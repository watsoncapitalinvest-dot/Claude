":"New World Order","g":["Mike Wilson"]}]},{"y":2025,"s":[{"t":"The Jet - I","g":["Brenton Strange"]},{"t":"The Beaver Eaters","g":["2026 2nd (Beavers)"]}]},{"y":2022,"s":[{"t":"Pork Chop Express","g":["Rashaad Penny","2024 2nd (Pop)"]},{"t":"The Powers of Pain","g":["2025 1st (Chops)"]}]},{"y":2022,"s":[{"t":"Wookie Leaks","g":["Nick Foles"]},{"t":"The Machines","g":["2025 2nd (Wookies)"]}]},{"y":2025,"s":[{"t":"Pork Chop Express","g":["2025 pick 25"]},{"t":"The Machines","g":["2028 1st (PCE)"]}]},{"y":2026,"s":[{"t":"Heavy Hitters","g":["Jacory Croskey-Merritt"]},{"t":"Pork Chop Express","g":["2027 late 1st (Heavy Hitters)"]}]}]},"taunts":[{"y":2021,"t":"Pork Chop Express","g":"B-","l":"Amari Rodgers out of Clemson with the 32nd pick completes the GB Rodgers Stack."},{"y":2022,"t":"Beaver Eaters","g":"B-","l":"Cook slips to 12 and SDFT wisely grabs him."},{"y":2022,"t":"Big Blue","g":"C","l":"The champ doesn\u2019t need much at all so he decides to go with one of the remaining NFL 2nd round receivers in New England\u2019s Thornton."},{"y":2022,"t":"Guido Haters","g":"C+","l":"The Haters take a big risk drafting Ridder this high."},{"y":2022,"t":"Hairy Gumbas","g":"B","l":"Talks of Skyy Moore have died down some, but you can\u2019t go wrong at 14 drafting an acrobatic WR attached to Mahomes and the high powered KC offense."},{"y":2022,"t":"Heavy Hitters","g":"A+","l":"The Hitters upgrade their talent at 3 positions."},{"y":2022,"t":"Horse Collars","g":"C+","l":"Seemingly upset by some past draft mistakes, Collars decides to swing for the fences and takes the 3rd round QB from Liberty University."},{"y":2022,"t":"New World Order","g":"A","l":"The board really fell NWO\u2019s way in the WR department."},{"y":2022,"t":"Pork Chop Express","g":"A-","l":"PCE took RB after RB which I think was a smart move for his teams future."},{"y":2022,"t":"Powers Of Pain","g":"A-","l":"It\u2019s all in on the Jets for the Pain, who\u2019s hoping this doesn\u2019t end up crashing and 