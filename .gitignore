# macOS
.DS_Store

# editors
.idea/
.vscode/

# local server / tooling cruft
node_modules/
*.log
__pycache__/
*.pyc
scripts/.pack-*.json

# build_trade_values.py's output — an offline audit/validation artifact for
# the trade-value model (docs/TRADE-VALUE-MODEL.md). The app computes its
# future-pick expected value live in JS (index.html); nothing reads this
# file, so it doesn't get committed — regenerate with the script if needed.
tradeValues.json

# Chat corpora never enter this repo. The Pages workflow publishes the whole
# repo root as the site, so anything committed here is downloadable from the
# public site URL. The WhatsApp exports stay outside the tree; only distilled,
# reviewed artifacts (article copy, chat-marker.json) are committed.
*_chat*.txt
*_chat*.zip
*WhatsApp*
*whatsapp*
*.zip
chats/
sources/

# Sleeper NFL player table cache (5MB, refetched daily)
.sleeper-players.json

# brawler-test/ ships real game-engine and content archives (OpenBOR WASM
# build + game data) — not chat exports, safe to publish.
!/brawler-test/**/*.zip
.nflverse/
desk-notes.json

# nflverse downloads for scripts/waiver_depth.py -- 13MB of play-by-play and
# the player table. Regenerate by running the script; never commit them.
.cache/

# scripts/manager_quality.py's output. The numbers are fine; a committed FILE
# ranking all sixteen managers by how well they set a lineup is a league-wide
# shot list under the masthead, and nobody asked for one. The IR study quotes
# only the aggregate -- blocked sides against unblocked -- and the script
# reads committed week-data, so every figure on the page is reproducible
# without publishing the table. Run it yourself if you want the ranking.
manager-quality.json
.trade-pairs.json
tradeHindsight.json
tradeValuesDated.json
