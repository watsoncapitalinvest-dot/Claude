+void nativeSelector(const Surface *sel)
+{
+	if (!base || !sel) return;
+	R r = rectOf(sel);
+	if (!clipBase(r)) return;
+	const double k = SK();
+	const double x0 = xs[r.x0], y0 = ys[r.y0], x1 = xs[r.x1], y1 = ys[r.y1];
+	// where the room will go: a translucent wash and a solid edge, the plan still
+	// readable through it
+	const double t = std::max(3.0, k * 0.6);
+	roundRect(x0 + 1, y0 + 1, x1 - 1, y1 - 1, k * 2, 0xE8B04A, 70);
+	fillRect((int)x0 + 1, (int)y0 + 1, (int)x1 - 1, (int)(y0 + 1 + t), 0xE8B04A);
+	fillRect((int)x0 + 1, (int)(y1 - 1 - t), (int)x1 - 1, (int)y1 - 1, 0xE8B04A);
+	fillRect((int)x0 + 1, (int)y0 + 1, (int)(x0 + 1 + t), (int)y1 - 1, 0xE8B04A);
+	fillRect((int)(x1 - 1 - t), (int)y0 + 1, (int)x1 - 1, (int)y1 - 1, 0xE8B04A);
+	// hollow it: put the plan back inside the ring by re-claiming only the ring's base pixels
+	SDL_Surface *ss = const_cast<Surface*>(sel)->getSurface();
+	for (int by = r.y0; by < r.y1; ++by)
+	{
+		const Uint8 *p = row8(by);
+		for (int bx = r.x0; bx < r.x1; ++bx)
+		{
+			const int sx = bx - sel->getX(), sy = by - sel->getY();
+			if (!ss || sx >= ss->w || sy >= ss->h || !((const Uint8*)ss->pixels)[sy * ss->pitch + sx]) continue;
+			tag[by * bw + bx] = p[bx]; valid[by * bw + bx] = 1;
+		}
+	}
+	any = true;
+}
