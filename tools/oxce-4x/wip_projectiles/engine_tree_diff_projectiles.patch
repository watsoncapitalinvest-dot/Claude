+/**
+ * Draws one leg of a player-drawn route as a dashed line in a fixed colour.
+ *
+ * NOT drawPath/XuLine, which is what a craft's flight path uses. XuLine reads
+ * the pixel under it and writes a SHADED version of that same pixel, so the
+ * trail is a darkening of the globe rather than a line drawn on it. That is
+ * right for radar and wrong here: the first build routed three marks through
+ * it and the line was invisible over ocean, which left a route reading as
+ * three loose icons. A mark the player drew himself is ink on the map, so it
+ * gets a colour of its own, and a dash so it cannot be mistaken for a radar
+ * range or a flight path.
+ *
+ * `phase` carries the dash across the legs of a route, so a bend does not
+ * restart the pattern and the whole run reads as one line.
+ */
+void Globe::drawMarkPath(double lon1, double lat1, double lon2, double lat2,
+                         Uint8 colour, double *phase)
+{
+	Cord a(CordPolar(lon1, lat1));
+	Cord b(CordPolar(lon2, lat2));
+	if (-b == a)
+	{
+		return;
+	}
+	b -= a;
+	double length = b.norm();
+	length *= length*15;
+	Sint16 count = length + 1;
+	b /= count;
+	CordPolar p1 = CordPolar(a), p2;
+	double x1, y1, x2, y2;
+	polarToCart(p1.lon, p1.lat, &x1, &y1);
+	for (int i = 0; i < count; ++i)
+	{
+		a += b;
+		p2 = CordPolar(a);
+		polarToCart(p2.lon, p2.lat, &x2, &y2);
+		if (!pointBack(p1.lon, p1.lat) && !pointBack(p2.lon, p2.lat))
+		{
+			double cx1 = x1, cy1 = y1, cx2 = x2, cy2 = y2;
+			if (HiUI::enabled())
+			{
+				// Same dash as the pixel version - 4 on, 3 off, in base pixels,
+				// phase carried across legs - cut out of the true segment.
+				const double dx = x2 - x1, dy = y2 - y1;
+				const double len = std::sqrt(dx*dx + dy*dy);
+				double t = 0.0;
+				while (t < len)
+				{
+					const double ph = std::fmod(*phase, 7.0);
+					const double run = (ph < 4.0) ? (4.0 - ph) : (7.0 - ph);
+					const double t2 = std::min(len, t + run);
+					if (ph < 4.0 && len > 0)
+					{
+						HiUI::vectorLine(HiUI::VEC_RADAR,
+							x1 + dx*t/len + getX(), y1 + dy*t/len + getY(),
+							x1 + dx*t2/len + getX(), y1 + dy*t2/len + getY(),
+							argbOf(getPalette(), colour, 235), 2.2);
+					}
+					*phase += (t2 - t);
+					t = t2;
+				}
+			}
+			else if (_clipper->LineClip(&cx1, &cy1, &cx2, &cy2) == 1)
+			{
+				const double dx = cx2 - cx1, dy = cy2 - cy1;
+				const int steps = (int)std::max(std::abs(dx), std::abs(dy));
+				for (int k = 0; k <= steps; ++k)
+				{
+					const double t = steps ? (double)k / steps : 0.0;
+					const int px = (int)(cx1 + dx*t), py = (int)(cy1 + dy*t);
+					// Only where the globe itself has a pixel, exactly as
+					// XuLine tests: that is what keeps the line off the sky
+					// and off the far face.
+					if (getPixel(px, py) && std::fmod(*phase, 7.0) < 4.0)
+					{
+						_radars->setPixel(px, py, colour);
+					}
+					*phase += 1.0;
+				}
+			}
+		}
+		p1 = p2;
+		x1 = x2;
+		y1 = y2;
+	}
+}
