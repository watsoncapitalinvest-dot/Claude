+		const double sxk = (double)(xs[bw] - xs[0]) / bw, syk = (double)(ys[bh] - ys[0]) / bh;
+		const double ox = xs[0], oy = ys[0];
+		if (vcov.size() != (size_t)sw * sh) vcov.assign((size_t)sw * sh, 0);
+		for (auto &layer : vlayers)
+		{
+			std::vector<Uint32> colours;
+			for (const auto &l : layer)
+				if (std::find(colours.begin(), colours.end(), l.argb) == colours.end()) colours.push_back(l.argb);
+			for (Uint32 col : colours)
+			{
+				vtouched.clear();
+				for (const auto &l : layer)
+				{
+					if (l.argb != col) continue;
+					const double X1 = ox + l.x1 * sxk, Y1 = oy + l.y1 * syk, X2 = ox + l.x2 * sxk, Y2 = oy + l.y2 * syk;
+					const double hw = l.w * 0.5, pad = hw + 1.0;
+					const int x0 = std::max(0, (int)std::floor(std::min(X1, X2) - pad));
+					const int x1 = std::min(sw - 1, (int)std::ceil(std::max(X1, X2) + pad));
+					const int y0 = std::max(0, (int)std::floor(std::min(Y1, Y2) - pad));
+					const int y1 = std::min(sh - 1, (int)std::ceil(std::max(Y1, Y2) + pad));
+					const double dx = X2 - X1, dy = Y2 - Y1, L2 = dx * dx + dy * dy;
+					for (int Y = y0; Y <= y1; ++Y)
+					{
+						const int by = (int)((Y + 0.5 - oy) / syk);
+						if (by < 0 || by >= bh) continue;
+						const Uint8 *row = row8(by);
+						for (int X = x0; X <= x1; ++X)
+						{
+							const int bx = (int)((X + 0.5 - ox) / sxk);
+							if (bx < 0 || bx >= bw) continue;
+							const size_t bi = (size_t)by * bw + bx;
+							// the floor rule: only where the globe's own pixel still shows
+							if (!vvalid[bi] || vtag[bi] != row[bx]) continue;
+							const double px = X + 0.5 - X1, py = Y + 0.5 - Y1;
+							double t = L2 > 0 ? (px * dx + py * dy) / L2 : 0.0;
+							t = t < 0 ? 0 : (t > 1 ? 1 : t);
+							const double qx = px - t * dx, qy = py - t * dy;
+							const double d = std::sqrt(qx * qx + qy * qy);
+							double cov = hw + 0.5 - d;
+							if (cov <= 0) continue;
+							if (cov > 1) cov = 1;
+							const Uint8 c8 = (Uint8)(cov * 255);
+							Uint8 &cell = vcov[(size_t)Y * sw + X];
+							if (cell == 0) vtouched.push_back(Y * sw + X);
+							if (c8 > cell) cell = c8;
+						}
+					}
+				}
+				const int a = col >> 24;
+				const Uint32 rgbc = col & 0xFFFFFF;
+				for (int idx : vtouched)
+				{
+					const int X = idx % sw, Y = idx / sw;
+					const int al = vcov[idx] * a / 255;
+					vcov[idx] = 0;
+					if (al <= 0) continue;
+					Uint32 *d = (Uint32*)((Uint8*)screen32->pixels + Y * screen32->pitch) + X;
+					const Uint32 under = direct ? (*d & 0xFFFFFF) : rgb((*d >> f->Rshift) & 255, (*d >> f->Gshift) & 255, (*d >> f->Bshift) & 255);
+					put(X, Y, mix(under, rgbc, al));
+				}
+			}
+		}
+	}
 	if (curOn && curX >= 0 && curY >= 0 && curX < bw && curY < bh)
 	{
 		const Img *cur = piece("cursor");
