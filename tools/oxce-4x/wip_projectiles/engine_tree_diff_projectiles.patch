+				setType(*f, legend, (int)(x0 + k * 0.6), (int)(y0 + push), (int)(x1 - k * 0.6), (int)(y1 + push - k * 0.3), cap, cap, 1, 1, ink);
+			}
+		}
+		else if (const Face *f = face("stencil"))
+		{
+			const double cap = (y1 - y0) * 0.42;
+			const double m = k * 3.0;     // a margin of face either side of the legend
+			setType(*f, legend, (int)(x0 + m + k * 0.4), (int)(y0 + push + k * 0.4), (int)(x1 - m + k * 0.4), (int)(y1 + push - k * 0.55 + k * 0.4), cap, cap, 1, 1, (Uint32)sh);
+			setType(*f, legend, (int)(x0 + m), (int)(y0 + push), (int)(x1 - m), (int)(y1 + push - k * 0.55), cap, cap, 1, 1, C_INK);
+		}
+	}
+
+	/// An 8-bit frame enlarged by whole pixels (6x), cached per frame and palette:
+	/// crisp pixel art wherever a sprite has no painted twin yet.
+	const Img *flatTwin(const Surface *frame)
+	{
+		static std::unordered_map<const Surface*, std::pair<Uint32, Img> > flatTwins;
+		SDL_Surface *fs8 = const_cast<Surface*>(frame)->getSurface();
+		if (!fs8 || fs8->format->BitsPerPixel != 8 || !base->format->palette) return nullptr;
+		const SDL_Color *pal = base->format->palette->colors;
+		const Uint32 ph = palHash(pal);
+		auto &slot = flatTwins[frame];
+		if (!slot.second.ok || slot.first != ph)
+		{
+			const int K6 = 6;
+			Img im; im.w = fs8->w * K6; im.h = fs8->h * K6; im.px.assign((size_t)im.w * im.h, 0); im.ok = true;
+			for (int fy = 0; fy < fs8->h; ++fy)
+				for (int fx = 0; fx < fs8->w; ++fx)
+				{
+					const Uint8 v = ((const Uint8*)fs8->pixels)[fy * fs8->pitch + fx];
+					if (!v) continue;
+					const Uint32 c = 0xFF000000u | rgb(pal[v].r, pal[v].g, pal[v].b);
+					for (int yy = 0; yy < K6; ++yy)
+						for (int xx = 0; xx < K6; ++xx) im.px[(size_t)(fy * K6 + yy) * im.w + fx * K6 + xx] = c;
+				}
+			slot = std::make_pair(ph, std::move(im));
+		}
+		return &slot.second;
+	}
+
+	/// Words set across as many lines as they need inside a box, shrunk until
+	/// they fit, centred both ways. Room names on the base plan.
+	void setTypeWrapped(const Face &f, const std::string &str, int X0, int Y0, int X1, int Y1, double capPx, Uint32 col, Uint32 shadow, int align = 1, int valign = 1)
+	{
+		std::vector<std::string> words;
+		{
+			std::string w;
+			for (char c : str) { if (c == ' ') { if (!w.empty()) words.push_back(w); w.clear(); } else w += c; }
+			if (!w.empty()) words.push_back(w);
+		}
+		if (words.empty()) return;
+		std::vector<std::string> lines;
+		double size = capPx * f.em / f.cap;
+		for (int tries = 0; tries < 12; ++tries)
+		{
+			lines.clear();
+			std::string cur;
+			for (auto &w : words)
+			{
+				std::string t = cur.empty() ? w : cur + " " + w;
+				const auto v = latin1(t);
+				if (!cur.empty() && lineWidth(f, v, 0, v.size(), size) > X1 - X0) { lines.push_back(cur); cur = w; }
+				else cur = t;
+			}
+			lines.push_back(cur);
+			double widest = 0;
+			for (auto &l : lines) { const auto v = latin1(l); widest = std::max(widest, lineWidth(f, v, 0, v.size(), size)); }
+			const double lineH = f.cap * size / f.em * 1.45;
+			if (widest <= X1 - X0 && lineH * lines.size() <= Y1 - Y0) break;
+			size *= 0.9;
+		}
+		const double cap = f.cap * size / f.em, lineH = cap * 1.45;
+		const double block = lineH * (lines.size() - 1) + cap;
+		double y = valign == 0 ? Y0 + (lineH - cap) / 2.0 : valign == 2 ? Y1 - block : (Y0 + Y1) / 2.0 - block / 2.0;
+		for (auto &l : lines)
+		{
+			const auto v = latin1(l);
+			const double w = lineWidth(f, v, 0, v.size(), size);
+			const double x = align == 0 ? X0 : align == 2 ? X1 - w : (X0 + X1 - w) / 2.0;
+			if (shadow) drawLine(f, v, 0, v.size(), x + 2, y + cap + 2, size, shadow, 0, 0, sw, sh);
+			drawLine(f, v, 0, v.size(), x, y + cap, size, col, 0, 0, sw, sh);
+			y += lineH;
+		}
+	}
+
+	/// Floor colour of a room by what it is for, from the console's own family:
+	/// muted, so the names read and nothing glares on the plan.
+	Uint32 roomTone(int kind)
+	{
+		switch (kind)
+		{
+		case ROOM_HANGAR:   return 0x4D5643;
+		case ROOM_LIFT:     return 0x5E5D4B;
+		case ROOM_LAB:      return 0x3E5562;
+		case ROOM_WORKSHOP: return 0x60533A;
+		case ROOM_QUARTERS: return 0x4F5C3E;
+		case ROOM_STORES:   return 0x59553F;
+		case ROOM_DEFENCE:  return 0x613F37;
+		case ROOM_RADAR:    return 0x3C5B51;
+		case ROOM_PSI:      return 0x514263;
+		case ROOM_PRISON:   return 0x4B4B4B;
+		default:            return 0x4C5244;
+		}
+	}
+	Uint32 lift(Uint32 c, int d)
+	{
+		auto ch = [&](int sh2) { return std::max(0, std::min(255, (int)((c >> sh2) & 255) + d)); };
+		return rgb(ch(16), ch(8), ch(0));
+	}
+
+	/// A Text widget's own colour, made readable on the dark plate.
+	Uint32 textColour(Uint8 index)
+	{
+		const SDL_Color &c = base->format->palette->colors[index];
+		const int hi = std::max(c.r, std::max(c.g, c.b)), lo = std::min(c.r, std::min(c.g, c.b));
+		return readable(c.r, c.g, c.b, (hi - lo) > 150);
+	}
+
+	// UI STANDARD v1 (design chat, approved by John 12 Nov). Colour ROLES, not
+	// the game's palette entries: every screen reads alike whatever palette it runs.
+
+	/// The standard's text role for one of the game's text colours. Yellow and
+	/// orange are headings and highlights; red is danger; strong blue is information
+	/// and strong green good news (so a list that marks rows by colour keeps the
+	/// mark); everything else is main or muted text by how bright the game made it.
+	Uint32 roleColour(Uint8 index)
+	{
+		const SDL_Color &c = base->format->palette->colors[index];
+		const int hi = std::max(c.r, std::max(c.g, c.b)), lo = std::min(c.r, std::min(c.g, c.b));
+		const int sat = hi ? (hi - lo) * 255 / hi : 0;
+		double h = 0;
+		if (hi != lo)
+		{
+			if (hi == c.r) h = 60.0 * std::fmod((double)(c.g - c.b) / (hi - lo), 6.0);
+			else if (hi == c.g) h = 60.0 * ((double)(c.b - c.r) / (hi - lo) + 2.0);
+			else h = 60.0 * ((double)(c.r - c.g) / (hi - lo) + 4.0);
+			if (h < 0) h += 360;
+		}
+		if (sat > 110 && hi > 90)
+		{
+			// the game's column headers are an orange-red (hue ~15-25): headings, not danger
+			if (h >= 11 && h < 72) return S_YELLOW;
+			// the game's list headers are a soft pinkish red: headings. Only a strong
+			// pure red (a warning, a casualty) takes the danger role.
+			if (h < 11 || h >= 330) return sat > 215 && hi > 150 ? S_DANGER_TXT : S_YELLOW;
+			if (sat > 170 && h >= 190 && h < 260) return S_INFO;
+			if (sat > 170 && h >= 85 && h < 160 && hi < 200) return S_GOOD;
+		}
+		return hi >= 120 ? S_TEXT : S_MUTED;
+	}
+
+	/// THE STANDARD'S BUTTON, in the cartoon finish John chose over the canvas's
+	/// gradients: one flat steel tone, a dark ink outline, and one hard edge - a
+	/// light lip on top and a shadow under it when up, the shadow on top when down.
+	void stdButton(int X0, int Y0, int X1, int Y1, bool down, Uint32 fill)
+	{
+		const double k = SK();
+		const int t = std::max(1, (int)std::lround(k * 0.45)), e = std::max(1, (int)std::lround(k * 0.6));
+		if (!fill) fill = down ? S_BUTTON_DOWN : S_BUTTON;
+		fillRect(X0, Y0, X1, Y1, S_INK);
+		fillRect(X0 + t, Y0 + t, X1 - t, Y1 - t, fill);
+		if (down) fillRect(X0 + t, Y0 + t, X1 - t, Y0 + t + e, S_BUTTON_SHADOW);
+		else
+		{
+			fillRect(X0 + t, Y0 + t, X1 - t, Y0 + t + std::max(1, e / 2), lift(fill, 22));
+			fillRect(X0 + t, Y1 - t - e, X1 - t, Y1 - t, S_BUTTON_SHADOW);
+		}
+	}
+
+	// Per-widget overrides (fix list 12 Nov): a readout coloured by what it says,
+	// a widget kept in its pixel font, a widget forced into one face.
+	std::unordered_map<const Surface*, Uint32> textInks;
+	std::unordered_map<const Surface*, bool> pixelTexts;
+	std::unordered_map<const Surface*, std::string> textFaces;
+
+	/// Set a Text in the label face over its own rectangle.
+	void nativeType(const Text *t, int bx, int by, Uint32 col)
+	{
+		const int fh = t->getFont() ? t->getFont()->getHeight() : 9;
+		const bool big = fh >= 12;
+		{
+			auto ink = textInks.find(t);
+			if (ink != textInks.end()) col = ink->second;
+		}
+		// the standard: titles and headings in the stencil face, everything else Oswald
+		const Face *f = big && face("stencil") ? face("stencil") : face("label");
+		{
+			auto tf = textFaces.find(t);
+			if (tf != textFaces.end() && face(tf->second)) f = face(tf->second);
+		}
+		if (!f || t->getText().empty()) return;
+		const double k = SK();
+		// the stencil face sets wider than the pixel font it replaces, so a little smaller
+		const double cap = fh * (big ? (f == face("stencil") ? 0.50 : 0.62) : 0.60) * k;
+		const double lineH = (fh + (t->getFont() ? t->getFont()->getSpacing() : 0)) * k;
+		// a little air from the edge it is aligned to, so type never sits on a plate's rim
+		const double pad = 1.5;
+		const double l = t->getAlign() == ALIGN_LEFT ? pad : 0, r = t->getAlign() == ALIGN_RIGHT ? pad : 0;
+		const int X0 = (int)DX(bx + l), Y0 = (int)DY(by), X1 = (int)DX(bx + t->getWidth() - r), Y1 = (int)DY(by + t->getHeight());
+		// a wrapping text more than a line tall is a paragraph: wrap it, do not shrink it onto one line
+		if (t->getWordWrap() && t->getHeight() > fh * 1.6)
+			setTypeWrapped(*f, t->getText(), X0, Y0, X1, Y1, cap, col, 0, (int)t->getAlign(), (int)t->getVerticalAlign());
+		else setType(*f, t->getText(), X0, Y0, X1, Y1, cap, lineH, (int)t->getAlign(), (int)t->getVerticalAlign(), col);
+	}
+
+	// ---------------------------------------------------------------- THE BATTLE BAR
+	// BATTLE_HUD_SPEC_v1, positions in base px with the bar's top at 0 (the spec's
+	// y 158). The bar runs the full width of the screen; its contents are a 320-wide
+	// block centred on it, the same block the widgets were laid out in.
+
+	/// A box in the bar's own coordinates, in display pixels.
+	struct DBox { double x0, y0, x1, y1; };
+	DBox hudBox(const Surface *bar, double x, double y, double w, double h)
+	{
+		const double ox = hud.contentX, oy = bar->getY();
+		return { DX(ox + x), DY(oy + y), DX(ox + x + w), DY(oy + y + h) };
+	}
+	void boxFill(const DBox &b, Uint32 c, int a = 255) { fillRect((int)b.x0, (int)b.y0, (int)b.x1, (int)b.y1, c, a); }
+	void boxEdge(const DBox &b, Uint32 c, double t)
+	{
+		const int T = std::max(1, (int)std::lround(t));
+		fillRect((int)b.x0, (int)b.y0, (int)b.x1, (int)b.y0 + T, c); fillRect((int)b.x0, (int)b.y1 - T, (int)b.x1, (int)b.y1, c);
+		fillRect((int)b.x0, (int)b.y0, (int)b.x0 + T, (int)b.y1, c); fillRect((int)b.x1 - T, (int)b.y0, (int)b.x1, (int)b.y1, c);
+	}
+	void boxText(const DBox &b, const std::string &str, double capBase, int align, Uint32 col, const char *faceName = "label")
+	{
+		const Face *f = face(faceName);
+		if (!f) f = face("label");
+		if (!f || str.empty()) return;
+		const double cap = capBase * SK();
+		setType(*f, str, (int)b.x0, (int)b.y0, (int)b.x1, (int)b.y1, cap, b.y1 - b.y0, align, 1, col, false);
+	}
+
+	/// An item picture laid on its side for the hand card's strip, cropped to what it draws.
+	const Img *sideways(const Surface *frame)
+	{
+		auto c = hudArt.find(frame);
+		if (c != hudArt.end()) return c->second.ok ? &c->second : nullptr;
+		Img &out = hudArt[frame];
+		auto it = bgImages.find(frame);
+		const Img *src = (it != bgImages.end() && it->second.ok) ? &it->second : flatTwin(frame);
+		if (!src) return nullptr;
+		int x0 = src->w, y0 = src->h, x1 = 0, y1 = 0;
+		for (int y = 0; y < src->h; ++y)
+			for (int x = 0; x < src->w; ++x)
+				if ((src->px[(size_t)y * src->w + x] >> 24) > 24) { x0 = std::min(x0, x); y0 = std::min(y0, y); x1 = std::max(x1, x + 1); y1 = std::max(y1, y + 1); }
+		if (x1 <= x0 || y1 <= y0) return nullptr;
+		const int w = x1 - x0, h = y1 - y0;
+		const bool turn = h > w;   // upright in the equipment screen: muzzle up. Lay it down, muzzle left.
+		out.w = turn ? h : w; out.h = turn ? w : h; out.px.assign((size_t)out.w * out.h, 0);
+		for (int y = 0; y < h; ++y)
+			for (int x = 0; x < w; ++x)
+			{
+				const Uint32 p = src->px[(size_t)(y0 + y) * src->w + (x0 + x)];
+				if (turn) out.px[(size_t)(w - 1 - x) * out.w + y] = p;     // rotate 90 degrees anticlockwise
+				else out.px[(size_t)y * out.w + x] = p;
+			}
+		out.ok = true;
+		return &out;
+	}
+
+	void hudBarRow(const Surface *bar, double y, const char *label, int v, int vmax, Uint32 col)
+	{
+		const double fr = vmax > 0 ? std::max(0.0, std::min(1.0, (double)v / vmax)) : 0;
+		boxText(hudBox(bar, 36, y - 0.6, 10, 3.6), label, 2.0, 0, S_MUTED);
+		DBox track = hudBox(bar, 46, y, 32, 2.4);
+		boxFill(track, 0x2A3033);
+		DBox fill = track; fill.x1 = track.x0 + (track.x1 - track.x0) * fr;
+		boxFill(fill, col);
+		boxText(hudBox(bar, 79, y - 0.9, 11, 4.2), std::to_string(v), 2.6, 2, S_TEXT);
+	}
+
+	void paintHud(const Surface *bar)
+	{
+		const double k = SK();
+		const int Y0 = (int)DY(bar->getY()), Y1 = (int)DY(bar->getY() + bar->getHeight());
+		// the bar: ground, the olive rule on top, the squad strip
+		fillRect(0, Y0, sw, Y1, 0x14181A);
+		fillRect(0, Y0, sw, Y0 + std::max(1, (int)std::lround(k * 0.35)), S_OLIVE);
+		fillRect(0, (int)DY(bar->getY() + 1), sw, (int)DY(bar->getY() + 8.5), 0x0F1213);
+
+		// 6 portrait: a head crop of the inventory figure, in a yellow frame
+		DBox pb = hudBox(bar, 4, 11, 28, 28);
+		boxFill(pb, 0x1B2023);
+		bool drew = false;
+		if (hud.figure)
+		{
+			auto it = bgImages.find(hud.figure);
+			if (it != bgImages.end() && it->second.ok)
+			{
+				// the figures are painted to one sheet (INVENTORY_FIGURE_BRIEF): head
+				// top at 1/40 of the height, centred. Crop a square from the top.
+				const Img &im = it->second;
+				const double scale = im.h / 1200.0;             // twins are 1920x1200 pages
+				const int cx = (int)(483 * scale), top = (int)(290 * scale), side = (int)(130 * scale);
+				stretch(im, cx - side / 2, top, cx + side / 2, top + side, (int)pb.x0 + 2, (int)pb.y0 + 2, (int)pb.x1 - 2, (int)pb.y1 - 2);
+				drew = true;
+			}
+		}
+		if (!drew) boxText(hudBox(bar, 4, 11, 28, 28), "?", 8, 1, S_MUTED, "stencil");
+		boxEdge(pb, S_YELLOW, k * 0.35);
+
+		// 7 the line under the name, then four bars
+		boxText(hudBox(bar, 36, 18.5, 54, 4), hud.sub, 2.2, 0, S_MUTED);
+		hudBarRow(bar, 23.5, "TIME", hud.tu, hud.tuMax, S_YELLOW);
+		hudBarRow(bar, 27.5, "HEALTH", hud.hp, hud.hpMax, 0x6FAE4A);
+		hudBarRow(bar, 31.5, "ENERGY", hud.en, hud.enMax, 0x5B8FC9);
+		hudBarRow(bar, 35.5, "MORALE", hud.mo, hud.moMax, 0xC9C3B1);
+
+		// 8, 9 the hand cards (the fire-mode keys are widgets drawn over them)
+		for (int i = 0; i < 2; ++i)
+		{
+			const double cx = i == 0 ? 94 : 145;
+			DBox cb = hudBox(bar, cx, 10, 47, 29);
+			boxFill(cb, 0x1B2023);
+			boxEdge(cb, 0x2E3530, k * 0.33);
+			const HudHand &h = hud.hand[i];
+			boxText(hudBox(bar, cx + 1.5, 10.8, 30, 3.6), h.label, 1.9, 0, S_MUTED);
+			if (h.empty)
+			{
+				boxText(hudBox(bar, cx + 1.5, 15, 44, 5), "EMPTY", 2.6, 1, 0x5C5A52);
+				continue;
+			}
+			boxText(hudBox(bar, cx + 27, 10.8, 18.5, 3.6), h.ammo, 2.0, 2, S_TEXT);
+			boxText(hudBox(bar, cx + 1.5, 14.6, 44, 4.4), h.name, 2.6, 0, S_TEXT);
+			if (h.art)
+				if (const Img *im = sideways(h.art))
+				{
+					// fit the strip, keep the picture's proportions
+					DBox sb = hudBox(bar, cx + 1.5, 19.2, 44, 6.2);
+					const double bw2 = sb.x1 - sb.x0, bh2 = sb.y1 - sb.y0;
+					const double sc = std::min(bw2 / im->w, bh2 / im->h);
+					const double w = im->w * sc, hgt = im->h * sc;
+					const double x = sb.x0 + (bw2 - w) / 2, y = sb.y0 + (bh2 - hgt) / 2;
+					stretch(*im, 0, 0, im->w, im->h, (int)x, (int)y, (int)(x + w), (int)(y + hgt));
+				}
+		}
+
+		// 11 reserve time: the label (the four toggles are widgets)
+		boxText(hudBox(bar, 251, 10.4, 36, 4), "RESERVE TIME", 1.9, 0, S_MUTED);
+
+		// 12 signature move
+		DBox sg = hudBox(bar, 251, 24, 36, 14);
+		boxFill(sg, hud.sigOn ? 0x232A2D : 0x1B2023);
+		boxEdge(sg, hud.sigOn ? S_YELLOW : 0x2E3530, k * 0.3);
+		boxText(hudBox(bar, 252.5, 24.8, 33, 3.4), hud.sigTitle, 1.7, 0, hud.sigOn ? S_YELLOW : 0x6E6C64);
+		boxText(hudBox(bar, 252.5, 28.4, 33, 5), hud.sigName, 2.6, 0, hud.sigOn ? S_TEXT : 0x6E6C64, "stencil");
+		boxText(hudBox(bar, 252.5, 33.6, 33, 3.6), hud.sigHow, 1.6, 0, hud.sigOn ? S_MUTED : 0x5C5A52);
+	}
+
+	void paintMission(const Surface *m)
+	{
+		const double k = SK();
+		const DBox b{ DX(m->getX()), DY(m->getY()), DX(m->getX() + m->getWidth()), DY(m->getY() + m->getHeight()) };
+		boxFill(b, 0x14181A);
+		boxEdge(b, S_OLIVE, k * 0.3);
+		auto row = [&](double y, double h) { return DBox{ b.x0 + k * 2, b.y0 + y * k, b.x1 - k * 2, b.y0 + (y + h) * k }; };
+		boxText(row(1.2, 6.5), hud.turn, 3.6, 0, S_YELLOW, "stencil");
+		boxText(row(1.2, 6.5), hud.phase, 2.2, 2, S_MUTED);
+		boxText(row(8.5, 5.5), hud.objective, 2.4, 0, S_TEXT);
+		boxText(row(14.8, 5), hud.counts, 2.1, 0, S_MUTED);
+	}
+
+	// ===================================================================== THE GLOBE
+	//
+	// The 8-bit globe is a 256x200 surface zoomed six times, so a 2048-wide
+	// earth texture reaches the screen as 6x6 blocks. Here the same projection
+	// is inverted per DISPLAY pixel and the texture sampled bilinearly, so the
+	// earth is as sharp as the texture is. Two caches: the land sample per
+	// pixel (rebuilt when the globe turns or zooms) and the shaded colour
+	// (rebuilt when the sun moves), so a still globe costs one copy a frame.
+	const double GPI = 3.14159265358979323846;
+	bool lastActive = false;
+	// The globe's own rectangle: base (gb*) and display (gc*). Everything the top
+	// layer draws stays inside it, or a name near the edge is printed over the
+	// side panel - which the panel has already claimed this frame.
+	int gbx0 = 0, gby0 = 0, gbx1 = 0, gby1 = 0, gcx0 = 0, gcy0 = 0, gcx1 = 0, gcy1 = 0;
+	/// Draw `fn` into the overlay, then put back every pixel it touched outside the globe.
+	template <class F> void clipToGlobe(double x0, double y0, double x1, double y1, F fn)
+	{
+		const int X0 = std::max(0, (int)std::floor(x0)), Y0 = std::max(0, (int)std::floor(y0));
+		const int X1 = std::min(sw, (int)std::ceil(x1)), Y1 = std::min(sh, (int)std::ceil(y1));
+		if (X0 >= gcx0 && Y0 >= gcy0 && X1 <= gcx1 && Y1 <= gcy1) { fn(); return; }
+		if (X1 <= X0 || Y1 <= Y0) return;
+		std::vector<Uint32> keep((size_t)(X1 - X0) * (Y1 - Y0));
+		for (int Y = Y0; Y < Y1; ++Y) memcpy(&keep[(size_t)(Y - Y0) * (X1 - X0)], over.data() + (size_t)Y * sw + X0, (size_t)(X1 - X0) * 4);
+		fn();
+		for (int Y = Y0; Y < Y1; ++Y)
+			for (int X = X0; X < X1; ++X)
+				if (X < gcx0 || X >= gcx1 || Y < gcy0 || Y >= gcy1) over[(size_t)Y * sw + X] = keep[(size_t)(Y - Y0) * (X1 - X0) + (X - X0)];
+	}
+	struct GlobeHD
+	{
+		GlobeView v; bool have = false;
+		std::vector<GlobeLabel> labels; std::vector<GlobePin> pins; std::vector<GlobeArt> art;
+		const Surface *texSrc = nullptr; Uint32 texKey = 0; Img tex;
+		int X0 = 0, Y0 = 0, X1 = 0, Y1 = 0;
+		double gkey[9] = {};
+		std::vector<Uint32> land;                 // ARGB, alpha = how much of this pixel is land
+		double skey[4] = {};
+		std::vector<Uint32> out; std::vector<Uint8> cov;
+		bool geomOk = false, shadeOk = false;
+	} G;
+
+	void globeTexture()
+	{
+		const Surface *t = G.v.texture;
+		if (!t) { G.tex = Img(); G.texSrc = nullptr; return; }
+		// a full-colour twin (earth_hi.png beside earth.png) wins if the mod has one
+		auto twin = bgImages.find(t);
+		if (twin != bgImages.end() && twin->second.ok)
+		{
+			if (G.texSrc != t || G.texKey != 1) { G.tex = twin->second; G.texSrc = t; G.texKey = 1; G.geomOk = false; }
+			return;
+		}
+		// otherwise the 8-bit texture itself, at its own 2048x1024, in the palette
+		// the globe is drawn in. Sea (index 0) is transparent: the ocean is shaded.
+		const Uint32 key = palHash(base->format->palette->colors) | 2u;
+		if (G.texSrc == t && G.texKey == key && G.tex.ok) return;
+		const SDL_Color *pal = base->format->palette->colors;
+		const int w = t->getWidth(), h = t->getHeight(), pitch = t->getPitch();
+		const Uint8 *src = t->getBuffer();
+		Img im; im.w = w; im.h = h; im.px.assign((size_t)w * h, 0); im.ok = src != nullptr && w > 1 && h > 1;
+		if (im.ok)
+			for (int y = 0; y < h; ++y)
+				for (int x = 0; x < w; ++x)
+				{
+					const Uint8 c = src[y * pitch + x];
+					if (c) im.px[(size_t)y * w + x] = 0xFF000000u | rgb(pal[c].r, pal[c].g, pal[c].b);
+				}
+		G.tex = std::move(im); G.texSrc = t; G.texKey = key; G.geomOk = false;
+	}
+
+	/// Bilinear, wrapping east-west, clamped at the poles. Colour is averaged over
+	/// the land texels only, so a coast fades to sea instead of to black.
+	inline Uint32 sampleEarth(const Img &im, double u, double v)
+	{
+		const double fx = u - 0.5, fy = v - 0.5;
+		int x0 = (int)std::floor(fx), y0 = (int)std::floor(fy);
+		const double ax = fx - x0, ay = fy - y0;
+		int x1 = x0 + 1, y1 = y0 + 1;
+		x0 = ((x0 % im.w) + im.w) % im.w; x1 = ((x1 % im.w) + im.w) % im.w;
+		y0 = std::max(0, std::min(im.h - 1, y0)); y1 = std::max(0, std::min(im.h - 1, y1));
+		const Uint32 p[4] = { im.px[(size_t)y0 * im.w + x0], im.px[(size_t)y0 * im.w + x1], im.px[(size_t)y1 * im.w + x0], im.px[(size_t)y1 * im.w + x1] };
+		const double wt[4] = { (1 - ax) * (1 - ay), ax * (1 - ay), (1 - ax) * ay, ax * ay };
+		double A = 0, r = 0, g = 0, b = 0;
+		for (int i = 0; i < 4; ++i)
+		{
+			const double a = wt[i] * (p[i] >> 24) / 255.0;
+			A += a; r += a * ((p[i] >> 16) & 255); g += a * ((p[i] >> 8) & 255); b += a * (p[i] & 255);
+		}
+		if (A <= 1e-6) return 0;
+		return ((Uint32)std::min(255.0, A * 255.0 + 0.5) << 24) | rgb((int)(r / A + 0.5), (int)(g / A + 0.5), (int)(b / A + 0.5));
+	}
+
+	void globeBox(int &X0, int &Y0, int &X1, int &Y1)
+	{
+		const Surface *g = G.v.globe;
+		const int gx0 = std::max(0, std::min(bw, g->getX())), gx1 = std::max(0, std::min(bw, g->getX() + g->getWidth()));
+		const int gy0 = std::max(0, std::min(bh, g->getY())), gy1 = std::max(0, std::min(bh, g->getY() + g->getHeight()));
+		const double k = SK(), cx = DX(G.v.cenX), cy = DY(G.v.cenY), R = G.v.radius * k;
+		X0 = std::max(xs[gx0], (int)std::floor(cx - R - 2)); X1 = std::min(xs[gx1], (int)std::ceil(cx + R + 2));
+		Y0 = std::max(ys[gy0], (int)std::floor(cy - R - 2)); Y1 = std::min(ys[gy1], (int)std::ceil(cy + R + 2));
+		if (X1 < X0) X1 = X0;
+		if (Y1 < Y0) Y1 = Y0;
+	}
+
+	void globeGeometry()
+	{
+		const double k = SK(), cx = DX(G.v.cenX), cy = DY(G.v.cenY), R = G.v.radius * k;
+		const double key[9] = { G.v.cenX, G.v.cenY, G.v.radius, G.v.cenLon, G.v.cenLat, (double)xs[0], (double)ys[0], k, (double)reinterpret_cast<uintptr_t>(G.tex.px.data()) };
+		if (G.geomOk && std::equal(key, key + 9, G.gkey)) return;
+		std::copy(key, key + 9, G.gkey);
+		const Uint32 t0 = SDL_GetTicks();
+		globeBox(G.X0, G.Y0, G.X1, G.Y1);
+		const int W = G.X1 - G.X0, H = G.Y1 - G.Y0;
+		G.land.assign((size_t)W * H, 0);
+		const double s0 = std::sin(G.v.cenLat), c0 = std::cos(G.v.cenLat);
+		const double tw = G.tex.w, th = G.tex.h;
+		if (G.tex.ok)
+			for (int Y = 0; Y < H; ++Y)
+			{
+				const double dy = (G.Y0 + Y + 0.5 - cy) / R;
+				for (int X = 0; X < W; ++X)
+				{
+					const double dx = (G.X0 + X + 0.5 - cx) / R;
+					double r2 = dx * dx + dy * dy;
+					if (r2 > 1.0 + 4.0 / R) continue;
+					r2 = std::min(r2, 0.999999);
+					const double nz = std::sqrt(1.0 - r2);
+					// cartToPolar, written with the unit normal: the same projection
+					const double lat = std::asin(std::max(-1.0, std::min(1.0, dy * c0 + nz * s0)));
+					const double lon = G.v.cenLon + std::atan2(dx, nz * c0 - dy * s0);
+					const double u = lon / (2 * GPI) * tw;
+					const double v = (GPI / 2 - lat) / GPI * th;
+					G.land[(size_t)Y * W + X] = sampleEarth(G.tex, u, v);
+				}
+			}
+		G.geomOk = true; G.shadeOk = false;
+		const Uint32 ms = SDL_GetTicks() - t0;
+		static int logged = 0;
+		if (logged < 3 && ms > 30) { ++logged; Log(LOG_INFO) << "HiUI globe: " << W << "x" << H << " re-projected in " << ms << " ms"; }
+	}
+
+	void globeShade()
+	{
+		const double key[4] = { G.v.sunX, G.v.sunY, G.v.sunZ, (double)G.v.ocean };
+		if (G.shadeOk && std::equal(key, key + 4, G.skey)) return;
+		std::copy(key, key + 4, G.skey);
+		const SDL_Color *pal = base->format->palette->colors;
+		// the ocean's own 32-step ramp; land is darkened by the same ratio the
+		// ramp falls by, so day and night agree between the two
+		double ramp[33][3], fac[33];
+		for (int i = 0; i < 33; ++i)
+		{
+			const int idx = std::max(0, std::min(255, G.v.ocean + (G.v.oceanShading ? std::min(i, 31) : 0)));
+			ramp[i][0] = pal[idx].r; ramp[i][1] = pal[idx].g; ramp[i][2] = pal[idx].b;
+		}
+		const double l0 = std::max(1.0, ramp[0][0] * 0.3 + ramp[0][1] * 0.59 + ramp[0][2] * 0.11);
+		for (int i = 0; i < 33; ++i)
+		{
+			const double l = ramp[i][0] * 0.3 + ramp[i][1] * 0.59 + ramp[i][2] * 0.11;
+			fac[i] = G.v.oceanShading ? std::max(0.14, std::min(1.0, l / l0)) : 1.0 - 0.7 * std::min(i, 31) / 31.0;
+		}
+		const double k = SK(), cx = DX(G.v.cenX), cy = DY(G.v.cenY), R = G.v.radius * k;
+		const int W = G.X1 - G.X0, H = G.Y1 - G.Y0;
+		G.out.assign((size_t)W * H, 0); G.cov.assign((size_t)W * H, 0);
+		const size_t nShade = G.v.shade.size();
+		for (int Y = 0; Y < H; ++Y)
+		{
+			const double dy = (G.Y0 + Y + 0.5 - cy) / R;
+			for (int X = 0; X < W; ++X)
+			{
+				const double dx = (G.X0 + X + 0.5 - cx) / R;
+				const double r2 = dx * dx + dy * dy;
+				const double d = (1.0 - std::sqrt(r2)) * R;           // display px inside the limb
+				const double c = std::max(0.0, std::min(1.0, d + 0.5));
+				if (c <= 0) continue;
+				const size_t i = (size_t)Y * W + X;
+				G.cov[i] = (Uint8)(c * 255 + 0.5);
+				const double nz = std::sqrt(std::max(0.0, 1.0 - r2));
+				const double dot = dx * G.v.sunX + dy * G.v.sunY + nz * G.v.sunZ;
+				const double t = -250.0 * dot + 128.0;
+				double s = 0;
+				if (nShade) s = G.v.shade[std::max(0, std::min((int)nShade - 1, (int)(t * 4)))];
+				s = std::max(0.0, std::min(31.0, s));
+				const int s0 = (int)s; const double sf = s - s0;
+				const double oc[3] = { ramp[s0][0] + (ramp[s0 + 1][0] - ramp[s0][0]) * sf, ramp[s0][1] + (ramp[s0 + 1][1] - ramp[s0][1]) * sf, ramp[s0][2] + (ramp[s0 + 1][2] - ramp[s0][2]) * sf };
+				const double f = fac[s0] + (fac[s0 + 1] - fac[s0]) * sf;
+				const Uint32 lp = G.land[i];
+				const double a = (lp >> 24) / 255.0;
+				const double r = oc[0] * (1 - a) + ((lp >> 16) & 255) * f * a;
+				const double g = oc[1] * (1 - a) + ((lp >> 8) & 255) * f * a;
+				const double b = oc[2] * (1 - a) + (lp & 255) * f * a;
+				G.out[i] = rgb((int)std::min(255.0, r + 0.5), (int)std::min(255.0, g + 0.5), (int)std::min(255.0, b + 0.5));
+			}
+		}
+		G.shadeOk = true;
+	}
+
+	/// Anti-aliased disc and ring, solid colour.
+	void ringAA(double cx, double cy, double rIn, double rOut, Uint32 col, int alpha = 255)
+	{
+		const int X0 = std::max(0, (int)std::floor(cx - rOut - 1)), X1 = std::min(sw, (int)std::ceil(cx + rOut + 1));
+		const int Y0 = std::max(0, (int)std::floor(cy - rOut - 1)), Y1 = std::min(sh, (int)std::ceil(cy + rOut + 1));
+		for (int Y = Y0; Y < Y1; ++Y)
+		{
+			Uint32 *o = over.data() + (size_t)Y * sw;
+			for (int X = X0; X < X1; ++X)
+			{
+				const double d = std::sqrt((X + 0.5 - cx) * (X + 0.5 - cx) + (Y + 0.5 - cy) * (Y + 0.5 - cy));
+				double c = std::max(0.0, std::min(1.0, rOut - d + 0.5));
+				if (rIn > 0) c -= std::max(0.0, std::min(1.0, rIn - d + 0.5));
+				if (c > 0) o[X] = mix(o[X], col, (int)(c * alpha));
+			}
+		}
+	}
+
+	/// Take over a base rect for the globe's top layer: pixels not already the
+	/// overlay's start from their flat colour, and vector strokes stand clear.
+	void globeClaimRect(R r)
+	{
+		r.x0 = std::max(r.x0, gbx0); r.y0 = std::max(r.y0, gby0); r.x1 = std::min(r.x1, gbx1); r.y1 = std::min(r.y1, gby1);
+		if (!clipBase(r)) return;
+		const SDL_Color *pal = base->format->palette->colors;
+		for (int by = r.y0; by < r.y1; ++by)
+		{
+			const Uint8 *p = row8(by);
+			for (int bx = r.x0; bx < r.x1; ++bx)
+			{
+				const size_t bi = (size_t)by * bw + bx;
+				if (!(valid[bi] && tag[bi] == p[bx]))
+				{
+					const Uint32 flat = rgb(pal[p[bx]].r, pal[p[bx]].g, pal[p[bx]].b);
+					fillRect(xs[bx], ys[by], xs[bx + 1], ys[by + 1], flat);
+					tag[bi] = p[bx]; valid[bi] = 1;
+				}
+				if (vvalid.size() == (size_t)bw * bh) vvalid[bi] = 0;
+			}
+		}
+		any = true;
+	}
+
+	/// Small caps: capitals at full size, lower case set as capitals at 78%.
+	double smallCapsWidth(const Face &f, const std::string &s, double size)
+	{
+		double w = 0;
+		for (int c : latin1(s))
+		{
+			const bool low = c >= 'a' && c <= 'z';
+			const int g = low ? c - 32 : c;
+			if (f.g[g].ok) w += f.g[g].adv * (low ? size * 0.78 : size) / f.em;
+		}
+		return w;
+	}
+	void smallCaps(const Face &f, const std::string &s, double x, double baseline, double size, Uint32 col)
+	{
+		for (int c : latin1(s))
+		{
+			const bool low = c >= 'a' && c <= 'z';
+			std::vector<int> one{ low ? c - 32 : c };
+			const double sz = low ? size * 0.78 : size;
+			drawLine(f, one, 0, 1, x, baseline, sz, col, 0, 0, sw, sh);
+			if (f.g[one[0]].ok) x += f.g[one[0]].adv * sz / f.em;
+		}
+	}
+
+	void globePin(const GlobePin &p)
+	{
+		const double k = SK(), cx = DX(p.x), cy = DY(p.y);
+		const int a = p.lit ? 255 : 170;
+		const double s = k * 2.1;          // half-size of a pin
+		const double o = std::max(1.5, k * 0.42);   // dark outline
+		auto poly = [&](std::vector<std::pair<double, double> > pts, double grow, Uint32 col, int al)
+		{
+			// grow a convex shape outward about its centre, for the outline
+			for (auto &q : pts) { const double vx = q.first - cx, vy = q.second - cy, L = std::sqrt(vx * vx + vy * vy); if (L > 0) { q.first += vx / L * grow; q.second += vy / L * grow; } }
+			polygonAA(pts, col, al);
+		};
+		switch (p.kind)
+		{
+		case PIN_JOE_BASE:                  // square: olive with a yellow rim
+			roundRect(cx - s - o, cy - s - o, cx + s + o, cy + s + o, k * 0.5, S_INK, 230);
+			roundRect(cx - s, cy - s, cx + s, cy + s, k * 0.35, S_YELLOW, a);
+			roundRect(cx - s + k * 0.5, cy - s + k * 0.5, cx + s - k * 0.5, cy + s - k * 0.5, k * 0.2, S_OLIVE_LIT, 255);
+			break;
+		case PIN_COBRA_SITE:                // diamond: red
+		{
+			const double d = s * 1.3;
+			std::vector<std::pair<double, double> > dia{ { cx, cy - d }, { cx + d, cy }, { cx, cy + d }, { cx - d, cy } };
+			poly(dia, o * 1.4, S_INK, 230);
+			poly(dia, 0, 0xD8392B, a);
+			std::vector<std::pair<double, double> > in{ { cx, cy - d * 0.38 }, { cx + d * 0.38, cy }, { cx, cy + d * 0.38 }, { cx - d * 0.38, cy } };
+			poly(in, 0, 0x3A0E0A, 220);
+			break;
+		}
+		case PIN_MISSION:                   // triangle: orange
+		{
+			const double d = s * 1.35;
+			std::vector<std::pair<double, double> > tri{ { cx, cy - d }, { cx + d * 0.95, cy + d * 0.7 }, { cx - d * 0.95, cy + d * 0.7 } };
+			poly(tri, o * 1.5, S_INK, 230);
+			poly(tri, 0, 0xE8873A, a);
+			break;
+		}
+		case PIN_CONTACT:                   // ring: white
+			ringAA(cx, cy, s * 0.55 - o, s * 1.1 + o, S_INK, 200);
+			ringAA(cx, cy, s * 0.62, s * 1.0, 0xF4F3EE, a);
+			ringAA(cx, cy, 0, s * 0.2, 0xF4F3EE, a);
+			break;
+		case PIN_JOE_CRAFT:                 // arrowhead: cyan
+		{
+			const double d = s * 1.25;
+			std::vector<std::pair<double, double> > hd{ { cx, cy - d }, { cx + d * 0.8, cy + d * 0.8 }, { cx, cy + d * 0.35 }, { cx - d * 0.8, cy + d * 0.8 } };
+			// not convex, so two halves
+			std::vector<std::pair<double, double> > L{ hd[0], hd[2], hd[3] }, Rr{ hd[0], hd[1], hd[2] };
+			poly(L, o * 1.4, S_INK, 220); poly(Rr, o * 1.4, S_INK, 220);
+			poly(L, 0, 0x45D3E8, a); poly(Rr, 0, 0x45D3E8, a);
+			break;
+		}
+		case PIN_WAYPOINT:                  // small cross: cyan
+			roundRect(cx - s * 0.9, cy - k * 0.45, cx + s * 0.9, cy + k * 0.45, k * 0.2, 0x45D3E8, a);
+			roundRect(cx - k * 0.45, cy - s * 0.9, cx + k * 0.45, cy + s * 0.9, k * 0.2, 0x45D3E8, a);
+			break;
+		case PIN_CITY:                      // dot: bone
+			ringAA(cx, cy, 0, k * 0.75 + o * 0.6, S_INK, 200);
+			ringAA(cx, cy, 0, k * 0.75, S_TEXT, 255);
+			break;
+		}
+	}
+
+	void globeLabel(const GlobeLabel &l)
+	{
+		const Face *f = face("label");
+		if (!f || l.text.empty()) return;
+		const double k = SK();
+		const double cap = (l.kind == 0 ? 3.4 : 2.9) * k;
+		const double size = cap * f->em / f->cap;
+		const double w = smallCapsWidth(*f, l.text, size);
+		const double x = DX(l.x) - w / 2, top = DY(l.y) + k * 0.6, baseline = top + cap;
+		const Uint32 col = l.kind == 0 ? S_TEXT : l.kind == 1 ? S_MUTED : l.kind == 2 ? S_YELLOW : 0xC9A13E;
+		// the base pixels the type covers, outline included
+		const double pad = k * 0.6;
+		R r{ (int)std::floor((x - pad - xs[0]) / k), (int)std::floor((top - pad - ys[0]) / k), (int)std::ceil((x + w + pad - xs[0]) / k), (int)std::ceil((baseline + pad - ys[0]) / k) };
+		globeClaimRect(r);
+		// a dark outline all round, then the letters
+		const double ow = std::max(1.5, k * 0.33);
+		clipToGlobe(x - pad, top - pad - cap, x + w + pad, baseline + pad + cap, [&]()
+		{
+			for (int dy = -1; dy <= 1; ++dy)
+				for (int dx = -1; dx <= 1; ++dx)
+					if (dx || dy) smallCaps(*f, l.text, x + dx * ow, baseline + dy * ow, size, S_INK);
+			smallCaps(*f, l.text, x, baseline, size, col);
+		});
+	}
+}
+
+bool enabled()
+{
+	static int on = -1;
+	if (on < 0)
+	{
+		const char *e = getenv("OXCE_HIUI");
+		on = e ? (atoi(e) != 0) : HiColor::enabled();
+	}
+	return on != 0;
+}
+
+void registerFontImage(const Surface *sheet8, const std::string &file)
+{
+	if (!enabled() || !sheet8) return;
+	const auto dot = file.find_last_of('.');
+	if (dot == std::string::npos) return;
+	const std::string twin = file.substr(0, dot) + "_hi.png";
+	if (!FileMap::fileExists(twin)) return;
+	SDL_Surface *img = IMG_Load_RW(FileMap::getRWops(twin), SDL_TRUE);
+	if (!img) return;
+	SDL_PixelFormat fmt = {};
+	fmt.BitsPerPixel = 32; fmt.BytesPerPixel = 4;
