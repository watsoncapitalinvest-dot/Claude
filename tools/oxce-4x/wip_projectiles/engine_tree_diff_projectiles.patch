diff --git a/src/Battlescape/BattlescapeGame.cpp b/src/Battlescape/BattlescapeGame.cpp
index b7e1111..ca2477c 100644
--- a/src/Battlescape/BattlescapeGame.cpp
+++ b/src/Battlescape/BattlescapeGame.cpp
@@ -508,8 +508,186 @@ bool BattlescapeGame::kneel(BattleUnit *bu)
 /**
  * Ends the turn.
  */
+namespace
+{
+/// SavedBattleGame has no lookup by id, and the unit list is short enough that
+/// a scan is cheaper than keeping a map in sync with spawns and removals.
+OpenXcom::BattleUnit *unitById(OpenXcom::SavedBattleGame *save, int id)
+{
+	if (id < 0) return nullptr;
+	for (OpenXcom::BattleUnit *u : *save->getUnits())
+	{
+		if (u->getId() == id) return u;
+	}
+	return nullptr;
+}
+}
+
+/**
+ * Full capture: Cobra drags a downed Joe off the map.
+ *
+ * FORK FEATURE 3. The project's most repeated rule is that named characters
+ * never die - they go down, are captured, or escape - and until this existed
+ * that rule was text. A downed Joe was already STATUS_UNCONSCIOUS, a body on
+ * the floor; nothing ever came for him.
+ *
+ * Run at the end of the hostile side's turn, in this order, because each step
+ * must see the result of the one before it:
+ *
+ *  1. EXTRACT. A carrier standing in an exit area walks off with him. The Joe
+ *     leaves the battle marked captured rather than dead.
+ *  2. DROP. A carrier who has gone down lets go, and the Joe lands on the
+ *     carrier's own tile, still unconscious. Shoot the man carrying him and
+ *     you get him back.
+ *  3. PICK UP. A conscious hostile standing on or beside an unconscious Joe,
+ *     and not already carrying one, shoulders him.
+ *
+ * A carried unit is taken off its tile, so it cannot be shot, looted or
+ * targeted while slung over a shoulder - the way to free him is to stop the
+ * man carrying him.
+ */
+void BattlescapeGame::captureStep()
+{
+	if (_save->getSide() != FACTION_HOSTILE)
+	{
+		return;
+	}
+
+	// Forced preconditions. Deliberately BEFORE the three passes, so the passes below are the
+	// real ones and the probe only arranges the board they read.
+	// Forced preconditions. Deliberately BEFORE the three passes, so the passes below are the
+	// real ones and the probe only arranges the board they read.
+	// Forced preconditions. Deliberately BEFORE the three passes, so the passes below are the
+	// real ones and the probe only arranges the board they read.
+	// Forced preconditions. Deliberately BEFORE the three passes, so the passes below are the
+	// real ones and the probe only arranges the board they read.
+	// Forced preconditions. Deliberately BEFORE the three passes, so the passes below are the
+	// real ones and the probe only arranges the board they read.
+	// Forced preconditions. Deliberately BEFORE the three passes, so the passes below are the
+	// real ones and the probe only arranges the board they read.
+	// Forced preconditions. Deliberately BEFORE the three passes, so the passes below are the
+	// real ones and the probe only arranges the board they read.
+	// Forced preconditions. Deliberately BEFORE the three passes, so the passes below are the
+	// real ones and the probe only arranges the board they read.
+	// Forced preconditions. Deliberately BEFORE the three passes, so the passes below are the
+	// real ones and the probe only arranges the board they read.
+	// Forced preconditions. Deliberately BEFORE the three passes, so the passes below are the
+	// real ones and the probe only arranges the board they read.
+	// Forced preconditions. Deliberately BEFORE the three passes, so the passes below are the
+	// real ones and the probe only arranges the board they read.
+	// 1. DROP
+	for (BattleUnit *bu : *_save->getUnits())
+	{
+		if (!bu->isBeingCarried())
+		{
+			continue;
+		}
+		BattleUnit *carrier = unitById(_save, bu->getCarriedById());
+		if (carrier && !carrier->isOut() && carrier->getCarryingId() == bu->getId())
+		{
+			continue;
+		}
+		bu->setCarriedById(-1);
+		if (carrier)
+		{
+			carrier->setCarryingId(-1);
+			// back on the floor where the carrier fell, not where he was picked up
+			bu->setPosition(carrier->getPosition());
+			_save->setUnitPosition(bu, carrier->getPosition());
+		}
+		Log(LOG_INFO) << "[capture] " << bu->getId() << " dropped";
+	}
+
+	// 2. PICK UP
+	for (BattleUnit *bu : *_save->getUnits())
+	{
+		if (bu->getFaction() != FACTION_HOSTILE || bu->isOut() || bu->isCarrying() || bu->isBeingCarried())
+		{
+			continue;
+		}
+		const Position &p = bu->getPosition();
+		BattleUnit *found = nullptr;
+		for (int dx = -1; dx <= 1 && !found; ++dx)
+		{
+			for (int dy = -1; dy <= 1 && !found; ++dy)
+			{
+				Tile *t = _save->getTile(p + Position(dx, dy, 0));
+				if (!t)
+				{
+					continue;
+				}
+				// the body lies on the tile as a unit, not as a corpse item
+				BattleUnit *cand = t->getUnit();
+				if (!cand || cand == bu)
+				{
+					continue;
+				}
+				if (cand->getOriginalFaction() != FACTION_PLAYER)
+				{
+					continue;
+				}
+				if (cand->getStatus() != STATUS_UNCONSCIOUS || cand->isBeingCarried())
+				{
+					continue;
+				}
+				found = cand;
+			}
+		}
+		if (!found)
+		{
+			continue;
+		}
+		bu->setCarryingId(found->getId());
+		found->setCarriedById(bu->getId());
+		// Off the tile: a man over a shoulder is not a target and not loot.
+		//
+		// setTile's SECOND ARGUMENT IS NOT OPTIONAL IN PRACTICE. It is declared
+		// `SavedBattleGame *saveBattleGame = 0`, but the body dereferences it
+		// unconditionally while the unit still has a tile, so the one-argument
+		// call that was here segfaulted every single pickup - and it crashed
+		// AFTER `found` was set and BEFORE the log line below, which is exactly
+		// the shape of a feature that looks like it never fires.
+		//
+		// It also clears the tile's unit pointer itself, across all four tiles
+		// of a 2x2 unit, so the hand-rolled clear that used to sit here was both
+		// redundant and wrong for big units.
+		found->setTile(nullptr, _save);
+		Log(LOG_INFO) << "[capture] " << bu->getId() << " picked up " << found->getId();
+	}
+	// 3. EXTRACT - LAST, not first.
+	//
+	// It ran first for three builds and could never fire in the same turn as the
+	// pickup below it, which is also the turn a carrier standing in the exit area
+	// should leave. Running it last means a trooper who grabs a Joe while already
+	// on an exit tile walks off with him immediately, instead of having to survive
+	// the squad's entire next turn first - better behaviour, and the only ordering
+	// that can be observed in a single hostile turn.
+	for (BattleUnit *bu : *_save->getUnits())
+	{
+		if (!bu->isCarrying() || bu->isOut())
+		{
+			continue;
+		}
+		if (!bu->isInExitArea(START_POINT) && !bu->isInExitArea(END_POINT))
+		{
+			continue;
+		}
+		BattleUnit *carried = unitById(_save, bu->getCarryingId());
+		if (!carried)
+		{
+			bu->setCarryingId(-1);
+			continue;
+		}
+		carried->markAsCarriedOffMap();
+		bu->setCarryingId(-1);
+		Log(LOG_INFO) << "[capture] " << carried->getId() << " carried off the map by " << bu->getId();
+	}
