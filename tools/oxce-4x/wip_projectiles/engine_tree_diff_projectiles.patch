+void globeFloor(const Surface *globe)
+{
+	if (!base || !G.have || G.v.globe != globe || !shown(globe) || !base->format->palette) return;
+	globeTexture();
+	globeGeometry();
+	globeShade();
+	const SDL_Color *pal = base->format->palette->colors;
+	SDL_Surface *gs = const_cast<Surface*>(globe)->getSurface();
+	if (!gs || gs->format->BitsPerPixel != 8) return;
+	const int gx = globe->getX(), gy = globe->getY();
+	{
+		R gr{ gx, gy, gx + globe->getWidth(), gy + globe->getHeight() };
+		if (!clipBase(gr)) return;
+		gbx0 = gr.x0; gby0 = gr.y0; gbx1 = gr.x1; gby1 = gr.y1;
+		gcx0 = xs[gr.x0]; gcy0 = ys[gr.y0]; gcx1 = xs[gr.x1]; gcy1 = ys[gr.y1];
+	}
+	// 1. Every base pixel the disc touches is the overlay's from here on. Its
+	// block starts as what was there - black where the 8-bit globe was, the sky's
+	// own colour where it was not - so the anti-aliased limb blends onto sky.
+	{
+		R r{ gx, gy, gx + globe->getWidth(), gy + globe->getHeight() };
+		if (clipBase(r))
+		{
+			const double lim = G.v.radius + 1.0, lim2 = lim * lim;
+			for (int by = r.y0; by < r.y1; ++by)
+			{
+				const double dy = by + 0.5 - G.v.cenY;
+				if (dy * dy > lim2) continue;
+				const Uint8 *p = row8(by);
+				const Uint8 *g8 = (const Uint8*)gs->pixels + (by - gy) * gs->pitch;
+				for (int bx = r.x0; bx < r.x1; ++bx)
+				{
+					const double dx = bx + 0.5 - G.v.cenX;
+					if (dx * dx + dy * dy > lim2) continue;
+					const Uint32 flat = g8[bx - gx] ? 0u : rgb(pal[p[bx]].r, pal[p[bx]].g, pal[p[bx]].b);
+					fillRect(xs[bx], ys[by], xs[bx + 1], ys[by + 1], flat);
+					const size_t bi = (size_t)by * bw + bx;
+					tag[bi] = p[bx]; valid[bi] = 1;
+				}
+			}
+			any = true;
+		}
+	}
+	// 2. the earth
+	{
+		const int W = G.X1 - G.X0, H = G.Y1 - G.Y0;
+		if (G.out.size() == (size_t)W * H)
+			for (int Y = 0; Y < H; ++Y)
+			{
+				const int SY = G.Y0 + Y;
+				if (SY < 0 || SY >= sh) continue;
+				Uint32 *o = over.data() + (size_t)SY * sw;
+				const Uint32 *src = G.out.data() + (size_t)Y * W;
+				const Uint8 *cv = G.cov.data() + (size_t)Y * W;
+				for (int X = 0; X < W; ++X)
+				{
+					const int SX = G.X0 + X;
+					if (SX < 0 || SX >= sw || !cv[X]) continue;
+					o[SX] = cv[X] == 255 ? src[X] : mix(o[SX], src[X], cv[X]);
+				}
+			}
+	}
+	// 3. the player's own marks, crisp from their frames
+	for (const GlobeArt &a : G.art)
+	{
+		if (!a.frame) continue;
+		const int fw = a.frame->getWidth(), fh = a.frame->getHeight();
+		const int x0 = (int)std::floor(a.x), y0 = (int)std::floor(a.y);
+		globeClaimRect(R{ x0, y0, x0 + fw, y0 + fh });
+		if (const Img *im = flatTwin(a.frame))
+			clipToGlobe(DX(x0), DY(y0), DX(x0 + fw), DY(y0 + fh), [&]() { stretch(*im, 0, 0, im->w, im->h, (int)DX(x0), (int)DY(y0), (int)DX(x0 + fw), (int)DY(y0 + fh)); });
+	}
+	// 4. pins, then 5. labels over them
+	for (const GlobePin &p : G.pins)
+	{
+		const int e = 5;
+		globeClaimRect(R{ (int)std::floor(p.x) - e, (int)std::floor(p.y) - e, (int)std::floor(p.x) + e + 1, (int)std::floor(p.y) + e + 1 });
+		const double k = SK(), e2 = k * 5;
+		clipToGlobe(DX(p.x) - e2, DY(p.y) - e2, DX(p.x) + e2, DY(p.y) + e2, [&]() { globePin(p); });
+	}
+	for (const GlobeLabel &l : G.labels) globeLabel(l);
+}
