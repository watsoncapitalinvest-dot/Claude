+
+void nativeForget(const Surface *s)
+{
+	if (s && s == hudBar) { hudBar = nullptr; hudMission = nullptr; hud.on = false; hudArt.clear(); }
+	nativeKeyStyles.erase(s);
+	nativeBgs.erase(s); nativeKeys.erase(s); nativeKeyInArt.erase(s); nativeTexts.erase(s);
+}
+
+void surfaceGone(const Surface *s)
+{
+	// Everything here is keyed by pointer. A surface that was registered and then
+	// freed - an intro slide - left its twin behind, and the next surface the
+	// allocator put at that address inherited the picture: the geoscape's
+	// rotate-up key came out as a black square cut from the end of the intro.
+	if (!s) return;
+	bgImages.erase(s);
+	insets.erase(s);
+	for (auto &kv : insets)
+		kv.second.erase(std::remove_if(kv.second.begin(), kv.second.end(), [s](const Inset &e) { return e.src == s; }), kv.second.end());
+	textInks.erase(s); pixelTexts.erase(s); textFaces.erase(s);
+	nativeForget(s);
+	if (G.v.globe == s) globeForget(s);
+}
+
+bool nativeOn()
+{
+	return enabled() && !nativeBgs.empty();
