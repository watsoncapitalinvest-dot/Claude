+namespace
+{
+/// Hand positions per frame of a whole-body sheet, in 4x cell pixels:
+/// Resources/Units/anchors/<sheet type>.txt, "frame rx ry lx ly" a line.
+struct HandAnchor { float rx, ry, lx, ly; };
+const std::vector<HandAnchor> &handAnchors(const std::string &sheet)
+{
+	static std::map<std::string, std::vector<HandAnchor> > cache;
+	auto it = cache.find(sheet);
+	if (it != cache.end()) return it->second;
+	std::vector<HandAnchor> v;
+	const std::string path = "Resources/Units/anchors/" + sheet + ".txt";
+	if (FileMap::fileExists(path))
+	{
+		auto in = FileMap::getIStream(path);
+		int n; HandAnchor a;
+		while (in && (*in >> n >> a.rx >> a.ry >> a.lx >> a.ly))
+		{
+			if (n >= 0) { if ((int)v.size() <= n) v.resize(n + 1, HandAnchor{ -1, -1, -1, -1 }); v[n] = a; }
+		}
+	}
+	else Log(LOG_WARNING) << "No hand anchors for " << sheet << " (" << path << ")";
+	return cache.emplace(sheet, std::move(v)).first->second;
+}
+/// Centre of a held-weapon frame's ink, cached: the point that goes in the hands.
+std::pair<float, float> inkCentre(const Surface *s)
+{
+	static std::map<const Surface*, std::pair<float, float> > cache;
+	auto it = cache.find(s);
+	if (it != cache.end()) return it->second;
+	double sx = 0, sy = 0; long n = 0;
+	SDL_Surface *ss = const_cast<Surface*>(s)->getSurface();
+	for (int y = 0; ss && y < ss->h; ++y)
+		for (int x = 0; x < ss->w; ++x)
+			if (((const Uint8*)ss->pixels)[y * ss->pitch + x]) { sx += x; sy += y; ++n; }
+	auto r = n ? std::make_pair((float)(sx / n), (float)(sy / n)) : std::make_pair(s->getWidth() / 2.f, s->getHeight() / 2.f);
+	cache[s] = r;
+	return r;
+}
+}
+
+/**
+ * WHOLE-BODY FRAMES (drawing routine 23), for soldiers rendered from a rigged
+ * model: one picture per state, facing and frame instead of X-COM's torso, legs
+ * and arms. Sheet layout, 4x cells: frame = clip * 64 + direction * 8 + f, with
+ * clips stand, walk, kneel, aim, death. The weapon in hand is the item's own
+ * held sprite, its centre put between the hands the render recorded for that
+ * exact frame - so any weapon sits in the hands, and follows them as he walks.
+ */
+void UnitSprite::drawRoutineWhole()
+{
+	Part body{ BODYPART_TORSO }, itemR{ BODYPART_ITEM_RIGHTHAND }, itemL{ BODYPART_ITEM_LEFTHAND };
+	const int dir = _unit->getDirection();
+	int clip = 0, f = (_animationFrame / 2) % 8;
+	if (_unit->getStatus() == STATUS_COLLAPSING)
+	{
+		clip = 4;
+		const int n = std::max(1, _unit->getArmor()->getDeathFrames());
+		f = std::min(7, _unit->getFallingPhase() * 8 / n);
+	}
+	else if (_unit->getStatus() == STATUS_WALKING) { clip = 1; f = _unit->getWalkingPhase() % 8; }
+	else if (_unit->getStatus() == STATUS_AIMING) clip = 3;
+	else if (_unit->isKneeled()) clip = 2;
+	// ONE-HANDED CLIPS. A sheet with eight clips carries a pistol stance after the
+	// five stock ones: 5 stand (also aim), 6 walk, 7 kneel. Used only when the
+	// unit holds something and nothing it holds is two-handed. Death stays 4,
+	// and a five-clip sheet never gets here, so it draws exactly as before.
+	if (clip != 4 && _unitSurface && _unitSurface->getTotalFrames() >= 8 * 64)
+	{
+		const BattleItem *r = _unit->getRightHandWeapon(), *l = _unit->getLeftHandWeapon();
+		const bool holds = r || l;
+		const bool twoHanded = (r && r->getRules()->isTwoHanded()) || (l && l->getRules()->isTwoHanded());
+		if (holds && !twoHanded)
+		{
+			if (clip == 0 || clip == 3) clip = 5;
+			else if (clip == 1) clip = 6;
+			else if (clip == 2) clip = 7;
+		}
+	}
+	const int frame = clip * 64 + dir * 8 + f;
+	selectUnit(body, clip * 64 + dir * 8, f);
+
+	const int k = std::max(1, SurfaceSet::battleScale());
+	const auto &anch = handAnchors(_unit->getArmor()->getSpriteSheet());
+	auto hold = [&](Part &p, const BattleItem *item, bool right)
+	{
+		if (!item || _unit->getStatus() == STATUS_COLLAPSING) return;
+		selectItem(p, item, dir);
+		if (!p.src || frame >= (int)anch.size() || anch[frame].rx < 0) return;
+		const HandAnchor &a = anch[frame];
+		const bool twoHands = item->getRules()->isTwoHanded();
+		const float hx = twoHands ? (a.rx + a.lx) / 2 : (right ? a.rx : a.lx);
+		const float hy = twoHands ? (a.ry + a.ly) / 2 : (right ? a.ry : a.ly);
+		const auto c = inkCentre(p.src);
+		p.offX = (int)std::lround((hx - c.first) / k);
+		p.offY = (int)std::lround((hy - c.second) / k);
+	};
+	sortRifles();
+	hold(itemR, _itemR, true);
+	hold(itemL, _itemL, false);
+	// seen from behind (up-left, up, up-right on screen) the weapon is in front of
+	// him and so behind him in the picture
+	const bool fromBehind = dir == 7 || dir == 0 || dir == 6;
+	if (fromBehind) { blitItem(itemR); blitItem(itemL); blitBody(body); }
+	else { blitBody(body); blitItem(itemR); blitItem(itemL); }
+}
