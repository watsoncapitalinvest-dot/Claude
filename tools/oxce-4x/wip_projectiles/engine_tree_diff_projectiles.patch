+	{
+		int trust = m.trust;
+		if (m.fromIntel && month >= 0 && month - m.placedMonth >= MARK_STALE_MONTHS)
+		{
+			trust = std::max((int)GlobeMark::TRUST_RUMOUR, trust - 1);
+		}
