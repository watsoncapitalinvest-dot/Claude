+void vectorFloor(const Surface *floor)
+{
+	if (!base || !floor) return;
+	if (vtag.size() != (size_t)bw * bh) { vtag.assign((size_t)bw * bh, 0); vvalid.assign((size_t)bw * bh, 0); }
+	else std::fill(vvalid.begin(), vvalid.end(), 0);
+	SDL_Surface *own = const_cast<Surface*>(floor)->getSurface();
+	if (!own || own->format->BitsPerPixel != 8) return;
+	const int fx = floor->getX(), fy = floor->getY();
+	for (int y = 0; y < own->h; ++y)
+	{
+		const int by = fy + y;
+		if (by < 0 || by >= bh) continue;
+		const Uint8 *src = (const Uint8*)own->pixels + y * own->pitch;
+		const Uint8 *dst = row8(by);
+		for (int x = 0; x < own->w; ++x)
+		{
+			const int bx = fx + x;
+			if (bx < 0 || bx >= bw || !src[x]) continue;   // 0 is space: no line there
+			vvalid[(size_t)by * bw + bx] = 1;
+			vtag[(size_t)by * bw + bx] = dst[bx];
+		}
+	}
+	vHave = true;
+}
