+/**
+ * Blits the strip, then has HiUI draw it again at display resolution.
+ */
+void MiniBaseView::blit(SDL_Surface *surface)
+{
+	Surface::blit(surface);
+	if (!HiUI::enabled() || !_bases) return;
+	std::vector<HiUI::MiniBase> mb;
+	for (size_t i = 0; i < MAX_BASES; ++i)
+	{
+		HiUI::MiniBase b{ i < _bases->size(), i == _base, {} };
+		if (b.exists)
+			for (const auto *fac : *_bases->at(i)->getFacilities())
+				b.rooms.emplace_back(SDL_Rect{ (Sint16)fac->getX(), (Sint16)fac->getY(), (Uint16)fac->getRules()->getSizeX(), (Uint16)fac->getRules()->getSizeY() },
+					fac->getDisabled() ? 2 : fac->getBuildTime() > 0 ? 1 : 0);
+		mb.push_back(b);
+	}
+	HiUI::nativeMiniBases(this, MINI_SIZE + 2, mb);
+}
+
 }
