+	const Img *roomShell(const std::string &theme, int w, int h, int dw, int dh)
+	{
+		static std::unordered_map<std::string, Img> src, sized;
+		const std::string id = theme + "_" + std::to_string(w) + "x" + std::to_string(h);
+		auto s = src.find(id);
+		if (s == src.end()) s = src.emplace(id, loadPng("Resources/Base/shells/shell_" + id + ".png")).first;
+		if (!s->second.ok || dw <= 0 || dh <= 0) return nullptr;
+		const std::string key = id + "@" + std::to_string(dw) + "x" + std::to_string(dh);
+		auto z = sized.find(key);
+		if (z == sized.end()) z = sized.emplace(key, resampleArea(s->second, dw, dh)).first;
+		return &z->second;
+	}
