+ * @param monthsPassed Campaign months elapsed.
+ * @return The tier ceiling, or -1 when the ruleset sets none.
+ */
+int Mod::getCobraKitTierCap(size_t monthsPassed) const
+{
+	int cap = -1;
+	for (const auto& entry : _cobraKitTierByMonth)
+	{
+		if (entry.first > monthsPassed)
