# The battlefield's shots, in the Saturday-morning cartoon look (12 Nov 2026).
# Joe fire is BLUE, Cobra fire is RED. Rockets and missiles point where they fly.
#
# Sheet: build/make_projectile_sheet.py (bodies from build/sprites/render_projectile.py).
# 48x48 frames, 35 per row, rows from bulletSprite 11 so vanilla's eleven rows stay as they were.
# The engine sizes the Projectiles set from the largest subX/subY declared here; vanilla's 3x3
# bullets still load into it, scaled up and centred (ENGINE_NOTES.md, projectiles).
#
#  11 tracer          small yellow-white head, short tail
#  12 tracer_heavy    the same, a size up
#  13 laser_joe       blue bolt, white core, long glow
#  14 laser_cobra     red bolt
#  15 pulse_cobra     fat red-magenta blob, short and chunky
#  16 pulse_joe       the same in blue
#  17 ball            grenade / M-32 round, dark, no glow
#  18 rocket          smoke trail; 19 = its 8 bodies by screen direction
#  20 missile         smoke trail; 21 = its 8 bodies by screen direction
#
# bulletDirectional (engine, G.I. Joe 4x): the row AFTER bulletSprite holds eight heads by the
# direction the shot travels on screen, 0 = nose up, clockwise in 45-degree steps.
extraSprites:
  - type: Projectiles
    width: 1680
    height: 528
    subX: 48
    subY: 48
    files:
      385: Resources/Projectiles/projectiles.png

items:
  # bullets - both armies' conventional guns
  - type: STR_PISTOL              # Uzi (Cobra carries it too, months 1-3)
    bulletSprite: 11
  - type: STR_RIFLE               # M4 Carbine (and Cobra's rifle, months 4-8)
    bulletSprite: 11
  - type: STR_LASER_RIFLE         # Sniper Rifle - a conventional rifle on the laser id
    bulletSprite: 11
  - type: STR_HEAVY_CANNON        # .50 Cal
    bulletSprite: 12
  - type: STR_TANK_CANNON         # MOBAT/Cannon
    bulletSprite: 12

  # Joe lasers - blue
  - type: STR_LASER_PISTOL        # laser pistol prototype, topic 1-10
    bulletSprite: 13
  - type: STR_HEAVY_LASER
    bulletSprite: 13
  - type: STR_TANK_LASER_CANNON   # MOBAT/Laser Cannon
    bulletSprite: 13

  # Cobra lasers - red (the B.A.T.s' built-in guns)
  - type: SECTOPOD_WEAPON         # B.A.T. Heavy Weapon
    bulletSprite: 14
  - type: CYBERDISC_WEAPON        # B.A.T. Drone Weapon
    bulletSprite: 14

  # pulse - Cobra red-magenta, Joe blue
  - type: STR_PLASMA_PISTOL       # Pulse Pistol
    bulletSprite: 15
  - type: STR_PLASMA_RIFLE        # Pulse Rifle
    bulletSprite: 15
  - type: STR_HEAVY_PLASMA        # Heavy Pulse
    bulletSprite: 15
  - type: CELATID_WEAPON          # B.A.T. Sentry Weapon
    bulletSprite: 15
  - type: STR_HOVERTANK_PLASMA    # HAVOC/Pulse
    bulletSprite: 16

  # grenade rounds
  - type: STR_AUTO_CANNON         # M-32 Launcher
    bulletSprite: 17
  - type: STR_SMALL_LAUNCHER      # Cobra's stun launcher
    bulletSprite: 17

  # rockets and missiles - they point where they fly
  - type: STR_ROCKET_LAUNCHER     # RPG-7
    bulletSprite: 18
    bulletDirectional: true
  - type: STR_TANK_ROCKET_LAUNCHER  # MOBAT/Rocket Launcher
    bulletSprite: 18
    bulletDirectional: true
  - type: STR_HOVERTANK_LAUNCHER  # HAVOC/Launcher
    bulletSprite: 20
    bulletDirectional: true
  - type: STR_BLASTER_LAUNCHER
    bulletSprite: 20
    bulletDirectional: true
