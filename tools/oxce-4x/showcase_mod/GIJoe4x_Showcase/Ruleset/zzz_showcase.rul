# SHOWCASE (test level, not part of the campaign). Load after GIJoe4x.
# Every Joe on the books rides the APC; the Day 1 Cartel Ranch is replaced by every Cobra unit we
# have, each carrying a gun and NO ammunition. The ranch shows up a few minutes into a new game.

crafts:
  - type: STR_APC
    soldiers: 25          # all 16 named Joes, 6 riflemen, 2 medics and the pilot

startingBase:
  facilities:
    - type: STR_ACCESS_LIFT
      x: 2
      y: 2
    - type: STR_HANGAR
      x: 2
      y: 0
    - type: STR_LIVING_QUARTERS
      x: 3
      y: 2
    - type: STR_GENERAL_STORES
      x: 2
      y: 3
    - type: STR_LABORATORY
      x: 3
      y: 3
  # the starting 16 named Joes and 8 greenshirts (section 2). STR_SOLDIER is Roadblock.
  randomSoldiers:
    STR_HAWK: 1
    STR_DUKE: 1
    STR_SOLDIER: 1
    STR_ROCK_N_ROLL: 1
    STR_GRAND_SLAM: 1
    STR_SHORT_FUZE: 1
    STR_ZAP: 1
    STR_GRUNT: 1
    STR_STALKER: 1
    STR_BREAKER: 1
    STR_FLASH: 1
    STR_SCARLETT: 1
    STR_SNAKE_EYES: 1
    STR_DOC: 1
    STR_ACE: 1
    STR_AIRBORNE: 1
    STR_REGULAR_JOE: 6
    STR_JOE_MEDIC: 2
    STR_JOE_PILOT: 1          # showcase: the pilot too
  crafts:
    - type: STR_APC
      id: 1
      fuel: 3000
      damage: 0
      status: STR_READY
      # Loaded for the first mission, as stock X-COM loads its Skyranger. Taken out of the stores
      # below, so the Day 1 totals are unchanged.
      items:
        STR_RIFLE: 10
        STR_RIFLE_CLIP: 30
        STR_PISTOL: 2
        STR_PISTOL_CLIP: 8
        STR_GRENADE: 12
        STR_SMOKE_GRENADE: 6
        STR_MEDI_KIT: 2
        STR_HEAVY_CANNON: 1
        STR_HC_AP_AMMO: 3
        STR_ROCKET_LAUNCHER: 1
        STR_SMALL_ROCKET: 3
  # Section 5, with the guns that exist as items today (SHORTCUT #7): the M4 Carbine for the
  # M-16, the Uzi for the pistol; no shotguns or flak vests yet; signature weapons where the
  # gun exists (Roadblock's .50 cal, Duke's M-32, Zap's launcher). 4 clips a gun.
  items:
    STR_RIFLE_CLIP: 10
    STR_PISTOL: 4
    STR_PISTOL_CLIP: 16
    STR_GRENADE: 8
    STR_SMOKE_GRENADE: 4
    STR_MEDI_KIT: 2
    STR_HC_AP_AMMO: 1
    STR_AUTO_CANNON: 1
    STR_AC_AP_AMMO: 4
    STR_SMALL_ROCKET: 1
  scientists: 10
  engineers: 10

missionScripts:
  - type: cartelRanchOpening
    startDelay: 5

alienDeployments:
  - type: STR_CARTEL_RANCH
    data:
      - alienRank: 0
        lowQty: 1
        highQty: 1
        dQty: 0
        percentageOutsideUfo: 100
        itemSets:
          - [STR_PISTOL]
          - [STR_PISTOL]
          - [STR_PISTOL]
      - alienRank: 1
        lowQty: 1
        highQty: 1
        dQty: 0
        percentageOutsideUfo: 100
        itemSets:
          - [STR_RIFLE]
          - [STR_RIFLE]
          - [STR_RIFLE]
      - alienRank: 2
        lowQty: 1
        highQty: 1
        dQty: 0
        percentageOutsideUfo: 100
        itemSets:
          - [STR_RIFLE]
          - [STR_RIFLE]
          - [STR_RIFLE]
      - alienRank: 3
        lowQty: 1
        highQty: 1
        dQty: 0
        percentageOutsideUfo: 100
        itemSets:
          - [STR_PISTOL]
          - [STR_PISTOL]
          - [STR_PISTOL]
      - alienRank: 4
        lowQty: 1
        highQty: 1
        dQty: 0
        percentageOutsideUfo: 100
        itemSets:
          - [STR_PISTOL]
          - [STR_PISTOL]
          - [STR_PISTOL]
      - alienRank: 5
        lowQty: 4
        highQty: 4
        dQty: 0
        percentageOutsideUfo: 100
        itemSets:
          - [STR_RIFLE]
          - [STR_RIFLE]
          - [STR_RIFLE]
      - alienRank: 6
        lowQty: 2
        highQty: 2
        dQty: 0
        percentageOutsideUfo: 100
        itemSets:
          - [STR_RIFLE]
          - [STR_RIFLE]
          - [STR_RIFLE]
    civilians: 0
    briefingData:
      palette: 0
      title: STR_CARTEL_RANCH
      desc: STR_SHOWCASE_BRIEFING

extraStrings:
  - type: en-US
    strings:
      STR_SHOWCASE_BRIEFING: "SHOWCASE. Every Joe we have built against every Cobra we have built: Cobra Commander, Destro, Storm Shadow, the Vipers, Troopers and B.A.T.s. Cobra came to this fight with empty guns."
  - type: en-GB
    strings:
      STR_SHOWCASE_BRIEFING: "SHOWCASE. Every Joe we have built against every Cobra we have built: Cobra Commander, Destro, Storm Shadow, the Vipers, Troopers and B.A.T.s. Cobra came to this fight with empty guns."
