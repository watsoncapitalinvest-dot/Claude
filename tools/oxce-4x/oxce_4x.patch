+const double EARTH_KM = 6371.0;
+}
+
+int SavedGame::cobraBombersInRange(const Mod *mod, const Base *base) const
+{
+	const auto &R = mod->getAirRaidRules();
+	int n = 0;
+	for (const auto *ab : _alienBases)
+	{
+		if (ab->getSiteType().empty()) continue;
+		const RuleCobraSite *r = mod->getCobraSite(ab->getSiteType());
+		if (!r || r->getBombers() <= 0) continue;
+		if (ab->getDistance(base) * EARTH_KM > R.rangeKm) continue;
+		n += std::max(0, r->getBombers() - ab->getBombersLost());
+	}
+	return n;
+}
+
+Base *SavedGame::cobraAirRaidToday(const Mod *mod, int &planes)
+{
+	const auto &R = mod->getAirRaidRules();
+	planes = 0;
+	if (!R.on) return nullptr;
+	for (auto *base : _bases)
+	{
+		// only an outpost Cobra has found (vanilla's retaliation mark: Cobra knows where it is); never the Pit
+		const auto *k = Outposts::kindOf(mod, base);
+		if (!k || k->pit || !base->getRetaliationTarget()) continue;
+		const int have = cobraBombersInRange(mod, base);
+		if (have <= 0) continue;
+		auto t = R.threatByKind.find(k->type);
+		const int threat = t == R.threatByKind.end() ? 1 : t->second;
+		const int monthly = std::min(R.chanceCap, R.chancePerThreat * threat);
+		// a month's chance spread over thirty days
+		if (!getenv("OXCE_AIRRAID_TODAY") && RNG::generate(0, 2999) >= monthly) continue;   // monthly% / 30 a day (rig: OXCE_AIRRAID_TODAY)
+		// how many it sends follows the motive (s.1): a first look is one plane; a strike, two or three;
+		// back at a place it has hit before and that is still mending, everything it has
+		bool mending = false;
+		for (const auto *f : *base->getFacilities()) if (f->getBuildTime() > 0 && f->getBuildTime() < f->getRules()->getBuildTime()) mending = true;
+		if (base->getAirRaids() == 0) planes = 1;
+		else if (mending) planes = have;
+		else planes = RNG::generate(2, 3);
+		planes = std::max(1, std::min({ planes, have, R.maxPlanes }));
+		return base;
+	}
+	return nullptr;
+}
+
+void SavedGame::cobraBombersLost(const Mod *mod, const Base *base, int n)
+{
+	const auto &R = mod->getAirRaidRules();
+	for (auto *ab : _alienBases)
+	{
+		if (n <= 0) break;
+		if (ab->getSiteType().empty()) continue;
+		const RuleCobraSite *r = mod->getCobraSite(ab->getSiteType());
+		if (!r || r->getBombers() <= 0 || ab->getDistance(base) * EARTH_KM > R.rangeKm) continue;
+		const int take = std::min(n, r->getBombers() - ab->getBombersLost());
+		if (take <= 0) continue;
+		ab->setBombersLost(ab->getBombersLost() + take);
+		if (ab->getBomberRebuildDays() <= 0) ab->setBomberRebuildDays(R.bomberRebuildDays);
+		n -= take;
+	}
+}
