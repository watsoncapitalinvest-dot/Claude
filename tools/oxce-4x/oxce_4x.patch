+	// glyphs leaves a button with nothing written on it and no way back.
+	// With dry = true nothing is drawn and only the count is computed.
+	int glyphs(const Text *t, int ox, int oy, const R &clip, Uint32 ink, bool useMask, const R &maskRect, bool dry = false)
+	{
+		const SDL_Color *pal = base->format->palette->colors;
+		int drawn = 0;
+		for (const auto &g : t->getHiGlyphs())
+		{
+			if (!g.sheet) continue;
+			auto it = atlases.find(g.sheet);
+			if (it == atlases.end()) continue;
+			const Atlas &a = it->second;
+			const int bx0 = ox + g.x, by0 = oy + g.y, bx1 = bx0 + g.w, by1 = by0 + g.h;
+			if (bx1 <= clip.x0 || by1 <= clip.y0 || bx0 >= clip.x1 || by0 >= clip.y1) continue;
+			// A glyph whose box crosses the base surface used to be dropped WHOLE,
+			// which is why a label hard against an edge - the geoscape's right-hand
+			// buttons - came out blank, and why LAUNCH INTERCEPTION truncated. Only
+			// the xs/ys lookups need the box in range, so clamp those and let the
+			// inner loops clip per pixel as they already do.
+			if (bx1 <= 0 || by1 <= 0 || bx0 >= bw || by0 >= bh) continue;
+			const int cx0 = std::max(0, std::min(bw, bx0)), cx1 = std::max(0, std::min(bw, bx1));
+			const int cy0 = std::max(0, std::min(bh, by0)), cy1 = std::max(0, std::min(bh, by1));
+			if (cx1 <= cx0 || cy1 <= cy0) continue;
+			++drawn;
+			if (dry) continue;
+			Uint32 col = ink;
+			if (!col)
+			{
+				const SDL_Color &c = pal[g.color];
+				// A STRONGLY SATURATED COLOUR IS A DELIBERATE ONE. DO NOT WASH IT OUT.
+				//
+				// The wash exists because the geoscape palette gives its labels a
+				// scatter of pale blues and greens that read as noise at this size;
+				// pulling them to off-white makes the panel one piece of type. But it
+				// is applied by palette index and cannot tell a default apart from a
+				// choice, so a clock deliberately set to red (252,0,0) came out PINK -
+				// 205/255 of the way to off-white is mostly off-white.
+				//
+				// Saturation separates the two. Nothing in this palette's UI text is
+				// anywhere near this saturated; only a colour picked on purpose is.
+				const int hi = std::max(c.r, std::max(c.g, c.b));
+				const int lo = std::min(c.r, std::min(c.g, c.b));
+				// THE COLOUR IS THE MEANING. John: "all the fonts need to be correct
+				// and colors". The wash used to pull every glyph 205/255 of the way to
+				// off-white so a screen read as one typeface - and in doing so erased
+				// what the colours SAY: green craft rows, yellow READY, a wounded man
+				// in red. The palette's own colour is kept and only lifted a little
+				// toward the light, because the 8-bit text colours were picked to
+				// read against 8-bit backgrounds and some sit dark against the
+				// smoothed ones. Saturated choices are left almost untouched.
+				// KEEP THE HUE, GUARANTEE THE LIGHTNESS. A plain mix toward white has
+				// one knob and it trades the two against each other: at 205/255 every
+				// colour was the same off-white, at 60/255 the dark palette entries
+				// sat dark on dark windows and LAUNCH INTERCEPTION's title all but
+				// vanished. So the colour is taken to HSL, its lightness raised to a
+				// floor that reads on the smoothed backgrounds, its saturation capped
+				// so nothing glares - and green, yellow and red still say what they
+				// said in 8 bits.
+				col = readable(c.r, c.g, c.b, (hi - lo) > 150);
+			}
+			const int X0 = xs[cx0], X1 = xs[cx1], Y0 = ys[cy0], Y1 = ys[cy1];
+			const double kx = (double)((cx1 - cx0) * a.k) / (X1 - X0), ky = (double)((cy1 - cy0) * a.k) / (Y1 - Y0);
+			for (int Y = Y0; Y < Y1; ++Y)
+			{
+				const int by = cy0 + (Y - Y0) * (cy1 - cy0) / (Y1 - Y0);
+				if (by < clip.y0 || by >= clip.y1) continue;
+				const double fy = (g.sy + (cy0 - by0)) * a.k + (Y - Y0 + 0.5) * ky - 0.5; const int sy0 = std::max(0, (int)fy), sy1 = std::min(a.h - 1, sy0 + 1); const int wy = (int)((fy - sy0) * 256);
+				Uint32 *o = over.data() + (size_t)Y * sw;
+				for (int X = X0; X < X1; ++X)
+				{
+					const int bx = cx0 + (X - X0) * (cx1 - cx0) / (X1 - X0);
+					if (bx < clip.x0 || bx >= clip.x1) continue;
+					if (useMask && !scratch[(by - maskRect.y0) * (maskRect.x1 - maskRect.x0) + (bx - maskRect.x0)]) continue;
+					const double fx = (g.sx + (cx0 - bx0)) * a.k + (X - X0 + 0.5) * kx - 0.5; const int sx0 = std::max(0, (int)fx), sx1 = std::min(a.w - 1, sx0 + 1); const int wx = (int)((fx - sx0) * 256);
+					const int c00 = a.cov[(size_t)sy0 * a.w + sx0], c01 = a.cov[(size_t)sy0 * a.w + sx1], c10 = a.cov[(size_t)sy1 * a.w + sx0], c11 = a.cov[(size_t)sy1 * a.w + sx1];
+					const int cov = ((c00 * (256 - wx) + c01 * wx) * (256 - wy) + (c10 * (256 - wx) + c11 * wx) * wy) >> 16;
+					if (cov > 0) o[X] = mix(o[X], col, std::min(255, cov));
+				}
+			}
+		}
+		return drawn;
+	}
