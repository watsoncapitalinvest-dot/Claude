+/**
+ * VECTOR LINES. At 4x every line the globe draws - borders, radar rings, flight
+ * paths, route marks - was one base pixel wide in a 320x200 surface and then
+ * zoomed 5.4 times, which is the staircase on every border. With HiUI on, the
+ * segment is handed over at full precision instead and stroked anti-aliased at
+ * display resolution (HiUI::vectorLine); nothing is drawn into the 8-bit layer,
+ * or the staircase would still show under the stroke.
+ *
+ * Coordinates arrive surface-local and go out in base coordinates.
+ */
+static Uint32 argbOf(const SDL_Color *pal, Uint8 idx, int alpha)
+{
+	const SDL_Color &c = pal[idx];
+	return ((Uint32)alpha << 24) | ((Uint32)c.r << 16) | ((Uint32)c.g << 8) | (Uint32)c.b;
+}
