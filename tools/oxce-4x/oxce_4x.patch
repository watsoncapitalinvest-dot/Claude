+/// a dead body lying on this man's tile or the next one (STEALTH SIGHT item 12: conceal body)
+BattleItem *BattlescapeState::concealTarget(BattleUnit *u)
+{
+	if (!u || !u->getTile()) return nullptr;
+	for (int dx = -1; dx <= 1; ++dx)
+		for (int dy = -1; dy <= 1; ++dy)
+		{
+			Tile *t = _save->getTile(u->getPosition() + Position(dx, dy, 0));
+			if (!t) continue;
+			for (auto *it : *t->getInventory())
+				if (it->getUnit() && it->getUnit()->getStatus() == STATUS_DEAD) return it;
+		}
+	return nullptr;
+}
+
+/// STEALTH SIGHT item 12: the body leaves the map (no dragging); what he carried stays on the tile unless picked up first
+void BattlescapeState::doConceal(BattleUnit *u)
+{
+	BattleItem *corpse = concealTarget(u);
+	if (!corpse || !u->spendTimeUnits(u->getBaseStats()->tu / 2)) { warning("STR_NOT_ENOUGH_TIME_UNITS"); return; }
+	BattleUnit *dead = corpse->getUnit();
+	_save->removeItem(corpse);
+	if (dead) dead->setTile(nullptr, _save);
+	Log(LOG_INFO) << "[stealth] body concealed by " << u->getType();
+	_battleGame->getMap()->draw();
+	refreshJoeHud();
+}
+
+/// STEALTH SIGHT item 8: thrown at the tile the map cursor last pointed to, 12 tiles at most; only TU; noise where it lands
+void BattlescapeState::doDistract(BattleUnit *u)
+{
+	Position at; _battleGame->getMap()->getSelectorPosition(&at);
+	if (!_save->getTile(at) || Position::distance2d(at, u->getPosition()) > 12) { warning("STR_OUT_OF_RANGE"); return; }
+	if (!u->spendTimeUnits(15)) { warning("STR_NOT_ENOUGH_TIME_UNITS"); return; }
+	// John 19 Nov 10:18: "Throw distraction should have you throw like a grenade but it's a rock and creates noise and a
+	// little dust instead of explode". The rock flies the grenade arc (ProjectileFlyBState); where it lands it makes the
+	// noise and a puff of dust and is gone (ProjectileFlyBState, STR_GJ_DISTRACTION_ROCK).
+	if (const RuleItem *rock = _game->getMod()->getItem("STR_GJ_DISTRACTION_ROCK"))
+	{
+		BattleItem *it = _save->createItemForTile(rock, u->getTile());
+		BattleAction a;
+		a.type = BA_THROW; a.actor = u; a.weapon = it; a.target = at;
+		a.cameraPosition = _battleGame->getMap()->getCamera()->getMapOffset();
+		_battleGame->statePushBack(new ProjectileFlyBState(_battleGame, a));
+		_battleGame->statePushFront(new UnitTurnBState(_battleGame, a));
+		Log(LOG_INFO) << "[stealth] distraction rock thrown at " << at.x << "," << at.y << "," << at.z;
+	}
+	else
+	{
+		Stealth::noise(_save, at, 10, u, false);
+		Log(LOG_INFO) << "[stealth] distraction thrown to " << at.x << "," << at.y << "," << at.z;
+	}
+	refreshJoeHud();
+}
+
 }
