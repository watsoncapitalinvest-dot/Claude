+	}
+	ShaderMove<const Uint8> surf{ marker, x - marker->getWidth() / 2, y - marker->getHeight() / 2 };
+	ShaderMove<Uint8> dest{ this };
+	ShaderDrawFunc(
+		[](Uint8& destStuff, Uint8 srcStuff)
+		{
+			if (srcStuff)
+			{
+				destStuff = srcStuff;
+			}
+		},
+		dest,
+		surf
+	);
+}
