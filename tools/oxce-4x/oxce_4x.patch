+	/// Anti-aliased convex polygon, 4x4 supersampled.
+	void polygonAA(const std::vector<std::pair<double, double> > &p, Uint32 col, int alpha = 255)
+	{
+		double x0 = 1e9, y0 = 1e9, x1 = -1e9, y1 = -1e9;
+		for (auto &q : p) { x0 = std::min(x0, q.first); y0 = std::min(y0, q.second); x1 = std::max(x1, q.first); y1 = std::max(y1, q.second); }
+		const int X0 = std::max(0, (int)std::floor(x0)), X1 = std::min(sw, (int)std::ceil(x1));
+		const int Y0 = std::max(0, (int)std::floor(y0)), Y1 = std::min(sh, (int)std::ceil(y1));
+		auto inside = [&](double x, double y)
+		{
+			bool pos = false, neg = false;
+			for (size_t i = 0; i < p.size(); ++i)
+			{
+				const auto &A = p[i], &B = p[(i + 1) % p.size()];
+				const double c = (B.first - A.first) * (y - A.second) - (B.second - A.second) * (x - A.first);
+				if (c > 0) pos = true; else if (c < 0) neg = true;
+			}
+			return !(pos && neg);
+		};
+		for (int Y = Y0; Y < Y1; ++Y)
+		{
+			Uint32 *o = over.data() + (size_t)Y * sw;
+			for (int X = X0; X < X1; ++X)
+			{
+				int c = 0;
+				for (int sy = 0; sy < 4; ++sy) for (int sx = 0; sx < 4; ++sx) c += inside(X + (sx + 0.5) / 4, Y + (sy + 0.5) / 4);
+				if (c) o[X] = mix(o[X], col, c * alpha / 16);
+			}
+		}
+	}
+
+	/// Rounded rectangle, anti-aliased on its outline, solid colour.
+	void roundRect(double x0, double y0, double x1, double y1, double rad, Uint32 col, int alpha = 255)
+	{
+		const int X0 = std::max(0, (int)std::floor(x0)), X1 = std::min(sw, (int)std::ceil(x1));
+		const int Y0 = std::max(0, (int)std::floor(y0)), Y1 = std::min(sh, (int)std::ceil(y1));
+		for (int Y = Y0; Y < Y1; ++Y)
+		{
+			Uint32 *o = over.data() + (size_t)Y * sw;
+			const double py = Y + 0.5;
+			for (int X = X0; X < X1; ++X)
+			{
+				const double px = X + 0.5;
+				const double qx = std::max(std::max(x0 + rad - px, px - (x1 - rad)), 0.0);
+				const double qy = std::max(std::max(y0 + rad - py, py - (y1 - rad)), 0.0);
+				double d;   // signed distance inside the shape
+				if (qx > 0 && qy > 0) d = rad - std::sqrt(qx * qx + qy * qy);
+				else d = std::min(std::min(px - x0, x1 - px), std::min(py - y0, y1 - py));
+				const double cov = std::max(0.0, std::min(1.0, d + 0.5));
+				if (cov > 0) o[X] = mix(o[X], col, (int)(cov * alpha));
+			}
+		}
+	}
