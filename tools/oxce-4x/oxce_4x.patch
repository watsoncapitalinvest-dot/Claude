+ * along with OpenXcom.  If not, see <http://www.gnu.org/licenses/>.
+ */
+#include <map>
+#include <string>
+#include <vector>
+#include "../Engine/Yaml.h"
+
+namespace OpenXcom
+{
+
+class AlienStrategy;
+
+/**
+ * What Cobra is running on, held per region.
+ *
+ * Two resources and not one, because a single global pool makes every site interchangeable and
+ * a target list of interchangeable targets is just a longer list. Funds are liquid and move
+ * between regions; materiel is physical, stockpiled where it is made, and equips the troops in
+ * that region. Raiding the factory in South America has to starve South American garrisons
+ * specifically or geography means nothing.
+ *
+ * Quantities are named and in units, with no opaque scores anywhere. That is a stricter bar
+ * than a planner needs and it is deliberate: a Cobra playthrough would put a person behind the
+ * same state, and legibility is cheap to keep now and expensive to retrofit.
+ */
+struct CobraProject
+{
+	std::string type;        ///< the DEPARTMENT. One project per department, worldwide.
+	std::string region;      ///< where its lab stands; written when a lab claims it
+	/// Which site hosts its bench, as "<siteType>#<id>"; empty = nobody is working on it.
+	/// NOT the bare Target id: AlienBase ids are handed out per deployment marker, so the
+	/// first depot and the first lab are BOTH id 1. Keyed on the id alone, raiding a depot
+	/// cleared a lab's research and two site types shared one pool of benches.
+	std::string labKey;
+	int progress = 0;        ///< in the same units as cost, so a bar can be drawn without a lookup
+	int cost = 0;
+	bool known = false;      ///< the player has learned this exists, by raiding a lab or an HQ
+	void load(const YAML::YamlNodeReader& reader);
+	void save(YAML::YamlNodeWriter writer) const;
+};
+
+class CobraEconomy
+{
+public:
+	CobraEconomy() = default;
+	~CobraEconomy() = default;
+
+	void load(const YAML::YamlNodeReader& reader);
+	void save(YAML::YamlNodeWriter writer) const;
+
+	/// What a region holds. Missing regions read as zero rather than being created on access.
+	int getFunds(const std::string& region) const;
+	int getMateriel(const std::string& region) const;
+	void addFunds(const std::string& region, int delta);
+	void addMateriel(const std::string& region, int delta);
+
+	const std::map<std::string, int>& getAllFunds() const { return _funds; }
+	const std::map<std::string, int>& getAllMateriel() const { return _materiel; }
+
+	std::vector<CobraProject>& getProjects() { return _projects; }
+	const std::vector<CobraProject>& getProjects() const { return _projects; }
+
+	/**
+	 * Publish the per-region holdings where the mission scripts can already see them.
+	 *
+	 * The scripts gate on AlienStrategy's persisted counter map, so mirroring the economy into
+	 * it under COBRA_FUNDS_<REGION> and COBRA_MATERIEL_<REGION> lets every existing gate react
+	 * to Cobra's wealth with no new scheduling code - a richer region runs more missions because
+	 * a ruleset author wrote a condition, not because the scheduler changed.
+	 *
+	 * The map is named missionsRun and holds mission counts, so this deliberately overloads it.
+	 * The COBRA_ prefix is what keeps the two apart, and nothing may write a mission under it.
+	 */
+	void mirrorToCounters(AlienStrategy& strategy) const;
+
+	/// Every region's funds added up. Funds are liquid by design, so this is what Cobra can
+	/// actually spend, and what a build gate that may pick any region has to read.
+	int getTotalFunds() const;
+	/// Spends from the pool, taking from the named region first and then wherever there is
+	/// money. Returns what it managed to take, which is all of it unless Cobra is short.
+	int spendFunds(const std::string& preferredRegion, int amount);
+
+private:
+	std::map<std::string, int> _funds;
+	std::map<std::string, int> _materiel;
+	std::vector<CobraProject> _projects;
+};
+
+}
