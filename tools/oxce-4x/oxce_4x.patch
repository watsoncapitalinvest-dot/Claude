@@ -0,0 +1,25 @@
+#pragma once
+#include "../Engine/State.h"
+
+namespace OpenXcom
+{
+class Window; class Text; class TextButton; class BattlescapeState; class BattlescapeGame;
+
+/**
+ * ALL TARGETS NEUTRALIZED (John 16 Nov 00:19 "continue or exfiltrate? every map"; built 18 Nov 17:42 "go").
+ * Asked once, when the last Cobra goes down on a mission that ends that way. CONTINUE: the squad stays to search the
+ * site (the AREA SECURE mode: END MISSION ends it as a win whenever). EXFILTRATE: the mission ends now, a win.
+ */
+class SecureAreaState : public State
+{
+	BattlescapeState *_state;
+	BattlescapeGame *_bg;
+	Window *_window;
+	Text *_txtTitle, *_txtAsk;
+	TextButton *_btnContinue, *_btnExfil;
+public:
+	SecureAreaState(BattlescapeState *state, BattlescapeGame *bg);
+	void btnContinueClick(Action *action);
+	void btnExfilClick(Action *action);
+};
+}
