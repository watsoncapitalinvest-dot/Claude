+#include "RuleCobraSite.h"
+
+namespace OpenXcom
+{
+
+RuleCobraSite::RuleCobraSite(const std::string& type) :
+	_type(type),
+	_fundsPerMonth(0), _materielPerMonth(0),
+	_upkeepFunds(0), _upkeepMateriel(0),
+	_buildCostFunds(0),
+	_lootFunds(0), _lootMateriel(0),
+	_lootsRegionalStockpile(false),
+	_projectProgressPerMonth(0), _labSlots(0),
+	_goodwillErosionPerMonth(0),
+	_garrisonBonus(0), _garrisonRankUnlock(-1), _garrisonAllMissions(false),
+	_runsThePlanning(false), _incomeNeedsShipment(false), _materielCostFunds(0),
+	_stockpileCap(0),
+	_revealOnRaid(0)
+{
+	// Everything defaults to zero, so a site type declared with only a deployment is inert
+	// rather than quietly worth something. Every number here is John's to tune and belongs in
+	// the single tuning file the design asks for, which does not exist yet.
+}
+
+void RuleCobraSite::load(const YAML::YamlNodeReader& reader, Mod*)
+{
+	reader.tryRead("fundsPerMonth", _fundsPerMonth);
+	reader.tryRead("materielPerMonth", _materielPerMonth);
+	reader.tryRead("upkeepFunds", _upkeepFunds);
+	reader.tryRead("upkeepMateriel", _upkeepMateriel);
+	reader.tryRead("buildCostFunds", _buildCostFunds);
+	reader.tryRead("lootFunds", _lootFunds);
+	reader.tryRead("lootMateriel", _lootMateriel);
+	reader.tryRead("lootsRegionalStockpile", _lootsRegionalStockpile);
+	reader.tryRead("projectProgressPerMonth", _projectProgressPerMonth);
+	reader.tryRead("labSlots", _labSlots);
+	reader.tryRead("goodwillErosionPerMonth", _goodwillErosionPerMonth);
+	reader.tryRead("garrisonBonus", _garrisonBonus);
+	reader.tryRead("garrisonRankUnlock", _garrisonRankUnlock);
+	reader.tryRead("garrisonAllMissions", _garrisonAllMissions);
+	reader.tryRead("runsThePlanning", _runsThePlanning);
+	reader.tryRead("incomeNeedsShipment", _incomeNeedsShipment);
+	// Guns are made, not conjured. A factory spends funds to turn out its
+	// materielPerMonth, so a Cobra that cannot pay cannot arm itself - which is what
+	// connects the two resources instead of leaving them as separate dials.
+	// Defaults to 0, so every site priced before this existed still produces free.
+	reader.tryRead("materielCostFunds", _materielCostFunds);
+	reader.tryRead("stockpileCap", _stockpileCap);
+	reader.tryRead("revealOnRaid", _revealOnRaid);
+}
+
+}
