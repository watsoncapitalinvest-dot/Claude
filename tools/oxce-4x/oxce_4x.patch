+
+Region *SavedGame::locateRegion(double lon, double lat) const
+{
+	Region* found = nullptr;
+	for (auto* region : _regions)
+	{
+		if (region->getRules()->insideRegion(lon, lat))
+		{
+			found = region;
+			break;
+		}
+	}
+	if (found)
+	{
+		return found;
+	}
+	Log(LOG_ERROR) << "Failed to find a region at location [" << lon << ", " << lat << "].";
+	return 0;
+}
