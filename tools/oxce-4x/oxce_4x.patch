+/**
+ * WHOLE-BODY FRAMES (drawing routine 23), for soldiers rendered from a rigged
+ * model: one picture per state, facing and frame instead of X-COM's torso, legs
+ * and arms. Sheet layout, 4x cells: frame = clip * 64 + direction * 8 + f, with
+ * clips stand, walk, kneel, aim, death. The weapon in hand is the item's own
+ * held sprite, its centre put between the hands the render recorded for that
+ * exact frame - so any weapon sits in the hands, and follows them as he walks.
+ */
+void UnitSprite::drawRoutineWhole()
+{
+	Part body{ BODYPART_TORSO }, itemR{ BODYPART_ITEM_RIGHTHAND }, itemL{ BODYPART_ITEM_LEFTHAND };
+	const int dir = _unit->getDirection();
+	const int N = _unit->getArmor()->getSize();
+	if (N >= 2)
+	{
+		// G.I. Joe big aircraft and vessels (DOGFIGHT_DESIGN_v1 section 3, SEA_BATTLES_DESIGN_v1 2b): one picture
+		// for the whole body in cells N times a tile (N*128 x N*160 at 4x), drawn by every one of the N*N parts
+		// and clipped by the map to each part's own tile, so together they make the whole. Frames: 0-7 the
+		// eight headings; then death: 2x2 sheets have 8 + heading * 8 + f, bigger ones 8 + f (one sequence).
+		int frame = dir;
+		// G.I. Joe (VFACTORY): rounds the store weapon has fired (gjStoreStates); -1 when the armour has no stores
+		int fired = -1;
+		const Armor *sa = _unit->getArmor();
+		if (sa->getGjStoreStates() > 0)
+		{
+			for (const BattleItem *it : *_unit->getInventory())
+			{
+				if (it->getRules()->getType() != sa->getGjStoreWeapon()) continue;
+				const BattleItem *ammo = it->getAmmoForSlot(0);
+				fired = ammo ? std::max(0, ammo->getRules()->getClipSize() - ammo->getAmmoQuantity()) : sa->getGjStoreStates();   // spent clip is taken away
+				break;
+			}
+		}
+		if (_unit->getStatus() == STATUS_COLLAPSING)
+		{
+			const int n = std::max(1, _unit->getArmor()->getDeathFrames());
+			const int f = std::min(7, _unit->getFallingPhase() * 8 / n);
+			frame = N == 2 ? 8 + dir * 8 + f : 8 + f;
+		}
+		else if (fired > 0)
+		{
+			// G.I. Joe (VFACTORY, John 17 Nov "finish the missiles"): a rack of missiles drawn on the hull. Each round the store
+			// weapon has fired takes one off the picture: frames after the death frames, 8 headings per missile gone.
+			// (Missiles on a turret come off the turret sheet instead, below; the hull sheet then has no such frames.)
+			const int base = N == 2 ? 72 : 16;
+			const int want = base + (std::min(fired, sa->getGjStoreStates()) - 1) * 8 + dir;
+			if (_unitSurface && want < (int)_unitSurface->getTotalFrames()) frame = want;
+		}
+		if (fired >= 0 && fired < sa->getGjStoreStates() && sa->getGjStoreDeploy() > 0 && _unit->getGjDeployStep() >= 0 && _unit->getStatus() != STATUS_COLLAPSING)
+		{
+			// G.I. Joe (VFACTORY, John 17 Nov 23:28): the next store pushed out on its arm before it fires (ProjectileFlyBState steps it)
+			const int D = sa->getGjStoreDeploy();
+			const int want = (N == 2 ? 72 : 16) + sa->getGjStoreStates() * 8 + (fired * D + std::min(_unit->getGjDeployStep(), D - 1)) * 8 + dir;
+			if (_unitSurface && want < (int)_unitSurface->getTotalFrames()) frame = want;
+		}
+		selectUnit(body, frame, 0);
+		// the picture's centre sits over the middle of the N x N footprint; this part's tile is (ox, oy) from
+		// the unit's first tile, and x+1 is (+16,+8) on screen, y+1 is (-16,+8)
+		const int ox = _part % N, oy = _part / N;
+		body.offX = 16 - 16 * N - 16 * ox + 16 * oy;
+		body.offY = 28 + 8 * (N - 1) - 28 * N - 8 * ox - 8 * oy - 4;
+		blitBody(body);
+		// G.I. Joe: the turret, turned to its own heading, where the hull at this heading carries it
+		const Armor *ar = _unit->getArmor();
+		if (!ar->getGjTurretSheet().empty() && _unit->getStatus() != STATUS_COLLAPSING)
+		{
+			SurfaceSet *ts = const_cast<Mod*>(_mod)->getSurfaceSet(ar->getGjTurretSheet(), false);
+			const int td = _unit->getTurretType() >= 0 ? _unit->getTurretDirection() : dir;
+			// G.I. Joe (VFACTORY, John 17 Nov 20:21 "they dont disappear"): missiles carried on the turret (Wolverine) come
+			// off the turret sheet: frame 8 + (fired - 1) * 8 + turret heading, when the sheet has those frames
+			int tf = td;
+			// G.I. Joe (VFACTORY, John 17 Nov 22:01): a vehicle with a cupola keeps two turret sets - 0-7 with the cupola fixed on it
+			// (what an exe without this code draws) and 8-15 without it, for the cupola drawn below at its own heading
+			if (ts && _unit->hasCupola() && (int)ts->getTotalFrames() >= 16) tf = 8 + td;
+			else if (ts && fired > 0)
+			{
+				const int want = 8 + (std::min(fired, sa->getGjStoreStates()) - 1) * 8 + td;
+				if (want < (int)ts->getTotalFrames()) tf = want;
+			}
+			if (ts && ts->getFrame(tf))
+			{
+				Part turret{ BODYPART_TORSO, ts->getFrame(tf) };
+				const auto &off = ar->getGjTurretOffsets();
+				turret.offX = body.offX + (dir < (int)off.size() && off[dir].size() >= 2 ? off[dir][0] : 0);
+				turret.offY = body.offY + (dir < (int)off.size() && off[dir].size() >= 2 ? off[dir][1] : 0);
+				blitBody(turret);
+				// G.I. Joe (VFACTORY, John 17 Nov 22:01): the cupola - a second turret on the turret, at its own heading,
+				// where the turret at this heading carries it
+				if (_unit->hasCupola())
+				{
+					SurfaceSet *cs = const_cast<Mod*>(_mod)->getSurfaceSet(ar->getGjCupolaSheet(), false);
+					const int cd = _unit->getCupolaDirection();
+					if (cs && cs->getFrame(cd))
+					{
+						Part cupola{ BODYPART_TORSO, cs->getFrame(cd) };
+						const auto &co = ar->getGjCupolaOffsets();
+						cupola.offX = turret.offX + (td < (int)co.size() && co[td].size() >= 2 ? co[td][0] : 0);
+						cupola.offY = turret.offY + (td < (int)co.size() && co[td].size() >= 2 ? co[td][1] : 0);
+						blitBody(cupola);
+					}
+				}
+			}
+		}
+		return;
+	}
+	// G.I. Joe: the rendered clips are real-time motion, so they play slower than X-COM's
+	// sprites did. Idle: one frame every 4 map ticks (was 2). Walk: a clip is a full stride
+	// (two steps), so it spans two tiles: the first half on odd steps, the second on even.
+	int clip = 0, f = (_animationFrame / 4) % 8;
+	// G.I. Joe WALK16 (BRIEF_FOR_BUILD_Walk16, John 15 Nov / 16 Nov 21:29 "do the animations now"). A sheet of 896
+	// frames (56 rows) is the new layout: the six still clips at 64 frames each (8 facings x 8), then four walks
+	// at 16 frames a facing - two-handed gun, pistol, crouched (sneaking), and empty-handed or a knife. A stride
+	// still spans two tiles, so the walk plays 8 frames a tile: twice as many frames at the same speed.
+	const bool w16 = _unitSurface && _unitSurface->getTotalFrames() >= 896;
+	if (w16)
+	{
+		enum { STAND = 0, KNEEL = 64, AIM = 128, DEATH = 192, PSTAND = 256, PKNEEL = 320, WALK = 384, PWALK = 512, SWALK = 640, EWALK = 768,
+			UPSTAIRS = 896, DOWNSTAIRS = 1024, HANDSUP = 1152 };
+		// FIRST HOUR (John 17 Nov 18:19 "all of the animations they need including stairs and hands up"): a sheet of
+		// 1216 frames adds up and down the stairs (16 a facing, stepping in place) and hands up (8 a facing).
+		const bool fh = _unitSurface->getTotalFrames() >= 1216;
+		const BattleItem *r = _unit->getRightHandWeapon(), *l = _unit->getLeftHandWeapon();
+		const bool twoHanded = (r && r->getRules()->isTwoHanded()) || (l && l->getRules()->isTwoHanded());
+		auto gun = [](const BattleItem *i) { return i && i->getRules()->getBattleType() == BT_FIREARM; };
+		const bool pistol = !twoHanded && (gun(r) || gun(l));
+		int base = STAND, per = 8;
+		if (_unit->getStatus() == STATUS_COLLAPSING)
+		{
+			base = DEATH;
+			const int n = std::max(1, _unit->getArmor()->getDeathFrames());
+			f = std::min(7, _unit->getFallingPhase() * 8 / n);
+		}
+		else if (_unit->getStatus() == STATUS_WALKING)
+		{
+			base = _unit->getGjSneaking() ? SWALK : twoHanded ? WALK : pistol ? PWALK : EWALK;
+			per = 16;
+			// WALKSYNC (BRIEF_FOR_BUILD_WalkSync, John 14:55): the frame follows the distance walked this move, one
+			// 16-frame cycle per the clip's own stride, so the planted foot stays planted. No restart at each tile.
+			const double stride = _mod->getWalk16Stride(_unit->gjWalkClip());
+			f = ((int)std::floor(_unit->getGjWalkDist() / stride * 16.0)) % 16;
+			// a step that climbs or drops (a stair, a ramp, a level change) plays the stairs clip: the floor
+			// height of the tile he leaves against the one he goes to, 24 a level, a quarter level either way
+			if (fh && _save)
+			{
+				auto h = [&](const Position &p) { const Tile *t = _save->getTile(p); return p.z * 24 - (t ? t->getTerrainLevel() : 0); };
+				const int climb = h(_unit->getDestination()) - h(_unit->getLastPosition());   // the tile the step started on: _pos moves halfway
+				if (climb >= 6) base = UPSTAIRS;
+				else if (climb <= -6) base = DOWNSTAIRS;
+				static int told = 0;   // the log says so the first few times (the simulator's proof the clip is used)
+				if (base != SWALK && base != WALK && base != PWALK && base != EWALK && told < 6)
+				{ ++told; Log(LOG_INFO) << "[stairs] " << (base == UPSTAIRS ? "up" : "down") << " clip, unit " << _unit->getId() << " climb " << climb; }
+			}
+		}
+		else if (fh && _unit->isHandsUp()) base = HANDSUP;
+		else if (_unit->getStatus() == STATUS_AIMING) base = pistol ? PSTAND : AIM;
+		else if (_unit->isKneeled()) base = pistol ? PKNEEL : KNEEL;
+		else base = pistol ? PSTAND : STAND;
+		clip = -1;
+		_w16Frame = base + dir * per + f;
+	}
+	else if (_unit->getStatus() == STATUS_COLLAPSING)
+	{
+		clip = 4;
+		const int n = std::max(1, _unit->getArmor()->getDeathFrames());
+		f = std::min(7, _unit->getFallingPhase() * 8 / n);
+	}
+	else if (_unit->getStatus() == STATUS_WALKING) { clip = 1; f = ((_unit->getWalkingPhase() % 8) / 2 + 4 * (_unit->getStepCount() & 1)) % 8; }
+	else if (_unit->getStatus() == STATUS_AIMING) clip = 3;
+	else if (_unit->isKneeled()) clip = 2;
+	// ONE-HANDED CLIPS. A sheet with eight clips carries a pistol stance after the
+	// five stock ones: 5 stand (also aim), 6 walk, 7 kneel. Used only when the
+	// unit holds something and nothing it holds is two-handed. Death stays 4,
+	// and a five-clip sheet never gets here, so it draws exactly as before.
+	if (!w16 && clip != 4 && _unitSurface && _unitSurface->getTotalFrames() >= 8 * 64)
+	{
+		const BattleItem *r = _unit->getRightHandWeapon(), *l = _unit->getLeftHandWeapon();
+		const bool holds = r || l;
+		const bool twoHanded = (r && r->getRules()->isTwoHanded()) || (l && l->getRules()->isTwoHanded());
+		if (holds && !twoHanded)
+		{
+			if (clip == 0 || clip == 3) clip = 5;
+			else if (clip == 1) clip = 6;
+			else if (clip == 2) clip = 7;
+		}
+	}
+	const int frame = w16 ? _w16Frame : clip * 64 + dir * 8 + f;
+	selectUnit(body, frame, 0);
+	// G.I. Joe: the sheets put the feet on row 152 of 160; X-COM's own soldiers stand on
+	// rows 33-36 of 40 (136-144 at 4x), so ours sank into the floor. Lift body and weapon.
+	constexpr int FOOT_LIFT = 4;
+	body.offY -= FOOT_LIFT;
+
+	const int k = std::max(1, SurfaceSet::battleScale());
+	const auto &anch = handAnchors(_unit->getArmor()->getSpriteSheet());
+	auto hold = [&](Part &p, const BattleItem *item, bool right)
+	{
+		if (!item || _unit->getStatus() == STATUS_COLLAPSING || _unit->isHandsUp()) return;
+		selectItem(p, item, dir);
+		if (!p.src || frame >= (int)anch.size() || anch[frame].rx < 0) return;
+		const HandAnchor &a = anch[frame];
+		const bool twoHands = item->getRules()->isTwoHanded();
+		const float hx = twoHands ? (a.rx + a.lx) / 2 : (right ? a.rx : a.lx);
+		const float hy = twoHands ? (a.ry + a.ly) / 2 : (right ? a.ry : a.ly);
+		const auto c = inkCentre(p.src);
+		p.offX = (int)std::lround((hx - c.first) / k);
+		p.offY = (int)std::lround((hy - c.second) / k) - FOOT_LIFT;
+	};
+	sortRifles();
+	hold(itemR, _itemR, true);
+	hold(itemL, _itemL, false);
+	// seen from behind (up-left, up, up-right on screen) the weapon is in front of
+	// him and so behind him in the picture
+	const bool fromBehind = dir == 7 || dir == 0 || dir == 6;
+	if (fromBehind) { blitItem(itemR); blitItem(itemL); blitBody(body); }
+	else { blitBody(body); blitItem(itemR); blitItem(itemL); }
+}
