+AirFightChoiceState::AirFightChoiceState(GeoscapeState *state, const std::string &title, const std::string &body, bool canAuto, int odds) : _state(state)
+{
+	_screen = false;
+	_window = new Window(this, 256, 160, 32, 20, POPUP_BOTH);
