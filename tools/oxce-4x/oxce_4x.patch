+#pragma once
+/*
+ * G.I. Joe: USA Defense. Department heads (John 13 Nov 2026, claude/DEPARTMENT_HEADS_DESIGN_v1.md).
+ * DepartmentsState lists every department with its head, his state and the speed it runs at.
+ * AppointHeadState picks a head for one department (also the prompt when its room is built).
+ * SoldierJobsState is the same choice from a Joe's own screen.
+ */
+#include "../Engine/State.h"
+#include <string>
+#include <vector>
+
+namespace OpenXcom
+{
+
+class TextButton;
+class Window;
+class Text;
+class TextList;
+class Soldier;
+class Mod;
+class SavedGame;
+
+class DepartmentsState : public State
+{
+private:
+	Window *_window;
+	Text *_txtTitle, *_txtRules;
+	TextList *_lst;
+	TextButton *_btnOk;
+	std::vector<std::string> _rows;
+public:
+	DepartmentsState();
+	void init() override;
+	void lstClick(Action *action);
+	void btnOkClick(Action *action);
+};
+
+class AppointHeadState : public State
+{
+private:
+	std::string _dept; // a department type, or "TOP_KICK"
+	Window *_window;
+	Text *_txtTitle, *_txtBody;
+	TextList *_lst;
+	TextButton *_btnNone, *_btnCancel;
+	std::vector<Soldier*> _rows;
+public:
+	AppointHeadState(const std::string &dept, bool prompt);
+	void lstClick(Action *action);
+	void btnNoneClick(Action *action);
+	void btnCancelClick(Action *action);
+};
+
+class SoldierJobsState : public State
+{
+private:
+	Soldier *_soldier;
+	Window *_window;
+	Text *_txtTitle, *_txtBody;
+	TextList *_lst;
+	TextButton *_btnClear, *_btnCancel;
+	std::vector<std::string> _rows;
+public:
+	SoldierJobsState(Soldier *soldier);
+	void lstClick(Action *action);
+	void btnClearClick(Action *action);
+	void btnCancelClick(Action *action);
+};
+
+/// Shared helpers.
+namespace Departments
+{
+	/// The display name of a department type (or Top Kick).
+	std::string name(State *st, const std::string &dept);
+	/// Can this Joe hold this job (0 no, 1 main, 2 second)?
+	int match(const Mod *mod, const Soldier *s, const std::string &dept);
+	/// Give a Joe a job, taking him off any other (one job per Joe), and the job off anyone else.
+	void appoint(SavedGame *save, const std::string &dept, const Soldier *s);
+	/// Offer a head for every department whose room now exists and was never offered.
+	/// Returns the prompts to push (caller decides how).
+	std::vector<std::string> pendingPrompts(const Mod *mod, SavedGame *save);
+}
+
+}
