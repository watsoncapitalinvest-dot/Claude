diff --git a/src/Geoscape/Outposts.cpp b/src/Geoscape/Outposts.cpp
new file mode 100644
index 0000000..24f17d2
--- /dev/null
+++ b/src/Geoscape/Outposts.cpp
@@ -0,0 +1,279 @@
+/*
+ * G.I. Joe outposts (see Outposts.h).
+ */
+#include "Outposts.h"
+#include <algorithm>
+#include <cmath>
+#ifndef M_PI
+#define M_PI 3.14159265358979323846 // MSVC defines it only with _USE_MATH_DEFINES
+#endif
+#include "SeaNav.h"
+#include "../Engine/Logger.h"
+#include "../Savegame/SavedGame.h"
+#include "../Savegame/Base.h"
+#include "../Savegame/BaseFacility.h"
+#include "../Savegame/Craft.h"
+#include "../Savegame/Soldier.h"
+#include "../Savegame/ItemContainer.h"
+#include "../Mod/RuleSoldier.h"
+#include "../Mod/RuleItem.h"
+#include "../Savegame/Country.h"
+#include "../Savegame/Transfer.h"
+#include "../Savegame/Production.h"
+#include "../Mod/RuleBaseFacility.h"
+#include "../Mod/RuleCraft.h"
+#include "../Mod/RuleCountry.h"
+#include "../Mod/RuleManufacture.h"
+#include "../Mod/RuleResearch.h"
+
+namespace OpenXcom
+{
+namespace Outposts
+{
+
+namespace
+{
+	bool researched(const Mod *mod, const SavedGame *save, const std::string &topic)
+	{
+		const RuleResearch *r = mod->getResearch(topic, false);
+		return r && save->isResearched(r);
+	}
+
+	/// how much water lies within `r` half-degree steps of a point (0..(2r+1)^2)
+	int waterAround(double lon, double lat, int r)
+	{
+		const double step = 0.5 * M_PI / 180.0;
+		int n = 0;
+		for (int dy = -r; dy <= r; ++dy)
+			for (int dx = -r; dx <= r; ++dx)
+				n += SeaNav::isWater(lon + dx * step, lat + dy * step) ? 1 : 0;
+		return n;
+	}
+
+	int pierSize(const Mod *mod, const std::string &facility)
+	{
+		auto it = mod->getOutpostRules().piers.find(facility);
+		return it == mod->getOutpostRules().piers.end() ? 0 : it->second;
+	}
+
+	int boatSize(const Mod *mod, const std::string &craft)
+	{
+		auto it = mod->getOutpostRules().boats.find(craft);
+		return it == mod->getOutpostRules().boats.end() ? 0 : it->second;
+	}
+}
+
+const Mod::OutpostKindRule *kind(const Mod *mod, const std::string &type)
+{
+	if (type.empty()) return nullptr;
+	for (const auto &k : mod->getOutpostRules().kinds) if (k.type == type) return &k;
+	return nullptr;
+}
+
+const Mod::OutpostKindRule *kindOf(const Mod *mod, const Base *base)
+{
+	return base ? kind(mod, base->getOutpostKind()) : nullptr;
+}
+
+int cap(const Mod *mod, const SavedGame *save)
+{
+	const auto &R = mod->getOutpostRules();
+	int n = R.capBase;
+	for (const auto &t : R.capResearch) if (researched(mod, save, t)) ++n;
+	return n;
+}
+
+int count(const Mod *mod, const SavedGame *save)
+{
+	int n = 0;
+	for (const Base *b : *const_cast<SavedGame*>(save)->getBases())
+	{
+		const auto *k = kindOf(mod, b);
+		if (k && k->counts) ++n;
+	}
+	return n;
+}
+
+std::string whyNot(const Mod *mod, const SavedGame *save, const Mod::OutpostKindRule &k, double lon, double lat)
+{
+	for (const auto &t : k.requires) if (!researched(mod, save, t)) return "STR_OUTPOST_NEEDS_RESEARCH";
+	if (k.counts && count(mod, save) >= cap(mod, save)) return "STR_OUTPOST_CAP_REACHED";
+	// the ground: land kinds on land, a port where land meets water, the platform out on open water
+	const bool land = SeaNav::isLandExact(lon, lat);
+	if (k.place == "ocean")
+	{
+		if (land || waterAround(lon, lat, 2) < 25) return "STR_OUTPOST_NEEDS_OPEN_WATER";
+	}
+	else if (!land) return "STR_OUTPOST_NEEDS_LAND";
+	else if (k.place == "coast" && waterAround(lon, lat, 2) == 0) return "STR_OUTPOST_NEEDS_COAST"; // within about a degree
+	// permission: the US anywhere; abroad only with that country's goodwill; the open ocean needs nobody's
+	if (k.place != "ocean")
+	{
+		for (const Country *c : *const_cast<SavedGame*>(save)->getCountries())
+		{
+			if (!c->getRules()->insideCountry(lon, lat)) continue;
+			if (c->getRules()->getType() == "STR_USA") return "";
+			if (c->getGoodwill() >= 0 && c->getGoodwill() < k.goodwill) return "STR_OUTPOST_NEEDS_GOODWILL";
+			return "";
+		}
+		return "STR_OUTPOST_NEEDS_COUNTRY";
+	}
+	return "";
+}
+
+void placeFixed(const Mod *mod, Base *base)
+{
+	const auto *k = kindOf(mod, base);
+	if (!k) return;
+	for (const auto &f : k->fixed)
+	{
+		const RuleBaseFacility *rule = mod->getBaseFacility(f.facility, false);
+		if (!rule) continue;
+		BaseFacility *fac = new BaseFacility(rule, base);
+		fac->setX(f.x);
+		fac->setY(f.y);
+		// the lift is there at once (a base needs one); the rest goes up over the founding days
+		fac->setBuildTime(rule->isLift() ? 0 : k->days);
+		base->getFacilities()->push_back(fac);
+	}
+}
+
+Base *grantByEvent(const Mod *mod, SavedGame *save, const std::string &eventName)
+{
+	for (const auto &g : mod->getOutpostRules().grants)
+	{
+		if (std::find(g.events.begin(), g.events.end(), eventName) == g.events.end()) continue;
+		bool have = false;
+		for (const Base *b : *save->getBases()) if (b->getOutpostKind() == g.kind) have = true;
+		if (have || !kind(mod, g.kind)) continue;
+		Base *base = new Base(mod);
+		base->setLongitude(g.lon * M_PI / 180.0);
+		base->setLatitude(-g.lat * M_PI / 180.0);   // the ruleset gives north positive; the globe counts north negative
+		base->setName(g.name.empty() ? g.kind : g.name);
+		base->setOutpostKind(g.kind);
+		placeFixed(mod, base);
+		for (BaseFacility *f : *base->getFacilities()) f->setBuildTime(0);   // handed over finished
+		for (const auto &s : g.soldiers)
+		{
+			const RuleSoldier *rs = mod->getSoldier(s.first, false);
+			if (!rs) { Log(LOG_WARNING) << "[outpost] grant: no soldier type " << s.first; continue; }
+			for (int i = 0; i < s.second; ++i)
+				base->getSoldiers()->push_back(mod->genSoldier(save, rs, save->selectSoldierNationalityByLocation(mod, rs, base)));
+		}
+		for (const auto &c : g.crafts)
+		{
+			const RuleCraft *rc = mod->getCraft(c, false);
+			if (!rc) { Log(LOG_WARNING) << "[outpost] grant: no craft type " << c; continue; }
+			Craft *craft = new Craft(rc, base, save->getId(c));
+			craft->setFuel(rc->getMaxFuel());
+			craft->setStatus("STR_READY");
+			base->getCrafts()->push_back(craft);
+		}
+		for (const auto &it : g.items)
+		{
+			if (!mod->getItem(it.first, false)) { Log(LOG_WARNING) << "[outpost] grant: no item " << it.first; continue; }
+			base->getStorageItems()->addItem(mod->getItem(it.first), it.second);
+		}
+		save->getBases()->push_back(base);
+		Log(LOG_INFO) << "[outpost] " << eventName << " hands over " << g.kind << ": " << base->getSoldiers()->size()
+			<< " soldiers, " << base->getCrafts()->size() << " craft";
+		return base;
+	}
+	return nullptr;
+}
+
+bool isFixed(const Mod *mod, const Base *base, int x, int y)
+{
+	const auto *k = kindOf(mod, base);
+	if (!k) return false;
+	for (const auto &f : k->fixed) if (f.x == x && f.y == y) return true;
+	return false;
+}
+
+bool onWater(const Base *base)
+{
+	return waterAround(base->getLongitude(), base->getLatitude(), 2) > 0;
+}
+
+bool canList(const Mod *mod, const Base *base, const RuleBaseFacility *rule)
+{
+	const auto &R = mod->getOutpostRules();
+	if (!R.on) return true;
+	const auto *k = kindOf(mod, base);
+	if (k && !k->pit)
+		return std::find(k->addons.begin(), k->addons.end(), rule->getType()) != k->addons.end();
+	// at a Pit: no outpost-only add-ons; piers only on the water
+	if (std::find(R.addonOnly.begin(), R.addonOnly.end(), rule->getType()) != R.addonOnly.end()) return false;
+	// the Pit's floors: only the rooms that have a floor (the big Lab, the Fabrication Shop, hangars: off site)
+	const auto &PF = mod->getPitFloorRules();
+	if (PF.on && !PF.floors.count(rule->getType())) return false;
+	if (pierSize(mod, rule->getType()) && !onWater(base)) return false;
+	return true;
+}
+
+std::string canBuild(const Mod *mod, const Base *base, const RuleBaseFacility *rule, int x, int y)
+{
+	if (!mod->getOutpostRules().on) return "";
+	if (!canList(mod, base, rule)) return "STR_OUTPOST_NOT_HERE";
+	const auto *k = kindOf(mod, base);
+	if (!k || k->pit)
+	{
+		// a room goes on its own floor, wholly inside it (PIT_FLOORS_v1 section 2)
+		const auto &PF = mod->getPitFloorRules();
+		if (!PF.on) return "";
+		auto it = PF.floors.find(rule->getType());
+		if (it == PF.floors.end()) return "STR_OUTPOST_NOT_HERE";
+		for (int dx = 0; dx < rule->getSizeX(); ++dx)
+			for (int dy = 0; dy < rule->getSizeY(); ++dy)
+				if (Mod::pitFloorAt(x + dx, y + dy) != it->second) return "STR_PIT_WRONG_FLOOR";
+		return "";
+	}
+	// at an outpost: only on its pads, one add-on to a pad
+	for (int dx = 0; dx < rule->getSizeX(); ++dx)
+		for (int dy = 0; dy < rule->getSizeY(); ++dy)
+		{
+			bool pad = false;
+			for (const auto &p : k->pads) if (p.size() >= 2 && p[0] == x + dx && p[1] == y + dy) pad = true;
+			if (!pad) return "STR_OUTPOST_PADS_ONLY";
+		}
+	return "";
+}
+
+int freeHangarsFor(const Mod *mod, const Base *base, const RuleCraft *craft)
+{
+	// the slots: aircraft spaces (every craft space not on a pier), small piers, large piers
+	int air = 0, smallP = 0, largeP = 0;
+	for (const BaseFacility *f : *const_cast<Base*>(base)->getFacilities())
+	{
+		if (f->getBuildTime() != 0) continue;
+		const int c = f->getRules()->getCrafts();
+		switch (pierSize(mod, f->getRules()->getType()))
+		{
+		case 0: air += c; break;
+		case 1: smallP += c; break;
+		default: largeP += c; break;
+		}
+	}
+	// what is using them: craft here, craft on the way, craft being made
+	int usedAir = 0, usedSmall = 0, usedLarge = 0;
+	auto use = [&](const RuleCraft *r, int n)
+	{
+		const int b = r ? boatSize(mod, r->getType()) : 0;
+		if (b == 0) usedAir += n; else if (b == 1) usedSmall += n; else usedLarge += n;
+	};
+	for (const Craft *c : *base->getCrafts()) use(c->getRules(), 1);
+	for (Transfer *t : *const_cast<Base*>(base)->getTransfers())
+		if (t->getType() == TRANSFER_CRAFT && t->getCraft()) use(t->getCraft()->getRules(), t->getQuantity());
+	for (const Production *p : base->getProductions())
+		if (p->getRules()->getProducedCraft()) use(p->getRules()->getProducedCraft(), p->getAmountTotal() - p->getAmountProduced());
+	// a small boat may use a large pier that is spare
+	const int spareLarge = largeP - usedLarge;
+	const int freeSmall = smallP - usedSmall + std::max(0, spareLarge);
+	const int b = boatSize(mod, craft->getType());
+	if (b == 0) return air - usedAir;
+	if (b == 1) return freeSmall;
+	return spareLarge - std::max(0, usedSmall - smallP);
+}
+
+}
+}
diff --git a/src/Geoscape/Outposts.h b/src/Geoscape/Outposts.h
new file mode 100644
index 0000000..67bd246
--- /dev/null
+++ b/src/Geoscape/Outposts.h
@@ -0,0 +1,47 @@
+#pragma once
+/*
+ * G.I. Joe outposts (claude/OUTPOSTS_v2_DECISIONS.md, John 14 Nov 15:40-16:31).
+ * An outpost is a base underneath (craft, boats, troops, stores, radar), but a fixed place drawn by MAPS:
+ * it comes with its buildings already in place on the base grid, and the player builds add-ons only on
+ * its pads. Kinds: forward camp, port, airstrip, listening post, the Tactical Battle Platform at sea,
+ * and a full extra Pit (the normal room grid). Boats are kept only at piers.
+ */
+#include <string>
+#include "../Mod/Mod.h"
+
+namespace OpenXcom
+{
+
+class SavedGame;
+class Base;
+class RuleBaseFacility;
+class RuleCraft;
+
+namespace Outposts
+{
+	/// the kind rule of this base, or nullptr (The Pit)
+	const Mod::OutpostKindRule *kindOf(const Mod *mod, const Base *base);
+	const Mod::OutpostKindRule *kind(const Mod *mod, const std::string &type);
+	/// outposts allowed now: capBase + one per capResearch researched
+	int cap(const Mod *mod, const SavedGame *save);
+	/// outposts that count against the cap
+	int count(const Mod *mod, const SavedGame *save);
+	/// can this kind be founded here: "" = yes, else the reason (a string id)
+	std::string whyNot(const Mod *mod, const SavedGame *save, const Mod::OutpostKindRule &k, double lon, double lat);
+	/// put the buildings an outpost comes with in place (under construction for its founding days)
+	void placeFixed(const Mod *mod, Base *base);
+/// a story event popped: found any outpost it hands over (built, garrisoned; once). The new base, or null.
+Base *grantByEvent(const Mod *mod, SavedGame *save, const std::string &eventName);
+	/// may this facility be built at this base, at grid (x, y): "" = yes, else the reason
+	std::string canBuild(const Mod *mod, const Base *base, const RuleBaseFacility *rule, int x, int y);
+	/// may this facility be listed for building at this base at all
+	bool canList(const Mod *mod, const Base *base, const RuleBaseFacility *rule);
+	/// is this a building the outpost came with (it can't be taken down)
+	bool isFixed(const Mod *mod, const Base *base, int x, int y);
+	/// is this base's spot on the water's edge (or on the water)
+	bool onWater(const Base *base);
+	/// free craft spaces at this base for this craft: boats only at piers of their size, aircraft never at piers
+	int freeHangarsFor(const Mod *mod, const Base *base, const RuleCraft *craft);
+}
+
+}
