+std::vector<Entry> list(SavedBattleGame *save, BattleUnit *u)
+{
+	std::vector<Entry> out;
+	const auto *mine = specialsOf(save, u);
+	if (!mine || u->isOut()) return out;
+	const int armed = vget(save, K("vsArm", u)) - 1;
+	for (const std::string &id : *mine)
+	{
+		const int i = poolIndex(id);
+		if (i < 0) continue;
+		Entry e;
+		e.id = id;
+		const int left = usesLeft(save, u, id);
+		e.label = POOL[i].name;
+		if (armed == i) e.label += "  ARMED";
+		else if (left < 50) e.label += "  " + std::to_string(std::max(0, left));
+		// why it can't be used right now
+		if (save->getSide() != u->getFaction() && !g_selfTest) { e.usable = false; e.why = "NOT YOUR TURN"; }
+		else if (left <= 0) { e.usable = false; e.why = "USED UP"; }
+		else if (u->getTimeUnits() < tuCost(save, u, id)) { e.usable = false; e.why = "NOT ENOUGH TU"; }
+		else if (id == "LOBBED_SHOT") { e.usable = false; e.why = "A FIRING MODE OF THE GUN"; }
+		else if (id == "DISMOUNT" || id == "GO_TO_GROUND" || id == "STRAFING_RUN" || id == "GUN_RUN") { e.usable = false; e.why = "NOT BUILT YET"; }
+		else if ((id == "FLANK_SPEED" || id == "STEAMROLLER" || id == "JUMP") && moveBlocked(save, u)) { e.usable = false; e.why = "PARKED"; }
+		else if (id == "FLANK_SPEED" && u->getTimeUnits() < u->getBaseStats()->tu) { e.usable = false; e.why = "ALREADY MOVED"; }
+		else if (id == "FULL_SALVO" && !rocketWeapon(u)) { e.usable = false; e.why = "NO ROCKETS"; }
+		else if (id == "RAM" && !unitInFront(save, u)) { e.usable = false; e.why = "NOTHING IN FRONT"; }
+		else if (id == "STEAMROLLER" && u->getTimeUnits() < u->getBaseStats()->tu) { e.usable = false; e.why = "ALREADY MOVED"; }
+		out.push_back(e);
+	}
+	return out;
+}
+
+static std::string useInner(BattlescapeGame *game, BattleUnit *u, const std::string &id);
+std::string use(BattlescapeGame *game, BattleUnit *u, const std::string &id)
+{
+	const std::string msg = useInner(game, u, id);
+	Log(LOG_INFO) << "[specials] " << u->getType() << " #" << u->getId() << " " << id << " at " << u->getPosition() << " facing " << u->getDirection() << " -> " << msg;
+	return msg;
+}
+
+static std::string useInner(BattlescapeGame *game, BattleUnit *u, const std::string &id)
+{
+	SavedBattleGame *save = game->getSave();
+	const int i = poolIndex(id);
+	if (i < 0) return "";
+	for (const Entry &e : list(save, u))
+		if (e.id == id && !e.usable) return e.why;
+	const auto &r = R(save);
+	const int turn = save->getTurn();
+	const std::string name = POOL[i].name;
+
+	// armed specials: switch on (or off) for the next shot; the use is counted when it fires
+	if (POOL[i].armed)
+	{
+		const int armed = vget(save, K("vsArm", u)) - 1;
+		vset(save, K("vsArm", u), armed == i ? 0 : i + 1);
+		Log(LOG_INFO) << "[specials] " << u->getType() << " " << (armed == i ? "disarms " : "arms ") << id;
+		return armed == i ? name + " OFF" : name + ": READY - FIRE TO USE";
+	}
+
+	const int cost = tuCost(save, u, id);
+	std::string msg = name;
+	if (id == "FLANK_SPEED")
+	{
+		vset(save, K("vsFlank", u), turn); // every step costs 100/(100+flankSpeedPct) as much: double move
+		msg += ": DOUBLE MOVE, NO FIRING THIS TURN";
+	}
+	else if (id == "HULL_DOWN")
+	{
+		vset(save, K("vsHull", u), turn);
+		msg += ": FRONT ARMOUR UP, NO MOVING TILL NEXT TURN";
+	}
+	else if (id == "SENTRY_LOCK")
+	{
+		vset(save, K("vsSentry", u), turn);
+		vset(save, K("vsSentryDir", u), facing(u) + 1);
+		vset(save, K("vsSentryLeft", u), r.sentryShots);
+		msg += ": WATCHING THE ARC";
+	}
+	else if (id == "SKY_WATCH")
+	{
+		vset(save, K("vsSky", u), turn);
+		msg += ": WATCHING THE SKY";
+	}
+	else if (id == "SHIELD_WALL")
+	{
+		vset(save, K("vsShield", u), turn);
+		vset(save, K("vsHull", u), turn); // it parks
+		msg += ": MEN BESIDE IT ARE IN COVER";
+	}
+	else if (id == "LASER_CHARGE")
+	{
+		vset(save, K("vsLaserWait", u), turn);
+		vset(save, K("vsLaser", u), 1);
+		msg += ": NEXT SHOT DOUBLE DAMAGE";
+	}
+	else if (id == "SMOKE_SCREEN")
+	{
+		int n = 0;
+		const Position p = u->getPosition();
+		const int size = u->getArmor()->getSize();
+		for (int dx = -r.smokeRadius; dx < size + r.smokeRadius; ++dx)
+			for (int dy = -r.smokeRadius; dy < size + r.smokeRadius; ++dy)
+				if (Tile *t = save->getTile(p + Position(dx, dy, 0)))
+				{
+					t->addSmoke(r.smokeAmount);
+					++n;
+				}
+		refreshAround(game, p);
+		game->getTileEngine()->calculateFOV(p, r.smokeRadius + size, true);
+		msg += ": " + std::to_string(n) + " TILES";
+	}
+	else if (id == "RAM")
+	{
+		BattleUnit *t = unitInFront(save, u);
+		if (!t) return "NOTHING IN FRONT";
+		if (t->getArmor()->getSize() > u->getArmor()->getSize()) return "TOO BIG TO RAM";
+		const RuleDamageType *dt = save->getMod()->getDamageType(DT_MELEE);
+		const int dmg = r.ramDamage * u->getArmor()->getSize();
+		const int before = t->getHealth();
+		BattleActionAttack atk; atk.type = BA_HIT; atk.attacker = u;
+		t->damage(Position(0, 0, 0), dmg, dt, save, atk);
+		const int dealt = std::max(0, before - t->getHealth());
+		// the jolt comes through the hull: armour does not stop it (never below 1 health from its own ram)
+		u->setHealthDirect(std::max(1, u->getHealth() - std::max(1, dealt * r.ramSelfPct / 100)));
+		game->checkForCasualties(dt, atk);
+		msg += ": " + std::to_string(dealt) + " DAMAGE";
+	}
+	else if (id == "JUMP")
+	{
+		if (u->getArmor()->getSize() > 1) return "TOO BIG TO JUMP";
+		const Position v = dirVec(u->getDirection()), to = u->getPosition() + Position(v.x * 2, v.y * 2, 0);
+		Tile *t = save->getTile(to);
+		if (!t || t->getUnit() || t->hasNoFloor(save) || t->getTUCost(O_OBJECT, u->getMovementType()) == Pathfinding::INVALID_MOVE_COST)
+			return "NOWHERE TO LAND";
+		const Position from = u->getPosition();
+		u->setPosition(to);
+		u->setTile(t, save);
+		refreshAround(game, from);
+		game->getTileEngine()->calculateFOV(u);
+		msg += "!";
+	}
+	else if (id == "STEAMROLLER")
+	{
+		// straight ahead, knocking light cover flat, until a unit, heavy cover or the end of its move
+		g_cleared = 0;
+		Position end = u->getPosition();
+		for (int step = 1; step <= r.steamrollerTiles; ++step)
+		{
+			bool ok = true;
+			for (const Position &q : frontTiles(u, step))
+			{
+				Tile *t = save->getTile(q);
+				if (!t || (t->getUnit() && t->getUnit() != u) || t->hasNoFloor(save)) { ok = false; break; }
+				if (!clearTile(save, t, r.steamrollerCoverArmor)) ok = false;
+			}
+			if (!ok) break;
+			const Position v = dirVec(u->getDirection());
+			end = u->getPosition() + Position(v.x * step, v.y * step, 0);
+		}
+		refreshAround(game, u->getPosition());
+		if (end == u->getPosition()) return "BLOCKED";
+		save->getPathfinding()->calculate(u, end, BAM_NORMAL);
+		BattleAction walk;
+		walk.actor = u;
+		walk.type = BA_WALK;
+		walk.target = end;
+		// the walk is paid as normal; the next shot this turn is free (beforeShot hands its TU back)
+		vset(save, K("vsSteamShot", u), turn);
+		game->statePushBack(new UnitWalkBState(game, walk));
+		msg += ": " + std::to_string(Position::distance2d(end, u->getPosition())) + " TILES, " + std::to_string(g_cleared) + " FLATTENED, THEN ONE FREE SHOT";
+	}
+	else if (id == "RESUPPLY")
+	{
+		int n = 0;
+		for (auto *o : *save->getUnits())
+		{
+			if (o->isOut() || o->getFaction() != u->getFaction() || !beside(u, o)) continue;
+			for (auto *it : *o->getInventory())
+			{
+				if (it->getRules()->getBattleType() != BT_FIREARM) continue;
+				if (BattleItem *a = it->getAmmoForSlot(0))
+					if (a->getAmmoQuantity() < a->getRules()->getClipSize()) { a->setAmmoQuantity(a->getRules()->getClipSize()); ++n; }
+			}
+		}
+		if (!n) return "NOBODY BESIDE IT NEEDS AMMO";
+		msg += ": " + std::to_string(n) + " RELOADED";
+	}
+	else if (id == "FIELD_REPAIR")
+	{
+		BattleUnit *best = nullptr;
+		for (auto *o : *save->getUnits())
+			if (!o->isOut() && o != u && o->getFaction() == u->getFaction() && isVehicleUnit(o) && beside(u, o)
+				&& o->getHealth() < o->getBaseStats()->health && (!best || o->getHealth() < best->getHealth())) best = o;
+		if (!best) return "NO DAMAGED VEHICLE BESIDE IT";
+		// heal() only works on a wounded body part, and a hull has none: add the health straight on
+		const int before = best->getHealth();
+		best->setHealthDirect(std::min((int)best->getBaseStats()->health, before + r.repairHP));
+		msg += ": " + std::to_string(best->getHealth() - before) + " REPAIRED";
+	}
+	else if (id == "RADAR_SWEEP")
+	{
+		int n = 0;
+		for (auto *o : *save->getUnits())
+		{
+			if (o->isOut() || o->getFaction() == u->getFaction() || o->getFaction() == FACTION_NEUTRAL) continue;
+			if (Position::distance2d(o->getPosition(), u->getPosition()) > r.radarRange) continue;
+			o->setVisible(true);
+			o->setTurnsSinceSpotted(0);
+			if (Tile *t = o->getTile()) t->setVisible(+1);
+			++n;
+		}
+		msg += ": " + std::to_string(n) + " CONTACTS";
+	}
+	else if (id == "BRIDGE_CLEAR")
+	{
+		int n = 0;
+		for (const Position &q : frontTiles(u))
+			if (Tile *t = save->getTile(q))
+				for (TilePart part : { O_OBJECT, O_WESTWALL, O_NORTHWALL })
+					if (t->getMapData(part) && t->getMapData(part)->getArmor() < 255) { t->destroy(part, save->getObjectiveType()); ++n; }
+		if (!n) return "NOTHING TO CLEAR";
+		refreshAround(game, u->getPosition());
+		msg = "CLEARED";
+	}
+	else return "NOT BUILT YET";
+
+	if (cost > 0) u->spendTimeUnits(cost);
+	spendUse(save, u, id);
+	Log(LOG_INFO) << "[specials] " << u->getType() << " #" << u->getId() << " uses " << id << " turn " << turn << " TU " << u->getTimeUnits() << ": " << msg;
+	return msg;
+}
+
+int moveCostPct(SavedBattleGame *save, const BattleUnit *u)
+{
+	if (!u || R(save).units.empty()) return 100;
+	return ownTurnNow(save, vget(save, K("vsFlank", u)), u->getFaction()) ? 10000 / (100 + R(save).flankSpeedPct) : 100;
+}
+
+bool moveBlocked(SavedBattleGame *save, const BattleUnit *u)
+{
+	if (!u || R(save).units.empty()) return false;
+	return throughNextTurn(save, vget(save, K("vsHull", u)), u->getFaction())
+		|| throughNextTurn(save, vget(save, K("vsSentry", u)), u->getFaction())
+;
+}
+
+std::string fireBlocked(SavedBattleGame *save, const BattleUnit *u);
+void beforeShot(SavedBattleGame *save, BattleUnit *u, int shotTU)
+{
+	if (!u || R(save).units.empty()) return;
+	if (ownTurnNow(save, vget(save, K("vsSteamShot", u)), u->getFaction()) && u->getStatus() != STATUS_WALKING && fireBlocked(save, u).empty())
+	{
+		vset(save, K("vsSteamShot", u), 0);
+		u->setTimeUnits(u->getTimeUnits() + shotTU);
+		Log(LOG_INFO) << "[specials] " << u->getType() << " steamroller's free shot (" << shotTU << " TU back)";
+	}
+}
+
+std::string fireBlocked(SavedBattleGame *save, const BattleUnit *u)
+{
+	if (!u || R(save).units.empty()) return "";
+	if (ownTurnNow(save, vget(save, K("vsFlank", u)), u->getFaction())) return "FLANK SPEED: NO FIRING THIS TURN";
+	if (ownTurnNow(save, vget(save, K("vsLaserWait", u)), u->getFaction())) return "LASER CHARGING";
+	return "";
+}
+
+bool onShot(BattlescapeGame *game, BattleAction &action, bool reaction)
+{
+	SavedBattleGame *save = game->getSave();
+	BattleUnit *u = action.actor;
+	if (!u || R(save).units.empty()) return false;
+	const auto &r = R(save);
+	const int turn = save->getTurn();
+
+	// Sentry Lock: each reaction shot uses one of its watch
+	if (reaction && throughNextTurn(save, vget(save, K("vsSentry", u)), u->getFaction()))
+	{
+		const int left = vget(save, K("vsSentryLeft", u));
+		if (left > 0) vset(save, K("vsSentryLeft", u), left - 1);
+	}
+	// Laser Charge: the charged shot is the next real one (an armed special that replaces the shot does not use it)
+	vset(save, K("vsLaserLive", u), 0);
+	auto laser = [&]() {
+		if (!reaction && vget(save, K("vsLaser", u)))
+		{
+			vset(save, K("vsLaser", u), 0);
+			vset(save, K("vsLaserLive", u), turn);
+			Log(LOG_INFO) << "[specials] " << u->getType() << " fires its charged laser";
+		}
+		return false;
+	};
+
+	const int armed = vget(save, K("vsArm", u)) - 1;
+	if (reaction || armed < 0) return laser();
+	const std::string id = POOL[armed].id;
+	Tile *tt = save->getTile(action.target);
+	if (!tt) return laser();
+
+	if (id == "SUPPRESSING_FIRE")
+	{
+		int n = 0;
+		for (auto *o : *save->getUnits())
+		{
+			if (o->isOut() || o->getFaction() == u->getFaction()) continue;
+			const Position p = o->getPosition();
+			if (p.z != action.target.z || std::abs(p.x - action.target.x) > r.suppressRadius || std::abs(p.y - action.target.y) > r.suppressRadius) continue;
+			vset(save, K("vsSupp", o), turn);
+			o->moraleChange(-r.suppressMorale);
+			++n;
+		}
+		Log(LOG_INFO) << "[specials] suppressing fire pins " << n << " at " << action.target;
+		vset(save, K("vsArm", u), 0);
+		spendUse(save, u, id);
+		return laser(); // the burst itself still flies
+	}
+	if (id == "FULL_SALVO")
+	{
+		BattleItem *w = action.weapon;
+		if (!w || w->getRules()->getGjaGroup() != "MISSILES") return laser(); // waits for a rocket shot
+		BattleItem *ammo = w->getAmmoForSlot(0);
+		if (!ammo || ammo->getAmmoQuantity() <= 0) return laser();
+		const int n = std::min(ammo->getAmmoQuantity(), r.salvoMax);
+		for (int k = 0; k < n; ++k)
+		{
+			const Position off = k == 0 ? Position(0, 0, 0) : Position(RNG::generate(-1, 1), RNG::generate(-1, 1), 0);
+			const Position at = action.target + off;
+			if (!save->getTile(at)) continue;
+			BattleActionAttack atk; atk.type = action.type; atk.attacker = u; atk.weapon_item = w; atk.damage_item = ammo;
+			game->statePushNext(new ExplosionBState(game, LastPositions(at.toVoxel() + TileEngine::voxelTileCenter), atk));
+		}
+		ammo->setAmmoQuantity(0);
+		u->setTimeUnits(0);
+		vset(save, K("vsArm", u), 0);
+		spendUse(save, u, id);
+		Log(LOG_INFO) << "[specials] " << u->getType() << " full salvo: " << n << " rockets on " << action.target;
+		return true;
+	}
+	if (id == "SPOTTER")
+	{
+		BattleUnit *t = tt->getUnit();
+		if (!t || t->getFaction() == u->getFaction()) { action.result = "NO TARGET TO MARK"; return true; }
+		vset(save, K("vsSpot", t), turn);
+		vset(save, K("vsArm", u), 0);
+		spendUse(save, u, id);
+		action.result = "TARGET MARKED";
+		return true;
+	}
+	if (id == "FLAME_SWEEP")
+	{
+		const Position o = u->getPosition();
+		int dir = 0;
+		auto sgn = [](int x) { return (x > 0) - (x < 0); };
+		Pathfinding::vectorToDirection(Position(sgn(action.target.x - o.x), sgn(action.target.y - o.y), 0), dir);
+		if (dir < 0) dir = u->getDirection();
+		int n = 0;
+		for (int dx = -r.flameRange; dx <= r.flameRange; ++dx)
+			for (int dy = -r.flameRange; dy <= r.flameRange; ++dy)
+			{
+				const Position q = o + Position(dx, dy, 0);
+				if ((dx || dy) && dx * dx + dy * dy <= r.flameRange * r.flameRange && inArc(o, dir, q, 30))
+					if (Tile *t = save->getTile(q)) { t->ignite(15); ++n; }
+			}
+		refreshAround(game, o);
+		Log(LOG_INFO) << "[specials] " << u->getType() << " flame sweep: " << n << " tiles in the cone set alight";
+		u->spendTimeUnits(std::max(1, u->getBaseStats()->tu / 3));
+		vset(save, K("vsArm", u), 0);
+		spendUse(save, u, id);
+		return true;
+	}
+	return laser();
+}
+
+int accuracyBonus(SavedBattleGame *save, const BattleUnit *shooter, const BattleUnit *target)
+{
+	if (!shooter || !target || R(save).units.empty()) return 0;
+	const auto &r = R(save);
+	int b = 0;
+	if (vget(save, K("vsSpot", target)) == save->getTurn()) b += r.spotterBonus;
+	if (save->getSide() != shooter->getFaction() && throughNextTurn(save, vget(save, K("vsSentry", shooter)), shooter->getFaction())) b += r.sentryBonus;
+	// Shield Wall: a man beside a vehicle of his side that is shielding is harder to hit
+	for (auto *v : *save->getUnits())
+		if (!v->isOut() && v != target && v->getFaction() == target->getFaction() && beside(v, target)
+			&& throughNextTurn(save, vget(save, K("vsShield", v)), v->getFaction())) { b -= r.shieldWallPenalty; break; }
+	return b;
+}
+
+int damagePct(SavedBattleGame *save, const BattleUnit *attacker, const BattleUnit *target)
+{
+	if (!attacker || R(save).units.empty()) return 100;
+	return vget(save, K("vsLaserLive", attacker)) == save->getTurn() ? R(save).laserChargePct : 100;
+}
+
+int extraArmor(SavedBattleGame *save, const BattleUnit *attacker, const BattleUnit *target)
+{
+	if (!attacker || !target || R(save).units.empty()) return 0;
+	if (!throughNextTurn(save, vget(save, K("vsHull", target)), target->getFaction())) return 0;
+	if (!inArc(target->getPosition(), target->getDirection(), attacker->getPosition(), 45)) return 0;
+	return target->getArmor(SIDE_FRONT) * R(save).hullDownArmorPct / 100;
+}
+
+double reactionFactor(SavedBattleGame *save, const BattleUnit *reactor, const BattleUnit *mover)
+{
+	if (!reactor || R(save).units.empty()) return 1.0;
+	const auto &r = R(save);
+	const int turn = save->getTurn();
+	if (vget(save, K("vsSupp", reactor)) == turn && save->getSide() != reactor->getFaction()) return 0.0;
+	double f = 1.0;
+	if (mover && mover->isFloating() && throughNextTurn(save, vget(save, K("vsSky", reactor)), reactor->getFaction())) f *= r.skyWatchFactor;
+	if (mover && throughNextTurn(save, vget(save, K("vsSentry", reactor)), reactor->getFaction()) && vget(save, K("vsSentryLeft", reactor)) > 0
+		&& inArc(reactor->getPosition(), vget(save, K("vsSentryDir", reactor)) - 1, mover->getPosition(), r.sentryArc))
+		f *= 10.0;
+	return f;
+}
+
+/// rig only (OXCE_VS_SELFTEST): once a battle, stage Ram, Full Salvo and Suppressing Fire and run them for real
+static void selfTest(BattlescapeGame *game)
+{
+	SavedBattleGame *save = game->getSave();
+	if (!getenv("OXCE_VS_SELFTEST") || save->getVanStop("vsSelfTest")) return;
+	save->setVanStop("vsSelfTest", 1);
+	BattleUnit *joe = nullptr, *cobra = nullptr;
+	for (auto *o : *save->getUnits())
+	{
+		if (o->isOut() || o->getArmor()->getSize() > 1 || o->getTurretType() != -1) continue;
+		if (!joe && o->getFaction() == FACTION_PLAYER && o->getGeoscapeSoldier()) joe = o;
+		if (!cobra && o->getFaction() == FACTION_HOSTILE && !specialsOf(save, o)) cobra = o;
+	}
+	for (auto *v : *save->getUnits())
+	{
+		if (v->isOut() || !specialsOf(save, v)) continue;
+		const auto *sp = specialsOf(save, v);
+		auto hasSp = [&](const char *id) { return std::find(sp->begin(), sp->end(), id) != sp->end(); };
+		BattleUnit *enemy = nullptr;
+		for (auto *o : *save->getUnits())
+			if (!o->isOut() && o->getArmor()->getSize() == 1 && o->getTurretType() == -1 && !specialsOf(save, o)
+				&& ((v->getFaction() == FACTION_HOSTILE && o->getFaction() == FACTION_PLAYER && o->getGeoscapeSoldier())
+					|| (v->getFaction() == FACTION_PLAYER && o->getFaction() == FACTION_HOSTILE))) { enemy = o; break; }
+		(void)joe; (void)cobra;
+		if (!enemy) continue;
+		if (hasSp("RAM"))
+		{
+			// put the enemy on the first free tile in front of it
+			for (const Position &q : frontTiles(v))
+				if (Tile *t = save->getTile(q))
+					if (!t->getUnit() && !t->hasNoFloor(save))
+					{
+						const Position from = enemy->getPosition();
+						enemy->setPosition(q); enemy->setTile(t, save);
+						Log(LOG_INFO) << "[vs-test] " << enemy->getType() << " moved from " << from << " in front of " << v->getType();
+						const int hp = enemy->getHealth(), myHp = v->getHealth();
+						g_selfTest = true;
+						const std::string msg = use(game, v, "RAM");
+						g_selfTest = false;
+						Log(LOG_INFO) << "[vs-test] RAM: " << msg << " | target hp " << hp << " -> " << enemy->getHealth() << ", rammer hp " << myHp << " -> " << v->getHealth();
+						break;
+					}
+		}
+		for (const char *armedId : { "FULL_SALVO", "SUPPRESSING_FIRE" })
+		{
+			if (!hasSp(armedId) || enemy->isOut()) continue;
+			BattleItem *w = std::string(armedId) == "FULL_SALVO" ? rocketWeapon(v) : v->getRightHandWeapon();
+			if (!w) { Log(LOG_INFO) << "[vs-test] " << armedId << ": " << v->getType() << " has no weapon for it"; continue; }
+			g_selfTest = true;
+			use(game, v, armedId);
+			BattleAction a; a.actor = v; a.weapon = w; a.type = BA_SNAPSHOT; a.target = enemy->getPosition();
+			const int before = w->getAmmoForSlot(0) ? w->getAmmoForSlot(0)->getAmmoQuantity() : -1;
+			const bool replaced = onShot(game, a, false);
+			g_selfTest = false;
+			Log(LOG_INFO) << "[vs-test] " << armedId << " by " << v->getType() << " at " << a.target << ": replaced the shot " << replaced
+				<< ", ammo " << before << " -> " << (w->getAmmoForSlot(0) ? w->getAmmoForSlot(0)->getAmmoQuantity() : -1)
+				<< ", target suppressed " << (vget(save, K("vsSupp", enemy)) == save->getTurn()) << ", morale " << enemy->getMorale();
+		}
+	}
+}
+
+/// rig only (OXCE_VS_SELFTEST=2): the rest of the pool on the first Joe vehicle that carries them
+static void selfTest2(BattlescapeGame *game)
+{
+	SavedBattleGame *save = game->getSave();
+	if (std::string(getenv("OXCE_VS_SELFTEST") ? getenv("OXCE_VS_SELFTEST") : "") != "2" || save->getVanStop("vsSelfTest2")) return;
+	save->setVanStop("vsSelfTest2", 1);
+	BattleUnit *v = nullptr, *cobra = nullptr;
+	for (auto *o : *save->getUnits())
+	{
+		if (o->isOut()) continue;
+		if (!v && o->getFaction() == FACTION_PLAYER && specialsOf(save, o)) v = o;
+		if (!cobra && o->getFaction() == FACTION_HOSTILE && !specialsOf(save, o) && o->getArmor()->getSize() == 1) cobra = o;
+	}
+	if (!v || !cobra) { Log(LOG_INFO) << "[vs-test2] no vehicle or no target"; return; }
+	g_selfTest = true;
+	for (const char *id : { "SKY_WATCH", "SHIELD_WALL", "RESUPPLY", "FIELD_REPAIR", "BRIDGE_CLEAR", "LASER_CHARGE", "JUMP" })
+		Log(LOG_INFO) << "[vs-test2] " << id << " -> " << use(game, v, id);
+	Log(LOG_INFO) << "[vs-test2] after LASER_CHARGE, fire blocked: '" << fireBlocked(save, v) << "' (blocks only on its own turn)";
+	for (const char *id : { "SPOTTER", "FLAME_SWEEP" })
+	{
+		use(game, v, id);
+		BattleAction a; a.actor = v; a.weapon = v->getRightHandWeapon(); a.type = BA_SNAPSHOT; a.target = cobra->getPosition();
+		const bool replaced = onShot(game, a, false);
+		Log(LOG_INFO) << "[vs-test2] " << id << " shot at " << a.target << ": replaced " << replaced << ", result '" << a.result << "', fire on target tile " << (cobra->getTile() ? cobra->getTile()->getFire() : -1);
+	}
+	Log(LOG_INFO) << "[vs-test2] accuracy bonus on the spotted " << cobra->getType() << ": " << accuracyBonus(save, v, cobra);
+	{
+		BattleAction a; a.actor = v; a.weapon = v->getRightHandWeapon(); a.type = BA_SNAPSHOT; a.target = cobra->getPosition();
+		onShot(game, a, false); // the charged shot
+		Log(LOG_INFO) << "[vs-test2] laser shot damage pct " << damagePct(save, v, cobra);
+	}
+	vset(save, K("vsHull", v), save->getTurn());
+	Log(LOG_INFO) << "[vs-test2] hull down: move blocked " << moveBlocked(save, v) << ", extra armour v. a shot from in front " << extraArmor(save, cobra, v) << " (0 if the shooter is not in its front arc)";
+	g_selfTest = false;
+}
+
+bool aiThink(BattlescapeGame *game, BattleUnit *u, BattleAction *action, int visibleEnemies)
+{
+	SavedBattleGame *save = game->getSave();
+	selfTest(game);
+	selfTest2(game);
+	if (!specialsOf(save, u) || u->isOut()) return false;
+	const int turn = save->getTurn();
+	const std::string once = K("vsAiTurn", u);
+	auto usable = [&](const char *id) { for (auto &e : list(save, u)) if (e.id == id) return e.usable; return false; };
+
+	// Ram: a Joe right in front
+	if (usable("RAM"))
+		if (BattleUnit *t = unitInFront(save, u))
+			if (t->getFaction() == FACTION_PLAYER)
+			{
+				use(game, u, "RAM");
+				action->type = BA_RETHINK;
+				return true;
+			}
+	if (vget(save, once) == turn) return false; // one decision a turn for the rest
+	vset(save, once, turn);
+	// Full Salvo: two or more Joes it can see within a tile of each other
+	if (usable("FULL_SALVO") && visibleEnemies >= 2)
+	{
+		auto *seen = u->getVisibleUnits();
+		for (auto *a : *seen) for (auto *b : *seen)
+			if (a != b && a->getFaction() == FACTION_PLAYER && b->getFaction() == FACTION_PLAYER && Position::distance2d(a->getPosition(), b->getPosition()) <= 1
+				&& vget(save, K("vsArm", u)) == 0)
+			{
+				use(game, u, "FULL_SALVO");
+				if (BattleItem *w = rocketWeapon(u)) { u->setActiveRightHand(); (void)w; }
+				return false;
+			}
+	}
+	// Suppressing Fire: two or more Joes in sight
+	if (usable("SUPPRESSING_FIRE") && visibleEnemies >= 2 && vget(save, K("vsArm", u)) == 0)
+	{
+		use(game, u, "SUPPRESSING_FIRE");
+		return false;
+	}
+	// Sentry Lock: nobody in sight, but a Joe was seen lately: park facing where he was
+	if (usable("SENTRY_LOCK") && visibleEnemies == 0 && u->getTimeUnits() >= u->getBaseStats()->tu
+		&& vget(save, K("vsSentry", u)) < turn - 1) // not two turns running: it moves in between
+	{
+		for (auto *o : *save->getUnits())
+		{
+			if (o->getFaction() != FACTION_PLAYER || o->isOut()) continue;
+			const int seenTurn = save->getVanStop("seenTurn:" + std::to_string(o->getId()), -100);
+			if (seenTurn < turn - 2) continue;
+			const int enc = save->getVanStop("seenAt:" + std::to_string(o->getId())) - 1;
+			const Position at(enc / 100000, (enc / 100) % 1000, enc % 100);
+			for (bool turret : { false, true })
+			{
+				if (turret && u->getTurretType() == -1) continue;
+				u->lookAt(at, turret);
+				while (u->getStatus() == STATUS_TURNING) u->turn(turret);
+			}
+			use(game, u, "SENTRY_LOCK");
+			action->type = BA_NONE;
+			return true;
+		}
+	}
+	// Flank Speed: nobody in sight, half the time, to close in
+	if (usable("FLANK_SPEED") && visibleEnemies == 0 && RNG::percent(50))
+		use(game, u, "FLANK_SPEED");
+	return false;
+}
+
+
+/// rig only (OXCE_VS_SELFTEST=3), once, at the start of the Joes' second turn: Jump, Resupply, Field Repair and
+/// Sentry Lock's reaction shot done for real, with the time units each one cost (needs a rig overlay that hands
+/// STR_COBRA_TROOPER [JUMP, RESUPPLY, FIELD_REPAIR] and a H.I.S.S. on the map)
+void turnStart(BattlescapeGame *game)
+{
+	SavedBattleGame *save = game->getSave();
+	const char *e = getenv("OXCE_VS_SELFTEST");
+	if (!e || std::string(e) != "3" || save->getSide() != FACTION_PLAYER || save->getTurn() < 2 || save->getVanStop("vsSelfTest3")) return;
+	save->setVanStop("vsSelfTest3", 1);
+	BattleUnit *trooper = nullptr, *other = nullptr, *hiss = nullptr, *joe = nullptr;
+	for (auto *o : *save->getUnits())
+	{
+		if (o->isOut()) continue;
+		if (o->getFaction() == FACTION_HOSTILE && o->getArmor()->getSize() == 1 && has(save, o, "JUMP")) { if (!trooper) trooper = o; else if (!other) other = o; }
+		if (!hiss && o->getFaction() == FACTION_HOSTILE && has(save, o, "SENTRY_LOCK")) hiss = o;
+		if (!joe && o->getFaction() == FACTION_PLAYER && o->getArmor()->getSize() == 1) joe = o;
+	}
+	Log(LOG_INFO) << "[vs-test3] trooper " << (trooper != nullptr) << ", second trooper " << (other != nullptr) << ", H.I.S.S. " << (hiss != nullptr) << ", Joe " << (joe != nullptr);
+	if (!trooper) return;
+	g_selfTest = true;
+	auto full = [](BattleUnit *u) { u->setTimeUnits(u->getBaseStats()->tu); };
+	auto freeBeside = [&](Position c, int size) -> Tile*
+	{
+		for (int dx = -1; dx <= size; ++dx) for (int dy = -1; dy <= size; ++dy)
+		{
+			if (dx >= 0 && dx < size && dy >= 0 && dy < size) continue;
+			Tile *t = save->getTile(c + Position(dx, dy, 0));
+			if (t && !t->getUnit() && !t->hasNoFloor(save) && t->getTUCost(O_OBJECT, MT_WALK) != Pathfinding::INVALID_MOVE_COST) return t;
+		}
+		return nullptr;
+	};
+	auto put = [&](BattleUnit *u, Tile *t) { const Position from = u->getPosition(); u->setPosition(t->getPosition()); u->setTile(t, save); refreshAround(game, from); };
+
+	// JUMP: two tiles ahead, at its time-unit price
+	for (int d = 0; d < 8; ++d)
+	{
+		full(trooper);
+		trooper->setDirection(d);
+		const Position from = trooper->getPosition();
+		const int tu = trooper->getTimeUnits();
+		const std::string m = use(game, trooper, "JUMP");
+		if (m == "NOWHERE TO LAND") continue;
+		Log(LOG_INFO) << "[vs-test3] JUMP facing " << d << ": " << from << " -> " << trooper->getPosition() << ", TU " << tu << " -> " << trooper->getTimeUnits() << " (rule says " << tuCost(save, trooper, "JUMP") << "), '" << m << "'";
+		break;
+	}
+
+	// RESUPPLY: a man beside it with one round left
+	if (other)
+	{
+		if (Tile *t = freeBeside(trooper->getPosition(), 1)) put(other, t);
+		BattleItem *clip = nullptr;
+		for (auto *it : *other->getInventory())
+			if (it->getRules()->getBattleType() == BT_FIREARM && it->getAmmoForSlot(0)) { clip = it->getAmmoForSlot(0); break; }
+		if (clip)
+		{
+			clip->setAmmoQuantity(1);
+			full(trooper);
+			const int tu = trooper->getTimeUnits();
+			const std::string m = use(game, trooper, "RESUPPLY");
+			Log(LOG_INFO) << "[vs-test3] RESUPPLY: neighbour's clip 1 -> " << clip->getAmmoQuantity() << " of " << clip->getRules()->getClipSize() << ", TU " << tu << " -> " << trooper->getTimeUnits() << " (rule says " << tuCost(save, trooper, "RESUPPLY") << "), '" << m << "'";
+		}
+		else Log(LOG_INFO) << "[vs-test3] RESUPPLY: the second man carries no loaded gun";
+	}
+
+	// FIELD REPAIR: stand beside the damaged H.I.S.S.
+	if (hiss)
+	{
+		if (Tile *t = freeBeside(hiss->getPosition(), hiss->getArmor()->getSize())) put(trooper, t);
+		hiss->setHealthDirect(std::max(1, hiss->getHealth() - 25));
+		full(trooper);
+		const int hp = hiss->getHealth(), tu = trooper->getTimeUnits();
+		const std::string m = use(game, trooper, "FIELD_REPAIR");
+		Log(LOG_INFO) << "[vs-test3] FIELD_REPAIR: H.I.S.S. " << hp << " -> " << hiss->getHealth() << " of " << hiss->getBaseStats()->health << ", TU " << tu << " -> " << trooper->getTimeUnits() << " (rule says " << tuCost(save, trooper, "FIELD_REPAIR") << "), '" << m << "'";
+	}
+
+	// SENTRY LOCK: lock its arc, put a Joe in it, and let the engine's own reaction check run
+	if (hiss && joe)
+	{
+		full(hiss);
+		const std::string m = use(game, hiss, "SENTRY_LOCK");
+		const Position v = dirVec(hiss->getDirection()), c = hiss->getPosition();
+		Tile *spot = nullptr;
+		for (int k = 4; k <= 9 && !spot; ++k)
+		{
+			Tile *t = save->getTile(c + Position(v.x * k, v.y * k, 0));
+			if (t && !t->getUnit() && !t->hasNoFloor(save) && t->getTUCost(O_OBJECT, MT_WALK) != Pathfinding::INVALID_MOVE_COST) spot = t;
+		}
+		if (spot)
+		{
+			put(joe, spot);
+			game->getTileEngine()->calculateFOV(hiss);
+			game->getTileEngine()->calculateFOV(joe);
+			const int tu = hiss->getTimeUnits();
+			BattleAction walk; walk.actor = joe; walk.type = BA_WALK; walk.target = joe->getPosition();
+			const bool fired = game->getTileEngine()->checkReactionFire(joe, walk);
+			Log(LOG_INFO) << "[vs-test3] SENTRY_LOCK '" << m << "': Joe put at " << joe->getPosition() << " in its arc (H.I.S.S. at " << c << " facing " << hiss->getDirection()
+				<< ", sees him " << (hiss->hasVisibleUnit(joe) ? "yes" : "no") << "), reaction fire " << (fired ? "YES" : "no") << ", H.I.S.S. TU " << tu << " -> " << hiss->getTimeUnits();
+		}
+		else Log(LOG_INFO) << "[vs-test3] SENTRY_LOCK: no free tile in front of the H.I.S.S.";
+	}
+	g_selfTest = false;
+}
+
+}
+
+}
diff --git a/src/Battlescape/VehicleSpecials.h b/src/Battlescape/VehicleSpecials.h
new file mode 100644
index 0000000..1d783e5
--- /dev/null
+++ b/src/Battlescape/VehicleSpecials.h
@@ -0,0 +1,59 @@
+#pragma once
+/*
+ * G.I. Joe: vehicle specials (VEHICLE_SPECIALS_v1, BRIEF_FOR_BUILD_VehicleSpecials; BUILD-2).
+ * A vehicle type carries a few specials from a shared pool (rules: vehicleSpecials). Each is used from the HUD's
+ * SPECIALS list (or by Cobra's AI). Instant ones act at once; "armed" ones change the vehicle's next shot.
+ * State lives in the battle's vanStop map, keyed by unit id, so it saves with the battle.
+ */
+#include <string>
+#include <vector>
+
+namespace OpenXcom
+{
+
+class SavedBattleGame;
+class BattlescapeGame;
+class BattleUnit;
+class BattleItem;
+struct BattleAction;
+
+namespace VehicleSpecials
+{
+	struct Entry
+	{
+		std::string id;    ///< FLANK_SPEED, ...
+		std::string label; ///< "FLANK SPEED  2" (name + uses left, or ARMED)
+		bool usable = true;
+		std::string why;   ///< why not, when not usable
+	};
+
+	/// the specials this unit carries, as the HUD lists them (empty for a unit without specials)
+	std::vector<Entry> list(SavedBattleGame *save, BattleUnit *u);
+	/// uses one; returns a message for the player (empty = nothing to say)
+	std::string use(BattlescapeGame *game, BattleUnit *u, const std::string &id);
+	/// rig only: the staged test of OXCE_VS_SELFTEST=3, at a side's turn start
+	void turnStart(BattlescapeGame *game);
+
+	/// Pathfinding step cost in percent (Flank Speed 50)
+	int moveCostPct(SavedBattleGame *save, const BattleUnit *u);
+	/// Pathfinding: a unit that may not move now (Hull Down, Sentry Lock)
+	bool moveBlocked(SavedBattleGame *save, const BattleUnit *u);
+	/// ProjectileFlyBState::init, before the TU check: a free shot owed (Steamroller) hands its TU back
+	void beforeShot(SavedBattleGame *save, BattleUnit *u, int shotTU);
+	/// ProjectileFlyBState::init, before a shot: why this unit may not fire now (Flank Speed, Laser Charge) - empty = may
+	std::string fireBlocked(SavedBattleGame *save, const BattleUnit *u);
+	/// ProjectileFlyBState::init, the shot is going ahead: an armed special acts on it. Returns true if the special
+	/// replaces the shot (Full Salvo, Spotter): the caller pops the state.
+	bool onShot(BattlescapeGame *game, BattleAction &action, bool reaction);
+	/// to-hit bonus (percent) for shooter firing at target: Spotter, Sentry Lock
+	int accuracyBonus(SavedBattleGame *save, const BattleUnit *shooter, const BattleUnit *target);
+	/// damage in percent and extra armour for a hit from attacker on target: Laser Charge, Hull Down
+	int damagePct(SavedBattleGame *save, const BattleUnit *attacker, const BattleUnit *target);
+	int extraArmor(SavedBattleGame *save, const BattleUnit *attacker, const BattleUnit *target);
+	/// reaction fire: multiplier on reactor's reaction score against mover (Suppressing Fire 0, Sky Watch 2, Sentry Lock)
+	double reactionFactor(SavedBattleGame *save, const BattleUnit *reactor, const BattleUnit *mover);
+	/// AIModule (BattleAI 10): Cobra's vehicle may use a special this think; returns true if it did (action set)
+	bool aiThink(BattlescapeGame *game, BattleUnit *u, BattleAction *action, int visibleEnemies);
+}
+
+}
diff --git a/src/Battlescape/Villains.cpp b/src/Battlescape/Villains.cpp
new file mode 100644
index 0000000..d836dd0
--- /dev/null
+++ b/src/Battlescape/Villains.cpp
@@ -0,0 +1,485 @@
+/*
+ * G.I. Joe: the named villains' Moves and traits. See Villains.h.
+ *
+ * Year 1 Moves (John 15 Nov "1"): Major Bludd's mark, Firefly's booby trap, Storm Shadow's silent shot from hiding (John replaced his strike),
+ * Scrap-Iron's remote missile (the stock launcher AI, vehicles first), Copperhead's Water Moccasin drop, Buzzer's
+ * cut-through, Ripper's door, Torch's cut and burn. Each is used once a mission (SavedBattleGame's vanStop store:
+ * "gjv:<id>"). Zartan's disguise and Wild Weasel's strafing run are not built (the disguise fork is parked; the
+ * strafing run belongs to the air fights).
+ */
+#include "Villains.h"
+#include <algorithm>
+#include <climits>
+#include <cstdlib>
+#include "../Savegame/SavedBattleGame.h"
+#include "../Savegame/BattleUnit.h"
+#include "../Savegame/BattleItem.h"
+#include "../Savegame/Tile.h"
+#include "../Savegame/Soldier.h"
+#include "../Battlescape/TileEngine.h"
+#include "../Battlescape/Pathfinding.h"
+#include "../Battlescape/BattlescapeState.h"
+#include "../Battlescape/BattlescapeGame.h"
+#include "../Mod/Mod.h"
+#include "../Mod/RuleItem.h"
+#include "../Mod/Armor.h"
+#include "../Mod/MapData.h"
+#include "../Mod/Unit.h"
+#include "../Mod/RuleSoldier.h"
+#include "../Engine/Game.h"
+#include "../Engine/Logger.h"
+#include "../Engine/Language.h"
+
+namespace OpenXcom
+{
+namespace Villains
+{
+
+namespace
+{
+
+const Mod::VillainRule *rule(SavedBattleGame *save, const BattleUnit *u)
+{
+	if (!u || !save) return nullptr;
+	return save->getMod()->getVillainRule(u->getType());
+}
+
+std::string key(const char *what, const BattleUnit *u) { return std::string(what) + ":" + std::to_string(u->getId()); }
+bool used(SavedBattleGame *save, const BattleUnit *u) { return save->getVanStop(key("gjv", u)) > 0; }
+void markUsed(SavedBattleGame *save, const BattleUnit *u) { save->setVanStop(key("gjv", u), 1); }
+
+int encode(const Position &p) { return 1 + p.x + p.y * 1000 + p.z * 1000000; }
+Position decode(int v) { --v; return Position(v % 1000, (v / 1000) % 1000, v / 1000000); }
+
+std::string nameOf(SavedBattleGame *save, BattleUnit *u)
+{
+	BattlescapeState *st = save->getBattleState();
+	if (!st) return u->getType();
+	return u->getName(st->getGame()->getLanguage(), false);
+}
+
+void notice(SavedBattleGame *save, const std::string &k, BattleUnit *a, BattleUnit *b = nullptr)
+{
+	BattlescapeState *st = save->getBattleState();
+	if (!st) return;
+	std::string s = st->tr(k).arg(nameOf(save, a)).arg(b ? nameOf(save, b) : std::string());
+	st->warningRaw(s);
+}
+
+/// the type a record names him by: a Joe's soldier type (STR_DUKE), else the unit type
+std::string typeOf(const BattleUnit *b)
+{
+	if (b && b->getGeoscapeSoldier()) return b->getGeoscapeSoldier()->getRules()->getType();
+	return b ? b->getType() : std::string();
+}
+
+bool isJoe(const BattleUnit *b) { return b && b->getFaction() == FACTION_PLAYER && !b->isOut() && b->getTile(); }
+
+/// the nearest Joe Cobra knows about (seen this turn or lately), or any Joe if allowAny
+BattleUnit *nearestKnownJoe(SavedBattleGame *save, BattleUnit *u, bool allowAny)
+{
+	BattleUnit *best = nullptr;
+	int bd = INT_MAX;
+	for (auto *b : *save->getUnits())
+	{
+		if (!isJoe(b)) continue;
+		// OXCE_VILLAIN_TEST: the villains know where every Joe is, so each Move can be seen in a short test
+		static const bool test = getenv("OXCE_VILLAIN_TEST") != nullptr;
+		if (!allowAny && !test && b->getTurnsSinceSpottedByFaction(FACTION_HOSTILE) > 2) continue;
+		const int d = Position::distanceSq(b->getPosition(), u->getPosition());
+		if (d < bd) { bd = d; best = b; }
+	}
+	return best;
+}
+
+/// the tile part between two orthogonal neighbours a -> b (the wall you'd walk through), or false
+bool boundary(SavedBattleGame *save, const Position &a, const Position &b, Tile **tile, TilePart *part)
+{
+	if (a.z != b.z) return false;
+	const int dx = b.x - a.x, dy = b.y - a.y;
+	if (std::abs(dx) + std::abs(dy) != 1) return false;
+	if (dx == 1) { *tile = save->getTile(b); *part = O_WESTWALL; }
+	else if (dx == -1) { *tile = save->getTile(a); *part = O_WESTWALL; }
+	else if (dy == 1) { *tile = save->getTile(b); *part = O_NORTHWALL; }
+	else { *tile = save->getTile(a); *part = O_NORTHWALL; }
+	return *tile && (*tile)->getMapData(*part) && !(*tile)->getMapData(*part)->isGravLift();
+}
+
+bool isDoorPart(Tile *t, TilePart p)
+{
+	MapData *md = t ? t->getMapData(p) : nullptr;
+	return md && (md->isDoor() || md->isUFODoor());
+}
+
+/// tear out a wall or door part and let the battle see through the gap
+void breach(SavedBattleGame *save, Tile *t, TilePart p, bool fire, const Position &other)
+{
+	t->destroy(p, save->getObjectiveType());
+	if (fire)
+	{
+		t->ignite(60);
+		if (Tile *o = save->getTile(other)) o->ignite(60);
+	}
+	save->getTileEngine()->calculateLighting(LL_FIRE, t->getPosition(), 1, true);
+	save->getTileEngine()->calculateFOV(t->getPosition(), 1, true, true);
+}
+
+BattleItem *meleeWeapon(BattleUnit *u)
+{
+	for (BattleItem *w : { u->getRightHandWeapon(), u->getLeftHandWeapon() })
+		if (w && w->getRules()->getBattleType() == BT_MELEE) return w;
+	return nullptr;
+}
+
+/// a free tile with a floor (or the ground) a man can stand on
+bool standable(SavedBattleGame *save, const Position &p)
+{
+	Tile *t = save->getTile(p);
+	if (!t || t->getUnit()) return false;
+	if (t->getTUCost(O_OBJECT, MT_WALK) == Pathfinding::INVALID_MOVE_COST) return false;
+	return !t->hasNoFloor(save);
+}
+
+/// a two-step plan: walk to a tile, then act there. Returns the stored target, or invalid.
+Position plan(SavedBattleGame *save, const BattleUnit *u, const char *what)
+{
+	const int v = save->getVanStop(key(what, u));
+	return v > 0 ? decode(v) : TileEngine::invalid;
+}
+
+bool walkTo(SavedBattleGame *save, BattleUnit *u, const Position &to, BattleAction *action)
+{
+	save->getPathfinding()->calculate(u, to, BAM_NORMAL);
+	const bool can = save->getPathfinding()->getStartDirection() != -1;
+	save->getPathfinding()->abortPath();
+	if (!can) return false;
+	action->type = BA_WALK;
+	action->target = to;
+	return true;
+}
+
+std::vector<Position> reachable(SavedBattleGame *save, BattleUnit *u, const BattleActionCost &cost)
+{
+	std::vector<Position> out;
+	for (int i : save->getPathfinding()->findReachable(u, cost))
+	{
+		out.push_back(save->getTileCoords(i));
+	}
+	return out;
+}
+
+// ---- the Moves ----
+
+/// Major Bludd: marks one Joe in sight; every Cobra +20 to hit him for the rest of the mission
+bool moveMark(SavedBattleGame *save, BattleUnit *u, const Mod::VillainRule &r)
+{
+	BattleUnit *pick = nullptr;
+	int bd = INT_MAX;
+	for (auto *b : *u->getVisibleUnits())
+	{
+		if (!isJoe(b)) continue;
+		int d = Position::distanceSq(b->getPosition(), u->getPosition());
+		if (std::find(r.marked.begin(), r.marked.end(), typeOf(b)) != r.marked.end()) d -= 100000;
+		if (d < bd) { bd = d; pick = b; }
+	}
+	if (!pick) return false;
+	save->setVanStop("gjvMark", pick->getId() + 1);
+	markUsed(save, u);
+	Log(LOG_INFO) << "[villain] " << u->getType() << " marks " << typeOf(pick) << " #" << pick->getId();
+	notice(save, "STR_GJV_MARK", u, pick);
+	return false; // a free action: he goes on with his turn
+}
+
+/// Firefly: walks to a door or doorway toward the Joes and leaves a hidden charge there
+bool moveTrap(SavedBattleGame *save, BattleUnit *u, const Mod::VillainRule &r, BattleAction *action)
+{
+	const RuleItem *charge = save->getMod()->getItem(r.item, false);
+	if (!charge) return false;
+	Position goal = plan(save, u, "gjvT");
+	if (goal == TileEngine::invalid)
+	{
+		BattleUnit *joe = nearestKnownJoe(save, u, false);
+		if (!joe) return false;
+		int best = INT_MIN;
+		for (const auto &p : reachable(save, u, BattleActionCost()))
+		{
+			if (p.z != u->getPosition().z) continue;
+			const int dj = Position::distance2d(p, joe->getPosition());
+			if (dj < 3 || dj > 14) continue;
+			Tile *t = save->getTile(p);
+			if (!t || (t->getUnit() && t->getUnit() != u)) continue;
+			bool door = isDoorPart(t, O_WESTWALL) || isDoorPart(t, O_NORTHWALL)
+				|| isDoorPart(save->getTile(p + Position(1, 0, 0)), O_WESTWALL) || isDoorPart(save->getTile(p + Position(0, 1, 0)), O_NORTHWALL);
+			const int score = (door ? 20 : 0) - dj;
+			if (score > best) { best = score; goal = p; }
+		}
+		if (goal == TileEngine::invalid) goal = u->getPosition();
+		save->setVanStop(key("gjvT", u), encode(goal));
+	}
+	if (u->getPosition() != goal)
+	{
+		if (walkTo(save, u, goal, action)) return true;
+		goal = u->getPosition(); // can't get there: leave it where he stands
+	}
+	BattleItem *it = save->createItemForTile(charge, save->getTile(goal));
+	it->setFuseTimer(0);
+	save->setVanStop("gjvCharge:" + std::to_string(it->getId()), 1);
+	markUsed(save, u);
+	save->setVanStop(key("gjvT", u), 0);
+	u->spendTimeUnits(std::min(15, u->getTimeUnits()));
+	Log(LOG_INFO) << "[villain] " << u->getType() << " leaves a charge at " << goal << " (item " << it->getId() << ")";
+	return false;
+}
+
+/// Storm Shadow (John 15 Nov, replacing the Arashikage Strike): the silent assassin. From hiding - no Joe can see
+/// him - one aimed bow shot at a Joe who hasn't seen him: double damage, and it doesn't give him away.
+bool moveAssassin(SavedBattleGame *save, BattleUnit *u, BattleAction *action)
+{
+	BattleItem *bow = u->getRightHandWeapon();
+	if (!bow || bow->getRules()->getBattleType() != BT_FIREARM || !bow->haveAnyAmmo()) bow = u->getLeftHandWeapon();
+	if (!bow || bow->getRules()->getBattleType() != BT_FIREARM || !bow->haveAnyAmmo()) return false;
+	for (auto *b : *save->getUnits()) // hidden: no Joe sees him now
+		if (isJoe(b) && std::find(b->getVisibleUnits()->begin(), b->getVisibleUnits()->end(), u) != b->getVisibleUnits()->end()) return false;
+	BattleActionCost cost(BA_AIMEDSHOT, u, bow);
+	if (!cost.haveTU()) return false;
+	BattleUnit *pick = nullptr;
+	int bd = INT_MAX;
+	for (auto *b : *u->getVisibleUnits())
+	{
+		if (!isJoe(b)) continue;
+		const int d = Position::distanceSq(b->getPosition(), u->getPosition());
+		if (d < bd) { bd = d; pick = b; }
+	}
+	if (!pick) return false;
+	action->type = BA_AIMEDSHOT;
+	action->weapon = bow;
+	action->target = pick->getPosition();
+	save->setVanStop(key("gjvAss", u), pick->getId() + 1);
+	save->setVanStop(key("gjvAssT", u), save->getTurn() + 1);
+	markUsed(save, u);
+	Log(LOG_INFO) << "[villain] " << u->getType() << " shoots " << typeOf(pick) << " from hiding";
+	notice(save, "STR_GJV_ASSASSIN", u);
+	return true;
+}
+
+/// Buzzer, Ripper, Torch: through a wall or door. Buzzer goes for a Joe behind a wall and cuts him down; Ripper
+/// tears a door off on the way to the Joes; Torch cuts a wall or door on the way and sets it burning.
+bool moveBreach(SavedBattleGame *save, BattleUnit *u, const Mod::VillainRule &r, BattleAction *action)
+{
+	const bool buzzer = r.move == "CUT_THROUGH", doorsOnly = r.move == "RIP_DOOR", fire = r.move == "CUT_BURN";
+	BattleItem *melee = meleeWeapon(u);
+	Position at = plan(save, u, "gjvB"), through = plan(save, u, "gjvBT");
+	if (at == TileEngine::invalid)
+	{
+		BattleUnit *joe = nearestKnownJoe(save, u, false);
+		if (!joe) return false;
+		const BattleActionCost cost = buzzer && melee ? BattleActionCost(BA_HIT, u, melee) : BattleActionCost();
+		std::vector<Position> can = reachable(save, u, cost);
+		can.push_back(u->getPosition());
+		int best = INT_MAX;
+		static const Position dirs[4] = { Position(1, 0, 0), Position(-1, 0, 0), Position(0, 1, 0), Position(0, -1, 0) };
+		for (const auto &p : can)
+		{
+			for (const auto &d : dirs)
+			{
+				const Position n = p + d;
+				Tile *t; TilePart part;
+				if (!boundary(save, p, n, &t, &part)) continue;
+				if (doorsOnly && !isDoorPart(t, part)) continue;
+				int score;
+				Tile *nt = save->getTile(n);
+				if (buzzer && nt && isJoe(nt->getUnit()))
+				{
+					score = Position::distanceSq(p, u->getPosition()); // a Joe right behind the wall: best of all
+				}
+				else if (buzzer && Position::distanceSq(n, joe->getPosition()) > 25)
+				{
+					continue; // otherwise only a wall within 5 tiles of a Joe is worth cutting
+				}
+				else
+				{
+					const int dn = Position::distanceSq(n, joe->getPosition()), dp = Position::distanceSq(p, joe->getPosition());
+					if (dn >= dp || n.z != joe->getPosition().z) continue;
+					score = 1000 + dn * 4 + Position::distanceSq(p, u->getPosition());
+				}
+				if (score < best) { best = score; at = p; through = n; }
+			}
+		}
+		if (at == TileEngine::invalid) return false;
+		save->setVanStop(key("gjvB", u), encode(at));
+		save->setVanStop(key("gjvBT", u), encode(through));
+	}
+	if (u->getPosition() != at)
+	{
+		if (walkTo(save, u, at, action)) return true;
+		save->setVanStop(key("gjvB", u), 0);
+		save->setVanStop(key("gjvBT", u), 0);
+		return false;
+	}
+	save->setVanStop(key("gjvB", u), 0);
+	save->setVanStop(key("gjvBT", u), 0);
+	Tile *t; TilePart part;
+	if (!boundary(save, at, through, &t, &part)) return false;
+	breach(save, t, part, fire, through);
+	markUsed(save, u);
+	u->spendTimeUnits(std::min(10, u->getTimeUnits()));
+	Log(LOG_INFO) << "[villain] " << u->getType() << " breaches " << at << " -> " << through;
+	notice(save, buzzer ? "STR_GJV_BREACH" : fire ? "STR_GJV_BURN" : "STR_GJV_DOOR", u);
+	Tile *nt = save->getTile(through);
+	if (buzzer && melee && nt && isJoe(nt->getUnit()))
+	{
+		BattleActionCost c(BA_HIT, u, melee);
+		if (c.haveTU())
+		{
+			action->type = BA_HIT;
+			action->weapon = melee;
+			action->target = through;
+			return true;
+		}
+	}
+	return false;
+}
+
+/// Copperhead: his Water Moccasin crosses the map in one turn and drops Cobra troops close to the Joes, out of
+/// their sight; he comes with them, and his turn is spent
+bool moveDrop(SavedBattleGame *save, BattleUnit *u, const Mod::VillainRule &r, BattleAction *action)
+{
+	const Unit *type = save->getMod()->getUnit(r.spawn, false);
+	BattleUnit *joe = nearestKnownJoe(save, u, false);
+	if (!type || !joe) return false;
+	const Position jp = joe->getPosition();
+	auto seen = [&](const Position &p) {
+		for (auto *b : *save->getUnits())
+			if (isJoe(b) && save->getTileEngine()->visible(b, save->getTile(p))) return true;
+		return false;
+	};
+	Position drop = TileEngine::invalid;
+	for (int r2 = 6; r2 <= 12 && drop == TileEngine::invalid; ++r2)
+		for (int dx = -r2; dx <= r2 && drop == TileEngine::invalid; ++dx)
+			for (int dy = -r2; dy <= r2 && drop == TileEngine::invalid; ++dy)
+			{
+				if (std::max(std::abs(dx), std::abs(dy)) != r2) continue;
+				const Position p = jp + Position(dx, dy, 0);
+				if (!standable(save, p) || seen(p)) continue;
+				int room = 0;
+				for (int ax = -1; ax <= 1; ++ax) for (int ay = -1; ay <= 1; ++ay) if (standable(save, p + Position(ax, ay, 0))) ++room;
+				if (room >= r.count + 2) drop = p;
+			}
+	if (drop == TileEngine::invalid) return false;
+	// Copperhead himself
+	save->setUnitPosition(u, drop);
+	u->setDirection(save->getTileEngine()->getDirectionTo(drop, jp));
+	int made = 0;
+	for (int ax = -1; ax <= 1 && made < r.count; ++ax)
+		for (int ay = -1; ay <= 1 && made < r.count; ++ay)
+		{
+			const Position p = drop + Position(ax, ay, 0);
+			if (!standable(save, p)) continue;
+			BattleUnit *nu = save->createTempUnit(type, FACTION_HOSTILE);
+			nu->setTile(save->getTile(p), save);
+			nu->setPosition(p);
+			nu->setDirection(save->getTileEngine()->getDirectionTo(p, jp));
+			nu->clearTimeUnits();
+			nu->setVisible(false);
+			save->getUnits()->push_back(nu);
+			save->initUnit(nu, 0);
+			++made;
+		}
+	save->getTileEngine()->calculateFOV(drop);
+	markUsed(save, u);
+	u->clearTimeUnits();
+	Log(LOG_INFO) << "[villain] " << u->getType() << " drops " << made << " troopers at " << drop;
+	notice(save, "STR_GJV_MOCCASIN", u);
+	action->type = BA_NONE;
+	return true;
+}
+
+} // namespace
+
+bool think(SavedBattleGame *save, BattleUnit *unit, BattleAction *action)
+{
+	static const bool test = getenv("OXCE_VILLAIN_TEST") != nullptr;
+	if (test) // the test: Cobra knows where every Joe is
+		for (auto *b : *save->getUnits())
+			if (isJoe(b)) { b->setTurnsSinceSpottedByFaction(FACTION_HOSTILE, 0); b->setTurnsLeftSpottedForSnipersByFaction(FACTION_HOSTILE, 2); }
+	const Mod::VillainRule *r = rule(save, unit);
+	if (!r || r->move.empty() || r->move == "NONE" || unit->getFaction() != FACTION_HOSTILE) return false;
+	if (used(save, unit)) return false;
+	if (r->move == "MARK") return moveMark(save, unit, *r);
+	if (r->move == "SILENT_ASSASSIN") return moveAssassin(save, unit, action);
+	if (r->move == "BOOBY_TRAP") return moveTrap(save, unit, *r, action);
+	if (r->move == "CUT_THROUGH" || r->move == "RIP_DOOR" || r->move == "CUT_BURN") return moveBreach(save, unit, *r, action);
+	if (r->move == "MOCCASIN_DROP") return moveDrop(save, unit, *r, action);
+	return false; // REMOTE_MISSILE is the stock launcher AI (prefersVehicles), one bomb
+}
+
+int damagePct(SavedBattleGame *save, const BattleUnit *attacker, const BattleUnit *victim)
+{
+	const Mod::VillainRule *r = rule(save, attacker);
+	if (!r || !victim) return 100;
+	// Storm Shadow's shot from hiding: double damage, that one shot
+	if (save->getVanStop(key("gjvAss", attacker)) == victim->getId() + 1 && save->getVanStop(key("gjvAssT", attacker)) == save->getTurn() + 1)
+	{
+		save->setVanStop(key("gjvAss", attacker), 0);
+		Log(LOG_INFO) << "[villain] " << attacker->getType() << "'s shot from hiding hits " << typeOf(victim) << ": double damage";
+		return 200;
+	}
+	if (r->trait.empty()) return 100;
+	if (r->trait == "MARKED_LIST")
+	{
+		const bool marked = std::find(r->marked.begin(), r->marked.end(), typeOf(victim)) != r->marked.end();
+		return marked ? r->pct : 100;
+	}
+	if (r->trait == "VEHICLE_HUNTER") return isJoeVehicle(victim) ? r->pct : 100;
+	if (r->trait == "CLOSE_QUARTERS")
+		return Position::distance2d(attacker->getPosition(), victim->getPosition()) <= r->range ? r->pct : 100;
+	return 100;
+}
+
+int accuracyBonus(SavedBattleGame *save, const BattleUnit *attacker, const BattleUnit *target)
+{
+	if (!attacker || !target || attacker->getFaction() != FACTION_HOSTILE) return 0;
+	return save->getVanStop("gjvMark") == target->getId() + 1 ? 20 : 0;
+}
+
+bool steady(SavedBattleGame *save, const BattleUnit *unit)
+{
+	const Mod::VillainRule *r = rule(save, unit);
+	return r && r->trait == "STEADY";
+}
+
+bool neverDies(SavedBattleGame *save, const BattleUnit *unit)
+{
+	return rule(save, unit) != nullptr;
+}
+
+bool noReactions(SavedBattleGame *save, const BattleUnit *unit)
+{
+	static const bool test = getenv("OXCE_VILLAIN_TEST") != nullptr; // the test: Joes hold fire so every Move is seen
+	if (test && unit && unit->getFaction() == FACTION_HOSTILE) return true;
+	return save && unit && save->getVanStop(key("gjvNR", unit)) == save->getTurn() + 1;
+}
+
+bool hiddenItem(SavedBattleGame *save, const BattleItem *item)
+{
+	return save && item && save->getVanStop("gjvCharge:" + std::to_string(item->getId())) > 0;
+}
+
+bool ignoresCharge(SavedBattleGame *save, const BattleItem *item, const BattleUnit *walker)
+{
+	return walker && walker->getFaction() == FACTION_HOSTILE && hiddenItem(save, item);
+}
+
+bool prefersVehicles(SavedBattleGame *save, const BattleUnit *unit)
+{
+	const Mod::VillainRule *r = rule(save, unit);
+	return r && r->move == "REMOTE_MISSILE";
+}
+
+bool isJoeVehicle(const BattleUnit *unit)
+{
+	return unit && unit->getOriginalFaction() == FACTION_PLAYER && !unit->getGeoscapeSoldier();
+}
+
+}
+}
diff --git a/src/Battlescape/Villains.h b/src/Battlescape/Villains.h
new file mode 100644
index 0000000..c0c5e19
--- /dev/null
+++ b/src/Battlescape/Villains.h
@@ -0,0 +1,42 @@
+#pragma once
+/*
+ * G.I. Joe: the named villains' Moves and traits (ROSTER's records, roster_cobra_b1/b2.yaml; BUILD 15 Nov).
+ * Stock OpenXcom's AI can't choose to use a special ability, so each villain's Move is engine code here,
+ * called from AIModule::think. The table (which villain has which Move and trait) is the ruleset's
+ * `villains:` list, written by build/gen_villains.py. A Move is used once a mission.
+ */
+#include <string>
+
+namespace OpenXcom
+{
+
+class SavedBattleGame;
+class BattleUnit;
+class BattleItem;
+struct BattleAction;
+
+namespace Villains
+{
+	/// the AI's turn: a villain may use his Move. True if it set the action.
+	bool think(SavedBattleGame *save, BattleUnit *unit, BattleAction *action);
+	/// damage percentage for a hit (traits: marked list, vehicle hunter, close quarters)
+	int damagePct(SavedBattleGame *save, const BattleUnit *attacker, const BattleUnit *victim);
+	/// accuracy added to a shot (Major Bludd's mark: every Cobra +20 against the marked Joe)
+	int accuracyBonus(SavedBattleGame *save, const BattleUnit *attacker, const BattleUnit *target);
+	/// no morale loss from wounds (Buzzer)
+	bool steady(SavedBattleGame *save, const BattleUnit *unit);
+	/// a villain never dies: a killing hit leaves him down instead (named characters never die)
+	bool neverDies(SavedBattleGame *save, const BattleUnit *unit);
+	/// this unit draws no reaction fire (only the OXCE_VILLAIN_TEST bench uses it now)
+	bool noReactions(SavedBattleGame *save, const BattleUnit *unit);
+	/// an item the Joes never see on the floor (Firefly's charge)
+	bool hiddenItem(SavedBattleGame *save, const BattleItem *item);
+	/// a Cobra man walking past a villain's charge doesn't set it off
+	bool ignoresCharge(SavedBattleGame *save, const BattleItem *item, const BattleUnit *walker);
+	/// launcher targets: Joe vehicles first (Scrap-Iron)
+	bool prefersVehicles(SavedBattleGame *save, const BattleUnit *unit);
+	/// a Joe vehicle (a player unit with no soldier behind it)
+	bool isJoeVehicle(const BattleUnit *unit);
+}
+
+}
