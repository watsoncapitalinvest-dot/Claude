+			if ((ab->getSiteType() != rule->getRevealSiteType() && ab->getSiteType() != rule->getRevealSiteType() + "_BUILDING") || ab->isDiscovered()) continue;
+			const double d = _bases.empty() ? 0 : ab->getDistance(_bases.front());
+			if (!best || d < bestD) { best = ab; bestD = d; }
+		}
+		if (best) best->setDiscovered(true);
+	}
+	if (!rule->getMarkSiteType().empty())
+	{
+		addCobraSiteIntel(rule->getMarkSiteType());
+	}
+	for (const auto &name : rule->getGrantResearch())
+	{
+		const RuleResearch *r = mod->getResearch(name);
+		if (r && !isResearched(r, false))
