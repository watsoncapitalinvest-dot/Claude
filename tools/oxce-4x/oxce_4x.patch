+		if (!drew) boxText(hudBox(bar, 4, 11, 28, 28), "?", 8, 1, S_MUTED, "stencil");
+		boxEdge(pb, S_YELLOW, k * 0.35);
+
+		// 7 the line under the name, then four bars
+		boxText(hudBox(bar, 36, 18.5, 54, 4), hud.sub, 2.2, 0, S_MUTED);
+		hudBarRow(bar, 23.5, "TIME", hud.tu, hud.tuMax, S_YELLOW);
+		hudBarRow(bar, 27.5, "HEALTH", hud.hp, hud.hpMax, 0x6FAE4A);
+		hudBarRow(bar, 31.5, "ENERGY", hud.en, hud.enMax, 0x5B8FC9);
