+	void btnSearchClick(Action *action);
+	void btnFireClick(Action *action);
+	void btnGoClick(Action *action);
+};
+
+}
diff --git a/src/Geoscape/Shipping.cpp b/src/Geoscape/Shipping.cpp
new file mode 100644
index 0000000..c0a99a3
--- /dev/null
+++ b/src/Geoscape/Shipping.cpp
@@ -0,0 +1,540 @@
+/*
+ * G.I. Joe: civilian shipping on the world map. See Shipping.h.
+ */
+#include "Shipping.h"
+#include "Tips.h"
+#include "../Mod/RuleItem.h"
+#include "../Savegame/ItemContainer.h"
+#include <algorithm>
+#include <cmath>
+#include <sstream>
+#include "Globe.h"
+#include "../Engine/Game.h"
+#include "../Engine/Language.h"
+#include "../Engine/Logger.h"
+#include "../Engine/RNG.h"
+#include "../fmath.h"
+#include "../Mod/Mod.h"
+#include "../Mod/RuleAlienMission.h"
+#include "../Mod/RuleCountry.h"
+#include "../Mod/RuleResearch.h"
+#include "../Mod/RuleRegion.h"
+#include "../Mod/RuleCobraSite.h"
+#include "../Mod/UfoTrajectory.h"
+#include "../Mod/AlienDeployment.h"
+#include "../Savegame/SavedGame.h"
+#include "../Savegame/AlienMission.h"
+#include "../Savegame/AlienBase.h"
+#include "../Savegame/Base.h"
+#include "../Mod/RuleCraft.h"
+#include <cstdlib>
+#include <cstring>
+#include "../Savegame/CobraEconomy.h"
+#include "../Savegame/Country.h"
+#include "../Savegame/Craft.h"
+#include "../Savegame/MissionSite.h"
+#include "../Savegame/Region.h"
+#include "../Savegame/Ufo.h"
+#include "../Savegame/Waypoint.h"
+
+namespace OpenXcom
+{
+
+namespace Shipping
+{
+
+namespace
+{
+	const double DEG = M_PI / 180.0;
+
+	/// a lane point (lat, lon in degrees, north positive) to the engine's (lon, lat) in radians
+	void toEngine(std::pair<double, double> p, double &lon, double &lat)
+	{
+		double l = p.second;
+		while (l < 0) l += 360.0;
+		while (l >= 360.0) l -= 360.0;
+		lon = l * DEG;
+		lat = -p.first * DEG;
+	}
+
+	/// the point a fraction f of the way from a to b (degrees; the short way round in longitude)
+	std::pair<double, double> lerp(std::pair<double, double> a, std::pair<double, double> b, double f)
+	{
+		double dl = b.second - a.second;
+		while (dl > 180.0) dl -= 360.0;
+		while (dl < -180.0) dl += 360.0;
+		return { a.first + (b.first - a.first) * f, a.second + dl * f };
+	}
+
+	int pointCount(const Mod::ShipLane &lane) { return (int)lane.pts.size(); }
+
+	/// the lane point index for a leg end, in the ship's direction of travel
+	std::pair<double, double> point(const Mod::ShipLane &lane, int i, bool rev)
+	{
+		const int n = pointCount(lane);
+		return lane.pts[rev ? n - 1 - i : i];
+	}
+
+	void head(Ufo *ufo, const Mod::ShipLane &lane)
+	{
+		double lon, lat;
+		toEngine(point(lane, ufo->gjLeg + 1, ufo->gjRev), lon, lat);
+		Waypoint *wp = new Waypoint();
+		wp->setLongitude(lon);
+		wp->setLatitude(lat);
+		ufo->setDestination(wp);
+		ufo->setSpeed(ufo->getCraftStats().speedMax);
+	}
+
+	/// Cobra's monthly upkeep for all its sites (the "well paid" yardstick, 12h.4)
+	int upkeep(const Game *game)
+	{
+		int sum = 0;
+		for (const auto *ab : *game->getSavedGame()->getAlienBases())
+		{
+			if (ab->getSiteType().empty()) continue;
+			if (const RuleCobraSite *r = game->getMod()->getCobraSite(ab->getSiteType())) sum += r->getUpkeepFunds();
+		}
+		return sum;
+	}
+
+	AlienMission *shippingMission(Game *game, Globe *)
+	{
+		const Mod *mod = game->getMod();
+		const auto &SH = mod->getShippingRules();
+		SavedGame *save = game->getSavedGame();
+		for (auto *m : save->getAlienMissions())
+			if (m->getRules().getType() == SH.mission) return m;
+		const RuleAlienMission *rule = mod->getAlienMission(SH.mission);
+		if (!rule || mod->getRegionsList().empty()) return nullptr;
+		AlienMission *m = new AlienMission(*rule);
+		m->setRace(rule->generateRace(0));
+		m->setId(save->getId("ALIEN_MISSIONS"));
+		m->setRegion(mod->getRegionsList().front(), *mod);
+		save->getAlienMissions().push_back(m);
+		return m;
+	}
+
+	std::string countryType(const SavedGame *save, const std::string &type)
+	{
+		if (type.empty()) return "";
+		for (const auto *c : *const_cast<SavedGame*>(save)->getCountries())
+			if (c->getRules()->getType() == type) return type;
+		return "";
+	}
+
+	/// a new merchant on a random lane (weighted by the lane's ships); anywhere along it when the sea is
+	/// being filled for the first time, at its home port otherwise
+	void spawn(Game *game, AlienMission *mission, bool anywhere)
+	{
+		const Mod *mod = game->getMod();
+		const auto &SH = mod->getShippingRules();
+		SavedGame *save = game->getSavedGame();
+		const RuleUfo *rule = mod->getUfo(SH.ufo);
+		const UfoTrajectory *traj = mod->getUfoTrajectory(SH.trajectory);
+		if (!rule || !traj) return;
+		int total = 0;
+		for (const auto &l : SH.lanes) total += std::max(0, l.ships);
+		if (total <= 0) return;
+		int pick = RNG::generate(0, total - 1), li = 0;
+		for (; li < (int)SH.lanes.size(); ++li)
+		{
+			pick -= std::max(0, SH.lanes[li].ships);
+			if (pick < 0) break;
+		}
+		if (li >= (int)SH.lanes.size()) return;
+		const auto &lane = SH.lanes[li];
+		Ufo *ufo = new Ufo(rule, save->getId("STR_UFO_UNIQUE"));
+		ufo->setMissionInfo(mission, traj);
+		ufo->setAltitude("STR_VERY_LOW");
+		ufo->gjLane = li;
+		ufo->gjRev = RNG::percent(50);
+		ufo->gjLeg = 0;
+		std::pair<double, double> at = point(lane, 0, ufo->gjRev);
+		if (anywhere)
+		{
+			ufo->gjLeg = RNG::generate(0, pointCount(lane) - 2);
+			at = lerp(point(lane, ufo->gjLeg, ufo->gjRev), point(lane, ufo->gjLeg + 1, ufo->gjRev), RNG::generate(0.0, 1.0));
+		}
+		double lon, lat;
+		toEngine(at, lon, lat);
+		ufo->setLongitude(lon);
+		ufo->setLatitude(lat);
+		ufo->gjFlag = countryType(save, RNG::percent(50) ? lane.fromFlag : lane.toFlag);
+		if (!SH.names.empty()) ufo->gjName = "MV " + SH.names[RNG::generate(0, (int)SH.names.size() - 1)];
+		ufo->setId(save->getId("STR_UFO"));
+
+		// Cobra's cargo (12g, 12h): up to the lane's share when Cobra is well paid, none when it is broke.
+		// A voyage is paid for when it sails, and needs its cargo stockpiled where it sails from.
+		CobraEconomy &eco = save->getCobraEconomy();
+		const int funds = eco.getTotalFunds();
+		const int wellPaid = std::max(1, upkeep(game) * std::max(1, mod->getCobraWellPaidUpkeep()));
+		const double share = lane.cobraShare * std::min(1.0, std::max(0, funds) / (double)wellPaid);
+		if (share > 0 && RNG::generate(0.0, 1.0) < share)
+		{
+			const Region *reg = save->locateRegionQuiet(lon, lat);
+			const std::string region = reg ? reg->getRules()->getType() : "";
+			int w[3] = {0, 0, 0}, wsum = 0;
+			for (int i = 0; i < 3 && i < (int)SH.tierWeights.size(); ++i) { w[i] = SH.tierWeights[i]; wsum += w[i]; }
+			int tier = 0;
+			if (wsum > 0)
+			{
+				int r = RNG::generate(0, wsum - 1);
+				while (tier < 2 && r >= w[tier]) { r -= w[tier]; ++tier; }
+			}
+			const int ownLine = RNG::percent(SH.ownLineShare) ? 1 : 2;
+			const int needMat[3] = { SH.materielLow, SH.materielMedium, SH.materielHigh };
+			const int cost = (ownLine == 1 ? SH.costOwnLine : SH.costContainers) + (tier == 1 ? SH.costMedium : tier == 2 ? SH.costHigh : 0);
+			// rule 2: keep a month of upkeep in hand; rule 3: no cargo, no voyage (money cargo, Medium, needs the funds)
+			const bool matOk = tier == 1 || region.empty() || eco.getMateriel(region) >= needMat[tier];
+			if (funds - cost >= upkeep(game) && matOk)
+			{
+				eco.spendFunds(region, cost);
+				if (tier != 1 && !region.empty()) eco.addMateriel(region, -needMat[tier]);
+				ufo->gjCobra = ownLine;
+				// Follow the Money done: the front company's ships are known the day they sail (12a)
+				const RuleResearch *ftm = mod->getResearch(SH.followMoneyResearch);
+				if (ownLine == 1 && ftm && save->isResearched(ftm, false)) ufo->gjIntel = SH.confirmedAt;
+				ufo->gjCargo = tier;
+				ufo->gjRegion = region;
+				Log(LOG_INFO) << "[shipping] Cobra " << (ownLine == 1 ? "own-line freighter" : "containers") << " tier " << tier
+					<< " on " << lane.id << " (paid " << cost << ", funds " << funds << ")";
+			}
+		}
+		// a cartel boat among the honest traffic on the Gulf and Caribbean lanes, until the stash house falls
+		if (!ufo->gjCobra && SH.cartelShare > 0 && std::find(SH.cartelLanes.begin(), SH.cartelLanes.end(), lane.id) != SH.cartelLanes.end())
+		{
+			const RuleResearch *until = mod->getResearch(SH.cartelUntil);
+			if ((!until || !save->isResearched(until, false)) && RNG::generate(0.0, 1.0) < SH.cartelShare)
+			{
+				ufo->gjCobra = 3;
+				ufo->gjFlag = "";
+				ufo->gjName = game->getLanguage()->getString("STR_CARTEL_BOAT");
+				Log(LOG_INFO) << "[shipping] a cartel boat on " << lane.id;
+			}
+		}
+		ufo->setDetected(true);   // shipping is public: every ship shows, nothing pops up
+		head(ufo, lane);
+		save->getUfos()->push_back(ufo);
+	}
+}
+
+/// rig test (OXCE_SHIP_TEST=<0 innocent|1 own line|2 containers>[,cargo]): the first merchant is set
+/// a degree from the first base, made that kind, and the first armed craft with soldiers is sent at it
+static void testHook(Game *game)
+{
+	static bool done = false;
+	const char *env = getenv("OXCE_SHIP_TEST");
+	if (!env || done) return;
+	SavedGame *save = game->getSavedGame();
+	if (save->getBases()->empty()) return;
+	Base *b = save->getBases()->front();
+	Craft *craft = nullptr;
+	for (auto *c : *b->getCrafts()) if (c->getStatus() == "STR_READY" && c->getNumTotalSoldiers() > 0) { craft = c; break; }
+	if (!craft) for (auto *c : *b->getCrafts()) if (c->getStatus() == "STR_READY") { craft = c; break; }
+	for (auto *u : *save->getUfos())
+	{
+		if (!isMerchant(u)) continue;
+		done = true;
+		u->gjCobra = atoi(env) == 3 ? 0 : atoi(env);
+		if (atoi(env) == 3) { u->gjHijack = game->getMod()->getShippingRules().hijackHours; u->setSpeed(0); }
+		u->gjCargo = strchr(env, ',') ? atoi(strchr(env, ',') + 1) : 1;
+		if (const char *c2 = strchr(env, ',')) if (const char *c3 = strchr(c2 + 1, ',')) u->gjIntel = atoi(c3 + 1);
+		u->setLongitude(b->getLongitude() + 0.017);
+		u->setLatitude(b->getLatitude() + 0.017);
+		if (craft && !getenv("OXCE_SHIP_TEST_NOCRAFT")) { craft->setDestination(u); craft->setStatus("STR_OUT"); }
+		Log(LOG_INFO) << "[shipping] test: " << u->getName(game->getLanguage()) << " kind " << u->gjCobra << " cargo " << u->gjCargo
+			<< ", craft " << (craft ? craft->getRules()->getType() : std::string("none"));
+		break;
+	}
+}
+
+bool isMerchant(const Ufo *ufo)
+{
+	return ufo && ufo->gjLane >= 0;
+}
+
+std::string think(Game *game, Globe *globe)
+{
+	const auto &SH = game->getMod()->getShippingRules();
+	if (!SH.on || SH.lanes.empty() || game->getSavedGame()->getMonthsPassed() < 0) return "";
+	SavedGame *save = game->getSavedGame();
+	Language *lang = game->getLanguage();
+	std::string news;
+	int n = 0;
+	Ufo *held = nullptr;
+	for (auto *u : *save->getUfos())
+	{
+		if (!isMerchant(u) || u->getStatus() == Ufo::DESTROYED) continue;
+		++n;
+		if (u->gjHijack > 0) held = u;
+	}
+
+	// a rescue that was never flown (its site timed out) leaves nothing to remember
+	if (!held && !save->getHijackFlag().empty())
+	{
+		bool site = false;
+		for (auto *ms : *save->getMissionSites()) if (ms->getDeployment() && ms->getDeployment()->getType() == SH.boardHijack) site = true;
+		if (!site && !save->getSavedBattle()) save->setHijackFlag("");
+	}
+	// hijacking (12c): a held ship waits out its hours, then Cobra has its way - the cargo, or a ransom
+	// the flag country pays (and blames the Joes for)
+	if (held && --held->gjHijack <= 0)
+	{
+		CobraEconomy &eco = save->getCobraEconomy();
+		const Region *reg = save->locateRegionQuiet(held->getLongitude(), held->getLatitude());
+		const std::string region = reg ? reg->getRules()->getType() : "";
+		const std::string name = held->getName(lang);
+		if (flag(save, held) && RNG::percent(50))
+		{
+			goodwill(save, held, -SH.ransomGoodwill, 0);
+			if (!region.empty()) eco.addFunds(region, SH.ransomFunds);
+			news = lang->getString("STR_SHIP_HIJACK_RANSOM").arg(name).arg(lang->getString(held->gjFlag)).arg(SH.ransomGoodwill);
+		}
+		else
+		{
+			if (!region.empty()) { eco.addFunds(region, SH.seizeFunds); eco.addMateriel(region, SH.seizeMateriel); }
+			news = lang->getString("STR_SHIP_HIJACK_SEIZED").arg(name);
+		}
+		Log(LOG_INFO) << "[shipping] hijack of " << name << " ended: " << news;
+		held->gjHijack = 0;
+		held->setSpeed(held->getCraftStats().speedMax);
+		save->setHijackFlag("");
+		held = nullptr;
+	}
+	// a new one: one at a time, about one every hijackEveryDays, paid for by Cobra (12g, 12h)
+	// 18 Nov: no hijacking before Cobra Commander's broadcast - the MAYDAY says "Cobra has her" (BUILD-1's 60-day run had one on day 21)
+	else if (!held && save->getCobraNet().count("broadcastDone") && save->getHijackFlag().empty() && SH.hijackEveryDays > 0 && RNG::generate(0, SH.hijackEveryDays * 24 - 1) == 0
+		&& save->getCobraEconomy().getTotalFunds() - SH.hijackCost >= upkeep(game))
+	{
+		std::vector<Ufo*> pick, flagged;
+		for (auto *u : *save->getUfos())
+		{
+			if (!isMerchant(u) || u->getStatus() != Ufo::FLYING || u->gjCobra) continue;
+			pick.push_back(u);
+			if (flag(save, u)) flagged.push_back(u);
+		}
+		auto &from = flagged.empty() ? pick : flagged;
+		if (!from.empty())
+		{
+			Ufo *u = from[RNG::generate(0, (int)from.size() - 1)];
+			u->gjHijack = SH.hijackHours;
+			u->setSpeed(0);
+			save->getCobraEconomy().spendFunds("", SH.hijackCost);
+			news = lang->getString("STR_SHIP_HIJACK_ALERT").arg(u->getName(lang)).arg(SH.hijackHours);
+			Log(LOG_INFO) << "[shipping] hijack: " << u->getName(lang) << " (" << u->gjFlag << ")";
+		}
+	}
+
+	if (n < SH.total)
+	{
+		if (AlienMission *m = shippingMission(game, globe))
+		{
+			const bool fill = n < SH.total / 2;  // a new game (or an old save): fill the sea at once
+			const int add = fill ? SH.total - n : 1 + (SH.total - n) / 8;
+			for (int i = 0; i < add; ++i) spawn(game, m, fill);
+		}
+	}
+	testHook(game);
+	return news;
+}
+
+void daily(Game *game)
+{
+	// the analysts keep working every open ship file (12f.4)
+	const auto &SH = game->getMod()->getShippingRules();
+	SavedGame *save = game->getSavedGame();
+	for (auto *u : *save->getUfos())
+	{
+		if (!isMerchant(u) || u->gjIntel <= 0 || u->gjIntel >= SH.confirmedAt || u->getStatus() == Ufo::DESTROYED) continue;
+		const int before = u->gjIntel;
+		u->gjIntel = std::min(SH.confirmedAt, u->gjIntel + SH.intelPerDay);
+		if (u->gjIntel >= SH.confirmedAt) save->addLeadNews("!STR_SHIP_INTEL_CONFIRMED|" + u->gjName);
+		else if (u->gjIntel >= SH.suspectedAt && before < SH.suspectedAt) save->addLeadNews("!STR_SHIP_INTEL_SUSPECTED|" + u->gjName);
+	}
+}
+
+bool isHijacked(const Ufo *ufo)
+{
+	return isMerchant(ufo) && ufo->gjHijack > 0;
+}
+
+bool reachedWaypoint(Game *game, Ufo *ufo)
+{
+	if (!isMerchant(ufo)) return false;
+	const auto &SH = game->getMod()->getShippingRules();
+	if (ufo->gjLane >= (int)SH.lanes.size()) { ufo->setDetected(false); ufo->setStatus(Ufo::DESTROYED); return true; }
+	const auto &lane = SH.lanes[ufo->gjLane];
+	ufo->gjLeg++;
+	if (ufo->gjLeg + 1 < pointCount(lane))
+	{
+		head(ufo, lane);
+		return true;
+	}
+	// into port: a Cobra cargo is delivered (12g)
+	if (ufo->gjCobra)
+	{
+		CobraEconomy &eco = game->getSavedGame()->getCobraEconomy();
+		// it lands where the ship docks; the region that paid for it if the port is in none
+		const Region *there = game->getSavedGame()->locateRegionQuiet(ufo->getLongitude(), ufo->getLatitude());
+		if (there) ufo->gjRegion = there->getRules()->getType();
+		const int t = std::min(2, std::max(0, ufo->gjCargo));
+		const int f = t < (int)SH.deliverFunds.size() ? SH.deliverFunds[t] : 0;
+		if (f > 0 && !ufo->gjRegion.empty()) eco.addFunds(ufo->gjRegion, f);
+		if (t == 2 && !ufo->gjRegion.empty()) eco.addMateriel(ufo->gjRegion, SH.deliverMaterielHigh);
+		Log(LOG_INFO) << "[shipping] Cobra cargo delivered on " << lane.id << " (tier " << t << ")";
+	}
+	ufo->setDetected(false);
+	ufo->setStatus(Ufo::DESTROYED);
+	return true;
+}
+
+Country *flag(SavedGame *save, const Ufo *ufo)
+{
+	if (!ufo || ufo->gjFlag.empty()) return nullptr;
+	for (auto *c : *save->getCountries())
+		if (c->getRules()->getType() == ufo->gjFlag) return c;
+	return nullptr;
+}
+
+void goodwill(SavedGame *save, const Ufo *ufo, int delta, int exposure)
+{
+	if (Country *c = flag(save, ufo)) c->setGoodwill(c->getGoodwill() + delta);
+	if (exposure) save->setExposure(save->getExposure() + exposure);
+}
+
+std::string describe(Game *game, const Ufo *ufo)
+{
+	const auto &SH = game->getMod()->getShippingRules();
+	Language *lang = game->getLanguage();
+	std::ostringstream s;
+	if (ufo->gjLane >= 0 && ufo->gjLane < (int)SH.lanes.size())
+	{
+		const auto &lane = SH.lanes[ufo->gjLane];
+		s << lang->getString("STR_SHIP_BOUND").arg(ufo->gjRev ? lane.fromName : lane.toName).arg(ufo->gjRev ? lane.toName : lane.fromName) << "\n";
+	}
+	s << lang->getString("STR_SHIP_FLAG").arg(ufo->gjFlag.empty() ? lang->getString("STR_SHIP_FLAG_NONE") : lang->getString(ufo->gjFlag)) << "\n";
+	if (ufo->gjHijack > 0) s << lang->getString("STR_SHIP_HIJACKED_HOURS").arg(ufo->gjHijack);
+	else if (ufo->gjIntel >= SH.confirmedAt) s << lang->getString("STR_SHIP_INTEL_IS_CONFIRMED");
+	else if (ufo->gjIntel >= SH.suspectedAt) s << lang->getString("STR_SHIP_INTEL_IS_SUSPECTED");
+	else s << lang->getString("STR_SHIP_INTEL_UNKNOWN");
+	return s.str();
+}
+
+bool canBoard(const Craft *craft)
+{
+	// a team to put aboard, and a craft that can put them there: a boat or helicopter that comes alongside or
+	// lands on her (sea design 12f.3). A Devilfish's one seat is its pilot.
+	return craft && craft->getNumTotalSoldiers() > 0 && craft->getRules()->getAllowLanding();
+}
+
+std::string search(Game *game, Ufo *ufo, Craft *craft, bool *boarding)
+{
+	const Mod *mod = game->getMod();
+	const auto &SH = mod->getShippingRules();
+	SavedGame *save = game->getSavedGame();
+	Language *lang = game->getLanguage();
+	*boarding = false;
+	const std::string name = ufo->getName(lang);
+	if (ufo->gjHijack > 0)
+	{
+		// hostage rescue on deck (12c): the hijackers hold the crew; the flag country is remembered for the debrief
+		const RuleAlienMission *mrule = mod->getAlienMission(SH.boardMission);
+		AlienDeployment *dep = mod->getDeployment(SH.boardHijack);
+		if (mrule && dep)
+		{
+			MissionSite *ms = new MissionSite(mrule, dep, nullptr);
+			ms->setLongitude(ufo->getLongitude());
+			ms->setLatitude(ufo->getLatitude());
+			ms->setId(save->getId(dep->getMarkerName()));
+			ms->setSecondsRemaining(std::max(1, ufo->gjHijack) * 3600);
+			ms->setAlienRace(mrule->generateRace(0));
+			ms->setDetected(true);
+			save->getMissionSites()->push_back(ms);
+			if (craft) craft->setDestination(ms);
+			save->setHijackFlag(ufo->gjFlag.empty() ? "-" : ufo->gjFlag);
+			*boarding = true;
+			ufo->gjHijack = 0;
+			ufo->setDetected(false);
+			ufo->setStatus(Ufo::DESTROYED);
+			return lang->getString("STR_SHIP_HIJACK_BOARD").arg(name);
+		}
+	}
+	if (!ufo->gjCobra)
+	{
+		// innocent: it stops, the hold is searched, nothing is found, and its flag country minds (12g)
+		goodwill(save, ufo, -SH.searchInnocent, 0);
+		return lang->getString("STR_SHIP_SEARCH_NOTHING").arg(name).arg(SH.searchInnocent);
+	}
+	if (ufo->gjCobra == 3)
+	{
+		Tips::geo(game, "CARTEL_BOAT");
+		// a cartel boat: contraband (sold, or the guns kept), a bag of cash, or the crew goes for the guns under the nets
+		Base *home = craft ? craft->getBase() : (save->getBases()->empty() ? nullptr : save->getBases()->front());
+		const int roll = RNG::generate(0, 99);
+		if (roll < SH.cartelContrabandPct)
+		{
+			if (home)
+			{
+				if (const RuleItem *c = mod->getItem(SH.cartelContraband)) home->getStorageItems()->addItem(c, 1);
+				if (RNG::percent(50)) if (const RuleItem *g = mod->getItem(SH.cartelGun)) home->getStorageItems()->addItem(g, 1);
+			}
+			ufo->gjCobra = 0; ufo->setDetected(false); ufo->setStatus(Ufo::DESTROYED);
+			return lang->getString("STR_CARTEL_BOAT_FOUND_CONTRABAND");
+		}
+		if (roll < SH.cartelContrabandPct + SH.cartelCashPct)
+		{
+			save->setFunds(save->getFunds() + SH.cartelCash);
+			ufo->gjCobra = 0; ufo->setDetected(false); ufo->setStatus(Ufo::DESTROYED);
+			return lang->getString("STR_CARTEL_BOAT_FOUND_CASH");
+		}
+		const RuleAlienMission *mrule = mod->getAlienMission(SH.boardMission);
+		AlienDeployment *dep = mod->getDeployment(SH.boardCartel);
+		if (mrule && dep)
+		{
+			MissionSite *ms = new MissionSite(mrule, dep, nullptr);
+			ms->setLongitude(ufo->getLongitude());
+			ms->setLatitude(ufo->getLatitude());
+			ms->setId(save->getId(dep->getMarkerName()));
+			ms->setSecondsRemaining(12 * 3600);
+			ms->setAlienRace("STR_CARTEL");
+			ms->setDetected(true);
+			save->getMissionSites()->push_back(ms);
+			if (craft) craft->setDestination(ms);
+			*boarding = true;
+			ufo->gjCobra = 0; ufo->setDetected(false); ufo->setStatus(Ufo::DESTROYED);
+			return lang->getString("STR_CARTEL_BOAT_FIGHT");
+		}
+		return lang->getString("STR_CARTEL_BOAT_FOUND_CONTRABAND");
+	}
+	if (ufo->gjCobra == 2 && ufo->gjCargo == 0)
+	{
+		// cheap cargo travels alone: the containers are opened and seized with nobody to fight (12b)
+		ufo->gjCobra = 0;
+		return lang->getString("STR_SHIP_SEARCH_SEIZED").arg(name);
+	}
+	// Cobra's own line bluffs; containers with minders stop (the crew doesn't know): either way the
+	// boarding is played on the deck (7.3)
+	const std::string depType = ufo->gjCobra == 1 ? SH.boardOwnLine : SH.boardContainers;
+	const RuleAlienMission *mrule = mod->getAlienMission(SH.boardMission);
+	AlienDeployment *dep = mod->getDeployment(depType + (ufo->gjCargo == 2 ? "_HIGH" : ""));
+	if (!dep) dep = mod->getDeployment(depType);
+	if (!mrule || !dep) return lang->getString("STR_SHIP_SEARCH_NOTHING").arg(name).arg(0);
+	MissionSite *ms = new MissionSite(mrule, dep, nullptr);
+	ms->setLongitude(ufo->getLongitude());
+	ms->setLatitude(ufo->getLatitude());
+	ms->setId(save->getId(dep->getMarkerName()));
+	ms->setSecondsRemaining(12 * 3600);
+	ms->setAlienRace(mrule->generateRace(0));
+	ms->setDetected(true);
+	save->getMissionSites()->push_back(ms);
+	if (craft) craft->setDestination(ms);
+	*boarding = true;
+	ufo->setDetected(false);
+	ufo->setStatus(Ufo::DESTROYED);
+	return lang->getString(ufo->gjCobra == 1 ? "STR_SHIP_SEARCH_BLUFF" : "STR_SHIP_SEARCH_MINDERS").arg(name);
+}
+
+}
+
+}
diff --git a/src/Geoscape/Shipping.h b/src/Geoscape/Shipping.h
new file mode 100644
index 0000000..78da07f
--- /dev/null
+++ b/src/Geoscape/Shipping.h
@@ -0,0 +1,46 @@
+#pragma once
+/*
+ * G.I. Joe: civilian shipping on the world map (SEA_BATTLES_DESIGN_v1 sections 7, 9, 12).
+ * Merchant ships sail STORY's lanes all the time, from Day 1. Up to a lane's cobraShare of them carry
+ * Cobra's cargo, scaled by Cobra's money (12h): its own line, or hidden containers on an honest ship.
+ * A Joe craft that reaches one may stop and search it, open fire, or let it go.
+ */
+#include <string>
+
+namespace OpenXcom
+{
+
+class Game;
+class Globe;
+class Ufo;
+class Craft;
+class Country;
+class SavedGame;
+class Language;
+
+namespace Shipping
+{
+	/// a merchant ship on a lane
+	bool isMerchant(const Ufo *ufo);
+	/// every game hour: keep the lanes full, run hijackings; returns news for a popup (may be empty)
+	std::string think(Game *game, Globe *globe);
+	/// every game day: the analysts work the open ship files
+	void daily(Game *game);
+	/// held by hijackers
+	bool isHijacked(const Ufo *ufo);
+	/// a merchant reached a lane point: on to the next, or into port. True if it was a merchant.
+	bool reachedWaypoint(Game *game, Ufo *ufo);
+	/// the flag country of a merchant (may be null)
+	Country *flag(SavedGame *save, const Ufo *ufo);
+	/// goodwill with a merchant's flag country moves by delta (and the exposure meter, if any)
+	void goodwill(SavedGame *save, const Ufo *ufo, int delta, int exposure);
+	/// what the stop screen says about the ship
+	std::string describe(Game *game, const Ufo *ufo);
+	/// does a craft carry anyone who could board
+	bool canBoard(const Craft *craft);
+	/// the ship stops and is searched: puts a boarding mission on the spot for a Cobra ship and returns
+	/// the report; an innocent ship is searched on the spot, costs goodwill and sails on
+	std::string search(Game *game, Ufo *ufo, Craft *craft, bool *boarding);
+}
+
+}
diff --git a/src/Geoscape/Tips.cpp b/src/Geoscape/Tips.cpp
new file mode 100644
index 0000000..849ab0c
--- /dev/null
+++ b/src/Geoscape/Tips.cpp
@@ -0,0 +1,51 @@
+#include "Tips.h"
+#include "../Engine/Game.h"
+#include "../Engine/Options.h"
+#include "../Engine/Language.h"
+#include "../Mod/Mod.h"
+#include "../Mod/RuleInterface.h"
+#include "../Savegame/SavedGame.h"
+#include "../Savegame/SavedBattleGame.h"
+#include "../Menu/ErrorMessageState.h"
+#include "../Engine/Logger.h"
+#include "../Engine/Palette.h"
+
+namespace OpenXcom
+{
+namespace Tips
+{
+namespace
+{
+	std::vector<std::string> pending;
+	bool want(SavedGame *g, const std::string &name)
+	{
+		if (!g || !Options::gjTips) return false;
+		auto &net = g->getCobraNet();
+		const std::string k = "tip:" + name;
+		if (net.count(k)) return false;
+		net[k] = 1;
+		Log(LOG_INFO) << "[tip] " << name;
+		return true;
+	}
+}
+
+void battle(SavedBattleGame *save, const std::string &name)
+{
+	if (save && want(save->getGeoscapeSave(), name)) pending.push_back("STR_TIP_" + name);
+}
+
+std::vector<std::string> takeBattle() { std::vector<std::string> v; v.swap(pending); return v; }
+
+void geo(Game *game, const std::string &name)
+{
+	if (!game || !want(game->getSavedGame(), name)) return;
+	const std::string k = "STR_TIP_" + name;
+	const std::string text = game->getLanguage()->getString(k);
+	if (text == k) return;   // a tip STORY has not written yet never fires
+	RuleInterface *ui = game->getMod()->getInterface("geoscape");
+	game->pushState(new ErrorMessageState(text, game->getMod()->getPalette("PAL_GEOSCAPE")->getColors(),
+		ui->getElement("errorMessage")->color, "BACK13.SCR", ui->getElement("errorPalette")->color));
+}
+
+}
+}
