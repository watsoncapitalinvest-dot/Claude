+void resolvePending();
+
+void aliasImage(const Surface *dst, const Surface *src)
+{
+	if (!enabled() || !dst || !src) return;
+	// a sprite-set frame's twin stays pending until first draw; resolve it now,
+	// or a screen that only ever copies the frame never finds it (Job 3, 12 Nov)
+	resolvePending();
+	auto it = bgImages.find(src);
+	// no twin: forget any earlier alias, or a reused surface keeps the old picture
+	if (it == bgImages.end() || !it->second.ok) { bgImages.erase(dst); return; }
+	bgImages[dst] = it->second;
+}
+
+void registerSetFrame(SurfaceSet *set, int frame, const std::string &file)
+{
+	if (!enabled() || !set) return;
+	const auto dot = file.find_last_of('.');
+	if (dot == std::string::npos || !FileMap::fileExists(file.substr(0, dot) + "_hi.png")) return;
+	pending.push_back({set, frame, file});
+}
+
+void spriteIn(const Surface *dst, const Surface *src, int x, int y)
+{
+	if (!enabled() || !dst || !src) return;
+	auto &v = insets[dst];
+	for (auto &e : v)
+		if (e.x == x && e.y == y) { e.src = src; return; }   // a redraw of the same place replaces it
+	v.push_back({src, x, y});
+}
+
+void resolvePending()
+{
+	if (pending.empty()) return;
+	std::vector<Pending> todo;
+	todo.swap(pending);
+	for (const auto &p : todo)
+	{
+		const Surface *f = p.set->getFrame(p.frame);
+		if (!f) continue;
+		const auto dot = p.file.find_last_of('.');
+		Img im = loadPng(p.file.substr(0, dot) + "_hi.png");
+		if (!im.ok) continue;
+		Log(LOG_INFO) << "Sharp sprite: " << p.file << " (" << im.w << "x" << im.h << ")";
+		bgImages[f] = std::move(im);
+	}
+}
+
+void spriteFit(const Surface *frame, int x, int y, int w, int h, int boxX, int boxY, int boxW, int boxH, double inset)
+{
+	resolvePending();
+	if (!base || !frame || w <= 0 || h <= 0 || boxW <= 0 || boxH <= 0) return;
+	auto it = bgImages.find(frame);
+	const Img *imp = (it != bgImages.end() && it->second.ok) ? &it->second : nullptr;
+	// AN ITEM WITH NO SHARP PICTURE YET is fitted all the same, from its 8-bit
+	// frame: enlarged by whole pixels (so it stays crisp pixel art, not a blur)
+	// and cached per frame and palette.
+	if (!imp) imp = flatTwin(frame);
+	if (!imp) return;
+	R r{ x, y, x + w, y + h };
+	if (!clipBase(r)) return;
+	// hide the 8-bit icon: every pixel the frame itself wrote shows the overlay,
+	// which holds the page underneath until the twin goes on top of it
+	SDL_Surface *fs = const_cast<Surface*>(frame)->getSurface();
+	for (int by = r.y0; by < r.y1; ++by)
+	{
+		const Uint8 *p = row8(by);
+		for (int bx = r.x0; bx < r.x1; ++bx)
+		{
+			const int fx = bx - x, fy = by - y;
+			if (!fs || fx >= fs->w || fy >= fs->h || !((const Uint8*)fs->pixels)[fy * fs->pitch + fx]) continue;
+			tag[by * bw + bx] = p[bx]; valid[by * bw + bx] = 1;
+		}
+	}
+	any = true;
+	const double s = std::min((boxW - 2 * inset) / boxW, (boxH - 2 * inset) / boxH);
+	const double cx = boxX + boxW / 2.0, cy = boxY + boxH / 2.0;
+	const Img &im = *imp;
+	stretch(im, 0, 0, im.w, im.h,
+		(int)DX(cx + (x - cx) * s), (int)DY(cy + (y - cy) * s), (int)DX(cx + (x + w - cx) * s), (int)DY(cy + (y + h - cy) * s));
+}
+
+void sprite(const Surface *frame, int x, int y, int w, int h)
+{
+	resolvePending();
+	if (!base || !frame || w <= 0 || h <= 0) return;
+	auto it = bgImages.find(frame);
+	if (it == bgImages.end() || !it->second.ok) return;
+	const Img &im = it->second;
+	R r{x, y, x + w, y + h};
+	if (!clipBase(r)) return;
+	const SDL_Color *pal = base->format->palette ? base->format->palette->colors : nullptr;
+	bool took = false;
+	for (int by = r.y0; by < r.y1; ++by)
+	{
+		const Uint8 *p = row8(by);
+		for (int bx = r.x0; bx < r.x1; ++bx)
+		{
+			// this base pixel's block on screen, and the slice of the sharp twin that belongs to it
+			const int X0 = xs[bx], X1 = xs[bx + 1], Y0 = ys[by], Y1 = ys[by + 1];
+			const int u0 = (bx - x) * im.w / w, u1 = std::max(u0 + 1, (bx - x + 1) * im.w / w);
+			const int v0 = (by - y) * im.h / h, v1 = std::max(v0 + 1, (by - y + 1) * im.h / h);
+			// The 8-bit icon's outline is one base pixel wide and steps badly. Where the sharp twin
+			// has something to say just outside it, take that pixel too, so the edge is the twin's.
+			if (!p[bx])
+			{
+				bool edge = false;
+				for (int v = v0; v < v1 && !edge; ++v)
+					for (int u = u0; u < u1; ++u)
+						if ((im.px[(size_t)v * im.w + u] >> 24) > 24) { edge = true; break; }
+				if (!edge) continue;
+			}
+			if (!valid[by * bw + bx] && pal)            // nothing sharp underneath yet: start from the flat colour
+			{
+				const SDL_Color &c = pal[p[bx]];
+				const Uint32 flat = rgb(c.r, c.g, c.b);
+				for (int Y = std::max(0, Y0); Y < std::min(sh, Y1); ++Y)
+				{
+					Uint32 *o = over.data() + (size_t)Y * sw;
+					for (int X = std::max(0, X0); X < std::min(sw, X1); ++X) o[X] = flat;
+				}
+			}
+			for (int Y = std::max(0, Y0); Y < std::min(sh, Y1); ++Y)
+			{
+				const int v = std::min(v1 - 1, v0 + (Y1 > Y0 ? (Y - Y0) * (v1 - v0) / (Y1 - Y0) : 0));
+				Uint32 *o = over.data() + (size_t)Y * sw;
+				for (int X = std::max(0, X0); X < std::min(sw, X1); ++X)
+				{
+					const int u = std::min(u1 - 1, u0 + (X1 > X0 ? (X - X0) * (u1 - u0) / (X1 - X0) : 0));
+					const Uint32 s = im.px[(size_t)v * im.w + u];
+					const Uint32 a = s >> 24;
+					if (!a) continue;                   // transparent in the sharp art: keep what is there
+					if (a == 255) { o[X] = s & 0x00FFFFFFu; continue; }
+					const Uint32 d = o[X];
+					const Uint32 nr = (((s >> 16) & 0xFF) * a + ((d >> 16) & 0xFF) * (255 - a)) / 255;
+					const Uint32 ng = (((s >> 8) & 0xFF) * a + ((d >> 8) & 0xFF) * (255 - a)) / 255;
+					const Uint32 nb = ((s & 0xFF) * a + (d & 0xFF) * (255 - a)) / 255;
+					o[X] = rgb((int)nr, (int)ng, (int)nb);
+				}
+			}
+			tag[by * bw + bx] = p[bx]; valid[by * bw + bx] = 1; took = true;
+		}
+	}
+	if (took) any = true;
+}
+
+void beginFrame(SDL_Surface *base8, int screenW, int screenH, int left, int top, int right, int bottom)
+{
+	base = nullptr; any = false; curOn = false; vHave = false; lastActive = false;
+	if (!enabled() || !base8 || base8->format->BitsPerPixel != 8) return;
+	base = base8;
+	if (bw != base8->w || bh != base8->h || sw != screenW || sh != screenH || xs.empty() || xs[0] != left || ys[0] != top)
+	{
+		bw = base8->w; bh = base8->h; sw = screenW; sh = screenH;
+		xs.resize(bw + 1); ys.resize(bh + 1);
+		for (int i = 0; i <= bw; ++i) xs[i] = left + (int)((double)i * (sw - left - right) / bw + 0.5);
+		for (int i = 0; i <= bh; ++i) ys[i] = top + (int)((double)i * (sh - top - bottom) / bh + 0.5);
+		over.assign((size_t)sw * sh, 0); tag.assign((size_t)bw * bh, 0); valid.assign((size_t)bw * bh, 0);
+		bgCache.clear();
+	}
+	else std::fill(valid.begin(), valid.end(), 0);
+	lastActive = true;
+}
+
+void before(Surface *w)
+{
+	if (!base || !any) return;
+	// LISTS TOO. after() has had a TextList branch all along - craft, soldiers,
+	// research, stores - but it only runs on the pixels captured HERE, and this
+	// accepted plain Text alone. Every list therefore returned early with nothing
+	// captured and drew in the flat 8-bit font: John saw LAUNCH INTERCEPTION with
+	// a sharp title and sharp column headers over blocky green craft rows.
+	Surface *t = dynamic_cast<Text*>(w);
+	if (!t) t = dynamic_cast<TextList*>(w);
+	if (!t) t = dynamic_cast<TextEdit*>(w);
+	if (!t || !shown(t)) return;
+	R r = rectOf(t);
+	if (!clipBase(r)) { scratch.clear(); return; }
+	scratch.assign((size_t)(r.x1 - r.x0) * (r.y1 - r.y0), 0);
+	for (int y = r.y0; y < r.y1; ++y)
+	{
+		const Uint8 *p = row8(y);
+		for (int x = r.x0; x < r.x1; ++x)
+			scratch[(size_t)(y - r.y0) * (r.x1 - r.x0) + (x - r.x0)] = valid[y * bw + x] && tag[y * bw + x] == p[x];
+	}
+}
+
+void after(Surface *w)
+{
+	if (!base || !shown(w)) return;
+	// A SCREEN'S OWN PANEL (the research tree): it paints itself.
+	{
+		auto pn = panels.find(w);
+		if (pn != panels.end())
+		{
+			R r = rectOf(w);
+			if (clipBase(r))
+			{
+				clipX0 = xs[r.x0]; clipY0 = ys[r.y0]; clipX1 = xs[r.x1]; clipY1 = ys[r.y1];
+				pn->second(DX(w->getX()), DY(w->getY()), SK());
+				claim(r);
+			}
+			return;
+		}
+	}
+	// NATIVE SCREEN PIECES first: they are drawn, not looked up.
+	if (hud.on && (w == hudBar || w == hudMission))
+	{
+		R r = rectOf(w);
+		if (!clipBase(r)) return;
+		if (w == hudBar) paintHud(w); else paintMission(w);
+		claim(r);
+		return;
+	}
+	{
+		auto nb = nativeBgs.find(w);
+		if (nb != nativeBgs.end())
+		{
+			R r = rectOf(w);
+			if (clipBase(r))
+			{
+				paintBackdrop(w, nb->second, xs[r.x0], ys[r.y0], xs[r.x1], ys[r.y1]);
+				claim(r);
+			}
+			return;
+		}
