+Region *SavedGame::locateRegionQuiet(double lon, double lat) const
+{
+	for (auto* region : _regions)
+	{
+		if (region->getRules()->insideRegion(lon, lat))
+		{
+			return region;
+		}
+	}
+	return 0;
+}
