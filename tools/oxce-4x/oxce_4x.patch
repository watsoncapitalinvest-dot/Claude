+void rect(double x0, double y0, double x1, double y1, Uint32 c, int alpha)
+{
+	const int X0 = std::max(clipX0, (int)std::lround(x0)), Y0 = std::max(clipY0, (int)std::lround(y0));
+	const int X1 = std::min(clipX1, (int)std::lround(x1)), Y1 = std::min(clipY1, (int)std::lround(y1));
+	if (X0 < X1 && Y0 < Y1) fillRect(X0, Y0, X1, Y1, c & 0xFFFFFF, alpha);
+}
+void roundRect(double x0, double y0, double x1, double y1, double rad, Uint32 c, int alpha)
+{
+	if (x0 >= clipX0 && y0 >= clipY0 && x1 <= clipX1 && y1 <= clipY1) OpenXcom::HiUI::roundRect(x0, y0, x1, y1, rad, c & 0xFFFFFF, alpha);
+	else rect(x0, y0, x1, y1, c, alpha);   // partly outside the panel: square, so nothing spills
+}
+void frame(double x0, double y0, double x1, double y1, double w, Uint32 c)
+{
+	rect(x0, y0, x1, y0 + w, c); rect(x0, y1 - w, x1, y1, c);
+	rect(x0, y0, x0 + w, y1, c); rect(x1 - w, y0, x1, y1, c);
+}
+void text(const std::string &faceName, const std::string &s, double x0, double y0, double x1, double y1,
+	double capPx, int halign, int valign, Uint32 c)
+{
+	const Face *f = face(faceName);
+	if (!f || s.empty()) return;
+	if (x1 <= clipX0 || x0 >= clipX1 || y1 <= clipY0 || y0 >= clipY1) return;
+	// count the lines so the line height follows the cap height
+	setType(*f, s, (int)x0, (int)std::max<double>(y0, clipY0 - 1000), (int)x1, (int)y1, capPx, capPx * 1.55, halign, valign, c & 0xFFFFFF, true);
+}
+bool image(const std::string &file, double x0, double y0, double x1, double y1, int alpha)
+{
+	static std::unordered_map<std::string, Img> srcs, sized;
+	auto s = srcs.find(file);
+	if (s == srcs.end()) s = srcs.emplace(file, loadPng(file)).first;
+	if (!s->second.ok) return false;
+	const int X0 = (int)std::lround(x0), Y0 = (int)std::lround(y0);
+	const int W = (int)std::lround(x1) - X0, H = (int)std::lround(y1) - Y0;
+	if (W <= 0 || H <= 0) return true;
+	const std::string key = file + "@" + std::to_string(W) + "x" + std::to_string(H);
+	auto z = sized.find(key);
+	if (z == sized.end())
+	{
+		if (sized.size() > 400) sized.clear();
+		z = sized.emplace(key, (s->second.w == W && s->second.h == H) ? s->second : resampleArea(s->second, W, H)).first;
+	}
+	const Img &q = z->second;
+	for (int Y = std::max(clipY0, Y0); Y < std::min(clipY1, Y0 + H); ++Y)
+	{
+		Uint32 *o = over.data() + (size_t)Y * sw;
+		const Uint32 *row = q.px.data() + (size_t)(Y - Y0) * q.w;
+		for (int X = std::max(clipX0, X0); X < std::min(clipX1, X0 + W); ++X)
+		{
+			const Uint32 p = row[X - X0];
+			const int a = (int)(p >> 24) * alpha / 255;
+			if (a) o[X] = a >= 255 ? (p & 0xFFFFFF) : mix(o[X], p & 0xFFFFFF, a);
+		}
+	}
+	return true;
+}
+
+bool picture(const std::string &file, double x0, double y0, double x1, double y1, double progress)
+{
+	static std::unordered_map<std::string, Img> cache;
+	auto it = cache.find(file);
+	if (it == cache.end()) it = cache.emplace(file, loadPng(file)).first;
+	const Img &src = it->second;
+	if (!src.ok) return false;
+	const int W = (int)std::lround(x1 - x0), H = (int)std::lround(y1 - y0);
+	if (W <= 0 || H <= 0) return true;
+	// spec 1b: block = 48 x (1 - progress) px at 432 wide, min 1; saturation 35% -> 100%
+	const double p = std::max(0.0, std::min(1.0, progress));
+	const int block = std::max(1, (int)std::lround(48.0 * (1.0 - p) * W / 432.0));
+	const int sat = (int)std::lround(256 * (0.35 + 0.65 * p));
+	const int X0 = (int)std::lround(x0), Y0 = (int)std::lround(y0);
+	// each block is the AREA average of the picture under it (the reveal strip's soft squares)
+	const Img sized = resampleArea(src, W, H);
+	const int nbx = (W + block - 1) / block, nby = (H + block - 1) / block;
+	std::vector<Uint32> blocks((size_t)nbx * nby);
+	for (int j = 0; j < nby; ++j)
+		for (int i = 0; i < nbx; ++i)
+		{
+			long r = 0, g = 0, b = 0, n = 0;
+			for (int y = j * block; y < std::min(H, (j + 1) * block); ++y)
+				for (int x = i * block; x < std::min(W, (i + 1) * block); ++x)
+				{
+					const Uint32 q = sized.px[(size_t)y * W + x];
+					r += (q >> 16) & 255; g += (q >> 8) & 255; b += q & 255; ++n;
+				}
+			blocks[(size_t)j * nbx + i] = n ? rgb((int)(r / n), (int)(g / n), (int)(b / n)) : 0;
+		}
+	for (int Y = std::max(clipY0, Y0); Y < std::min(clipY1, Y0 + H); ++Y)
+	{
+		Uint32 *o = over.data() + (size_t)Y * sw;
+		for (int X = std::max(clipX0, X0); X < std::min(clipX1, X0 + W); ++X)
+		{
+			const Uint32 q = blocks[(size_t)((Y - Y0) / block) * nbx + (X - X0) / block];
+			int r = (q >> 16) & 255, g = (q >> 8) & 255, b = q & 255;
+			if (sat < 256)
+			{
+				const int l = (r * 3 + g * 6 + b) / 10;
+				r = l + ((r - l) * sat >> 8); g = l + ((g - l) * sat >> 8); b = l + ((b - l) * sat >> 8);
+			}
+			o[X] = rgb(r, g, b);
+		}
+	}
+	return true;
+}
+}
