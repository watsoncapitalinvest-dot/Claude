+	/// resampling it each time was the biggest single cost of a frame (12 Nov profile).
+	struct Scaled { std::vector<Uint32> px; bool opaque = true; };
+	struct ScaledKey
+	{
+		const void *data; int w, h, sx0, sy0, sx1, sy1, dw, dh;
+		bool operator==(const ScaledKey &o) const { return data == o.data && w == o.w && h == o.h && sx0 == o.sx0 && sy0 == o.sy0 && sx1 == o.sx1 && sy1 == o.sy1 && dw == o.dw && dh == o.dh; }
