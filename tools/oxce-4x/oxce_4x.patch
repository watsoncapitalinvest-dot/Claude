+#pragma once
+/*
+ * G.I. Joe: USA Defense. The INTEL board: what the Joes know and what they are closing in on.
+ * Opens from the geoscape INTEL button, and by itself when a lead is solved or recon spots a site.
+ */
+#include "../Engine/State.h"
+#include <vector>
+#include <cstdint>
+
+namespace OpenXcom
+{
+
+class TextButton;
+class Window;
+class Text;
+class TextList;
+class Soldier;
+
+class IntelBoardState : public State
+{
+private:
+	TextButton *_btnOk, *_btnGraphs, *_btnCobra;
+	Window *_window;
+	Text *_txtTitle, *_txtNews;
+	TextList *_lstBoard;
+	std::vector<Soldier*> _heldRows; // row -> held Joe (0 for every other row)
+	std::vector<std::string> _opRows; // row -> spy operation that can be sent ("" for every other row)
+public:
+	IntelBoardState();
+	~IntelBoardState() = default;
+	void btnOkClick(Action *action);
+	void btnGraphsClick(Action *action);
+	void btnCobraClick(Action *action);
+	void lstBoardClick(Action *action);
+	void init() override;
+private:
+	void fill();
+};
+
+/// G.I. Joe spy operations (John 13 Nov 2026): pick a spy and send him on an operation.
+class SendSpyState : public State
+{
+private:
+	std::string _op;
+	Window *_window;
+	Text *_txtTitle, *_txtBody;
+	TextList *_lstSpies;
+	TextButton *_btnCancel;
+	std::vector<std::pair<Soldier*, class Base*>> _spies;
+public:
+	SendSpyState(const std::string &op);
+	void lstSpiesClick(Action *action);
+	void btnCancelClick(Action *action);
+};
+
+/// G.I. Joe capture (John 13 Nov 2026): a Joe held by Cobra. Trade a Cobra prisoner for him,
+/// rank for rank with cash to cover a gap, or mount a rescue (waits on its map).
+class HeldJoeState : public State
+{
+private:
+	Soldier *_soldier;
+	Window *_window;
+	Text *_txtTitle, *_txtBody;
+	TextButton *_btnTrade, *_btnRescue, *_btnCancel;
+	const class RuleItem *_offer;
+	int64_t _cash;
+public:
+	HeldJoeState(Soldier *soldier);
+	void btnTradeClick(Action *action);
+	void btnRescueClick(Action *action);
+	void btnCancelClick(Action *action);
+};
+
+}
