+void shot(Game *game, const std::string &tag)
+{
+	if (!game || !game->getScreen() || shots >= (campaign() > 0 ? 400 : 60)) return;   // a long battle is not a folder of 500 pictures
+	++shots;
+	game->getScreen()->screenshot(out(tag + ".png"));
+	note("screenshot " + tag);
+}
+
+void battleTick(Game *game, BattlescapeGame *bg, int turn, int side)
+{
+	if (!on()) return;
+	if (turn != turnSeen || side != sideSeen)
+	{
+		const bool newTurn = turn != turnSeen;
+		turnSeen = turn; sideSeen = side; turnSince = SDL_GetTicks();
+		note("turn " + std::to_string(turn) + (side == 0 ? " Joes" : side == 1 ? " Cobra" : " civilians"));
+		// pictures: the first three Joe turns, then every fifth
+		if (newTurn && (turn <= 3 || turn % 5 == 0)) { pendingShot = "turn" + std::to_string(turn); pendingAt = SDL_GetTicks(); }
+	}
+	// taken a few seconds in, once the turn's own popup has gone and the Joes have started moving
+	// (on the Joes' side only: the side change brings its own popup up, and the picture would be of that)
+	if (!pendingShot.empty() && side == 0 && SDL_GetTicks() - pendingAt > 2500) { shot(game, pendingShot); pendingShot.clear(); }
+	if (!pendingShot.empty() && side != 0) pendingShot.clear();
+	// one side's turn that never ends (the AI walking in circles, a unit that never gives up its move)
+	if (SDL_GetTicks() - turnSince > 600000)
+	{
+		shot(game, "stuck_turn" + std::to_string(turn));
+		result(std::string(campaign() > 0 ? "CAMPAIGN " : "") + "STUCK " + mission() + " turn " + std::to_string(turn) + ": one side's turn ran 10 minutes");
+		GJ_EXIT(5);
+	}
+	(void)bg;
+	// who is still standing: a line when it changes, and status.txt (the simulator app's live readout) every 2 s
+	SavedBattleGame *sb = game->getSavedGame() ? game->getSavedGame()->getSavedBattle() : nullptr;
+	if (!sb) return;
+	int total[3] = {0, 0, 0}, down[3] = {0, 0, 0};
+	for (const auto *u : *sb->getUnits())
+	{
+		const int f = (int)u->getOriginalFaction();
+		if (f < 0 || f > 2) continue;
+		++total[f]; if (u->isOut()) ++down[f];
+	}
+	static const char *who[3] = {"Joes", "Cobra", "civilians"};
+	for (int f = 0; f < 3; ++f)
+		if (down[f] != downSeen[f])
+		{
+			if (downSeen[f] >= 0) note(std::string(who[f]) + " down: " + std::to_string(down[f]) + " of " + std::to_string(total[f]));
+			downSeen[f] = down[f];
+		}
+	if (SDL_GetTicks() - statusAt > 2000)
+	{
+		statusAt = SDL_GetTicks();
+		std::ofstream st(out("status.txt"), std::ios::trunc);
+		st << "mission " << mission() << "\nturn " << turn << "\nside " << who[side < 0 || side > 2 ? 0 : side]
+		   << "\njoes " << total[0] - down[0] << " " << total[0] << "\ncobra " << total[1] - down[1] << " " << total[1]
+		   << "\ncivilians " << total[2] - down[2] << " " << total[2] << "\nseconds " << SDL_GetTicks() / 1000 << "\n";
+	}
+}
