+
+namespace OpenXcom
+{
+
+class TextButton;
+class Window;
+class Text;
+class TextList;
+
+/**
+ * What the player has worked out about Cobra's network, region by region.
+ *
+ * It reports only what has been found. A site counts once its base is discovered, and the two
+ * figures are what those known sites are worth per month - not what the region is actually
+ * holding, which the player has no way of knowing. So the screen sharpens as the player finds
+ * more, which is what gives a research lab or a hidden HQ a job beyond its own production.
+ *
+ * The mirror of the funding screen, and reached from it: that one says what the world pays
+ * X-COM, this one says what Cobra is earning.
+ */
+class CobraIntelState : public State
+{
+private:
+	TextButton *_btnOk;
+	Window *_window;
+	Text *_txtTitle, *_txtRegion, *_txtSites, *_txtFunds, *_txtMateriel, *_txtNote;
+	TextList *_lstRegions;
+
+public:
+	CobraIntelState();
+	~CobraIntelState() = default;
+	void btnOkClick(Action *action);
+};
+
+}
