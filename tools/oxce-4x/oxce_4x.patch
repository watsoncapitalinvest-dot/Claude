+/**
+ * G.I. Joe (John 18 Nov: "Tanks should run over sandbags"). As a big ground vehicle's hull
+ * crosses into new tiles, every part marked gjCrush under it is flattened: objects on the tiles
+ * it now covers, and walls between two tiles it has covered in this step (so a fence it only
+ * parks against stays up). Pathfinding::partCost let it in for a small cost.
+ */
+void gjCrushUnder(BattlescapeGame *parent, BattleUnit *unit)
+{
+	if (!Pathfinding::gjCrusher(unit)) return;
+	if (getenv("OXCE_CRUSH_TEST")) Log(LOG_INFO) << "[crush] step " << unit->getId() << " " << unit->getLastPosition() << " -> " << unit->getPosition();
+	SavedBattleGame *save = parent->getSave();
+	const int n = unit->getArmor()->getSize();
+	const Position now = unit->getPosition(), was = unit->getLastPosition();
+	auto covered = [&](int x, int y, int z) {
+		return (z == now.z && x >= now.x && x < now.x + n && y >= now.y && y < now.y + n)
+			|| (z == was.z && x >= was.x && x < was.x + n && y >= was.y && y < was.y + n);
+	};
+	int flattened = 0;
+	auto crush = [&](Tile *t, TilePart part) {
+		for (int guard = 0; guard < 3 && t && t->getMapData(part) && t->getMapData(part)->getGjCrush(); ++guard)
+		{
+			const MapData *md = t->getMapData(part);
+			const int die = md->getDieMCD();
+			const TilePart next = die ? md->getDataset()->getObject(die)->getObjectType() : part;
+			t->destroy(part, save->getObjectiveType());
+			++flattened;
+			if (next != part) break;     // turned into a floor or another part: leave what it became
+		}
+	};
+	for (int x = now.x; x < now.x + n; ++x)
+		for (int y = now.y; y < now.y + n; ++y)
+		{
+			Tile *t = save->getTile(Position(x, y, now.z));
+			if (!t) continue;
+			crush(t, O_OBJECT);
+			if (covered(x - 1, y, now.z)) crush(t, O_WESTWALL);
+			if (covered(x, y - 1, now.z)) crush(t, O_NORTHWALL);
+		}
+	// the walls on the tiles just left, between two covered tiles
+	for (int x = was.x; x < was.x + n; ++x)
+		for (int y = was.y; y < was.y + n; ++y)
+		{
+			Tile *t = save->getTile(Position(x, y, was.z));
+			if (!t) continue;
+			if (covered(x - 1, y, was.z)) crush(t, O_WESTWALL);
+			if (covered(x, y - 1, was.z)) crush(t, O_NORTHWALL);
+		}
+	if (flattened)
+	{
+		TileEngine *te = save->getTileEngine();
+		te->calculateLighting(LL_AMBIENT, now, n + 1, true);
+		te->calculateFOV(now, n + 1, true, true);
+		static int logged = 0;
+		if (logged < 20) { ++logged; Log(LOG_INFO) << "[crush] unit " << unit->getId() << " flattened " << flattened << " part(s) at " << now; }
+	}
+}
