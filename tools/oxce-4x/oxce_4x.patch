+	void paintHud(const Surface *bar)
+	{
+		const double k = SK();
+		const int Y0 = (int)DY(bar->getY()), Y1 = (int)DY(bar->getY() + bar->getHeight());
+		// the bar: ground, the olive rule on top, the squad strip
+		fillRect(0, Y0, sw, Y1, 0x14181A);
+		fillRect(0, Y0, sw, Y0 + std::max(1, (int)std::lround(k * 0.35)), S_OLIVE);
+		fillRect(0, (int)DY(bar->getY() + 1), sw, (int)DY(bar->getY() + 8.5), 0x0F1213);
+
+		// 6 portrait: a head crop of the inventory figure, in a yellow frame
+		DBox pb = hudBox(bar, 4, 11, 28, 28);
+		boxFill(pb, 0x1B2023);
+		bool drew = false;
+		if (hud.figure)
+		{
+			auto it = bgImages.find(hud.figure);
+			if (it != bgImages.end() && it->second.ok)
+			{
+				// the figures are painted to one sheet (INVENTORY_FIGURE_BRIEF): head
+				// top at 1/40 of the height, centred. Crop a square from the top.
+				const Img &im = it->second;
+				const double scale = im.h / 1200.0;             // twins are 1920x1200 pages
+				const int cx = (int)(483 * scale), top = (int)(290 * scale), side = (int)(130 * scale);
+				stretch(im, cx - side / 2, top, cx + side / 2, top + side, (int)pb.x0 + 2, (int)pb.y0 + 2, (int)pb.x1 - 2, (int)pb.y1 - 2);
+				drew = true;
+			}
+		}
+		if (!drew && hud.vehicleArt)
+		{
+			// a vehicle: its own picture, the one on its item card, fitted whole (John's list 18 Nov: no '?')
+			auto it = bgImages.find(hud.vehicleArt);
+			const Img *im = (it != bgImages.end() && it->second.ok) ? &it->second : flatTwin(hud.vehicleArt);
+			if (im && im->w > 0 && im->h > 0)
+			{
+				// fitted by what is drawn, not by the frame's empty margin
+				int ax0 = im->w, ay0 = im->h, ax1 = 0, ay1 = 0;
+				for (int yy = 0; yy < im->h; ++yy)
+					for (int xx = 0; xx < im->w; ++xx)
+						if ((im->px[yy * im->w + xx] >> 24) > 24) { ax0 = std::min(ax0, xx); ay0 = std::min(ay0, yy); ax1 = std::max(ax1, xx + 1); ay1 = std::max(ay1, yy + 1); }
+				if (ax1 <= ax0) { ax0 = 0; ay0 = 0; ax1 = im->w; ay1 = im->h; }
+				const double cw = ax1 - ax0, ch = ay1 - ay0;
+				const double bw = pb.x1 - pb.x0 - 8, bh = pb.y1 - pb.y0 - 8;
+				const double s = std::min(bw / cw, bh / ch);
+				const int w = (int)(cw * s), h = (int)(ch * s);
+				const int x0 = (int)(pb.x0 + 4 + (bw - w) / 2), y0 = (int)(pb.y0 + 4 + (bh - h) / 2);
+				stretch(*im, ax0, ay0, ax1, ay1, x0, y0, x0 + w, y0 + h);
+				drew = true;
+			}
+		}
+		if (!drew) boxText(hudBox(bar, 4, 11, 28, 28), "?", 8, 1, S_MUTED, "stencil");
+		boxEdge(pb, S_YELLOW, k * 0.35);
+
+		// 7 the line under the name, then four bars
+		boxText(hudBox(bar, 36, 18.3, 54, 4.4), hud.sub, 2.7, 0, S_MUTED);
+		hudBarRow(bar, 23.5, "TIME", hud.tu, hud.tuMax, S_YELLOW);
+		hudBarRow(bar, 27.5, "HEALTH", hud.hp, hud.hpMax, 0x6FAE4A);
+		hudBarRow(bar, 31.5, "ENERGY", hud.en, hud.enMax, 0x5B8FC9);
+		hudBarRow(bar, 35.5, "MORALE", hud.mo, hud.moMax, 0xC9C3B1);
+
+		// 8, 9 the hand cards (the fire-mode keys are widgets drawn over them)
+		// G.I. Joe ARSENAL: a vehicle has one ARMED WEAPON card across both, or its open weapon list there
+		if (hud.listOpen)
+		{
+			DBox cb = hudBox(bar, 94, 10, 98, 29);
+			boxFill(cb, 0x1B2023);
+			boxEdge(cb, S_YELLOW, k * 0.33);
+			boxText(hudBox(bar, 95.5, 10.8, 80, 3.6), hud.listTitle, 2.4, 0, S_YELLOW);
+		}
+		for (int i = 0; i < 2; ++i)
+		{
+			if (hud.listOpen || (hud.vehicle && i == 1)) continue;
+			const double cx = i == 0 ? 94 : 145;
+			const double cw = hud.vehicle ? 98 : 47;
+			DBox cb = hudBox(bar, cx, 10, cw, 29);
+			boxFill(cb, 0x1B2023);
+			boxEdge(cb, 0x2E3530, k * 0.33);
+			const HudHand &h = hud.hand[i];
+			boxText(hudBox(bar, cx + 1.5, 10.8, 30, 3.6), h.label, 2.4, 0, S_MUTED);
+			if (h.empty)
+			{
+				boxText(hudBox(bar, cx + 1.5, 15, 44, 5), "EMPTY", 2.6, 1, 0x5C5A52);
+				continue;
+			}
+			boxText(hudBox(bar, cx + cw - 20, 10.8, 18.5, 3.6), h.ammo, 2.6, 2, S_TEXT);
+			// the name shrinks to fit rather than being cut (59 of the Arsenal's names are longer than a hand card)
+			boxText(hudBox(bar, cx + 1.5, 14.6, cw - 3, 4.4), h.name, 2.6, 0, S_TEXT, "label", true);
+			if (h.art && hud.vehicle)   // HUD v2: a Joe's card has its fire modes and foot buttons where the picture was
+				if (const Img *im = sideways(h.art))
+				{
+					// fit the strip, keep the picture's proportions
+					DBox sb = hudBox(bar, cx + 1.5, 19.2, cw - 3, 6.2);
+					const double bw2 = sb.x1 - sb.x0, bh2 = sb.y1 - sb.y0;
+					const double sc = std::min(bw2 / im->w, bh2 / im->h);
+					const double w = im->w * sc, hgt = im->h * sc;
+					const double x = sb.x0 + (bw2 - w) / 2, y = sb.y0 + (bh2 - hgt) / 2;
+					stretch(*im, 0, 0, im->w, im->h, (int)x, (int)y, (int)(x + w), (int)(y + hgt));
+				}
+		}
+
+		// 11 reserve time: the label (the four toggles are widgets)
+		boxText(hudBox(bar, 196, 26.2, 30, 3.6), "RESERVE TIME", 2.2, 0, S_MUTED);
+
+		// 12 signature move
+		DBox sg = hudBox(bar, 228, 26, 30, 13);
+		boxFill(sg, hud.sigOn ? 0x232A2D : 0x1B2023);
+		boxEdge(sg, hud.sigOn ? S_YELLOW : 0x2E3530, k * 0.3);
+		boxText(hudBox(bar, 229.5, 26.6, 27, 3.2), hud.sigTitle, 2.0, 0, hud.sigOn ? S_YELLOW : 0x6E6C64, "label", true);
+		boxText(hudBox(bar, 229.5, 30, 27, 4.6), hud.sigName, 2.4, 0, hud.sigOn ? S_TEXT : 0x6E6C64, "stencil", true);
+		boxText(hudBox(bar, 229.5, 34.8, 27, 3.4), hud.sigHow, 1.9, 0, hud.sigOn ? S_MUTED : 0x5C5A52, "label", true);
+	}
