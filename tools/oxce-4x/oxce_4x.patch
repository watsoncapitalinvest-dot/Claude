+/**
+ * G.I. Joe: the Cobra turn screen, over the whole window while the player cannot see what Cobra is doing.
+ * One of John's three pictures (picked at random when the turn starts, kept for the turn), letterboxed; the HIDDEN
+ * MOVEMENT readout in the dark band the art keeps clear (y 520-680 of 1200), blinking off for a beat once a second;
+ * "TURN n . COBRA TURN" in gold top right over a red progress bar fed by refreshAIProgress.
+ */
+void Map::gjCobraTurnScreen()
+{
+	const int turn = _save->getTurn();
+	if (_gjTurnPicFor != turn) { _gjTurnPicFor = turn; _gjTurnPic = RNG::seedless(1, 3); _gjAIProgress = 0; }
+	const int pic = _gjTurnPic, progress = _gjAIProgress;
+	const bool neutral = _save->getSide() == FACTION_NEUTRAL;
+	HiUI::topLayer([pic, progress, turn, neutral](int sw, int sh)
+	{
+		HiUI::Paint::rect(0, 0, sw, sh, 0x000000);
+		const double k = std::min(sw / 1920.0, sh / 1200.0);
+		const double X0 = (sw - 1920 * k) / 2, Y0 = (sh - 1200 * k) / 2;
+		HiUI::Paint::image("Resources/Backgrounds/Briefings/cobra_turn_" + std::to_string(pic) + "_hi.png", X0, Y0, X0 + 1920 * k, Y0 + 1200 * k);
+		// the readout: 1263 x 156 canvas px, centred on y 600; off for the last 250 ms of every second
+		const bool lit = (SDL_GetTicks() % 1000) < 750;
+		const double lw = 1263 * k, lh = 156 * k, lx = X0 + (1920 * k - lw) / 2, ly = Y0 + 600 * k - lh / 2;
+		HiUI::Paint::image(lit ? "Resources/UI/cobra_turn_led_on.png" : "Resources/UI/cobra_turn_led_off.png", lx, ly, lx + lw, ly + lh);
+		// top right: whose turn, and how far through it Cobra is
+		const std::string who = neutral ? "CIVILIANS" : "COBRA TURN";
+		HiUI::Paint::text("label", "TURN " + std::to_string(turn) + " \xC2\xB7 " + who, X0 + 1380 * k, Y0 + 52 * k, X0 + 1850 * k, Y0 + 96 * k, 30 * k, 2, 1, 0xD8B45A);
+		const double bx0 = X0 + 1450 * k, by0 = Y0 + 110 * k, bx1 = X0 + 1850 * k, by1 = Y0 + 128 * k;
+		HiUI::Paint::frame(bx0, by0, bx1, by1, std::max(1.0, 2 * k), 0xB4B4B4);
+		const double in = std::max(1.0, 4 * k);
+		const double fill = (bx1 - bx0 - 2 * in) * std::max(0, std::min(100, progress)) / 100.0;
+		if (fill > 0) HiUI::Paint::rect(bx0 + in, by0 + in, bx0 + in + fill, by1 - in, 0xFF281E);
+	});
+}
