+/// A choice from the open list: a weapon becomes the armed weapon (it and the right hand's weapon change places);
+/// an order or action is done or made ready to aim.
+void BattlescapeState::hudListClick(Action *action)
+{
+	if (action->getSender() == _hudListPage) { _hudListFirst += 6; refreshJoeHud(); return; }
+	if (!playableUnitSelected() || _battleGame->isBusy()) return;
+	BattleUnit *u = _save->getSelectedUnit();
+	for (int i = 0; i < 6; ++i)
+	{
+		const int k = _hudListFirst + i;
+		if (action->getSender() != _hudList[i] || k >= (int)_hudEntries.size()) continue;
+		const HudEntry e = _hudEntries[k];
+		if (!e.usable) return;
+		_hudOpenGroup = -1;
+		switch (e.kind)
+		{
+		case HE_ARM:
+		{
+			BattleItem *pick = e.item, *cur = u->getRightHandWeapon();
+			if (pick != cur)
+			{
+				_battleGame->cancelCurrentAction();
+				const RuleInventory *slot = pick->getSlot();
+				const int sx = pick->getSlotX(), sy = pick->getSlotY();
+				pick->setSlot(_game->getMod()->getInventoryRightHand());
+				pick->setSlotX(0); pick->setSlotY(0);
+				if (cur) { cur->setSlot(slot); cur->setSlotX(sx); cur->setSlotY(sy); }
+				u->setActiveRightHand();
+				Log(LOG_INFO) << "[arsenal] " << u->getType() << " arms " << pick->getRules()->getType();
+			}
+			break;
+		}
+		case HE_ABORT: refreshJoeHud(); btnAbortClick(action); return;
+		case HE_CUFF: refreshJoeHud(); hudSigClick(action); return;
+		case HE_RELOAD: refreshJoeHud(); btnReloadClick(action); return;
+		case HE_CONCEAL: doConceal(u); break;
+		case HE_DISTRACT: doDistract(u); break;
+		case HE_SPECIAL: // BUILD-2 specials
+		{
+			_battleGame->cancelCurrentAction();
+			const std::string msg = VehicleSpecials::use(_battleGame, u, e.id);
+			if (!msg.empty()) warning(msg);
+			break;
+		}
+		case HE_PRIME:
+		case HE_MEDIKIT:
+		{
+			_battleGame->cancelCurrentAction();
+			if (e.item == u->getRightHandWeapon()) u->setActiveRightHand(); else u->setActiveLeftHand();
+			_battleGame->getCurrentAction()->weapon = e.item;
+			ActionMenuState *menu = new ActionMenuState(_battleGame->getCurrentAction(), _icons->getX(), _icons->getY() + 16);
+			menu->autoPick(e.kind == HE_PRIME ? BA_PRIME : BA_USE);
+			refreshJoeHud();
+			popup(menu);
+			return;
+		}
+		}
+		break;
+	}
+	updateSoldierInfo();
+	refreshJoeHud();
+}
