+++ b/src/Engine/HiUI.cpp
@@ -0,0 +1,666 @@
+#include "HiUI.h"
+#include "HiColor.h"
+#include "Surface.h"
+#include "SurfaceSet.h"
+#include "FileMap.h"
+#include "Logger.h"
+#include "Font.h"
+#include "../Interface/Window.h"
+#include "../Interface/TextButton.h"
+#include "../Interface/Text.h"
+#include "../Interface/ComboBox.h"
+#include "../Interface/Slider.h"
+#include "../Interface/Frame.h"
+#include "../Interface/ArrowButton.h"
+#include "../Interface/Bar.h"
+#include <SDL_image.h>
+#include <vector>
+#include <unordered_map>
+#include <algorithm>
+#include <cstdlib>
+#include <cstring>
+#include <cmath>
+
+namespace OpenXcom
+{
+namespace HiUI
+{
+
+namespace
+{
+	struct Atlas { std::vector<Uint8> cov; int w = 0, h = 0, k = 1; };
+	std::unordered_map<const Surface*, Atlas> atlases;
+
+	SDL_Surface *base = nullptr;
+	int bw = 0, bh = 0, sw = 0, sh = 0;
+	std::vector<int> xs, ys;          // base pixel edge -> screen pixel
+	std::vector<Uint32> over;         // screen-sized, 0x00RRGGBB
+	std::vector<Uint8> tag, valid;    // base-sized
+	std::vector<Uint8> scratch;       // per-widget "was valid before its blit"
+	bool any = false;
+	int curX = 0, curY = 0; bool curOn = false;
+
+	struct BgCache { const Surface *bg; Uint32 palHash; int w, h; std::vector<Uint32> px; };
+	std::vector<BgCache> bgCache;
+
+	struct Img { int w = 0, h = 0; std::vector<Uint32> px; bool ok = false; };   // 0xAARRGGBB
+	std::unordered_map<const Surface*, Img> bgImages;                            // sharp twin of a screen background or sprite frame
+	struct Pending { SurfaceSet *set; int frame; std::string file; };
+	std::vector<Pending> pending;                                                // resolved on first draw, not at mod load
+	std::unordered_map<std::string, Img> pieces;                                 // Resources/UI/<name>.png
+
+	Img loadPng(const std::string &path)
+	{
+		Img im;
+		if (!FileMap::fileExists(path)) return im;
+		SDL_Surface *raw = IMG_Load_RW(FileMap::getRWops(path), SDL_TRUE);
+		if (!raw) return im;
+		SDL_PixelFormat fmt = {};
+		fmt.BitsPerPixel = 32; fmt.BytesPerPixel = 4;
+		fmt.Rmask = 0x00FF0000; fmt.Gmask = 0x0000FF00; fmt.Bmask = 0x000000FF; fmt.Amask = 0xFF000000;
+		fmt.Rshift = 16; fmt.Gshift = 8; fmt.Bshift = 0; fmt.Ashift = 24;
+		SDL_Surface *c = SDL_ConvertSurface(raw, &fmt, SDL_SWSURFACE);
+		SDL_FreeSurface(raw);
+		if (!c) return im;
+		im.w = c->w; im.h = c->h; im.px.resize((size_t)im.w * im.h);
+		SDL_LockSurface(c);
+		for (int y = 0; y < im.h; ++y) memcpy(&im.px[(size_t)y * im.w], (Uint8*)c->pixels + y * c->pitch, (size_t)im.w * 4);
+		SDL_UnlockSurface(c); SDL_FreeSurface(c);
+		im.ok = true;
+		return im;
+	}
+	const Img *piece(const std::string &name)
+	{
+		auto it = pieces.find(name);
+		if (it == pieces.end())
+		{
+			Img im = loadPng("Resources/UI/" + name + ".png");
+			if (im.ok) Log(LOG_INFO) << "Interface art: " << name << " (" << im.w << "x" << im.h << ")";
+			it = pieces.emplace(name, std::move(im)).first;
+		}
+		return it->second.ok ? &it->second : nullptr;
+	}
+
+	inline Uint32 rgb(int r, int g, int b) { return ((Uint32)r << 16) | ((Uint32)g << 8) | (Uint32)b; }
+	inline Uint32 mix(Uint32 a, Uint32 b, int t) // t 0..255 of b
+	{
+		const int r = (((a >> 16) & 255) * (255 - t) + ((b >> 16) & 255) * t) / 255;
+		const int g = (((a >> 8) & 255) * (255 - t) + ((b >> 8) & 255) * t) / 255;
+		const int bl = ((a & 255) * (255 - t) + (b & 255) * t) / 255;
+		return rgb(r, g, bl);
+	}
+	inline const Uint8 *row8(int y) { return (const Uint8*)base->pixels + y * base->pitch; }
+
+	struct R { int x0, y0, x1, y1; };
+	bool clipBase(R &r)
+	{
+		r.x0 = std::max(r.x0, 0); r.y0 = std::max(r.y0, 0); r.x1 = std::min(r.x1, bw); r.y1 = std::min(r.y1, bh);
+		return r.x0 < r.x1 && r.y0 < r.y1;
+	}
+	void claim(const R &r) // these base pixels now show the overlay
+	{
+		for (int y = r.y0; y < r.y1; ++y)
+		{
+			const Uint8 *p = row8(y);
+			for (int x = r.x0; x < r.x1; ++x) { tag[y * bw + x] = p[x]; valid[y * bw + x] = 1; }
+		}
+		any = true;
+	}
+
+	Uint32 palHash(const SDL_Color *c)
+	{
+		Uint32 h = 2166136261u;
+		for (int i = 0; i < 256; ++i) { h = (h ^ c[i].r) * 16777619u; h = (h ^ c[i].g) * 16777619u; h = (h ^ c[i].b) * 16777619u; }
+		return h;
+	}
+
+	/// The window's 8-bit backdrop, smoothly enlarged and dimmed so text reads on it.
+	const BgCache &backdrop(const Surface *bg)
+	{
+		const SDL_Color *pal = base->format->palette->colors;
+		const Uint32 h = palHash(pal);
+		const int W = xs[std::min(bw, bg->getWidth())] - xs[0], H = ys[std::min(bh, bg->getHeight())] - ys[0];
+		for (auto &c : bgCache) if (c.bg == bg && c.palHash == h && c.w == W && c.h == H) return c;
+		if (bgCache.size() > 5) bgCache.erase(bgCache.begin());
+		bgCache.push_back(BgCache{ bg, h, W, H, std::vector<Uint32>((size_t)W * H) });
+		BgCache &c = bgCache.back();
+		const int gw = bg->getWidth(), gh = bg->getHeight(), pitch = bg->getPitch();
+		const Uint8 *src = bg->getBuffer();
+		for (int y = 0; y < H; ++y)
+		{
+			const double fy = (y + 0.5) * gh / H - 0.5; const int y0 = std::max(0, (int)std::floor(fy)), y1 = std::min(gh - 1, y0 + 1); const int ty = (int)((fy - y0) * 256); const int wy = std::min(256, std::max(0, ty));
+			for (int x = 0; x < W; ++x)
+			{
+				const double fx = (x + 0.5) * gw / W - 0.5; const int x0 = std::max(0, (int)std::floor(fx)), x1 = std::min(gw - 1, x0 + 1); const int wx = std::min(256, std::max(0, (int)((fx - x0) * 256)));
+				const SDL_Color &a = pal[src[y0 * pitch + x0]], &b = pal[src[y0 * pitch + x1]], &d = pal[src[y1 * pitch + x0]], &e = pal[src[y1 * pitch + x1]];
+				int r = ((a.r * (256 - wx) + b.r * wx) * (256 - wy) + (d.r * (256 - wx) + e.r * wx) * wy) >> 16;
+				int g = ((a.g * (256 - wx) + b.g * wx) * (256 - wy) + (d.g * (256 - wx) + e.g * wx) * wy) >> 16;
+				int bl = ((a.b * (256 - wx) + b.b * wx) * (256 - wy) + (d.b * (256 - wx) + e.b * wx) * wy) >> 16;
+				const int l = (r * 3 + g * 6 + bl) / 10;          // pull towards grey and darken: a watermark, not a picture
+				r = (r + l) / 2; g = (g + l) / 2; bl = (bl + l) / 2;
+				c.px[(size_t)y * W + x] = rgb(14 + r * 34 / 100, 17 + g * 36 / 100, 16 + bl * 34 / 100);
+			}
+		}
+		return c;
+	}
+
+	void fillRect(int x0, int y0, int x1, int y1, Uint32 c, int alpha = 255)
+	{
+		x0 = std::max(x0, 0); y0 = std::max(y0, 0); x1 = std::min(x1, sw); y1 = std::min(y1, sh);
+		for (int y = y0; y < y1; ++y)
+		{
+			Uint32 *o = over.data() + (size_t)y * sw;
+			if (alpha >= 255) for (int x = x0; x < x1; ++x) o[x] = c;
+			else for (int x = x0; x < x1; ++x) o[x] = mix(o[x], c, alpha);
+		}
+	}
+
+	/// Stretch a region of an image into a screen rectangle, blending on its alpha.
+	void stretch(const Img &im, int sx0, int sy0, int sx1, int sy1, int dx0, int dy0, int dx1, int dy1)
+	{
+		if (dx1 <= dx0 || dy1 <= dy0 || sx1 <= sx0 || sy1 <= sy0) return;
+		const int cx0 = std::max(dx0, 0), cy0 = std::max(dy0, 0), cx1 = std::min(dx1, sw), cy1 = std::min(dy1, sh);
+		for (int Y = cy0; Y < cy1; ++Y)
+		{
+			const double fy = sy0 + (Y - dy0 + 0.5) * (sy1 - sy0) / (double)(dy1 - dy0) - 0.5;
+			const int y0 = std::min(sy1 - 1, std::max(sy0, (int)std::floor(fy))), y1 = std::min(sy1 - 1, y0 + 1);
+			const int wy = std::min(256, std::max(0, (int)((fy - y0) * 256)));
+			Uint32 *o = over.data() + (size_t)Y * sw;
+			for (int X = cx0; X < cx1; ++X)
+			{
+				const double fx = sx0 + (X - dx0 + 0.5) * (sx1 - sx0) / (double)(dx1 - dx0) - 0.5;
+				const int x0 = std::min(sx1 - 1, std::max(sx0, (int)std::floor(fx))), x1 = std::min(sx1 - 1, x0 + 1);
+				const int wx = std::min(256, std::max(0, (int)((fx - x0) * 256)));
+				const Uint32 p00 = im.px[(size_t)y0 * im.w + x0], p01 = im.px[(size_t)y0 * im.w + x1];
+				const Uint32 p10 = im.px[(size_t)y1 * im.w + x0], p11 = im.px[(size_t)y1 * im.w + x1];
+				auto ch = [&](int sh2) { return (int)((((p00 >> sh2 & 255) * (256 - wx) + (p01 >> sh2 & 255) * wx) * (256 - wy) + ((p10 >> sh2 & 255) * (256 - wx) + (p11 >> sh2 & 255) * wx) * wy) >> 16); };
+				const int al = ch(24);
+				if (al <= 0) continue;
+				const Uint32 c = rgb(ch(16), ch(8), ch(0));
+				o[X] = al >= 255 ? c : mix(o[X], c, al);
+			}
+		}
+	}
+	/// Nine-slice: corners kept, edges and middle stretched.
+	void nine(const Img &im, int x0, int y0, int x1, int y1, int b)
+	{
+		b = std::min(b, std::min(im.w, im.h) / 3);
+		const int bx = std::min(b, (x1 - x0) / 3), by = std::min(b, (y1 - y0) / 3);
+		const int sx[4] = { 0, b, im.w - b, im.w }, sy[4] = { 0, b, im.h - b, im.h };
+		const int dx[4] = { x0, x0 + bx, x1 - bx, x1 }, dy[4] = { y0, y0 + by, y1 - by, y1 };
+		for (int r = 0; r < 3; ++r)
+			for (int c = 0; c < 3; ++c)
+				stretch(im, sx[c], sy[r], sx[c + 1], sy[r + 1], dx[c], dy[r], dx[c + 1], dy[r + 1]);
+	}
+
+	/// Rounded panel with a 1-2 px rim.
+	void panel(int x0, int y0, int x1, int y1, int rad, Uint32 top, Uint32 bottom, Uint32 rim, int rimW)
+	{
+		const int cx0 = std::max(x0, 0), cy0 = std::max(y0, 0), cx1 = std::min(x1, sw), cy1 = std::min(y1, sh);
+		const int h = std::max(1, y1 - y0);
+		for (int y = cy0; y < cy1; ++y)
+		{
+			Uint32 *o = over.data() + (size_t)y * sw;
+			const Uint32 fill = mix(top, bottom, (y - y0) * 255 / h);
+			for (int x = cx0; x < cx1; ++x)
+			{
+				// distance to the rounded outline
+				const int dx = std::max(std::max(x0 + rad - x, x - (x1 - 1 - rad)), 0), dy = std::max(std::max(y0 + rad - y, y - (y1 - 1 - rad)), 0);
+				double d;
+				if (dx > 0 && dy > 0) d = rad - std::sqrt((double)dx * dx + (double)dy * dy);
+				else d = std::min(std::min(x - x0, x1 - 1 - x), std::min(y - y0, y1 - 1 - y)) + 0.5;
+				if (d <= -0.5) continue;                           // outside the corner: leave what is there
+				Uint32 c = d < rimW ? rim : fill;
+				if (d < 0.5) c = mix(o[x], c, (int)((d + 0.5) * 255));
+				o[x] = c;
+			}
+		}
+	}
+
+	void glyphs(const Text *t, int ox, int oy, const R &clip, Uint32 ink, bool useMask, const R &maskRect)
+	{
+		const SDL_Color *pal = base->format->palette->colors;
+		for (const auto &g : t->getHiGlyphs())
+		{
+			if (!g.sheet) continue;
+			auto it = atlases.find(g.sheet);
+			if (it == atlases.end()) continue;
+			const Atlas &a = it->second;
+			const int bx0 = ox + g.x, by0 = oy + g.y, bx1 = bx0 + g.w, by1 = by0 + g.h;
+			if (bx1 <= clip.x0 || by1 <= clip.y0 || bx0 >= clip.x1 || by0 >= clip.y1 || bx0 < 0 || by0 < 0 || bx1 > bw || by1 > bh) continue;
+			Uint32 col = ink;
+			if (!col)
+			{
+				const SDL_Color &c = pal[g.color];
+				col = mix(rgb(c.r, c.g, c.b), rgb(234, 230, 214), 205);   // keep a hint of the hue's meaning, read as off-white
+			}
+			const int X0 = xs[bx0], X1 = xs[bx1], Y0 = ys[by0], Y1 = ys[by1];
+			const double kx = (double)(g.w * a.k) / (X1 - X0), ky = (double)(g.h * a.k) / (Y1 - Y0);
+			for (int Y = Y0; Y < Y1; ++Y)
+			{
+				const int by = by0 + (Y - Y0) * g.h / (Y1 - Y0);
+				if (by < clip.y0 || by >= clip.y1) continue;
+				const double fy = g.sy * a.k + (Y - Y0 + 0.5) * ky - 0.5; const int sy0 = std::max(0, (int)fy), sy1 = std::min(a.h - 1, sy0 + 1); const int wy = (int)((fy - sy0) * 256);
+				Uint32 *o = over.data() + (size_t)Y * sw;
+				for (int X = X0; X < X1; ++X)
+				{
+					const int bx = bx0 + (X - X0) * g.w / (X1 - X0);
+					if (bx < clip.x0 || bx >= clip.x1) continue;
+					if (useMask && !scratch[(by - maskRect.y0) * (maskRect.x1 - maskRect.x0) + (bx - maskRect.x0)]) continue;
+					const double fx = g.sx * a.k + (X - X0 + 0.5) * kx - 0.5; const int sx0 = std::max(0, (int)fx), sx1 = std::min(a.w - 1, sx0 + 1); const int wx = (int)((fx - sx0) * 256);
+					const int c00 = a.cov[(size_t)sy0 * a.w + sx0], c01 = a.cov[(size_t)sy0 * a.w + sx1], c10 = a.cov[(size_t)sy1 * a.w + sx0], c11 = a.cov[(size_t)sy1 * a.w + sx1];
+					const int cov = ((c00 * (256 - wx) + c01 * wx) * (256 - wy) + (c10 * (256 - wx) + c11 * wx) * wy) >> 16;
+					if (cov > 0) o[X] = mix(o[X], col, std::min(255, cov));
+				}
+			}
+		}
+	}
+
+	bool shown(const Surface *s) { return s->getVisible() && !s->isHidden(); }
+	R rectOf(const Surface *s) { return R{ s->getX(), s->getY(), s->getX() + s->getWidth(), s->getY() + s->getHeight() }; }
+}
+
+bool enabled()
+{
+	static int on = -1;
+	if (on < 0)
+	{
+		const char *e = getenv("OXCE_HIUI");
+		on = e ? (atoi(e) != 0) : HiColor::enabled();
+	}
+	return on != 0;
+}
+
+void registerFontImage(const Surface *sheet8, const std::string &file)
+{
+	if (!enabled() || !sheet8) return;
+	const auto dot = file.find_last_of('.');
+	if (dot == std::string::npos) return;
+	const std::string twin = file.substr(0, dot) + "_hi.png";
+	if (!FileMap::fileExists(twin)) return;
+	SDL_Surface *img = IMG_Load_RW(FileMap::getRWops(twin), SDL_TRUE);
+	if (!img) return;
+	SDL_PixelFormat fmt = {};
+	fmt.BitsPerPixel = 32; fmt.BytesPerPixel = 4;
+	fmt.Rmask = 0x00FF0000; fmt.Gmask = 0x0000FF00; fmt.Bmask = 0x000000FF; fmt.Amask = 0xFF000000;
+	fmt.Rshift = 16; fmt.Gshift = 8; fmt.Bshift = 0; fmt.Ashift = 24;
+	SDL_Surface *conv = SDL_ConvertSurface(img, &fmt, SDL_SWSURFACE);
+	SDL_FreeSurface(img);
+	if (!conv) return;
+	const int k = conv->w / sheet8->getWidth();
+	if (k < 1 || conv->w != sheet8->getWidth() * k || conv->h != sheet8->getHeight() * k)
+	{
+		Log(LOG_WARNING) << "Sharp font sheet " << twin << " does not match its 8-bit sheet";
+		SDL_FreeSurface(conv); return;
+	}
+	Atlas a; a.w = conv->w; a.h = conv->h; a.k = k; a.cov.resize((size_t)a.w * a.h);
+	SDL_LockSurface(conv);
+	for (int y = 0; y < a.h; ++y)
+	{
+		const Uint32 *p = (const Uint32*)((const Uint8*)conv->pixels + y * conv->pitch);
+		for (int x = 0; x < a.w; ++x) a.cov[(size_t)y * a.w + x] = (Uint8)(p[x] >> 24);
+	}
+	SDL_UnlockSurface(conv); SDL_FreeSurface(conv);
+	atlases[sheet8] = std::move(a);
+	Log(LOG_INFO) << "Sharp font sheet: " << twin << " (x" << k << ")";
+}
+
+void registerImage(const Surface *img, const std::string &file)
+{
+	if (!enabled() || !img) return;
+	const auto dot = file.find_last_of('.');
+	if (dot == std::string::npos) return;
+	Img im = loadPng(file.substr(0, dot) + "_hi.png");
+	if (!im.ok) return;
+	Log(LOG_INFO) << "Sharp twin: " << file << " (" << im.w << "x" << im.h << ")";
+	bgImages[img] = std::move(im);
+}
+
+void registerSetFrame(SurfaceSet *set, int frame, const std::string &file)
+{
+	if (!enabled() || !set) return;
+	const auto dot = file.find_last_of('.');
+	if (dot == std::string::npos || !FileMap::fileExists(file.substr(0, dot) + "_hi.png")) return;
+	pending.push_back({set, frame, file});
+}
+
+void resolvePending()
+{
+	if (pending.empty()) return;
+	std::vector<Pending> todo;
+	todo.swap(pending);
+	for (const auto &p : todo)
+	{
+		const Surface *f = p.set->getFrame(p.frame);
+		if (!f) continue;
+		const auto dot = p.file.find_last_of('.');
+		Img im = loadPng(p.file.substr(0, dot) + "_hi.png");
+		if (!im.ok) continue;
+		Log(LOG_INFO) << "Sharp sprite: " << p.file << " (" << im.w << "x" << im.h << ")";
+		bgImages[f] = std::move(im);
+	}
+}
+
+void sprite(const Surface *frame, int x, int y, int w, int h)
+{
+	resolvePending();
+	if (!base || !frame || w <= 0 || h <= 0) return;
+	auto it = bgImages.find(frame);
+	if (it == bgImages.end() || !it->second.ok) return;
+	const Img &im = it->second;
+	R r{x, y, x + w, y + h};
+	if (!clipBase(r)) return;
+	const SDL_Color *pal = base->format->palette ? base->format->palette->colors : nullptr;
+	bool took = false;
+	for (int by = r.y0; by < r.y1; ++by)
+	{
+		const Uint8 *p = row8(by);
+		for (int bx = r.x0; bx < r.x1; ++bx)
+		{
+			// this base pixel's block on screen, and the slice of the sharp twin that belongs to it
+			const int X0 = xs[bx], X1 = xs[bx + 1], Y0 = ys[by], Y1 = ys[by + 1];
+			const int u0 = (bx - x) * im.w / w, u1 = std::max(u0 + 1, (bx - x + 1) * im.w / w);
+			const int v0 = (by - y) * im.h / h, v1 = std::max(v0 + 1, (by - y + 1) * im.h / h);
+			// The 8-bit icon's outline is one base pixel wide and steps badly. Where the sharp twin
+			// has something to say just outside it, take that pixel too, so the edge is the twin's.
+			if (!p[bx])
+			{
+				bool edge = false;
+				for (int v = v0; v < v1 && !edge; ++v)
+					for (int u = u0; u < u1; ++u)
+						if ((im.px[(size_t)v * im.w + u] >> 24) > 24) { edge = true; break; }
+				if (!edge) continue;
+			}
+			if (!valid[by * bw + bx] && pal)            // nothing sharp underneath yet: start from the flat colour
+			{
+				const SDL_Color &c = pal[p[bx]];
+				const Uint32 flat = rgb(c.r, c.g, c.b);
+				for (int Y = std::max(0, Y0); Y < std::min(sh, Y1); ++Y)
+				{
+					Uint32 *o = over.data() + (size_t)Y * sw;
+					for (int X = std::max(0, X0); X < std::min(sw, X1); ++X) o[X] = flat;
+				}
+			}
+			for (int Y = std::max(0, Y0); Y < std::min(sh, Y1); ++Y)
+			{
+				const int v = std::min(v1 - 1, v0 + (Y1 > Y0 ? (Y - Y0) * (v1 - v0) / (Y1 - Y0) : 0));
+				Uint32 *o = over.data() + (size_t)Y * sw;
+				for (int X = std::max(0, X0); X < std::min(sw, X1); ++X)
+				{
+					const int u = std::min(u1 - 1, u0 + (X1 > X0 ? (X - X0) * (u1 - u0) / (X1 - X0) : 0));
+					const Uint32 s = im.px[(size_t)v * im.w + u];
+					const Uint32 a = s >> 24;
+					if (!a) continue;                   // transparent in the sharp art: keep what is there
+					if (a == 255) { o[X] = s & 0x00FFFFFFu; continue; }
+					const Uint32 d = o[X];
+					const Uint32 nr = (((s >> 16) & 0xFF) * a + ((d >> 16) & 0xFF) * (255 - a)) / 255;
+					const Uint32 ng = (((s >> 8) & 0xFF) * a + ((d >> 8) & 0xFF) * (255 - a)) / 255;
+					const Uint32 nb = ((s & 0xFF) * a + (d & 0xFF) * (255 - a)) / 255;
+					o[X] = rgb((int)nr, (int)ng, (int)nb);
+				}
+			}
+			tag[by * bw + bx] = p[bx]; valid[by * bw + bx] = 1; took = true;
+		}
+	}
+	if (took) any = true;
+}
+
+void beginFrame(SDL_Surface *base8, int screenW, int screenH, int left, int top, int right, int bottom)
+{
+	base = nullptr; any = false; curOn = false;
+	if (!enabled() || !base8 || base8->format->BitsPerPixel != 8) return;
+	base = base8;
+	if (bw != base8->w || bh != base8->h || sw != screenW || sh != screenH || xs.empty() || xs[0] != left || ys[0] != top)
+	{
+		bw = base8->w; bh = base8->h; sw = screenW; sh = screenH;
+		xs.resize(bw + 1); ys.resize(bh + 1);
+		for (int i = 0; i <= bw; ++i) xs[i] = left + (int)((double)i * (sw - left - right) / bw + 0.5);
+		for (int i = 0; i <= bh; ++i) ys[i] = top + (int)((double)i * (sh - top - bottom) / bh + 0.5);
+		over.assign((size_t)sw * sh, 0); tag.assign((size_t)bw * bh, 0); valid.assign((size_t)bw * bh, 0);
+		bgCache.clear();
+	}
+	else std::fill(valid.begin(), valid.end(), 0);
+}
+
+void before(Surface *w)
+{
+	if (!base || !any) return;
+	Text *t = dynamic_cast<Text*>(w);
+	if (!t || !shown(t)) return;
+	R r = rectOf(t);
+	if (!clipBase(r)) { scratch.clear(); return; }
+	scratch.assign((size_t)(r.x1 - r.x0) * (r.y1 - r.y0), 0);
+	for (int y = r.y0; y < r.y1; ++y)
+	{
+		const Uint8 *p = row8(y);
+		for (int x = r.x0; x < r.x1; ++x)
+			scratch[(size_t)(y - r.y0) * (r.x1 - r.x0) + (x - r.x0)] = valid[y * bw + x] && tag[y * bw + x] == p[x];
+	}
+}
+
+void after(Surface *w)
+{
+	if (!base || !shown(w)) return;
+	if (Window *win = dynamic_cast<Window*>(w))
+	{
+		if (!win->isPoppedUp()) return;
+		R r = rectOf(win);
+		if (!clipBase(r)) return;
+		const int X0 = xs[r.x0], Y0 = ys[r.y0], X1 = xs[r.x1], Y1 = ys[r.y1];
+		const Surface *bg = win->getBackground();
+		auto bit = bg ? bgImages.find(bg) : bgImages.end();
+		if (bit != bgImages.end() && bit->second.ok)
+		{
+			// the painted backdrop, sampled at the piece of the screen this window covers
+			const Img &im = bit->second;
+			const double kx = (double)im.w / bw, ky = (double)im.h / bh;
+			stretch(im, (int)(r.x0 * kx), (int)(r.y0 * ky), (int)(r.x1 * kx), (int)(r.y1 * ky), X0, Y0, X1, Y1);
+		}
+		else if (bg && bg->getBuffer())
+		{
+			const BgCache &c = backdrop(bg);
+			for (int Y = Y0; Y < Y1; ++Y)
+			{
+				const int sy = std::min(c.h - 1, std::max(0, Y - Y0));
+				Uint32 *o = over.data() + (size_t)Y * sw;
+				const Uint32 *src = c.px.data() + (size_t)sy * c.w;
+				for (int X = X0; X < X1; ++X) o[X] = src[std::min(c.w - 1, std::max(0, X - X0))];
+			}
+		}
+		else fillRect(X0, Y0, X1, Y1, rgb(22, 26, 24));
+		const Img *fr = piece(win->getWidth() >= 260 || win->getHeight() >= 150 ? "window_frame" : "window_frame_small");
+		if (fr) nine(*fr, X0, Y0, X1, Y1, std::max(6, (int)(fr->h * 0.06)));
+		else
+		{
+			const Uint32 line = rgb(150, 156, 140);
+			fillRect(X0, Y0, X1, Y0 + 3, rgb(150, 36, 30));
+			fillRect(X0, Y1 - 1, X1, Y1, line, 110); fillRect(X0, Y0 + 3, X0 + 1, Y1, line, 110); fillRect(X1 - 1, Y0 + 3, X1, Y1, line, 110);
+		}
+		claim(r);
+		return;
+	}
+	if (TextButton *b = dynamic_cast<TextButton*>(w))
+	{
+		R r = rectOf(b);
+		if (!clipBase(r) || r.x1 - r.x0 != b->getWidth() || r.y1 - r.y0 != b->getHeight()) return;
+		const int X0 = xs[r.x0], Y0 = ys[r.y0], X1 = xs[r.x1], Y1 = ys[r.y1];
+		const bool down = b->isPressedLook();
+		const int m = std::max(1, (ys[1] - ys[0]) / 3);     // a little air between stacked buttons
+		const bool square = b->getWidth() <= b->getHeight() * 5 / 4;
+		const Img *art = piece(square ? (down ? "button_square_pressed" : "button_square") : (down ? "button_wide_pressed" : "button_wide"));
+		if (art) nine(*art, X0 + m, Y0 + m, X1 - m, Y1 - m, std::max(5, (int)(art->h * 0.22)));
+        else if (down) panel(X0 + m, Y0 + m, X1 - m, Y1 - m, 5, rgb(120, 30, 26), rgb(96, 24, 21), rgb(214, 96, 84), 1);
+		else panel(X0 + m, Y0 + m, X1 - m, Y1 - m, 5, rgb(62, 72, 62), rgb(46, 54, 47), rgb(112, 122, 106), 1);
+		claim(r);
+		if (const Text *t = b->getTextWidget()) glyphs(t, b->getX() + t->getX(), b->getY() + t->getY(), r, rgb(236, 232, 214), false, r);
+		return;
+	}
+	if (Frame *fm = dynamic_cast<Frame*>(w))
+	{
+		R r = rectOf(fm);
+		if (!clipBase(r)) return;
+		const int X0 = xs[r.x0], Y0 = ys[r.y0], X1 = xs[r.x1], Y1 = ys[r.y1];
+		const int t = std::max(1, (ys[2] - ys[0]) / 2);
+		const Uint32 line = rgb(126, 136, 120);
+		fillRect(X0, Y0, X1, Y0 + t, line, 200); fillRect(X0, Y1 - t, X1, Y1, line, 200);
+		fillRect(X0, Y0, X0 + t, Y1, line, 200); fillRect(X1 - t, Y0, X1, Y1, line, 200);
+		// claim the rim only: anything the frame surrounds keeps drawing as before
+		const int bt = std::max(1, fm->getThickness());
+		R top{ r.x0, r.y0, r.x1, std::min(r.y1, r.y0 + bt) }, bot{ r.x0, std::max(r.y0, r.y1 - bt), r.x1, r.y1 };
+		R lef{ r.x0, r.y0, std::min(r.x1, r.x0 + bt), r.y1 }, rig{ std::max(r.x0, r.x1 - bt), r.y0, r.x1, r.y1 };
+		claim(top); claim(bot); claim(lef); claim(rig);
+		return;
+	}
+	if (ComboBox *cb = dynamic_cast<ComboBox*>(w))
+	{
+		R r = rectOf(cb);
+		if (!clipBase(r)) return;
+		const int X0 = xs[r.x0], Y0 = ys[r.y0], X1 = xs[r.x1], Y1 = ys[r.y1];
+		const int m = std::max(1, (ys[1] - ys[0]) / 3);
+		if (const Img *art = piece("button_wide")) nine(*art, X0 + m, Y0 + m, X1 - m, Y1 - m, std::max(5, (int)(art->h * 0.22)));
+		else panel(X0 + m, Y0 + m, X1 - m, Y1 - m, 5, rgb(62, 72, 62), rgb(46, 54, 47), rgb(112, 122, 106), 1);
+		const int aw = xs[std::min(bw, r.x0 + ComboBox::buttonWidth())] - X0;
+		if (const Img *ar = piece("dropdown_arrow"))
+		{
+			const int s2 = std::min(aw * 3 / 5, (Y1 - Y0) * 3 / 5), cx = X1 - aw / 2, cy = (Y0 + Y1) / 2;
+			stretch(*ar, 0, 0, ar->w, ar->h, cx - s2 / 2, cy - s2 / 2, cx + s2 / 2, cy + s2 / 2);
+		}
+		claim(r);
+		if (const TextButton *b = cb->getButtonWidget())
+			if (const Text *t = b->getTextWidget()) glyphs(t, b->getX() + t->getX(), b->getY() + t->getY(), r, rgb(236, 232, 214), false, r);
+		return;
+	}
+	if (Slider *sl = dynamic_cast<Slider*>(w))
+	{
+		R r = rectOf(sl);
+		if (!clipBase(r)) return;
+		claim(r);
+		if (const Frame *fr = sl->getTrackWidget())
+		{
+			const int tx0 = xs[std::max(0, std::min(bw, fr->getX()))], tx1 = xs[std::max(0, std::min(bw, fr->getX() + fr->getWidth()))];
+			const int cy = (ys[r.y0] + ys[r.y1]) / 2, th = std::max(2, (ys[3] - ys[0]) / 2);
+			if (const Img *tr = piece("slider_track")) stretch(*tr, 0, 0, tr->w, tr->h, tx0, cy - th, tx1, cy + th);
+			else fillRect(tx0, cy - th, tx1, cy + th, rgb(40, 46, 42));
+		}
+		if (const TextButton *kb = sl->getKnobWidget())
+		{
+			const int kx0 = xs[std::max(0, std::min(bw, kb->getX()))], kx1 = xs[std::max(0, std::min(bw, kb->getX() + kb->getWidth()))];
+			const int ky0 = ys[std::max(0, std::min(bh, kb->getY()))], ky1 = ys[std::max(0, std::min(bh, kb->getY() + kb->getHeight()))];
+			if (const Img *kn = piece("slider_knob")) stretch(*kn, 0, 0, kn->w, kn->h, kx0, ky0, kx1, ky1);
+			else panel(kx0, ky0, kx1, ky1, 3, rgb(150, 156, 140), rgb(110, 118, 104), rgb(40, 46, 42), 1);
+		}
+		return;
+	}
+	if (ArrowButton *ab = dynamic_cast<ArrowButton*>(w))
+	{
+		const ArrowShape sp = ab->getShape();
+		if (sp == ARROW_NONE) return;
+		R r = rectOf(ab);
+		if (!clipBase(r)) return;
+		const char *nm = (sp == ARROW_BIG_UP || sp == ARROW_SMALL_UP) ? "arrow_up" : (sp == ARROW_BIG_DOWN || sp == ARROW_SMALL_DOWN) ? "arrow_down" : (sp == ARROW_SMALL_LEFT) ? "arrow_left" : "arrow_right";
+		if (const Img *ar = piece(nm))
+		{
+			const int X0 = xs[r.x0], Y0 = ys[r.y0], X1 = xs[r.x1], Y1 = ys[r.y1];
+			stretch(*ar, 0, 0, ar->w, ar->h, X0, Y0, X1, Y1);
+			claim(r);
+		}
+		return;
+	}
+	if (Text *t = dynamic_cast<Text*>(w))
+	{
+		if (!any || scratch.empty()) return;
+		R r = rectOf(t);
+		if (!clipBase(r) || scratch.size() != (size_t)(r.x1 - r.x0) * (r.y1 - r.y0)) return;
+		glyphs(t, t->getX(), t->getY(), r, 0, true, r);
+		for (int y = r.y0; y < r.y1; ++y)
+		{
+			const Uint8 *p = row8(y);
+			for (int x = r.x0; x < r.x1; ++x)
+				if (scratch[(size_t)(y - r.y0) * (r.x1 - r.x0) + (x - r.x0)]) tag[y * bw + x] = p[x];
+		}
+		scratch.clear();
+	}
+}
+
+void cursor(int x, int y, bool visible)
+{
+	curX = x; curY = y; curOn = visible;
+}
+
+void composite(SDL_Surface *base8, SDL_Surface *screen32)
+{
+	if (!base || base8 != base || screen32->format->BitsPerPixel != 32 || screen32->w != sw || screen32->h != sh) return;
+	const SDL_PixelFormat *f = screen32->format;
+	const bool direct = f->Rshift == 16 && f->Gshift == 8 && f->Bshift == 0;
+	if (SDL_MUSTLOCK(screen32)) SDL_LockSurface(screen32);
+	auto put = [&](int X, int Y, Uint32 c)
+	{
+		((Uint32*)((Uint8*)screen32->pixels + Y * screen32->pitch))[X] = direct ? c : SDL_MapRGB(f, (c >> 16) & 255, (c >> 8) & 255, c & 255);
+	};
+	if (any)
+	{
+		for (int by = 0; by < bh; ++by)
+		{
+			const Uint8 *p = row8(by);
+			for (int bx = 0; bx < bw; ++bx)
+			{
+				if (!valid[by * bw + bx] || tag[by * bw + bx] != p[bx]) continue;
+				for (int Y = ys[by]; Y < ys[by + 1]; ++Y)
+				{
+					const Uint32 *o = over.data() + (size_t)Y * sw;
+					Uint32 *d = (Uint32*)((Uint8*)screen32->pixels + Y * screen32->pitch);
+					if (direct) memcpy(d + xs[bx], o + xs[bx], (xs[bx + 1] - xs[bx]) * 4);
+					else for (int X = xs[bx]; X < xs[bx + 1]; ++X) put(X, Y, o[X]);
+				}
+			}
+		}
+	}
+	if (curOn && curX >= 0 && curY >= 0 && curX < bw && curY < bh)
+	{
+		const Img *cur = piece("cursor");
+		const int oy = ys[curY], ox = xs[curX];
+		if (cur)
+		{
+			const int H = (ys[std::min(bh, curY + 17)] - oy), W = std::max(1, cur->w * H / cur->h);
+			for (int Y = 0; Y < H; ++Y)
+			{
+				const int SY = oy + Y; if (SY < 0 || SY >= sh) continue;
+				Uint32 *d = (Uint32*)((Uint8*)screen32->pixels + SY * screen32->pitch);
+				const int sy2 = std::min(cur->h - 1, Y * cur->h / H);
+				for (int X = 0; X < W; ++X)
+				{
+					const int SX = ox + X; if (SX < 0 || SX >= sw) continue;
+					const Uint32 p = cur->px[(size_t)sy2 * cur->w + std::min(cur->w - 1, X * cur->w / W)];
+					const int al = p >> 24; if (al < 40) continue;
+					const Uint32 c = al >= 230 ? (p & 0xFFFFFF) : mix(direct ? d[SX] : rgb((d[SX] >> f->Rshift & 255), (d[SX] >> f->Gshift & 255), (d[SX] >> f->Bshift & 255)), p & 0xFFFFFF, al);
+					put(SX, SY, c);
+				}
+			}
+		}
+		else
+		{
+		const double s2 = std::max(1.0, (ys[1] - ys[0]) / 5.0);
+		const double P[7][2] = { {0,0},{0,17},{4,13},{7,20},{10,19},{7,12},{12,12} };
+		auto inside = [&](double x, double y)
+		{
+			bool in = false;
+			for (int i = 0, j = 6; i < 7; j = i++)
+				if (((P[i][1] > y) != (P[j][1] > y)) && (x < (P[j][0] - P[i][0]) * (y - P[i][1]) / (P[j][1] - P[i][1]) + P[i][0])) in = !in;
+			return in;
+		};
+		for (int Y = (int)(-2 * s2); Y < (int)(22 * s2); ++Y)
+			for (int X = (int)(-2 * s2); X < (int)(14 * s2); ++X)
+			{
+				const int SX = ox + X, SY = oy + Y;
+				if (SX < 0 || SY < 0 || SX >= sw || SY >= sh) continue;
+				const double x = X / s2, y = Y / s2;
+				if (inside(x, y)) put(SX, SY, rgb(236, 232, 214));
+				else if (inside(x - 1.1, y) || inside(x + 1.1, y) || inside(x, y - 1.1) || inside(x, y + 1.1)) put(SX, SY, rgb(18, 20, 19));
+			}
+		}
+	}
+	if (SDL_MUSTLOCK(screen32)) SDL_UnlockSurface(screen32);
+}
+
+}
+}
diff --git a/src/Engine/HiUI.h b/src/Engine/HiUI.h
new file mode 100644
index 0000000..da9df91
--- /dev/null
+++ b/src/Engine/HiUI.h
@@ -0,0 +1,41 @@
+#pragma once
+/*
+ * G.I. Joe 4x: menus at screen resolution, in full colour.
+ *
+ * The game still lays out and draws every screen in 8 bits at its base size. Widgets this module
+ * knows (windows, text buttons, text) are drawn a second time, at the display's own resolution,
+ * into an overlay. A base pixel shows the overlay while its 8-bit value is still what it was when
+ * the last such widget finished drawing there; anything else drawn on top shows through as before.
+ */
+#include <SDL.h>
+#include <string>
+
+namespace OpenXcom
+{
+class Surface;
+class SurfaceSet;
+
+namespace HiUI
+{
+	bool enabled();
+	/// Start of a frame: the game's 8-bit buffer and the display it will be zoomed onto.
+	void beginFrame(SDL_Surface *base8, int screenW, int screenH, int left, int top, int right, int bottom);
+	/// Around every widget blit in State::blit.
+	void before(Surface *widget);
+	void after(Surface *widget);
+	/// Mouse pointer for this frame, in base coordinates; replaces the 8-bit cursor.
+	void cursor(int x, int y, bool visible);
+	/// A font sheet's sharp twin: <file>_hi.png, each cell K times the size of the 8-bit one.
+	void registerFontImage(const Surface *sheet8, const std::string &file);
+	/// A screen background's or a sprite frame's sharp twin: <file>_hi.png, any size.
+	void registerImage(const Surface *img, const std::string &file);
+	/// A sprite frame's sharp twin. The set's frames are not in their final places yet when the mod
+	/// loads, so the file is remembered here and the frame looked up the first time one is drawn.
+	void registerSetFrame(SurfaceSet *set, int frame, const std::string &file);
+	/// Draw a registered sprite's sharp twin over the base rect it has just been blitted into.
+	/// Only base pixels the sprite actually wrote are taken over, so its shape stays its own.
+	void sprite(const Surface *frame, int x, int y, int w, int h);
+	/// After the 8-bit buffer has been zoomed onto the 32-bit display.
+	void composite(SDL_Surface *base8, SDL_Surface *screen32);
+}
+}
