+}
+
+// ---- phase B: the screen at display resolution (RESEARCH_TREE_SCREEN_SPEC, the mockup) ------------
+
+namespace
+{
+const Uint32 C_GROUND = 0x14181A, C_PANEL = 0x1B2023, C_ROW = 0x232A2D, C_RAISED = 0x323A3E, C_EDGE = 0x3D464A,
+	C_OLIVE = 0x4A5640, C_YELLOW = 0xE8B923, C_BONE = 0xE9E6DC, C_MUTED = 0xB9B5A8, C_DIM = 0x5C5A52, C_DARKRED = 0x6B2A24,
+	C_RED = 0xC0392B, C_GREEN = 0x6FAE4A, C_BLUE = 0x5B8FC9, C_ORANGE = 0xD9822B, C_GREY = 0x8D897D;
+}
+
+namespace
+{
+const std::string TREE = "Resources/UI/tree/";
+/// The lane emblem for a department (the art names the Day 1 heads' lanes).
+std::string laneEmblem(const std::string &dept)
+{
+	if (dept == "COMMAND") return "lane_hawk";
+	if (dept == "INTEL") return "lane_scarlett";
+	if (dept == "MEDICAL") return "lane_doc";
+	if (dept == "COMMS") return "lane_breaker";
+	if (dept == "ARMORY") return "lane_roadblock";
+	if (dept == "MOTOR_POOL") return "lane_vehicles";
+	if (dept == "AIR_WING") return "lane_air";
+	return "";
+}
+/// The category icon for a topic: what it uses up first (a prisoner, a clue, captured gear),
+/// then its department, then a few words in its id.
+std::string topicIcon(const RuleResearch *r)
+{
+	const std::string &id = r->getName();
+	auto has = [&](const char *w) { return id.find(w) != std::string::npos; };
+	if (r->needItem() && r->getNeededItem())
+	{
+		if (r->getNeededItem()->isAlien()) return "icon_interrogation";
+		if (has("WRECK") || has("PARTS") || has("CORPSE") || has("RIFLE") || has("PISTOL") || has("GRENADE") || has("CHIP")) return "icon_cobra_tech";
+		return "icon_document";
+	}
+	const std::string &L = r->getLane();
+	if (L == "MEDICAL") return "icon_medical";
+	if (L == "COMMS") return "icon_comms";
+	if (L == "MOTOR_POOL") return "icon_vehicle";
+	if (L == "AIR_WING") return "icon_aircraft";
+	if (L == "COMMAND") return "icon_command";
+	if (L == "INTEL") return "icon_document";
+	if (has("ARMOR") || has("VEST") || has("SUIT")) return "icon_armor";
+	if (has("GRENADE") || has("EXPLOSIVE") || has("CHARGE") || has("MINE") || has("ROCKET") || has("MISSILE")) return "icon_explosive";
+	if (has("ROOM") || has("RADAR") || has("BLOCK") || has("STATION") || has("TOWER")) return "icon_facility";
+	return "icon_weapon";
+}
