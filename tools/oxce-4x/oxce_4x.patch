+void ResearchTreeState::build()
+{
+	const Mod *mod = _game->getMod();
+	SavedGame *save = _game->getSavedGame();
+	_nodes.clear();
+	_laneTypes.clear();
+	for (const auto &d : mod->getDepartments())
+		if (d.type != "TRAINING") _laneTypes.push_back(d.type);
+
+	// what this base can start now, and what it is working on
+	std::vector<RuleResearch*> avail;
+	save->getAvailableResearchProjects(avail, mod, _base);
+	std::map<const RuleResearch*, const ResearchProject*> working;
+	for (const auto *p : _base->getResearch()) working[p->getRules()] = p;
+	const RuleResearch *storyLock = mod->getResearch("STR_STORY_LOCK");
+
+	// depth = longest chain of dependencies back to a topic with none (column)
+	std::map<const RuleResearch*, int> depth;
+	std::function<int(const RuleResearch*, int)> col = [&](const RuleResearch *r, int guard) -> int
+	{
+		auto it = depth.find(r);
+		if (it != depth.end()) return it->second;
+		int d = 0;
+		if (guard < 40)
+			for (const auto *dep : r->getDependencies())
+				if (!dep->getLane().empty()) d = std::max(d, col(dep, guard + 1) + 1);
+		depth[r] = d;
+		return d;
+	};
+
+	auto behindLock = [&](const RuleResearch *r)
+	{
+		for (const auto *d : r->getDependencies()) if (d == storyLock) return true;
+		for (const auto *d : r->getRequirements()) if (d == storyLock) return true;
+		return false;
+	};
+
+	std::vector<Node> raw;
+	for (const auto &id : mod->getResearchList())
+	{
+		const RuleResearch *r = mod->getResearch(id);
+		if (!r || r->getLane().empty()) continue;
+		const int lane = (int)(std::find(_laneTypes.begin(), _laneTypes.end(), r->getLane()) - _laneTypes.begin());
+		if (lane >= (int)_laneTypes.size()) continue;
+		if (behindLock(r) && !save->isResearched(r)) continue;     // story stubs never show
+		Node n { r, lane, col(r, 0), 0, N_LOCKED, 0 };
+		if (save->isResearched(r)) n.st = N_DONE;
+		else if (working.count(r))
+		{
+			n.st = N_RESEARCHING;
+			n.pct = r->getCost() > 0 ? std::min(99, working[r]->getSpent() * 100 / r->getCost()) : 0;
+		}
+		else if (std::find(avail.begin(), avail.end(), r) != avail.end()) n.st = N_AVAILABLE;
+		else
+		{
+			// no spoilers: a locked topic shows only one step past something available or done
+			// a topic that only waits for an item (a prisoner, a clue) stays hidden until the item is home
+			bool near = r->getDependencies().empty() && !(r->needItem() && r->getNeededItem());
+			for (const auto *d : r->getDependencies())
+				if (save->isResearched(d) || working.count(d) || std::find(avail.begin(), avail.end(), d) != avail.end()) near = true;
+			if (!near) continue;
+			if (r->needItem() && r->getNeededItem() && _base->getStorageItems()->getItem(r->getNeededItem()) <= 0) n.st = N_NEEDITEM;
+		}
+		raw.push_back(n);
+	}
+
+	// rows: inside each lane, each column stacks its topics; the lane is as tall as its tallest column
+	_laneTop.assign(_laneTypes.size(), 0);
+	_laneRows.assign(_laneTypes.size(), 1);
+	_cols = 0;
+	int top = 0;
+	for (size_t L = 0; L < _laneTypes.size(); ++L)
+	{
+		std::map<int, int> used;
+		for (auto &n : raw)
+			if (n.lane == (int)L) { n.row = used[n.col]++; _cols = std::max(_cols, n.col + 1); }
+		int h = 2; // room for the department label (name, head, speed)
+		for (auto &u : used) h = std::max(h, u.second);
+		_laneTop[L] = top;
+		_laneRows[L] = h;
+		top += h;
+		for (auto &n : raw) if (n.lane == (int)L) { n.row += _laneTop[L]; _nodes.push_back(n); }
+	}
+	_rows = top;
+	if (_sel >= (int)_nodes.size()) _sel = -1;
+}
+
+void ResearchTreeState::draw()
+{
+	const Uint8 bandA = nearest(0x14181A), bandB = nearest(0x1B2023);
+	const Uint8 cDone = nearest(0x232A2D), cRes = nearest(0x2A3033), cAv = nearest(0x323A3E), cLock = nearest(0x1B2023);
+	const Uint8 eDone = nearest(0x6FAE4A), eRes = nearest(0x5B8FC9), eAv = nearest(0xE8B923), eLock = nearest(0x3D464A), eItem = nearest(0x6B2A24);
+	const Uint8 lineDone = nearest(0x4A5640), lineAv = nearest(0xE8B923), lineLock = nearest(0x3D464A), sel = nearest(0xE8B923);
+	_view->clear();
+	_lanes->clear();
+	const Mod *mod = _game->getMod();
+	SavedGame *save = _game->getSavedGame();
+
+	// lane bands, and the department label down the left: name, head, speed
+	for (size_t L = 0; L < _laneTypes.size(); ++L)
+	{
+		const int y0 = _laneTop[L] * PY - _scrollY, h = _laneRows[L] * PY;
+		_view->drawRect(0, std::max(0, y0), VW, std::max(0, std::min(VH, y0 + h) - std::max(0, y0)), (L % 2) ? bandB : bandA);
+		if (y0 + h <= 0 || y0 >= VH) continue;
+		const int head = save->getDeptHead(_laneTypes[L]);
+		const Soldier *s = save->findJoe(head);
+		std::ostringstream ss;
+		ss << tr("STR_DEPT_" + _laneTypes[L]) << "\n" << (s ? s->getName() : std::string(tr("STR_NO_HEAD")))
+			<< "\n" << (save->hasDeptRoom(mod, _laneTypes[L]) ? std::to_string(save->getDeptSpeed(mod, _laneTypes[L])) + "%" : std::string(tr("STR_DEPT_NO_ROOM")));
+		Text t(50, std::min(27, VH - std::max(0, y0)), 0, 0);
+		t.setPalette(_lanes->getPalette());
+		t.initText(mod->getFont("FONT_BIG"), mod->getFont("FONT_SMALL"), _game->getLanguage());
+		t.setSmall();
+		t.setColor(_txtName->getColor());
+		t.setText(ss.str());
+		t.setX(0); t.setY(std::max(0, y0) + 1);
+		t.blit(_lanes->getSurface());
+	}
+
+	auto cardX = [&](const Node &n) { return 2 + n.col * PX - _scrollX; };
+	auto cardY = [&](const Node &n) { return 1 + n.row * PY - _scrollY; };
+	// lines: out of the right side of a dependency, into the left side of the topic (elbow)
+	for (const auto &n : _nodes)
+	{
+		for (const auto *dep : n.r->getDependencies())
+		{
+			auto it = std::find_if(_nodes.begin(), _nodes.end(), [&](const Node &m) { return m.r == dep; });
+			if (it == _nodes.end()) continue;
+			const Uint8 c = n.st == N_DONE ? lineDone : (n.st == N_AVAILABLE || n.st == N_RESEARCHING) ? lineAv : lineLock;
+			const int x0 = cardX(*it) + CW, y0 = cardY(*it) + CH / 2, x1 = cardX(n), y1 = cardY(n) + CH / 2, xm = (x0 + x1) / 2;
+			auto hline = [&](int a, int b, int y) { if (y >= 0 && y < VH) for (int x = std::max(0, std::min(a, b)); x <= std::min(VW - 1, std::max(a, b)); ++x) _view->setPixel(x, y, c); };
+			auto vline = [&](int x, int a, int b) { if (x >= 0 && x < VW) for (int y = std::max(0, std::min(a, b)); y <= std::min(VH - 1, std::max(a, b)); ++y) _view->setPixel(x, y, c); };
+			hline(x0, xm, y0); vline(xm, y0, y1); hline(xm, x1, y1);
+		}
+	}
+	// cards
+	for (size_t i = 0; i < _nodes.size(); ++i)
+	{
+		const Node &n = _nodes[i];
+		const int x = cardX(n), y = cardY(n);
+		if (x + CW < 0 || x >= VW || y + CH < 0 || y >= VH) continue;
+		Uint8 fill = cLock, edge = eLock;
+		switch (n.st)
+		{
+		case N_DONE: fill = cDone; edge = eDone; break;
+		case N_RESEARCHING: fill = cRes; edge = eRes; break;
+		case N_AVAILABLE: fill = cAv; edge = eAv; break;
+		case N_NEEDITEM: fill = cLock; edge = eItem; break;
+		default: break;
+		}
+		if ((int)i == _sel) _view->drawRect(x - 1, y - 1, CW + 2, CH + 2, sel);
+		_view->drawRect(x, y, CW, CH, edge);
+		_view->drawRect(x + 1, y + 1, CW - 2, CH - 2, fill);
+		if (n.st == N_RESEARCHING) _view->drawRect(x + 1, y + CH - 2, (CW - 2) * n.pct / 100, 1, eRes);
+		Text t(CW - 3, CH - 2, 0, 0);
+		t.setPalette(_view->getPalette());
+		t.initText(mod->getFont("FONT_BIG"), mod->getFont("FONT_SMALL"), _game->getLanguage());
+		t.setSmall();
+		t.setWordWrap(true);
+		t.setColor(n.st == N_LOCKED || n.st == N_NEEDITEM ? edge : _txtName->getColor());
+		t.setText(n.st == N_NEEDITEM ? std::string("?") : std::string(tr(n.r->getName())));
+		t.setX(x + 2); t.setY(y + 1);
+		t.blit(_view->getSurface());
+	}
+}
+
+void ResearchTreeState::showInfo()
+{
+	_btnStart->setVisible(false);
+	if (_sel < 0 || _sel >= (int)_nodes.size())
+	{
+		_txtName->setText(tr("STR_RESEARCH_TREE_PICK"));
+		_txtInfo->setText("");
+		_txtBody->setText("");
+		return;
+	}
+	const Mod *mod = _game->getMod();
+	SavedGame *save = _game->getSavedGame();
+	const Node &n = _nodes[_sel];
+	_txtName->setText(n.st == N_NEEDITEM ? std::string("?") : std::string(tr(n.r->getName())));
+	const char *stKey[] = { "STR_TREE_DONE", "STR_TREE_RESEARCHING", "STR_TREE_AVAILABLE", "STR_TREE_LOCKED", "STR_TREE_NEEDS_ITEM" };
+	std::ostringstream info;
+	info << tr(stKey[n.st]);
+	if (n.st == N_RESEARCHING) info << " " << n.pct << "%";
+	info << "\n" << tr("STR_DEPT_" + n.r->getLane()) << " " << save->getDeptSpeed(mod, n.r->getLane()) << "%";
+	_txtInfo->setText(info.str());
+	std::ostringstream body;
+	body << tr("STR_TREE_COST").arg(n.r->getCost());
+	if (n.st != N_NEEDITEM && !n.r->getDependencies().empty())
+	{
+		body << "\n" << tr("STR_TREE_NEEDS");
+		for (const auto *d : n.r->getDependencies()) body << "\n- " << tr(d->getName());
+	}
+	if (n.r->needItem() && n.r->getNeededItem() && n.st != N_NEEDITEM)
+		body << "\n" << tr("STR_TREE_USES").arg(tr(n.r->getNeededItem()->getType()));
+	_txtBody->setText(body.str());
+	if (n.st == N_AVAILABLE) { _btnStart->setText(tr("STR_START_RESEARCH")); _btnStart->setVisible(true); }
+	if (n.st == N_RESEARCHING) { _btnStart->setText(tr("STR_ADD_SCIENTISTS")); _btnStart->setVisible(true); }
+}
+
+void ResearchTreeState::viewClick(Action *action)
+{
+	const Uint8 b = action->getDetails()->button.button;
+	if (b == SDL_BUTTON_WHEELUP || b == SDL_BUTTON_WHEELDOWN)
+	{
+		_scrollY = std::max(0, std::min(std::max(0, _rows * PY - VH), _scrollY + (b == SDL_BUTTON_WHEELUP ? -PY : PY)));
+		draw();
+		return;
+	}
+	const int mx = (int)(action->getRelativeXMouse() / action->getXScale());
+	const int my = (int)(action->getRelativeYMouse() / action->getYScale());
+	_sel = -1;
+	for (size_t i = 0; i < _nodes.size(); ++i)
+	{
+		const int x = 2 + _nodes[i].col * PX - _scrollX, y = 1 + _nodes[i].row * PY - _scrollY;
+		if (mx >= x && mx < x + CW && my >= y && my < y + CH) { _sel = (int)i; break; }
+	}
+	draw();
+	showInfo();
+}
+
+void ResearchTreeState::btnScroll(Action *action)
+{
+	if (action->getSender() == _btnLeft) _scrollX -= PX;
+	if (action->getSender() == _btnRight) _scrollX += PX;
+	if (action->getSender() == _btnUp) _scrollY -= PY * 3;
+	if (action->getSender() == _btnDown) _scrollY += PY * 3;
+	_scrollX = std::max(0, std::min(std::max(0, _cols * PX - VW + 4), _scrollX));
+	_scrollY = std::max(0, std::min(std::max(0, _rows * PY - VH), _scrollY));
+	draw();
+}
+
+void ResearchTreeState::handleKey(Action *action)
+{
+	switch (action->getDetails()->key.keysym.sym)
+	{
+	case SDLK_LEFT: _scrollX -= PX; break;
+	case SDLK_RIGHT: _scrollX += PX; break;
+	case SDLK_UP: _scrollY -= PY; break;
+	case SDLK_DOWN: _scrollY += PY; break;
+	default: return;
+	}
+	_scrollX = std::max(0, std::min(std::max(0, _cols * PX - VW + 4), _scrollX));
+	_scrollY = std::max(0, std::min(std::max(0, _rows * PY - VH), _scrollY));
+	draw();
+}
+
+void ResearchTreeState::btnStartClick(Action *)
+{
+	if (_sel < 0) return;
+	const Node &n = _nodes[_sel];
+	if (n.st == N_AVAILABLE)
+		_game->pushState(new ResearchInfoState(_base, const_cast<RuleResearch*>(n.r)));
+	else if (n.st == N_RESEARCHING)
+		for (auto *p : _base->getResearch())
+			if (p->getRules() == n.r) { _game->pushState(new ResearchInfoState(_base, p)); break; }
+}
+
+void ResearchTreeState::btnOkClick(Action *)
+{
+	_game->popState();
+}
+
+}
diff --git a/src/Basescape/ResearchTreeState.h b/src/Basescape/ResearchTreeState.h
new file mode 100644
index 0000000..27e1078
--- /dev/null
+++ b/src/Basescape/ResearchTreeState.h
@@ -0,0 +1,61 @@
+#pragma once
+/*
+ * G.I. Joe: USA Defense. The research TREE (claude/RESEARCH_TREE_SCREEN_SPEC.md, John 12 Nov 21:43:
+ * "it needs to be a visual tree not a drop down menu"). Left to right by research depth, one band
+ * per department, the department's head and speed down the left, the selected topic on the right.
+ * Phase A: the 8-bit screen (layout, states, no spoilers, scroll, START). The display-resolution
+ * painting and the pixelated picture come in phase B.
+ */
+#include "../Engine/State.h"
+#include <string>
+#include <vector>
+#include <map>
+
+namespace OpenXcom
+{
+
+class Base;
+class TextButton;
+class Window;
+class Text;
+class InteractiveSurface;
+class Surface;
+class RuleResearch;
+
+class ResearchTreeState : public State
+{
+public:
+	enum NodeState { N_DONE, N_RESEARCHING, N_AVAILABLE, N_LOCKED, N_NEEDITEM };
+	struct Node { const RuleResearch *r; int lane, col, row; NodeState st; int pct; };
+private:
+	Base *_base;
+	Window *_window;
+	Text *_txtTitle, *_txtInfo, *_txtName, *_txtBody;
+	InteractiveSurface *_view;
+	Surface *_lanes, *_info;
+	TextButton *_btnStart, *_btnOk, *_btnLeft, *_btnRight, *_btnUp, *_btnDown;
+	std::vector<Node> _nodes;
+	std::vector<std::string> _laneTypes;
+	std::vector<int> _laneTop, _laneRows; // first row and row count per lane
+	int _scrollX = 0, _scrollY = 0, _cols = 0, _rows = 0, _sel = -1;
+	void build();
+	void draw();
+	void showInfo();
+	Uint8 nearest(Uint32 rgb) const;
+	void paintHi();            // registers the display-resolution painters (phase B)
+	void paintView(double X0, double Y0, double k);
+	void paintLanes(double X0, double Y0, double k);
+	void paintInfo(double X0, double Y0, double k);
+	void paintFrame(double X0, double Y0, double k);
+	~ResearchTreeState();
+public:
+	ResearchTreeState(Base *base);
+	void init() override;
+	void viewClick(Action *action);
+	void btnStartClick(Action *action);
+	void btnOkClick(Action *action);
+	void btnScroll(Action *action);
+	void handleKey(Action *action);
+};
+
+}
