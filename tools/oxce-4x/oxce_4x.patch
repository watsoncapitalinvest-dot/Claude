+
+void AirRaidMapView::paint(double X0, double Y0, double k)
+{
+	if (!_save || !_mod) return;
+	namespace P = HiUI::Paint;
+	const int W = _save->getMapSizeX(), H = _save->getMapSizeY();
+	const double c = cell() * k, ox = X0 + 2 * k, oy = Y0 + 2 * k;
+	P::rect(X0, Y0, X0 + getWidth() * k, Y0 + getHeight() * k, 0x101418);
+	// the site from above: each column's top, in the mini-map's own colours, lighter the higher it stands
+	static std::map<int, Uint32> colourOf;
+	SurfaceSet *scang = const_cast<Mod*>(_mod)->getSurfaceSet("SCANG.DAT", false);
+	Palette *pal = _mod->getPalette("PAL_BATTLESCAPE", false);
+	auto mapColour = [&](const MapData *d) -> Uint32
+	{
+		const int idx = d->getMiniMapIndex();
+		auto it = colourOf.find(idx);
+		if (it != colourOf.end()) return it->second;
+		Uint32 rgb = d->getObjectType() == O_FLOOR ? 0x55604a : 0x8a8a8a;
+		Surface *f = (scang && pal && idx) ? scang->getFrame(idx + 35) : nullptr;
+		if (f)
+		{
+			long r = 0, g = 0, b = 0, n = 0;
+			for (int y = 0; y < f->getHeight(); ++y)
+				for (int x = 0; x < f->getWidth(); ++x)
+				{
+					const Uint8 p = f->getPixel(x, y);
+					if (!p) continue;
+					const SDL_Color *col = pal->getColors(p);
+					r += col->r; g += col->g; b += col->b; ++n;
+				}
+			if (n) rgb = ((r / n) << 16) | ((g / n) << 8) | (b / n);
+		}
+		colourOf[idx] = rgb;
+		return rgb;
+	};
+	auto lighten = [](Uint32 rgb, int pct) -> Uint32
+	{
+		int r = (rgb >> 16) & 255, g = (rgb >> 8) & 255, b = rgb & 255;
+		r = std::min(255, r + (255 - r) * pct / 100); g = std::min(255, g + (255 - g) * pct / 100); b = std::min(255, b + (255 - b) * pct / 100);
+		return (r << 16) | (g << 8) | b;
+	};
+	for (int y = 0; y < H; ++y)
+		for (int x = 0; x < W; ++x)
+		{
+			const int z = AirRaid::topLevel(_save, x, y);
+			if (z < 0) { P::rect(ox + x * c, oy + y * c, ox + (x + 1) * c, oy + (y + 1) * c, 0x0c0c0c); continue; }
+			Tile *t = _save->getTile(Position(x, y, z));
+			const MapData *d = t->getMapData(O_OBJECT) ? t->getMapData(O_OBJECT) : t->getMapData(O_FLOOR) ? t->getMapData(O_FLOOR)
+				: t->getMapData(O_WESTWALL) ? t->getMapData(O_WESTWALL) : t->getMapData(O_NORTHWALL);
+			P::rect(ox + x * c, oy + y * c, ox + (x + 1) * c + 0.5, oy + (y + 1) * c + 0.5, lighten(mapColour(d), z * 14));
+			// walls as dark rules on the tile's edge
+			for (int zz = 0; zz <= z; ++zz)
+			{
+				Tile *w = _save->getTile(Position(x, y, zz));
+				if (!w) continue;
+				if (w->getMapData(O_WESTWALL)) P::rect(ox + x * c, oy + y * c, ox + x * c + std::max(1.0, c * 0.18), oy + (y + 1) * c, 0x202020);
+				if (w->getMapData(O_NORTHWALL)) P::rect(ox + x * c, oy + y * c, ox + (x + 1) * c, oy + y * c + std::max(1.0, c * 0.18), 0x202020);
+			}
+		}
+	// the approach: the planes come in from the south edge
+	P::text("label", "APPROACH", X0, oy + H * c + 1 * k, X0 + getWidth() * k, Y0 + getHeight() * k, 3.4 * k, 1, 1, 0xd8b45a);
+	// targets
+	static const Uint32 PLANE[6] = { 0x4fc3f7, 0xffd54f, 0x81c784, 0xf06292, 0xba68c8, 0xffb74d };
+	if (_planes)
+		for (size_t i = 0; i < _planes->size(); ++i)
+		{
+			const auto &p = (*_planes)[i];
+			if (p.tx < 0) continue;
+			const double cx = ox + (p.tx + 0.5) * c, cy = oy + (p.ty + 0.5) * c, r = std::max(3.0 * k, c * 1.6);
+			P::frame(cx - r, cy - r, cx + r, cy + r, std::max(1.0, k * 0.8), PLANE[i % 6]);
+			P::text("label", std::to_string(i + 1), cx - r, cy - r - 4.5 * k, cx + r, cy - r, 3.6 * k, 1, 1, PLANE[i % 6]);
+			// its run, from the south edge
+			P::rect(cx - 0.4 * k, cy + r, cx + 0.4 * k, oy + H * c, PLANE[i % 6], (int)i == _selected ? 200 : 90);
+		}
+	// impacts
+	if (_impacts)
+		for (const auto &im : *_impacts)
+		{
+			static const Uint32 KIND[4] = { 0xc20f16, 0xff8c1a, 0xd8b45a, 0x9e9e9e };
+			const double cx = ox + (im.x + 0.5) * c, cy = oy + (im.y + 0.5) * c, r = std::max(2.5 * k, c * 1.1);
+			P::roundRect(cx - r, cy - r, cx + r, cy + r, r, KIND[im.kind], 210);
+		}
+	// the hover tile
+	int hx, hy;
+	if (_planes && tileUnderMouse(hx, hy))
+		P::frame(ox + hx * c, oy + hy * c, ox + (hx + 1) * c, oy + (hy + 1) * c, std::max(1.0, k * 0.6), 0xffffff);
+}
+
+// ---------------------------------------------------------------------------------------------------------- the state
+
+AirRaidState::AirRaidState(Craft *craft, AlienBase *base, Texture *missionTexture, Texture *globeTexture, int shade) : _base(base)
+{
+	_screen = true;
+	const Mod *mod = _game->getMod();
+	const auto &R = mod->getAirRaidRules();
+	_siteType = base->getSiteType();
+
+	_window = new Window(this, 320, 200, 0, 0, POPUP_NONE);
+	_txtTitle = new Text(310, 14, 5, 4);
+	_map = new AirRaidMapView(188, 176, 4, 20);
+	_txtInfo = new Text(118, 60, 196, 20);
+	_txtResult = new Text(118, 120, 196, 20);
+	_btnFly = new TextButton(56, 16, 196, 180);
+	_btnCancel = new TextButton(56, 16, 258, 180);
+	setInterface("confirmLanding");
+	add(_window, "window", "confirmLanding");
+	add(_txtTitle, "text", "confirmLanding");
+	add(_map);
+	add(_txtInfo, "text", "confirmLanding");
+	add(_txtResult, "text", "confirmLanding");
+	add(_btnFly, "button", "confirmLanding");
+	add(_btnCancel, "button", "confirmLanding");
+
+	// the planes: every bomber that has reached this site
+	for (auto *b : *_game->getSavedGame()->getBases())
+		for (auto *c : *b->getCrafts())
+		{
+			if (!AirRaid::canBomb(mod, c)) continue;
+			// every bomber already over the site, and every one of the lead's squadron on its wing (they fly as one)
+			const bool here = c->getDestination() == base && c->getDistance(base) <= 0.002;
+			const bool onWing = c->getDestination() == (Target*)craft && c->getStatus() == "STR_OUT";
+			if (c != craft && !here && !onWing) continue;
+			if ((int)_planes.size() >= 6) break;
+			AirRaid::Plane p;
+			p.craft = c;
+			const auto &br = R.bombers.at(c->getRules()->getType());
+			p.bombs = br.bombs;
+			p.heavy = br.heavy;
+			auto pilots = c->getPilotList(false, mod);
+			if (!pilots.empty()) p.pilotId = pilots.front()->getId();
+			_planes.push_back(p);
+		}
+	for (size_t i = 0; i < _planes.size(); ++i)
+	{
+		auto *b = new TextButton(118, 14, 196, 84 + (int)i * 15);
+		add(b, "button", "confirmLanding");
+		b->onMouseClick((ActionHandler)&AirRaidState::btnPlaneClick);
+		_btnPlanes.push_back(b);
+	}
+	centerAllSurfaces();
+	setWindowBackground(_window, "confirmLanding");
+
+	// the site's battle map, its garrison on it, no Joes on the ground
+	SavedBattleGame *bgame = new SavedBattleGame(_game->getMod(), _game->getLanguage());
+	_game->getSavedGame()->setBattleGame(bgame);
+	bgame->setMissionType(base->getDeployment()->getType());
+	BattlescapeGenerator bgen(_game);
+	bgen.setWorldTexture(0, globeTexture);
+	(void)missionTexture;
+	bgen.setWorldShade(shade);
+	bgen.setAlienBase(base);
+	bgen.setAlienRace(base->getAlienRace());
+	if (AlienRace *race = _game->getMod()->getAlienRace(base->getAlienRace()))
+		bgen.setAlienCustomDeploy(_game->getMod()->getDeployment(race->getBaseCustomDeploy()), _game->getMod()->getDeployment(race->getBaseCustomMission()));
+	bgen.setAirRaid(true);
+	// phase 2: from the first raid on, every battle here builds this same map, with the wreck laid back on it
+	if (!base->getMapSeed())
+		base->setMapSeed(((uint64_t)RNG::generate(1, 0x7fffffff) << 31) ^ (uint64_t)RNG::generate(1, 0x7fffffff));
+	bgen.run();
+	base->setInBattlescape(false);
+	Tile::destroyedLog.clear();
+
+	_map->setup(mod, bgame, &_planes, &_impacts);
+	_map->onMouseClick((ActionHandler)&AirRaidState::mapClick);
+
+	_txtTitle->setBig();
+	_txtTitle->setAlign(ALIGN_CENTER);
+	_txtTitle->setText(tr("STR_AR_TITLE").arg(base->getName(_game->getLanguage())));
+	_txtInfo->setWordWrap(true);
+	_txtResult->setWordWrap(true);
+	_txtResult->setVisible(false);
+	_btnFly->setText(tr("STR_AR_FLY"));
+	_btnFly->onMouseClick((ActionHandler)&AirRaidState::btnFlyClick);
+	_btnCancel->setText(tr("STR_AR_CANCEL"));
+	_btnCancel->onMouseClick((ActionHandler)&AirRaidState::btnCancelClick);
+	_btnCancel->onKeyboardPress((ActionHandler)&AirRaidState::btnCancelClick, Options::keyCancel);
+	refresh();
+}
+
+AirRaidState::AirRaidState(Base *outpost, int planes) : _outpost(outpost), _defend(true)
+{
+	_screen = true;
+	const Mod *mod = _game->getMod();
+	const auto &R = mod->getAirRaidRules();
+
+	_window = new Window(this, 320, 200, 0, 0, POPUP_NONE);
+	_txtTitle = new Text(310, 14, 5, 4);
+	_map = new AirRaidMapView(188, 176, 4, 20);
+	_txtInfo = new Text(118, 40, 196, 20);
+	_txtResult = new Text(118, 150, 196, 20);
+	_btnFly = new TextButton(56, 16, 196, 180);
+	_btnCancel = new TextButton(56, 16, 258, 180);
+	setInterface("confirmLanding");
+	add(_window, "window", "confirmLanding");
+	add(_txtTitle, "text", "confirmLanding");
+	add(_map);
+	add(_txtInfo, "text", "confirmLanding");
+	add(_txtResult, "text", "confirmLanding");
+	add(_btnFly, "button", "confirmLanding");
+	add(_btnCancel, "button", "confirmLanding");
+
+	// the outpost's battle map, nobody on it (phase 3 does not hurt people yet)
+	SavedBattleGame *bgame = new SavedBattleGame(_game->getMod(), _game->getLanguage());
+	_game->getSavedGame()->setBattleGame(bgame);
+	bgame->setMissionType("STR_BASE_DEFENSE");
+	BattlescapeGenerator bgen(_game);
+	bgen.setBase(outpost);
+	bgen.setAlienRace("STR_COBRA");
+	bgen.setAirRaid(true);
+	bgen.setAirRaidEmpty(true);
+	bgen.run();
+	outpost->setInBattlescape(false);
+	Tile::destroyedLog.clear();
+	const int W = bgame->getMapSizeX(), H = bgame->getMapSizeY();
+
+	// Cobra's plan, in secret: a speed each, and a module each - the guns first, then the rest (s.6)
+	std::vector<BaseFacility*> guns, rest;
+	for (auto *f : *outpost->getFacilities())
+	{
+		if (f->getBuildTime() > 0 || f->getRules()->isLift()) continue;
+		(R.facilityGuns.count(f->getRules()->getType()) ? guns : rest).push_back(f);
+	}
+	std::vector<std::pair<int, int> > aims;
+	for (int y = 0; y < H; ++y)
+		for (int x = 0; x < W; ++x)
+			if (AirRaid::structure(bgame, x, y)) aims.push_back({ x, y });
+	for (int i = 0; i < planes; ++i)
+	{
+		AirRaid::Plane p;
+		const int r = RNG::generate(0, 99);
+		p.speed = r < 20 ? 0 : r < 60 ? 1 : 2;
+		p.bombs = 2;
+		std::vector<BaseFacility*> &pool = !guns.empty() ? guns : rest;
+		BaseFacility *target = pool.empty() ? nullptr : pool[RNG::generate(0, (int)pool.size() - 1)];
+		if (target && !guns.empty()) guns.erase(std::find(guns.begin(), guns.end(), target));
+		_planeTargets.push_back(target);
+		auto a = aims.empty() ? std::make_pair(W / 2, H / 2) : aims[RNG::generate(0, (int)aims.size() - 1)];
+		p.tx = a.first; p.ty = a.second;
+		_planes.push_back(p);
+	}
+	// the outpost's guns, a row per shot: left-click picks the plane, right-click the lead
+	int k = 0;
+	for (auto *f : *outpost->getFacilities())
+	{
+		if (f->getBuildTime() > 0) continue;
+		auto fg = R.facilityGuns.find(f->getRules()->getType());
+		if (fg == R.facilityGuns.end()) continue;
+		auto g = R.guns.find(fg->second);
+		if (g == R.guns.end()) continue;
+		for (int s = 0; s < g->second.shots && _shots.size() < 10; ++s, ++k)
+		{
+			Shot sh; sh.gun = fg->second; sh.plane = k % std::max(1, planes); sh.lead = 1;
+			_shots.push_back(sh);
+		}
+	}
+	for (size_t i = 0; i < _shots.size(); ++i)
+	{
+		auto *b = new TextButton(118, 12, 196, 62 + (int)i * 11);
+		add(b, "button", "confirmLanding");
+		b->onMouseClick((ActionHandler)&AirRaidState::btnShotClick, SDL_BUTTON_LEFT);
+		b->onMouseClick((ActionHandler)&AirRaidState::btnShotRightClick, SDL_BUTTON_RIGHT);
+		_btnShots.push_back(b);
+	}
+	centerAllSurfaces();
+	setWindowBackground(_window, "confirmLanding");
+
+	// planes are listed only once the pass is flown
+	_map->setup(mod, bgame, nullptr, &_impacts);
+	_txtTitle->setBig();
+	_txtTitle->setAlign(ALIGN_CENTER);
+	_txtTitle->setText(tr("STR_AR_DEFEND_TITLE").arg(outpost->getName(_game->getLanguage())));
+	_txtInfo->setWordWrap(true);
+	_txtResult->setWordWrap(true);
+	_txtResult->setVisible(false);
+	_btnFly->onMouseClick((ActionHandler)&AirRaidState::btnFlyClick);
+	_btnFly->onKeyboardPress((ActionHandler)&AirRaidState::btnFlyClick, Options::keyOk);
+	_btnCancel->setVisible(false);
+	refresh();
+}
