+ * the map is installed. Without MAPS/<map>.MAP2 (the map is private, zip only) the old room-by-room map stays.
+ */
+bool BattlescapeGenerator::isPitBattle() const
+{
+	if (!_base || _save->getMissionType() != "STR_BASE_DEFENSE") return false;
+	const auto &pb = _game->getMod()->getPitBattleRules();
+	if (!_game->getMod()->getPitFloorRules().on || pb.deployment.empty() || pb.map.empty()) return false;
+	const auto *k = Outposts::kindOf(_game->getMod(), _base);
+	if (k && !k->pit) return false;
+	return FileMap::fileExists("MAPS/" + pb.map + ".MAP2") && _game->getMod()->getDeployment(pb.deployment, false);
+}
+
+/**
+ * G.I. Joe (PIT_MODULES_v1, pit_canon_v4): every slot group's slots are claimed in order, one per built facility of
+ * the group. A claimed slot gets that facility's fit-out from MAPS' showcase map (the library, "S:"); a slot nobody
+ * has built gets a bare slot from the Day 1 map itself ("D:", read before anything is written). A fit-out taken from
+ * a DIFFERENT slot brings only its floors and objects, since that slot's walls are not this one's.
+ */
+bool BattlescapeGenerator::isPitSurface() const
+{
+	const auto &SB = _game->getMod()->getPitSurfaceBattleRules();
+	return isPitBattle() && !SB.deployment.empty() && _alienCustomMission && _alienCustomMission->getType() == SB.deployment;
+}
+
+void BattlescapeGenerator::applyPitSurface()
+{
+	const auto &SB = _game->getMod()->getPitSurfaceBattleRules();
+	const auto &spots = _game->getMod()->getPitSurfaceRules().spots;
+	if (SB.library.empty() || !FileMap::fileExists("MAPS/" + SB.library + ".MAP2")) return;
+	auto f = FileMap::getIStream("MAPS/" + SB.library + ".MAP2");
+	unsigned char h[3];
+	f->read((char*)h, 3);
+	const int ly = h[0], lx = h[1], lz = h[2];
+	std::vector<unsigned int> lib;
+	unsigned char v[2];
+	while (f->read((char*)v, 2)) lib.push_back((unsigned int)v[0] | ((unsigned int)v[1] << 8));
+	if (lib.size() != (size_t)lx * ly * lz * 4) { Log(LOG_ERROR) << "[pit] " << SB.library << " is the wrong size"; return; }
+	for (const auto *fac : *_base->getFacilities())
+	{
+		if (!PitPlace::isSurface(fac) || fac->getBuildTime() > 0) continue;
+		const int i = fac->getPitX() - PitPlace::SURFACE_BASE;
+		if (i < 0 || i >= (int)spots.size()) continue;
+		auto cells = SB.spots.find(spots[i].id);
+		if (cells == SB.spots.end()) continue;
+		for (const auto &c : cells->second)
+		{
+			if (c.size() < 2 || c[0] >= lx || c[1] >= ly) continue;
+			for (int z = 0; z < lz && z < _mapsize_z; ++z)
+			{
+				Tile *t = _save->getTile(Position(c[0], c[1], z));
+				if (!t) continue;
+				const size_t at = (((size_t)(lz - 1 - z) * ly + c[1]) * lx + c[0]) * 4;
+				for (int k = 0; k < O_MAX; ++k)
+				{
+					unsigned int id = lib[at + k];
+					int set = 0;
+					MapData *md = id ? _terrain->getMapData(&id, &set) : nullptr;
+					t->setMapData(md, md ? (int)id : -1, md ? set : -1, (TilePart)k);
+				}
+			}
+		}
+		Log(LOG_INFO) << "[pit] surface: " << fac->getRules()->getType() << " opens at " << spots[i].id;
+	}
+}
+
+void BattlescapeGenerator::applyPitModules()
+{
+	const auto &pb = _game->getMod()->getPitBattleRules();
+	// the library map, read straight from its file (same terrain sets, same size as the canon map)
+	int lx = 0, ly = 0, lz = 0;
+	std::vector<unsigned int> lib;
+	if (!pb.library.empty() && FileMap::fileExists("MAPS/" + pb.library + ".MAP2"))
+	{
+		auto f = FileMap::getIStream("MAPS/" + pb.library + ".MAP2");
+		unsigned char h[3];
+		f->read((char*)h, 3);
+		ly = h[0]; lx = h[1]; lz = h[2];
+		unsigned char v[2];
+		while (f->read((char*)v, 2)) lib.push_back((unsigned int)v[0] | ((unsigned int)v[1] << 8));
+		if (lib.size() != (size_t)lx * ly * lz * 4) { Log(LOG_ERROR) << "[pit] library " << pb.library << " is the wrong size"; lib.clear(); }
+	}
+	typedef std::array<std::pair<int,int>, O_MAX> Parts;
+	auto fromMap = [&](int x, int y, int z) {
+		Parts parts;
+		Tile *t = _save->getTile(Position(x, y, z));
+		for (int k = 0; k < O_MAX; ++k)
+		{
+			int id = -1, set = -1;
+			if (t) t->getMapData(&id, &set, (TilePart)k);
+			parts[k] = std::make_pair(id, set);
+		}
+		return parts;
+	};
+	auto fromLib = [&](int x, int y, int z) {
+		Parts parts;
+		for (int k = 0; k < O_MAX; ++k) parts[k] = std::make_pair(-1, -1);
+		if (lib.empty() || x < 0 || y < 0 || z < 0 || x >= lx || y >= ly || z >= lz) return parts;
+		const size_t i = (((size_t)(lz - 1 - z) * ly + y) * lx + x) * 4;
+		for (int k = 0; k < O_MAX; ++k)
+		{
+			unsigned int id = lib[i + k];
+			if (!id) continue;
+			int set = 0;
+			MapData *md = _terrain->getMapData(&id, &set);
+			if (md) parts[k] = std::make_pair((int)id, set);
+		}
+		return parts;
+	};
+	// G.I. Joe FREE PLACEMENT (PIT_FLOORS_v1 s.1 v2): the old slots' furniture is cleared, then every finished room
+	// placed on a blueprint gets its module's fit-out (floor and objects, never walls) on the tiles it was dropped on
+	const auto &PP = _game->getMod()->getPitPlaceRules();
+	if (PitPlace::on(_game->getMod(), _base))
+	{
+		for (const auto &c : PP.clear)
+		{
+			if (c.size() < 5) continue;
+			for (int y = c[2]; y < c[2] + c[4]; ++y)
+				for (int x = c[1]; x < c[1] + c[3]; ++x)
+					if (Tile *t = _save->getTile(Position(x, y, c[0]))) t->setMapData(nullptr, -1, -1, O_OBJECT);
+		}
+		for (const auto *f : *_base->getFacilities())
+		{
+			if (!f->isPitPlaced() || f->getBuildTime() > 0) continue;
+			const std::string &type = f->getRules()->getType();
+			const auto *m = PP.module(type);
+			auto fl = PP.floors.find(PitPlace::floorOf(_game->getMod(), type));
+			if (!m || fl == PP.floors.end()) continue;
+			const bool turned = f->getPitTurned() && m->tx >= 0;
+			const int sx = turned ? m->tx : m->lx, sy = turned ? m->ty : m->ly, sz = turned ? m->tz : m->lz;
+			if (sx < 0 || lib.empty()) continue;
+			int w, h;
+			PitPlace::footprint(_game->getMod(), type, turned, w, h);
+			for (int y = 0; y < h; ++y)
+				for (int x = 0; x < w; ++x)
+				{
+					Tile *t = _save->getTile(Position(f->getPitX() + x, f->getPitY() + y, fl->second.z));
+					if (!t) continue;
+					const Parts p = fromLib(sx + x, sy + y, sz);
+					for (int k : { (int)O_FLOOR, (int)O_OBJECT })
+					{
+						const auto &pr = p[k];
+						if (k == O_FLOOR && pr.first < 0) continue;   // keep the room's own floor where the module has none
+						MapData *md = pr.first >= 0 && pr.second >= 0 ? _save->getMapDataSets()->at(pr.second)->getObject(pr.first) : nullptr;
+						t->setMapData(md, md ? pr.first : -1, md ? pr.second : -1, (TilePart)k);
+					}
+				}
+			Log(LOG_INFO) << "[pit] " << type << " at " << f->getPitX() << "," << f->getPitY() << (turned ? " turned" : "") << " from the library";
+		}
+		return;
+	}
+	// a bare slot's look is read from this map before any slot is written
+	std::map<std::string, std::vector<Parts>> dsnap;
+	for (const auto &g : pb.groups)
+		for (const auto &kv : g.from)
+			if (kv.second.compare(0, 2, "D:") == 0 && !dsnap.count(kv.second))
+				if (const Mod::PitSlot *s = pb.slot(kv.second.substr(2)))
+				{
+					auto &v = dsnap[kv.second];
+					for (int y = 0; y < s->h; ++y) for (int x = 0; x < s->w; ++x) v.push_back(fromMap(s->x + x, s->y + y, s->z));
+				}
+	for (const auto &g : pb.groups)
+	{
+		std::vector<std::string> fill;
+		for (const auto &type : g.facilities)
+			for (const auto *f : *_base->getFacilities())
+				if (f->getRules()->getType() == type && f->getBuildTime() == 0) fill.push_back(type);
+		for (size_t i = 0; i < g.slots.size(); ++i)
+		{
+			const Mod::PitSlot *s = pb.slot(g.slots[i]);
+			if (!s) continue;
+			const std::string fac = i < fill.size() ? fill[i] : std::string();
+			auto it = g.from.find(fac + "|" + s->id);
+			if (it == g.from.end()) it = g.from.find("|" + s->id);
+			if (it == g.from.end()) continue;
+			const bool library = it->second.compare(0, 2, "S:") == 0;
+			const Mod::PitSlot *src = pb.slot(it->second.substr(2));
+			if (!src || src->w != s->w || src->h != s->h) continue;
+			if (library && lib.empty()) continue;
+			const bool full = src->id == s->id;
+			size_t n = 0;
+			for (int y = 0; y < s->h; ++y)
+				for (int x = 0; x < s->w; ++x, ++n)
+				{
+					Tile *t = _save->getTile(Position(s->x + x, s->y + y, s->z));
+					if (!t) continue;
+					const Parts p = library ? fromLib(src->x + x, src->y + y, src->z) : dsnap[it->second][n];
+					for (int k = 0; k < O_MAX; ++k)
+					{
+						if (!full && (k == O_WESTWALL || k == O_NORTHWALL)) continue;
+						const auto &pr = p[k];
+						MapData *md = pr.first >= 0 && pr.second >= 0 ? _save->getMapDataSets()->at(pr.second)->getObject(pr.first) : nullptr;
+						t->setMapData(md, md ? pr.first : -1, md ? pr.second : -1, (TilePart)k);
+					}
+				}
+			Log(LOG_INFO) << "[pit] slot " << s->id << ": " << (fac.empty() ? std::string("bare") : fac) << " from " << it->second;
+		}
+	}
+}
