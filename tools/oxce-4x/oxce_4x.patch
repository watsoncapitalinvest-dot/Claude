+	const Mod *mod = _save->getBattleGame()->getMod();
+	const std::string terrain = obj->getDataset()->getName();
+	int part = -1, setId = -1;
+	tile->getMapData(&part, &setId, O_OBJECT);
+	if (part < 0 || !mod->isGijoeContainer(terrain, part)) return -1;
+	const int TUCost = 8;
+	if (!_save->getBattleGame()->checkReservedTU(unit, TUCost, 0)) return 5;
+	if (!unit->spendTimeUnits(TUCost)) return 4;
+	MapData *open = obj->getDataset()->getObject(obj->getAltMCD());
+	tile->setMapData(open, obj->getAltMCD(), setId, O_OBJECT);
+	int found = 0;
+	if (const auto *spots = mod->getGijoeContainers(_save->getMissionType()))
+		for (const auto &sp : *spots)
+		{
+			if (sp.size() < 4) continue;
+			const Position at(std::atoi(sp[0].c_str()), std::atoi(sp[1].c_str()), std::atoi(sp[2].c_str()));
+			if (at != tile->getPosition()) continue;
+			for (size_t k = 3; k < sp.size(); ++k)
+				if (const RuleItem *ri = mod->getItem(sp[k]))
+				{
+					_save->createItemForTile(ri, tile);
+					++found;
+				}
+		}
+	_save->setVanStop("clue:opened", _save->getVanStop("clue:opened") + 1);
+	if (found) _save->setVanStop("clue:found", _save->getVanStop("clue:found") + found);
+	Log(LOG_INFO) << "[clue] " << terrain << " part " << part << " opened at " << tile->getPosition() << ": " << found << " item(s)";
