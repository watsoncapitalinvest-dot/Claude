+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public License
+ * along with OpenXcom.  If not, see <http://www.gnu.org/licenses/>.
+ */
+#include <string>
+#include "../Engine/Yaml.h"
+
+namespace OpenXcom
+{
+
+class Mod;
+
+/**
+ * What one kind of Cobra site is worth, as data.
+ *
+ * Eight site types were chosen by what raiding each one changes rather than by flavour, and a
+ * site earns its place by that column alone. This rule carries only numbers and names; what
+ * happens with them is the monthly tick's job.
+ *
+ * Four of the eight act on the world rather than produce - a Terror Drome raises the mission
+ * rate, a broadcast station erodes goodwill, a lab advances a project, a camp hardens its region.
+ * Only two of those need a field here. The Terror Drome needs none at all, because the economy
+ * publishes a per-region count of every site type into the counter map that the mission scripts
+ * already gate on, so "more dromes means more missions" is a ruleset condition rather than code
+ * that knows what a Terror Drome is. Any site type added later gets the same for free.
+ *
+ * There is deliberately no deployment field here. A site learns what it is from the
+ * AlienDeployment that spawned it (cobraSiteType), so naming the deployment again on this
+ * side would be a second copy of the same link, free to disagree with the first.
+ */
+class RuleCobraSite
+{
+private:
+	std::string _type;
+	int _fundsPerMonth, _materielPerMonth;
+	int _upkeepFunds, _upkeepMateriel;
+	int _buildCostFunds;
+	int _lootFunds, _lootMateriel;
+	bool _lootsRegionalStockpile;      ///< the depot: raiding it takes what the region was holding
+	int _projectProgressPerMonth;      ///< progress per lab per month at this site
+	int _labSlots;                     ///< how many departments may be worked on here at once
+	int _goodwillErosionPerMonth;      ///< the broadcast station
+	/// The training camp. X-COM stores no garrison on a site - the defenders are generated
+	/// fresh from the deployment every time it is raided - so there is nothing to refill and
+	/// the field that used to be here pointed at nothing. A camp instead changes what the
+	/// deployment produces in its own region: more of them, and better ones.
+	int _garrisonBonus;                ///< extra defenders per rank entry, per camp in region
+	int _garrisonRankUnlock;           ///< ranks BELOW this (the elites) appear only where a
+	                                   ///< camp stands; -1 leaves ranks alone
+	bool _garrisonAllMissions;         ///< false: Cobra sites only. true: every Cobra battle there
+	/// Where the planning happens. While Cobra owns one of these, cobraPlan() decides what it
+	/// builds - pay upkeep first, diversify, replace what was destroyed. With none standing,
+	/// Cobra falls back to buying whatever it can afford, which is what it did before there
+	/// was a planner at all.
+	bool _runsThePlanning;
+	/// Whether this site's income rides on a cargo flight. With it on, the site sends a
+	/// shipment and earns nothing in any month where one of its shipments was shot down -
+	/// which is the whole point: the money stops being a number on a screen and starts
+	/// being something crossing the globe that you can go and meet.
+	bool _incomeNeedsShipment;
+	int _materielCostFunds;            ///< funds spent to make its materielPerMonth; 0 = free
+	int _stockpileCap;                 ///< what this site lets the region hold; 0 means no limit of its own
+	int _revealOnRaid;                 ///< how many unknown projects raiding this reveals
+
+public:
+	RuleCobraSite(const std::string& type);
+	~RuleCobraSite() = default;
+
+	void load(const YAML::YamlNodeReader& reader, Mod* mod);
+
+	const std::string& getType() const { return _type; }
+	int getFundsPerMonth() const { return _fundsPerMonth; }
+	int getMaterielPerMonth() const { return _materielPerMonth; }
+	int getUpkeepFunds() const { return _upkeepFunds; }
+	/// Funds this site spends to produce its materiel. 0 means production is free.
+	int getMaterielCostFunds() const { return _materielCostFunds; }
+	int getUpkeepMateriel() const { return _upkeepMateriel; }
+	int getBuildCostFunds() const { return _buildCostFunds; }
+	int getLootFunds() const { return _lootFunds; }
+	int getLootMateriel() const { return _lootMateriel; }
+	bool getLootsRegionalStockpile() const { return _lootsRegionalStockpile; }
+	int getProjectProgressPerMonth() const { return _projectProgressPerMonth; }
+	/// How many departments may be worked on here at once. A globe lab hosts one; a Terror
+	/// Drome hosts several. 0 means this site cannot host research at all.
+	int getLabSlots() const { return _labSlots; }
+	int getGoodwillErosionPerMonth() const { return _goodwillErosionPerMonth; }
+	int getGarrisonBonus() const { return _garrisonBonus; }
+	int getGarrisonRankUnlock() const { return _garrisonRankUnlock; }
+	bool getGarrisonAllMissions() const { return _garrisonAllMissions; }
+	bool getRunsThePlanning() const { return _runsThePlanning; }
+	bool getIncomeNeedsShipment() const { return _incomeNeedsShipment; }
+	int getStockpileCap() const { return _stockpileCap; }
+	int getRevealOnRaid() const { return _revealOnRaid; }
+};
+
+}
