+#pragma once
+/*
+ * G.I. Joe: a Joe craft has reached a merchant ship (SEA_BATTLES_DESIGN_v1 sections 7 and 12f).
+ * STOP AND SEARCH (needs someone aboard to board), OPEN FIRE (a sea fight), or LET IT GO.
+ */
+#include <string>
+#include "../Engine/State.h"
+
+namespace OpenXcom
+{
+
+class TextButton;
+class Window;
+class Text;
+class GeoscapeState;
+
+class ShipStopState : public State
+{
+private:
+	GeoscapeState *_state;
+	TextButton *_btnSearch, *_btnFire, *_btnGo;
+	Window *_window;
+	Text *_txtTitle, *_txtBody;
+public:
+	ShipStopState(GeoscapeState *state, const std::string &title, const std::string &body, bool canSearch, bool canFire, const std::string &searchLabel = "STR_SHIP_STOP_SEARCH");
