+bool onShot(BattlescapeGame *game, BattleAction &action)
+{
+	SavedBattleGame *save = game->getSave();
+	const auto &R = save->getMod()->getArtilleryRules();
+	if (R.radio.empty() || !action.weapon || action.weapon->getRules()->getType() != R.radio || !action.actor) return false;
+	const int kind = action.type == BA_AIMEDSHOT ? 1 : action.type == BA_AUTOSHOT ? 2 : 0;
+	Tile *t = save->getTile(action.target);
+	if (!t) return true;
+	if (action.actor->getFaction() == FACTION_PLAYER && !t->getVisible())
+	{
+		action.result = "STR_ARTY_NOT_SEEN";
+		return true;
+	}
+	std::string why;
+	const int gun = gunInRange(save, action.actor->getFaction(), why);
+	if (gun < 0)
+	{
+		action.result = why;
+		return true;
+	}
+	// DANGER CLOSE (John 17 Nov 18:30): a Joe inside the zone the shells can reach (scatter + blast) gets a warning
+	// first; calling again on the same spot this turn confirms. A refused call costs nothing.
+	if (action.actor->getFaction() == FACTION_PLAYER)
+	{
+		const int zone = (specialist(save, action.actor) ? R.specialistScatter : R.scatter) + R.dangerBlast;
+		bool close = false;
+		for (auto *u : *save->getUnits())
+			if (u->getFaction() == FACTION_PLAYER && !u->isOut() && Position::distance2d(u->getPosition(), action.target) <= zone) close = true;
+		const int key = enc(action.target);
+		static Uint32 warnedAt = 0;   // a double-click is not a confirmation: the second call must come half a second later
+		const bool confirmed = save->getVanStop("artConfirmTile") == key && save->getVanStop("artConfirmTurn") == save->getTurn()
+			&& SDL_GetTicks() - warnedAt > 500;
+		if (close && !confirmed)
+		{
+			save->setVanStop("artConfirmTile", key);
+			save->setVanStop("artConfirmTurn", save->getTurn());
+			warnedAt = SDL_GetTicks();
+			Log(LOG_INFO) << "[artillery] danger close at " << action.target << " (zone " << zone << " tiles): waiting for the second call";
+			action.result = "STR_ARTY_DANGER_CLOSE";
+			return true;
+		}
+		save->setVanStop("artConfirmTile", 0);
+	}
+	const std::string msg = call(save, action.actor, action.target, kind, gun);
+	action.result = msg;
+	return true;
+}
+
+void turnStart(BattlescapeGame *game)
+{
+	SavedBattleGame *save = game->getSave();
+	const auto &R = save->getMod()->getArtilleryRules();
+	if (getenv("OXCE_ARTY_TEST") && atoi(getenv("OXCE_ARTY_TEST")) == 3 && save->getSide() == FACTION_PLAYER && save->getTurn() >= 2 && save->getTurn() <= 4)
+	{
+		BattleUnit *joe = nullptr, *cobra = nullptr;
+		for (auto *u : *save->getUnits()) if (!joe && u->getFaction() == FACTION_PLAYER && !u->isOut()) joe = u;
+		int best = 1 << 30;
+		for (auto *u : *save->getUnits())
+			if (joe && u->getFaction() == FACTION_HOSTILE && !u->isOut())
+			{ int d = Position::distance2d(u->getPosition(), joe->getPosition()); if (d > 8 && d < best) { best = d; cobra = u; } }
+		std::string why;
+		const int gun = gunInRange(save, FACTION_PLAYER, why);
+		if (joe && cobra && gun >= 0) call(save, joe, cobra->getPosition(), (save->getTurn() - 2) % 3, gun);
+		else Log(LOG_INFO) << "[artillery] test 3: no call (" << why << ")";
+	}
+	if (getenv("OXCE_ARTY_TEST"))
+	{
+		int sm = 0, fi = 0, hurt = 0;
+		for (int i = 0; i < save->getMapSizeXYZ(); ++i) { Tile *t = save->getTile(i); if (t->getSmoke()) ++sm; if (t->getFire()) ++fi; }
+		for (auto *u : *save->getUnits()) if (u->getHealth() < u->getBaseStats()->health || u->isOut()) ++hurt;
+		Log(LOG_INFO) << "[artillery] turn " << save->getTurn() << ": " << sm << " tiles of smoke, " << fi << " burning, " << hurt << " units hurt or down";
+	}
+	const int n = save->getVanStop("artN");
+	bool landed = false;
+	for (int i = 0; i < n; ++i)
+	{
+		const int turn = save->getVanStop(K("artTurn", i));
+		if (!turn) continue;
+		const UnitFaction side = (UnitFaction)(save->getVanStop(K("artSide", i)) - 1);
+		if (side != save->getSide() || save->getTurn() <= turn) continue;
+		save->setVanStop(K("artTurn", i), 0);
+		const Position aim = dec(save->getVanStop(K("artTile", i)));
+		const int kind = save->getVanStop(K("artKind", i)), scatter = save->getVanStop(K("artScatter", i));
+		const auto &gun = R.guns[save->getVanStop(K("artGun", i))];
+		const std::string itemType = kind == 1 ? R.roundSmoke : kind == 2 ? R.roundIncendiary : R.roundHE;
+		const RuleItem *round = save->getMod()->getItem(itemType, false);
+		if (!round) { Log(LOG_ERROR) << "[artillery] no round item " << itemType; continue; }
+		BattleUnit *caller = nullptr;
+		for (auto *u : *save->getUnits()) if (u->getId() + 1 == save->getVanStop(K("artCaller", i))) caller = u;
+		std::string where;
+		for (int s = 0; s < R.shells; ++s)
+		{
+			// scatter: a random point in the circle of radius 'scatter' round the aim point
+			const double a = RNG::generate(0.0, 2 * 3.14159265358979), r = scatter * std::sqrt(RNG::generate(0.0, 1.0));
+			const int x = std::max(0, std::min(save->getMapSizeX() - 1, aim.x + (int)std::lround(r * std::cos(a))));
+			const int y = std::max(0, std::min(save->getMapSizeY() - 1, aim.y + (int)std::lround(r * std::sin(a))));
+			const Position hit = impact(save, x, y);
+			Tile *ht = save->getTile(hit);
+			BattleActionAttack atk;
+			atk.type = BA_NONE;
+			atk.attacker = caller && !caller->isOut() ? caller : nullptr;
+			atk.damage_item = save->createTempItem(round);
+			atk.weapon_item = atk.damage_item;
+			const Position voxel = hit.toVoxel() + Position(8, 8, ht ? -ht->getTerrainLevel() + 2 : 2);
+			game->statePushNext(new ExplosionBState(game, voxel, atk));
+			where += " " + std::to_string(hit.x) + "," + std::to_string(hit.y) + "," + std::to_string(hit.z);
+			if (getenv("OXCE_ARTY_TEST"))   // rig: who stands inside this shell's blast
+				for (auto *v : *save->getUnits())
+					if (!v->isOut() && Position::distance2d(v->getPosition(), hit) <= round->getExplosionRadius(atk))
+						Log(LOG_INFO) << "[artillery]   in the blast at " << hit << ": " << v->getType() << " (faction " << (int)v->getFaction() << ", " << Position::distance2d(v->getPosition(), hit) << " tiles)";
+		}
+		Log(LOG_INFO) << "[artillery] " << gun.label << " " << KINDS[kind] << " lands round " << aim << ":" << where;
+		// the first impact raises the alarm
+		Stealth::noise(save, aim, 30, nullptr, true);
+		Stealth::tryAlarm(save, "artillery");
+		landed = true;
+	}
+	if (landed) game->statePushBack(0);
+}
+
+bool aiCall(BattlescapeGame *game, BattleUnit *u, BattleAction *action)
+{
+	SavedBattleGame *save = game->getSave();
+	const auto &R = save->getMod()->getArtilleryRules();
+	if (R.guns.empty() || u->getFaction() != FACTION_HOSTILE) return false;
+	// the spotter is Cobra's leader: the mission's leader if it has one, else the senior man at the start (picked once)
+	int lead = save->getVanStop("leaderId", -1);
+	if (lead < 0) lead = save->getVanStop("leader", -1);
+	if (lead < 0)
+	{
+		if (!save->getVanStop("artLeaderSet"))
+		{
+			int bestRank = 1 << 30, pick = -1;
+			for (auto *c : *save->getUnits())
+			{
+				if (c->getOriginalFaction() != FACTION_HOSTILE || c->isOut() || c->getArmor()->getSize() > 1) continue;
+				if (c->getRankInt() < bestRank) { bestRank = c->getRankInt(); pick = c->getId(); }
+			}
+			save->setVanStop("artLeader", pick);
+			save->setVanStop("artLeaderSet", 1);
+			Log(LOG_INFO) << "[artillery] Cobra's spotter is unit " << pick;
+		}
+		lead = save->getVanStop("artLeader", -1);
+	}
+	if (u->getId() != lead) return false;
+	if (save->getVanStop("artAiTurn") >= save->getTurn() - 1 && save->getVanStop("artAiTurn")) return false; // one call every other turn
+	if (u->getTimeUnits() < u->getBaseStats()->tu / 2) return false;
+	// the Joe it can see with the most other Joes within 3 tiles
+	BattleUnit *best = nullptr;
+	int bestN = 0;
+	const bool blind = getenv("OXCE_ARTY_TEST") && atoi(getenv("OXCE_ARTY_TEST")) == 2;   // rig only
+	std::vector<BattleUnit*> seen;
+	for (auto *a : *u->getVisibleUnits()) seen.push_back(a);
+	if (blind) { seen.clear(); for (auto *a : *save->getUnits()) seen.push_back(a); }
+	for (auto *a : seen)
+	{
+		if (a->getFaction() != FACTION_PLAYER || a->isOut()) continue;
+		int k = 0;
+		for (auto *b : seen)
+			if (b->getFaction() == FACTION_PLAYER && !b->isOut() && Position::distance2d(a->getPosition(), b->getPosition()) <= 3) ++k;
+		// never on top of itself
+		if (Position::distance2d(a->getPosition(), u->getPosition()) <= R.scatter / 2 + 2) continue;
+		if (k > bestN) { bestN = k; best = a; }
+	}
+	if (!best) { if (getenv("OXCE_ARTY_TEST")) Log(LOG_INFO) << "[artillery] spotter sees no Joe to shell"; return false; }
+	std::string why;
+	const int gun = gunInRange(save, FACTION_HOSTILE, why);
+	if (gun < 0) { if (getenv("OXCE_ARTY_TEST")) Log(LOG_INFO) << "[artillery] no Cobra gun: " << why; return false; }
+	save->setVanStop("artAiTurn", save->getTurn());
+	call(save, u, best->getPosition(), 0, gun);
+	action->type = BA_NONE;
+	return true;
+}
+
+}
+
