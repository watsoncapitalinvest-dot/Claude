+	Img loadPng(const std::string &path)
+	{
+		Img im;
+		if (!FileMap::fileExists(path)) return im;
+		const Uint32 t0 = SDL_GetTicks();
+		SDL_Surface *raw = IMG_Load_RW(FileMap::getRWops(path), SDL_TRUE);
+		if (!raw) return im;
+		SDL_PixelFormat fmt = {};
+		fmt.BitsPerPixel = 32; fmt.BytesPerPixel = 4;
+		fmt.Rmask = 0x00FF0000; fmt.Gmask = 0x0000FF00; fmt.Bmask = 0x000000FF; fmt.Amask = 0xFF000000;
+		fmt.Rshift = 16; fmt.Gshift = 8; fmt.Bshift = 0; fmt.Ashift = 24;
+		SDL_Surface *c = SDL_ConvertSurface(raw, &fmt, SDL_SWSURFACE);
+		SDL_FreeSurface(raw);
+		if (!c) return im;
+		im.w = c->w; im.h = c->h; im.px.resize((size_t)im.w * im.h);
+		SDL_LockSurface(c);
+		for (int y = 0; y < im.h; ++y) memcpy(&im.px[(size_t)y * im.w], (Uint8*)c->pixels + y * c->pitch, (size_t)im.w * 4);
+		SDL_UnlockSurface(c); SDL_FreeSurface(c);
+		im.ok = true;
+		// Lazy loading means this runs the first time a screen opens, so a slow
+		// one IS the stall the player feels. Anything over an eyeblink is worth
+		// knowing about by name rather than guessing at the screen.
+		const Uint32 ms = SDL_GetTicks() - t0;
+		if (ms > 40) Log(LOG_INFO) << "HiUI: " << path << " (" << im.w << "x" << im.h << ") took " << ms << " ms";
+		return im;
+	}
