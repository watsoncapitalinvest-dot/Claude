+/// Piece 6, Cobra Commander's will (Act1Fixes item 1, approved 16 Nov; John 10:01 "incentivize, never force"): from month 8 the
+/// Drome is wanted first. Every month the region's spare funds above a small reserve go into the Drome's purse and the backers
+/// add 200 x the months past 8. At half the price a construction site goes up (raidable); the Drome stands once it is paid for
+/// and has been building two months. Ending B: no front company, factory or Drome in the region for two straight months
+/// after month 8.
+void dromeFight(Game *game, Base *home);
+static void willMonthly(Game *game)
+{
+	SavedGame *save = game->getSavedGame();
+	Mod *mod = game->getMod();
+	auto &net = save->getCobraNet();
+	const int cm = save->getCobraMonth();          // 0-based: month 8 of the campaign is 7
+	if (cm < 7) return;
+	const RuleCobraSite *drome = mod->getCobraSite("STR_COBRA_TERROR_DROME");
+	if (!drome) return;
+	const int cost = std::max(1, drome->getBuildCostFunds());
+	AlienBase *finished = nullptr, *building = nullptr;
+	int fronts = 0, factories = 0;
+	std::string region = "STR_NORTH_AMERICA";
+	for (auto *b : *save->getAlienBases())
+	{
+		if (b->getSiteType() == "STR_COBRA_TERROR_DROME") finished = b;
+		if (b->getSiteType() == "STR_COBRA_TERROR_DROME_BUILDING") building = b;
+		if (b->getSiteType() == FRONT) fronts++;
+		if (b->getSiteType() == "STR_COBRA_FACTORY") factories++;
+	}
+	// ending B: the network broken for two straight months after month 8
+	if (!net.count("endingB"))
+	{
+		if (!finished && !building && fronts == 0 && factories == 0) net["brokenMonths"]++;
+		else net["brokenMonths"] = 0;
+		if (net["brokenMonths"] >= 2)
+		{
+			net["endingB"] = save->getMonthsPassed();
+			if (const RuleEvent *ev = mod->getEvent("STR_EVENT_COBRA_RETREATS")) save->spawnEvent(ev);
+			Log(LOG_INFO) << "[will] ending B: the network has been broken for two months";
+			return;
+		}
+	}
+	// the Drome strikes first (John 13 Nov 21:08): three months after it is finished, if the Joes have not assaulted it,
+	// it hits the Joe base nearest to it. That fight closes Act 1 whichever way it goes.
+	if (finished && !net.count("dromeStrike") && net.count("dromeDone") && save->getDaysPassed() - net["dromeDone"] >= 90
+		&& !save->getBases()->empty())
+	{
+		Base *nearest = nullptr;
+		for (auto *b : *save->getBases()) if (!nearest || finished->getDistance(b) < finished->getDistance(nearest)) nearest = b;
+		// a base defence (STORY's alert: Firebats on radar, transports behind them): it lands a day after radar has it,
+		// with the STR_COBRA_DROME_STRIKE garrison (GeoscapeState::time1Hour starts the battle, DebriefingState ends it)
+		if (nearest && mod->getDeployment("STR_COBRA_DROME_STRIKE"))
+		{
+			int idx = 0;
+			for (auto *b : *save->getBases()) { if (b == nearest) break; ++idx; }
+			net["dromeStrike"] = save->getDaysPassed();
+			net["strikeBase"] = idx;
+			net["strikeDay"] = save->getDaysPassed() + 1;
+			std::string t = tr(game, "STR_EVENT_DROME_STRIKE") + ": " + tr(game, "STR_EVENT_DROME_STRIKE_DESCRIPTION");
+			replaceAll(t, "{BASE}", nearest->getName());
+			save->addLeadNews("!" + t);
+			Log(LOG_INFO) << "[will] the Drome strikes " << nearest->getName();
+		}
+	}
+	if (finished || net.count("endingB")) return;
+	// the purse: spare funds above the reserve, and the backers
+	int &purse = net["dromePurse"];
+	const int reserve = 100;
+	for (const auto &f : save->getCobraEconomy().getAllFunds())
+	{
+		if (f.first != region) continue;
+		const int spare = f.second - reserve;
+		if (spare > 0) { save->getCobraEconomy().addFunds(region, -spare); purse += spare; }
+	}
+	const int past = (cm + 1) - 8;
+	if (past > 0) purse += 200 * past;
+	const std::vector<Town> ts = towns(mod);
+	if (building)
+	{
+		if (purse >= cost && save->getMonthsPassed() - net["dromeStarted"] >= 2)
+		{
+			Town t; t.name = townOf(save, building, ts); t.lon = building->getLongitude(); t.lat = building->getLatitude();
+			const bool known = building->isDiscovered();
+			for (auto it = save->getAlienBases()->begin(); it != save->getAlienBases()->end(); ++it)
+				if (*it == building) { save->getAlienBases()->erase(it); break; }
+			delete building;
+			if (AlienBase *d = plant(game, "STR_COBRA_TERROR_DROME_SITE", t, 0)) { if (known) d->setDiscovered(true); }
+			purse -= cost;
+			net["dromeDone"] = save->getDaysPassed();
+			Log(LOG_INFO) << "[will] the Terror Drome is finished near " << t.name;
+		}
+	}
+	else if (purse >= cost / 2)
+	{
+		// raided before it finished: it starts again from what is left in the purse
+		std::vector<AlienBase*> anchors;
+		for (auto *b : *save->getAlienBases()) if (b->getSiteType() == FRONT || b->getSiteType() == DEPOT) anchors.push_back(b);
+		Town t;
+		if (!anchors.empty()) { AlienBase *a = anchors[RNG::generate(0, (int)anchors.size() - 1)]; t.lon = a->getLongitude(); t.lat = a->getLatitude(); t.name = townOf(save, a, ts); }
+		else if (!ts.empty()) t = ts[RNG::generate(0, (int)ts.size() - 1)];
+		// out of town: the Drome is a fortress in open country, an hour or two from the town that feeds it
+		if (plant(game, "STR_COBRA_TERROR_DROME_BUILDING_SITE", t, 80))
+		{
+			net["dromeStarted"] = save->getMonthsPassed();
+			Log(LOG_INFO) << "[will] construction of the Terror Drome begins near " << t.name << " (purse " << purse << " of " << cost << ")";
+		}
+	}
+}
