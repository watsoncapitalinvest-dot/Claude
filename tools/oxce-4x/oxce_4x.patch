+namespace
+{
+	/// The painted empty room for a footprint (Resources/Base/shells/shell_<theme>_<w>x<h>.png),
+	/// brought by area to the size it is shown and kept. nullptr when none is installed.
+	const Img *roomShell(const std::string &theme, int w, int h, int dw, int dh)
+	{
+		static std::unordered_map<std::string, Img> src, sized;
+		const std::string id = theme + "_" + std::to_string(w) + "x" + std::to_string(h);
+		auto s = src.find(id);
+		if (s == src.end()) s = src.emplace(id, loadPng("Resources/Base/shells/shell_" + id + ".png")).first;
+		if (!s->second.ok || dw <= 0 || dh <= 0) return nullptr;
+		const std::string key = id + "@" + std::to_string(dw) + "x" + std::to_string(dh);
+		auto z = sized.find(key);
+		if (z == sized.end()) z = sized.emplace(key, resampleArea(s->second, dw, dh)).first;
+		return &z->second;
+	}
+}
+
+void nativeBaseView(const Surface *view, int g, const std::vector<Room> &rooms,
+	const std::vector<std::pair<int, int> > &linksRight, const std::vector<std::pair<int, int> > &linksDown,
+	const std::vector<Docked> &craft)
+{
+	// the docked craft's twins are set frames, pending until something resolves
+	// them - without this the hangar was blocky until an equipment screen had opened
+	resolvePending();
+	if (!base || !view || !shown(view)) return;
+	R r = rectOf(view);
+	if (!clipBase(r)) return;
+	const double k = SK();
+	const double vx = view->getX(), vy = view->getY();
+	const int X0 = xs[r.x0], Y0 = ys[r.y0], X1 = xs[r.x1], Y1 = ys[r.y1];
+	// the plotting table: dark slate, a faint line on every square
+	for (int Y = Y0; Y < Y1; ++Y)
+	{
+		Uint32 *o = over.data() + (size_t)Y * sw;
+		for (int X = X0; X < X1; ++X)
+		{
+			const int n = (int)(hash2(X, Y) % 5) - 2;
+			o[X] = lift(0x1D211A, n);
+		}
+	}
+	const int cells = view->getWidth() / g;
+	for (int i = 0; i <= cells; ++i)
+	{
+		const double gx = DX(vx + i * g), gy = DY(vy + i * g);
+		fillRect((int)gx - 1, Y0, (int)gx + 1, Y1, 0x2C3226);
+		fillRect(X0, (int)gy - 1, X1, (int)gy + 1, 0x2C3226);
+	}
+	// corridors under the rooms
+	auto corridor = [&](double bx0, double by0, double bx1, double by1)
+	{
+		roundRect(DX(bx0) - 1, DY(by0) - 1, DX(bx1) + 1, DY(by1) + 1, k * 0.6, 0x15180F);
+		roundRect(DX(bx0), DY(by0), DX(bx1), DY(by1), k * 0.5, 0x4A5040);
+		roundRect(DX(bx0) + 2, DY(by0) + 2, DX(bx1) - 2, DY(by1) - 2, k * 0.4, 0x5C634E);
+	};
+	for (auto &l : linksRight) corridor(vx + l.first * g - g * 0.3, vy + l.second * g + g * 0.38, vx + l.first * g + g * 0.3, vy + l.second * g + g * 0.62);
+	for (auto &l : linksDown) corridor(vx + l.first * g + g * 0.38, vy + l.second * g - g * 0.3, vx + l.first * g + g * 0.62, vy + l.second * g + g * 0.3);
+	const Face *f = face("label");
+	const Face *st = face("stencil");
+	for (const Room &rm : rooms)
+	{
+		const double bx0 = vx + rm.x * g + 1.4, by0 = vy + rm.y * g + 1.4, bx1 = vx + (rm.x + rm.w) * g - 1.4, by1 = vy + (rm.y + rm.h) * g - 1.4;
+		const double x0 = DX(bx0), y0 = DY(by0), x1 = DX(bx1), y1 = DY(by1), rad = k * 2.2;
+		const Uint32 tone = roomTone(rm.kind);
+		const bool building = rm.buildDays > 0;
+		// THE PAINTED ROOM when one is installed for this footprint: the whole
+		// squares, its own margin and cut corners included. Otherwise the plate.
+		const int sx0 = (int)DX(vx + rm.x * g), sy0 = (int)DY(vy + rm.y * g);
+		const int sx1 = (int)DX(vx + (rm.x + rm.w) * g), sy1 = (int)DY(vy + (rm.y + rm.h) * g);
+		// THE STOCKED ROOM: each square's facility frame has a sharp twin (the shell with
+		// its objects, build/install_stocked_rooms.py). A room still being built shows the
+		// empty shell instead - nothing is moved in until it is finished.
+		bool stocked = !building && !rm.frames.empty();
+		for (const Surface *fr : rm.frames)
+		{
+			auto it = fr ? bgImages.find(fr) : bgImages.end();
+			if (it == bgImages.end() || !it->second.ok) { stocked = false; break; }
+		}
+		if (stocked)
+		{
+			static std::unordered_map<std::string, Img> sizedTwins;
+			for (int j = 0; j < rm.h; ++j)
+				for (int i = 0; i < rm.w; ++i)
+				{
+					const Surface *fr = rm.frames[(size_t)(j * rm.w + i)];
+					const Img &src = bgImages[fr];
+					const int qx0 = (int)DX(vx + (rm.x + i) * g), qy0 = (int)DY(vy + (rm.y + j) * g);
+					const int qx1 = (int)DX(vx + (rm.x + i + 1) * g), qy1 = (int)DY(vy + (rm.y + j + 1) * g);
+					const int dw = qx1 - qx0, dh = qy1 - qy0;
+					if (dw <= 0 || dh <= 0) continue;
+					const std::string key = std::to_string((uintptr_t)fr) + "@" + std::to_string(dw) + "x" + std::to_string(dh);
+					auto z = sizedTwins.find(key);
+					if (z == sizedTwins.end())
+						z = sizedTwins.emplace(key, (src.w == dw && src.h == dh) ? src : resampleArea(src, dw, dh)).first;
+					const Img &q = z->second;
+					for (int Y = std::max(0, qy0); Y < std::min(sh, qy1); ++Y)
+					{
+						Uint32 *o = over.data() + (size_t)Y * sw;
+						const Uint32 *srow = q.px.data() + (size_t)(Y - qy0) * q.w;
+						for (int X = std::max(0, qx0); X < std::min(sw, qx1); ++X)
+						{
+							const Uint32 p = srow[X - qx0];
+							const int a = p >> 24;
+							if (a) o[X] = a >= 255 ? (p & 0xFFFFFF) : mix(o[X], p & 0xFFFFFF, a);
+						}
+					}
+				}
+		}
+		const Img *shell = stocked ? nullptr : roomShell("joe", rm.w, rm.h, sx1 - sx0, sy1 - sy0);
+		if (stocked) {}
+		else if (shell)
+		{
+			for (int Y = std::max(0, sy0); Y < std::min(sh, sy1); ++Y)
+			{
+				Uint32 *o = over.data() + (size_t)Y * sw;
+				const Uint32 *srow = shell->px.data() + (size_t)(Y - sy0) * shell->w;
+				for (int X = std::max(0, sx0); X < std::min(sw, sx1); ++X)
+				{
+					const Uint32 p = srow[X - sx0];
+					const int a = p >> 24;
+					if (a) o[X] = a >= 255 ? (p & 0xFFFFFF) : mix(o[X], p & 0xFFFFFF, a);
+				}
+			}
+			if (building) roundRect(x0 + k * 2.6, y0 + k * 2.6, x1 - k * 2.6, y1 - k * 2.6, k * 0.6, 0x1E2018, 150);
+		}
+		else
+		{
+		roundRect(x0 + k * 0.5, y0 + k * 0.7, x1 + k * 0.5, y1 + k * 0.7, rad, 0x0C0E09, 200);   // shadow
+		roundRect(x0, y0, x1, y1, rad, 0x14170F);                                              // wall
+		roundRect(x0 + 2, y0 + 2, x1 - 2, y1 - 2, rad - 1, building ? 0x3A3D33 : lift(tone, 18)); // lit lip
+		roundRect(x0 + k * 0.9, y0 + k * 0.9, x1 - k * 0.6, y1 - k * 0.6, rad - k * 0.6, building ? 0x2E3129 : tone);
+		if (!building)
+			roundRect(x0 + k * 0.9, y0 + k * 0.9, x1 - k * 0.6, y0 + k * 2.4, k * 0.8, lift(tone, 34), 160); // the kind's band
+		}
+		if (building)
+		{
+			// tape across an unfinished room: hazard stripes, faint
+			const int ix0 = (int)(x0 + k), iy0 = (int)(y0 + k), ix1 = (int)(x1 - k), iy1 = (int)(y1 - k);
+			const int stripe = std::max(4, (int)(k * 2));
+			for (int Y = std::max(0, iy0); Y < std::min(sh, iy1); ++Y)
+			{
+				Uint32 *o = over.data() + (size_t)Y * sw;
+				for (int X = std::max(0, ix0); X < std::min(sw, ix1); ++X)
+					if (((X + Y) / stripe) % 2 == 0) o[X] = mix(o[X], 0xC09A2E, 46);
+			}
+		}
+		if (rm.disabled) roundRect(x0 + 2, y0 + 2, x1 - 2, y1 - 2, rad - 1, 0x8A2A22, 90);
+		const bool hangar = rm.kind == ROOM_HANGAR && !building;
+		if (f)
+		{
+			// the name: across the room, or along the top edge of a hangar so the craft shows
+			const int nx0 = (int)(x0 + k * 1.8), nx1 = (int)(x1 - k * 1.8);
+			const int ny0 = (int)(y0 + k * (building || rm.disabled ? 2.0 : 2.6));
+			const int ny1 = hangar ? (int)(y0 + k * 9.5) : (building || rm.disabled) ? (int)(y0 + (y1 - y0) * 0.42) : (int)(y1 - k * 1.8);
+			if ((shell || stocked) && !building && !rm.disabled)
+			{
+				// on the bare painted floor the name sits on a plaque in the room's colour,
+				// so it reads and still says what the room is for
+				// a stocked room keeps its middle for its furniture - the centrepiece is the
+				// point of the picture - so its name sits on the bottom wall instead
+				const bool low = stocked && !hangar;
+				const bool two = rm.name.size() > 12 && rm.w == 1;
+				const double ph = k * (low ? (two ? 7.6 : 5.0) : (two ? 10.0 : 6.0));
+				const double pw = low ? x1 - x0 - k * 3 : std::min(x1 - x0 - k * 6, k * 26.0);
+				const double pcx = (x0 + x1) / 2, pcy = hangar ? y0 + k * 6.0 : low ? y1 - ph / 2 - k * 0.3 : (y0 + y1) / 2;
+				roundRect(pcx - pw / 2 + k * 0.3, pcy - ph / 2 + k * 0.4, pcx + pw / 2 + k * 0.3, pcy + ph / 2 + k * 0.4, k * 1.0, 0x0A0B08, 150);
+				roundRect(pcx - pw / 2, pcy - ph / 2, pcx + pw / 2, pcy + ph / 2, k * 1.0, tone, 235);
+				roundRect(pcx - pw / 2, pcy - ph / 2, pcx + pw / 2, pcy - ph / 2 + k * 0.8, k * 0.5, lift(tone, 30), 200);
+				setTypeWrapped(*f, rm.name, (int)(pcx - pw / 2 + k), (int)(pcy - ph / 2 + k * 0.6), (int)(pcx + pw / 2 - k), (int)(pcy + ph / 2 - k * 0.6), low ? k * 2.8 : k * 3.2, C_INK, 0x0A0B08);
+			}
+			else
+			setTypeWrapped(*f, rm.name, nx0, ny0, nx1, ny1, k * 3.4, building ? 0xB8B49A : C_INK, 0x0A0B08);
+		}
+		if ((building || rm.disabled) && st)
+		{
+			std::string t = rm.disabled ? "OFF" : std::to_string(rm.buildDays);
+			if (rm.hadPrevious) t += "*";
+			const int ty0 = (int)(y0 + (y1 - y0) * 0.46), ty1 = (int)(y1 - k * 1.6);
+			setType(*st, t, (int)x0 + 2, ty0 + 2, (int)x1 + 2, ty1 + 2, std::min((ty1 - ty0) * 0.62, k * 9.0), k * 9, 1, 1, 0x0A0B08);
+			setType(*st, t, (int)x0, ty0, (int)x1, ty1, std::min((ty1 - ty0) * 0.62, k * 9.0), k * 9, 1, 1, rm.disabled ? 0xE07060 : 0xE8C35A);
+		}
+		if (!building && rm.ammoMax > 0 && f)
+		{
+			const Uint32 c = rm.ammo >= rm.ammoMax ? 0x8FD07A : rm.ammo <= rm.ammoMax / 2 ? 0xE07060 : 0xE8C35A;
+			const std::string t = std::to_string(rm.ammo) + "/" + std::to_string(rm.ammoMax);
+			setType(*f, t, (int)(x0 + k * 1.6), (int)(y1 - k * 6), (int)(x1 - k * 1.6), (int)(y1 - k * 1.4), k * 3.0, k * 4, 2, 2, c);
+		}
+	}
+	// craft on their pads: the craft's own sprite, never resampled into mush
+	for (const Docked &d : craft)
+	{
+		if (!d.frame) continue;
+		auto it = bgImages.find(d.frame);
+		const Img *im = (it != bgImages.end() && it->second.ok) ? &it->second : flatTwin(d.frame);
+		if (!im) continue;
+		stretch(*im, 0, 0, im->w, im->h, (int)DX(vx + d.x), (int)DY(vy + d.y + 3), (int)DX(vx + d.x + d.frame->getWidth()), (int)DY(vy + d.y + 3 + d.frame->getHeight()));
+	}
+	claim(r);
+}
