+#include "../Savegame/BaseFacility.h"
+#include "../Savegame/ItemContainer.h"
+#include "../Savegame/SavedGame.h"
+#include "../Menu/ErrorMessageState.h"
+#include "../Geoscape/Outposts.h"
+
+namespace OpenXcom
+{
+
+PitPlaceState::PitPlaceState(Base *base, const RuleBaseFacility *rule) : _base(base), _rule(rule)
+{
+	_screen = false;
+	_window = new Window(this, 128, 160, 192, 40);
+	_view = new PitBlueprintView(192, 192, 0, 8);
+	_btnCancel = new TextButton(112, 16, 200, 176);
+	_txtFacility = new Text(110, 17, 202, 50);
+	_txtCost = new Text(110, 9, 202, 68);
+	_numCost = new Text(110, 17, 202, 76);
+	_txtTime = new Text(110, 9, 202, 94);
+	_numTime = new Text(110, 17, 202, 102);
+	_txtHow = new Text(110, 25, 202, 122);
+	_txtFit = new Text(110, 17, 202, 150);
+
+	setInterface("placeFacility");
+	add(_window, "window", "placeFacility");
+	add(_view);
+	add(_btnCancel, "button", "placeFacility");
+	add(_txtFacility, "text", "placeFacility");
+	add(_txtCost, "text", "placeFacility");
+	add(_numCost, "numbers", "placeFacility");
+	add(_txtTime, "text", "placeFacility");
+	add(_numTime, "numbers", "placeFacility");
+	add(_txtHow, "text", "placeFacility");
+	add(_txtFit, "text", "placeFacility");
+	centerAllSurfaces();
+	if (HiUI::enabled())
+	{
+		HiUI::nativeKey(_btnCancel, "");
+		for (Surface *t : std::initializer_list<Surface*>{ _txtFacility, _txtCost, _numCost, _txtTime, _numTime, _txtHow, _txtFit })
+			HiUI::nativeText(t);
+	}
+	setWindowBackground(_window, "placeFacility");
+
+	_view->setup(_game->getMod(), _base, [this](const std::string &s) { return std::string((const std::string&)tr(s)); });
+	_view->setFloor(PitPlace::floorOf(_game->getMod(), _rule->getType()));
+	_view->lockTabs(true);
+	_view->setGhost(_rule->getType(), false);
+	_view->onMouseClick((ActionHandler)&PitPlaceState::viewClick);
+	_view->onMouseClick((ActionHandler)&PitPlaceState::viewTurn, SDL_BUTTON_RIGHT);
+	_view->onKeyboardPress((ActionHandler)&PitPlaceState::viewTurn, SDLK_r);
+
+	_btnCancel->setText(tr("STR_CANCEL"));
+	_btnCancel->onMouseClick((ActionHandler)&PitPlaceState::btnCancelClick);
+	_btnCancel->onKeyboardPress((ActionHandler)&PitPlaceState::btnCancelClick, Options::keyCancel);
+
+	_txtFacility->setWordWrap(true);
+	_txtFacility->setText(tr(_rule->getType()));
+	_txtCost->setText(tr("STR_COST_UC"));
+	_numCost->setBig();
+	_numCost->setText(Unicode::formatFunding(_rule->getBuildCost()));
+	_txtTime->setText(tr("STR_CONSTRUCTION_TIME_UC"));
+	_numTime->setBig();
+	_numTime->setText(tr("STR_DAY", _rule->getBuildTime()));
+	_txtHow->setWordWrap(true);
+	_txtHow->setText(tr(PitPlace::canTurn(_game->getMod(), _rule->getType()) ? "STR_PIT_PLACE_HOW" : "STR_PIT_PLACE_HOW_FIXED"));
+	_txtFit->setWordWrap(true);
+}
+
+PitPlaceState::~PitPlaceState()
+{
+	HiUI::nativeForget(_btnCancel);
+	for (const Surface *t : std::initializer_list<const Surface*>{ _txtFacility, _txtCost, _numCost, _txtTime, _numTime, _txtHow, _txtFit })
+		HiUI::nativeForget(t);
+}
+
+void PitPlaceState::think()
+{
+	State::think();
+	const std::string why = _view->ghostWhy();
+	if (why != _lastWhy)
+	{
+		_lastWhy = why;
+		_txtFit->setText(why.empty() ? tr("STR_PIT_FITS") : tr(why));
+	}
+}
+
+void PitPlaceState::btnCancelClick(Action *)
+{
+	_game->popState();
+}
+
+void PitPlaceState::viewTurn(Action *)
+{
+	if (PitPlace::canTurn(_game->getMod(), _rule->getType())) _view->setTurned(!_view->getTurned());
+}
+
+void PitPlaceState::viewClick(Action *)
+{
+	int x, y;
+	const bool turned = _view->getTurned() && PitPlace::canTurn(_game->getMod(), _rule->getType());
+	if (!_view->tileUnderMouse(x, y)) return;
+	const std::string why = PitPlace::fits(_game->getMod(), _base, _rule->getType(), x, y, turned);
+	const int c1 = _game->getMod()->getInterface("placeFacility")->getElement("errorMessage")->color;
+	const int c2 = _game->getMod()->getInterface("placeFacility")->getElement("errorPalette")->color;
+	if (!why.empty())
+	{
+		_game->pushState(new ErrorMessageState(tr(why), _palette, c1, "BACK13.SCR", c2));
+		return;
+	}
+	if (_game->getSavedGame()->getFunds() < _rule->getBuildCost())
+	{
+		_game->popState();
+		_game->pushState(new ErrorMessageState(tr("STR_NOT_ENOUGH_MONEY"), _palette, c1, "BACK01.SCR", c2));
+		return;
+	}
+	for (const auto &item : _rule->getBuildCostItems())
+	{
+		const int needed = item.second.first - _base->getStorageItems()->getItem(item.first);
+		if (needed > 0)
+		{
+			_game->popState();
+			_game->pushState(new ErrorMessageState(tr("STR_NOT_ENOUGH_ITEMS").arg(tr(item.first)).arg(needed), _palette, c1, "BACK01.SCR", c2));
+			return;
+		}
+	}
+	BaseFacility *fac = new BaseFacility(_rule, _base);
+	fac->setPitPlace(x, y, turned);
+	fac->setBuildTime(_rule->getBuildTime());
+	_base->getFacilities()->push_back(fac);
+	if (_rule->getPlaceSound() != Mod::NO_SOUND)
+		_game->getMod()->getSound("GEO.CAT", _rule->getPlaceSound())->play();
+	_game->getSavedGame()->setFunds(_game->getSavedGame()->getFunds() - _rule->getBuildCost());
+	for (const auto &item : _rule->getBuildCostItems())
+		_base->getStorageItems()->removeItem(item.first, item.second.first);
+	if (!_game->isShiftPressed()) _game->popState();
+}
+
+}
