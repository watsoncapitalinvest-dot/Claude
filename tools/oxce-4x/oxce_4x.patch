+void nativeSelector(const Surface *sel)
+{
+	if (!base || !sel) return;
+	R r = rectOf(sel);
+	if (!clipBase(r)) return;
+	const double k = SK();
+	const double x0 = xs[r.x0], y0 = ys[r.y0], x1 = xs[r.x1], y1 = ys[r.y1];
+	// where the room will go: a translucent wash and a solid edge, the plan still
+	// readable through it
+	const double t = std::max(3.0, k * 0.6);
+	roundRect(x0 + 1, y0 + 1, x1 - 1, y1 - 1, k * 2, 0xE8B04A, 70);
+	fillRect((int)x0 + 1, (int)y0 + 1, (int)x1 - 1, (int)(y0 + 1 + t), 0xE8B04A);
+	fillRect((int)x0 + 1, (int)(y1 - 1 - t), (int)x1 - 1, (int)y1 - 1, 0xE8B04A);
+	fillRect((int)x0 + 1, (int)y0 + 1, (int)(x0 + 1 + t), (int)y1 - 1, 0xE8B04A);
+	fillRect((int)(x1 - 1 - t), (int)y0 + 1, (int)x1 - 1, (int)y1 - 1, 0xE8B04A);
+	// hollow it: put the plan back inside the ring by re-claiming only the ring's base pixels
+	SDL_Surface *ss = const_cast<Surface*>(sel)->getSurface();
+	for (int by = r.y0; by < r.y1; ++by)
+	{
+		const Uint8 *p = row8(by);
+		for (int bx = r.x0; bx < r.x1; ++bx)
+		{
+			const int sx = bx - sel->getX(), sy = by - sel->getY();
+			if (!ss || sx >= ss->w || sy >= ss->h || !((const Uint8*)ss->pixels)[sy * ss->pitch + sx]) continue;
+			tag[by * bw + bx] = p[bx]; valid[by * bw + bx] = 1;
+		}
+	}
+	any = true;
+}
+
+void nativeMiniBases(const Surface *mini, int slot, const std::vector<MiniBase> &bases)
+{
+	if (!base || !mini || !shown(mini)) return;
+	R r = rectOf(mini);
+	if (!clipBase(r)) return;
+	const double k = SK();
+	const double mx = mini->getX(), my = mini->getY();
+	fillRect(xs[r.x0], ys[r.y0], xs[r.x1], ys[r.y1], C_PLATE);
+	for (size_t i = 0; i < bases.size(); ++i)
+	{
+		const double sx0 = DX(mx + i * slot + 0.4), sy0 = DY(my + 0.4), sx1 = DX(mx + (i + 1) * slot - 0.4), sy1 = DY(my + slot - 0.4);
+		const MiniBase &b = bases[i];
+		if (b.selected) roundRect(sx0 - 2, sy0 - 2, sx1 + 2, sy1 + 2, k * 1.4, 0xE8B04A);
+		roundRect(sx0, sy0, sx1, sy1, k * 1.2, C_RIM_DARK);
+		roundRect(sx0 + 2, sy0 + 2, sx1 - 2, sy1 - 2, k * 1.0, b.exists ? 0x1D211A : C_WELL);
+		if (!b.exists) continue;
+		for (auto &rm : b.rooms)
+		{
+			const Uint32 c = rm.second == 0 ? 0x7FA864 : rm.second == 1 ? 0xC9A23E : 0x6A7E96;
+			const double cx0 = DX(mx + i * slot + 2 + rm.first.x * 2) + 1, cy0 = DY(my + 2 + rm.first.y * 2) + 1;
+			const double cx1 = DX(mx + i * slot + 2 + (rm.first.x + rm.first.w) * 2) - 1, cy1 = DY(my + 2 + (rm.first.y + rm.first.h) * 2) - 1;
+			roundRect(cx0, cy0, cx1, cy1, k * 0.4, c);
+		}
+	}
+	claim(r);
+}
