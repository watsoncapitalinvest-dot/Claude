+/**
+ * G.I. JOE BATTLE BAR (BATTLE_HUD_SPEC_v1, approved 12 Nov).
+ *
+ * The bar is 42 base px (the interface's "icons" height); positions below are the
+ * spec's, with the bar's top at 0. Everything is PAINTED by HiUI from refreshJoeHud's
+ * data; the widgets here are only where clicks land, each drawn as a native key.
+ * Stock buttons the spec has no place for are kept 1 px big in the corner so their
+ * keyboard shortcuts still work.
+ */
+void BattlescapeState::layoutJoeHud()
+{
+	_joeHud = true;
+	const int ox = _icons->getX(), oy = _icons->getY();
+	auto place = [&](Surface *s, int x, int y, int w, int h)
+	{
+		s->setX(ox + x); s->setY(oy + y);
+		s->setWidth(w); s->setHeight(h);
+		// a button's pressed picture was cut from the stock bar at its old size: cut it again (blank)
+		if (auto *bb = dynamic_cast<BattlescapeButton*>(s)) { bb->clear(); bb->initSurfaces(); }
+	};
+	auto tuck = [&](Surface *s) { place(s, 0, 0, 1, 1); };
+	auto key = [&](Surface *s, const std::string &legend) { HiUI::nativeKey(s, legend, false); };
+
+	// the action grid: 4 x 2, each 12 x 11, 1 px apart
+	BattlescapeButton *grid[8] = { _btnMapUp, _btnMapDown, _btnKneel, _btnCenter, _btnNextSoldier, _btnShowMap, _btnInventory, _btnHelp };
+	const char *gridLegend[8] = { "UP", "DOWN", "KNEEL", "CENTER", "NEXT", "MAP", "GEAR", "OPTIONS" };
+	const char *gridIcon[8] = { "icon_level_up", "icon_level_down", "icon_kneel", "icon_center", "icon_next", "icon_map", "icon_gear", "icon_options" };
+	for (int i = 0; i < 8; ++i)
+	{
+		place(grid[i], 196 + (i % 4) * 13, 14 + (i / 4) * 12, 12, 11);
+		key(grid[i], gridLegend[i]);
+		HiUI::nativeKeyIcon(grid[i], std::string("battle_icons/") + gridIcon[i]);
+	}
+	// reserve time: four toggles under the label
+	BattlescapeButton *res[4] = { _btnReserveNone, _btnReserveSnap, _btnReserveAimed, _btnReserveAuto };
+	const char *resLegend[4] = { "NONE", "SNAP", "AIM", "AUTO" };
+	for (int i = 0; i < 4; ++i)
+	{
+		place(res[i], 251 + i * 9, 16, 8, 6);
+		key(res[i], resLegend[i]);
+	}
+	place(_btnEndTurn, 291, 11, 25, 28);
+	key(_btnEndTurn, "END TURN");
+	HiUI::nativeKeyStyle(_btnEndTurn, 1);
+	place(_btnStats, 36, 11, 54, 8);
+	_txtName->setX(ox + 36); _txtName->setY(oy + 11); _txtName->setWidth(54); _txtName->setHeight(8);
+	// clear of the squad strip's right-hand scroll key, which ends at 181
+	_txtTooltip->setX(ox + 184); _txtTooltip->setY(oy + 1); _txtTooltip->setWidth(132); _txtTooltip->setHeight(8);
+	_txtTooltip->setAlign(ALIGN_RIGHT);
+
+	// no place on the bar: shortcuts only
+	for (Surface *s : { (Surface*)_btnUnitUp, (Surface*)_btnUnitDown, (Surface*)_btnNextStop, (Surface*)_btnShowLayers,
+		(Surface*)_btnAbort, (Surface*)_btnZeroTUs, (Surface*)_btnReserveKneel, (Surface*)_btnLeftHandItem, (Surface*)_btnRightHandItem })
+		tuck(s);
+	// The stock pieces painted instead are parked off the screen: updateSoldierInfo
+	// turns their visibility back on, so hiding alone let them flash through.
+	for (Surface *s : { (Surface*)_rank, (Surface*)_rankTiny, (Surface*)_numLayers, (Surface*)_numTimeUnits, (Surface*)_numEnergy,
+		(Surface*)_numHealth, (Surface*)_numMorale, (Surface*)_barTimeUnits, (Surface*)_barEnergy, (Surface*)_barHealth,
+		(Surface*)_barMorale, (Surface*)_numTwoHandedIndicatorLeft, (Surface*)_numTwoHandedIndicatorRight })
+		{ s->setX(-400); s->setY(-400); }
+	if (_barMana) { _barMana->setX(-400); _barMana->setY(-400); }
+	for (auto *v : { &_numAmmoLeft, &_numAmmoRight, &_numMedikitLeft, &_numMedikitRight })
+		for (auto *n : *v) { n->setX(-400); n->setY(-400); }
+
+	// NEW PIECES
+	for (int i = 0; i < 6; ++i)
+	{
+		_hudChip[i] = new InteractiveSurface(28, 6, ox + 4 + 29 * i, oy + 2);
+		add(_hudChip[i]);
+		_hudChip[i]->onMouseClick((ActionHandler)&BattlescapeState::hudChipClick);
+	}
+	for (int i = 0; i < 2; ++i)
+	{
+		_hudScroll[i] = new InteractiveSurface(7, 6, ox + (i == 0 ? 4 : 174), oy + 2);
+		add(_hudScroll[i]);
+		_hudScroll[i]->onMouseClick((ActionHandler)&BattlescapeState::hudScrollClick);
+		HiUI::nativeKey(_hudScroll[i], i == 0 ? "<" : ">", false);
+		_hudScroll[i]->setVisible(false);
+	}
+	for (int hnd = 0; hnd < 2; ++hnd)
+	{
+		const int cx = hnd == 0 ? 94 : 145;
+		_hudCard[hnd] = new InteractiveSurface(47, 18, ox + cx, oy + 10);
+		add(_hudCard[hnd]);
+		_hudCard[hnd]->onMouseClick((ActionHandler)&BattlescapeState::hudCardClick, 0);
+		for (int m = 0; m < 3; ++m)
+		{
+			_hudMode[hnd][m] = new InteractiveSurface(14, 8, ox + cx + 1 + m * 15, oy + 30);
+			add(_hudMode[hnd][m]);
+			_hudMode[hnd][m]->onMouseClick((ActionHandler)&BattlescapeState::hudModeClick);
+		}
+	}
+	_hudSig = new InteractiveSurface(36, 14, ox + 251, oy + 24);
+	add(_hudSig);
+	_hudSig->onMouseClick((ActionHandler)&BattlescapeState::hudSigClick);
+	_hudPortrait = new InteractiveSurface(28, 28, ox + 4, oy + 11);
+	add(_hudPortrait);
+	_hudPortrait->onMouseClick((ActionHandler)&BattlescapeState::btnInventoryClick);
+
+	// the mission panel, top right; the special-action buttons move down under it
+	const int screenWidth = Options::baseXResolution;
+	_hudMission = new Surface(76, 22, screenWidth - 80, 4);
+	add(_hudMission);
+	_hudMission->drawRect(0, 0, 76, 22, 15);
+	for (Surface *s : { (Surface*)_btnLaunch, (Surface*)_btnPsi, (Surface*)_btnSpecial, (Surface*)_btnSkills })
+		if (s) s->setY(s->getY() + 28);
+	// the bar itself runs the full width; its contents stay in the centred block
+	_hudContentX = ox;
+	_icons->setX(0);
+	_icons->setWidth(screenWidth);
+
+	refreshJoeHud();
+}
