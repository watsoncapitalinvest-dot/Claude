+int SavedGame::flightRisk(const Mod *mod, double lon1, double lat1, double lon2, double lat2, bool groundOnly) const
+{
+	// sample the great circle and take the closest approach of each Cobra site and flying Cobra craft
+	auto angle = [](double aLon, double aLat, double bLon, double bLat)
+	{
+		const double c = sin(aLat) * sin(bLat) + cos(aLat) * cos(bLat) * cos(aLon - bLon);
+		return acos(std::max(-1.0, std::min(1.0, c)));
+	};
+	const double d = angle(lon1, lat1, lon2, lat2);
+	std::vector<std::pair<double, double> > pts;
+	for (int i = 0; i <= 24; ++i)
+	{
+		const double f = i / 24.0;
+		if (d < 1e-6) { pts.emplace_back(lon1, lat1); break; }
+		const double A = sin((1 - f) * d) / sin(d), B = sin(f * d) / sin(d);
+		const double x = A * cos(lat1) * cos(lon1) + B * cos(lat2) * cos(lon2);
+		const double y = A * cos(lat1) * sin(lon1) + B * cos(lat2) * sin(lon2);
+		const double z = A * sin(lat1) + B * sin(lat2);
+		pts.emplace_back(atan2(y, x), atan2(z, sqrt(x * x + y * y)));
+	}
+	auto near = [&](double lon, double lat)
+	{
+		for (auto &p : pts) if (angle(p.first, p.second, lon, lat) <= mod->getInterceptRadius()) return true;
+		return false;
+	};
+	int risk = 0;
+	for (const auto *ab : _alienBases) if (near(ab->getLongitude(), ab->getLatitude())) risk += mod->getInterceptPerSite();
+	if (!groundOnly) for (const auto *u : _ufos) if (u->getStatus() == Ufo::FLYING && near(u->getLongitude(), u->getLatitude())) risk += mod->getInterceptPerUfo();
+	return std::min(risk, mod->getInterceptCap());
+}
