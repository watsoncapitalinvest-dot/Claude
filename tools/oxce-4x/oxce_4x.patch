+	// G.I. Joe capture (13 Nov 2026): a Cobra man carrying a knocked-out Joe heads for the nearest
+	// edge of the map with him (BattlescapeGame::captureStep takes the Joe off the map there).
+	if (_unit->getFaction() == FACTION_HOSTILE && _unit->isCarrying() && _save->getMod()->isCaptureOn())
