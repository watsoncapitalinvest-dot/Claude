+void BattlescapeState::hudMenuClick(Action *action)
+{
+	int i = 0;
+	while (i < 16 && action->getSender() != _hudMenu[i]) ++i;
+	switch (i)
+	{
+	case 0: _hudWalkMode = (_hudWalkMode + 1) % 3; _battleGame->setGjWalkMode(_hudWalkMode); break;
+	case 1: btnKneelClick(action); break;
+	case 6: btnMapUpClick(action); break;
+	case 7: btnMapDownClick(action); break;
+	case 8: btnCenterClick(action); break;
+	case 9: btnNextSoldierClick(action); break;
+	case 10: btnShowMapClick(action); return;
+	case 11: btnInventoryClick(action); return;
+	case 12: btnStatsClick(action); return;
+	case 13: btnHelpClick(action); return;
+	case 14: if (playableUnitSelected() && !_battleGame->isBusy()) doDistract(_save->getSelectedUnit()); break;
+	case 15: if (playableUnitSelected() && !_battleGame->isBusy()) doConceal(_save->getSelectedUnit()); break;
