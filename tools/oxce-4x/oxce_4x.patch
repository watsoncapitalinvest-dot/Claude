+/**
+ * The bar's contents for this frame: who is selected, what they hold, the squad, the turn.
+ */
+void BattlescapeState::refreshJoeHud()
+{
+	if (!_joeHud || !_hudMission) return;
+	for (Surface *s : { (Surface*)_rank, (Surface*)_rankTiny, (Surface*)_numLayers, (Surface*)_numTimeUnits, (Surface*)_numEnergy,
+		(Surface*)_numHealth, (Surface*)_numMorale, (Surface*)_barTimeUnits, (Surface*)_barEnergy, (Surface*)_barHealth,
+		(Surface*)_barMorale, (Surface*)_numTwoHandedIndicatorLeft, (Surface*)_numTwoHandedIndicatorRight,
+		(Surface*)_btnLeftHandItem, (Surface*)_btnRightHandItem })
+		s->setVisible(false);
+	if (_barMana) _barMana->setVisible(false);
+	for (auto *n : _numAmmoLeft) n->setVisible(false);
+	for (auto *n : _numAmmoRight) n->setVisible(false);
+	for (auto *n : _numMedikitLeft) n->setVisible(false);
+	for (auto *n : _numMedikitRight) n->setVisible(false);
+	HiUI::HudData d;
+	d.on = true;
+	d.contentX = _hudContentX;
+	BattleUnit *u = _save->getSelectedUnit();
+	const bool ours = u && u->getFaction() == FACTION_PLAYER;
+	if (ours)
+	{
+		d.sub = tr(u->getRankString());
+		if (u->getGeoscapeSoldier())
+		{
+			const std::string look = u->getArmor()->getSpriteInventory();
+			d.figure = _game->getMod()->getSurface(look, false);
+			if (!d.figure) d.figure = _game->getMod()->getSurface(look + ".SPK", false);
+		}
+		d.tu = u->getTimeUnits(); d.tuMax = std::max(1, (int)u->getBaseStats()->tu);
+		d.hp = u->getHealth(); d.hpMax = std::max(1, (int)u->getBaseStats()->health);
+		d.en = u->getEnergy(); d.enMax = std::max(1, (int)u->getBaseStats()->stamina);
+		d.mo = u->getMorale(); d.moMax = 100;
+	}
+	// the hands, and the fire-mode keys under each
+	BattleAction *cur = _battleGame->getCurrentAction();
+	for (int hnd = 0; hnd < 2; ++hnd)
+	{
+		HiUI::HudHand &h = d.hand[hnd];
+		h.label = hnd == 0 ? "RIGHT HAND" : "LEFT HAND";
+		BattleItem *item = ours ? (hnd == 0 ? u->getRightHandWeapon() : u->getLeftHandWeapon()) : nullptr;
+		int m = 0;
+		if (item)
+		{
+			const RuleItem *r = item->getRules();
+			h.empty = false;
+			h.name = tr(r->getName());
+			if (r->getBattleType() == BT_FIREARM)
+			{
+				const BattleItem *ammo = item->getAmmoForSlot(0);
+				if (ammo) h.ammo = std::to_string(ammo->getAmmoQuantity()) + "/" + std::to_string(std::max(1, ammo->getRules()->getClipSize()));
+				else h.ammo = "EMPTY";
+			}
+			if (SurfaceSet *big = _game->getMod()->getSurfaceSet("BIGOBS.PCK", false))
+				h.art = big->getFrame(r->getBigSprite());
+			struct ModeDef { BattleActionType t; const char *name; bool ok; };
+			const ModeDef defs[] = {
+				{ BA_SNAPSHOT, "SNAP", r->getBattleType() == BT_FIREARM && r->getCostSnap().Time > 0 },
+				{ BA_AIMEDSHOT, "AIMED", r->getBattleType() == BT_FIREARM && r->getCostAimed().Time > 0 },
+				{ BA_AUTOSHOT, "AUTO", r->getBattleType() == BT_FIREARM && r->getCostAuto().Time > 0 },
+				{ BA_HIT, "STRIKE", r->getCostMelee().Time > 0 },
+				{ BA_THROW, "THROW", r->getBattleType() == BT_GRENADE || r->getBattleType() == BT_PROXIMITYGRENADE },
+			};
+			for (const auto &md : defs)
+			{
+				if (!md.ok || m >= 3) continue;
+				BattleActionCost cost(md.t, u, item);
+				_hudModeType[hnd][m] = md.t;
+				HiUI::nativeKey(_hudMode[hnd][m], std::string(md.name) + " " + std::to_string(cost.Time), false);
+				const bool armed = cur && cur->targeting && cur->weapon == item && cur->type == md.t;
+				const bool can = cost.Time <= u->getTimeUnits();
+				HiUI::nativeKeyStyle(_hudMode[hnd][m], armed ? 1 : can ? 0 : 3);
+				_hudMode[hnd][m]->setVisible(true);
+				++m;
+			}
+		}
+		for (; m < 3; ++m) _hudMode[hnd][m]->setVisible(false);
+		_hudCard[hnd]->setVisible(ours);
+	}
+	_hudPortrait->setVisible(ours);
+
+	// reserve: the active toggle is olive
+	BattlescapeButton *res[4] = { _btnReserveNone, _btnReserveSnap, _btnReserveAimed, _btnReserveAuto };
+	for (auto *b : res) HiUI::nativeKeyStyle(b, b == _reserve ? 4 : 0);
+	HiUI::nativeKeyStyle(_btnKneel, ours && u->isKneeled() ? 4 : 0);
+
+	// the squad strip: up to six, the window following the selected Joe
+	std::vector<BattleUnit*> squad;
+	int canAct = 0;
+	for (auto *bu : *_save->getUnits())
+	{
+		if (bu->getOriginalFaction() != FACTION_PLAYER || bu->getStatus() == STATUS_IGNORE_ME) continue;
+		if (bu->getStatus() == STATUS_DEAD && !bu->getGeoscapeSoldier()) continue;
+		squad.push_back(bu);
+		if (!bu->isOut() && bu->getTimeUnits() > 0 && bu->getFaction() == FACTION_PLAYER) ++canAct;
+	}
+	// THE WINDOW. With six or fewer Joes the strip is as it was. With more, two
+	// scroll keys take the ends and the chips close up to make room; the window
+	// still jumps to keep a newly selected Joe in view, but otherwise stays where
+	// the player scrolled it.
+	const int n = (int)squad.size();
+	const bool scroll = n > 6;
+	if (u != _hudLastSel)
+	{
+		_hudLastSel = u;
+		for (int i = 0; i < n; ++i)
+			if (squad[i] == u)
+			{
+				if (i < _hudFirst) _hudFirst = i;
+				if (i >= _hudFirst + 6) _hudFirst = i - 5;
+			}
+	}
+	_hudFirst = scroll ? std::max(0, std::min(_hudFirst, n - 6)) : 0;
+	{
+		const int ox = _hudContentX, oy = _icons->getY();
+		for (int i = 0; i < 6; ++i)
+		{
+			_hudChip[i]->setX(ox + (scroll ? 12 + 27 * i : 4 + 29 * i));
+			_hudChip[i]->setWidth(scroll ? 26 : 28);
+			_hudChip[i]->setY(oy + 2);
+		}
+		for (int i = 0; i < 2; ++i)
+		{
+			_hudScroll[i]->setVisible(scroll);
+			const bool can = i == 0 ? _hudFirst > 0 : _hudFirst + 6 < n;
+			HiUI::nativeKeyStyle(_hudScroll[i], can ? 0 : 3);
+		}
+	}
+	for (int i = 0; i < 6; ++i)
+	{
+		const int si = _hudFirst + i;
+		_hudChipUnit[i] = si < n ? squad[si] : nullptr;
+		_hudChip[i]->setVisible(_hudChipUnit[i] != nullptr);
+		if (!_hudChipUnit[i]) continue;
+		BattleUnit *bu = _hudChipUnit[i];
+		std::string nm = bu->getName(_game->getLanguage());
+		const auto sp = nm.find_last_of(' ');
+		if (sp != std::string::npos && nm.size() > 12) nm = nm.substr(sp + 1);
+		// CHIP STATES. Down (out of the fight) and captured (a Joe the enemy now
+		// controls) are marked red; a Joe with no time left this turn is dimmed
+		// and marked DONE; the selected Joe is the yellow one.
+		const bool down = bu->isOut();
+		const bool captured = !down && bu->getFaction() != FACTION_PLAYER;
+		const bool acted = !down && !captured && bu->getTimeUnits() == 0;
+		std::string legend = nm;
+		if (down) legend += " - DOWN";
+		else if (captured) legend += " - CAPTURED";
+		else if (acted) legend += " - DONE";
+		HiUI::nativeKey(_hudChip[i], legend, false);
+		HiUI::nativeKeyStyle(_hudChip[i], bu == u ? 1 : (down || captured) ? 2 : acted ? 3 : 0);
+	}
+	HiUI::nativeKey(_btnEndTurn, "END TURN|" + std::to_string(canAct) + (canAct == 1 ? " Joe can still act" : " Joes can still act"), false);
+
+	// signature move: no specials system yet. The slot is the CUFF key when the selected Joe
+	// stands next to a Cobra man with his hands up (capture, John 13 Nov 2026).
+	d.sigOn = false;
+	d.sigTitle = "SIGNATURE MOVE";
+	d.sigName = "NONE";
+	d.sigHow = "Comes with the specials system";
+	if (ours)
+	{
+		if (BattleUnit *t = cuffTarget(u))
+		{
+			const int cost = _game->getMod()->getCuffTU();
+			d.sigOn = u->getTimeUnits() >= cost;
+			d.sigTitle = "PRISONER";
+			d.sigName = "CUFF HIM";
+			d.sigHow = d.sigOn ? std::to_string(cost) + " TU" : "Not enough time";
+			(void)t;
+		}
+	}
+
+	// the mission panel
+	int seen = 0, civ = 0;
+	for (auto *bu : *_save->getUnits())
+	{
+		if (bu->isOut()) continue;
+		if (bu->getFaction() == FACTION_HOSTILE && bu->getVisible()) ++seen;
+		if (bu->getOriginalFaction() == FACTION_NEUTRAL) ++civ;
+	}
+	d.turn = "TURN " + std::to_string(_save->getTurn());
+	d.phase = _save->getSide() == FACTION_PLAYER ? "JOE TURN" : "COBRA TURN";
+	d.objective = tr(_save->getMissionType());
+	d.counts = "Cobra seen: " + std::to_string(seen) + "  -  Civilians: " + std::to_string(civ);
+	HiUI::nativeHud(_icons, _hudMission, d);
+}
+
+void BattlescapeState::hudChipClick(Action *action)
+{
+	if (!allowButtons()) return;
+	for (int i = 0; i < 6; ++i)
+	{
+		if (action->getSender() != _hudChip[i] || !_hudChipUnit[i]) continue;
+		BattleUnit *bu = _hudChipUnit[i];
+		if (!bu->isSelectable(_save->getSide(), false, false)) return;
+		_battleGame->cancelAllActions();
+		_save->setSelectedUnit(bu);
+		updateSoldierInfo();
+		_map->getCamera()->centerOnPosition(bu->getPosition());
+		_battleGame->getCurrentAction()->actor = bu;
+		_battleGame->setupCursor();
+		_map->refreshSelectorPosition();
+		return;
+	}
+}
+
+/**
+ * G.I. Joe capture: the surrendered, uncuffed Cobra man next to this Joe, if there is one.
+ */
+BattleUnit *BattlescapeState::cuffTarget(BattleUnit *joe) const
+{
+	if (!joe || joe->isOut() || !_game->getMod()->isCaptureOn()) return nullptr;
+	for (auto *bu : *_save->getUnits())
+	{
+		if (bu->isOut() || !bu->isHandsUp() || bu->isCuffed() || bu->getOriginalFaction() != FACTION_HOSTILE) continue;
+		Position d = bu->getPosition() - joe->getPosition();
+		if (std::abs(d.z) <= 0 && std::max(std::abs(d.x), std::abs(d.y)) <= 1) return bu;
+	}
+	return nullptr;
+}
+
+void BattlescapeState::hudSigClick(Action *)
+{
+	if (!playableUnitSelected()) return;
+	BattleUnit *joe = _save->getSelectedUnit();
+	BattleUnit *t = cuffTarget(joe);
+	const int cost = _game->getMod()->getCuffTU();
+	if (!t || !joe->spendTimeUnits(cost)) return;
+	t->setCuffed(true);
+	t->setCaptorId(joe->getId());
+	Log(LOG_INFO) << "CAPTURE cuffed " << t->getType() << " " << t->getId() << " by " << joe->getId();
+	updateSoldierInfo();
+}
