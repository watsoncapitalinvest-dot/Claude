+/**
+ * G.I. Joe: an air fight (DOGFIGHT_DESIGN_v1 section 2, AIR_SEA_BUILD_PLAN_v1). The map is the deployment's
+ * sky - the ground picture on floor 0, the decks on floors 1-4 - over the terrain picked for the spot.
+ * Every Joe craft in the fight and the Cobra aircraft become units; nobody walks.
+ * A Cobra plane that is going somewhere crosses the map from a side edge; the Joes cut in from the south.
+ * A Cobra plane that came to fight starts about 25 tiles off, facing them.
+ */
+/**
+ * G.I. Joe air raids, phase 2: lays what the bombs broke back over the site's map (AlienBase::getWreck).
+ */
+void BattlescapeGenerator::applySiteWreck()
+{
+	if (!_alienBase) return;
+	auto *sets = _save->getMapDataSets();
+	int laid = 0, missed = 0;
+	for (const auto &line : _alienBase->getWreck())
+	{
+		std::istringstream ss(line);
+		int x, y, z, part, idx;
+		std::string set;
+		if (!(ss >> x >> y >> z >> part >> set >> idx)) { ++missed; continue; }
+		Tile *t = _save->getTile(Position(x, y, z));
+		if (!t || part < O_FLOOR || part >= O_MAX) { ++missed; continue; }
+		if (_craftDeployed && x >= _craftPos.x * 10 && x < (_craftPos.x + _craftPos.w) * 10 && y >= _craftPos.y * 10 && y < (_craftPos.y + _craftPos.h) * 10) continue;   // the transport sits there
+		if (idx < 0) { t->setMapData(nullptr, -1, -1, (TilePart)part); ++laid; continue; }
+		int si = -1;
+		for (size_t i = 0; i < sets->size(); ++i) if ((*sets)[i]->getName() == set) si = (int)i;
+		if (si < 0 || idx >= (int)(*sets)[si]->getSize()) { ++missed; continue; }
+		t->setMapData((*sets)[si]->getObject(idx), idx, si, (TilePart)part);
+		++laid;
+	}
+	if (laid || missed) Log(LOG_INFO) << "[airraid] the wreck laid back on the site's map: " << laid << " parts" << (missed ? ", " + std::to_string(missed) + " could not be placed" : "");
+}
