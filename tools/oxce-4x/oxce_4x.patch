+					const int x0 = std::min(sx1 - 1, std::max(sx0, (int)std::floor(fx))), x1 = std::min(sx1 - 1, x0 + 1);
+					const int wx = std::min(256, std::max(0, (int)((fx - x0) * 256)));
+					const Uint32 p00 = im.px[(size_t)y0 * im.w + x0], p01 = im.px[(size_t)y0 * im.w + x1];
+					const Uint32 p10 = im.px[(size_t)y1 * im.w + x0], p11 = im.px[(size_t)y1 * im.w + x1];
+					auto ch = [&](int sh2) { return (Uint32)((((p00 >> sh2 & 255) * (256 - wx) + (p01 >> sh2 & 255) * wx) * (256 - wy) + ((p10 >> sh2 & 255) * (256 - wx) + (p11 >> sh2 & 255) * wx) * wy) >> 16); };
+					const Uint32 al = ch(24);
+					if (al < 255) sc.opaque = false;
+					sc.px[(size_t)Y * dw + X] = (al << 24) | (ch(16) << 16) | (ch(8) << 8) | ch(0);
+				}
+			}
+			scaledBytes += sc.px.size() * 4;
+			it = scaledCache.emplace(key, std::move(sc)).first;
+		}
+		const Scaled &sc = it->second;
+		const int cx0 = std::max(dx0, 0), cy0 = std::max(dy0, 0), cx1 = std::min(dx1, sw), cy1 = std::min(dy1, sh);
+		if (cx1 <= cx0) return;
+		for (int Y = cy0; Y < cy1; ++Y)
+		{
+			Uint32 *o = over.data() + (size_t)Y * sw;
+			const Uint32 *s2 = sc.px.data() + (size_t)(Y - dy0) * dw - dx0;
+			if (sc.opaque) { for (int X = cx0; X < cx1; ++X) o[X] = s2[X] & 0xFFFFFF; continue; }
+			for (int X = cx0; X < cx1; ++X)
+			{
+				const Uint32 p = s2[X];
+				const int al = p >> 24;
+				if (al <= 0) continue;
+				o[X] = al >= 255 ? (p & 0xFFFFFF) : mix(o[X], p & 0xFFFFFF, al);
+			}
+		}
+	}
+	void stretchRaw(const Img &im, int sx0, int sy0, int sx1, int sy1, int dx0, int dy0, int dx1, int dy1)
+	{
+		const int cx0 = std::max(dx0, 0), cy0 = std::max(dy0, 0), cx1 = std::min(dx1, sw), cy1 = std::min(dy1, sh);
+		for (int Y = cy0; Y < cy1; ++Y)
+		{
+			const double fy = sy0 + (Y - dy0 + 0.5) * (sy1 - sy0) / (double)(dy1 - dy0) - 0.5;
+			const int y0 = std::min(sy1 - 1, std::max(sy0, (int)std::floor(fy))), y1 = std::min(sy1 - 1, y0 + 1);
+			const int wy = std::min(256, std::max(0, (int)((fy - y0) * 256)));
+			Uint32 *o = over.data() + (size_t)Y * sw;
+			for (int X = cx0; X < cx1; ++X)
+			{
+				const double fx = sx0 + (X - dx0 + 0.5) * (sx1 - sx0) / (double)(dx1 - dx0) - 0.5;
+				const int x0 = std::min(sx1 - 1, std::max(sx0, (int)std::floor(fx))), x1 = std::min(sx1 - 1, x0 + 1);
+				const int wx = std::min(256, std::max(0, (int)((fx - x0) * 256)));
+				const Uint32 p00 = im.px[(size_t)y0 * im.w + x0], p01 = im.px[(size_t)y0 * im.w + x1];
+				const Uint32 p10 = im.px[(size_t)y1 * im.w + x0], p11 = im.px[(size_t)y1 * im.w + x1];
+				auto ch = [&](int sh2) { return (int)((((p00 >> sh2 & 255) * (256 - wx) + (p01 >> sh2 & 255) * wx) * (256 - wy) + ((p10 >> sh2 & 255) * (256 - wx) + (p11 >> sh2 & 255) * wx) * wy) >> 16); };
+				const int al = ch(24);
+				if (al <= 0) continue;
+				const Uint32 c = rgb(ch(16), ch(8), ch(0));
+				o[X] = al >= 255 ? c : mix(o[X], c, al);
+			}
+		}
+	}
+	/// Nine-slice: corners kept, edges and middle stretched.
+	void nine(const Img &im, int x0, int y0, int x1, int y1, int b, bool hollow = false)
+	{
+		b = std::min(b, std::min(im.w, im.h) / 3);
+		const int bx = std::min(b, (x1 - x0) / 3), by = std::min(b, (y1 - y0) / 3);
+		const int sx[4] = { 0, b, im.w - b, im.w }, sy[4] = { 0, b, im.h - b, im.h };
+		const int dx[4] = { x0, x0 + bx, x1 - bx, x1 }, dy[4] = { y0, y0 + by, y1 - by, y1 };
+		for (int r = 0; r < 3; ++r)
+			for (int c = 0; c < 3; ++c)
+				if (!(hollow && r == 1 && c == 1))
+					stretch(im, sx[c], sy[r], sx[c + 1], sy[r + 1], dx[c], dy[r], dx[c + 1], dy[r + 1]);
+	}
+
+	/// Rounded panel with a 1-2 px rim.
+	void panel(int x0, int y0, int x1, int y1, int rad, Uint32 top, Uint32 bottom, Uint32 rim, int rimW)
+	{
+		const int cx0 = std::max(x0, 0), cy0 = std::max(y0, 0), cx1 = std::min(x1, sw), cy1 = std::min(y1, sh);
+		const int h = std::max(1, y1 - y0);
+		for (int y = cy0; y < cy1; ++y)
+		{
+			Uint32 *o = over.data() + (size_t)y * sw;
+			const Uint32 fill = mix(top, bottom, (y - y0) * 255 / h);
+			for (int x = cx0; x < cx1; ++x)
+			{
+				// distance to the rounded outline
+				const int dx = std::max(std::max(x0 + rad - x, x - (x1 - 1 - rad)), 0), dy = std::max(std::max(y0 + rad - y, y - (y1 - 1 - rad)), 0);
+				double d;
+				if (dx > 0 && dy > 0) d = rad - std::sqrt((double)dx * dx + (double)dy * dy);
+				else d = std::min(std::min(x - x0, x1 - 1 - x), std::min(y - y0, y1 - 1 - y)) + 0.5;
+				if (d <= -0.5) continue;                           // outside the corner: leave what is there
+				Uint32 c = d < rimW ? rim : fill;
+				if (d < 0.5) c = mix(o[x], c, (int)((d + 0.5) * 255));
+				o[x] = c;
+			}
+		}
+	}
+
+	// Returns how many glyphs it actually put down. The callers need that: a
+	// claimed rect suppresses the 8-bit original, so a label that renders zero
+	// glyphs leaves a button with nothing written on it and no way back.
+	// With dry = true nothing is drawn and only the count is computed.
+	int glyphs(const Text *t, int ox, int oy, const R &clip, Uint32 ink, bool useMask, const R &maskRect, bool dry = false)
+	{
+		const SDL_Color *pal = base->format->palette->colors;
+		int drawn = 0;
+		// two passes: every letter's shadow and keyline first, then every letter's ink
+		for (int pass = dry ? 1 : 0; pass < 2; ++pass)
+		for (const auto &g : t->getHiGlyphs())
+		{
+			if (!g.sheet) continue;
+			auto it = atlases.find(g.sheet);
+			if (it == atlases.end()) continue;
+			const Atlas &a = it->second;
+			const int bx0 = ox + g.x, by0 = oy + g.y, bx1 = bx0 + g.w, by1 = by0 + g.h;
+			if (bx1 <= clip.x0 || by1 <= clip.y0 || bx0 >= clip.x1 || by0 >= clip.y1) continue;
+			// A glyph whose box crosses the base surface used to be dropped WHOLE,
+			// which is why a label hard against an edge - the geoscape's right-hand
+			// buttons - came out blank, and why LAUNCH INTERCEPTION truncated. Only
+			// the xs/ys lookups need the box in range, so clamp those and let the
+			// inner loops clip per pixel as they already do.
+			if (bx1 <= 0 || by1 <= 0 || bx0 >= bw || by0 >= bh) continue;
+			const int cx0 = std::max(0, std::min(bw, bx0)), cx1 = std::max(0, std::min(bw, bx1));
+			const int cy0 = std::max(0, std::min(bh, by0)), cy1 = std::max(0, std::min(bh, by1));
+			if (cx1 <= cx0 || cy1 <= cy0) continue;
+			if (pass == 1) ++drawn;
+			if (dry) continue;
+			Uint32 col = ink;
+			if (!col)
+			{
+				const SDL_Color &c = pal[g.color];
+				// A STRONGLY SATURATED COLOUR IS A DELIBERATE ONE. DO NOT WASH IT OUT.
+				//
+				// The wash exists because the geoscape palette gives its labels a
+				// scatter of pale blues and greens that read as noise at this size;
+				// pulling them to off-white makes the panel one piece of type. But it
+				// is applied by palette index and cannot tell a default apart from a
+				// choice, so a clock deliberately set to red (252,0,0) came out PINK -
+				// 205/255 of the way to off-white is mostly off-white.
+				//
+				// Saturation separates the two. Nothing in this palette's UI text is
+				// anywhere near this saturated; only a colour picked on purpose is.
+				const int hi = std::max(c.r, std::max(c.g, c.b));
+				const int lo = std::min(c.r, std::min(c.g, c.b));
+				// THE COLOUR IS THE MEANING. John: "all the fonts need to be correct
+				// and colors". The wash used to pull every glyph 205/255 of the way to
+				// off-white so a screen read as one typeface - and in doing so erased
+				// what the colours SAY: green craft rows, yellow READY, a wounded man
+				// in red. The palette's own colour is kept and only lifted a little
+				// toward the light, because the 8-bit text colours were picked to
+				// read against 8-bit backgrounds and some sit dark against the
+				// smoothed ones. Saturated choices are left almost untouched.
+				// KEEP THE HUE, GUARANTEE THE LIGHTNESS. A plain mix toward white has
+				// one knob and it trades the two against each other: at 205/255 every
+				// colour was the same off-white, at 60/255 the dark palette entries
+				// sat dark on dark windows and LAUNCH INTERCEPTION's title all but
+				// vanished. So the colour is taken to HSL, its lightness raised to a
+				// floor that reads on the smoothed backgrounds, its saturation capped
+				// so nothing glares - and green, yellow and red still say what they
+				// said in 8 bits.
+				col = readable(c.r, c.g, c.b, (hi - lo) > 150);
+			}
+			const int X0 = xs[cx0], X1 = xs[cx1], Y0 = ys[cy0], Y1 = ys[cy1];
+			const double kx = (double)((cx1 - cx0) * a.k) / (X1 - X0), ky = (double)((cy1 - cy0) * a.k) / (Y1 - Y0);
+			col = creamy(col);
+			const int gh = ys[std::min(bh, by0 + g.h)] - ys[std::max(0, by0)];
+			const bool light = lightInk(col);
+			const int wear = light ? wearFor(gh) : 0, sd = light ? std::max(1, gh / 12) : 0;
+			for (int Y = Y0; Y < Y1; ++Y)
+			{
+				const int by = cy0 + (Y - Y0) * (cy1 - cy0) / (Y1 - Y0);
+				if (by < clip.y0 || by >= clip.y1) continue;
+				const double fy = (g.sy + (cy0 - by0)) * a.k + (Y - Y0 + 0.5) * ky - 0.5; const int sy0 = std::max(0, (int)fy), sy1 = std::min(a.h - 1, sy0 + 1); const int wy = (int)((fy - sy0) * 256);
+				for (int X = X0; X < X1; ++X)
+				{
+					const int bx = cx0 + (X - X0) * (cx1 - cx0) / (X1 - X0);
+					if (bx < clip.x0 || bx >= clip.x1) continue;
+					if (useMask && !scratch[(by - maskRect.y0) * (maskRect.x1 - maskRect.x0) + (bx - maskRect.x0)]) continue;
+					const double fx = (g.sx + (cx0 - bx0)) * a.k + (X - X0 + 0.5) * kx - 0.5; const int sx0 = std::max(0, (int)fx), sx1 = std::min(a.w - 1, sx0 + 1); const int wx = (int)((fx - sx0) * 256);
+					const int c00 = a.cov[(size_t)sy0 * a.w + sx0], c01 = a.cov[(size_t)sy0 * a.w + sx1], c10 = a.cov[(size_t)sy1 * a.w + sx0], c11 = a.cov[(size_t)sy1 * a.w + sx1];
+					const int cov = ((c00 * (256 - wx) + c01 * wx) * (256 - wy) + (c10 * (256 - wx) + c11 * wx) * wy) >> 16;
+					if (pass == 0) darkPx(X, Y, cov, sd);
+					else paintPx(X, Y, X - X0 + g.sx * 3, Y - Y0 + g.sy * 3, cov, col, wear, sd, (Y - Y0) * 256 / std::max(1, Y1 - Y0));
+				}
+			}
+		}
+		return drawn;
+	}
+
+	bool shown(const Surface *s) { return s->getVisible() && !s->isHidden(); }
+	R rectOf(const Surface *s) { return R{ s->getX(), s->getY(), s->getX() + s->getWidth(), s->getY() + s->getHeight() }; }
+
+	// ===================================================================== NATIVE
+	// Everything below draws in DISPLAY pixels from shapes and outlines, so it is
+	// as sharp as the screen it lands on. Base coordinates are mapped with the
+	// same affine the zoom uses, not snapped to whole base pixels.
+	inline double DX(double bx) { return xs[0] + bx * (double)(xs[bw] - xs[0]) / bw; }
+	inline double DY(double by) { return ys[0] + by * (double)(ys[bh] - ys[0]) / bh; }
+	inline double SK() { return (double)(ys[bh] - ys[0]) / bh; }   // display px per base px
+
+	struct Face
+	{
+		Img img; int em = 0, asc = 0, desc = 0, cap = 0; bool ok = false;
+		struct G { int x = 0, y = 0, w = 0, h = 0, l = 0, t = 0; float adv = 0; bool ok = false; } g[256];
+	};
+	std::unordered_map<std::string, Face> faces;
+	const Face *face(const std::string &name)
+	{
+		auto it = faces.find(name);
+		if (it != faces.end()) return it->second.ok ? &it->second : nullptr;
+		Face f;
+		const std::string base = "Resources/UI/type_" + name;
+		f.img = loadPng(base + ".png");
+		if (f.img.ok && FileMap::fileExists(base + ".txt"))
+		{
+			auto in = FileMap::getIStream(base + ".txt");
+			if (in && (*in >> f.em >> f.asc >> f.desc >> f.cap))
+			{
+				int c, x, y, w, h, l, t; float adv;
+				while (*in >> c >> x >> y >> w >> h >> l >> t >> adv)
+					if (c >= 0 && c < 256) f.g[c] = Face::G{ x, y, w, h, l, t, adv, true };
+				f.ok = f.em > 0 && f.cap > 0;
+			}
+		}
+		if (f.ok) Log(LOG_INFO) << "Typeface: " << name << " (em " << f.em << ")";
+		else Log(LOG_WARNING) << "Typeface missing: " << base;
+		auto &slot = faces[name] = std::move(f);
+		return slot.ok ? &slot : nullptr;
+	}
+
+	/// UTF-8 to the face's Latin-1 range; control tokens dropped, line breaks kept.
+	std::vector<int> latin1(const std::string &s)
+	{
+		std::vector<int> out;
+		for (size_t i = 0; i < s.size();)
+		{
+			unsigned char c = (unsigned char)s[i];
+			int cp, n;
+			if (c < 0x80) { cp = c; n = 1; }
+			else if ((c >> 5) == 6) { cp = c & 0x1F; n = 2; }
+			else if ((c >> 4) == 14) { cp = c & 0x0F; n = 3; }
+			else { cp = c & 0x07; n = 4; }
+			for (int k = 1; k < n && i + k < s.size(); ++k) cp = (cp << 6) | ((unsigned char)s[i + k] & 0x3F);
+			i += n;
+			if (cp == '\n' || cp == 2) { out.push_back('\n'); continue; }
+			if (cp < 32) continue;
+			// the faces carry the en and em dash at their Windows-1252 codes
+			if (cp == 0x2013) { out.push_back(150); continue; }
+			if (cp == 0x2014) { out.push_back(151); continue; }
+			out.push_back(cp < 256 ? cp : '?');
+		}
+		return out;
+	}
+
+	double lineWidth(const Face &f, const std::vector<int> &s, size_t a, size_t b, double size)
+	{
+		double w = 0;
+		for (size_t i = a; i < b; ++i) if (f.g[s[i]].ok) w += f.g[s[i]].adv;
+		return w * size / f.em;
+	}
+
+	/// One line of type. Each output pixel takes the AREA average of the atlas
+	/// under it, which is what makes a 96 px master come down to 20 px clean.
+	void drawLine(const Face &f, const std::vector<int> &s, size_t a, size_t b, double X, double baseline, double size,
+		Uint32 col, int cx0, int cy0, int cx1, int cy1)
+	{
+		const double k = size / f.em;
+		const int n = std::max(1, std::min(6, (int)std::ceil(1.0 / k)));
+		// stencilled paint: a light ink is a painted letter; a dark one is somebody's shadow pass
+		const Uint32 ink = creamy(col);
+		const bool light = lightInk(ink);
+		const int capPx = (int)(f.cap * k);
+		const int wear = light ? wearFor(capPx) : 0, sd = light ? std::max(1, capPx / 10) : 0;
+		cx0 = std::max(cx0, 0); cy0 = std::max(cy0, 0); cx1 = std::min(cx1, sw); cy1 = std::min(cy1, sh);
+		const double top = baseline - f.asc * k;
+		for (int pass = sd > 0 ? 0 : 1; pass < 2; ++pass)
+		{
+		double pen = X;
+		for (size_t i = a; i < b; ++i)
+		{
+			const Face::G &g = f.g[s[i]];
+			if (!g.ok) continue;
+			if (g.w > 0 && g.h > 0)
+			{
+				const double gx0 = pen + g.l * k, gy0 = top + g.t * k;
+				const int X0 = std::max(cx0, (int)std::floor(gx0)), X1 = std::min(cx1, (int)std::ceil(gx0 + g.w * k));
+				const int Y0 = std::max(cy0, (int)std::floor(gy0)), Y1 = std::min(cy1, (int)std::ceil(gy0 + g.h * k));
+				for (int Y = Y0; Y < Y1; ++Y)
+				{
+					for (int Xp = X0; Xp < X1; ++Xp)
+					{
+						int sum = 0;
+						for (int sy = 0; sy < n; ++sy)
+						{
+							const double fy = (Y + (sy + 0.5) / n - gy0) / k;
+							if (fy < 0 || fy >= g.h) continue;
+							const Uint32 *row = f.img.px.data() + (size_t)(g.y + (int)fy) * f.img.w + g.x;
+							for (int sx = 0; sx < n; ++sx)
+							{
+								const double fx = (Xp + (sx + 0.5) / n - gx0) / k;
+								if (fx < 0 || fx >= g.w) continue;
+								sum += row[(int)fx] >> 24;
+							}
+						}
+						const int cov = sum / (n * n);
+						if (cov <= 0) continue;
+						if (pass == 0) darkPx(Xp, Y, cov, sd);
+						else paintPx(Xp, Y, Xp - X0 + (int)(g.x * k), Y - Y0 + (int)(g.y * k), cov, ink, wear, sd,
+							std::max(0, std::min(256, (int)((Y - gy0) * 256 / std::max(1.0, g.h * k)))));
+					}
+				}
+			}
+			pen += g.adv * k;
+		}
+		}
+	}
+
+	/// Set a string inside a display rectangle: size from the wanted cap height,
+	/// shrunk if a line would not fit across, aligned as asked.
+	void setType(const Face &f, const std::string &str, int X0, int Y0, int X1, int Y1, double capPx, double lineH,
+		int halign, int valign, Uint32 col, bool keepInside = true)
+	{
+		const std::vector<int> s = latin1(str);
+		double size = capPx * f.em / f.cap;
+		std::vector<std::pair<size_t, size_t> > lines;
+		size_t a = 0;
+		for (size_t i = 0; i <= s.size(); ++i)
+			if (i == s.size() || s[i] == '\n') { lines.emplace_back(a, i); a = i + 1; }
+		if (keepInside)
+			for (auto &l : lines)
+			{
+				const double w = lineWidth(f, s, l.first, l.second, size);
+				if (w > X1 - X0 - 1) size *= (X1 - X0 - 1) / w;
+			}
+		const double cap = f.cap * size / f.em;
+		const double total = lineH * (lines.size() - 1) + cap;
+		double y = valign == 1 ? (Y0 + Y1 - total) / 2 : valign == 2 ? Y1 - total - (lineH - cap) / 2 : Y0 + (lineH - cap) / 2;
+		for (auto &l : lines)
+		{
+			const double w = lineWidth(f, s, l.first, l.second, size);
+			const double x = halign == 1 ? (X0 + X1 - w) / 2 : halign == 2 ? X1 - w : X0;
+			drawLine(f, s, l.first, l.second, x, y + cap, size, col, X0 - 2, Y0 - 2, X1 + 2, Y1 + 2);
+			y += lineH;
+		}
+	}
+
+	/// Anti-aliased convex polygon, 4x4 supersampled.
+	void polygonAA(const std::vector<std::pair<double, double> > &p, Uint32 col, int alpha = 255)
+	{
+		double x0 = 1e9, y0 = 1e9, x1 = -1e9, y1 = -1e9;
+		for (auto &q : p) { x0 = std::min(x0, q.first); y0 = std::min(y0, q.second); x1 = std::max(x1, q.first); y1 = std::max(y1, q.second); }
+		const int X0 = std::max(0, (int)std::floor(x0)), X1 = std::min(sw, (int)std::ceil(x1));
+		const int Y0 = std::max(0, (int)std::floor(y0)), Y1 = std::min(sh, (int)std::ceil(y1));
+		auto inside = [&](double x, double y)
+		{
+			bool pos = false, neg = false;
+			for (size_t i = 0; i < p.size(); ++i)
+			{
+				const auto &A = p[i], &B = p[(i + 1) % p.size()];
+				const double c = (B.first - A.first) * (y - A.second) - (B.second - A.second) * (x - A.first);
+				if (c > 0) pos = true; else if (c < 0) neg = true;
+			}
+			return !(pos && neg);
+		};
+		for (int Y = Y0; Y < Y1; ++Y)
+		{
+			Uint32 *o = over.data() + (size_t)Y * sw;
+			for (int X = X0; X < X1; ++X)
+			{
+				int c = 0;
+				for (int sy = 0; sy < 4; ++sy) for (int sx = 0; sx < 4; ++sx) c += inside(X + (sx + 0.5) / 4, Y + (sy + 0.5) / 4);
+				if (c) o[X] = mix(o[X], col, c * alpha / 16);
+			}
+		}
+	}
+
+	/// Rounded rectangle, anti-aliased on its outline, solid colour.
+	void roundRect(double x0, double y0, double x1, double y1, double rad, Uint32 col, int alpha = 255)
+	{
+		const int X0 = std::max(0, (int)std::floor(x0)), X1 = std::min(sw, (int)std::ceil(x1));
+		const int Y0 = std::max(0, (int)std::floor(y0)), Y1 = std::min(sh, (int)std::ceil(y1));
+		for (int Y = Y0; Y < Y1; ++Y)
+		{
+			Uint32 *o = over.data() + (size_t)Y * sw;
+			const double py = Y + 0.5;
+			for (int X = X0; X < X1; ++X)
+			{
+				const double px = X + 0.5;
+				const double qx = std::max(std::max(x0 + rad - px, px - (x1 - rad)), 0.0);
+				const double qy = std::max(std::max(y0 + rad - py, py - (y1 - rad)), 0.0);
+				double d;   // signed distance inside the shape
+				if (qx > 0 && qy > 0) d = rad - std::sqrt(qx * qx + qy * qy);
+				else d = std::min(std::min(px - x0, x1 - px), std::min(py - y0, y1 - py));
+				const double cov = std::max(0.0, std::min(1.0, d + 0.5));
+				if (cov > 0) o[X] = mix(o[X], col, (int)(cov * alpha));
+			}
+		}
+	}
