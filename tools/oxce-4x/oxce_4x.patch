+		else for (const Text *c : tl->getVisibleCells())
+		{
+			drawn += glyphs(c, tl->getX() + c->getX(), tl->getY() + c->getY(), r, 0, true, r);
+		}
+		if (!drawn)
+		{
+			scratch.clear();
+			return;
+		}
+		for (int y = r.y0; y < r.y1; ++y)
+		{
+			const Uint8 *p = row8(y);
+			for (int x = r.x0; x < r.x1; ++x)
+				if (scratch[(size_t)(y - r.y0) * (r.x1 - r.x0) + (x - r.x0)]) tag[y * bw + x] = p[x];
+		}
+		scratch.clear();
+		return;
+	}
+	// THE EQUIPMENT SCREEN. Its grid and slot labels are not widgets: the Inventory
+	// draws them into 8-bit surfaces of its own and blits the lot as one. So the
+	// grid's pixels are handed back to the painted backdrop under them - the
+	// backdrop has a well cut for every slot, and the steel between the wells IS
+	// the grid at display resolution - and the labels are set again from the Text
+	// objects the Inventory now keeps. A pixel an item has drawn over is left alone.
+	if (Inventory *inv = dynamic_cast<Inventory*>(w))
+	{
+		if (!any) return;
+		R r = rectOf(inv);
+		if (!clipBase(r)) return;
+		if (nativeOn())
+		{
+			// Built from scratch: no 8-bit grid, labels or counts were drawn, so
+			// the painted wells show as they are and the type is set here.
+			const int ox = inv->getX(), oy = inv->getY();
+			const double k = SK();
+			if (const Face *f = face("label"))
+			{
+				for (const Text *t : inv->getLabelTexts())
+				{
+					// a margin inside the label plate, and clear of the page's own frame
+					// at the left edge - the painted page has a border there
+					const double lx = std::max(t->getX(), 5) + 1.5;
+					const int X0 = (int)DX(ox + lx), Y1 = (int)DY(oy + t->getY() + t->getHeight() - 1.4);   // caps centred in the painted plate, measured
+					setType(*f, t->getText(), X0, (int)DY(oy + t->getY()), X0 + (int)(140 * k), Y1, 4.5 * k, 9 * k, 0, 2, C_LABEL, false);
+				}
+				for (const auto &n : inv->_hiNumbers)
+				{
+					const int rx = std::get<0>(n), byy = std::get<1>(n);
+					const std::string v = std::to_string(std::get<2>(n));
+					const int X0 = (int)DX(ox + rx - 14), Y0 = (int)DY(oy + byy - 7.5), X1 = (int)DX(ox + rx), Y1 = (int)DY(oy + byy);
+					const Uint32 c = textColour(std::get<3>(n));
+					setType(*f, v, X0 + 2, Y0 + 2, X1 + 2, Y1 + 2, 5.0 * k, 7.5 * k, 2, 2, 0x0A0B08, false);
+					setType(*f, v, X0, Y0, X1, Y1, 5.0 * k, 7.5 * k, 2, 2, c, false);
+				}
+			}
+			return;
+		}
+		SDL_Surface *gs = const_cast<Surface*>(inv->getGridSurface())->getSurface();
+		SDL_Surface *ls = const_cast<Surface*>(inv->getLabelSurface())->getSurface();
+		const int ox = inv->getX(), oy = inv->getY();
+		auto at = [](SDL_Surface *s, int x, int y) -> Uint8
+		{
+			if (!s || x < 0 || y < 0 || x >= s->w || y >= s->h) return 0;
+			return ((const Uint8*)s->pixels)[y * s->pitch + x];
+		};
+		for (int y = r.y0; y < r.y1; ++y)
+		{
+			const Uint8 *p = row8(y);
+			for (int x = r.x0; x < r.x1; ++x)
+			{
+				const Uint8 gv = at(gs, x - ox, y - oy);
+				if (!gv || p[x] != gv) continue;
+				const size_t i = (size_t)y * bw + x;
+				if (valid[i] && tag[i] == p[x]) continue;      // a sharp item icon already holds it
+				tag[i] = p[x]; valid[i] = 1;
+			}
+		}
+		for (const Text *t : inv->getLabelTexts())
+		{
+			R lr{ ox + t->getX(), oy + t->getY(), ox + t->getX() + t->getWidth(), oy + t->getY() + t->getHeight() };
+			if (!clipBase(lr)) continue;
+			const int lw = lr.x1 - lr.x0;
+			scratch.assign((size_t)lw * (lr.y1 - lr.y0), 0);
+			for (int y = lr.y0; y < lr.y1; ++y)
+			{
+				const Uint8 *p = row8(y);
+				for (int x = lr.x0; x < lr.x1; ++x)
+				{
+					const size_t i = (size_t)y * bw + x;
+					const Uint8 lv = at(ls, x - ox, y - oy);
+					scratch[(size_t)(y - lr.y0) * lw + (x - lr.x0)] = (valid[i] && tag[i] == p[x]) || (lv && lv == p[x]);
+				}
+			}
+			if (glyphs(t, ox + t->getX(), oy + t->getY(), lr, 0, true, lr))
+			{
+				for (int y = lr.y0; y < lr.y1; ++y)
+				{
+					const Uint8 *p = row8(y);
+					for (int x = lr.x0; x < lr.x1; ++x)
+						if (scratch[(size_t)(y - lr.y0) * lw + (x - lr.x0)]) { tag[(size_t)y * bw + x] = p[x]; valid[(size_t)y * bw + x] = 1; }
+				}
+			}
+		}
+		scratch.clear();
+		return;
+	}
+	// A TextEdit - the soldier's name on the equipment screen - draws through a
+	// Text of its own; set that one, masked like a bare Text.
+	if (TextEdit *te = dynamic_cast<TextEdit*>(w))
+	{
+		const Text *t = te->getTextWidget();
+		if (!any || scratch.empty() || !t) return;
+		R r = rectOf(te);
+		if (!clipBase(r) || scratch.size() != (size_t)(r.x1 - r.x0) * (r.y1 - r.y0)) return;
+		bool drew;
+		if (face("label") && !t->getText().empty()) { nativeType(t, te->getX() + t->getX(), te->getY() + t->getY(), roleColour(t->getColor())); drew = true; }
+		else drew = glyphs(t, te->getX() + t->getX(), te->getY() + t->getY(), r, 0, true, r);
+		if (drew)
+		{
+			for (int y = r.y0; y < r.y1; ++y)
+			{
+				const Uint8 *p = row8(y);
+				for (int x = r.x0; x < r.x1; ++x)
+					if (scratch[(size_t)(y - r.y0) * (r.x1 - r.x0) + (x - r.x0)]) tag[y * bw + x] = p[x];
+			}
+		}
+		scratch.clear();
+		return;
+	}
+	if (Text *t = dynamic_cast<Text*>(w))
+	{
+		if (!any || scratch.empty()) return;
+		R r = rectOf(t);
+		if (!clipBase(r) || scratch.size() != (size_t)(r.x1 - r.x0) * (r.y1 - r.y0)) return;
+		// a pixel-font widget (the 7-segment clock) keeps its own font's sharp twin
+		const bool std_ = face("label") && !t->getText().empty() && !pixelTexts.count(t);
+		if (std_) nativeType(t, t->getX(), t->getY(), roleColour(t->getColor()));
+		if (!std_ && !glyphs(t, t->getX(), t->getY(), r, 0, true, r))
+		{
+			if (!t->getText().empty())
+			{
+				Log(LOG_VERBOSE) << "HiUI: text \"" << t->getText() << "\" drew 0 of " << t->getHiGlyphs().size()
+					<< " glyphs at base " << r.x0 << "," << r.y0 << " " << (r.x1 - r.x0) << "x" << (r.y1 - r.y0)
+					<< " (surface " << bw << "x" << bh << ") - leaving this one to the flat renderer";
+			}
+			scratch.clear();
+			return;
+		}
+		for (int y = r.y0; y < r.y1; ++y)
+		{
+			const Uint8 *p = row8(y);
+			for (int x = r.x0; x < r.x1; ++x)
+				if (scratch[(size_t)(y - r.y0) * (r.x1 - r.x0) + (x - r.x0)]) tag[y * bw + x] = p[x];
+		}
+		scratch.clear();
+	}
+}
