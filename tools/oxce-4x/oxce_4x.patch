+/**
+ * G.I. Joe: structural collapse.
+ * A floor, roof or object above ground level is held up by a wall, or a full-height object, on the level below
+ * (on its own tile or one of its four edges), and can bridge up to SPAN tiles of open floor from such a support.
+ * Anything left unsupported after something was destroyed comes down: its parts are removed, whoever stood on it
+ * falls, whoever stood under it is hit by the debris, and the dust fills the room below. Indestructible parts
+ * (armour 255: craft hulls, Cobra ships) never collapse. Collapses chain upward.
+ */
+void TileEngine::structuralCollapse()
+{
+	const int SPAN = 6, WIN = SPAN + 3;
+	auto wallBelow = [&](int x, int y, int z) -> bool
+	{
+		// only something standing to near full height holds a floor up: rubble and low fences do not
+		auto tall = [](MapData *m) { return m && (m->getLoftID(10) != 0 || m->getLoftID(11) != 0 || m->getBigWall() != 0); };
+		Tile *b = _save->getTile(Position(x, y, z - 1));
+		if (!b) return false;
+		if (tall(b->getMapData(O_WESTWALL)) || tall(b->getMapData(O_NORTHWALL)) || tall(b->getMapData(O_OBJECT))) return true;
+		Tile *e = _save->getTile(Position(x + 1, y, z - 1));
+		if (e && tall(e->getMapData(O_WESTWALL))) return true;
+		Tile *s = _save->getTile(Position(x, y + 1, z - 1));
+		if (s && tall(s->getMapData(O_NORTHWALL))) return true;
+		return false;
+	};
+	auto solid = [&](Tile *t) -> bool { return t && (t->getMapData(O_FLOOR) || t->getMapData(O_OBJECT)); };
+	auto indestructible = [&](Tile *t) -> bool
+	{
+		return (t->getMapData(O_FLOOR) && t->getMapData(O_FLOOR)->getArmor() == 255) || (t->getMapData(O_OBJECT) && t->getMapData(O_OBJECT)->getArmor() == 255);
+	};
+	std::vector<Position> changed;
+	auto collapse = [&](Tile *t)
+	{
+		Position p = t->getPosition();
+		for (TilePart part : { O_OBJECT, O_WESTWALL, O_NORTHWALL, O_FLOOR })
+		{
+			MapData *m = t->getMapData(part);
+			if (m && m->getArmor() != 255 && !m->isGravLift()) t->setMapData(nullptr, -1, -1, part);
+		}
+		Tile::destroyedLog.push_back(p);
+		changed.push_back(p);
+		Tile *below = _save->getTile(p - Position(0, 0, 1));
+		if (below)
+		{
+			below->setSmoke(std::max(below->getSmoke(), 8));
+			if (below->getUnit() && below->getUnit()->getHealth() > 0)
+			{
+				BattleActionAttack none; none.type = BA_NONE;
+				hitUnit(none, below->getUnit(), Position(0, 0, 0), RNG::generate(15, 40), _save->getMod()->getDamageType(DT_HE), false);
+			}
+		}
+		applyGravity(t);
+	};
+	int guard = 0;
+	while (!Tile::destroyedLog.empty() && guard++ < 48)
+	{
+		std::vector<Position> events;
+		events.swap(Tile::destroyedLog);
+		std::set<int> done;
+		for (const Position &e : events)
