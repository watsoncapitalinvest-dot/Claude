+void memoryUsedMB(long long &used, long long &total)
+{
+	used = -1; total = -1;
+#ifdef _WIN32
+	MEMORYSTATUSEX ms; ms.dwLength = sizeof(ms);
+	if (GlobalMemoryStatusEx(&ms))
+	{
+		total = (long long)(ms.ullTotalVirtual >> 20);
+		used = (long long)((ms.ullTotalVirtual - ms.ullAvailVirtual) >> 20);
+	}
+#else
+	std::ifstream st("/proc/self/status"); std::string ln;
+	while (std::getline(st, ln)) if (ln.rfind("VmRSS:", 0) == 0) used = std::stoll(ln.substr(6)) / 1024;
+#endif
