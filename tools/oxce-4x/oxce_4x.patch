+	/// Stretch a region of an image into a screen rectangle, blending on its alpha.
+	void stretch(const Img &im, int sx0, int sy0, int sx1, int sy1, int dx0, int dy0, int dx1, int dy1)
+	{
+		if (dx1 <= dx0 || dy1 <= dy0 || sx1 <= sx0 || sy1 <= sy0) return;
+		const int cx0 = std::max(dx0, 0), cy0 = std::max(dy0, 0), cx1 = std::min(dx1, sw), cy1 = std::min(dy1, sh);
+		for (int Y = cy0; Y < cy1; ++Y)
+		{
+			const double fy = sy0 + (Y - dy0 + 0.5) * (sy1 - sy0) / (double)(dy1 - dy0) - 0.5;
+			const int y0 = std::min(sy1 - 1, std::max(sy0, (int)std::floor(fy))), y1 = std::min(sy1 - 1, y0 + 1);
+			const int wy = std::min(256, std::max(0, (int)((fy - y0) * 256)));
+			Uint32 *o = over.data() + (size_t)Y * sw;
+			for (int X = cx0; X < cx1; ++X)
+			{
+				const double fx = sx0 + (X - dx0 + 0.5) * (sx1 - sx0) / (double)(dx1 - dx0) - 0.5;
+				const int x0 = std::min(sx1 - 1, std::max(sx0, (int)std::floor(fx))), x1 = std::min(sx1 - 1, x0 + 1);
+				const int wx = std::min(256, std::max(0, (int)((fx - x0) * 256)));
+				const Uint32 p00 = im.px[(size_t)y0 * im.w + x0], p01 = im.px[(size_t)y0 * im.w + x1];
+				const Uint32 p10 = im.px[(size_t)y1 * im.w + x0], p11 = im.px[(size_t)y1 * im.w + x1];
+				auto ch = [&](int sh2) { return (int)((((p00 >> sh2 & 255) * (256 - wx) + (p01 >> sh2 & 255) * wx) * (256 - wy) + ((p10 >> sh2 & 255) * (256 - wx) + (p11 >> sh2 & 255) * wx) * wy) >> 16); };
