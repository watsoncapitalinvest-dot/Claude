@@ -0,0 +1,654 @@
+/*
+ * G.I. Joe: sound and stealth. See Stealth.h and claude/SOUND_STEALTH_DESIGN_v1.md.
+ */
+#include "Stealth.h"
+#include "../Geoscape/Tips.h"
+#include <cstdlib>
+#include <vector>
+#include <map>
+#include <algorithm>
+#include <cmath>
+#include "AirFight.h"
+#include "TileEngine.h"
+#include "Pathfinding.h"
+#include "../Mod/Mod.h"
+#include "../Mod/RuleItem.h"
+#include "../Mod/RuleDamageType.h"
+#include "../Mod/AlienDeployment.h"
+#include "../Savegame/SavedBattleGame.h"
+#include "../Savegame/BattleUnit.h"
+#include "../Savegame/BattleItem.h"
+#include "../Savegame/Tile.h"
+#include "../Savegame/Soldier.h"
+#include "../Mod/RuleSoldier.h"
+#include "../Engine/RNG.h"
+#include "../Engine/Logger.h"
+
+namespace OpenXcom
+{
+namespace Stealth
+{
+
+namespace
+{
+	SavedBattleGame *mut(const SavedBattleGame *s) { return const_cast<SavedBattleGame*>(s); }
+	std::string key(const char *k, const BattleUnit *u) { return std::string(k) + std::to_string(u->getId()); }
+	int pack(Position p) { return (p.x & 2047) | ((p.y & 2047) << 11) | ((p.z & 31) << 22); }
+	Position unpack(int v) { return Position(v & 2047, (v >> 11) & 2047, (v >> 22) & 31); }
+	bool cobra(const BattleUnit *u) { return u && u->getOriginalFaction() == FACTION_HOSTILE && u->getFaction() == FACTION_HOSTILE; }
+	int seniority(const BattleUnit *u)
+	{
+		static const char *ranks[] = { "STR_LIVE_COMMANDER", "STR_LIVE_LEADER", "STR_LIVE_ENGINEER", "STR_LIVE_MEDIC", "STR_LIVE_NAVIGATOR", "STR_LIVE_SOLDIER", "STR_LIVE_TERRORIST" };
+		for (int i = 0; i < 7; ++i) if (u->getRankString() == ranks[i]) return i;
+		return 8;
+	}
+	bool listed(const std::vector<std::string> &v, const std::string &t) { return std::find(v.begin(), v.end(), t) != v.end(); }
+	std::string typeOf(const BattleUnit *u)
+	{
+		if (u->getGeoscapeSoldier()) return u->getGeoscapeSoldier()->getRules()->getType();
+		return u->getType();
+	}
+	float hearing(const SavedBattleGame *save, const BattleUnit *u)
+	{
+		float h = 0.75f + u->getBaseStats()->reactions / 200.0f;
+		if (listed(save->getMod()->getStealthRules().keenEars, typeOf(u))) h *= 1.25f;
+		if (asleep(save, u)) h *= 0.5f;
+		return h;
+	}
+	/// is this tile under a roof (the tile above has a floor)?
+	bool indoors(SavedBattleGame *save, Position p)
+	{
+		Tile *up = save->getTile(Position(p.x, p.y, p.z + 1));
+		return up && !up->hasNoFloor(save);
+	}
+	/// the radius left between two tiles. SOUND ROUND WALLS (STEALTH_SIGHT_v1 item 10, replaces "walls halve it"): sound
+	/// travels through open tiles only, so a fully enclosed space is silent on the other side; when walls stand on the
+	/// straight line but an opening (door, window, hole) lets it round, it carries about half as far; crossing between inside
+	/// and outside takes a further quarter off; each floor between takes three quarters off as before. A longer way round
+	/// shortens it in proportion. OXCE_STOCK_WALLS=1 = the old halving per wall.
+	float carried(SavedBattleGame *save, Position from, Position to, float r)
+	{
+		const int dz = std::abs(from.z - to.z);
+		for (int i = 0; i < dz && r >= 1; ++i) r /= 4.0f;
+		if (r < 1) return 0;
+		const int z = to.z;
+		// the straight line: are there walls on it?
+		int walls = 0;
+		{
+			int x0 = from.x, y0 = from.y;
+			const int x1 = to.x, y1 = to.y;
+			const int dx = std::abs(x1 - x0), sx = x0 < x1 ? 1 : -1, dy = -std::abs(y1 - y0), sy = y0 < y1 ? 1 : -1;
+			int err = dx + dy;
+			Tile *prev = save->getTile(Position(x0, y0, z));
+			while ((x0 != x1 || y0 != y1) && walls < 6)
+			{
+				const int e2 = 2 * err;
+				if (e2 >= dy) { err += dy; x0 += sx; }
+				if (e2 <= dx) { err += dx; y0 += sy; }
+				Tile *t = save->getTile(Position(x0, y0, z));
+				if (prev && t && save->getTileEngine()->horizontalBlockage(prev, t, DT_NONE, true) > 0) ++walls;
+				prev = t;
+			}
+		}
+		if (getenv("OXCE_STOCK_WALLS")) { for (int i = 0; i < walls; ++i) r /= 2.0f; return r; }
+		const int straight = std::max(std::abs(to.x - from.x), std::abs(to.y - from.y));
+		if (walls == 0 && straight <= (int)r)
+			return indoors(save, from) != indoors(save, to) ? r * 0.75f : r;
+		// the way round: a flood through open tiles on the listener's level, out to the radius
+		const int R = (int)std::ceil(r);
+		std::map<std::pair<int, int>, int> dist;
+		std::vector<Position> q;
+		const Position start(from.x, from.y, z);
+		if (!save->getTile(start)) return 0;
+		dist[{start.x, start.y}] = 0; q.push_back(start);
+		int found = -1;
+		for (size_t h = 0; h < q.size() && found < 0; ++h)
+		{
+			const Position c = q[h];
+			const int d = dist[{c.x, c.y}];
+			if (d >= R) continue;
+			Tile *ct = save->getTile(c);
+			static const int ox[4] = { 1, -1, 0, 0 }, oy[4] = { 0, 0, 1, -1 };
+			for (int k = 0; k < 4; ++k)
+			{
+				const Position n(c.x + ox[k], c.y + oy[k], z);
+				Tile *nt = save->getTile(n);
+				if (!nt || dist.count({n.x, n.y})) continue;
+				if (save->getTileEngine()->horizontalBlockage(ct, nt, DT_NONE, true) > 0) continue;
+				dist[{n.x, n.y}] = d + 1;
+				if (n.x == to.x && n.y == to.y) { found = d + 1; break; }
+				q.push_back(n);
+			}
+		}
+		if (found < 0) return 0;   // enclosed: no way round within earshot
+		float out = r * (walls > 0 ? 0.5f : 1.0f) * std::min(1.0f, (float)std::max(1, straight) / (float)found);
+		if (indoors(save, from) != indoors(save, to)) out *= 0.75f;
+		return out;
+	}
+	int noiseOf(const SavedBattleGame *save, const char *k, int def)
+	{
+		const auto &n = save->getMod()->getStealthRules().noise;
+		auto i = n.find(k);
+		return i == n.end() ? def : i->second;
+	}
+	void setState(SavedBattleGame *save, const BattleUnit *u, int st)
+	{
+		save->setVanStop(key("st:s:", u), st);
+		if (st == ALERT) save->setVanStop(key("st:at:", u), save->getMod()->getStealthRules().alertTurns);
+	}
+	void addMarker(SavedBattleGame *save, Position p)
+	{
+		int n = save->getVanStop("st:mkn");
+		if (n >= 12) return;
+		// within 2 tiles of the true spot
+		p.x += RNG::generate(-2, 2); p.y += RNG::generate(-2, 2);
+		p.x = std::max(0, std::min(save->getMapSizeX() - 1, (int)p.x));
+		p.y = std::max(0, std::min(save->getMapSizeY() - 1, (int)p.y));
+		save->setVanStop("st:mk" + std::to_string(n), pack(p));
+		save->setVanStop("st:mkn", n + 1);
+	}
+	void burnClues(SavedBattleGame *save)
+	{
+		const int pct = save->getMod()->getStealthRules().burnCluesPct;
+		if (pct <= 0) return;
+		std::vector<BattleItem*> clues;
+		for (auto *it : *save->getItems())
+		{
+			if (!it->getTile() || it->getOwner()) continue;
+			const std::string &t = it->getRules()->getType();
+			if (t.rfind("STR_CLUE_", 0) == 0 && t.find("DECOY") == std::string::npos) clues.push_back(it);
+		}
+		int burn = (int)clues.size() * pct / 100;
+		for (int i = 0; i < burn; ++i)
+		{
+			const int j = RNG::generate(0, (int)clues.size() - 1);
+			save->removeItem(clues[j]);
+			clues.erase(clues.begin() + j);
+		}
+		if (burn > 0) Log(LOG_INFO) << "[stealth] the alarm burned " << burn << " clue items";
+	}
+}
+
+bool on(const SavedBattleGame *save) { return save && save->getVanStop("st:on") != 0; }
+bool alarm(const SavedBattleGame *save) { return save->getVanStop("st:alarm") != 0; }
+
+int state(const SavedBattleGame *save, const BattleUnit *u)
+{
+	if (!on(save) || !cobra(u)) return ALERT;
+	if (alarm(save)) return ALERT;
+	if (save->getVanStop("st:ncmp") > 1 && save->getVanStop("st:calarm:" + std::to_string(save->getVanStop(key("st:cmp:", u)))) ) return ALERT;
+	return save->getVanStop(key("st:s:", u), ON_POST);
+}
+bool asleep(const SavedBattleGame *save, const BattleUnit *u) { return on(save) && cobra(u) && state(save, u) == ASLEEP; }
+bool unaware(const SavedBattleGame *save, const BattleUnit *u) { return on(save) && cobra(u) && state(save, u) != ALERT; }
+float reactionFactor(const SavedBattleGame *save, const BattleUnit *u, const BattleUnit *mover)
+{
+	if (!on(save)) return 1.0f;
+	// John 19 Nov 10:11 "Why in my test did they raise alarm": a Joe on overwatch fired at a cartel man walking past
+	// on Cobra's turn and the shot raised the alarm. While the site is quiet the Joes HOLD FIRE: no reaction shot at
+	// a Cobra who is not alert. Once the alarm is up, or at a man who has gone red, they fire as before.
+	if (!cobra(u))
+		return (alarm(save) || !mover || !cobra(mover) || state(save, mover) == ALERT) ? 1.0f : 0.0f;
+	const int s = state(save, u);
+	// John 19 Nov 01:02 "They shoot at me immediately stealth is nothing even when they're blue": a guard who is not
+	// ALERT gets no reaction shot at all. Seeing a Joe on the Joes' turn is still remembered (saw()), and on his own
+	// turn he goes suspicious or alert by the sighting rules - he no longer fires before he has even turned red.
+	return s == ALERT ? 1.0f : 0.0f;
+}
+
+void begin(SavedBattleGame *save)
+{
+	if (save->getVanStop("st:init")) return;
+	save->setVanStop("st:init", 1);
+	const Mod *mod = save->getMod();
+	const auto &r = mod->getStealthRules();
+	if (!r.on || AirFight::isAirFight(mod, save)) return;
+	save->setVanStop("st:on", 1);
+	const std::string &dep = save->getMissionType();
+	bool quiet = false;
+	for (const auto &q : r.quietDeployments)
+	{
+		if (!q.empty() && q.back() == '*' ? dep.rfind(q.substr(0, q.size() - 1), 0) == 0 : dep == q) { quiet = true; break; }
+	}
+	// the bank's own rule says it is quiet until its alarm
+	const AlienDeployment *ad = mod->getDeployment(dep, false);
+	if (ad && ad->getQuietUntilAlarm()) quiet = true;
+	if (!quiet)
+	{
+		save->setVanStop("st:alarm", 1);
+		Log(LOG_INFO) << "[stealth] " << dep << " starts loud";
+		return;
+	}
+	save->setVanStop("st:quiet", 1);
+	const bool night = save->getGlobalShade() >= 9;
+	// regional readiness (item 14): each step a third fewer sleepers; from step 2 the men on post start suspicious
+	const int ready = std::min(3, save->getVanStop("st:ready"));
+	const int sleepPct = (night ? r.sleepNight : r.sleepDay) * (3 - ready) / 3;
+	BattleUnit *radio = nullptr;
+	int sleepers = 0, n = 0;
+	for (auto *u : *save->getUnits())
+	{
+		if (!cobra(u) || u->isOut()) continue;
+		++n;
+		const bool zz = RNG::percent(sleepPct);
+		setState(save, u, zz ? ASLEEP : (ready >= 2 ? WARY : ON_POST));
+		if (zz) ++sleepers;
+		{
+			const int roll = RNG::generate(0, 99);
+			save->setVanStop(key("st:job:", u), roll < 35 ? SENTRY : roll < 60 ? SWEEP : roll < 85 ? PATROL : OFF_DUTY);
+		}
+		// the radio man: the senior man awake
+		if (!zz && (!radio || seniority(u) < seniority(radio))) radio = u;
+	}
+	if (radio) save->setVanStop("st:radio", radio->getId() + 1);
+	{
+		std::vector<BattleUnit*> men;
+		for (auto *u : *save->getUnits()) if (cobra(u) && !u->isOut()) men.push_back(u);
+		std::vector<int> c(men.size(), -1);
+		int nc = 0;
+		for (size_t i = 0; i < men.size(); ++i)
+		{
+			if (c[i] >= 0) continue;
+			c[i] = nc; std::vector<size_t> q{ i };
+			for (size_t h = 0; h < q.size(); ++h)
+				for (size_t j = 0; j < men.size(); ++j)
+					if (c[j] < 0 && Position::distance2d(men[q[h]]->getPosition(), men[j]->getPosition()) <= 15) { c[j] = nc; q.push_back(j); }
+			++nc;
+		}
+		for (size_t i = 0; i < men.size(); ++i) save->setVanStop(key("st:cmp:", men[i]), c[i] + 1);
+		save->setVanStop("st:ncmp", nc);
+		if (nc > 1) Log(LOG_INFO) << "[stealth] " << nc << " compounds: an alarm wakes one, spreading after 4 turns";
+	}
+	Log(LOG_INFO) << "[stealth] " << dep << " starts quiet: " << n << " Cobra, " << sleepers << " asleep (" << (night ? "night" : "day")
+		<< "), radio man " << (radio ? radio->getType() : std::string("none"));
+}
+
+bool tryAlarm(SavedBattleGame *save, const char *why)
+{
+	if (!on(save) || alarm(save)) return false;
+	const int rid = save->getVanStop("st:radio") - 1;
+	BattleUnit *radio = nullptr;
+	for (auto *u : *save->getUnits()) if (u->getId() == rid) radio = u;
+	if (!radio || radio->isOut() || asleep(save, radio) || radio->getStunlevel() >= radio->getHealth())
+	{
+		Log(LOG_INFO) << "[stealth] alarm wanted (" << why << ") but nobody can call it in";
+		return false;
+	}
+	save->setVanStop("st:alarm", 1);
+	for (auto *u : *save->getUnits()) if (cobra(u) && !u->isOut()) setState(save, u, ALERT);
+	burnClues(save);
+	save->setVanStop("st:alarmNews", 1);
+	Tips::battle(save, "ALARM_UP");
+	Log(LOG_INFO) << "[stealth] ALARM (" << why << ") turn " << save->getTurn();
+	return true;
+}
+
+bool tryAlarmAt(SavedBattleGame *save, const char *why, Position where)
+{
+	if (!on(save) || alarm(save)) return false;
+	if (save->getVanStop("st:ncmp") <= 1) return tryAlarm(save, why);
+	// the compound nearest the trouble
+	BattleUnit *near = nullptr;
+	for (auto *u : *save->getUnits())
+		if (cobra(u) && !u->isOut() && (!near || Position::distance2d(u->getPosition(), where) < Position::distance2d(near->getPosition(), where))) near = u;
+	if (!near) return false;
+	const int cmp = save->getVanStop(key("st:cmp:", near));
+	const std::string k = "st:calarm:" + std::to_string(cmp);
+	if (save->getVanStop(k)) return false;
+	save->setVanStop(k, save->getTurn() + 1);
+	if (!save->getVanStop("st:cspread")) save->setVanStop("st:cspread", save->getTurn() + 4);
+	for (auto *u : *save->getUnits()) if (cobra(u) && !u->isOut() && save->getVanStop(key("st:cmp:", u)) == cmp) setState(save, u, ALERT);
+	save->setVanStop("st:alarmNews", 1);
+	Tips::battle(save, "ALARM_SPREAD");
+	Log(LOG_INFO) << "[stealth] ALARM in compound " << cmp << " (" << why << ") turn " << save->getTurn() << "; the site in 4 turns unless the radio man is down";
+	return true;
+}
+
+bool quietWin(const SavedBattleGame *save) { return on(save) && save->getVanStop("st:quiet") && !alarm(save); }
+
+void noise(SavedBattleGame *save, Position at, int rad, const BattleUnit *maker, bool loud)
+{
+	if (!on(save) || rad <= 0) return;
+	const auto &r = save->getMod()->getStealthRules();
+	const bool byCobra = maker && maker->getOriginalFaction() == FACTION_HOSTILE;
+	std::vector<BattleUnit*> goers;
+	bool joeHeard = false;
+	int nearest = 9999, heard = 0;
+	for (auto *u : *save->getUnits())
+	{
+		if (u->isOut() || u == maker || !u->getTile()) continue;
+		const bool listenerCobra = cobra(u);
+		if (byCobra == listenerCobra) continue;
+		if (!listenerCobra && u->getOriginalFaction() != FACTION_PLAYER) continue;
+		const float reach = rad * hearing(save, u);
+		const int d = Position::distance2d(at, u->getPosition());
+		if (listenerCobra) nearest = std::min(nearest, d);
+		if (d > reach) continue;
+		const float c = carried(save, at, u->getPosition(), reach);
+		if (listenerCobra && d <= 15) Log(LOG_DEBUG) << "[stealth]  " << u->getType() << " at " << u->getPosition() << " d " << d << " reach " << reach << " after walls " << c;
+		if (c < std::max(1, d)) continue;
+		if (!listenerCobra) { joeHeard = true; continue; }
+		// a Cobra unit heard it
+		++heard;
+		if (alarm(save)) continue;
+		const int was = state(save, u);
+		setState(save, u, ALERT);
+		bool holds = false;
+		for (auto *g : goers) if (Position::distance2d(g->getPosition(), u->getPosition()) <= r.pairRadius) holds = true;
+		if (!holds) { goers.push_back(u); if (!save->getVanStop(key("st:home:", u))) save->setVanStop(key("st:home:", u), pack(u->getPosition()) + 1); save->setVanStop(key("st:ph:", u), 0); save->setVanStop(key("st:look:", u), pack(at) + 1); }
+		// the shout: everyone near turns to face the noise
+		for (auto *v : *save->getUnits())
+		{
+			if (v == u || !cobra(v) || v->isOut() || asleep(save, v)) continue;
+			if (Position::distance2d(v->getPosition(), u->getPosition()) > r.shoutRadius) continue;
+			v->lookAt(at);
+			while (v->getStatus() == STATUS_TURNING) v->turn();
+		}
+		if (was == ASLEEP) Log(LOG_INFO) << "[stealth] " << u->getType() << " " << u->getId() << " woke";
+		if (loud) tryAlarmAt(save, "gunfire heard", at);
+	}
+	if (!byCobra && rad >= 10) Log(LOG_INFO) << "[stealth] noise " << rad << " at " << at << (loud ? " (loud)" : "") << ": nearest Cobra " << nearest << " tiles, " << heard << " heard it";
+	if (byCobra && joeHeard && !(maker && maker->getVisible()))
+	{
+		addMarker(save, at);
+	}
+}
+
+int radius(const SavedBattleGame *save, const std::string &kind)
+{
+	static const std::map<std::string, int> defs = {
+		{"pistol", 15}, {"rifle", 20}, {"heavy", 25}, {"launcher", 30}, {"explosion", 35}, {"silenced", 4}, {"silencedSniper", 6},
+		{"melee", 2}, {"dart", 2}, {"failedTakedown", 8}, {"window", 8}, {"car", 15}, {"door", 3}, {"walk", 2}, {"run", 5}, {"crouch", 1} };
+	auto d = defs.find(kind);
+	return noiseOf(save, kind.c_str(), d == defs.end() ? 0 : d->second);
+}
+
+bool isDart(const SavedBattleGame *save, const BattleItem *weapon)
+{
+	return weapon && listed(save->getMod()->getStealthRules().dartWeapons, weapon->getRules()->getType());
+}
+
+int shotRadius(const SavedBattleGame *save, const BattleItem *weapon, const BattleItem *ammo)
+{
+	if (!weapon) return 0;
+	const RuleItem *w = weapon->getRules();
+	const RuleItem *a = ammo ? ammo->getRules() : w;
+	std::string kind;
+	if (isDart(save, weapon)) kind = "dart";
+	else
+	{
+		const auto *dt = a->getDamageType();
+		const bool blast = dt && (dt->ResistType == DT_HE || dt->ResistType == DT_IN) || w->getArcingShot() || a->getArcingShot();
+		if (blast) kind = "launcher";
+		else if (w->isFixed() || w->getConfigAuto()->shots >= 5 || w->getWeight() >= 12 || (w->getAccuracyAimed() >= 110 && w->getConfigAuto()->shots <= 1)) kind = "heavy";
+		else if (!w->isTwoHanded()) kind = "pistol";
+		else kind = "rifle";
+	}
+	return radius(save, kind);
+}
+
+void shot(SavedBattleGame *save, const BattleUnit *shooter, const BattleItem *weapon, const BattleItem *ammo)
+{
+	if (!on(save) || !shooter || !weapon) return;
+	const RuleItem *w = weapon->getRules();
+	const RuleItem *a = ammo ? ammo->getRules() : w;
+	std::string kind;
+	if (isDart(save, weapon)) kind = "dart";
+	else
+	{
+		const auto *dt = a->getDamageType();
+		const bool blast = dt && (dt->ResistType == DT_HE || dt->ResistType == DT_IN) || w->getArcingShot() || a->getArcingShot();
+		if (blast) kind = "launcher";
+		else if (w->isFixed() || w->getConfigAuto()->shots >= 5 || w->getWeight() >= 12 || (w->getAccuracyAimed() >= 110 && w->getConfigAuto()->shots <= 1)) kind = "heavy";
+		else if (!w->isTwoHanded()) kind = "pistol";
+		else kind = "rifle";
+	}
+	noise(save, shooter->getPosition(), radius(save, kind), shooter, kind != "dart");
+}
+
+void step(SavedBattleGame *save, const BattleUnit *u)
+{
+	if (!on(save) || !u) return;
+	const std::string k = "st:steps:" + std::to_string(u->getId()) + ":" + std::to_string(save->getTurn());
+	const int n = save->getVanStop(k) + 1;
+	save->setVanStop(k, n);
+	const char *kind = u->isKneeled() ? "crouch" : n > save->getMod()->getStealthRules().runTiles ? "run" : "walk";
+	noise(save, u->getPosition(), radius(save, kind), u, false);
+}
+
+int takedown(SavedBattleGame *save, BattleUnit *attacker, BattleUnit *target, const BattleItem *weapon, bool dart)
+{
+	if (!on(save) || !attacker || !target || target->isOut()) return -1;
+	const bool targetCobra = cobra(target);
+	if (targetCobra && !unaware(save, target)) return -1;
+	if (!targetCobra && !(cobra(attacker) && !attacker->getVisible())) return -1;   // a Cobra ninja the Joes can't see
+	// from behind: outside the target's three front directions
+	const int to = save->getTileEngine()->getDirectionTo(target->getPosition(), attacker->getPosition());
+	const int diff = std::abs(((to - target->getDirection()) + 12) % 8 - 4);   // 4 = straight ahead ... 0 = straight behind
+	if (diff >= 3 && !asleep(save, target)) return -1;
+	const auto &r = save->getMod()->getStealthRules();
+	int chance;
+	if (listed(r.silentUnits, typeOf(attacker))) chance = 100;
+	else
+	{
+		chance = dart ? attacker->getBaseStats()->firing : attacker->getBaseStats()->melee;
+		chance = std::min(chance, r.takedownCap);
+	}
+	const bool ok = RNG::percent(chance);
+	Log(LOG_INFO) << "[stealth] takedown " << attacker->getType() << " on " << target->getType() << " " << chance << "% -> " << (ok ? "silent" : "FAILED");
+	if (!ok)
+	{
+		if (targetCobra) setState(save, target, ALERT);
+		noise(save, target->getPosition(), radius(save, "failedTakedown"), attacker, false);
+	}
+	return ok ? 1 : 0;
+}
+
+Position lookTarget(const SavedBattleGame *save, const BattleUnit *u)
+{
+	const int v = save->getVanStop(key("st:look:", u));
+	return v ? unpack(v - 1) : TileEngine::invalid;
+}
+void clearLook(SavedBattleGame *save, const BattleUnit *u) { save->setVanStop(key("st:look:", u), 0); }
+
+int job(const SavedBattleGame *save, const BattleUnit *u) { return save->getVanStop(key("st:job:", u), PATROL); }
+
+bool elite(const BattleUnit *u)
+{
+	if (!u) return false;
+	const std::string &t = u->getType();
+	for (const char *k : { "CRIMSON", "STORM_SHADOW", "BARONESS", "FIREFLY", "ZARTAN" })
+		if (t.find(k) != std::string::npos) return true;
+	return false;
+}
+
+void arrived(SavedBattleGame *save, BattleUnit *u)
+{
+	const int ph = save->getVanStop(key("st:ph:", u));
+	const int home = save->getVanStop(key("st:home:", u));
+	if (ph < 2)
+	{
+		// search outward: a tile 2-3 away, then another
+		for (int tries = 0; tries < 12; ++tries)
+		{
+			const Position p = u->getPosition() + Position(RNG::generate(-3, 3), RNG::generate(-3, 3), 0);
+			Tile *t = save->getTile(p);
+			if (!t || p == u->getPosition() || t->getUnit() || Position::distance2d(p, u->getPosition()) < 2) continue;
+			save->setVanStop(key("st:ph:", u), ph + 1);
+			save->setVanStop(key("st:look:", u), pack(p) + 1);
+			return;
+		}
+	}
+	if (ph < 3 && home && unpack(home - 1) != u->getPosition())
+	{
+		save->setVanStop(key("st:ph:", u), 3);
+		save->setVanStop(key("st:look:", u), home);   // back to his post
+		return;
+	}
+	if (save->getVanStop(key("st:bed:", u)))
+	{
+		save->setVanStop(key("st:bed:", u), 0);
+		save->setVanStop(key("st:look:", u), 0); save->setVanStop(key("st:ph:", u), 0); save->setVanStop(key("st:home:", u), 0);
+		if (!alarm(save)) { setState(save, u, ASLEEP); Log(LOG_INFO) << "[stealth] " << u->getType() << " " << u->getId() << " off shift, asleep"; }
+		return;
+	}
+		// back on his spot: normal awareness
+	save->setVanStop(key("st:look:", u), 0);
+	save->setVanStop(key("st:ph:", u), 0);
+	save->setVanStop(key("st:home:", u), 0);
+	if (!alarm(save) && state(save, u) == WARY) { setState(save, u, ON_POST); Log(LOG_INFO) << "[stealth] " << u->getType() << " " << u->getId() << " back on post, nothing found"; }
+}
+
+int markers(const SavedBattleGame *save) { return on(save) ? save->getVanStop("st:mkn") : 0; }
+Position marker(const SavedBattleGame *save, int i) { return unpack(save->getVanStop("st:mk" + std::to_string(i))); }
+
+std::string turnStart(SavedBattleGame *save)
+{
+	begin(save);
+	if (!on(save)) return "";
+	std::string msg;
+	if (save->getSide() == FACTION_HOSTILE)
+	{
+		save->setVanStop("st:mkn", 0);
+		if (!alarm(save) && save->getVanStop("st:cspread") && save->getTurn() >= save->getVanStop("st:cspread"))
+		{
+			save->setVanStop("st:cspread", 0);
+			if (!tryAlarm(save, "the alarm spread from the next compound"))   // tryAlarm checks the radio man
+				Log(LOG_INFO) << "[stealth] the compound's alarm did not spread: the radio man is down";
+		}
+		// STEALTH SIGHT item 6: SHIFT CHANGE about every 8 turns while it is quiet. Each sleeper is paired with a guard on post:
+		// the sleeper gets up and walks to that post (and takes the job), the guard walks to the bunk and goes to sleep there.
+		if (save->getVanStop("st:quiet") && !alarm(save) && save->getTurn() > 1 && save->getTurn() % 8 == 0 && save->getVanStop("st:shift") != save->getTurn())
+		{
+			save->setVanStop("st:shift", save->getTurn());
+			std::vector<BattleUnit*> sleepers, posted;
+			for (auto *u : *save->getUnits())
+			{
+				if (!cobra(u) || u->isOut()) continue;
+				const int st = state(save, u);
+				if (st == ASLEEP) sleepers.push_back(u);
+				else if (st == ON_POST && !save->getVanStop(key("st:look:", u))) posted.push_back(u);
+			}
+			int swaps = 0;
+			for (size_t i = 0; i < sleepers.size() && i < posted.size(); ++i)
+			{
+				BattleUnit *s1 = sleepers[i], *p1 = posted[RNG::generate(0, (int)posted.size() - 1)];
+				if (save->getVanStop(key("st:bed:", p1))) continue;
+				const Position bunk = s1->getPosition(), post = p1->getPosition();
+				setState(save, s1, ON_POST);
+				save->setVanStop(key("st:job:", s1), job(save, p1));
+				save->setVanStop(key("st:home:", s1), pack(post) + 1); save->setVanStop(key("st:ph:", s1), 3);
+				save->setVanStop(key("st:look:", s1), pack(post) + 1);
+				save->setVanStop(key("st:bed:", p1), 1);
+				save->setVanStop(key("st:home:", p1), pack(bunk) + 1); save->setVanStop(key("st:ph:", p1), 3);
+				save->setVanStop(key("st:look:", p1), pack(bunk) + 1);
+				++swaps;
+			}
+			if (swaps) Tips::battle(save, "SHIFT_CHANGE");
+			if (swaps) Log(LOG_INFO) << "[stealth] shift change, turn " << save->getTurn() << ": " << swaps << " swap(s)";
+		}
+		for (auto *u : *save->getUnits())
+		{
+			if (!cobra(u) || u->isOut()) continue;
+			if (u->isHandsUp() || u->isCuffed()) continue;   // surrendered: he watches and reports nothing
+			const int s = state(save, u);
+			if (s == ASLEEP) { u->setTimeUnits(0); continue; }
+			if (s == ALERT && !alarm(save))
+			{
+				int left = save->getVanStop(key("st:at:", u)) - 1;
+				save->setVanStop(key("st:at:", u), left);
+				if (left <= 0) setState(save, u, WARY);
+			}
+			// a man who sees a Joe and is still standing at his next turn. STEALTH SIGHT (STEALTH_SIGHT_v1 item 1, John 17:55-18:28):
+			// seen far (> 8 tiles), at night, or crouched = SUSPICIOUS (WARY: he turns and goes to look, calls nobody); close
+			// and standing by day = ALERT. Suspicious and seeing the same Joe again on his next turn = ALERT. No dice.
+			for (auto *v : *u->getVisibleUnits())
+			{
+				if (v->getOriginalFaction() == FACTION_PLAYER && !v->isOut())
+				{
+					if (s == ON_POST && job(save, u) == OFF_DUTY && Position::distance2d(v->getPosition(), u->getPosition()) > 3) continue;   // off duty: only close
+					// John 19 Nov 01:02: 8 tiles made a daylight raid loud on the first look. Only a man close enough to be
+					// sure (4 tiles, elites 6) goes straight to ALERT; beyond that the first look is SUSPICIOUS and a second
+					// look on his next turn makes it ALERT.
+					const bool far = Position::distance2d(v->getPosition(), u->getPosition()) > (elite(u) ? 6 : 4);
+					const bool dark = save->getGlobalShade() >= 10;
+					const bool low = v->isKneeled();
+					const int seenBefore = save->getVanStop(key("st:sj:", u));
+					const bool again = s == WARY && seenBefore == v->getId() + 1 && save->getVanStop(key("st:st:", u)) == save->getTurn() - 1;
+					if ((far || dark || low) && !again)
+					{
+						if (s != ALERT)
+						{
+							setState(save, u, WARY);
+							save->setVanStop(key("st:sj:", u), v->getId() + 1);
+							save->setVanStop(key("st:st:", u), save->getTurn());
+							if (!save->getVanStop(key("st:home:", u))) save->setVanStop(key("st:home:", u), pack(u->getPosition()) + 1);
+							save->setVanStop(key("st:ph:", u), 0);
+							save->setVanStop(key("st:look:", u), pack(v->getPosition()) + 1);   // he walks to look where he saw something
+							Tips::battle(save, "GUARD_AMBER");
+							Log(LOG_INFO) << "[stealth] " << u->getType() << " " << u->getId() << " SUSPICIOUS" << (far ? " far" : "") << (dark ? " dark" : "") << (low ? " crouched" : "");
+						}
+						break;
+					}
+					setState(save, u, ALERT);
+					Tips::battle(save, "GUARD_RED");
+					tryAlarmAt(save, "a Joe seen", u->getPosition());
+					break;
+				}
+			}
+			// a body he can see
+			if (!alarm(save))
+			{
+				for (auto *b : *save->getUnits())
+				{
+					if (!b->isOut() || b->getOriginalFaction() != FACTION_HOSTILE || !b->getTile()) continue;
+					if (Position::distance2d(b->getPosition(), u->getPosition()) > 20) continue;
+					if (save->getTileEngine()->visible(u, b->getTile()))
+					{
+						setState(save, u, ALERT);
+						tryAlarmAt(save, "a body found", u->getPosition());
+						break;
+					}
+				}
+			}
+		}
+	}
+	if (save->getVanStop("st:alarmNews"))
+	{
+		save->setVanStop("st:alarmNews", 0);
+		msg = "STR_COBRA_ALARM_UP";
+	}
+	return msg;
+}
+
+
+namespace
+{
+	// per battle: (Cobra unit id, Joe id) -> the turn it last knew of him. Not saved with the game: a loaded battle starts
+	// with Cobra knowing nothing new (the stock per-faction counters still hold what the whole side saw).
+	std::map<const SavedBattleGame*, std::map<std::pair<int, int>, int>> knownBy;
+}
+
+void saw(SavedBattleGame *save, const BattleUnit *watcher, const BattleUnit *joe)
+{
+	if (!save || !watcher || !joe || watcher->getFaction() != FACTION_HOSTILE || watcher->isHandsUp() || watcher->isCuffed()) return;   // a surrendered man raises nothing
+	auto &k = knownBy[save];
+	const int t = save->getTurn();
+	k[{watcher->getId(), joe->getId()}] = t;
+	// the shout: comrades within 6 tiles of the one who saw him hear where he is
+	for (auto *u : *save->getUnits())
+		if (u != watcher && u->getFaction() == FACTION_HOSTILE && !u->isOut() && Position::distance2d(u->getPosition(), watcher->getPosition()) <= 6)
+			k[{u->getId(), joe->getId()}] = t;
+}
+
+bool knows(const SavedBattleGame *save, const BattleUnit *ai, const BattleUnit *joe, int turns)
+{
+	if (!save || !ai || !joe) return false;
+	if (ai->hasVisibleUnit(joe)) return true;
+	auto b = knownBy.find(save);
+	if (b == knownBy.end()) return false;
+	auto it = b->second.find({ai->getId(), joe->getId()});
+	return it != b->second.end() && save->getTurn() - it->second <= turns;
+}
+}
+}
diff --git a/src/Battlescape/Stealth.h b/src/Battlescape/Stealth.h
new file mode 100644
index 0000000..ea9013a
--- /dev/null
+++ b/src/Battlescape/Stealth.h
@@ -0,0 +1,92 @@
+#pragma once
+/*
+ * G.I. Joe: sound and stealth (claude/SOUND_STEALTH_DESIGN_v1.md, approved by John 14 Nov 23:35).
+ * Noise travels from what a unit does; Cobra units that hear it wake, look and raise the alarm.
+ * All state lives in SavedBattleGame's key/int store (getVanStop / setVanStop), so it saves with the battle.
+ *   st:on        stealth runs in this battle          st:alarm   the alarm is up
+ *   st:quiet     the battle started quiet              st:radio   the radio man's unit id
+ *   st:s:<id>    0 on post / patrol, 1 asleep, 2 wary, 3 alert          st:at:<id>  alert turns left
+ *   st:look:<id> a packed tile the unit is walking to look at          st:mk*      Joe hearing markers
+ */
+#include <string>
+#include "Position.h"
+
+namespace OpenXcom
+{
+
+class BattleUnit;
+class BattleItem;
+class SavedBattleGame;
+class Mod;
+
+namespace Stealth
+{
+	enum State { ON_POST = 0, ASLEEP = 1, WARY = 2, ALERT = 3 };
+
+	/// does stealth run in this battle (set up on the first turn)
