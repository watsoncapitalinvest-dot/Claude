+/**
+ * What Cobra's training camps do to a battle fought at this spot.
+ *
+ * A camp cannot refill a garrison, because X-COM keeps no garrison to refill: a site's defenders
+ * are generated from its deployment every time it is raided, so nothing depletes and nothing
+ * needs topping up. What a camp can do is change what that deployment produces in its own
+ * region - more defenders, and ranks that otherwise never turn out.
+ *
+ * Both are read off the camp's own rule rather than hardcoded, so a second kind of camp, or a
+ * camp that only hardens its own compounds, is a ruleset edit.
+ */
+SavedGame::CobraGarrison SavedGame::cobraGarrison(const Mod *mod, double lon, double lat, bool cobraSite) const
+{
+	CobraGarrison out;
+	bool campHere = false;
+	// Set before the region lookup and before any early return: the escalation calendar is a
+	// STORY rule, not an economy one, so it binds every Cobra battle - crash site, terror site,
+	// New Battle - whether or not this fight has a place on the globe. The economy may make
+	// Cobra poorer than the calendar allows; it must never make Cobra better armed than it does.
+	// Two ceilings, and the harsher wins. The month table is an absolute backstop the story
+	// sets; research is the organic driver inside it, which is what a Cobra player will be
+	// playing. With no projects authored, research returns -1 and the table rules alone, so the
+	// behaviour verified before this existed is unchanged.
+	out.maxKitTier = mod->getCobraKitTierCap((size_t)getMonthsPassed());
+	const int researched = cobraResearchedKitTier(mod);
+	if (researched >= 0 && (out.maxKitTier < 0 || researched < out.maxKitTier))
+	{
+		out.maxKitTier = researched;
+	}
+	// Quiet on purpose. A New Battle has no globe position - its mission sits at [0, 0], which is
+	// inside no region - and this returning "no garrison" is the right answer there, not an
+	// error. Removing the _craft fallback closed one route to that false log line and left
+	// _mission and _ufo open, which a campaign run could not reveal because every campaign
+	// target has a real position. It took running the battlescape harness to see it at all.
+	const Region *here = locateRegionQuiet(lon, lat);
+	if (!here)
+	{
+		return out;
+	}
+	const std::string &region = here->getRules()->getType();
+
+	// Can Cobra arm the men it keeps here? The stock is regional on purpose - materiel is
+	// physical and sits where it was made - so a region Cobra cannot supply fields badly armed
+	// troops even while another region is overflowing. That is the whole reason the convoys
+	// matter: guns have to travel, and travelling is where you can meet them.
+	const int wellSupplied = mod->getCobraWellSupplied();
+	if (wellSupplied > 0 && (cobraSite || mod->getCobraSupplyAllMissions()))
+	{
+		out.wellSupplied = _cobraEconomy->getMateriel(region) >= wellSupplied;
+	}
+
+	// One pass over the sites, for two unrelated sums: what this region owes in upkeep, and
+	// whether a training camp stands in it.
+	int upkeepOwed = 0;
+	for (const auto *base : _alienBases)
+	{
+		if (base->getSiteType().empty())
+		{
+			continue;
+		}
+		const RuleCobraSite *rule = mod->getCobraSite(base->getSiteType());
+		if (!rule)
+		{
+			continue;
+		}
+		const Region *there = locateRegion(*base);
+		if (!there || there->getRules()->getType() != region)
+		{
+			continue;
+		}
+		// Every Cobra site in the region owes its upkeep here, camp or not.
+		upkeepOwed += rule->getUpkeepFunds();
+
+		if (rule->getGarrisonBonus() == 0 && rule->getGarrisonRankUnlock() < 0)
+		{
+			continue;
+		}
+		// A camp that only hardens Cobra's own compounds does nothing to a crash site.
+		if (!cobraSite && !rule->getGarrisonAllMissions())
+		{
+			continue;
+		}
+		out.bonus += rule->getGarrisonBonus();
+		campHere = true;
+	}
+
+	// And can it pay for them? John: "if the troops portion of that fails then cobra should have
+	// less troops available. Even if they have the best guns." So the two resources fail in two
+	// different ways on the same map and a player can tell which one he has cut: a region out of
+	// MATERIEL fields a full garrison carrying sidearms, a region out of FUNDS fields a thin one
+	// carrying whatever the campaign would normally give it. Cutting both does both.
+	//
+	// The bar is what the region OWES, not a flat number. A 400-day run settled that: regional
+	// funds accumulate, so Cobra drops under any fixed threshold in month one and never returns
+	// - lowest seen was 110 against a threshold of 40, and the rule fired zero times in 400
+	// days. Measured against its own upkeep it rises as Cobra grows there, and a region that
+	// cannot cover its garrison's keep for N months cannot field that garrison at full strength.
+	// wellPaidFunds survives as a flat floor for anyone who wants one; either test failing is
+	// enough, and both at 0 switches the half off.
+	if (mod->getCobraStarvedHeadcount() > 0 && (cobraSite || mod->getCobraSupplyAllMissions()))
+	{
+		const int funds = _cobraEconomy->getFunds(region);
+		const int flat = mod->getCobraWellPaid();
+		const int months = mod->getCobraWellPaidUpkeep();
+		const bool underFlat = flat > 0 && funds < flat;
+		const bool underKeep = months > 0 && upkeepOwed > 0 && funds < upkeepOwed * months;
+		if (underFlat || underKeep)
+		{
+			out.headcountPenalty = mod->getCobraStarvedHeadcount();
+		}
+	}
+
+	// A camp lifts the cap entirely, so out.rankUnlock stays -1. With no camp standing, the cap
+	// a camp WOULD have lifted is the one that applies. Tracked with its own flag rather than
+	// inferred from the bonus, because a camp priced at garrisonBonus 0 is still a camp and
+	// would otherwise have left its own region capped.
+	if (!campHere)
+	{
+		for (const auto &siteType : mod->getCobraSitesList())
+		{
+			const RuleCobraSite *rule = mod->getCobraSite(siteType);
+			if (rule && rule->getGarrisonRankUnlock() >= 0
+				&& (cobraSite || rule->getGarrisonAllMissions()))
+			{
+				out.rankUnlock = rule->getGarrisonRankUnlock();
+				break;
+			}
+		}
+	}
+	return out;
+}
