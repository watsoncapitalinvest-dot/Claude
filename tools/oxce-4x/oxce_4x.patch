+ * @return how many leads were dropped.
+ */
+int SavedGame::addCobraSiteIntel(const std::string &siteType)
+{
+	int dropped = 0;
+	for (auto* ab : _alienBases)
+	{
+		if (ab->getSiteType() != siteType || ab->isDiscovered())
+		{
+			continue;
+		}
+		// one lead per site, however many topics point at it
+		bool already = false;
+		for (const auto& m : _globeMarks)
+		{
+			if (m.fromIntel && std::abs(m.lon - ab->getLongitude()) < 0.0001
+				&& std::abs(m.lat - ab->getLatitude()) < 0.0001)
+			{
+				already = true;
+				break;
+			}
+		}
+		if (already)
+		{
+			continue;
+		}
+		GlobeMark mark;
+		mark.id = ++_globeMarkId;
+		mark.lon = ab->getLongitude();
+		mark.lat = ab->getLatitude();
+		mark.kind = GlobeMark::MARK_PIN;
+		mark.trust = GlobeMark::TRUST_LIKELY;
+		mark.fromIntel = true;
+		mark.placedMonth = _monthsPassed;
+		// the site type is the label a lead can honestly carry: the player has
+		// heard there is a Drome here, not what Cobra calls it
+		mark.label = ab->getSiteType();
