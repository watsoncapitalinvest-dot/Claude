+	// ===================================================================== THE GLOBE
+	//
+	// The 8-bit globe is a 256x200 surface zoomed six times, so a 2048-wide
+	// earth texture reaches the screen as 6x6 blocks. Here the same projection
+	// is inverted per DISPLAY pixel and the texture sampled bilinearly, so the
+	// earth is as sharp as the texture is. Two caches: the land sample per
+	// pixel (rebuilt when the globe turns or zooms) and the shaded colour
+	// (rebuilt when the sun moves), so a still globe costs one copy a frame.
+	const double GPI = 3.14159265358979323846;
+	bool lastActive = false;
+	// The globe's own rectangle: base (gb*) and display (gc*). Everything the top
+	// layer draws stays inside it, or a name near the edge is printed over the
+	// side panel - which the panel has already claimed this frame.
+	int gbx0 = 0, gby0 = 0, gbx1 = 0, gby1 = 0, gcx0 = 0, gcy0 = 0, gcx1 = 0, gcy1 = 0;
+	/// Draw `fn` into the overlay, then put back every pixel it touched outside the globe.
+	template <class F> void clipToGlobe(double x0, double y0, double x1, double y1, F fn)
+	{
+		const int X0 = std::max(0, (int)std::floor(x0)), Y0 = std::max(0, (int)std::floor(y0));
+		const int X1 = std::min(sw, (int)std::ceil(x1)), Y1 = std::min(sh, (int)std::ceil(y1));
+		if (X0 >= gcx0 && Y0 >= gcy0 && X1 <= gcx1 && Y1 <= gcy1) { fn(); return; }
+		if (X1 <= X0 || Y1 <= Y0) return;
+		std::vector<Uint32> keep((size_t)(X1 - X0) * (Y1 - Y0));
+		for (int Y = Y0; Y < Y1; ++Y) memcpy(&keep[(size_t)(Y - Y0) * (X1 - X0)], over.data() + (size_t)Y * sw + X0, (size_t)(X1 - X0) * 4);
+		fn();
+		for (int Y = Y0; Y < Y1; ++Y)
+			for (int X = X0; X < X1; ++X)
+				if (X < gcx0 || X >= gcx1 || Y < gcy0 || Y >= gcy1) over[(size_t)Y * sw + X] = keep[(size_t)(Y - Y0) * (X1 - X0) + (X - X0)];
+	}
+	struct GlobeHD
+	{
+		GlobeView v; bool have = false;
+		std::vector<GlobeLabel> labels; std::vector<GlobePin> pins; std::vector<GlobeArt> art;
+		const Surface *texSrc = nullptr; Uint32 texKey = 0; Img tex;
+		int X0 = 0, Y0 = 0, X1 = 0, Y1 = 0;
+		double gkey[9] = {};
+		std::vector<Uint32> land;                 // ARGB, alpha = how much of this pixel is land
+		double skey[4] = {};
+		std::vector<Uint32> out; std::vector<Uint8> cov;
+		bool geomOk = false, shadeOk = false;
+	} G;
+
+	void globeTexture()
+	{
+		const Surface *t = G.v.texture;
+		if (!t) { G.tex = Img(); G.texSrc = nullptr; return; }
+		// a full-colour twin (earth_hi.png beside earth.png) wins if the mod has one
+		auto twin = bgImages.find(t);
+		if (twin != bgImages.end() && twin->second.ok)
+		{
+			if (G.texSrc != t || G.texKey != 1) { G.tex = twin->second; G.texSrc = t; G.texKey = 1; G.geomOk = false; }
+			return;
+		}
+		// otherwise the 8-bit texture itself, at its own 2048x1024, in the palette
+		// the globe is drawn in. Sea (index 0) is transparent: the ocean is shaded.
+		const Uint32 key = palHash(base->format->palette->colors) | 2u;
+		if (G.texSrc == t && G.texKey == key && G.tex.ok) return;
+		const SDL_Color *pal = base->format->palette->colors;
+		const int w = t->getWidth(), h = t->getHeight(), pitch = t->getPitch();
+		const Uint8 *src = t->getBuffer();
+		Img im; im.w = w; im.h = h; im.px.assign((size_t)w * h, 0); im.ok = src != nullptr && w > 1 && h > 1;
+		if (im.ok)
+			for (int y = 0; y < h; ++y)
+				for (int x = 0; x < w; ++x)
+				{
+					const Uint8 c = src[y * pitch + x];
+					if (c) im.px[(size_t)y * w + x] = 0xFF000000u | rgb(pal[c].r, pal[c].g, pal[c].b);
+				}
+		G.tex = std::move(im); G.texSrc = t; G.texKey = key; G.geomOk = false;
+	}
+
+	/// Bilinear, wrapping east-west, clamped at the poles. Colour is averaged over
+	/// the land texels only, so a coast fades to sea instead of to black.
+	inline Uint32 sampleEarth(const Img &im, double u, double v)
+	{
+		const double fx = u - 0.5, fy = v - 0.5;
+		int x0 = (int)std::floor(fx), y0 = (int)std::floor(fy);
+		const double ax = fx - x0, ay = fy - y0;
+		int x1 = x0 + 1, y1 = y0 + 1;
+		x0 = ((x0 % im.w) + im.w) % im.w; x1 = ((x1 % im.w) + im.w) % im.w;
+		y0 = std::max(0, std::min(im.h - 1, y0)); y1 = std::max(0, std::min(im.h - 1, y1));
+		const Uint32 p[4] = { im.px[(size_t)y0 * im.w + x0], im.px[(size_t)y0 * im.w + x1], im.px[(size_t)y1 * im.w + x0], im.px[(size_t)y1 * im.w + x1] };
+		const double wt[4] = { (1 - ax) * (1 - ay), ax * (1 - ay), (1 - ax) * ay, ax * ay };
+		double A = 0, r = 0, g = 0, b = 0;
+		for (int i = 0; i < 4; ++i)
+		{
+			const double a = wt[i] * (p[i] >> 24) / 255.0;
+			A += a; r += a * ((p[i] >> 16) & 255); g += a * ((p[i] >> 8) & 255); b += a * (p[i] & 255);
+		}
+		if (A <= 1e-6) return 0;
+		return ((Uint32)std::min(255.0, A * 255.0 + 0.5) << 24) | rgb((int)(r / A + 0.5), (int)(g / A + 0.5), (int)(b / A + 0.5));
+	}
+
+	void globeBox(int &X0, int &Y0, int &X1, int &Y1)
+	{
+		const Surface *g = G.v.globe;
+		const int gx0 = std::max(0, std::min(bw, g->getX())), gx1 = std::max(0, std::min(bw, g->getX() + g->getWidth()));
+		const int gy0 = std::max(0, std::min(bh, g->getY())), gy1 = std::max(0, std::min(bh, g->getY() + g->getHeight()));
+		const double k = SK(), cx = DX(G.v.cenX), cy = DY(G.v.cenY), R = G.v.radius * k;
+		X0 = std::max(xs[gx0], (int)std::floor(cx - R - 2)); X1 = std::min(xs[gx1], (int)std::ceil(cx + R + 2));
+		Y0 = std::max(ys[gy0], (int)std::floor(cy - R - 2)); Y1 = std::min(ys[gy1], (int)std::ceil(cy + R + 2));
+		if (X1 < X0) X1 = X0;
+		if (Y1 < Y0) Y1 = Y0;
+	}
+
+	void globeGeometry()
+	{
+		const double k = SK(), cx = DX(G.v.cenX), cy = DY(G.v.cenY), R = G.v.radius * k;
+		const double key[9] = { G.v.cenX, G.v.cenY, G.v.radius, G.v.cenLon, G.v.cenLat, (double)xs[0], (double)ys[0], k, (double)reinterpret_cast<uintptr_t>(G.tex.px.data()) };
+		if (G.geomOk && std::equal(key, key + 9, G.gkey)) return;
+		std::copy(key, key + 9, G.gkey);
+		const Uint32 t0 = SDL_GetTicks();
+		globeBox(G.X0, G.Y0, G.X1, G.Y1);
+		const int W = G.X1 - G.X0, H = G.Y1 - G.Y0;
+		G.land.assign((size_t)W * H, 0);
+		const double s0 = std::sin(G.v.cenLat), c0 = std::cos(G.v.cenLat);
+		const double tw = G.tex.w, th = G.tex.h;
+		if (G.tex.ok)
+			for (int Y = 0; Y < H; ++Y)
+			{
+				const double dy = (G.Y0 + Y + 0.5 - cy) / R;
+				for (int X = 0; X < W; ++X)
+				{
+					const double dx = (G.X0 + X + 0.5 - cx) / R;
+					double r2 = dx * dx + dy * dy;
+					if (r2 > 1.0 + 4.0 / R) continue;
+					r2 = std::min(r2, 0.999999);
+					const double nz = std::sqrt(1.0 - r2);
+					// cartToPolar, written with the unit normal: the same projection
+					const double lat = std::asin(std::max(-1.0, std::min(1.0, dy * c0 + nz * s0)));
+					const double lon = G.v.cenLon + std::atan2(dx, nz * c0 - dy * s0);
+					const double u = lon / (2 * GPI) * tw;
+					const double v = (GPI / 2 - lat) / GPI * th;
+					G.land[(size_t)Y * W + X] = sampleEarth(G.tex, u, v);
+				}
+			}
+		G.geomOk = true; G.shadeOk = false;
+		const Uint32 ms = SDL_GetTicks() - t0;
+		static int logged = 0;
+		if (logged < 3 && ms > 30) { ++logged; Log(LOG_INFO) << "HiUI globe: " << W << "x" << H << " re-projected in " << ms << " ms"; }
+	}
+
+	void globeShade()
+	{
+		const double key[4] = { G.v.sunX, G.v.sunY, G.v.sunZ, (double)G.v.ocean };
+		// the sun creeps every game tick; redoing the whole disc for a move nobody can see
+		// was a large part of every Geoscape frame (12 Nov profile)
+		if (G.shadeOk && key[3] == G.skey[3] && std::fabs(key[0] - G.skey[0]) < 0.004 && std::fabs(key[1] - G.skey[1]) < 0.004 && std::fabs(key[2] - G.skey[2]) < 0.004) return;
+		std::copy(key, key + 4, G.skey);
+		const SDL_Color *pal = base->format->palette->colors;
+		// the ocean's own 32-step ramp; land is darkened by the same ratio the
+		// ramp falls by, so day and night agree between the two
+		double ramp[33][3], fac[33];
+		for (int i = 0; i < 33; ++i)
+		{
+			const int idx = std::max(0, std::min(255, G.v.ocean + (G.v.oceanShading ? std::min(i, 31) : 0)));
+			ramp[i][0] = pal[idx].r; ramp[i][1] = pal[idx].g; ramp[i][2] = pal[idx].b;
+		}
+		const double l0 = std::max(1.0, ramp[0][0] * 0.3 + ramp[0][1] * 0.59 + ramp[0][2] * 0.11);
+		for (int i = 0; i < 33; ++i)
+		{
+			const double l = ramp[i][0] * 0.3 + ramp[i][1] * 0.59 + ramp[i][2] * 0.11;
+			fac[i] = G.v.oceanShading ? std::max(0.14, std::min(1.0, l / l0)) : 1.0 - 0.7 * std::min(i, 31) / 31.0;
+		}
+		const double k = SK(), cx = DX(G.v.cenX), cy = DY(G.v.cenY), R = G.v.radius * k;
+		const int W = G.X1 - G.X0, H = G.Y1 - G.Y0;
+		G.out.assign((size_t)W * H, 0); G.cov.assign((size_t)W * H, 0);
+		const size_t nShade = G.v.shade.size();
+		for (int Y = 0; Y < H; ++Y)
+		{
+			const double dy = (G.Y0 + Y + 0.5 - cy) / R;
+			for (int X = 0; X < W; ++X)
+			{
+				const double dx = (G.X0 + X + 0.5 - cx) / R;
+				const double r2 = dx * dx + dy * dy;
+				const double d = (1.0 - std::sqrt(r2)) * R;           // display px inside the limb
+				const double c = std::max(0.0, std::min(1.0, d + 0.5));
+				if (c <= 0) continue;
+				const size_t i = (size_t)Y * W + X;
+				G.cov[i] = (Uint8)(c * 255 + 0.5);
+				const double nz = std::sqrt(std::max(0.0, 1.0 - r2));
+				const double dot = dx * G.v.sunX + dy * G.v.sunY + nz * G.v.sunZ;
+				const double t = -250.0 * dot + 128.0;
+				double s = 0;
+				if (nShade) s = G.v.shade[std::max(0, std::min((int)nShade - 1, (int)(t * 4)))];
+				s = std::max(0.0, std::min(31.0, s));
+				const int s0 = (int)s; const double sf = s - s0;
+				const double oc[3] = { ramp[s0][0] + (ramp[s0 + 1][0] - ramp[s0][0]) * sf, ramp[s0][1] + (ramp[s0 + 1][1] - ramp[s0][1]) * sf, ramp[s0][2] + (ramp[s0 + 1][2] - ramp[s0][2]) * sf };
+				const double f = fac[s0] + (fac[s0 + 1] - fac[s0]) * sf;
+				const Uint32 lp = G.land[i];
+				const double a = (lp >> 24) / 255.0;
+				const double r = oc[0] * (1 - a) + ((lp >> 16) & 255) * f * a;
+				const double g = oc[1] * (1 - a) + ((lp >> 8) & 255) * f * a;
+				const double b = oc[2] * (1 - a) + (lp & 255) * f * a;
+				G.out[i] = rgb((int)std::min(255.0, r + 0.5), (int)std::min(255.0, g + 0.5), (int)std::min(255.0, b + 0.5));
+			}
+		}
+		G.shadeOk = true;
+	}
+
+	/// Anti-aliased disc and ring, solid colour.
+	void ringAA(double cx, double cy, double rIn, double rOut, Uint32 col, int alpha = 255)
+	{
+		const int X0 = std::max(0, (int)std::floor(cx - rOut - 1)), X1 = std::min(sw, (int)std::ceil(cx + rOut + 1));
+		const int Y0 = std::max(0, (int)std::floor(cy - rOut - 1)), Y1 = std::min(sh, (int)std::ceil(cy + rOut + 1));
+		for (int Y = Y0; Y < Y1; ++Y)
+		{
+			Uint32 *o = over.data() + (size_t)Y * sw;
+			for (int X = X0; X < X1; ++X)
+			{
+				const double d = std::sqrt((X + 0.5 - cx) * (X + 0.5 - cx) + (Y + 0.5 - cy) * (Y + 0.5 - cy));
+				double c = std::max(0.0, std::min(1.0, rOut - d + 0.5));
+				if (rIn > 0) c -= std::max(0.0, std::min(1.0, rIn - d + 0.5));
+				if (c > 0) o[X] = mix(o[X], col, (int)(c * alpha));
+			}
+		}
+	}
+
+	/// Take over a base rect for the globe's top layer: pixels not already the
+	/// overlay's start from their flat colour, and vector strokes stand clear.
+	void globeClaimRect(R r)
+	{
+		r.x0 = std::max(r.x0, gbx0); r.y0 = std::max(r.y0, gby0); r.x1 = std::min(r.x1, gbx1); r.y1 = std::min(r.y1, gby1);
+		if (!clipBase(r)) return;
+		const SDL_Color *pal = base->format->palette->colors;
+		for (int by = r.y0; by < r.y1; ++by)
+		{
+			const Uint8 *p = row8(by);
+			for (int bx = r.x0; bx < r.x1; ++bx)
+			{
+				const size_t bi = (size_t)by * bw + bx;
+				if (!(valid[bi] && tag[bi] == p[bx]))
+				{
+					const Uint32 flat = rgb(pal[p[bx]].r, pal[p[bx]].g, pal[p[bx]].b);
+					fillRect(xs[bx], ys[by], xs[bx + 1], ys[by + 1], flat);
+					tag[bi] = p[bx]; valid[bi] = 1;
+				}
+				if (vvalid.size() == (size_t)bw * bh) vvalid[bi] = 0;
+			}
+		}
+		any = true;
+	}
+
+	/// Small caps: capitals at full size, lower case set as capitals at 78%.
+	double smallCapsWidth(const Face &f, const std::string &s, double size)
+	{
+		double w = 0;
+		for (int c : latin1(s))
+		{
+			const bool low = c >= 'a' && c <= 'z';
+			const int g = low ? c - 32 : c;
+			if (f.g[g].ok) w += f.g[g].adv * (low ? size * 0.78 : size) / f.em;
+		}
+		return w;
+	}
+	void smallCaps(const Face &f, const std::string &s, double x, double baseline, double size, Uint32 col)
+	{
+		for (int c : latin1(s))
+		{
+			const bool low = c >= 'a' && c <= 'z';
+			std::vector<int> one{ low ? c - 32 : c };
+			const double sz = low ? size * 0.78 : size;
+			drawLine(f, one, 0, 1, x, baseline, sz, col, 0, 0, sw, sh);
+			if (f.g[one[0]].ok) x += f.g[one[0]].adv * sz / f.em;
+		}
+	}
+
+	void globePin(const GlobePin &p)
+	{
+		const double k = SK(), cx = DX(p.x), cy = DY(p.y);
+		const int a = p.lit ? 255 : 170;
+		const double s = k * 2.1;          // half-size of a pin
+		const double o = std::max(1.5, k * 0.42);   // dark outline
+		auto poly = [&](std::vector<std::pair<double, double> > pts, double grow, Uint32 col, int al)
+		{
+			// grow a convex shape outward about its centre, for the outline
+			for (auto &q : pts) { const double vx = q.first - cx, vy = q.second - cy, L = std::sqrt(vx * vx + vy * vy); if (L > 0) { q.first += vx / L * grow; q.second += vy / L * grow; } }
+			polygonAA(pts, col, al);
+		};
+		switch (p.kind)
+		{
+		case PIN_JOE_BASE:                  // square: olive with a yellow rim
+			roundRect(cx - s - o, cy - s - o, cx + s + o, cy + s + o, k * 0.5, S_INK, 230);
+			roundRect(cx - s, cy - s, cx + s, cy + s, k * 0.35, S_YELLOW, a);
+			roundRect(cx - s + k * 0.5, cy - s + k * 0.5, cx + s - k * 0.5, cy + s - k * 0.5, k * 0.2, S_OLIVE_LIT, 255);
+			break;
+		case PIN_COBRA_SITE:                // diamond: red
+		{
+			const double d = s * 1.3;
+			std::vector<std::pair<double, double> > dia{ { cx, cy - d }, { cx + d, cy }, { cx, cy + d }, { cx - d, cy } };
+			poly(dia, o * 1.4, S_INK, 230);
+			poly(dia, 0, 0xD8392B, a);
+			std::vector<std::pair<double, double> > in{ { cx, cy - d * 0.38 }, { cx + d * 0.38, cy }, { cx, cy + d * 0.38 }, { cx - d * 0.38, cy } };
+			poly(in, 0, 0x3A0E0A, 220);
+			break;
+		}
+		case PIN_MISSION:                   // triangle: orange
+		{
+			const double d = s * 1.35;
+			std::vector<std::pair<double, double> > tri{ { cx, cy - d }, { cx + d * 0.95, cy + d * 0.7 }, { cx - d * 0.95, cy + d * 0.7 } };
+			poly(tri, o * 1.5, S_INK, 230);
+			poly(tri, 0, 0xE8873A, a);
+			break;
+		}
+		case PIN_CONTACT:                   // ring: white
+			ringAA(cx, cy, s * 0.55 - o, s * 1.1 + o, S_INK, 200);
+			ringAA(cx, cy, s * 0.62, s * 1.0, 0xF4F3EE, a);
+			ringAA(cx, cy, 0, s * 0.2, 0xF4F3EE, a);
+			break;
+		case PIN_JOE_CRAFT:                 // arrowhead: cyan
+		{
+			const double d = s * 1.25;
+			std::vector<std::pair<double, double> > hd{ { cx, cy - d }, { cx + d * 0.8, cy + d * 0.8 }, { cx, cy + d * 0.35 }, { cx - d * 0.8, cy + d * 0.8 } };
+			// not convex, so two halves
+			std::vector<std::pair<double, double> > L{ hd[0], hd[2], hd[3] }, Rr{ hd[0], hd[1], hd[2] };
+			poly(L, o * 1.4, S_INK, 220); poly(Rr, o * 1.4, S_INK, 220);
+			poly(L, 0, 0x45D3E8, a); poly(Rr, 0, 0x45D3E8, a);
+			break;
+		}
+		case PIN_WAYPOINT:                  // small cross: cyan
+			roundRect(cx - s * 0.9, cy - k * 0.45, cx + s * 0.9, cy + k * 0.45, k * 0.2, 0x45D3E8, a);
+			roundRect(cx - k * 0.45, cy - s * 0.9, cx + k * 0.45, cy + s * 0.9, k * 0.2, 0x45D3E8, a);
+			break;
+		case PIN_SHIP:                      // a small hull, bow up: pale grey (civilian shipping); red when hijacked
+		case PIN_SHIP_HIJACKED:
+		case PIN_SHIP_SUSPECTED:
+		case PIN_SHIP_CONFIRMED:
+		{
+			const double w = s * 0.42, h = s * 0.95;
+			std::vector<std::pair<double, double> > hull{ { cx, cy - h * 1.15 }, { cx + w, cy - h * 0.45 }, { cx + w, cy + h }, { cx - w, cy + h }, { cx - w, cy - h * 0.45 } };
+			poly(hull, o * 1.2, S_INK, 200);
+			const Uint32 col = p.kind == PIN_SHIP_HIJACKED ? 0xFF6A3C : p.kind == PIN_SHIP_CONFIRMED ? 0xD8392B : p.kind == PIN_SHIP_SUSPECTED ? 0xE8A33A : 0xC8CCD2;
+			poly(hull, 0, col, p.kind == PIN_SHIP ? (p.lit ? 230 : 150) : a);
+			break;
+		}
+		case PIN_CITY:                      // dot: bone
+			ringAA(cx, cy, 0, k * 0.75 + o * 0.6, S_INK, 200);
+			ringAA(cx, cy, 0, k * 0.75, S_TEXT, 255);
+			break;
+		}
+	}
+
+	void globeLabel(const GlobeLabel &l)
+	{
+		const Face *f = face("label");
+		if (!f || l.text.empty()) return;
+		const double k = SK();
+		const double cap = (l.kind == 0 ? 3.4 : 2.9) * k;
+		const double size = cap * f->em / f->cap;
+		const double w = smallCapsWidth(*f, l.text, size);
+		const double x = DX(l.x) - w / 2, top = DY(l.y) + k * 0.6, baseline = top + cap;
+		const Uint32 col = l.kind == 0 ? S_TEXT : l.kind == 1 ? S_MUTED : l.kind == 2 ? S_YELLOW : 0xC9A13E;
+		// the base pixels the type covers, outline included
+		const double pad = k * 0.6;
+		R r{ (int)std::floor((x - pad - xs[0]) / k), (int)std::floor((top - pad - ys[0]) / k), (int)std::ceil((x + w + pad - xs[0]) / k), (int)std::ceil((baseline + pad - ys[0]) / k) };
+		globeClaimRect(r);
+		// a dark outline all round, then the letters
+		const double ow = std::max(1.5, k * 0.33);
+		clipToGlobe(x - pad, top - pad - cap, x + w + pad, baseline + pad + cap, [&]()
+		{
+			for (int dy = -1; dy <= 1; ++dy)
+				for (int dx = -1; dx <= 1; ++dx)
+					if (dx || dy) smallCaps(*f, l.text, x + dx * ow, baseline + dy * ow, size, S_INK);
+			smallCaps(*f, l.text, x, baseline, size, col);
+		});
+	}
+}
+
+bool enabled()
+{
+	static int on = -1;
+	if (on < 0)
+	{
+		const char *e = getenv("OXCE_HIUI");
+		on = e ? (atoi(e) != 0) : HiColor::enabled();
+	}
+	return on != 0;
+}
+
+void registerFontImage(const Surface *sheet8, const std::string &file)
+{
+	if (!enabled() || !sheet8) return;
+	const auto dot = file.find_last_of('.');
+	if (dot == std::string::npos) return;
+	const std::string twin = file.substr(0, dot) + "_hi.png";
+	if (!FileMap::fileExists(twin)) return;
+	SDL_Surface *img = IMG_Load_RW(FileMap::getRWops(twin), SDL_TRUE);
+	if (!img) return;
+	SDL_PixelFormat fmt = {};
+	fmt.BitsPerPixel = 32; fmt.BytesPerPixel = 4;
+	fmt.Rmask = 0x00FF0000; fmt.Gmask = 0x0000FF00; fmt.Bmask = 0x000000FF; fmt.Amask = 0xFF000000;
+	fmt.Rshift = 16; fmt.Gshift = 8; fmt.Bshift = 0; fmt.Ashift = 24;
+	SDL_Surface *conv = SDL_ConvertSurface(img, &fmt, SDL_SWSURFACE);
+	SDL_FreeSurface(img);
+	if (!conv) return;
+	const int k = conv->w / sheet8->getWidth();
+	if (k < 1 || conv->w != sheet8->getWidth() * k || conv->h != sheet8->getHeight() * k)
+	{
+		Log(LOG_WARNING) << "Sharp font sheet " << twin << " does not match its 8-bit sheet";
+		SDL_FreeSurface(conv); return;
+	}
+	Atlas a; a.w = conv->w; a.h = conv->h; a.k = k; a.cov.resize((size_t)a.w * a.h);
+	SDL_LockSurface(conv);
+	for (int y = 0; y < a.h; ++y)
+	{
+		const Uint32 *p = (const Uint32*)((const Uint8*)conv->pixels + y * conv->pitch);
+		for (int x = 0; x < a.w; ++x) a.cov[(size_t)y * a.w + x] = (Uint8)(p[x] >> 24);
+	}
+	SDL_UnlockSurface(conv); SDL_FreeSurface(conv);
+	atlases[sheet8] = std::move(a);
+	Log(LOG_INFO) << "Sharp font sheet: " << twin << " (x" << k << ")";
+}
+
+void registerImage(const Surface *img, const std::string &file)
+{
+	if (!enabled() || !img) return;
+	const auto dot = file.find_last_of('.');
+	if (dot == std::string::npos) return;
+	Img im = loadPng(file.substr(0, dot) + "_hi.png");
+	if (!im.ok) return;
+	Log(LOG_INFO) << "Sharp twin: " << file << " (" << im.w << "x" << im.h << ")";
+	bgImages[img] = std::move(im);
+}
+
+void spriteInClear(const Surface *dst)
+{
+	insets.erase(dst);
+}
+
+void resolvePending();
+
+void aliasImage(const Surface *dst, const Surface *src)
+{
+	if (!enabled() || !dst || !src) return;
+	// a sprite-set frame's twin stays pending until first draw; resolve it now,
+	// or a screen that only ever copies the frame never finds it (Job 3, 12 Nov)
+	resolvePending();
+	auto it = bgImages.find(src);
+	// no twin: forget any earlier alias, or a reused surface keeps the old picture
+	if (it == bgImages.end() || !it->second.ok) { bgImages.erase(dst); return; }
+	bgImages[dst] = it->second;
+}
+
+void registerSetFrame(SurfaceSet *set, int frame, const std::string &file)
+{
+	if (!enabled() || !set) return;
+	const auto dot = file.find_last_of('.');
+	if (dot == std::string::npos || !FileMap::fileExists(file.substr(0, dot) + "_hi.png")) return;
+	pending.push_back({set, frame, file});
+}
+
+void spriteIn(const Surface *dst, const Surface *src, int x, int y)
+{
+	if (!enabled() || !dst || !src) return;
+	auto &v = insets[dst];
+	for (auto &e : v)
+		if (e.x == x && e.y == y) { e.src = src; return; }   // a redraw of the same place replaces it
+	v.push_back({src, x, y});
+}
+
+void resolvePending()
+{
+	if (pending.empty()) return;
+	std::vector<Pending> todo;
+	todo.swap(pending);
+	for (const auto &p : todo)
+	{
+		const Surface *f = p.set->getFrame(p.frame);
+		if (!f) continue;
+		const auto dot = p.file.find_last_of('.');
+		Img im = loadPng(p.file.substr(0, dot) + "_hi.png");
+		if (!im.ok) continue;
+		Log(LOG_INFO) << "Sharp sprite: " << p.file << " (" << im.w << "x" << im.h << ")";
+		bgImages[f] = std::move(im);
+	}
+}
+
+void spriteFit(const Surface *frame, int x, int y, int w, int h, int boxX, int boxY, int boxW, int boxH, double inset)
+{
+	resolvePending();
+	if (!base || !frame || w <= 0 || h <= 0 || boxW <= 0 || boxH <= 0) return;
+	auto it = bgImages.find(frame);
+	const Img *imp = (it != bgImages.end() && it->second.ok) ? &it->second : nullptr;
+	// AN ITEM WITH NO SHARP PICTURE YET is fitted all the same, from its 8-bit
+	// frame: enlarged by whole pixels (so it stays crisp pixel art, not a blur)
+	// and cached per frame and palette.
+	if (!imp) imp = flatTwin(frame);
+	if (!imp) return;
+	R r{ x, y, x + w, y + h };
+	if (!clipBase(r)) return;
+	// hide the 8-bit icon: every pixel the frame itself wrote shows the overlay,
+	// which holds the page underneath until the twin goes on top of it
+	SDL_Surface *fs = const_cast<Surface*>(frame)->getSurface();
+	for (int by = r.y0; by < r.y1; ++by)
+	{
+		const Uint8 *p = row8(by);
+		for (int bx = r.x0; bx < r.x1; ++bx)
+		{
+			const int fx = bx - x, fy = by - y;
+			if (!fs || fx >= fs->w || fy >= fs->h || !((const Uint8*)fs->pixels)[fy * fs->pitch + fx]) continue;
+			tag[by * bw + bx] = p[bx]; valid[by * bw + bx] = 1;
+		}
+	}
+	any = true;
+	// John 17 Nov: "make sure all the weapons and ammos sprites fit into the inventory slots". 789 of the 929
+	// item pictures are bigger than the space the item takes (a 32x48 frame on a 1x1 or 1x2 item). Fit what the
+	// picture DRAWS - its opaque box, not the whole frame - inside the compartment, centred, proportions kept,
+	// never enlarged past its own size.
+	const Img &im = *imp;
+	static std::map<const Img*, std::array<int, 4> > bbs;
+	auto bi = bbs.find(&im);
+	if (bi == bbs.end())
+	{
+		int x0 = im.w, y0 = im.h, x1 = 0, y1 = 0;
+		for (int yy = 0; yy < im.h; ++yy)
+			for (int xx = 0; xx < im.w; ++xx)
+				if ((im.px[(size_t)yy * im.w + xx] >> 24) > 24) { x0 = std::min(x0, xx); y0 = std::min(y0, yy); x1 = std::max(x1, xx + 1); y1 = std::max(y1, yy + 1); }
+		if (x1 <= x0) { x0 = 0; y0 = 0; x1 = im.w; y1 = im.h; }
+		bi = bbs.emplace(&im, std::array<int, 4>{ { x0, y0, x1, y1 } }).first;
+	}
+	const auto &bb = bi->second;
+	const double kx = (double)w / im.w, ky = (double)h / im.h;          // twin pixels -> base pixels
+	const double ow = (bb[2] - bb[0]) * kx, oh = (bb[3] - bb[1]) * ky;   // the object, in base pixels
+	const double tw = std::max(1.0, boxW - 2 * inset), th = std::max(1.0, boxH - 2 * inset);
+	// John 18 Nov 01:26: "they should all fill their space no more" - an item now grows to fill its compartment
+	// as well as shrinking to fit it (it was never enlarged, so small pictures sat lost in big boxes)
+	double s = std::min(tw / ow, th / oh);
+	double cx = boxX + boxW / 2.0, cy = boxY + boxH / 2.0;
+	if (inset < 0)
+	{
+		// G.I. Joe (BUILD-1, John 18 Nov 01:24 "hes not in the proper window"): a picture painted to its page (the
+		// inventory figure) keeps the place it was painted at - only items are centred in their compartment
+		s = 1.0;
+		cx = x + (bb[0] + bb[2]) / 2.0 * kx;
+		cy = y + (bb[1] + bb[3]) / 2.0 * ky;
+	}
+	stretch(im, bb[0], bb[1], bb[2], bb[3],
+		(int)DX(cx - ow * s / 2), (int)DY(cy - oh * s / 2), (int)DX(cx + ow * s / 2), (int)DY(cy + oh * s / 2));
+}
+
+void sprite(const Surface *frame, int x, int y, int w, int h)
+{
+	resolvePending();
+	if (!base || !frame || w <= 0 || h <= 0) return;
+	auto it = bgImages.find(frame);
+	if (it == bgImages.end() || !it->second.ok) return;
+	const Img &im = it->second;
+	R r{x, y, x + w, y + h};
+	if (!clipBase(r)) return;
+	const SDL_Color *pal = base->format->palette ? base->format->palette->colors : nullptr;
+	bool took = false;
+	for (int by = r.y0; by < r.y1; ++by)
+	{
+		const Uint8 *p = row8(by);
+		for (int bx = r.x0; bx < r.x1; ++bx)
+		{
+			// this base pixel's block on screen, and the slice of the sharp twin that belongs to it
+			const int X0 = xs[bx], X1 = xs[bx + 1], Y0 = ys[by], Y1 = ys[by + 1];
+			const int u0 = (bx - x) * im.w / w, u1 = std::max(u0 + 1, (bx - x + 1) * im.w / w);
+			const int v0 = (by - y) * im.h / h, v1 = std::max(v0 + 1, (by - y + 1) * im.h / h);
+			// The 8-bit icon's outline is one base pixel wide and steps badly. Where the sharp twin
+			// has something to say just outside it, take that pixel too, so the edge is the twin's.
+			if (!p[bx])
+			{
+				bool edge = false;
+				for (int v = v0; v < v1 && !edge; ++v)
+					for (int u = u0; u < u1; ++u)
+						if ((im.px[(size_t)v * im.w + u] >> 24) > 24) { edge = true; break; }
+				if (!edge) continue;
+			}
+			if (!valid[by * bw + bx] && pal)            // nothing sharp underneath yet: start from the flat colour
+			{
+				const SDL_Color &c = pal[p[bx]];
+				const Uint32 flat = rgb(c.r, c.g, c.b);
+				for (int Y = std::max(0, Y0); Y < std::min(sh, Y1); ++Y)
+				{
+					Uint32 *o = over.data() + (size_t)Y * sw;
+					for (int X = std::max(0, X0); X < std::min(sw, X1); ++X) o[X] = flat;
+				}
+			}
+			for (int Y = std::max(0, Y0); Y < std::min(sh, Y1); ++Y)
+			{
+				const int v = std::min(v1 - 1, v0 + (Y1 > Y0 ? (Y - Y0) * (v1 - v0) / (Y1 - Y0) : 0));
+				Uint32 *o = over.data() + (size_t)Y * sw;
+				for (int X = std::max(0, X0); X < std::min(sw, X1); ++X)
+				{
+					const int u = std::min(u1 - 1, u0 + (X1 > X0 ? (X - X0) * (u1 - u0) / (X1 - X0) : 0));
+					const Uint32 s = im.px[(size_t)v * im.w + u];
+					const Uint32 a = s >> 24;
+					if (!a) continue;                   // transparent in the sharp art: keep what is there
+					if (a == 255) { o[X] = s & 0x00FFFFFFu; continue; }
+					const Uint32 d = o[X];
+					const Uint32 nr = (((s >> 16) & 0xFF) * a + ((d >> 16) & 0xFF) * (255 - a)) / 255;
+					const Uint32 ng = (((s >> 8) & 0xFF) * a + ((d >> 8) & 0xFF) * (255 - a)) / 255;
+					const Uint32 nb = ((s & 0xFF) * a + (d & 0xFF) * (255 - a)) / 255;
+					o[X] = rgb((int)nr, (int)ng, (int)nb);
+				}
+			}
+			tag[by * bw + bx] = p[bx]; valid[by * bw + bx] = 1; took = true;
+		}
+	}
+	if (took) any = true;
+}
+
+void beginFrame(SDL_Surface *base8, int screenW, int screenH, int left, int top, int right, int bottom)
+{
+	base = nullptr; any = false; curOn = false; vHave = false; lastActive = false;
+	if (!enabled() || !base8 || base8->format->BitsPerPixel != 8) return;
+	base = base8;
+	if (bw != base8->w || bh != base8->h || sw != screenW || sh != screenH || xs.empty() || xs[0] != left || ys[0] != top)
+	{
+		bw = base8->w; bh = base8->h; sw = screenW; sh = screenH;
+		xs.resize(bw + 1); ys.resize(bh + 1);
+		for (int i = 0; i <= bw; ++i) xs[i] = left + (int)((double)i * (sw - left - right) / bw + 0.5);
+		for (int i = 0; i <= bh; ++i) ys[i] = top + (int)((double)i * (sh - top - bottom) / bh + 0.5);
+		over.assign((size_t)sw * sh, 0); tag.assign((size_t)bw * bh, 0); valid.assign((size_t)bw * bh, 0);
+		bgCache.clear();
+	}
+	else std::fill(valid.begin(), valid.end(), 0);
+	lastActive = true;
+}
+
+void before(Surface *w)
+{
+	if (!base || !any) return;
+	// LISTS TOO. after() has had a TextList branch all along - craft, soldiers,
+	// research, stores - but it only runs on the pixels captured HERE, and this
+	// accepted plain Text alone. Every list therefore returned early with nothing
+	// captured and drew in the flat 8-bit font: John saw LAUNCH INTERCEPTION with
+	// a sharp title and sharp column headers over blocky green craft rows.
+	Surface *t = dynamic_cast<Text*>(w);
+	if (!t) t = dynamic_cast<TextList*>(w);
+	if (!t) t = dynamic_cast<TextEdit*>(w);
+	if (!t || !shown(t)) return;
+	R r = rectOf(t);
+	if (!clipBase(r)) { scratch.clear(); return; }
+	scratch.assign((size_t)(r.x1 - r.x0) * (r.y1 - r.y0), 0);
+	for (int y = r.y0; y < r.y1; ++y)
+	{
+		const Uint8 *p = row8(y);
+		for (int x = r.x0; x < r.x1; ++x)
+			scratch[(size_t)(y - r.y0) * (r.x1 - r.x0) + (x - r.x0)] = valid[y * bw + x] && tag[y * bw + x] == p[x];
+	}
+}
+
+void after(Surface *w)
+{
+	if (!base || !shown(w)) return;
+	// A SCREEN'S OWN PANEL (the research tree): it paints itself.
+	{
+		auto pn = panels.find(w);
+		if (pn != panels.end())
+		{
+			R r = rectOf(w);
+			if (clipBase(r))
+			{
+				clipX0 = xs[r.x0]; clipY0 = ys[r.y0]; clipX1 = xs[r.x1]; clipY1 = ys[r.y1];
+				pn->second(DX(w->getX()), DY(w->getY()), SK());
+				claim(r);
+			}
+			return;
+		}
+	}
+	// NATIVE SCREEN PIECES first: they are drawn, not looked up.
+	if (hud.on && (w == hudBar || w == hudMission))
+	{
+		R r = rectOf(w);
+		if (!clipBase(r)) return;
+		if (w == hudBar) paintHud(w); else paintMission(w);
+		claim(r);
+		return;
+	}
+	{
+		auto nb = nativeBgs.find(w);
+		if (nb != nativeBgs.end())
+		{
+			R r = rectOf(w);
+			if (clipBase(r))
+			{
+				paintBackdrop(w, nb->second, xs[r.x0], ys[r.y0], xs[r.x1], ys[r.y1]);
+				claim(r);
+			}
+			return;
+		}
+		auto nk = nativeKeys.find(w);
+		if (nk != nativeKeys.end())
+		{
+			R r = rectOf(w);
+			if (clipBase(r))
+			{
+				const BattlescapeButton *bb = dynamic_cast<BattlescapeButton*>(w);
+				const TextButton *tb = dynamic_cast<TextButton*>(w);
+				auto ia = nativeKeyInArt.find(w);
+				const std::string legend = nk->second.empty() && tb ? tb->getText() : nk->second;
+				const bool down = (bb && bb->isInverted()) || (tb && tb->isPressedLook());
+				auto ks = nativeKeyStyles.find(w);
+				auto ic = nativeKeyIcons.find(w);
+				const Img *icon = ic == nativeKeyIcons.end() ? nullptr : piece(ic->second);
+				paintKey(legend, w->getX(), w->getY(), w->getX() + w->getWidth(), w->getY() + w->getHeight(), down, ia == nativeKeyInArt.end() || ia->second, ks == nativeKeyStyles.end() ? 0 : ks->second, icon);
+				claim(r);
+			}
+			return;
+		}
+		if (nativeTexts.count(w) && dynamic_cast<TextList*>(w))
+		{
+			// A LIST set in the label face: its highlight bar drawn again, then each
+			// visible cell in its own colour and alignment.
+			TextList *tl = static_cast<TextList*>(w);
+			R r = rectOf(w);
+			if (any && clipBase(r) && scratch.size() == (size_t)(r.x1 - r.x0) * (r.y1 - r.y0))
+			{
+				for (int y = r.y0; y < r.y1; ++y)
+				{
+					const Uint8 *p = row8(y);
+					for (int x = r.x0; x < r.x1; ++x)
+						if (scratch[(size_t)(y - r.y0) * (r.x1 - r.x0) + (x - r.x0)]) tag[y * bw + x] = p[x];
+				}
+				const Surface *sel = tl->getSelectorWidget();
+				// a selector that is not where its list is (a combo box's drop-down: its bar landed half a list to the right
+				// and rows down, past the window - John's screens 023, 046) is not drawn at all
+				if (sel && sel->getVisible() && sel->getX() == tl->getX() && sel->getY() >= tl->getY() && sel->getY() < tl->getY() + tl->getHeight())
+				{
+					const double k = SK();
+					// the bar stays inside the list (it ran past the window's right edge: John's screens 023, 033, 046)
+					const int sx0 = std::max(sel->getX(), tl->getX()), sx1 = std::min({sel->getX() + sel->getWidth(), tl->getX() + tl->getWidth(), tl->getScrollColumnX() > sx0 + 8 ? tl->getScrollColumnX() - 2 : 1 << 20});
+					roundRect(DX(sx0), DY(sel->getY()), DX(sx1), DY(sel->getY() + sel->getHeight()), k * 0.8, 0xC08A34, 70);
+					roundRect(DX(sx0), DY(sel->getY()), DX(sx0) + k * 0.8, DY(sel->getY() + sel->getHeight()), k * 0.3, 0xE8B04A, 230);
+				}
+				for (const Text *c : tl->getVisibleCells())
+					nativeType(c, tl->getX() + c->getX(), tl->getY() + c->getY(), roleColour(c->getColor()));
+			}
+			scratch.clear();
+			return;
+		}
+		if (nativeTexts.count(w))
+		{
+			const Text *t = dynamic_cast<Text*>(w);
+			int ox = w->getX(), oy = w->getY();
+			if (!t)
+				if (const TextEdit *te = dynamic_cast<TextEdit*>(w))
+					if ((t = te->getTextWidget())) { ox += t->getX(); oy += t->getY(); }
+			R r = rectOf(w);
+			if (t && any && clipBase(r) && scratch.size() == (size_t)(r.x1 - r.x0) * (r.y1 - r.y0))
+			{
+				for (int y = r.y0; y < r.y1; ++y)
+				{
+					const Uint8 *p = row8(y);
+					for (int x = r.x0; x < r.x1; ++x)
+						if (scratch[(size_t)(y - r.y0) * (r.x1 - r.x0) + (x - r.x0)]) tag[y * bw + x] = p[x];
+				}
+				nativeType(t, ox, oy, roleColour(t->getColor()));
+			}
+			scratch.clear();
+			return;
+		}
+	}
+	// A TWIN INSIDE PART OF A WIDGET (spriteIn): the interception window's
+	// preview is one surface built from three pieces, and only the craft in the
+	// middle has a sharp twin. Painted over the pixels it wrote, the rest of the
+	// widget is left as it is.
+	{
+		auto in = insets.find(w);
+		if (in != insets.end())
+			for (const auto &e : in->second)
+				sprite(e.src, w->getX() + e.x, w->getY() + e.y, e.src->getWidth(), e.src->getHeight());
+	}
+	// A PLAIN SCREEN BACKGROUND WITH A REGISTERED SHARP TWIN.
+	//
+	// bgImages was only ever consulted for Window, so a mod could ship
+	// <background>_hi.png, watch the engine log "Sharp twin: ... (1920x1200)",
+	// and still see the 320x200 original on screen - which is exactly what
+	// happened to the geoscape's GEOBORD. The geoscape's backdrop is not a
+	// Window; it is the state's own background surface, so it never reached the
+	// lookup. Anything with a registered twin is drawn from it here.
+	if (!dynamic_cast<Window*>(w))
+	{
+		auto bit = bgImages.find(w);
+		if (bit != bgImages.end() && bit->second.ok)
+		{
+			R r = rectOf(w);
+			if (clipBase(r))
+			{
+				const Img &im = bit->second;
+				// A twin drawn FOR THIS WIDGET - same proportions as the widget, and the
+				// widget not the whole screen - maps onto the widget's own rectangle.
+				// The geoscape's twins are screen-sized and map onto the screen; the
+				// equipment screen's backdrop is a 320x200 surface centred in a larger
+				// battlescape buffer, and mapped onto the screen it came out cropped
+				// and shifted.
+				const bool own = w->getWidth() != bw && (long)w->getWidth() * im.h == (long)w->getHeight() * im.w;
+				if (own)
+				{
+					const double kx = (double)im.w / w->getWidth(), ky = (double)im.h / w->getHeight();
+					stretch(im, (int)((r.x0 - w->getX()) * kx), (int)((r.y0 - w->getY()) * ky),
+						(int)((r.x1 - w->getX()) * kx), (int)((r.y1 - w->getY()) * ky),
+						xs[r.x0], ys[r.y0], xs[r.x1], ys[r.y1]);
+				}
+				else
+				{
+					const double kx = (double)im.w / bw, ky = (double)im.h / bh;
+					stretch(im, (int)(r.x0 * kx), (int)(r.y0 * ky), (int)(r.x1 * kx), (int)(r.y1 * ky),
+						xs[r.x0], ys[r.y0], xs[r.x1], ys[r.y1]);
+				}
+				claim(r);
+				return;
+			}
+		}
+	}
+	if (Window *win = dynamic_cast<Window*>(w))
+	{
+		if (!win->isPoppedUp()) return;
+		R r = rectOf(win);
+		if (!clipBase(r)) return;
+		const int X0 = xs[r.x0], Y0 = ys[r.y0], X1 = xs[r.x1], Y1 = ys[r.y1];
+		const Surface *bg = win->getBackground();
+		auto bit = bg ? bgImages.find(bg) : bgImages.end();
+		// A backdrop made for this window exactly (its surface is the window's own size, like the
+		// turn screen) is a whole picture: shown entire, with no frame of ours over its own.
+		const bool wholePicture = bit != bgImages.end() && bit->second.ok && bg
