+void ResearchTreeState::paintInfo(double X0, double Y0, double k)
+{
+	HiUI::Paint::rect(X0, Y0, X0 + 88 * k, Y0 + 124 * k, C_PANEL);
+	if (_sel < 0 || _sel >= (int)_nodes.size())
+	{
+		HiUI::Paint::text("label", tr("STR_RESEARCH_TREE_PICK"), X0 + 2 * k, Y0 + 2 * k, X0 + 86 * k, Y0 + 8 * k, 2.2 * k, 0, 1, C_GREY);
+		return;
+	}
+	const Mod *mod = _game->getMod();
+	SavedGame *save = _game->getSavedGame();
+	const Node &n = _nodes[_sel];
+	const bool hidden = n.st == N_NEEDITEM;
+	HiUI::Paint::text("stencil", hidden ? std::string("?") : std::string(tr(n.r->getName())), X0 + 2 * k, Y0 + 1 * k, X0 + 86 * k, Y0 + 8 * k, 3.3 * k, 0, 1, C_YELLOW);
+	// department, head, state
+	const Soldier *head = save->findJoe(save->getDeptHead(n.r->getLane()));
+	std::ostringstream sub;
+	sub << (head ? head->getName() + " - " : std::string()) << tr("STR_DEPT_" + n.r->getLane()) << " - " << save->getDeptSpeed(mod, n.r->getLane()) << "% speed";
+	HiUI::Paint::text("label", sub.str(), X0 + 2 * k, Y0 + 9 * k, X0 + 86 * k, Y0 + 12.5 * k, 1.9 * k, 0, 1, C_MUTED);
+	// the picture, sharpening with the work (1b): nothing until started, clean when done
+	const double px0 = X0 + 2 * k, py0 = Y0 + 14 * k, px1 = X0 + 86 * k, py1 = py0 + 84 * k * 240 / 432;
+	HiUI::Paint::rect(px0, py0, px1, py1, C_ROW);
+	const double prog = n.st == N_DONE ? 1.0 : n.st == N_RESEARCHING ? n.pct / 100.0 : 0.0;
+	if (!hidden && !HiUI::Paint::picture("Resources/Research/" + n.r->getName() + ".png", px0, py0, px1, py1, prog))
+		HiUI::Paint::text("label", "no picture yet", px0, py0, px1, py1, 1.6 * k, 1, 1, C_DIM);
+	HiUI::Paint::frame(px0, py0, px1, py1, std::max(1.0, 0.25 * k), C_EDGE);
+	double y = py1 + 2.5 * k;
+	auto row = [&](const std::string &label, const std::string &value)
+	{
+		HiUI::Paint::text("label", label, X0 + 2 * k, y, X0 + 22 * k, y + 4 * k, 1.8 * k, 0, 1, C_GREY);
+		HiUI::Paint::text("label", value, X0 + 22 * k, y, X0 + 86 * k, y + 4 * k, 2.2 * k, 0, 1, C_BONE);
+		y += 5 * k;
+	};
+	const char *stKey[] = { "STR_TREE_DONE", "STR_TREE_RESEARCHING", "STR_TREE_AVAILABLE", "STR_TREE_LOCKED", "STR_TREE_NEEDS_ITEM" };
+	row("STATUS", std::string(tr(stKey[n.st])) + (n.st == N_RESEARCHING ? " " + std::to_string(n.pct) + "%" : std::string()));
+	if (!hidden)
+	{
+		if (n.r->getDependencies().empty()) row("NEEDS", "nothing");
+		else for (size_t i = 0; i < n.r->getDependencies().size() && i < 3; ++i)
+			row(i == 0 ? "NEEDS" : "", tr(n.r->getDependencies()[i]->getName()));
+		int opens = 0;
+		for (const auto &m : _nodes)
+			for (const auto *d : m.r->getDependencies())
+				if (d == n.r && opens < 3 && m.st != N_NEEDITEM) { row(opens == 0 ? "OPENS" : "", tr(m.r->getName())); ++opens; }
+		row("TIME", std::to_string(n.r->getCost()) + " scientist-days");
+		if (n.r->needItem() && n.r->getNeededItem()) row("USES UP", tr(n.r->getNeededItem()->getType()));
+	}
+}
