 /**
  * Completes the transfer between bases.
  */
+Craft *TransferItemsState::carrierFor(const std::string &craftType) const
+{
+	for (auto *c : *_baseFrom->getCrafts())
+		if (c->getRules()->getType() == craftType && c->getStatus() != "STR_OUT" && c->getStatus() != "STR_REPAIRS") return c;
+	return nullptr;
+}
+
+bool TransferItemsState::truckCanGo() const
+{
+	const double lon1 = _baseFrom->getLongitude(), lat1 = _baseFrom->getLatitude(), lon2 = _baseTo->getLongitude(), lat2 = _baseTo->getLatitude();
+	const double d = acos(std::max(-1.0, std::min(1.0, sin(lat1) * sin(lat2) + cos(lat1) * cos(lat2) * cos(lon1 - lon2))));
+	if (d * 3959.0 > 1500.0) return false;   // miles
+	// never over water: walk the route and test each point against the land polygons
+	auto onLand = [&](double lon, double lat)
+	{
+		const double coslat = cos(lat), sinlat = sin(lat);
+		for (auto *polygon : *_game->getMod()->getGlobe()->getPolygons())
+		{
+			double z = 0;
+			for (int j = 0; j < polygon->getPoints(); ++j)
+			{
+				z = coslat * cos(polygon->getLatitude(j)) * cos(polygon->getLongitude(j) - lon) + sinlat * sin(polygon->getLatitude(j));
+				if (z < 0.75) break;
+			}
+			if (z < 0.75) continue;
+			bool odd = false;
+			double clat = polygon->getLatitude(0), clon = polygon->getLongitude(0);
+			double x = cos(clat) * sin(clon - lon), y = coslat * sin(clat) - sinlat * cos(clat) * cos(clon - lon);
+			for (int j = 0; j < polygon->getPoints(); ++j)
+			{
+				const int k = (j + 1) % polygon->getPoints();
+				clat = polygon->getLatitude(k); clon = polygon->getLongitude(k);
+				const double x2 = cos(clat) * sin(clon - lon), y2 = coslat * sin(clat) - sinlat * cos(clat) * cos(clon - lon);
+				if (((y > 0) != (y2 > 0)) && (0 < (x2 - x) * (0 - y) / (y2 - y) + x)) odd = !odd;
+				x = x2; y = y2;
+			}
+			if (odd)
+			{
+				const RuleGlobe *g = _game->getMod()->getGlobe();
+				const Texture *tx = g->getTexture(polygon->getTexture());
+				return !(tx && tx->isCosmeticOcean());
+			}
+		}
+		return false;
+	};
+	for (int i = 1; i < 20; ++i)
+	{
+		const double f = i / 20.0;
+		if (!onLand(lon1 + (lon2 - lon1) * f, lat1 + (lat2 - lat1) * f)) return false;
+	}
+	return true;
+}
+
+int TransferItemsState::riskFor(int mode) const
+{
+	const SavedGame *save = _game->getSavedGame();
+	const double lon1 = _baseFrom->getLongitude(), lat1 = _baseFrom->getLatitude(), lon2 = _baseTo->getLongitude(), lat2 = _baseTo->getLatitude();
+	if (mode == 2) return save->flightRisk(_game->getMod(), lon1, lat1, lon2, lat2, true);        // ground teams near the road
+	const int r = save->flightRisk(_game->getMod(), lon1, lat1, lon2, lat2);
+	return mode == 1 ? r * 8 / 10 : r;                                                           // door gunners help
+}
