+/**
+ * Takes a soldier off the roster into Cobra's hands.
+ *
+ * Deliberately NOT killSoldier. The project's rule is that named characters
+ * never die, and a man carried off a map is the clearest case there is: he is
+ * gone from the base, he is not in the memorial, and he is waiting for someone
+ * to come and get him. Same removal as a death - he cannot be assigned to a
+ * craft while Cobra has him - and no SoldierDeath.
+ *
+ * @param soldier the soldier Cobra carried off.
+ * @return iterator to the next soldier at that base.
+ */
+std::vector<Soldier*>::iterator SavedGame::captureSoldier(Soldier *soldier)
+{
+	std::vector<Soldier*>::iterator it;
+	for (auto* xbase : _bases)
+	{
+		for (it = xbase->getSoldiers()->begin(); it != xbase->getSoldiers()->end(); ++it)
+		{
+			if ((*it) == soldier)
+			{
+				_capturedSoldiers.push_back(soldier);
+				_heldDays[soldier->getId()] = 0;
+				return xbase->getSoldiers()->erase(it);
+			}
+		}
+	}
+	return it;
+}
+
+bool SavedGame::sendSpy(Soldier *soldier, Base *base, const std::string &op, int days)
+{
+	if (std::find(base->getSoldiers()->begin(), base->getSoldiers()->end(), soldier) == base->getSoldiers()->end()) return false;
+	if (soldier->isAway() || (soldier->getCraft() && soldier->getCraft()->getStatus() == "STR_OUT")) return false;
+	soldier->setCraft(nullptr);
+	soldier->setTraining(false);
+	soldier->setPsiTraining(false);
+	soldier->setReturnToTrainingWhenHealed(false);
+	SpyMission m;
+	m.op = op;
+	m.soldierId = soldier->getId();
+	m.daysLeft = std::max(1, days);
+	soldier->setAwayDays(m.daysLeft);
+	_spyMissions.push_back(m);
+	return true;
+}
+
+Soldier *SavedGame::findJoe(int soldierId, bool *captured, Base **at) const
+{
+	if (captured) *captured = false;
+	if (at) *at = nullptr;
+	if (soldierId < 0) return nullptr;
+	for (auto *b : _bases)
+		for (auto *s : *b->getSoldiers())
+			if (s->getId() == soldierId) { if (at) *at = b; return s; }
+	for (auto *s : _capturedSoldiers)
+		if (s->getId() == soldierId) { if (captured) *captured = true; return s; }
+	return nullptr;
+}
+
+std::string SavedGame::getJobOf(int soldierId) const
+{
+	if (soldierId < 0) return "";
+	if (_topKick == soldierId) return "TOP_KICK";
+	for (const auto &kv : _deptHeads)
+		if (kv.second == soldierId) return kv.first;
+	return "";
+}
+
+bool SavedGame::isJoeAway(const Soldier *s)
+{
+	return s->isAway() || s->isWounded() || (s->getCraft() && s->getCraft()->getStatus() == "STR_OUT");
+}
+
+int SavedGame::getDeptSpeed(const Mod *mod, const std::string &dept) const
+{
+	const Mod::DepartmentRule *d = mod->getDepartment(dept);
+	if (!d) return 100; // a topic with no department (or an unknown lane) runs as stock
+	bool captured = false;
+	const Soldier *head = findJoe(getDeptHead(dept), &captured);
+	if (!head || captured) return mod->getDeptSpeedNone();
+	return mod->getDeptSpeed(mod->deptMatch(head->getRules()->getType(), *d), isJoeAway(head));
+}
+
+int SavedGame::getTopKickBonus(const Mod *mod, const Base *base) const
+{
+	bool captured = false;
+	Base *at = nullptr;
+	const Soldier *tk = findJoe(_topKick, &captured, &at);
+	if (!tk || captured || at != base) return 0;
+	const int match = mod->topKickMatch(tk->getRules()->getType());
+	if (!match) return 0;
+	// the department rule's speeds scale the bonus: main 100%, second 70%, away 70% (60% second)
+	return mod->getTopKickBonus() * mod->getDeptSpeed(match, isJoeAway(tk)) / 100;
+}
+
+bool SavedGame::hasDeptRoom(const Mod *mod, const std::string &dept) const
+{
+	const Mod::DepartmentRule *d = mod->getDepartment(dept);
+	if (!d) return false;
+	for (auto *b : _bases)
+		for (auto *f : *b->getFacilities())
+			if (f->getBuildTime() == 0 && std::find(d->rooms.begin(), d->rooms.end(), f->getRules()->getType()) != d->rooms.end())
+				return true;
+	return false;
+}
+
+Soldier *SavedGame::getSpy(const SpyMission &m) const
+{
+	for (auto *b : _bases)
+		for (auto *s : *b->getSoldiers())
+			if (s->getId() == m.soldierId) return s;
+	return nullptr;
+}
+
+void SavedGame::endSpyMission(size_t i, int outcome)
+{
+	if (i >= _spyMissions.size()) return;
+	Soldier *soldier = getSpy(_spyMissions[i]);
+	_spyMissions.erase(_spyMissions.begin() + i);
+	if (!soldier) return;
+	soldier->setAwayDays(0);
+	if (outcome == 1)
+		captureSoldier(soldier);
+	else if (outcome == 2)
+		killSoldier(true, soldier, nullptr); // missing in action: no battle, no killer
+}
+
+void SavedGame::returnCapturedSoldier(Soldier *soldier, Base *base)
+{
+	auto it = std::find(_capturedSoldiers.begin(), _capturedSoldiers.end(), soldier);
+	if (it == _capturedSoldiers.end() || !base) return;
+	_capturedSoldiers.erase(it);
+	_heldDays.erase(soldier->getId());
+	base->getSoldiers()->push_back(soldier);
+}
