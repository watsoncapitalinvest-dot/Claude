+	inline Uint32 hash2(int x, int y)
+	{
+		Uint32 h = (Uint32)x * 374761393u + (Uint32)y * 668265263u;
+		h = (h ^ (h >> 13)) * 1274126177u;
+		return h ^ (h >> 16);
+	}
