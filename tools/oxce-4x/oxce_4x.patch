@@ -659,9 +660,60 @@ void BaseView::draw()
 void BaseView::blit(SDL_Surface *surface)
 {
 	Surface::blit(surface);
+	// BUILT FROM SCRATCH at display resolution: the plan is described, not copied.
+	if (HiUI::enabled() && _base)
+	{
+		std::vector<HiUI::Room> rooms;
+		std::vector<std::pair<int, int> > right, down;
+		std::vector<HiUI::Docked> craft;
+		auto craftIt = _base->getCrafts()->begin();
+		for (const auto *fac : *_base->getFacilities())
+		{
+			const RuleBaseFacility *r = fac->getRules();
+			int kind = HiUI::ROOM_GENERIC;
+			if (r->getCrafts() > 0) kind = HiUI::ROOM_HANGAR;
+			else if (r->isLift()) kind = HiUI::ROOM_LIFT;
+			else if (r->getLaboratories() > 0) kind = HiUI::ROOM_LAB;
+			else if (r->getWorkshops() > 0) kind = HiUI::ROOM_WORKSHOP;
+			else if (r->getPsiLaboratories() > 0) kind = HiUI::ROOM_PSI;
+			else if (r->getAliens() > 0) kind = HiUI::ROOM_PRISON;
+			else if (r->getDefenseValue() > 0) kind = HiUI::ROOM_DEFENCE;
+			else if (r->getRadarRange() > 0) kind = HiUI::ROOM_RADAR;
+			else if (r->getPersonnel() > 0) kind = HiUI::ROOM_QUARTERS;
+			else if (r->getStorage() > 0) kind = HiUI::ROOM_STORES;
+			rooms.push_back(HiUI::Room{ fac->getX(), fac->getY(), r->getSizeX(), r->getSizeY(),
+				_lang ? std::string(_lang->getString(r->getType())) : r->getType(), kind, fac->getBuildTime(), fac->getDisabled(),
+				fac->getIfHadPreviousFacility(), fac->getAmmo(), r->getAmmoMax(), {} });
+			for (int i = 0; i < r->getSizeX() * r->getSizeY(); ++i)
+				rooms.back().frames.push_back(_texture->getFrame(r->getSpriteFacility() + i));
+			if (fac->isBuiltOrHadPreviousFacility() && !r->connectorsDisabled())
+			{
+				const int xr = fac->getX() + r->getSizeX();
+				if (xr < BASE_SIZE)
+					for (int y = fac->getY(); y < fac->getY() + r->getSizeY(); ++y)
+						if (_facilities[xr][y] && _facilities[xr][y]->isBuiltOrHadPreviousFacility() && !_facilities[xr][y]->getRules()->connectorsDisabled())
+							right.emplace_back(xr, y);
+				const int yd = fac->getY() + r->getSizeY();
+				if (yd < BASE_SIZE)
+					for (int x = fac->getX(); x < fac->getX() + r->getSizeX(); ++x)
+						if (_facilities[x][yd] && _facilities[x][yd]->isBuiltOrHadPreviousFacility() && !_facilities[x][yd]->getRules()->connectorsDisabled())
+							down.emplace_back(x, yd);
+			}
+			if (fac->getBuildTime() == 0 && r->getCrafts() > 0 && craftIt != _base->getCrafts()->end())
+			{
+				if ((*craftIt)->getStatus() != "STR_OUT")
+					craft.push_back(HiUI::Docked{ _texture->getFrame((*craftIt)->getSkinSprite() + 33),
+						fac->getX() * GRID_SIZE + (r->getSizeX() - 1) * GRID_SIZE / 2 + 2,
+						fac->getY() * GRID_SIZE + (r->getSizeY() - 1) * GRID_SIZE / 2 - 4 });
+				++craftIt;
+			}
+		}
+		HiUI::nativeBaseView(this, GRID_SIZE, rooms, right, down, craft);
+	}
 	if (_selector != 0)
 	{
 		_selector->blit(surface);
+		if (HiUI::enabled() && _selector->getVisible()) HiUI::nativeSelector(_selector);
 	}
 }
 
