+#include "CobraEconomy.h"
+#include "AlienStrategy.h"
+#include <algorithm>
+
+namespace OpenXcom
+{
+
+void CobraProject::load(const YAML::YamlNodeReader& reader)
+{
+	reader.tryRead("type", type);
+	reader.tryRead("region", region);
+	reader.tryRead("progress", progress);
+	reader.tryRead("cost", cost);
+	reader.tryRead("known", known);
+}
+
+void CobraProject::save(YAML::YamlNodeWriter writer) const
+{
+	writer.setAsMap();
+	writer.write("type", type);
+	writer.write("region", region);
+	writer.write("progress", progress);
+	writer.write("cost", cost);
+	writer.write("known", known);
+}
+
+void CobraEconomy::load(const YAML::YamlNodeReader& reader)
+{
+	_funds.clear();
+	_materiel.clear();
+	_projects.clear();
+	reader.tryRead("funds", _funds);
+	reader.tryRead("materiel", _materiel);
+	for (const auto& projectReader : reader["projects"].children())
+	{
+		CobraProject p;
+		p.load(projectReader);
+		_projects.push_back(p);
+	}
+}
+
+void CobraEconomy::save(YAML::YamlNodeWriter writer) const
+{
+	writer.setAsMap();
+	writer.write("funds", _funds);
+	writer.write("materiel", _materiel);
+	if (!_projects.empty())
+	{
+		auto projectsWriter = writer["projects"];
+		projectsWriter.setAsSeq();
+		for (const auto& p : _projects)
+		{
+			p.save(projectsWriter.write());
+		}
+	}
+}
+
+int CobraEconomy::getFunds(const std::string& region) const
+{
+	// find rather than operator[], so asking about a region does not quietly create it
+	auto it = _funds.find(region);
+	return it == _funds.end() ? 0 : it->second;
+}
+
+int CobraEconomy::getMateriel(const std::string& region) const
+{
+	auto it = _materiel.find(region);
+	return it == _materiel.end() ? 0 : it->second;
+}
+
+void CobraEconomy::addFunds(const std::string& region, int delta)
+{
+	// A region can be emptied but not driven into debt: what Cobra does when it cannot pay is
+	// a design question that is not answered yet, and a negative stockpile would make every
+	// counter gate downstream read as a wealth it does not have.
+	int v = getFunds(region) + delta;
+	_funds[region] = v < 0 ? 0 : v;
+}
+
+void CobraEconomy::addMateriel(const std::string& region, int delta)
+{
+	int v = getMateriel(region) + delta;
+	_materiel[region] = v < 0 ? 0 : v;
+}
+
+int CobraEconomy::getTotalFunds() const
+{
+	int total = 0;
+	for (const auto& pair : _funds)
+	{
+		total += pair.second;
+	}
+	return total;
+}
+
+int CobraEconomy::spendFunds(const std::string& preferredRegion, int amount)
+{
+	// The region the site stands in pays first, because that is where the money most likely
+	// came from and it keeps the geography meaningful. What it cannot cover comes from the
+	// rest of the network, which is what "funds are liquid" means.
+	int taken = 0;
+	int here = std::min(amount, getFunds(preferredRegion));
+	if (here > 0)
+	{
+		addFunds(preferredRegion, -here);
+		taken += here;
+	}
+	for (auto& pair : _funds)
+	{
+		if (taken >= amount)
+		{
+			break;
+		}
+		if (pair.first == preferredRegion || pair.second <= 0)
+		{
+			continue;
+		}
+		int bite = std::min(amount - taken, pair.second);
+		pair.second -= bite;
+		taken += bite;
+	}
+	return taken;
+}
+
+void CobraEconomy::mirrorToCounters(AlienStrategy& strategy) const
+{
+	// What Cobra can spend anywhere. A build script may pick any region, so it cannot gate on
+	// one region's bank; this is the counter it reads.
+	strategy.setMissionRun("COBRA_FUNDS_TOTAL", getTotalFunds());
+
+	for (const auto& pair : _funds)
+	{
+		strategy.setMissionRun("COBRA_FUNDS_" + pair.first, pair.second);
+	}
+	for (const auto& pair : _materiel)
+	{
+		strategy.setMissionRun("COBRA_MATERIEL_" + pair.first, pair.second);
+	}
+}
