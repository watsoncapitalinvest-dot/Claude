+
+bool canBomb(const Mod *mod, const Craft *craft)
+{
+	const auto &R = mod->getAirRaidRules();
+	return R.on && craft && R.bombers.count(craft->getRules()->getType());
+}
+
+bool canBeBombed(const Mod *mod, const AlienBase *base)
+{
+	return mod->getAirRaidRules().on && base && !base->getSiteType().empty();
+}
+
+std::vector<const MapData*> snapshot(SavedBattleGame *save)
+{
+	std::vector<const MapData*> v;
+	v.reserve((size_t)save->getMapSizeXYZ() * O_MAX);
+	for (int i = 0; i < save->getMapSizeXYZ(); ++i)
+		for (int part = O_FLOOR; part < O_MAX; ++part) v.push_back(save->getTile(i)->getMapData((TilePart)part));
+	return v;
+}
+
+int recordWreck(AlienBase *base, SavedBattleGame *save, const std::vector<const MapData*> &before)
+{
+	const std::vector<const MapData*> after = snapshot(save);
+	if (after.size() != before.size()) return 0;
+	std::map<std::string, std::string> wreck;
+	for (const auto &line : base->getWreck())
+	{
+		std::istringstream ss(line);
+		int x, y, z, part;
+		if (ss >> x >> y >> z >> part) wreck[std::to_string(x) + " " + std::to_string(y) + " " + std::to_string(z) + " " + std::to_string(part)] = line;
+	}
+	int changed = 0;
+	for (size_t i = 0; i < before.size(); ++i)
+	{
+		if (before[i] == after[i]) continue;
+		++changed;
+		Tile *t = save->getTile((int)(i / O_MAX));
+		const int part = (int)(i % O_MAX);
+		int id = -1, setId = -1;
+		t->getMapData(&id, &setId, (TilePart)part);
+		const Position pos = t->getPosition();
+		const std::string key = std::to_string(pos.x) + " " + std::to_string(pos.y) + " " + std::to_string(pos.z) + " " + std::to_string(part);
+		std::string set = "-";
+		if (after[i] && setId >= 0 && setId < (int)save->getMapDataSets()->size()) set = save->getMapDataSets()->at(setId)->getName();
+		else id = -1;
+		wreck[key] = key + " " + set + " " + std::to_string(after[i] ? id : -1);
+	}
+	if (!changed) return 0;
+	base->getWreck().clear();
+	for (const auto &w : wreck) base->getWreck().push_back(w.second);
+	base->setRepairDays(0);   // the repair starts over
+	return changed;
+}
+
+namespace
+{
+/// the top of a tile column: the highest level with anything on it (-1 = nothing)
+int topLevel(SavedBattleGame *save, int x, int y)
+{
+	for (int z = save->getMapSizeZ() - 1; z >= 0; --z)
+	{
+		Tile *t = save->getTile(Position(x, y, z));
+		if (!t) continue;
+		for (int p = O_FLOOR; p < O_MAX; ++p) if (t->getMapData((TilePart)p)) return z;
+	}
+	return -1;
+}
+
+bool structure(SavedBattleGame *save, int x, int y)
+{
+	for (int z = 0; z < save->getMapSizeZ(); ++z)
+	{
+		Tile *t = save->getTile(Position(x, y, z));
+		if (t && (t->getMapData(O_OBJECT) || t->getMapData(O_WESTWALL) || t->getMapData(O_NORTHWALL))) return true;
+	}
+	return false;
+}
+
+const char *speedName(int s) { return s == 0 ? "STR_AR_SLOW" : s == 1 ? "STR_AR_MEDIUM" : "STR_AR_FAST"; }
+}
+
+}
+
+// ---------------------------------------------------------------------------------------------------------- squadrons
+
+namespace Squadron
+{
+
+bool canLead(const Mod *mod, Craft *craft)
+{
+	if (!craft || craft->getRules()->getPilots() <= 0) return false;
+	auto pilots = craft->getPilotList(false, mod);
+	return !pilots.empty() && !mod->isGreenshirt(pilots.front()->getRules()->getType());
+}
+
+Craft *leadOf(const Mod *mod, Base *base, const Craft *craft)
+{
+	if (!base || craft->getSquadLead().first.empty()) return nullptr;
+	for (auto *c : *base->getCrafts())
+		if (c != craft && c->getUniqueId() == craft->getSquadLead()) return canLead(mod, c) ? c : nullptr;
+	return nullptr;
+}
+
+int followers(Base *base, const Craft *lead)
+{
+	int n = 0;
+	for (auto *c : *base->getCrafts()) if (c != lead && c->getSquadLead() == lead->getUniqueId()) ++n;
+	return n;
+}
+
+void sync(Game *game)
+{
+	const Mod *mod = game->getMod();
+	for (auto *base : *game->getSavedGame()->getBases())
+	{
+		std::map<Craft*, int> slowest;   // lead -> the slowest speed among those flying with it
+		for (auto *c : *base->getCrafts())
+		{
+			Craft *lead = leadOf(mod, base, c);
+			if (!lead || c->isDestroyed() || c->isInBattlescape()) continue;
+			Target *ld = lead->getDestination();
+			const bool leadOut = lead->getStatus() == "STR_OUT" && ld;
+			const bool leadHome = leadOut && ld == (Target*)lead->getBase();
+			if (leadOut && !leadHome)
+			{
+				// a Cobra aircraft: chase the same one, so every plane gets its dogfight; anything else: on the lead's wing
+				Target *want = dynamic_cast<Ufo*>(ld) ? ld : (Target*)lead;
+				if (c->getStatus() == "STR_READY" && !c->getLowFuel())
+				{
+					c->setDestination(want);
+					c->setStatus("STR_OUT");
+				}
+				else if (c->getStatus() == "STR_OUT" && c->getDestination() != want
+					&& (c->getDestination() == (Target*)lead || dynamic_cast<Ufo*>(c->getDestination())))
+				{
+					c->setDestination(want);
+				}
+				if (c->getStatus() == "STR_OUT")
+				{
+					const int s = c->getCraftStats().speedMax;
+					auto it = slowest.find(lead);
+					slowest[lead] = it == slowest.end() ? std::min(s, lead->getCraftStats().speedMax) : std::min(it->second, s);
+				}
+			}
+			else if (leadHome && c->getStatus() == "STR_OUT" && c->getDestination() != (Target*)c->getBase())
+			{
+				c->returnToBase();   // the lead turned for home: so does its squadron
+			}
+		}
+		// they fly together: nobody outruns the slowest
+		for (const auto &sl : slowest)
+			for (auto *c : *base->getCrafts())
+				if ((c == sl.first || (c->getSquadLead() == sl.first->getUniqueId() && c->getStatus() == "STR_OUT")) && c->getSpeed() > sl.second)
+					c->setSpeed(sl.second);
+	}
+}
+
