+{
+	const int id = s ? s->getId() : -1;
+	if (id >= 0)
+	{
+		const std::string old = save->getJobOf(id);
+		if (old == "TOP_KICK") save->setTopKick(-1);
+		else if (!old.empty()) save->setDeptHead(old, -1);
+	}
+	if (dept == "TOP_KICK") save->setTopKick(id);
+	else save->setDeptHead(dept, id);
+}
+
+std::vector<std::string> pendingPrompts(const Mod *mod, SavedGame *save)
+{
+	std::vector<std::string> out;
+	for (const auto &d : mod->getDepartments())
+	{
+		if (save->isDeptPrompted(d.type) || !save->hasDeptRoom(mod, d.type)) continue;
+		save->setDeptPrompted(d.type);
+		if (save->getDeptHead(d.type) < 0) out.push_back(d.type);
+	}
+	return out;
+}
+}
+
+namespace
+{
+/// "in office" / "away" / "captured" / "no head", and the speed.
+void headLine(State *st, const Mod *mod, SavedGame *save, const std::string &dept, std::string &who, std::string &state, std::string &speed)
+{
+	bool captured = false;
+	const int id = dept == "TOP_KICK" ? save->getTopKick() : save->getDeptHead(dept);
+	const Soldier *s = save->findJoe(id, &captured);
+	who = s ? s->getName() : std::string(st->tr("STR_NO_HEAD"));
+	if (!s) state = "";
+	else if (captured) state = st->tr("STR_HEAD_CAPTURED");
+	else if (SavedGame::isJoeAway(s)) state = st->tr("STR_HEAD_AWAY");
+	else state = st->tr("STR_HEAD_IN_OFFICE");
+	std::ostringstream ss;
+	if (dept == "TOP_KICK")
+	{
+		Base *at = nullptr;
+		save->findJoe(id, nullptr, &at);
+		ss << "+" << (at ? save->getTopKickBonus(mod, at) : 0) << "%";
+	}
+	else if (!save->hasDeptRoom(mod, dept))
+	{
+		ss << st->tr("STR_DEPT_NO_ROOM");
+	}
+	else
+	{
+		ss << save->getDeptSpeed(mod, dept) << "%";
+	}
+	speed = ss.str();
+}
+
+void popupFrame(State *st, Window *&w, Text *&title, Text *&body, TextList *&lst)
+{
+	w = new Window(st, 296, 184, 12, 8, POPUP_BOTH);
+	title = new Text(276, 17, 22, 16);
+	body = new Text(268, 26, 26, 34);
+	lst = new TextList(264, 96, 26, 64);
+}
+}
+
+// ---- DepartmentsState ---------------------------------------------------------------------------
+
+DepartmentsState::DepartmentsState()
+{
+	_screen = false;
+	_window = new Window(this, 320, 200, 0, 0, POPUP_BOTH);
+	_txtTitle = new Text(320, 17, 0, 8);
+	_txtRules = new Text(288, 18, 16, 26);
+	_lst = new TextList(288, 128, 16, 48);
+	_btnOk = new TextButton(120, 14, 100, 180);
+	setInterface("fundingWindow");
+	add(_window, "window", "fundingWindow");
+	add(_txtTitle, "text1", "fundingWindow");
+	add(_txtRules, "text2", "fundingWindow");
+	add(_lst, "list", "fundingWindow");
+	add(_btnOk, "button", "fundingWindow");
+	centerAllSurfaces();
+	setWindowBackground(_window, "fundingWindow");
+	_txtTitle->setBig();
+	_txtTitle->setAlign(ALIGN_CENTER);
+	_txtTitle->setText(tr("STR_DEPARTMENTS"));
+	_txtRules->setWordWrap(true);
+	_txtRules->setText(tr("STR_DEPT_RULES"));
+	_lst->setColumns(4, 112, 70, 52, 54);
+	_lst->setSelectable(true);
+	_lst->setBackground(_window);
+	_lst->onMouseClick((ActionHandler)&DepartmentsState::lstClick);
+	_btnOk->setText(tr("STR_OK"));
+	_btnOk->onMouseClick((ActionHandler)&DepartmentsState::btnOkClick);
+	_btnOk->onKeyboardPress((ActionHandler)&DepartmentsState::btnOkClick, Options::keyCancel);
+}
+
+void DepartmentsState::init()
+{
+	State::init();
+	const Mod *mod = _game->getMod();
+	SavedGame *save = _game->getSavedGame();
+	_lst->clearList();
+	_rows.clear();
+	std::vector<std::string> all;
+	for (const auto &d : mod->getDepartments()) all.push_back(d.type);
+	all.push_back("TOP_KICK");
+	for (const auto &dept : all)
+	{
+		std::string who, state, speed;
+		headLine(this, mod, save, dept, who, state, speed);
+		_lst->addRow(4, Departments::name(this, dept).c_str(), who.c_str(), state.c_str(), speed.c_str());
+		_rows.push_back(dept);
+	}
+}
+
+void DepartmentsState::lstClick(Action *)
+{
+	unsigned row = _lst->getSelectedRow();
+	if (row < _rows.size()) _game->pushState(new AppointHeadState(_rows[row], false));
+}
+
+void DepartmentsState::btnOkClick(Action *)
+{
+	_game->popState();
+}
+
+// ---- AppointHeadState ---------------------------------------------------------------------------
+
+AppointHeadState::AppointHeadState(const std::string &dept, bool prompt) : _dept(dept)
+{
+	_screen = false;
+	popupFrame(this, _window, _txtTitle, _txtBody, _lst);
+	_btnNone = new TextButton(120, 14, 26, 170);
+	_btnCancel = new TextButton(120, 14, 170, 170);
+	setInterface("fundingWindow");
+	add(_window, "window", "fundingWindow");
+	add(_txtTitle, "text1", "fundingWindow");
+	add(_txtBody, "text2", "fundingWindow");
+	add(_lst, "list", "fundingWindow");
+	add(_btnNone, "button", "fundingWindow");
+	add(_btnCancel, "button", "fundingWindow");
+	centerAllSurfaces();
+	setWindowBackground(_window, "fundingWindow");
+
+	const Mod *mod = _game->getMod();
+	SavedGame *save = _game->getSavedGame();
+	_txtTitle->setBig();
+	_txtTitle->setAlign(ALIGN_CENTER);
+	_txtTitle->setText(tr("STR_APPOINT_HEAD").arg(Departments::name(this, _dept)));
+	std::string who, state, speed;
+	headLine(this, mod, save, _dept, who, state, speed);
+	std::ostringstream body;
+	body << who << (state.empty() ? "" : " (" + state + ")") << "  " << speed;
+	_txtBody->setWordWrap(true);
+
+	_lst->setColumns(4, 88, 64, 50, 62);
+	_lst->setSelectable(true);
+	_lst->setBackground(_window);
+	_lst->onMouseClick((ActionHandler)&AppointHeadState::lstClick);
+	for (auto *base : *save->getBases())
+	{
+		for (auto *s : *base->getSoldiers())
+		{
+			const int m = Departments::match(mod, s, _dept);
+			if (!m) continue;
+			std::string job = save->getJobOf(s->getId());
+			std::string jobText = job.empty() ? std::string() : (job == _dept ? std::string(tr("STR_HEAD_IN_OFFICE")) : Departments::name(this, job));
+			_lst->addRow(4, s->getName().c_str(), base->getName().c_str(),
+				tr(m == 1 ? "STR_DEPT_MAIN" : "STR_DEPT_SECOND").c_str(), jobText.c_str());
+			_rows.push_back(s);
+		}
+	}
+	if (_rows.empty())
+	{
+		body << "\n" << tr("STR_DEPT_NONE_QUALIFY");
+	}
+	_txtBody->setText(body.str());
+	_btnNone->setText(tr(prompt ? "STR_NO_ONE_YET" : "STR_DEPT_CLEAR"));
+	_btnNone->onMouseClick((ActionHandler)&AppointHeadState::btnNoneClick);
+	_btnCancel->setText(tr("STR_CANCEL"));
+	_btnCancel->onMouseClick((ActionHandler)&AppointHeadState::btnCancelClick);
+	_btnCancel->onKeyboardPress((ActionHandler)&AppointHeadState::btnCancelClick, Options::keyCancel);
+	_btnCancel->setVisible(!prompt);
+	if (prompt) _btnNone->setX(_btnNone->getX() + 72);
+}
+
+void AppointHeadState::lstClick(Action *)
+{
+	unsigned row = _lst->getSelectedRow();
+	if (row >= _rows.size()) return;
+	Departments::appoint(_game->getSavedGame(), _dept, _rows[row]);
+	_game->popState();
+}
+
+void AppointHeadState::btnNoneClick(Action *)
+{
+	// on a prompt this only closes it (the department stays headless); otherwise it removes the head
+	if (_btnCancel->getVisible()) Departments::appoint(_game->getSavedGame(), _dept, nullptr);
+	_game->popState();
+}
+
+void AppointHeadState::btnCancelClick(Action *)
+{
+	_game->popState();
+}
+
+// ---- SoldierJobsState ---------------------------------------------------------------------------
+
+SoldierJobsState::SoldierJobsState(Soldier *soldier) : _soldier(soldier)
+{
+	_screen = false;
+	popupFrame(this, _window, _txtTitle, _txtBody, _lst);
+	_btnClear = new TextButton(120, 14, 26, 170);
+	_btnCancel = new TextButton(120, 14, 170, 170);
+	setInterface("fundingWindow");
+	add(_window, "window", "fundingWindow");
+	add(_txtTitle, "text1", "fundingWindow");
+	add(_txtBody, "text2", "fundingWindow");
+	add(_lst, "list", "fundingWindow");
+	add(_btnClear, "button", "fundingWindow");
+	add(_btnCancel, "button", "fundingWindow");
+	centerAllSurfaces();
+	setWindowBackground(_window, "fundingWindow");
+
+	const Mod *mod = _game->getMod();
+	SavedGame *save = _game->getSavedGame();
+	_txtTitle->setBig();
+	_txtTitle->setAlign(ALIGN_CENTER);
+	_txtTitle->setText(_soldier->getName());
+	const std::string job = save->getJobOf(_soldier->getId());
+	_txtBody->setWordWrap(true);
+	_txtBody->setText(job.empty() ? std::string(tr("STR_DEPT_RULES")) : Departments::name(this, job));
+
+	_lst->setColumns(3, 120, 70, 70);
+	_lst->setSelectable(true);
+	_lst->setBackground(_window);
+	_lst->onMouseClick((ActionHandler)&SoldierJobsState::lstClick);
+	std::vector<std::string> all;
+	for (const auto &d : mod->getDepartments()) all.push_back(d.type);
+	all.push_back("TOP_KICK");
+	for (const auto &dept : all)
+	{
+		const int m = Departments::match(mod, _soldier, dept);
+		if (!m) continue;
+		std::string who, state, speed;
+		headLine(this, mod, save, dept, who, state, speed);
+		_lst->addRow(3, Departments::name(this, dept).c_str(), tr(m == 1 ? "STR_DEPT_MAIN" : "STR_DEPT_SECOND").c_str(), who.c_str());
+		_rows.push_back(dept);
+	}
+	if (_rows.empty()) _lst->addRow(1, tr("STR_DEPT_NONE_QUALIFY").c_str());
+	_btnClear->setText(tr("STR_DEPT_CLEAR"));
+	_btnClear->onMouseClick((ActionHandler)&SoldierJobsState::btnClearClick);
+	_btnClear->setVisible(!job.empty());
+	_btnCancel->setText(tr("STR_CANCEL"));
+	_btnCancel->onMouseClick((ActionHandler)&SoldierJobsState::btnCancelClick);
+	_btnCancel->onKeyboardPress((ActionHandler)&SoldierJobsState::btnCancelClick, Options::keyCancel);
+}
+
+void SoldierJobsState::lstClick(Action *)
+{
+	unsigned row = _lst->getSelectedRow();
+	if (row >= _rows.size()) return;
+	Departments::appoint(_game->getSavedGame(), _rows[row], _soldier);
+	_game->popState();
+}
+
+void SoldierJobsState::btnClearClick(Action *)
+{
+	const std::string job = _game->getSavedGame()->getJobOf(_soldier->getId());
+	if (!job.empty()) Departments::appoint(_game->getSavedGame(), job, nullptr);
+	_game->popState();
+}
+
+void SoldierJobsState::btnCancelClick(Action *)
+{
+	_game->popState();
+}
+
+}
