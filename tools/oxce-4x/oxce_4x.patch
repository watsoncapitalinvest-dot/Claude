 /**
  * Draws the text list and all the text contained within.
  */
+/**
+ * Returns the cells the last draw() actually blitted, in draw order.
+ * HiUI needs exactly these: a row outside the scroll window still holds a Y
+ * from whenever it was last on screen, so walking every row would hand the
+ * overlay stale coordinates. The bounds here therefore mirror draw().
+ */
+std::vector<Text*> TextList::getVisibleCells() const
+{
+	std::vector<Text*> out;
+	if (_rows.empty() || _scroll >= _rows.size())
+	{
+		return out;
+	}
+	for (size_t i = _rows[_scroll]; i < _texts.size() && i < _rows[_scroll] + _visibleRows; ++i)
+	{
+		for (auto *t : _texts[i])
+		{
+			out.push_back(t);
+		}
+	}
+	return out;
+}
