+void SavedGame::cobraMonthly(const Mod *mod)
+{
+	// Count what Cobra holds where, and let each site earn or cost its keep.
+	//
+	// The per-type counts are published alongside the two resources because that is what makes
+	// the acting sites free: "more Terror Dromes in this region means more missions" becomes a
+	// condition a ruleset author writes against COBRA_SITES_<TYPE>_<REGION>, with nothing in
+	// here that knows what a Terror Drome is. A site type added later gets the same treatment
+	// without touching this function.
+	// The month is summed per region and applied once, rather than site by site.
+	//
+	// Applying each site as it is read looked equivalent and is not, because stockpiles are
+	// floored at zero: a region whose consumers happen to be read before its earners clamps to
+	// zero on the way down and then keeps the income, while the same set of sites in a
+	// different order ends up broke. The order sites are read in is the order they were built,
+	// which is nothing to do with what a region is worth. Summing first makes the month's
+	// result depend only on what Cobra owns.
+	std::map<std::string, int> siteCounts, netFunds, netMateriel;
+	// Production is collected rather than applied, and settled in a second pass below, because
+	// what a factory can afford depends on the region's money INCLUDING this month's income -
+	// which is not known until every site has been read. Kept as region totals, not per site,
+	// for the same reason the rest of the month is summed: a pro-rata cut computed from totals
+	// cannot depend on the order sites were built in.
+	std::map<std::string, int> wantMateriel, costMateriel;
+	for (auto *base : _alienBases)
+	{
+		const std::string &siteType = base->getSiteType();
+		if (siteType.empty())
+		{
+			continue;                      // an ordinary alien base; not part of the economy
+		}
+		RuleCobraSite *rule = mod->getCobraSite(siteType);
+		if (rule == 0)
+		{
+			continue;                      // declared but never priced, so it is inert
+		}
+		Region *region = locateRegion(*base);
+		if (region == 0)
+		{
+			continue;                      // locateRegion already logged it
+		}
+		const std::string &regionType = region->getRules()->getType();
+		// A site whose income rides on a cargo flight earns nothing in a month where one of its
+		// flights was shot down. Upkeep is still paid either way - the staff do not go home
+		// because the shipment did not arrive, and a site that costs money while earning none
+		// is exactly the pressure an intercepted run should create.
+		const bool shipmentDenied = rule->getIncomeNeedsShipment() && base->getShipmentsLost() > 0;
+		if (shipmentDenied && cobraLogOn())
+		{
+			// Shipped rather than kept as a probe, for the same reason OXCE_PEN_LOG is: the
+			// numbers are John's to tune and he should be able to see the mechanism fire without
+			// waiting on a build. The balance alone is not evidence - it moves whenever Cobra
+			// builds something - so this says so at the moment it happens.
+			Log(LOG_INFO) << "[econ] " << siteType << " earns nothing this month ("
+				<< base->getShipmentsLost() << " shipment(s) shot down), upkeep still paid";
+		}
+		netFunds[regionType] += (shipmentDenied ? 0 : rule->getFundsPerMonth()) - rule->getUpkeepFunds();
+		base->setShipmentsLost(0);
+		// Consumption happens whatever the money says; production has to be paid for, so it
+		// goes into the second pass instead of straight onto the pile.
+		netMateriel[regionType] -= rule->getUpkeepMateriel();
+		if (!shipmentDenied && rule->getMaterielPerMonth() > 0)
+		{
+			wantMateriel[regionType] += rule->getMaterielPerMonth();
+			costMateriel[regionType] += rule->getMaterielCostFunds();
+		}
+		siteCounts["COBRA_SITES_" + siteType + "_" + regionType]++;
+
+		// A broadcast station erodes goodwill through the engine's own pathway rather than by
+		// touching funding: a country's monthly satisfaction is alien activity weighed against
+		// X-COM's, so adding alien activity is what "eroding goodwill" already means here.
+		// Funding falls, a pact becomes likelier and the graphs screen shows it, all without
+		// anything new. This runs before monthlyFunding, so it counts in the month it happens.
+		int erosion = rule->getGoodwillErosionPerMonth();
+		if (erosion > 0)
+		{
+			region->addActivityAlien(erosion);
+			Country *country = locateCountry(*base);
+			if (country != 0)
+			{
+				country->addActivityAlien(erosion);
+			}
+		}
+	}
+
+	// Second pass: Cobra buys what it makes. A region that can cover the whole bill makes
+	// everything; one that cannot makes the share it can pay for and spends every penny it had
+	// trying. That is the cascade the two resources were missing - go broke and the guns stop,
+	// and today's kit rule then turns out the garrison on sidearms a month or two later.
+	//
+	// Pro-rata rather than all-or-nothing: a factory that stops dead the moment Cobra is a
+	// pound short reads as a bug, and a half-funded month producing half the guns is both
+	// legible and smooth. Floored by integer division, which is the right direction.
+	for (const auto &pair : wantMateriel)
+	{
+		const std::string &regionType = pair.first;
+		const int want = pair.second;
+		const int cost = costMateriel[regionType];
+		if (cost <= 0)
+		{
+			netMateriel[regionType] += want;        // priced free, as everything was before
+			continue;
+		}
+		const int avail = std::max(0, _cobraEconomy->getFunds(regionType) + netFunds[regionType]);
+		if (avail >= cost)
+		{
+			netMateriel[regionType] += want;
+			netFunds[regionType] -= cost;
+			continue;
+		}
+		// How a shortfall behaves is a ruleset number, because neither this desk nor John knows
+		// which plays better and guessing in the abstract is how a wrong default survives.
+		// 0 pro-rata, 100 all-or-nothing, anything between is a floor the bill must clear.
+		const int minPercent = mod->getCobraProductionMinimum();
+		if (minPercent > 0 && (long long)avail * 100 < (long long)cost * minPercent)
+		{
+			// Short of the floor, so the line stops and the money stays in the bank. Not spent:
+			// paying for nothing would be a third behaviour nobody asked for, and it would make
+			// a stalled factory quietly bankrupt the region that owns it.
+			if (cobraLogOn())
+			{
+				Log(LOG_INFO) << "[econ] " << regionType << " could not reach the minimum "
+					<< minPercent << "% of its production bill (" << avail << " of " << cost
+					<< " funds), so it made nothing and kept the money";
+			}
+			continue;
+		}
+		const int made = (int)((long long)want * avail / cost);
+		netMateriel[regionType] += made;
+		netFunds[regionType] -= avail;
+		if (cobraLogOn())
+		{
+			Log(LOG_INFO) << "[econ] " << regionType << " could not pay for its own production: "
+				<< avail << " of " << cost << " funds, so it made " << made << " of " << want
+				<< " materiel";
+		}
+	}
+
+	// Republished from scratch every month, so a site that was raided away stops being counted
+	// instead of leaving its last value behind forever. Clearing by prefix rather than by a
+	// remembered list is deliberate: the list would not survive a save, and the counters do, so
+	// a reloaded game would keep crediting Cobra with sites the player had already destroyed.
+	for (const auto &pair : netFunds)
+	{
+		_cobraEconomy->addFunds(pair.first, pair.second);
+	}
+	for (const auto &pair : netMateriel)
+	{
+		_cobraEconomy->addMateriel(pair.first, pair.second);
+	}
+
+	// Shipped, for the same reason OXCE_PEN_LOG is: these four thresholds are John's to tune and
+	// he should be able to see which regions are over them without waiting on a build. It also
+	// closes the hole that let the kit rule ship switched off - the thresholds are printed next
+	// to the stock they are compared with, so a rule reading against a threshold of zero looks
+	// different from a rule that is working. Once a month, after the month has been applied.
+	if (cobraLogOn())
+	{
+		const int needGuns = mod->getCobraWellSupplied();
+		for (const auto *region : _regions)
+		{
+			const std::string &rt = region->getRules()->getType();
+			const int mat = _cobraEconomy->getMateriel(rt);
+			const int fun = _cobraEconomy->getFunds(rt);
+			if (mat == 0 && fun == 0)
+			{
+				continue;	// Cobra has never been here; saying so sixteen times a month is noise
+			}
+			// The pay bar is derived, so print the bar and not the ruleset number: a multiple of
+			// upkeep is unreadable without the upkeep, and the whole point of this line is that
+			// a threshold nobody can see is a threshold nobody notices is dead. The condition is
+			// recomputed here rather than read back from cobraGarrison, which wants a point
+			// inside the region and a region has no single point - it is a list of boxes.
+			int owed = 0;
+			for (const auto *base : _alienBases)
+			{
+				if (base->getSiteType().empty()) continue;
+				const RuleCobraSite *r = mod->getCobraSite(base->getSiteType());
+				const Region *there = r ? locateRegion(*base) : 0;
+				if (there && there->getRules()->getType() == rt) owed += r->getUpkeepFunds();
+			}
+			const int months = mod->getCobraWellPaidUpkeep();
+			const int flat = mod->getCobraWellPaid();
+			const int bar = owed * months;
+			const bool cannotPay = mod->getCobraStarvedHeadcount() > 0
+				&& ((flat > 0 && fun < flat) || (months > 0 && owed > 0 && fun < bar));
+			Log(LOG_INFO) << "[econ] " << rt
+				<< " materiel=" << mat << "/" << needGuns
+				<< (needGuns > 0 && mat < needGuns ? " CANNOT ARM" : "")
+				<< "  funds=" << fun << "/" << bar
+				<< " (upkeep " << owed << " x " << months << ")"
+				<< (cannotPay ? " CANNOT PAY" : "");
+		}
+	}
+
+	// Research runs after the month's materiel has landed, so a factory built this month can
+	// fund this month's progress rather than next month's.
+	cobraResearch(mod);
+
+	_alienStrategy->clearMissionRunsWithPrefix("COBRA_SITES_");
+	for (const auto &pair : siteCounts)
+	{
+		_alienStrategy->setMissionRun(pair.first, pair.second);
+	}
+
+	_cobraEconomy->mirrorToCounters(*_alienStrategy);
+
+	// Decide last, against this month's holdings rather than last month's.
+	cobraPlan(mod);
+		// An EMPTY env var is still a valid pointer, and campaign_ff.sh passes "${SHOOT:-}" which
+		// sets it to "" rather than leaving it unset. So getenv came back truthy with nothing
+		// behind it, atoi("") gave 0, and the control run was shooting cargo down as eagerly as
+		// the test run. Both halves of the comparison reported the same thing and it looked
+		// like the feature firing when it should not.
+		// An EMPTY env var is still a valid pointer, and campaign_ff.sh passes "${SHOOT:-}" which
+		// sets it to "" rather than leaving it unset. So getenv came back truthy with nothing
+		// behind it, atoi("") gave 0, and the control run was shooting cargo down as eagerly as
