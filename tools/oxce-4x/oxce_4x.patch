+#include "GlobeMarkState.h"
+#include <cmath>
+#include "../Engine/Game.h"
+#include "../Engine/Action.h"
+#include "../Engine/LocalizedText.h"
+#include "../Engine/Options.h"
+#include "../Interface/TextButton.h"
+#include "../Interface/Window.h"
+#include "../Interface/Text.h"
+#include "../Interface/TextEdit.h"
+#include "../Mod/Mod.h"
+#include "../Mod/RuleRegion.h"
+#include "../Mod/RuleCountry.h"
+#include "../Savegame/SavedGame.h"
+#include "../Savegame/Region.h"
+#include "../Savegame/Country.h"
+#include "Globe.h"
+
+namespace OpenXcom
+{
+
+/**
+ * Builds the mark menu for one point on the globe.
+ * @param globe the globe, so it can be redrawn the moment a mark changes.
+ * @param lon longitude of the point the player right-clicked.
+ * @param lat latitude of the same.
+ */
+GlobeMarkState::GlobeMarkState(Globe *globe, double lon, double lat)
+	: _globe(globe), _lon(lon), _lat(lat), _existing(0)
+{
+	_screen = false;
+
+	_window = new Window(this, 216, 164, 52, 18, POPUP_BOTH);
+	_txtTitle = new Text(196, 16, 62, 26);
+	_txtWhere = new Text(196, 9, 62, 42);
+	_txtLabel = new Text(60, 9, 62, 56);
+	_edtLabel = new TextEdit(this, 130, 9, 122, 56);
+	_btnConfirmed = new TextButton(196, 14, 62, 70);
+	_btnLikely    = new TextButton(196, 14, 62, 86);
+	_btnRumour    = new TextButton(196, 14, 62, 102);
+	_btnArea      = new TextButton(96, 14, 62, 118);
+	_btnRoute     = new TextButton(96, 14, 162, 118);
+	_btnRemove    = new TextButton(96, 14, 62, 136);
+	_btnCancel    = new TextButton(96, 14, 162, 136);
+
+	setInterface("geoscape");
+
+	add(_window, "genericWindow", "geoscape");
+	add(_txtTitle, "genericText", "geoscape");
+	add(_txtWhere, "genericText", "geoscape");
+	add(_txtLabel, "genericText", "geoscape");
+	add(_edtLabel, "genericText", "geoscape");
+	add(_btnConfirmed, "genericButton2", "geoscape");
+	add(_btnLikely, "genericButton2", "geoscape");
+	add(_btnRumour, "genericButton2", "geoscape");
+	add(_btnArea, "genericButton2", "geoscape");
+	add(_btnRoute, "genericButton2", "geoscape");
+	add(_btnRemove, "genericButton1", "geoscape");
+	add(_btnCancel, "genericButton1", "geoscape");
+
+	centerAllSurfaces();
+
+	setWindowBackground(_window, "geoscape");
+
+	_txtTitle->setAlign(ALIGN_CENTER);
+	_txtTitle->setBig();
+	_txtTitle->setText(tr("STR_MARK_THE_MAP"));
+
+	// Where the player is pointing, in his own terms. A pin at "14.2, -3.9" is
+	// a pin he cannot read back later; the region is what he will remember.
+	std::string where;
+	for (const auto* country : *_game->getSavedGame()->getCountries())
+	{
+		if (country->getRules()->insideCountry(_lon, _lat))
+		{
+			where = tr(country->getRules()->getType());
+			break;
+		}
+	}
+	if (where.empty())
+	{
+		for (const auto* region : *_game->getSavedGame()->getRegions())
+		{
+			if (region->getRules()->insideRegion(_lon, _lat))
+			{
+				where = tr(region->getRules()->getType());
+				break;
+			}
+		}
+	}
+	_txtWhere->setAlign(ALIGN_CENTER);
+	_txtWhere->setText(where);
+
+	_txtLabel->setText(tr("STR_MARK_NOTE"));
+
+	// An existing mark close to the click is what Remove acts on, and its label
+	// is loaded for editing. "Close" is in radians on the globe rather than in
+	// screen pixels, so it does not change meaning when the player zooms.
+	double best = 0.08;
+	for (const auto& m : _game->getSavedGame()->getGlobeMarks())
+	{
+		const double d = std::sqrt((m.lon - _lon) * (m.lon - _lon) + (m.lat - _lat) * (m.lat - _lat));
+		if (d < best)
+		{
+			best = d;
+			_existing = m.id;
+			_edtLabel->setText(m.label);
+		}
+	}
+
+	_btnConfirmed->setText(tr("STR_MARK_CONFIRMED"));
+	_btnConfirmed->onMouseClick((ActionHandler)&GlobeMarkState::btnConfirmedClick);
+	_btnLikely->setText(tr("STR_MARK_LIKELY"));
+	_btnLikely->onMouseClick((ActionHandler)&GlobeMarkState::btnLikelyClick);
+	_btnRumour->setText(tr("STR_MARK_RUMOUR"));
+	_btnRumour->onMouseClick((ActionHandler)&GlobeMarkState::btnRumourClick);
+	_btnArea->setText(tr("STR_MARK_AREA"));
+	_btnArea->onMouseClick((ActionHandler)&GlobeMarkState::btnAreaClick);
+	_btnRoute->setText(tr("STR_MARK_ROUTE"));
+	_btnRoute->onMouseClick((ActionHandler)&GlobeMarkState::btnRouteClick);
+
+	_btnRemove->setText(tr("STR_MARK_REMOVE"));
+	_btnRemove->onMouseClick((ActionHandler)&GlobeMarkState::btnRemoveClick);
+	_btnRemove->setVisible(_existing != 0);
+
+	_btnCancel->setText(tr("STR_CANCEL"));
+	_btnCancel->onMouseClick((ActionHandler)&GlobeMarkState::btnCancelClick);
+	_btnCancel->onKeyboardPress((ActionHandler)&GlobeMarkState::btnCancelClick, Options::keyCancel);
+}
+
+GlobeMarkState::~GlobeMarkState()
+{
+}
+
+/**
+ * Writes the mark and closes.
+ *
+ * Editing an existing mark rather than stacking a second one on top of it is
+ * deliberate: two pins a pixel apart are indistinguishable on the globe and
+ * the player would have no way to get rid of the one underneath.
+ */
+void GlobeMarkState::place(int kind, int trust)
+{
+	GlobeMark *m = 0;
+	if (_existing)
+	{
+		for (auto& e : _game->getSavedGame()->getGlobeMarks())
+		{
+			if (e.id == _existing) { m = &e; break; }
+		}
+	}
+	if (!m)
+	{
+		m = &_game->getSavedGame()->addGlobeMark();
+		m->lon = _lon;
+		m->lat = _lat;
+	}
+	m->kind = kind;
+	m->trust = trust;
+	m->label = _edtLabel->getText();
+	// The player's own pin is never intel, so it never goes stale. He is not
+	// guessing about his own guess.
+	m->fromIntel = false;
+	_globe->invalidate();
+	_game->popState();
+}
+
+void GlobeMarkState::btnConfirmedClick(Action *) { place(GlobeMark::MARK_PIN, GlobeMark::TRUST_CONFIRMED); }
+void GlobeMarkState::btnLikelyClick(Action *)    { place(GlobeMark::MARK_PIN, GlobeMark::TRUST_LIKELY); }
+void GlobeMarkState::btnRumourClick(Action *)    { place(GlobeMark::MARK_PIN, GlobeMark::TRUST_RUMOUR); }
+void GlobeMarkState::btnAreaClick(Action *)      { place(GlobeMark::MARK_AREA, GlobeMark::TRUST_LIKELY); }
+
+/**
+ * Starts a route here, or adds this point to the route already being drawn.
+ *
+ * The route being drawn is simply the most recent MARK_ROUTE the player owns.
+ * No "currently drawing" flag is kept, because a flag would have to survive a
+ * save, a reload and the player wandering off to fight a battle - and a stale
+ * one would silently append to a route he finished weeks ago.
+ */
+void GlobeMarkState::btnRouteClick(Action *)
+{
+	GlobeMark *open = 0;
+	for (auto& e : _game->getSavedGame()->getGlobeMarks())
+	{
+		if (e.kind == GlobeMark::MARK_ROUTE && !e.fromIntel)
+		{
+			open = &e;
+		}
+	}
+	if (open && open->route.size() < 32)
+	{
+		open->route.push_back(_lon);
+		open->route.push_back(_lat);
+		if (!_edtLabel->getText().empty())
+		{
+			open->label = _edtLabel->getText();
+		}
+	}
+	else
+	{
+		GlobeMark &m = _game->getSavedGame()->addGlobeMark();
+		m.lon = _lon;
+		m.lat = _lat;
+		m.kind = GlobeMark::MARK_ROUTE;
+		m.trust = GlobeMark::TRUST_RUMOUR;
+		m.label = _edtLabel->getText();
+		m.route.push_back(_lon);
+		m.route.push_back(_lat);
+	}
+	_globe->invalidate();
+	_game->popState();
+}
+
+void GlobeMarkState::btnRemoveClick(Action *)
+{
+	if (_existing)
+	{
+		_game->getSavedGame()->removeGlobeMark(_existing);
+		_globe->invalidate();
+	}
+	_game->popState();
+}
+
+void GlobeMarkState::btnCancelClick(Action *)
+{
+	_game->popState();
+}
+
+}
