+	/// Stretch a region of an image into a screen rectangle, blending on its alpha.
+	void stretchRaw(const Img &im, int sx0, int sy0, int sx1, int sy1, int dx0, int dy0, int dx1, int dy1);
+	void stretch(const Img &im, int sx0, int sy0, int sx1, int sy1, int dx0, int dy0, int dx1, int dy1)
+	{
+		if (dx1 <= dx0 || dy1 <= dy0 || sx1 <= sx0 || sy1 <= sy0) return;
+		const int dw = dx1 - dx0, dh = dy1 - dy0;
+		if ((size_t)dw * dh > (size_t)4096 * 4096) { stretchRaw(im, sx0, sy0, sx1, sy1, dx0, dy0, dx1, dy1); return; }
