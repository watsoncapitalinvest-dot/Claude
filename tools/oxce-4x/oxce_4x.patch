+		for (TilePart part : { O_OBJECT, O_WESTWALL, O_NORTHWALL, O_FLOOR })
+		{
+			MapData *m = t->getMapData(part);
+			if (m && m->getArmor() != 255 && !m->isGravLift()) t->setMapData(nullptr, -1, -1, part);
+		}
+		Tile::destroyedLog.push_back(p);
+		changed.push_back(p);
+		Tile *below = _save->getTile(p - Position(0, 0, 1));
+		if (below)
+		{
+			below->setSmoke(std::max(below->getSmoke(), 8));
+			if (below->getUnit() && below->getUnit()->getHealth() > 0)
+			{
+				BattleActionAttack none; none.type = BA_NONE;
+				hitUnit(none, below->getUnit(), Position(0, 0, 0), RNG::generate(15, 40), _save->getMod()->getDamageType(DT_HE), false);
+			}
+		}
