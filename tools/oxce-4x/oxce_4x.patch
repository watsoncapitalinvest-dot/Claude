+	const char *KINDS[3] = { "HE", "SMOKE", "INCENDIARY" };
+	const double EARTH_KM = 6371.0;
+
+	int enc(const Position &p) { return p.x * 100000 + p.y * 100 + p.z + 1; }
+	Position dec(int v) { --v; return Position(v / 100000, (v / 100) % 1000, v % 100); }
+	std::string K(const char *k, int i) { return std::string(k) + ":" + std::to_string(i); }
+
+	/// where the battle is on the world map (the craft that brought the Joes, or the base under attack)
+	bool battleSite(SavedGame *geo, double &lon, double &lat)
+	{
+		if (!geo) return false;
+		for (auto *b : *geo->getBases())
+		{
+			if (b->isInBattlescape()) { lon = b->getLongitude(); lat = b->getLatitude(); return true; }
+			for (auto *c : *b->getCrafts())
+				if (c->isInBattlescape()) { lon = c->getLongitude(); lat = c->getLatitude(); return true; }
+		}
+		return false;
+	}
+	double km(double lon1, double lat1, double lon2, double lat2)
+	{
+		const double c = std::sin(lat1) * std::sin(lat2) + std::cos(lat1) * std::cos(lat2) * std::cos(lon1 - lon2);
+		return std::acos(std::max(-1.0, std::min(1.0, c))) * EARTH_KM;
+	}
+
+	/// the first gun of this side in range with salvoes left (index into the rules), or -1; why says why not
+	int gunInRange(SavedBattleGame *save, UnitFaction side, std::string &why)
+	{
+		const auto &R = save->getMod()->getArtilleryRules();
+		SavedGame *geo = save->getGeoscapeSave();
+		double lon = 0, lat = 0;
+		const bool site = battleSite(geo, lon, lat);
+		const bool test = getenv("OXCE_ARTY_TEST") != nullptr; // rig: every gun of the side counts as in range
+		bool any = false;
+		for (int g = 0; g < (int)R.guns.size(); ++g)
+		{
+			const auto &gun = R.guns[g];
+			if ((side == FACTION_PLAYER) != (gun.side == "JOE")) continue;
+			bool ok = test;
+			if (!ok && side == FACTION_PLAYER && geo && site)
+			{
+				for (auto *b : *geo->getBases())
+				{
+					for (auto *c : *b->getCrafts())
+						if (std::find(gun.crafts.begin(), gun.crafts.end(), c->getRules()->getType()) != gun.crafts.end()
+							&& (c->isInBattlescape() || (c->getStatus() == "STR_OUT" && km(lon, lat, c->getLongitude(), c->getLatitude()) <= gun.rangeKm)))
+							ok = true;
+					if (!gun.facilities.empty() && km(lon, lat, b->getLongitude(), b->getLatitude()) <= gun.rangeKm)
+						for (auto *f : *b->getFacilities())
+							if (f->getBuildTime() == 0 && !f->getDisabled()
+								&& std::find(gun.facilities.begin(), gun.facilities.end(), f->getRules()->getType()) != gun.facilities.end())
+								ok = true;
+				}
+			}
+			// a gun that fights on the map (the Thunderclap tractor and trailer): in range while it stands on the field
+			if (!ok && !gun.units.empty())
+				for (auto *u : *save->getUnits())
+					if (u->getFaction() == side && !u->isOut()
+						&& std::find(gun.units.begin(), gun.units.end(), u->getType()) != gun.units.end())
+						ok = true;
+			if (!ok && side == FACTION_HOSTILE && geo && !gun.cobraProject.empty())
+				ok = geo->cobraProjectDone(gun.cobraProject);
+			if (!ok) continue;
+			any = true;
+			if (save->getVanStop("artUsed:" + gun.id) < R.salvoes) return g;
+		}
+		why = any ? "STR_ARTY_NO_SALVOES" : "STR_ARTY_NO_GUN";
+		return -1;
+	}
+
+	bool specialist(SavedBattleGame *save, const BattleUnit *u)
+	{
+		const auto &R = save->getMod()->getArtilleryRules();
+		if (std::find(R.specialistTypes.begin(), R.specialistTypes.end(), u->getType()) != R.specialistTypes.end()) return true;
+		if (u->getGeoscapeSoldier())
+		{
+			const std::string spec = save->getMod()->mainSpecialty(u->getGeoscapeSoldier()->getRules()->getType());
+			return !spec.empty() && std::find(R.specialistSpecialties.begin(), R.specialistSpecialties.end(), spec) != R.specialistSpecialties.end();
+		}
+		return false;
+	}
+
+	/// records a call; returns the message
+	std::string call(SavedBattleGame *save, BattleUnit *u, Position target, int kind, int gun)
+	{
+		const auto &R = save->getMod()->getArtilleryRules();
+		const int n = save->getVanStop("artN");
+		save->setVanStop("artN", n + 1);
+		save->setVanStop(K("artTile", n), enc(target));
+		save->setVanStop(K("artKind", n), kind);
+		save->setVanStop(K("artSide", n), (int)u->getFaction() + 1);
+		save->setVanStop(K("artTurn", n), save->getTurn());
+		save->setVanStop(K("artScatter", n), specialist(save, u) ? R.specialistScatter : R.scatter);
+		save->setVanStop(K("artGun", n), gun);
+		save->setVanStop(K("artCaller", n), u->getId() + 1);
+		const auto &g = R.guns[gun];
+		save->setVanStop("artUsed:" + g.id, save->getVanStop("artUsed:" + g.id) + 1);
+		u->setTimeUnits(0);
+		Log(LOG_INFO) << "[artillery] " << u->getType() << " calls " << g.label << " " << KINDS[kind] << " on " << target
+			<< " (scatter " << save->getVanStop(K("artScatter", n)) << ", salvo " << save->getVanStop("artUsed:" + g.id) << "/" << R.salvoes << ")";
+		const char *IDS[3] = { "STR_ARTY_CALLED_HE", "STR_ARTY_CALLED_SMOKE", "STR_ARTY_CALLED_INCENDIARY" };
+		return IDS[kind];
+	}
+
+	/// the tile a shell falling on column (x, y) hits: the highest level with something to stop it
+	Position impact(SavedBattleGame *save, int x, int y)
+	{
+		for (int z = save->getMapSizeZ() - 1; z > 0; --z)
+		{
+			Tile *t = save->getTile(Position(x, y, z));
+			if (t && (!t->hasNoFloor(save) || t->getMapData(O_OBJECT) || t->getUnit())) return Position(x, y, z);
+		}
+		return Position(x, y, 0);
+	}
+}
+
+namespace Artillery
+{
