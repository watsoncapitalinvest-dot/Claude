+
+// ------------------------------------------------------------------------------------------------------------------
+// THE CAMPAIGN SIMULATOR (John 18 Nov 02:58 "Make the campaign simulator", "on my pc"). OXCE_CAMPAIGNSIM=<days>:
+// a new campaign plays itself on the world map. Missions and found Cobra sites get the squad; the battles are played
+// by the battle simulator's AI on both sides; the labs are kept busy (cheapest topic first, every free scientist on
+// it); every popup is answered. timeline.txt gets each step with its day; a STALL line when 30 days pass with nothing
+// moving (no new mission, site, research or battle). Stops after <days> days.
+// ------------------------------------------------------------------------------------------------------------------
+namespace
+{
+	struct Camp
+	{
+		bool begun = false;
+		int startDay = 0, lastProgress = 0, stallNoted = -1, battles = 0, lastTick = -1;
+		Uint32 lastDirect = 0;
+		std::set<std::string> seenSites, seenBases;
+		std::set<std::string> researchKnown;
+		std::map<Target*, Craft*> sent;
+	};
+	Camp camp;
+
+	// JOE LAB "plays like John" (18 Nov 18:26): a profile written from his own campaigns (playstyle.txt -> profile).
+	// OXCE_SIM_PROFILE=<file>, lines: "research <topic>" in his order, "answer <deployment> <percent>", "delay <hours>",
+	// "squad <n>". Anything it lacks, the simulator decides as before.
+	struct Profile
+	{
+		bool loaded = false;
+		std::map<std::string, int> order;
+		std::map<std::string, int> answer;
+		int delay = 0, squad = 0;
+	};
+	Profile &profile()
+	{
+		static Profile p;
+		if (p.loaded) return p;
+		p.loaded = true;
+		const char *f = getenv("OXCE_SIM_PROFILE");
+		if (!f || !*f) return p;
+		std::ifstream in(f);
+		std::string w;
+		while (in >> w)
+		{
+			if (w == "research") { std::string t; in >> t; if (!p.order.count(t)) { const int n = (int)p.order.size(); p.order[t] = n; } }
+			else if (w == "answer") { std::string t; int pc = 100; in >> t >> pc; p.answer[t] = pc; }
+			else if (w == "delay") in >> p.delay;
+			else if (w == "squad") in >> p.squad;
+			else { std::string rest; std::getline(in, rest); }
+		}
+		Log(LOG_INFO) << "[sim] playing by the profile " << f << ": " << p.order.size() << " topics in order, " << p.answer.size()
+			<< " mission kinds, delay " << p.delay << "h, squad " << p.squad;
+		return p;
+	}
+
+	void tl(SavedGame *save, const std::string &what)
+	{
+		std::ostringstream ss;
+		GameTime *t = save->getTime();
+		ss << "day " << (save->getDaysPassed() - camp.startDay) << "  " << t->getYear() << "-" << (t->getMonth() < 10 ? "0" : "")
+		   << t->getMonth() << "-" << (t->getDay() < 10 ? "0" : "") << t->getDay() << "  " << what;
+		std::ofstream f(out("timeline.txt"), std::ios::app);
+		f << ss.str() << "\n";
+		note(ss.str());
+	}
+
+	std::string targetName(Target *t)
+	{
+		if (auto *ms = dynamic_cast<MissionSite*>(t)) return ms->getDeployment() ? ms->getDeployment()->getType() : "mission site";
+		if (auto *ab = dynamic_cast<AlienBase*>(t)) return ab->getDeployment() ? ab->getDeployment()->getType() : "Cobra site";
+		return "target";
+	}
+
+	/// a ready transport with a squad aboard (the first free soldiers are put aboard when it has none)
+	Craft *readyTransport(SavedGame *save)
+	{
+		for (auto *base : *save->getBases())
+			for (auto *c : *base->getCrafts())
+			{
+				if (c->getStatus() != "STR_READY" || c->getDestination() || !c->getRules()->getAllowLanding() || c->getRules()->getMaxUnits() <= 0) continue;
+				if (c->getNumTotalSoldiers() == 0)
+					for (auto *so : *base->getSoldiers())
+					{
+						if (c->getSpaceAvailable() <= 0) break;
+						if (!so->getCraft() && !so->isWounded() && !so->getDeath()) so->setCraft(c);
+					}
+				if (c->getNumTotalSoldiers() > 0) return c;
+			}
+		return nullptr;
+	}
+
+	void research(Game *game, SavedGame *save)
+	{
+		const Mod *mod = game->getMod();
+		for (auto *base : *save->getBases())
+		{
+			int free = base->getAvailableScientists();
+			if (free <= 0) continue;
+			auto &active = base->getResearch();
+			if (!active.empty())
+			{
+				ResearchProject *p = active.front();
+				for (auto *q : active) if (q->getRules()->getCost() < p->getRules()->getCost()) p = q;
+				p->setAssigned(p->getAssigned() + free);
+				base->setScientists(base->getScientists() - free);   // assigned ones leave the free pool, as the research screen does
+				continue;
+			}
+			if (base->getFreeLaboratories() <= 0) continue;
+			std::vector<RuleResearch*> avail;
+			save->getAvailableResearchProjects(avail, mod, base);
+			if (avail.empty()) continue;
+			// a player reads the clues first: anything that needs an item brought home, then the cheapest
+			// then the story's own steps (the cartel arc and the spine), then the cheapest
+			auto rank = [](RuleResearch *r) {
+				if (r->needItem()) return 1;
+				static const char *story[] = { "STR_CARTEL_", "STR_ROBBERY", "STR_GETAWAY", "STR_BORDER_BANK", "STR_SLOW_MONEY", "STR_FACTORY_",
+					"STR_INFORMANT_TIP", "STR_WHO_IS_COBRA", "STR_TRACE_", "STR_SPINE", "STR_LEAD_" };
+				for (const char *s : story) if (r->getName().rfind(s, 0) == 0) return 1;
+				return 0; };
+			const auto &ord = profile().order;
+			std::sort(avail.begin(), avail.end(), [&rank, &ord](RuleResearch *a, RuleResearch *b) {
+				// the profile's order first: John's picks in the order he made them
+				const auto ia = ord.find(a->getName()), ib = ord.find(b->getName());
+				if ((ia != ord.end()) != (ib != ord.end())) return ia != ord.end();
+				if (ia != ord.end() && ia->second != ib->second) return ia->second < ib->second;
+				if (rank(a) != rank(b)) return rank(a) > rank(b);
+				return a->getCost() < b->getCost(); });
+			RuleResearch *r = avail.front();
+			int cost = r->getCost() * RNG::generate(50, 150) / 100;
+			if (r->getCost() > 0) cost = std::max(1, cost);
+			auto *proj = new ResearchProject(r, cost);
+			base->addResearch(proj);
+			if (r->isHoldingNeededItem()) base->getStorageItems()->removeItem(r->getNeededItem(), 1);
+			proj->setAssigned(free);
+			base->setScientists(base->getScientists() - free);
+			tl(save, "RESEARCH starts " + r->getName());
+		}
+	}
+
+	void direct(Game *game, GeoscapeState *gs)
+	{
+		SavedGame *save = game->getSavedGame();
+		if (!save) return;
+		if (!camp.begun)
+		{
+			camp.begun = true;
+			camp.startDay = save->getDaysPassed();
+			camp.lastProgress = save->getDaysPassed();
+			for (auto *r : save->getDiscoveredResearch()) camp.researchKnown.insert(r->getName());
+			tl(save, "CAMPAIGN starts: " + std::to_string(campaign()) + " days (markers 2)");   // markers 2: BROADCAST and CARTEL FLIGHT lines (JOE LAB Checks)
+		}
+		gs->simSpeed(4);   // one hour a step: popups stop the clock on their own
+		const int day = save->getDaysPassed();
+		// the labs
+		research(game, save);
+		const auto &disc = save->getDiscoveredResearch();
+		for (auto *r : disc)
+			if (camp.researchKnown.insert(r->getName()).second) { tl(save, "RESEARCHED " + r->getName()); camp.lastProgress = day; }
+		// what has appeared on the map
+		for (auto *ms : *save->getMissionSites())
+		{
+			const std::string key = std::to_string(ms->getId()) + targetName(ms);
+			if (!camp.seenSites.count(key)) { camp.seenSites.insert(key); tl(save, "MISSION appears: " + targetName(ms) + (ms->getDetected() ? "" : " (not detected)")); camp.lastProgress = day; }
+		}
+		for (auto *ab : *save->getAlienBases())
+		{
+			if (!ab->isDiscovered()) continue;
+			const std::string key = std::to_string(ab->getId()) + targetName(ab);
+			if (!camp.seenBases.count(key)) { camp.seenBases.insert(key); tl(save, "COBRA SITE found: " + targetName(ab)); camp.lastProgress = day; }
+		}
+		// send the squad: missions first, then found Cobra sites
+		for (auto it = camp.sent.begin(); it != camp.sent.end(); )
+		{
+			bool alive = false;
+			for (auto *ms : *save->getMissionSites()) if (ms == it->first) alive = true;
+			for (auto *ab : *save->getAlienBases()) if (ab == it->first) alive = true;
+			// gone, or the transport is home again without having got there (refuelling, rearming, ready)
+			if (!alive || (it->second->getDestination() != it->first && it->second->getStatus() != "STR_OUT")) it = camp.sent.erase(it); else ++it;
+		}
+		std::vector<Target*> targets;
+		for (auto *ms : *save->getMissionSites()) if (ms->getDetected()) targets.push_back(ms);
+		for (auto *ab : *save->getAlienBases()) if (ab->isDiscovered()) targets.push_back(ab);
+		for (auto *t : targets)
+		{
+			if (camp.sent.count(t)) continue;
+			// the profile: answer this kind as often as John did, and not sooner than he did
+			{
+				Profile &pf = profile();
+				static std::map<Target*, int> firstSeen;
+				static std::map<Target*, bool> decided;
+				const int now = save->getDaysPassed() * 24 + save->getTime()->getHour();
+				if (!firstSeen.count(t)) firstSeen[t] = now;
+				if (!decided.count(t))
+				{
+					auto a = pf.answer.find(targetName(t));
+					decided[t] = a == pf.answer.end() || RNG::percent(a->second);
+					if (!decided[t]) tl(save, "LET GO " + targetName(t) + " (the profile)");
+				}
+				if (!decided[t] || now - firstSeen[t] < pf.delay) continue;
+			}
+			Craft *c = readyTransport(save);
+			if (!c) break;
+			if (int sq = profile().squad)
+				for (auto *so : *c->getBase()->getSoldiers())
+					if (so->getCraft() == c && c->getNumTotalSoldiers() > sq) so->setCraft(nullptr);
+			c->setDestination(t);
+			c->setStatus("STR_OUT");
+			camp.sent[t] = c;
+			tl(save, "SENT " + c->getRules()->getType() + " with " + std::to_string(c->getNumTotalSoldiers()) + " to " + targetName(t)
+				+ " (fuel " + std::to_string(c->getFuel()) + "/" + std::to_string(c->getCraftStats().fuelMax) + ", " + std::to_string((int)(c->getDistance(t) * 3440)) + " nm, speed " + std::to_string(c->getCraftStats().speedMax) + ")");
+		}
+		// RIG (OXCE_CAMPAIGNSIM_WHY=<topic>): once a day, why that topic is or is not on offer at the first base
+		if (const char *why = getenv("OXCE_CAMPAIGNSIM_WHY"))
+		{
+			static int whyDay = -1;
+			Base *base = save->getBases()->empty() ? nullptr : save->getBases()->front();
+			if (base && whyDay != day)
+			{
+				whyDay = day;
+				const Mod *mod = game->getMod();
+				std::vector<RuleResearch*> avail;
+				save->getAvailableResearchProjects(avail, mod, base);
+				const RuleResearch *w = mod->getResearch(why);
+				std::ostringstream s;
+				s << "WHY " << why << ": ";
+				if (!w) s << "no such topic";
+				else
+				{
+					const bool offered = std::find(avail.begin(), avail.end(), w) != avail.end();
+					s << (offered ? "OFFERED" : "not offered") << "; researched " << save->isResearched(w, false)
+					  << "; disabled " << save->isResearchRuleStatusDisabled(w->getName()) << "; deps " << save->isResearched(w->getDependencies(), false)
+					  << "; requires " << save->isResearched(w->getRequirements(), false) << "; unlocked by:";
+					for (auto *d : save->getDiscoveredResearch())
+						for (auto *u : d->getUnlocked()) if (u == w) s << " " << d->getName();
+					s << "; base funcs missing " << (~base->getProvidedBaseFunc({}) & w->getRequireBaseFunc()).any();
+				}
+				tl(save, s.str());
+			}
+		}
+		// Scarlett's operations: a player sends a spy the day one opens (as the INTEL board offers it)
+		for (const auto &op : game->getMod()->getSpyOperations())
+		{
+			if (!save->spyOpOpen(game->getMod(), op.type)) continue;
+			if (op.cost > 0 && save->getFunds() < op.cost) continue;
+			for (auto *base : *save->getBases())
+			{
+				Soldier *spy = nullptr;
+				for (auto *s : *base->getSoldiers())
+					if (game->getMod()->isSpy(s->getRules()->getType()) && !s->isWounded() && !s->isAway() && !(s->getCraft() && s->getCraft()->getStatus() == "STR_OUT")) { spy = s; break; }
+				if (spy && save->sendSpy(spy, base, op.type, op.days)) { if (op.cost > 0) save->setFunds(save->getFunds() - op.cost); tl(save, "SPY " + spy->getName() + " sent on " + op.type); camp.lastProgress = day; break; }
+			}
+		}
+		// markers for JOE LAB's Checks tab: the day the broadcast went out, and each cartel flight taking off
+		{
+			static bool saidBroadcast = false;
+			if (!saidBroadcast && save->getCobraNet().count("broadcastDone")) { saidBroadcast = true; tl(save, "BROADCAST: Cobra Commander's broadcast has gone out"); }
+			static std::set<int> saidFlight;
+			for (auto *ufo : *save->getUfos())
+				if (ufo->getRules()->getType() == "STR_CARTEL_PLANE" && saidFlight.insert(ufo->getId()).second)
+				{
+					bool home = false;
+					for (auto *ab : *save->getAlienBases())
+						if (ab->getSiteType() == "STR_CARTEL_STASH_HOUSE" && ufo->getDestination() && ufo->getDestination()->getDistance(ab) < 0.01) home = true;
+					tl(save, std::string("CARTEL FLIGHT takes off") + (ufo->getDetected() ? "" : " (not detected)") + (home ? ", heading home" : ""));
+				}
+		}
+		// the cartel's flights: a player tails one home with an unarmed craft (an armed one would fight it)
+		for (auto *ufo : *save->getUfos())
+		{
+			if (ufo->getRules()->getType() != "STR_CARTEL_PLANE" || !ufo->getDetected() || ufo->getStatus() != Ufo::FLYING || !ufo->getCraftFollowers().empty()) continue;
+			// a player who has read the flight route waits for the run home (the radar can show it going out, to Mexico)
+			{
+				bool home = false;
+				for (auto *ab : *save->getAlienBases())
+					if (ab->getSiteType() == "STR_CARTEL_STASH_HOUSE" && ufo->getDestination() && ufo->getDestination()->getDistance(ab) < 0.01) home = true;
+				if (!home) continue;
+			}
+			static std::set<int> logged;
+			Craft *tail = nullptr;
+			for (auto *base : *save->getBases())
+				for (auto *c : *base->getCrafts())
+					if (!tail && c->getStatus() == "STR_READY" && !c->getDestination() && c->getNumWeapons() == 0 && c->getRules()->getMaxSpeed() > ufo->getSpeed()) tail = c;
+			if (!tail)
+			{
+				if (logged.insert(ufo->getId()).second) tl(save, "CARTEL FLIGHT seen, no unarmed craft fast enough to tail it");
+				continue;
+			}
+			tail->setDestination(ufo);
+			tail->setStatus("STR_OUT");
+			tl(save, "TAIL the cartel flight with " + tail->getRules()->getType());
+			camp.lastProgress = day;
+		}
+		// a stall: nothing new for 30 days
+		if (day - camp.lastProgress >= 30 && camp.stallNoted != camp.lastProgress)
+		{
+			camp.stallNoted = camp.lastProgress;
+			tl(save, "STALL: nothing new for 30 days (no mission, site, research or battle)");
+			shot(game, "stall_day" + std::to_string(day - camp.startDay));
+		}
+		// money: the monthly upkeep, base by base, whenever it changes (a 1.5 billion bill ended a 120-day run, 18 Nov)
+		{
+			static std::string lastUpkeep;
+			std::ostringstream up;
+			long long total = 0;
+			for (const auto *b : *save->getBases())
+			{
+				up << " | " << b->getName() << ": craft " << b->getCraftMaintenance() << ", people " << b->getPersonnelMaintenance()
+				   << ", rooms " << b->getFacilityMaintenance();
+				total += b->getMonthlyMaintenace();
+			}
+			const std::string s = "UPKEEP " + std::to_string(total) + " a month, funds " + std::to_string(save->getFunds()) + up.str();
+			if (up.str() != lastUpkeep) { lastUpkeep = up.str(); tl(save, s); }
+		}
+		// the status the hub shows
+		if (SDL_GetTicks() - statusAt > 2000)
+		{
+			statusAt = SDL_GetTicks();
+			std::ofstream st(out("status.txt"), std::ios::trunc);
+			st << "mode campaign\nday " << day - camp.startDay << " of " << campaign() << "\nbattles " << camp.battles
+			   << "\nresearched " << disc.size() << "\nmissions " << save->getMissionSites()->size() << "\nsites_found " << camp.seenBases.size()
+			   << "\nquiet_days " << day - camp.lastProgress << "\nseconds " << SDL_GetTicks() / 1000 << "\n";
+		}
+		if (day - camp.startDay >= campaign())
+		{
+			tl(save, "CAMPAIGN ends: " + std::to_string(camp.battles) + " battles");
+			result("CAMPAIGN END day " + std::to_string(day - camp.startDay) + ", " + std::to_string(camp.battles) + " battles, "
+				+ std::to_string(disc.size()) + " research topics known");
+			game->quit();
+		}
+	}
+}
+
+void frame(Game *game, State *top)
+{
+	if (!on() || !top) return;
+	beat.store(SDL_GetTicks() ? SDL_GetTicks() : 1);
+	if (!watching) { watching = true; std::thread(watchdog).detach();
+		note("simulator: " + mission() + ", turn limit " + std::to_string(maxTurns()) + ", Joes " + (getenv("OXCE_BATTLESIM_JOES") ? getenv("OXCE_BATTLESIM_JOES") : "normal") + ", Cobra " + (getenv("OXCE_BATTLESIM_COBRA") ? getenv("OXCE_BATTLESIM_COBRA") : "normal")); }
+	if (top != topSeen) { topSeen = top; topSince = SDL_GetTicks(); presses = 0; }
+	const Uint32 held = SDL_GetTicks() - topSince;
+	// the campaign: every screen of the first OXCE_CAMPAIGNSIM_SCREENS days (default 60) is kept - its words in screens.txt and
+	// its picture - so the opening can be read end to end (John 18 Nov: "tighten up everything in the first 2 months")
+	if (campaign() > 0 && game->getSavedGame() && camp.begun && held > 700)
+	{
+		static std::set<const State*> kept;
+		static int nScreen = 0;
+		const int days = getenv("OXCE_CAMPAIGNSIM_SCREENS") ? atoi(getenv("OXCE_CAMPAIGNSIM_SCREENS")) : 60;
+		SavedGame *sv = game->getSavedGame();
+		const bool skip = dynamic_cast<GeoscapeState*>(top) || dynamic_cast<BattlescapeState*>(top) || dynamic_cast<InventoryState*>(top)
+			|| dynamic_cast<NextTurnState*>(top);
+		if (!skip && sv->getDaysPassed() - camp.startDay <= days && kept.insert(top).second)
+		{
+			++nScreen;
+			char tag[32]; snprintf(tag, sizeof(tag), "screen_%03d", nScreen);
+			std::ostringstream w;
+			w << "== " << tag << "  day " << (sv->getDaysPassed() - camp.startDay) << "  " << typeid(*top).name() << "\n";
+			for (auto *s : top->simSurfaces())
+			{
+				std::string txt;
+				if (auto *tx = dynamic_cast<Text*>(s)) txt = tx->getText();
+				else if (auto *tb = dynamic_cast<TextButton*>(s)) txt = "[" + tb->getText() + "]";
+				if (!txt.empty() && s->getVisible()) w << txt << "\n";
+			}
+			std::ofstream f(out("screens.txt"), std::ios::app);
+			f << w.str() << "\n";
+			shot(game, tag);
+		}
+	}
+
+	if (dynamic_cast<MainMenuState*>(top) && campaign() > 0)
+	{
+		if (held < 1500 || started) return;
+		started = true; topSeen = nullptr;
+		note("campaign: a new game, the Pit in Colorado");
+		SavedGame *save = game->getMod()->newSave(DIFF_EXPERIENCED);
+		save->setDifficulty(DIFF_EXPERIENCED);
+		save->setCobraHeadStart(getenv("OXCE_CAMPAIGNSIM_HEADSTART") ? atoi(getenv("OXCE_CAMPAIGNSIM_HEADSTART")) : 0);
+		save->cobraApplyHeadStart(game->getMod());
+		game->setSavedGame(save);
+		Base *base = save->getBases()->back();
+		if (base->getMarker() == -1)
+		{
+			base->setLongitude(255.0 * 3.14159265358979323846 / 180.0);   // 105 W, written as the globe stores it (0-360)
+			base->setLatitude(-39.0 * 3.14159265358979323846 / 180.0);
+			for (auto *c : *base->getCrafts()) { c->setLongitude(base->getLongitude()); c->setLatitude(base->getLatitude()); }   // they sit at the base, as a placed base's do
+		}
+		if (base->getName().empty()) base->setName("The Pit");
+		base->calculateServices(save);
+		game->setState(new GeoscapeState);
+		return;
+	}
+	if (auto *gs = dynamic_cast<GeoscapeState*>(top))
+	{
+		if (campaign() <= 0) return;
+		if (SDL_GetTicks() - camp.lastDirect < 250) return;
+		camp.lastDirect = SDL_GetTicks();
+		direct(game, gs);
+		return;
+	}
+	if (auto *cl = dynamic_cast<ConfirmLandingState*>(top))
+	{
+		if (held < 1500 || presses) return;
+		presses = 1;
+		Craft *c = cl->getCraft();
+		const std::string m = c && c->getDestination() ? targetName(c->getDestination()) : std::string("?");
+		picked = m;
+		turnSeen = -1; sideSeen = -1; searching = false; limitHit = false; downSeen[0] = downSeen[1] = downSeen[2] = -1;
+		if (game->getSavedGame()) tl(game->getSavedGame(), "LANDING at " + m);
+		cl->btnYesClick(nullptr);
+		return;
+	}
+	if (campaign() > 0)
+	{
+		if (auto *lf = dynamic_cast<LowFuelState*>(top)) { (void)lf; static const State *lfSeen = nullptr; if (lfSeen != top && game->getSavedGame()) { lfSeen = top; std::ostringstream lfs; lfs << "LOW FUEL popup:";
+				for (auto *b : *game->getSavedGame()->getBases()) for (auto *c : *b->getCrafts()) if (c->getStatus() == "STR_OUT" || c->getLowFuel())
+					lfs << " " << c->getRules()->getType() << " fuel " << c->getFuel() << "/" << c->getCraftStats().fuelMax << " limit " << c->getFuelLimit()
+					    << " home " << (int)(c->getDistance(b) * 3440) << " nm at " << (int)(c->getLongitude() * 57.2958) << "," << (int)(c->getLatitude() * -57.2958);
+				tl(game->getSavedGame(), lfs.str()); } }
+		// department heads: the simulator leaves the posts as they are (a head picked at random would skew the run)
+		if (auto *ah = dynamic_cast<AppointHeadState*>(top)) { if (held > 1200 && !presses) { presses = 1; note("department head: left as it is"); ah->btnCancelClick(nullptr); } return; }
+		if (auto *ds = dynamic_cast<DepartmentsState*>(top)) { if (held > 1200 && !presses) { presses = 1; ds->btnOkClick(nullptr); } return; }
+		if (auto *sj = dynamic_cast<SoldierJobsState*>(top)) { if (held > 1200 && !presses) { presses = 1; sj->btnCancelClick(nullptr); } return; }
+		// the world map's own notices: read and closed (the director sends the squad and runs the labs itself)
+		if (held < 900 || presses) { if (dynamic_cast<NewPossibleResearchState*>(top) || dynamic_cast<ResearchCompleteState*>(top) || dynamic_cast<MissionDetectedState*>(top) || dynamic_cast<UfoDetectedState*>(top) || dynamic_cast<ResearchState*>(top)) return; }
+		else if (auto *a = dynamic_cast<NewPossibleResearchState*>(top)) { presses = 1; a->btnOkClick(nullptr); return; }
+		else if (auto *a = dynamic_cast<ResearchCompleteState*>(top)) { presses = 1; a->btnOkClick(nullptr); return; }
+		else if (auto *a = dynamic_cast<MissionDetectedState*>(top)) { presses = 1; a->btnCancelClick(nullptr); return; }
+		else if (auto *a = dynamic_cast<UfoDetectedState*>(top)) { presses = 1; a->btnCancelClick(nullptr); return; }
+		else if (auto *a = dynamic_cast<ResearchState*>(top)) { presses = 1; a->btnOkClick(nullptr); return; }
+	}
+	if (dynamic_cast<MainMenuState*>(top))
+	{
+		if (held < 1500) return;
+		if (!started)
+		{
+			started = true; topSeen = nullptr;
+			note("opening New Battle");
+			game->pushState(new NewBattleState);
+		}
+		else if (++menus == 1)
+		{
+			if (!resultWritten) result("NO RESULT " + mission() + ": back at the main menu without a debrief");
+			note("done, quitting");
+			game->quit();
+		}
+		return;
+	}
+	if (auto *nb = dynamic_cast<NewBattleState*>(top))
+	{
+		if (held < 1500 || presses) return;
+		presses = 1;
+		if (!nb->simStart(mission()))
+		{
+			result("NO MISSION " + mission() + ": New Battle has no such mission");
+			game->quit();
+		}
+		return;
+	}
+	if (auto *br = dynamic_cast<BriefingState*>(top))
+	{
+		if (held < 2500 || presses) return;
+		presses = 1; shot(game, "briefing"); br->btnOkClick(nullptr);
+		return;
+	}
+	if (auto *inv = dynamic_cast<InventoryState*>(top))
+	{
+		if (held < 1500 || presses) return;
+		presses = 1; shot(game, "equipment"); note("equipment screen: OK"); inv->btnOkClick(nullptr);
+		return;
+	}
+	if (auto *nt = dynamic_cast<NextTurnState*>(top))
+	{
+		if (held < 1200 || presses) return;
+		presses = 1; nt->close();
+		return;
+	}
+	if (dynamic_cast<DebriefingState*>(top))
+	{
+		if (held < 2500 || presses) return;
+		presses = 1; shot(game, campaign() > 0 ? "debrief_" + std::to_string(camp.battles + 1) : std::string("debrief"));
+		if (campaign() > 0 && game->getSavedGame()) { ++camp.battles; camp.lastProgress = game->getSavedGame()->getDaysPassed(); }
+		static_cast<DebriefingState*>(top)->btnOkClick(nullptr);
+		return;
+	}
+	if (auto *bs = dynamic_cast<BattlescapeState*>(top))
+	{
+		BattlescapeGame *bg = bs->getBattleGame();
+		SavedBattleGame *sb = game->getSavedGame() ? game->getSavedGame()->getSavedBattle() : nullptr;
+		if (!bg || !sb) return;
+		// AREA SECURE: nothing left to fight; the Joes leave (END MISSION, which counts as a win)
+		if (bg->searchingSecuredSite() && !bg->isBusy())
+		{
+			if (!searching) { searching = true; note("area secure: END MISSION"); }
+			bs->btnEndTurnClick(nullptr);   // asks first: the OK below answers it
+			return;
+		}
+		// RIG (OXCE_BATTLESIM_HIDE=<turns>): the Joes keep still and end their turn for that many turns, so the guards stay
+		// unaware and the quiet-time stealth (jobs, shift changes, searching) can be watched
+		if (const char *h = getenv("OXCE_BATTLESIM_HIDE"))
+			if (sb->getTurn() <= atoi(h) && sb->getSide() == 0 && !bg->isBusy())
+			{
+				static int endedTurn = -1;
+				if (endedTurn != sb->getTurn()) { endedTurn = sb->getTurn(); note("hiding: the Joes end turn " + std::to_string(sb->getTurn())); bs->btnEndTurnClick(nullptr); }
+				return;
+			}
+		if (!limitHit && sb->getTurn() > maxTurns() && sb->getSide() == 0 && !bg->isBusy())
+		{
+			limitHit = true; note("turn limit: the Joes pull out");
+			game->pushState(new AbortMissionState(sb, bs));
+		}
+		return;
+	}
+	if (!started) return;   // the loading screens and the intro come and go by themselves
+	// ANY OTHER SCREEN in front during a run (a message, a confirmation): answer it with OK after a few seconds,
+	// three times; still there after that is a screen the player cannot get past either.
+	if (held > (campaign() > 0 ? 2000u + 2500u * presses : 5000u + 6000u * presses))
+	{
+		if (presses < 3)
+		{
+			++presses;
+			note("OK on " + name(top));
+			press(Options::keyOk);
+		}
+		else if (campaign() > 0 && presses < 6)
+		{
+			// a campaign screen that OK does not close (a choice, a list): back out of it
+			++presses;
+			note("Cancel on " + name(top));
+			press(Options::keyCancel);
+		}
+		else
+		{
+			shot(game, "stuck_screen");
+			result(std::string(campaign() > 0 ? "CAMPAIGN " : "") + "STUCK " + mission() + " on the " + name(top) + " screen (OK pressed 3 times, still there)");
+				GJ_EXIT(5);
+		}
+	}
+}
+
+}
+}
diff --git a/src/Battlescape/BattleSim.h b/src/Battlescape/BattleSim.h
new file mode 100644
index 0000000..6358ac5
--- /dev/null
+++ b/src/Battlescape/BattleSim.h
@@ -0,0 +1,51 @@
+#pragma once
+/*
+ * G.I. Joe BATTLE SIMULATOR (John 17 Nov 18:09-18:12: "an offline simulator that can run the game and test it").
+ * OXCE_BATTLESIM=<deployment name or New Battle list number>: the game opens New Battle on that mission by itself,
+ * the computer plays BOTH sides (the Joes with the same AI Cobra uses), every popup is answered, the debrief is
+ * written down, and the game quits. One battle per run, so a crash costs one battle and the next run goes on.
+ * Sim_Battles_4x.bat loops over every mission. Nothing here is reachable without the variable.
+ *   OXCE_BATTLESIM_OUT    folder for the result line, the event list and the screenshots (default: the user folder)
+ *   OXCE_BATTLESIM_TURNS  turn limit (default 30): past it the Joes pull out and the run says so
+ * What it finds: crashes, hangs, screens nobody can get past, turns that never end, errors in the log. It does
+ * not find out whether a mission is fun or fair: the Joes are played by Cobra's AI, which is not a player.
+ */
+#include <string>
+
+namespace OpenXcom
+{
+class Game;
+class State;
+class BattlescapeGame;
+
+namespace BattleSim
+{
+	/// Is this run a simulation?
+	bool on();
+	/// The campaign simulator's length in days (OXCE_CAMPAIGNSIM), 0 when not running one.
+	int campaign();
+	/// The mission being played: its deployment name once New Battle has picked it, else what was asked for.
+	std::string mission();
+	/// New Battle tells it the deployment it picked.
+	void setMission(const std::string &deployment);
+	/// The turn limit.
+	int maxTurns();
+	/// A file in the output folder.
+	std::string out(const std::string &file);
+	/// One line in the run's own event list (and the game log).
+	void note(const std::string &line);
+	/// The run's one-line result (the loop collects these); written once, the first call wins.
+	void result(const std::string &line);
+	/// Each main-loop frame: the heartbeat the hang watchdog reads, and the screen in front.
+	void frame(Game *game, State *top);
+	/// A screenshot into the output folder.
+	void shot(Game *game, const std::string &tag);
+	/// From the battle: the turn and side now playing (screenshots, the turn limit, a turn that never ends).
+	void battleTick(Game *game, BattlescapeGame *bg, int turn, int side);
+	/// The style set for a side (OXCE_BATTLESIM_JOES / _COBRA: defensive, normal, aggressive): the AI's aggression
+	/// for a unit of that faction, or its own when the side plays normal.
+	int aggression(int faction, int own);
+	/// The last turn the battle reached.
+	int lastTurn();
+}
+}
