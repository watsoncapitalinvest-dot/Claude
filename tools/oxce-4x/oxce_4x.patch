+void ResearchTreeState::paintView(double X0, double Y0, double k)
+{
+	// lane bands with a faint grid
+	for (size_t L = 0; L < _laneTypes.size(); ++L)
+	{
+		const double y0 = Y0 + (_laneTop[L] * PY - _scrollY) * k, y1 = y0 + _laneRows[L] * PY * k;
+		HiUI::Paint::rect(X0, y0, X0 + VW * k, y1, (L % 2) ? 0x1B2023 : 0x14181A);
+		HiUI::Paint::rect(X0, y1 - 0.25 * k, X0 + VW * k, y1, C_EDGE);
+	}
+	{
+		const double ts = 192;   // the blueprint tile at its own size
+		for (double ty = Y0; ty < Y0 + VH * k; ty += ts)
+			for (double tx = X0; tx < X0 + VW * k; tx += ts)
+				HiUI::Paint::image(TREE + "tree_bg_tile.png", tx, ty, tx + ts, ty + ts, 110);
+	}
+	auto cardX = [&](const Node &n) { return X0 + (2 + n.col * PX - _scrollX) * k; };
+	auto cardY = [&](const Node &n) { return Y0 + (1 + n.row * PY - _scrollY) * k; };
+	const double lw = std::max(2.0, 0.5 * k);
+	// elbow lines: out of the right side, into the left side
+	for (size_t i = 0; i < _nodes.size(); ++i)
+	{
+		const Node &n = _nodes[i];
+		for (const auto *dep : n.r->getDependencies())
+		{
+			auto it = std::find_if(_nodes.begin(), _nodes.end(), [&](const Node &m) { return m.r == dep; });
+			if (it == _nodes.end()) continue;
+			const Uint32 c = n.st == N_DONE ? C_OLIVE : (n.st == N_AVAILABLE || n.st == N_RESEARCHING) ? C_YELLOW : C_EDGE;
+			const double w = ((int)i == _sel) ? lw * 1.7 : lw;
+			const double x0 = cardX(*it) + CW * k, y0 = cardY(*it) + CH * k / 2, x1 = cardX(n), y1 = cardY(n) + CH * k / 2, xm = (x0 + x1) / 2;
+			HiUI::Paint::rect(x0, y0 - w / 2, xm + w / 2, y0 + w / 2, c);
+			HiUI::Paint::rect(xm - w / 2, std::min(y0, y1) - w / 2, xm + w / 2, std::max(y0, y1) + w / 2, c);
+			HiUI::Paint::rect(xm - w / 2, y1 - w / 2, x1, y1 + w / 2, c);
+		}
+	}
+	// cards (spec section 3)
+	for (size_t i = 0; i < _nodes.size(); ++i)
+	{
+		const Node &n = _nodes[i];
+		const double x0 = cardX(n), y0 = cardY(n), x1 = x0 + CW * k, y1 = y0 + CH * k;
+		if (x1 < X0 || x0 > X0 + VW * k || y1 < Y0 || y0 > Y0 + VH * k) continue;
+		Uint32 plate = C_PANEL, edge = C_EDGE, ink = C_DIM;
+		switch (n.st)
+		{
+		case N_DONE: plate = C_ROW; edge = C_GREEN; ink = C_MUTED; break;
+		case N_RESEARCHING: plate = 0x2A3033; edge = C_BLUE; ink = C_BONE; break;
+		case N_AVAILABLE: plate = C_RAISED; edge = C_YELLOW; ink = C_BONE; break;
+		case N_NEEDITEM: plate = C_PANEL; edge = C_DARKRED; ink = C_GREY; break;
+		default: break;
+		}
+		if ((int)i == _sel) HiUI::Paint::rect(x0 - 1.2 * k, y0 - 1.2 * k, x1 + 1.2 * k, y1 + 1.2 * k, C_YELLOW, 90);
+		const char *plateArt = n.st == N_AVAILABLE ? "card_raised" : (n.st == N_LOCKED || n.st == N_NEEDITEM) ? "card_flat" : "card_normal";
+		if (!HiUI::Paint::image(TREE + plateArt + ".png", x0, y0, x1, y1)) HiUI::Paint::rect(x0, y0, x1, y1, plate);
+		if (n.st != N_LOCKED || (int)i == _sel)
+			HiUI::Paint::frame(x0, y0, x1, y1, (int)i == _sel ? std::max(3.0, 0.7 * k) : std::max(2.0, 0.35 * k), (int)i == _sel ? C_YELLOW : edge);
+		// Cobra-derived topics: a red strip down the left edge (anything that uses up an item)
+		if (n.r->needItem()) HiUI::Paint::rect(x0, y0, x0 + 1.0 * k, y1, C_RED);
+		// the category icon (or the "?" crate), dimmed on a locked card
+		{
+			const double s = 8.2 * k, ix = x0 + 1.6 * k, iy = y0 + (CH * k - s) / 2;
+			HiUI::Paint::image(TREE + (n.st == N_NEEDITEM ? std::string("icon_unknown") : topicIcon(n.r)) + ".png", ix, iy, ix + s, iy + s, n.st == N_LOCKED ? 110 : 255);
+		}
+		const std::string name = n.st == N_NEEDITEM ? std::string("?") : std::string(tr(n.r->getName()));
+		HiUI::Paint::text("label", name, x0 + 10.6 * k, y0 + 1.0 * k, x1 - 4.5 * k, y0 + 8.4 * k, 2.4 * k, 0, 1, ink);
+		std::ostringstream cost;
+		cost << n.r->getCost() << " days";
+		if (n.st == N_NEEDITEM) cost.str(std::string(tr("STR_TREE_NEEDS_ITEM")));
+		if (n.st != N_NEEDITEM) HiUI::Paint::image(TREE + "cost_days.png", x0 + 10.6 * k, y0 + 9.0 * k, x0 + 13.4 * k, y0 + 11.8 * k, n.st == N_LOCKED ? 110 : 255);
+		HiUI::Paint::text("label", cost.str(), x0 + (n.st == N_NEEDITEM ? 10.6 : 14.2) * k, y0 + 8.6 * k, x1 - 2 * k, y1 - 1.4 * k, 1.9 * k, 0, 1, n.st == N_LOCKED ? C_DIM : C_MUTED);
+		// badges: done check, padlock, progress
+		const char *badge = n.st == N_DONE ? "badge_done" : n.st == N_LOCKED ? "badge_locked" : n.st == N_RESEARCHING ? "badge_scientist" : nullptr;
+		if (badge) HiUI::Paint::image(TREE + badge + ".png", x1 - 5.2 * k, y0 + 0.9 * k, x1 - 0.8 * k, y0 + 5.3 * k);
+		if (n.st == N_RESEARCHING) HiUI::Paint::rect(x0 + 1 * k, y1 - 1.2 * k, x0 + 1 * k + (CW - 2) * k * n.pct / 100.0, y1 - 0.4 * k, C_BLUE);
+	}
+}
