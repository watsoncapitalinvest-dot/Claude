+/// 4x battlescape: blit a classic-size overlay (text, markers) enlarged by the battle scale.
+static void upBlit(SurfaceRaw<const Uint8> src, SurfaceRaw<Uint8> dst, int x, int y, int shade = 0, int newBaseColor = 0)
+{
+	if (!src) return;
+	const int S = SurfaceSet::battleScale();
+	if (S <= 1 || src.getWidth() > 64) { Surface::blitRaw(dst, src, x, y, shade, false, newBaseColor); return; }
+	const int w = src.getWidth() * S, h = src.getHeight() * S;
+	std::vector<Uint8> buf(w * h, 0);
+	for (int sy = 0; sy < src.getHeight(); ++sy)
+	{
+		const Uint8 *row = (const Uint8*)((const char*)src.getBuffer() + sy * src.getPitch());
+		for (int sx = 0; sx < src.getWidth(); ++sx)
+		{
+			Uint8 c = row[sx];
+			if (!c) continue;
+			for (int dy = 0; dy < S; ++dy)
+				for (int dx = 0; dx < S; ++dx)
+					buf[(sy * S + dy) * w + sx * S + dx] = c;
+		}
+	}
+	Surface::blitRaw(dst, SurfaceRaw<const Uint8>{ (const Uint8*)buf.data(), w, h, (Uint16)w }, x, y, shade, false, newBaseColor);
+}
