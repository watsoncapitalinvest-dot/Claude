+{
+	struct Spec { const char *id; const char *name; bool armed; };
+	// the pool (s.1) and the Year 1 signatures (s.3). "armed" = acts on the vehicle's next shot.
+	const Spec POOL[] = {
+		{ "LOBBED_SHOT", "LOBBED SHOT", false },     // the L.Y.N.X.'s, a weapon mode already: listed for information
+		{ "FULL_SALVO", "FULL SALVO", true },
+		{ "SKY_WATCH", "SKY WATCH", false },
+		{ "SUPPRESSING_FIRE", "SUPPRESSING FIRE", true },
+		{ "HULL_DOWN", "HULL DOWN", false },
+		{ "RAM", "RAM", false },
+		{ "LASER_CHARGE", "LASER CHARGE", false },
+		{ "FLAME_SWEEP", "FLAME SWEEP", true },
+		{ "FLANK_SPEED", "FLANK SPEED", false },
+		{ "JUMP", "JUMP", false },
+		{ "SMOKE_SCREEN", "SMOKE SCREEN", false },
+		{ "DISMOUNT", "DISMOUNT", false },
+		{ "SHIELD_WALL", "SHIELD WALL", false },
+		{ "RADAR_SWEEP", "RADAR SWEEP", false },
+		{ "SPOTTER", "SPOTTER", true },
+		{ "FIELD_REPAIR", "FIELD REPAIR", false },
+		{ "RESUPPLY", "RESUPPLY", false },
+		{ "BRIDGE_CLEAR", "CLEAR THE WAY", false },
+		{ "GO_TO_GROUND", "GO TO GROUND", false },
+		{ "STRAFING_RUN", "STRAFING RUN", false },
+		{ "STEAMROLLER", "STEAMROLLER", false },
+		{ "GUN_RUN", "GUN RUN", false },
+		{ "SENTRY_LOCK", "SENTRY LOCK", false },
+	};
+	const int NPOOL = sizeof(POOL) / sizeof(POOL[0]);
+
+	int poolIndex(const std::string &id)
+	{
+		for (int i = 0; i < NPOOL; ++i) if (id == POOL[i].id) return i;
+		return -1;
+	}
+
+	const Mod::VehicleSpecialRules &R(SavedBattleGame *save) { return save->getMod()->getVehicleSpecialRules(); }
+	std::string K(const char *k, const BattleUnit *u) { return std::string(k) + ":" + std::to_string(u->getId()); }
+	int vget(SavedBattleGame *s, const std::string &k) { return s->getVanStop(k); }
+	void vset(SavedBattleGame *s, const std::string &k, int v) { s->setVanStop(k, v); }
+
+	/// used on turn 'stored' by a unit of faction f: still on until that faction's next turn
+	bool throughNextTurn(SavedBattleGame *s, int stored, UnitFaction f)
+	{
+		if (stored <= 0) return false;
+		const int t = s->getTurn();
+		if (t == stored) return true;
+		// the turn number moves on at the Joes' turn: a Cobra unit's effect lasts through the Joes' next turn
+		return t == stored + 1 && f != FACTION_PLAYER && s->getSide() == FACTION_PLAYER;
+	}
+	/// set during this unit's own turn and it is still that turn
+	bool ownTurnNow(SavedBattleGame *s, int stored, UnitFaction f) { return stored > 0 && stored == s->getTurn() && s->getSide() == f; }
+
+	const std::vector<std::string> *specialsOf(SavedBattleGame *save, const BattleUnit *u)
+	{
+		const auto &m = R(save).units;
+		auto it = m.find(u->getType());
+		return it == m.end() ? nullptr : &it->second;
+	}
+	bool has(SavedBattleGame *save, const BattleUnit *u, const char *id)
+	{
+		const auto *v = specialsOf(save, u);
+		return v && std::find(v->begin(), v->end(), id) != v->end();
+	}
+	int usesLeft(SavedBattleGame *save, const BattleUnit *u, const std::string &id)
+	{
+		auto it = R(save).uses.find(id);
+		const int max = it == R(save).uses.end() ? 99 : it->second;
+		return max - vget(save, "vsUse:" + id + ":" + std::to_string(u->getId()));
+	}
+	void spendUse(SavedBattleGame *save, const BattleUnit *u, const std::string &id)
+	{
+		const std::string k = "vsUse:" + id + ":" + std::to_string(u->getId());
+		vset(save, k, vget(save, k) + 1);
+	}
+	int tuCost(SavedBattleGame *save, const BattleUnit *u, const std::string &id)
+	{
+		auto it = R(save).tu.find(id);
+		return it == R(save).tu.end() ? 0 : it->second * u->getBaseStats()->tu / 100;
+	}
+	Position dirVec(int dir) { Position v; Pathfinding::directionToVector(dir, &v); return v; }
+	int facing(const BattleUnit *u) { return u->getTurretType() != -1 ? u->getTurretDirection() : u->getDirection(); }
+
+	/// the tiles just in front of u's footprint, in its facing direction
+	std::vector<Position> frontTiles(const BattleUnit *u, int steps = 1)
+	{
+		const int size = u->getArmor()->getSize();
+		const Position p = u->getPosition(), v = dirVec(u->getDirection());
+		std::vector<Position> out;
+		for (int x = 0; x < size; ++x) for (int y = 0; y < size; ++y)
+		{
+			const Position q = p + Position(x, y, 0) + Position(v.x * steps, v.y * steps, 0);
+			if (q.x >= p.x && q.x < p.x + size && q.y >= p.y && q.y < p.y + size) continue;
+			if (std::find(out.begin(), out.end(), q) == out.end()) out.push_back(q);
+		}
+		return out;
+	}
+	BattleUnit *unitInFront(SavedBattleGame *save, const BattleUnit *u)
+	{
+		for (const Position &q : frontTiles(u))
+			if (Tile *t = save->getTile(q))
+				if (BattleUnit *b = t->getUnit()) if (b != u && !b->isOut()) return b;
+		return nullptr;
+	}
+	/// within one tile of u's footprint
+	bool beside(const BattleUnit *u, const BattleUnit *o)
+	{
+		if (u == o || u->getPosition().z != o->getPosition().z) return false;
+		const int su = u->getArmor()->getSize(), so = o->getArmor()->getSize();
+		const Position a = u->getPosition(), b = o->getPosition();
+		return b.x + so - 1 >= a.x - 1 && b.x <= a.x + su && b.y + so - 1 >= a.y - 1 && b.y <= a.y + su;
+	}
+	/// is 'at' inside the arc of +-arcDeg around direction dir, seen from 'from'
+	bool inArc(Position from, int dir, Position at, int arcDeg)
+	{
+		const Position v = dirVec(dir);
+		const double dx = at.x - from.x, dy = at.y - from.y;
+		const double len = std::sqrt(dx * dx + dy * dy), vl = std::sqrt((double)v.x * v.x + (double)v.y * v.y);
+		if (len < 0.5) return true;
+		const double cosA = (dx * v.x + dy * v.y) / (len * vl);
+		return cosA >= std::cos(arcDeg * 3.14159265358979 / 180.0);
+	}
+	BattleItem *rocketWeapon(BattleUnit *u)
+	{
+		for (auto *it : *u->getInventory())
+			if (it->getRules()->getBattleType() == BT_FIREARM && it->getRules()->getGjaGroup() == "MISSILES")
+				if (const BattleItem *a = it->getAmmoForSlot(0)) if (a->getAmmoQuantity() > 0) return it;
+		return nullptr;
+	}
+	bool isVehicleUnit(const BattleUnit *u) { return !u->getGeoscapeSoldier() && (u->getArmor()->getSize() > 1 || u->getTurretType() != -1); }
+	void refreshAround(BattlescapeGame *game, Position p)
+	{
+		game->getTileEngine()->calculateLighting(LL_AMBIENT, p, 2, true);
+		game->getTileEngine()->calculateFOV(p, 2, true);
+	}
+	/// knocks out light cover (objects and walls with armour <= maxArmor) on a tile; false if something heavier stands
+	int g_cleared = 0;
+	bool g_selfTest = false; // rig self-test: ignores whose turn it is
+	bool clearTile(SavedBattleGame *save, Tile *t, int maxArmor)
+	{
+		bool clear = true;
+		for (TilePart part : { O_OBJECT, O_WESTWALL, O_NORTHWALL })
+		{
+			MapData *md = t->getMapData(part);
+			if (!md) continue;
+			if (md->getArmor() <= maxArmor) { t->destroy(part, save->getObjectiveType()); ++g_cleared; }
+			else clear = false;
+		}
+		return clear;
+	}
+}
