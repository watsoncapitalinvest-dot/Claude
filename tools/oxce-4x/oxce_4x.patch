+	// ============================================================ STENCILLED PAINT
+	// John 14 Nov 19:14: "I'd like the text to look higher quality ... a better colour or treatment",
+	// and he picked stencilled paint: cream letters, a slight worn / speckled texture, a faint
+	// shadow for depth. Every letter the overlay draws goes through paintPx, so the briefings, the
+	// turn page and the screens all get it. The texture is keyed to the letter's own position, so
+	// it does not crawl when the text moves. Small type gets the colour and the shadow only: wear
+	// on a 10-pixel letter reads as a rendering fault, not as paint.
+	inline Uint32 hash2(int u, int v)
+	{
+		Uint32 h = (Uint32)u * 374761393u + (Uint32)v * 668265263u;
+		h = (h ^ (h >> 13)) * 1274126177u;
+		return h ^ (h >> 16);
+	}
+	/// smooth value noise, 0..255, blobs about `cell` pixels across
+	inline int blobs(int u, int v, int cell)
+	{
+		const int cu = u >= 0 ? u / cell : (u - cell + 1) / cell, cv = v >= 0 ? v / cell : (v - cell + 1) / cell;
+		const int fu = ((u - cu * cell) * 256) / cell, fv = ((v - cv * cell) * 256) / cell;
+		const int a = hash2(cu, cv) & 255, b = hash2(cu + 1, cv) & 255, c = hash2(cu, cv + 1) & 255, d = hash2(cu + 1, cv + 1) & 255;
+		const int top = a + (((b - a) * fu) >> 8), bot = c + (((d - c) * fu) >> 8);
+		return top + (((bot - top) * fv) >> 8);
+	}
+	/// a light, unsaturated ink becomes cream; a colour that says something keeps its hue
+	inline Uint32 creamy(Uint32 col)
+	{
+		const int r = (col >> 16) & 255, g = (col >> 8) & 255, b = col & 255;
+		const int hi = std::max(r, std::max(g, b)), lo = std::min(r, std::min(g, b));
+		if (hi < 150) return col;
+		if (hi - lo > 40)
+		{
+			// the old palettes' washed pinks (the briefing's 233,172,161) say nothing: cream them.
+			// A red picked on purpose is far more saturated (the readable() wash keeps it so) and
+			// green, yellow and blue keep their hue, because there the colour is the meaning.
+			if (hi - lo >= 120 || hi != r) return col;
+			const int hue = g >= b ? (g - b) * 60 / (hi - lo) : 360 - (b - g) * 60 / (hi - lo);
+			if (hue > 25 && hue < 300) return col;
+		}
+		const Uint32 cream = rgb(243, 232, 206);
+		return mix(col, rgb(cream >> 16 & 255, cream >> 8 & 255, cream & 255), 200);
+	}
+	inline bool lightInk(Uint32 col)
+	{
+		return ((col >> 16 & 255) * 3 + (col >> 8 & 255) * 6 + (col & 255)) / 10 > 120;
+	}
+	/// one pixel of a painted letter: (u, v) are letter-local display pixels, cov its coverage,
+	/// strength 0..256 how much wear this size of type takes, sd the shadow offset (0 = none)
+	/// the dark the letters sit on: one pass for every letter of a line BEFORE any ink, so a
+	/// letter's outline never darkens its neighbour (John 14 Nov 20:08 "just make it look better")
+	inline void darkPx(int X, int Y, int cov, int sd)
+	{
+		if (cov <= 0 || sd <= 0) return;
+		cov = std::min(255, cov);
+		auto put = [&](int x, int y, int a)
+		{
+			if (x < 0 || y < 0 || x >= sw || y >= sh) return;
+			Uint32 &s = over[(size_t)y * sw + x];
+			s = mix(s, rgb(10, 9, 7), cov * a >> 8);
+		};
+		// a thin keyline all round, so the edge is crisp on any background
+		const int k = std::max(1, sd / 3);
+		for (int dy = -k; dy <= k; ++dy)
+			for (int dx = -k; dx <= k; ++dx)
+				if (dx || dy) put(X + dx, Y + dy, 150);
+		// a soft drop shadow down and to the right: three steps, each fainter, reads as a blur
+		put(X + sd, Y + sd, 170);
+		put(X + sd + 1, Y + sd + 1, 110);
+		put(X + sd * 2, Y + sd * 2, 55);
+	}
+	/// one pixel of a letter's ink: lit from above, and on big type the paint a little thin in patches
+	inline void paintPx(int X, int Y, int u, int v, int cov, Uint32 col, int strength, int sd, int t = 128)
+	{
+		if (cov <= 0) return;
+		cov = std::min(255, cov);
+		if (sd > 0)
+		{
+			// lit from above: the top of the letter a touch brighter, the foot a touch darker
+			const int f = 272 - (t * 44 >> 8);                                   // 272 at the top .. 228 at the foot
+			const int r = std::min(255, (int)(col >> 16 & 255) * f >> 8);
+			const int g = std::min(255, (int)(col >> 8 & 255) * f >> 8);
+			const int b = std::min(255, (int)(col & 255) * f >> 8);
+			col = rgb(r, g, b);
+		}
+		if (strength > 0)
+		{
+			// only soft worn patches now: the chips and the grain read as noise (20:06 "that looks bad")
+			const int patch = std::max(0, blobs(u, v, 9) - 165) * 2;           // 0..180 over about a quarter
+			const int dim = patch * strength >> 9;                                // up to about 90/255 darker
+			col = mix(col, rgb(120, 112, 96), dim);
+		}
+		Uint32 &o = over[(size_t)Y * sw + X];
+		o = mix(o, col, cov);
+	}
+	/// how much wear type of this many display pixels tall takes: none below 16, all from 34
+	inline int wearFor(int px) { return std::max(0, std::min(256, (px - 16) * 256 / 18)); }
+
