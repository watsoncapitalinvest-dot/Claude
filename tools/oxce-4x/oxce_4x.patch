diff --git a/src/Basescape/PitBlueprintView.cpp b/src/Basescape/PitBlueprintView.cpp
new file mode 100644
index 0000000..847a824
--- /dev/null
+++ b/src/Basescape/PitBlueprintView.cpp
@@ -0,0 +1,286 @@
+#include "PitBlueprintView.h"
+#include <algorithm>
+#include <cmath>
+#include "PitPlace.h"
+#include "../Engine/Action.h"
+#include "../Engine/HiUI.h"
+#include "../Mod/Mod.h"
+#include "../Mod/RuleBaseFacility.h"
+#include "../Savegame/Base.h"
+#include "../Savegame/BaseFacility.h"
+
+namespace OpenXcom
+{
+
+namespace
+{
+const Uint32 NAVY = 0x0a1f4a, SHEET = 0x10306a, GRID = 0x1b4282, OPEN = 0x143873, BLOCK = 0x2c5ca6,
+	LINE = 0xe6efff, CARD = 0x1d4f9c, CARD_EDGE = 0xdfeaff, BUILDING = 0xd8b45a, GOOD = 0x36c76a, BAD = 0xe04848,
+	TAB = 0x16386f, TAB_ON = 0x2f63b8, DIM = 0x8fb0e0;
+}
+
+PitBlueprintView::PitBlueprintView(int width, int height, int x, int y) : InteractiveSurface(width, height, x, y)
+{
+}
+
+PitBlueprintView::~PitBlueprintView()
+{
+	HiUI::nativePanel(this, nullptr);
+}
+
+void PitBlueprintView::setup(const Mod *mod, Base *base, Namer tr)
+{
+	_mod = mod; _base = base; _tr = tr;
+	const auto &R = mod->getPitPlaceRules();
+	int x0 = R.w, y0 = R.h, x1 = -1, y1 = -1;
+	for (const auto &f : R.floors)
+		for (int y = 0; y < R.h; ++y)
+			for (int x = 0; x < R.w; ++x)
+				if (PitPlace::maskAt(mod, f.first, x, y)) { x0 = std::min(x0, x); y0 = std::min(y0, y); x1 = std::max(x1, x); y1 = std::max(y1, y); }
+	if (x1 < 0) { x0 = 0; y0 = 0; x1 = std::max(0, R.w - 1); y1 = std::max(0, R.h - 1); }
+	_bx0 = x0; _by0 = y0; _bw = x1 - x0 + 1; _bh = y1 - y0 + 1;
+	HiUI::nativePanel(this, [this](double X0, double Y0, double k) { paint(X0, Y0, k); });
+	_redraw = true;
+}
+
+double PitBlueprintView::scale() const
+{
+	return std::min((double)(getWidth() - 4) / _bw, (double)(getHeight() - TAB_H - 6) / _bh);
+}
+// the screen position of map tile 0,0 (the sheet itself starts at tile _bx0, _by0)
+double PitBlueprintView::sheetX() const
+{
+	return (getWidth() - _bw * scale()) / 2 - _bx0 * scale();
+}
+double PitBlueprintView::sheetY() const
+{
+	return TAB_H + 2 + (getHeight() - TAB_H - 2 - _bh * scale()) / 2 - _by0 * scale();
+}
+
+void PitBlueprintView::mouseOver(Action *action, State *state)
+{
+	_mx = action->getRelativeXMouse() / action->getXScale();
+	_my = action->getRelativeYMouse() / action->getYScale();
+	_redraw = true;
+	InteractiveSurface::mouseOver(action, state);
+}
+
+void PitBlueprintView::mousePress(Action *action, State *state)
+{
+	_mx = action->getRelativeXMouse() / action->getXScale();
+	_my = action->getRelativeYMouse() / action->getYScale();
+	InteractiveSurface::mousePress(action, state);
+}
+
+int PitBlueprintView::tabUnderMouse() const
+{
+	if (_my < 0 || _my >= TAB_H || _mx < 0 || _mx >= getWidth()) return -1;
+	return std::min(5, (int)(_mx / (getWidth() / 6.0)));
+}
+
+bool PitBlueprintView::tileUnderMouse(int &x, int &y) const
+{
+	if (!_mod || _my < TAB_H) return false;
+	const double s = scale();
+	const double fx = (_mx - sheetX()) / s, fy = (_my - sheetY()) / s;
+	const auto &R = _mod->getPitPlaceRules();
+	if (!_ghost.empty())
+	{
+		int w, h;
+		PitPlace::footprint(_mod, _ghost, _turned, w, h);
+		x = (int)std::floor(fx - w / 2.0 + 0.5);
+		y = (int)std::floor(fy - h / 2.0 + 0.5);
+		const auto *m = R.module(_ghost);
+		if (m && !m->spots.empty())
+		{
+			// a bay: snap to the nearest bay
+			double best = 1e9;
+			for (const auto &sp : m->spots)
+				if (sp.size() >= 2)
+				{
+					const double d = std::hypot(sp[0] + w / 2.0 - fx, sp[1] + h / 2.0 - fy);
+					if (d < best) { best = d; x = sp[0]; y = sp[1]; }
+				}
+		}
+		return fx >= -2 && fy >= -2 && fx < R.w + 2 && fy < R.h + 2;
+	}
+	x = (int)std::floor(fx); y = (int)std::floor(fy);
+	return x >= 0 && y >= 0 && x < R.w && y < R.h;
+}
+
+BaseFacility *PitBlueprintView::roomUnderMouse() const
+{
+	if (!_mod || !_base || _my < TAB_H) return nullptr;
+	if (_floor == 0)
+	{
+		// the Surface: the 13 hiding spots (BRIEF_FOR_BUILD_SurfaceInstall)
+		const int n = (int)_mod->getPitSurfaceRules().spots.size();
+		for (int i = 0; i < n; ++i)
+		{
+			const auto r = spotRect(i);
+			if (_mx >= r[0] && _mx < r[0] + r[2] && _my >= r[1] && _my < r[1] + r[3]) return PitPlace::surfaceAt(_mod, _base, i);
+		}
+		for (auto *f : *_base->getFacilities())   // an old save's surface rooms that found no spot
+			if (!f->isPitPlaced() && Mod::pitFloorAt(f->getX(), f->getY()) == 0) { (void)f; }
+		return nullptr;
+	}
+	for (const auto &u : unplaced())
+		if (_mx >= u.second[0] && _mx < u.second[0] + u.second[2] && _my >= u.second[1] && _my < u.second[1] + u.second[3]) return u.first;
+	int x, y;
+	if (!tileUnderMouse(x, y)) return nullptr;
+	return PitPlace::roomAt(_mod, _base, _floor, x, y);
+}
+
+std::vector<std::pair<BaseFacility*, std::array<double, 4> > > PitBlueprintView::unplaced() const
+{
+	std::vector<std::pair<BaseFacility*, std::array<double, 4> > > out;
+	if (!_mod || !_base || _floor == 0) return out;
+	const double y0 = sheetY() + (_by0 + _bh) * scale() + 3;
+	int i = 0;
+	for (auto *f : *_base->getFacilities())
+		if (!f->isPitPlaced() && PitPlace::placed(_mod, f->getRules()->getType()) && PitPlace::floorOf(_mod, f->getRules()->getType()) == _floor)
+		{
+			out.push_back({ f, std::array<double, 4>{ { 4.0 + i * 46, y0, 44.0, 10.0 } } });
+			++i;
+		}
+	return out;
+}
+
+std::array<double, 4> PitBlueprintView::spotRect(int i) const
+{
+	// four across, below the tabs, in base px
+	const double cols = 4, gap = 2, top = TAB_H + 4, bottom = getHeight() - 10;
+	const int n = _mod ? (int)_mod->getPitSurfaceRules().spots.size() : 13;
+	const int rows = std::max(1, (n + 3) / 4);
+	const double w = (getWidth() - gap * (cols + 1)) / cols, h = (bottom - top - gap * (rows - 1)) / rows;
+	return std::array<double, 4>{ { gap + (i % 4) * (w + gap), top + (i / 4) * (h + gap), w, h } };
+}
+
+std::string PitBlueprintView::ghostWhy() const
+{
+	int x, y;
+	if (_ghost.empty() || !tileUnderMouse(x, y)) return "STR_PIT_DOES_NOT_FIT";
+	return PitPlace::fits(_mod, _base, _ghost, x, y, _turned);
+}
+
+void PitBlueprintView::draw()
+{
+	Surface::draw();
+	clear();
+}
+
+void PitBlueprintView::paint(double X0, double Y0, double k)
+{
+	if (!_mod || !_base) return;
+	namespace P = HiUI::Paint;
+	const auto &R = _mod->getPitPlaceRules();
+	const double W = getWidth() * k, H = getHeight() * k;
+	P::rect(X0, Y0, X0 + W, Y0 + H, NAVY);
+	// tabs
+	const auto &names = _mod->getPitFloorRules().names;
+	const double tw = W / 6;
+	for (int i = 0; i < 6; ++i)
+	{
+		const bool on = i == _floor, hot = !_tabsLocked && tabUnderMouse() == i;
+		const double x0 = X0 + i * tw + k * 0.5, x1 = X0 + (i + 1) * tw - k * 0.5;
+		P::rect(x0, Y0, x1, Y0 + TAB_H * k, on ? TAB_ON : hot ? GRID : TAB);
+		if (on) P::rect(x0, Y0 + (TAB_H - 1) * k, x1, Y0 + TAB_H * k, LINE);
+		const std::string label = i < (int)names.size() && _tr ? _tr(names[i]) : std::to_string(i);
+		P::text("label", label, x0 + k, Y0, x1 - k, Y0 + TAB_H * k, 3.6 * k, 1, 1, (on || !_tabsLocked) ? LINE : DIM);
+	}
+	const double s = scale() * k, sx = X0 + sheetX() * k, sy = Y0 + sheetY() * k;
+	const double bx = sx + _bx0 * s, by = sy + _by0 * s, bw = _bw * s, bh = _bh * s;   // the sheet
+	P::rect(bx - 2 * k, by - 2 * k, bx + bw + 2 * k, by + bh + 2 * k, SHEET);
+	if (_floor == 0)
+	{
+		// the Surface: nothing is placed, each defence is installed in its own hiding spot (John 15 Nov)
+		const auto &S = _mod->getPitSurfaceRules().spots;
+		for (int i = 0; i < (int)S.size(); ++i)
+		{
+			const auto r = spotRect(i);
+			const double x0 = X0 + r[0] * k, y0 = Y0 + r[1] * k, x1 = x0 + r[2] * k, y1 = y0 + r[3] * k;
+			const BaseFacility *f = PitPlace::surfaceAt(_mod, _base, i);
+			const bool hot = f && f == roomUnderMouse();
+			P::rect(x0, y0, x1, y1, f ? (hot ? TAB_ON : CARD) : OPEN);
+			P::frame(x0, y0, x1, y1, k * 0.5, f ? (f->getBuildTime() > 0 ? BUILDING : CARD_EDGE) : GRID);
+			P::text("label", _tr ? _tr(S[i].name) : S[i].name, x0 + k, y0 + k * 0.5, x1 - k, y0 + (r[3] * 0.42) * k, 3.0 * k, 1, 1, DIM);
+			std::string what;
+			if (f)
+			{
+				what = _tr ? _tr(f->getRules()->getType()) : f->getRules()->getType();
+				if (f->getBuildTime() > 0)
+					what += "  " + std::to_string(std::min(f->getBuildTime(), f->getRules()->getBuildTime())) + (_tr ? " " + _tr("STR_DAYS_SHORT") : std::string(" d"));
+			}
+			else what = _tr ? _tr("STR_PIT_SPOT_EMPTY") : "empty";
+			P::text("label", what, x0 + k, y0 + (r[3] * 0.42) * k, x1 - k, y1 - k * 0.5, 3.8 * k, 1, 1, f ? LINE : DIM);
+		}
+		P::text("label", _tr ? _tr("STR_PIT_SURFACE_NOTE") : "", X0, Y0 + (getHeight() - 9) * k, X0 + getWidth() * k, Y0 + getHeight() * k, 3.2 * k, 1, 1, DIM);
+		return;
+	}
+	if (!R.floors.count(_floor)) return;
+	// the sheet: open floor, permanent fixtures, walls
+	for (int y = 0; y < R.h; ++y)
+		for (int x = 0; x < R.w; ++x)
+		{
+			const int m = PitPlace::maskAt(_mod, _floor, x, y);
+			if (!(m & 1)) continue;
+			const double x0 = sx + x * s, y0 = sy + y * s;
+			P::rect(x0, y0, x0 + s, y0 + s, (m & 8) ? BLOCK : OPEN);
+			P::rect(x0, y0, x0 + s, y0 + std::max(1.0, k * 0.15), GRID);
+			P::rect(x0, y0, x0 + std::max(1.0, k * 0.15), y0 + s, GRID);
+		}
+	const double lw = std::max(1.0, k * 0.55);
+	for (int y = 0; y < R.h; ++y)
+		for (int x = 0; x < R.w; ++x)
+		{
+			const int m = PitPlace::maskAt(_mod, _floor, x, y);
+			const double x0 = sx + x * s, y0 = sy + y * s;
+			if (m & 2) P::rect(x0 - lw / 2, y0, x0 + lw / 2, y0 + s, LINE);
+			if (m & 4) P::rect(x0, y0 - lw / 2, x0 + s, y0 + lw / 2, LINE);
+		}
+	// the rooms
+	const BaseFacility *hover = _ghost.empty() ? roomUnderMouse() : nullptr;
+	for (const auto *f : *_base->getFacilities())
+	{
+		const std::string &type = f->getRules()->getType();
+		if (!f->isPitPlaced() || PitPlace::floorOf(_mod, type) != _floor) continue;
+		int w, h;
+		PitPlace::footprint(_mod, type, f->getPitTurned(), w, h);
+		const double x0 = sx + f->getPitX() * s + k * 0.4, y0 = sy + f->getPitY() * s + k * 0.4;
+		const double x1 = sx + (f->getPitX() + w) * s - k * 0.4, y1 = sy + (f->getPitY() + h) * s - k * 0.4;
+		P::rect(x0, y0, x1, y1, f == hover ? TAB_ON : CARD, 235);
+		P::frame(x0, y0, x1, y1, k * 0.6, f->getBuildTime() > 0 ? BUILDING : CARD_EDGE);
+		std::string label = _tr ? _tr(type) : type;
+		if (f->getBuildTime() > 0)
+		{
+			const int days = f->getBuildTime() > f->getRules()->getBuildTime() ? f->getRules()->getBuildTime() : f->getBuildTime();
+			label += "\n" + std::to_string(days) + (_tr ? " " + _tr("STR_DAYS_SHORT") : std::string(" d"));
+		}
+		P::text("label", label, x0 + k * 0.6, y0 + k * 0.6, x1 - k * 0.6, y1 - k * 0.6, std::min(4.0 * k, (y1 - y0) / 3), 1, 1, LINE);
+	}
+	// rooms an old save had here that fit nowhere: still built, shown under the sheet so they can be dismantled
+	for (const auto &u : unplaced())
+	{
+		const double x0 = X0 + u.second[0] * k, y0 = Y0 + u.second[1] * k, x1 = x0 + u.second[2] * k, y1 = y0 + u.second[3] * k;
+		P::rect(x0, y0, x1, y1, u.first == hover ? TAB_ON : CARD);
+		P::frame(x0, y0, x1, y1, k * 0.5, BUILDING);
+		P::text("label", (_tr ? _tr(u.first->getRules()->getType()) : u.first->getRules()->getType()) + "*", x0 + k, y0, x1 - k, y1, 3.2 * k, 1, 1, LINE);
+	}
+	// the ghost
+	if (!_ghost.empty())
+	{
+		int gx, gy;
+		if (tileUnderMouse(gx, gy))
+		{
+			int w, h;
+			PitPlace::footprint(_mod, _ghost, _turned, w, h);
+			const bool ok = PitPlace::fits(_mod, _base, _ghost, gx, gy, _turned).empty();
+			const double x0 = sx + gx * s, y0 = sy + gy * s, x1 = x0 + w * s, y1 = y0 + h * s;
+			P::rect(x0, y0, x1, y1, ok ? GOOD : BAD, 120);
+			P::frame(x0, y0, x1, y1, k * 0.7, ok ? GOOD : BAD);
+			P::text("label", _tr ? _tr(_ghost) : _ghost, x0 + k, y0 + k, x1 - k, y1 - k, std::min(4.0 * k, (y1 - y0) / 3), 1, 1, LINE);
+		}
+	}
+}
+
+}
diff --git a/src/Basescape/PitBlueprintView.h b/src/Basescape/PitBlueprintView.h
new file mode 100644
index 0000000..c359c0a
--- /dev/null
+++ b/src/Basescape/PitBlueprintView.h
@@ -0,0 +1,71 @@
+#pragma once
+/*
+ * G.I. Joe: the Pit's base screen as blueprints (PIT_FLOORS_v1 s.1 v2; John's look: Reference\basebuild\).
+ * One sheet per floor: the battle map's tiles, permanent things drawn in white on blueprint blue, rooms as cards
+ * laid on top. Floor tabs along the top. While placing, a ghost of the module follows the mouse, green where it
+ * fits and red where it doesn't. Painted at display resolution (HiUI::nativePanel); the 8-bit fallback is plain.
+ */
+#include <array>
+#include <functional>
+#include <vector>
+#include <string>
+#include "../Engine/InteractiveSurface.h"
+
+namespace OpenXcom
+{
+
+class Mod;
+class Base;
+class BaseFacility;
+
+class PitBlueprintView : public InteractiveSurface
+{
+public:
+	using Namer = std::function<std::string(const std::string&)>;
+private:
+	const Mod *_mod = nullptr;
+	Base *_base = nullptr;
+	Namer _tr;
+	int _floor = 1;
+	bool _tabsLocked = false;
+	// placing
+	std::string _ghost;
+	bool _turned = false;
+	// mouse, in this surface's base pixels
+	double _mx = -1, _my = -1;
+	// geometry
+	static const int TAB_H = 12;
+	int _bx0 = 0, _by0 = 0, _bw = 1, _bh = 1;   // the part of the map any floor uses (the sheet shows only that)
+	double scale() const;
+	double sheetX() const;
+	double sheetY() const;
+	void paint(double X0, double Y0, double k);
+	/// rooms of this floor that fit nowhere on it (an old save): a row of cards under the sheet, base px
+	std::vector<std::pair<BaseFacility*, std::array<double, 4> > > unplaced() const;
+	/// the Surface tab: hiding spot i's card, base px
+	std::array<double, 4> spotRect(int i) const;
+public:
+	PitBlueprintView(int width, int height, int x = 0, int y = 0);
+	~PitBlueprintView();
+	void setup(const Mod *mod, Base *base, Namer tr);
+	void setFloor(int floor) { _floor = floor; }
+	int getFloor() const { return _floor; }
+	void lockTabs(bool locked) { _tabsLocked = locked; }
+	/// show a module following the mouse (empty: stop)
+	void setGhost(const std::string &type, bool turned) { _ghost = type; _turned = turned; }
+	bool getTurned() const { return _turned; }
+	void setTurned(bool t) { _turned = t; }
+	/// the tile under the mouse (the ghost's north-west tile while placing); false off the sheet
+	bool tileUnderMouse(int &x, int &y) const;
+	/// the floor tab under the mouse, -1 if none
+	int tabUnderMouse() const;
+	/// the room under the mouse on this floor, if any (the Surface: its grid rooms)
+	BaseFacility *roomUnderMouse() const;
+	/// why the ghost can't go where the mouse is ("" = it fits)
+	std::string ghostWhy() const;
+	void mouseOver(Action *action, State *state) override;
+	void mousePress(Action *action, State *state) override;
+	void draw() override;
+};
+
+}
diff --git a/src/Basescape/PitPlace.cpp b/src/Basescape/PitPlace.cpp
new file mode 100644
index 0000000..3d364fe
--- /dev/null
+++ b/src/Basescape/PitPlace.cpp
@@ -0,0 +1,274 @@
+#include "PitPlace.h"
+#include <algorithm>
+#include <functional>
+#include "../Mod/Mod.h"
+#include "../Mod/RuleBaseFacility.h"
+#include "../Savegame/Base.h"
+#include "../Savegame/BaseFacility.h"
+#include "../Geoscape/Outposts.h"
+#include "../Engine/Logger.h"
+
+namespace OpenXcom
+{
+namespace PitPlace
+{
+
+bool on(const Mod *mod, const Base *base)
+{
+	if (!mod || !base || !mod->getPitPlaceRules().on || !mod->getPitFloorRules().on) return false;
+	const auto *k = Outposts::kindOf(mod, base);
+	return !k || k->pit;
+}
+
+int floorOf(const Mod *mod, const std::string &type)
+{
+	const auto &F = mod->getPitFloorRules().floors;
+	auto i = F.find(type);
+	return i == F.end() ? -1 : i->second;
+}
+
+bool placed(const Mod *mod, const std::string &type)
+{
+	const int f = floorOf(mod, type);
+	return f >= 1 && mod->getPitPlaceRules().floors.count(f);
+}
+
+void footprint(const Mod *mod, const std::string &type, bool turned, int &w, int &h)
+{
+	const auto *m = mod->getPitPlaceRules().module(type);
+	w = m ? m->w : 4;
+	h = m ? m->h : 4;
+	if (turned) std::swap(w, h);
+}
+
+bool canTurn(const Mod *mod, const std::string &type)
+{
+	const auto *m = mod->getPitPlaceRules().module(type);
+	if (!m) return true;                  // an empty room turns freely
+	if (!m->spots.empty()) return false;  // a vehicle bay is where it is
+	if (m->w == m->h && m->lx < 0) return false;
+	return m->lx < 0 || m->tx >= 0;
+}
+
+int maskAt(const Mod *mod, int floor, int x, int y)
+{
+	const auto &R = mod->getPitPlaceRules();
+	auto f = R.floors.find(floor);
+	if (f == R.floors.end() || x < 0 || y < 0 || x >= R.w || y >= R.h) return 0;
+	const size_t i = (size_t)y * R.w + x;
+	if (i >= f->second.mask.size()) return 0;
+	const char c = f->second.mask[i];
+	return (c >= '0' && c <= '9') ? c - '0' : (c >= 'a' && c <= 'f') ? c - 'a' + 10 : (c >= 'A' && c <= 'F') ? c - 'A' + 10 : 0;
+}
+
+namespace
+{
+struct Rect { int x, y, w, h; };
+
+Rect rectOf(const Mod *mod, const BaseFacility *f)
+{
+	int w, h;
+	footprint(mod, f->getRules()->getType(), f->getPitTurned(), w, h);
+	return Rect{ f->getPitX(), f->getPitY(), w, h };
+}
+
+bool overlap(const Rect &a, const Rect &b)
+{
+	return a.x < b.x + b.w && b.x < a.x + a.w && a.y < b.y + b.h && b.y < a.y + a.h;
+}
+
+/// the rooms placed on a floor
+std::vector<Rect> roomsOn(const Mod *mod, const Base *base, int floor, const BaseFacility *ignore)
+{
+	std::vector<Rect> out;
+	for (const auto *f : *const_cast<Base*>(base)->getFacilities())
+		if (f != ignore && f->isPitPlaced() && floorOf(mod, f->getRules()->getType()) == floor)
+			out.push_back(rectOf(mod, f));
+	return out;
+}
+
+/// open-floor regions of eight tiles or more: rooms are walls to walk round
+int regions(const Mod *mod, int floor, const std::vector<Rect> &rooms)
+{
+	const auto &R = mod->getPitPlaceRules();
+	std::vector<char> walk((size_t)R.w * R.h, 0), seen((size_t)R.w * R.h, 0);
+	for (int y = 0; y < R.h; ++y)
+		for (int x = 0; x < R.w; ++x)
+		{
+			const int m = maskAt(mod, floor, x, y);
+			if (!(m & 1) || (m & 8)) continue;
+			bool in = false;
+			for (const auto &r : rooms) if (x >= r.x && x < r.x + r.w && y >= r.y && y < r.y + r.h) { in = true; break; }
+			walk[(size_t)y * R.w + x] = !in;
+		}
+	int count = 0;
+	std::vector<int> stack;
+	for (int s = 0; s < R.w * R.h; ++s)
+	{
+		if (!walk[s] || seen[s]) continue;
+		int size = 0;
+		stack.assign(1, s); seen[s] = 1;
+		while (!stack.empty())
+		{
+			const int c = stack.back(); stack.pop_back(); ++size;
+			const int x = c % R.w, y = c / R.w;
+			auto go = [&](int nx, int ny, bool blocked) {
+				if (nx < 0 || ny < 0 || nx >= R.w || ny >= R.h || blocked) return;
+				const int n = ny * R.w + nx;
+				if (walk[n] && !seen[n]) { seen[n] = 1; stack.push_back(n); }
+			};
+			go(x + 1, y, x + 1 < R.w && (maskAt(mod, floor, x + 1, y) & 2));
+			go(x - 1, y, (maskAt(mod, floor, x, y) & 2));
+			go(x, y + 1, y + 1 < R.h && (maskAt(mod, floor, x, y + 1) & 4));
+			go(x, y - 1, (maskAt(mod, floor, x, y) & 4));
+		}
+		if (size >= 8) ++count;   // a strip left between a module and its room wall is not a sealed-off part
+	}
+	return count;
+}
+}
+
+std::string fits(const Mod *mod, const Base *base, const std::string &type, int x, int y, bool turned, const BaseFacility *ignore)
+{
+	const auto &R = mod->getPitPlaceRules();
+	const int floor = floorOf(mod, type);
+	if (!placed(mod, type)) return "STR_OUTPOST_NOT_HERE";
+	if (turned && !canTurn(mod, type)) turned = false;
+	int w, h;
+	footprint(mod, type, turned, w, h);
+	const Rect me{ x, y, w, h };
+	if (x < 0 || y < 0 || x + w > R.w || y + h > R.h) return "STR_PIT_DOES_NOT_FIT";
+	const auto *m = R.module(type);
+	const bool spotted = m && !m->spots.empty();
+	if (spotted)
+	{
+		bool ok = false;
+		for (const auto &s : m->spots) if (s.size() >= 2 && s[0] == x && s[1] == y) ok = true;
+		if (!ok) return "STR_PIT_BAY_ONLY";
+	}
+	else
+	{
+		for (int dy = 0; dy < h; ++dy)
+			for (int dx = 0; dx < w; ++dx)
+			{
+				const int k = maskAt(mod, floor, x + dx, y + dy);
+				if (!(k & 1) || (k & 8)) return "STR_PIT_DOES_NOT_FIT";
+				if ((k & 2) && dx > 0) return "STR_PIT_DOES_NOT_FIT";   // a wall would run through the room
+				if ((k & 4) && dy > 0) return "STR_PIT_DOES_NOT_FIT";
+			}
+	}
+	auto rooms = roomsOn(mod, base, floor, ignore);
+	for (const auto &r : rooms) if (overlap(r, me)) return "STR_PIT_DOES_NOT_FIT";
+	// it may not seal off part of the floor (John 00:07: restrictions acceptable)
+	if (!spotted)
+	{
+		const int before = regions(mod, floor, rooms);
+		rooms.push_back(me);
+		if (regions(mod, floor, rooms) > before) return "STR_PIT_SEALS_OFF";
+	}
+	return "";
+}
+
+bool findSpot(const Mod *mod, const Base *base, const std::string &type, int &x, int &y, bool &turned)
+{
+	const auto &R = mod->getPitPlaceRules();
+	const auto *m = R.module(type);
+	if (m && !m->spots.empty())
+	{
+		for (const auto &s : m->spots)
+			if (s.size() >= 2 && fits(mod, base, type, s[0], s[1], false).empty()) { x = s[0]; y = s[1]; turned = false; return true; }
+		return false;
+	}
+	if (m)
+		for (const auto &p : m->prefer)
+			if (p.size() >= 3 && fits(mod, base, type, p[0], p[1], p[2] != 0).empty()) { x = p[0]; y = p[1]; turned = p[2] != 0; return true; }
+	for (int t = 0; t < (canTurn(mod, type) ? 2 : 1); ++t)
+		for (int yy = 0; yy < R.h; ++yy)
+			for (int xx = 0; xx < R.w; ++xx)
+				if (fits(mod, base, type, xx, yy, t == 1).empty()) { x = xx; y = yy; turned = t == 1; return true; }
+	return false;
+}
+
+void migrate(const Mod *mod, Base *base)
+{
+	if (!on(mod, base)) return;
+	const auto &R = mod->getPitPlaceRules();
+	if (!mod->getPitSurfaceRules().spots.empty())
+		for (auto *f : *base->getFacilities())
+		{
+			if (f->isPitPlaced() || floorOf(mod, f->getRules()->getType()) != 0) continue;
+			std::string why;
+			const int s = surfaceSpotFor(mod, base, f->getRules()->getType(), why);
+			if (s >= 0) { f->setPitPlace(SURFACE_BASE + s, 0, false); Log(LOG_INFO) << "[pitplace] " << f->getRules()->getType() << " installed in surface spot " << s; }
+			else Log(LOG_WARNING) << "[pitplace] no surface spot for " << f->getRules()->getType() << ": it stays on the grid";
+		}
+	for (auto *f : *base->getFacilities())
+	{
+		const std::string &type = f->getRules()->getType();
+		if (f->isPitPlaced() || !placed(mod, type)) continue;
+		int x = -1, y = -1; bool turned = false;
+		auto d = R.day1.find(type);
+		bool used = false;   // Broca's spot, once per type
+		for (const auto *g : *base->getFacilities())
+			if (g != f && g->isPitPlaced() && g->getRules()->getType() == type && d != R.day1.end() && d->second.size() >= 2 && g->getPitX() == d->second[0] && g->getPitY() == d->second[1]) used = true;
+		if (d != R.day1.end() && d->second.size() >= 2 && !used
+			&& fits(mod, base, type, d->second[0], d->second[1], d->second.size() > 2 && d->second[2]).empty())
+		{
+			x = d->second[0]; y = d->second[1]; turned = d->second.size() > 2 && d->second[2];
+		}
+		else if (!findSpot(mod, base, type, x, y, turned))
+		{
+			Log(LOG_WARNING) << "[pitplace] no room on its floor for " << type << ": it stays on the grid";
+			continue;
+		}
+		f->setPitPlace(x, y, turned);
+		Log(LOG_INFO) << "[pitplace] " << type << " placed at " << x << "," << y << (turned ? " turned" : "");
+	}
+}
+
+bool isSurface(const BaseFacility *f)
+{
+	return f && f->getPitX() >= SURFACE_BASE;
+}
+
+int surfaceSpotFor(const Mod *mod, const Base *base, const std::string &type, std::string &why)
+{
+	const auto &S = mod->getPitSurfaceRules().spots;
+	why = "";
+	auto taken = [&](int i) {
+		for (const auto *f : *const_cast<Base*>(base)->getFacilities()) if (f->getPitX() == SURFACE_BASE + i) return true;
+		return false;
+	};
+	bool any = false;
+	for (size_t i = 0; i < S.size(); ++i)
+		if (!S[i].flexible && std::find(S[i].facilities.begin(), S[i].facilities.end(), type) != S[i].facilities.end())
+		{
+			any = true;
+			if (!taken((int)i)) return (int)i;
+		}
+	if (!any) { why = "STR_OUTPOST_NOT_HERE"; return -1; }
+	for (size_t i = 0; i < S.size(); ++i)
+		if (S[i].flexible && !taken((int)i)) return (int)i;
+	why = "STR_PIT_SPOT_TAKEN";
+	return -1;
+}
+
+BaseFacility *surfaceAt(const Mod *mod, Base *base, int spot)
+{
+	for (auto *f : *base->getFacilities()) if (f->getPitX() == SURFACE_BASE + spot) return f;
+	return nullptr;
+}
+
+BaseFacility *roomAt(const Mod *mod, Base *base, int floor, int x, int y)
+{
+	for (auto *f : *base->getFacilities())
+	{
+		if (!f->isPitPlaced() || floorOf(mod, f->getRules()->getType()) != floor) continue;
+		const Rect r = rectOf(mod, f);
+		if (x >= r.x && x < r.x + r.w && y >= r.y && y < r.y + r.h) return f;
+	}
+	return nullptr;
+}
+
+}
+}
diff --git a/src/Basescape/PitPlace.h b/src/Basescape/PitPlace.h
new file mode 100644
index 0000000..cf8773e
--- /dev/null
+++ b/src/Basescape/PitPlace.h
@@ -0,0 +1,55 @@
+#pragma once
+/*
+ * G.I. Joe: FREE PLACEMENT on the Pit's floors (PIT_FLOORS_v1 s.1 v2; BRIEF_FOR_BUILD_PitFreePlacement; John 16 Nov
+ * 00:01-00:41, "build it now" 08:03). Each floor below the Surface is a blueprint of the battle map's tiles. A room is
+ * a module with a footprint: bought, then dropped anywhere on its own floor where it fits on open floor, turned 90
+ * degrees if it has a turned fit-out. Module size is what limits how many fit. The battle stamps each module's
+ * fit-out on the tiles it was dropped on (BattlescapeGenerator::applyPitModules).
+ *
+ * A placed room has NO grid square (BaseFacility::isPitPlaced): every grid routine skips it. The Surface and every
+ * outpost keep the grid.
+ */
+#include <string>
+#include <vector>
+
+namespace OpenXcom
+{
+
+class Mod;
+class Base;
+class BaseFacility;
+class RuleBaseFacility;
+
+namespace PitPlace
+{
+	/// is this base laid out on blueprints? (the Pit, with the rules loaded)
+	bool on(const Mod *mod, const Base *base);
+	/// the floor a room type belongs on (1..5), 0 for the Surface, -1 if it can't go in a Pit
+	int floorOf(const Mod *mod, const std::string &type);
+	/// does this room type go on a blueprint (a floor 1..5 with a sheet)?
+	bool placed(const Mod *mod, const std::string &type);
+	/// footprint in tiles (turned swaps it)
+	void footprint(const Mod *mod, const std::string &type, bool turned, int &w, int &h);
+	/// can it be turned?
+	bool canTurn(const Mod *mod, const std::string &type);
+	/// mask bits of a tile on a floor (0 outside the sheet)
+	int maskAt(const Mod *mod, int floor, int x, int y);
+	/// why it can't go there ("" = it fits). ignore: a room to leave out (the one being moved).
+	std::string fits(const Mod *mod, const Base *base, const std::string &type, int x, int y, bool turned, const BaseFacility *ignore = nullptr);
+	/// the first place it fits (scanning rows), false if none
+	bool findSpot(const Mod *mod, const Base *base, const std::string &type, int &x, int &y, bool &turned);
+	/// put every room that should be on a blueprint and isn't there yet (Day 1, an old save): where Broca has it,
+	/// else the first place it fits. Rooms that fit nowhere stay on the grid (logged).
+	void migrate(const Mod *mod, Base *base);
+	/// SURFACE: a defence installed in spot i has pitX SURFACE_BASE + i
+	const int SURFACE_BASE = 1000;
+	bool isSurface(const BaseFacility *f);
+	/// the spot this defence would go into ("" why = ok); -1 if none
+	int surfaceSpotFor(const Mod *mod, const Base *base, const std::string &type, std::string &why);
+	/// what is installed in spot i, if anything
+	BaseFacility *surfaceAt(const Mod *mod, Base *base, int spot);
+	/// the room placed over this tile of a floor, if any
+	BaseFacility *roomAt(const Mod *mod, Base *base, int floor, int x, int y);
+}
+
+}
