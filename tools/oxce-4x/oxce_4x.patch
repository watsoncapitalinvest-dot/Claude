+IntelBoardState::IntelBoardState()
+{
+	_screen = false;
+
+	_window = new Window(this, 320, 200, 0, 0, POPUP_BOTH);
+	_btnOk = new TextButton(70, 12, 16, 180);
+	_btnGraphs = new TextButton(70, 12, 125, 180);
+	_btnCobra = new TextButton(84, 12, 220, 180);
+	_txtTitle = new Text(320, 17, 0, 8);
+	_txtNews = new Text(288, 26, 16, 27);
+	_lstBoard = new TextList(288, 120, 16, 56);
+
+	setInterface("fundingWindow");
+	add(_window, "window", "fundingWindow");
+	add(_btnOk, "button", "fundingWindow");
+	add(_btnGraphs, "button", "fundingWindow");
+	add(_btnCobra, "button", "fundingWindow");
+	add(_txtTitle, "text1", "fundingWindow");
+	add(_txtNews, "text1", "fundingWindow");
+	add(_lstBoard, "list", "fundingWindow");
+	centerAllSurfaces();
+	setWindowBackground(_window, "fundingWindow");
+
+	_btnOk->setText(tr("STR_OK"));
+	_btnOk->onMouseClick((ActionHandler)&IntelBoardState::btnOkClick);
+	_btnOk->onKeyboardPress((ActionHandler)&IntelBoardState::btnOkClick, Options::keyOk);
+	_btnOk->onKeyboardPress((ActionHandler)&IntelBoardState::btnOkClick, Options::keyCancel);
+	_btnGraphs->setText(tr("STR_INTEL_GRAPHS"));
+	_btnGraphs->onMouseClick((ActionHandler)&IntelBoardState::btnGraphsClick);
+	_btnCobra->setText(tr("STR_COBRA_INTEL"));
+	_btnCobra->onMouseClick((ActionHandler)&IntelBoardState::btnCobraClick);
+
+	_txtTitle->setBig();
+	_txtTitle->setAlign(ALIGN_CENTER);
+	_txtTitle->setText(tr("STR_INTEL_BOARD"));
+
+	SavedGame *save = _game->getSavedGame();
+	const Mod *mod = _game->getMod();
+
+	// what just happened, newest last, taken once
+	std::ostringstream news;
+	int shown = 0;
+	for (const auto &n : save->takeLeadNews())
+	{
+		bool big = !n.empty() && n[0] == '!';
+		std::string id = big ? n.substr(1) : n;
+		std::string line;
+		if (mod->getLead(id))
+		{
+			line = big ? tr("STR_LEAD_SOLVED").arg(tr(id)) : tr("STR_LEAD_PROGRESS").arg(tr(id));
+		}
+		else
+		{
+			line = tr(id);
+		}
+		if (shown++ < 3)
+		{
+			news << (shown > 1 ? "\n" : "") << line;
+		}
+	}
+	_txtNews->setWordWrap(true);
+	_txtNews->setText(shown ? news.str() : std::string(tr("STR_INTEL_NOTHING_NEW")));
+
+	_lstBoard->setColumns(3, 150, 88, 50);
+	_lstBoard->setDot(false);
+	_lstBoard->setSelectable(true);
+	_lstBoard->setBackground(_window);
+	_lstBoard->onMouseClick((ActionHandler)&IntelBoardState::lstBoardClick);
+}
