new file mode 100644
index 0000000..f454a96
--- /dev/null
+++ b/src/Geoscape/PlayStyle.cpp
@@ -0,0 +1,102 @@
+#include "PlayStyle.h"
+#include <fstream>
+#include <cstdlib>
+#include <map>
+#include <set>
+#include <string>
+#include "../Engine/Game.h"
+#include "../Engine/Options.h"
+#include "../Battlescape/BattleSim.h"
+#include "../Mod/Mod.h"
+#include "../Mod/RuleResearch.h"
+#include "../Mod/RuleCraft.h"
+#include "../Mod/AlienDeployment.h"
+#include "../Savegame/SavedGame.h"
+#include "../Savegame/GameTime.h"
+#include "../Savegame/Base.h"
+#include "../Savegame/Craft.h"
+#include "../Savegame/ResearchProject.h"
+#include "../Savegame/MissionSite.h"
+#include "../Savegame/AlienBase.h"
+
+namespace OpenXcom
+{
+namespace PlayStyle
+{
+namespace
+{
+	SavedGame *lastSave = nullptr;
+	std::map<std::string, int> seenAt;          // "M<id>"/"B<id>" -> hour first seen
+	std::map<std::string, std::string> kindOf;  // the same key -> deployment type
+	std::set<std::string> answered, research;
+
+	int hours(SavedGame *s) { return s->getDaysPassed() * 24 + s->getTime()->getHour(); }
+
+	void out(SavedGame *s, const std::string &line)
+	{
+		std::ofstream f(Options::getUserFolder() + "playstyle.txt", std::ios::app);
+		f << "day " << s->getDaysPassed() << " " << line << "\n";
+	}
+
+	std::string kindOfTarget(Target *t, std::string &key)
+	{
+		if (auto *ms = dynamic_cast<MissionSite*>(t)) { key = "M" + std::to_string(ms->getId()); return ms->getDeployment() ? ms->getDeployment()->getType() : "mission"; }
+		if (auto *ab = dynamic_cast<AlienBase*>(t)) { key = "B" + std::to_string(ab->getId()) + ab->getType(); return ab->getDeployment() ? ab->getDeployment()->getType() : "site"; }
+		return "";
+	}
+}
+
+void tick(Game *game)
+{
+	SavedGame *s = game->getSavedGame();
+	if (!s || (BattleSim::on() && !getenv("OXCE_PLAYSTYLE_TEST"))) return;   // RIG: OXCE_PLAYSTYLE_TEST records a simulated campaign
+	if (s != lastSave)
+	{
+		// a new campaign or a loaded save: start fresh, and treat what is already under research as known
+		lastSave = s; seenAt.clear(); kindOf.clear(); answered.clear(); research.clear();
+		// a loaded save's research is already under way; a new campaign's first picks are the player's, so they count
+		if (s->getDaysPassed() > 0)
+			for (auto *b : *s->getBases()) for (auto *p : b->getResearch()) research.insert(p->getRules()->getName());
+		out(s, "SESSION difficulty " + std::to_string((int)s->getDifficulty()));
+	}
+	const int now = hours(s);
+	// research the player started
+	for (auto *b : *s->getBases())
+		for (auto *p : b->getResearch())
+		{
+			const std::string &n = p->getRules()->getName();
+			if (research.insert(n).second)
+				out(s, "RESEARCH " + n + " cost " + std::to_string(p->getRules()->getCost()) + (p->getRules()->needItem() ? " clue" : ""));
+		}
+	// what is on the map
+	std::set<std::string> present;
+	auto see = [&](Target *t) {
+		std::string key; const std::string k = kindOfTarget(t, key);
+		if (k.empty()) return;
+		present.insert(key);
+		if (!seenAt.count(key)) { seenAt[key] = now; kindOf[key] = k; out(s, "SEEN " + k); }
+	};
+	for (auto *ms : *s->getMissionSites()) if (ms->getDetected()) see(ms);
+	for (auto *ab : *s->getAlienBases()) if (ab->isDiscovered()) see(ab);
+	// answered: a craft with men aboard heading for it
+	for (auto *b : *s->getBases())
+		for (auto *c : *b->getCrafts())
+		{
+			if (!c->getDestination() || c->getNumTotalSoldiers() + c->getNumTotalVehicles() <= 0) continue;
+			std::string key; const std::string k = kindOfTarget(c->getDestination(), key);
+			if (k.empty() || !seenAt.count(key) || !answered.insert(key).second) continue;
+			out(s, "ANSWER " + k + " after " + std::to_string(now - seenAt[key]) + "h squad " + std::to_string(c->getNumTotalSoldiers())
+				+ " vehicles " + std::to_string(c->getNumTotalVehicles()) + " craft " + c->getRules()->getType());
+		}
+	// gone without an answer
+	for (auto it = seenAt.begin(); it != seenAt.end(); )
+	{
+		if (present.count(it->first)) { ++it; continue; }
+		if (!answered.count(it->first)) out(s, "IGNORED " + kindOf[it->first] + " after " + std::to_string(now - it->second) + "h");
+		kindOf.erase(it->first); answered.erase(it->first);
+		it = seenAt.erase(it);
+	}
+}
+
+}
+}
