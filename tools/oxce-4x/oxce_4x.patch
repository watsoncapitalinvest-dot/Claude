+					if (cov > 0) o[X] = mix(o[X], col, std::min(255, cov));
+				}
+			}
+		}
+		return drawn;
+	}
+
+	bool shown(const Surface *s) { return s->getVisible() && !s->isHidden(); }
+	R rectOf(const Surface *s) { return R{ s->getX(), s->getY(), s->getX() + s->getWidth(), s->getY() + s->getHeight() }; }
+}
