+/**
+ * How much of a shot survives passing through one piece of terrain.
+ *
+ * Each material absorbs a flat amount and then passes a fraction of what is left, rather than
+ * weapons being sorted into classes. The flat part is what makes a pistol stop at a wall that a
+ * rifle goes through, with no class table to keep in step with the weapon list; the fraction is
+ * what stops a heavy weapon turning every building into open ground.
+ *
+ * Energy weapons pay less of the flat cost against mineral materials - burning through masonry
+ * is what they are for - and no less against metal, which is what they are worst at.
+ *
+ * EVERY NUMBER HERE IS A PLACEHOLDER AND JOHN'S TO TUNE. They belong in the tuning file the
+ * design asks for, which does not exist yet.
+ */
+int TileEngine::penetrate(int power, int material, const RuleDamageType *type) const
+{
+	// Absorbed, then the share of the remainder that carries on. Both come off the Mod, so
+	// every number here is a ruleset line rather than a rebuild.
+	if (material < 0 || material >= MAT_COUNT)
+	{
+		material = MAT_UNKNOWN;
+	}
+	bool energy = type && (type->ResistType == DT_LASER || type->ResistType == DT_PLASMA);
+	int cost = energy ? _penEnergyCost[material] : _penCost[material];
+	int left = power - cost;
+	if (_penLog)
+	{
+		Log(LOG_INFO) << "[pen] PEN mat=" << material << " power=" << power
+			<< " cost=" << cost << " -> "
+			<< (left <= 0 ? 0 : (int)(left * _penPass[material]));
+	}
+	if (left <= 0)
+	{
+		return 0;
+	}
+	return (int)(left * _penPass[material]);
+}
+
+/**
+ * Carries a shot on past terrain that failed to stop it.
+ *
+ * The shot is traced again from just beyond the obstruction, along the line it was already
+ * travelling, and whatever it meets next is hit at the reduced power. This runs in the shared
+ * firing path, so Cobra's shots come through cover exactly as the player's do from the day it
+ * ships. What no AI does yet is *choose* to shoot through a wall, which is a question of intent
+ * and not of physics.
+ */
+void TileEngine::penetrateOnward(BattleActionAttack attack, Position center, int power, const RuleDamageType *type)
+{
+	// Four walls is already further than any honest shot goes, and the limit is what stops a
+	// shot that somehow re-hits its own tile from recursing until the stack runs out. Tunable,
+	// but it is a safety rail before it is a game number, so nothing should set it high.
+	if (!attack.attacker || power <= 0 || _penetrationDepth >= _penMaxWalls)
+	{
+		return;
+	}
+
+	Position from = attack.attacker->getPosition().toVoxel() + Position(8, 8, 12);
+	Position delta = center - from;
+	if (delta.x == 0 && delta.y == 0 && delta.z == 0)
+	{
+		return;
+	}
+
+	// Carry on along the same line, far enough to leave the obstruction and reach whatever is
+	// behind it. Stepping off by a whole tile first is what keeps the trace from finding the
+	// very wall it has just come through.
+	int span = std::max(std::max(std::abs(delta.x), std::abs(delta.y)), std::abs(delta.z));
+	if (span <= 0)
+	{
+		return;
+	}
+	Position step(delta.x * 16 / span, delta.y * 16 / span, delta.z * 16 / span);
+	Position start = center + step;
+	Position far = center + Position(delta.x * 8 / span, delta.y * 8 / span, delta.z * 8 / span) * 16;
+
+	std::vector<Position> trajectory;
+	++_penetrationDepth;
+	VoxelType next = calculateLineVoxel(start, far, false, &trajectory, attack.attacker);
+	if (_penLog)
+	{
+		Log(LOG_INFO) << "[pen] ONWARD depth=" << _penetrationDepth << " power=" << power
+			<< " found=" << (int)next << " traj=" << trajectory.size();
+	}
