+	/// the hang watchdog: a frame that never comes back (an endless loop, a deadlock) is a HANG
+	void watchdog()
+	{
+		const Uint32 limit = 180000;
+		for (;;)
+		{
+			std::this_thread::sleep_for(std::chrono::seconds(5));
+			const Uint32 b = beat.load();
+			if (b && SDL_GetTicks() - b > limit)
+			{
+				result(std::string(campaign() > 0 ? "CAMPAIGN " : "") + "HANG " + mission() + " turn " + std::to_string(turnSeen) + ": the game stopped answering for 3 minutes");
+				GJ_EXIT(4);
+			}
+		}
+	}
+	void press(Uint32 sym)
+	{
+		SDL_Event e = {};
+		e.type = SDL_KEYDOWN; e.key.state = SDL_PRESSED; e.key.keysym.sym = (SDLKey)sym;
+		SDL_PushEvent(&e);
+		e.type = SDL_KEYUP; e.key.state = SDL_RELEASED;
+		SDL_PushEvent(&e);
+	}
+	std::string name(const State *s)
+	{
+		std::string n = typeid(*s).name();
+		const size_t p = n.find("OpenXcom");
+		if (p != std::string::npos) n = n.substr(p + 8);
+		while (!n.empty() && (isdigit((unsigned char)n[0]) || n[0] == ':' || n[0] == ' ')) n.erase(0, 1);
+		if (n.size() > 1 && n.back() == 'E') n.pop_back();
+		return n;
+	}
+}
