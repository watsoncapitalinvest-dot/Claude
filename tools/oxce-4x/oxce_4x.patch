+/**
+ * Is a screen point on the globe's disc?
+ *
+ * cartToPolar answers for any point, including the black sky outside the disc,
+ * where it returns a lon/lat on the limb. So anything that turns a click into a
+ * place has to ask this first or a right-click on empty space pins a point in
+ * the ocean.
+ */
+bool Globe::isOnGlobe(int x, int y) const
+{
+	const double dx = x - _cenX, dy = y - _cenY;
+	return dx * dx + dy * dy <= _radius * _radius;
