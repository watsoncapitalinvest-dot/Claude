+#pragma once
+#include <string>
+#include <vector>
+namespace OpenXcom
+{
+class Game; class SavedGame; class SavedBattleGame;
+/**
+ * ONE-TIME TIPS (BRIEF_FOR_BUILD_Tutorial item 4, TUTORIAL_v1): each STR_TIP_<NAME> shows the first time its thing appears,
+ * once per campaign (remembered in the save). Options > "G.I. Joe tips" turns them all off. Battle tips ride on the next
+ * turn screen; world-map tips are a popup.
+ */
+namespace Tips
+{
+	/// in battle: queued for the next turn screen
+	void battle(SavedBattleGame *save, const std::string &name);
+	/// the queued battle tips (as string ids), emptied
+	std::vector<std::string> takeBattle();
+	/// on the world map or in the base: a popup now
+	void geo(Game *game, const std::string &name);
+}
+}
