+#include "../Savegame/AlienBase.h"
+#include "../Savegame/Region.h"
+
+namespace OpenXcom
+{
+
+CobraIntelState::CobraIntelState()
+{
+	_screen = false;
+
+	_window = new Window(this, 320, 200, 0, 0, POPUP_BOTH);
+	_btnOk = new TextButton(50, 12, 135, 180);
+	_txtTitle = new Text(320, 17, 0, 8);
+	_txtRegion = new Text(110, 9, 16, 30);
+	_txtSites = new Text(40, 9, 128, 30);
+	_txtFunds = new Text(60, 9, 174, 30);
+	_txtMateriel = new Text(60, 9, 240, 30);
+	_lstRegions = new TextList(290, 120, 16, 40);
+	_txtNote = new Text(290, 17, 16, 162);
+
+	// Reuses the funding screen's interface rather than declaring one of its own, so it is
+	// already themed by whatever the mod does to that screen and needs no interfaces: entry.
+	setInterface("fundingWindow");
+
+	add(_window, "window", "fundingWindow");
+	add(_btnOk, "button", "fundingWindow");
+	add(_txtTitle, "text1", "fundingWindow");
+	add(_txtRegion, "text2", "fundingWindow");
+	add(_txtSites, "text2", "fundingWindow");
+	add(_txtFunds, "text2", "fundingWindow");
+	add(_txtMateriel, "text2", "fundingWindow");
+	add(_lstRegions, "list", "fundingWindow");
+	add(_txtNote, "text2", "fundingWindow");
+
+	centerAllSurfaces();
+
+	_btnOk->setText(tr("STR_OK"));
+	_btnOk->onMouseClick((ActionHandler)&CobraIntelState::btnOkClick);
+	_btnOk->onKeyboardPress((ActionHandler)&CobraIntelState::btnOkClick, Options::keyCancel);
+
+	_txtTitle->setBig();
+	_txtTitle->setAlign(ALIGN_CENTER);
+	_txtTitle->setText(tr("STR_COBRA_INTELLIGENCE"));
+
+	_txtRegion->setText(tr("STR_REGION"));
+	_txtSites->setText(tr("STR_COBRA_SITES_FOUND"));
+	_txtFunds->setText(tr("STR_COBRA_FUNDS"));
+	_txtMateriel->setText(tr("STR_COBRA_MATERIEL"));
+
+	_lstRegions->setColumns(4, 112, 46, 66, 60);
+	_lstRegions->setDot(true);
+
+	// Only discovered sites count, and the figures are what those known sites earn per month -
+	// not what the region holds, which the player has no way of knowing.
+	static const std::vector<AlienBase*> _noBases;
+	std::map<std::string, int> found, funds, materiel;
+	SavedGame *save = _game->getSavedGame();
+	const Mod *mod = _game->getMod();
+	// Reachable only from the funding screen, so there is always a game in practice - but the
+	// cost of being wrong is a segfault rather than a blank table. getAlienBases() on a null
+	// SavedGame hands back the offset of the member, 0x1e0, which then dereferences.
+	for (const auto *base : save ? *save->getAlienBases() : _noBases)
+	{
+		if (base->getSiteType().empty() || !base->isDiscovered())
+		{
+			continue;
+		}
+		RuleCobraSite *rule = mod->getCobraSite(base->getSiteType());
+		Region *region = save->locateRegion(*base);
+		if (rule == 0 || region == 0)
+		{
+			continue;
+		}
+		const std::string &name = region->getRules()->getType();
+		found[name]++;
+		funds[name] += rule->getFundsPerMonth() - rule->getUpkeepFunds();
+		materiel[name] += rule->getMaterielPerMonth() - rule->getUpkeepMateriel();
+	}
+
+	int totalSites = 0;
+	for (const auto &pair : found)
+	{
+		std::ostringstream sites, f, m;
+		sites << pair.second;
+		f << funds[pair.first];
+		m << materiel[pair.first];
+		_lstRegions->addRow(4, tr(pair.first).c_str(), sites.str().c_str(),
+			f.str().c_str(), m.str().c_str());
+		totalSites += pair.second;
+	}
+
+	// An empty list and an undiscovered network look identical, so the screen says which.
+	_txtNote->setWordWrap(true);
+	_txtNote->setText(totalSites == 0 ? tr("STR_NO_COBRA_SITES_FOUND") : tr("STR_COBRA_INTEL_NOTE"));
+}
+
+void CobraIntelState::btnOkClick(Action *)
+{
+	_game->popState();
+}
+
+}
