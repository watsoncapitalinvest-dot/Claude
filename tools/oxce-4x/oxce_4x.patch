+	Window *_window;
+	Text *_txtTitle, *_txtWhere, *_txtLabel;
+	TextEdit *_edtLabel;
+	TextButton *_btnConfirmed, *_btnLikely, *_btnRumour, *_btnArea;
+	TextButton *_btnRoute, *_btnRemove, *_btnCancel;
+	/// Writes a mark of this kind and trust, then closes.
+	void place(int kind, int trust);
+public:
+	/// Creates the state for a point on the globe.
+	GlobeMarkState(Globe *globe, double lon, double lat);
+	/// Cleans up.
+	~GlobeMarkState();
+	void btnConfirmedClick(Action *action);
+	void btnLikelyClick(Action *action);
+	void btnRumourClick(Action *action);
+	void btnAreaClick(Action *action);
+	void btnRouteClick(Action *action);
+	void btnRemoveClick(Action *action);
+	void btnCancelClick(Action *action);
+};
+
+}
