new file mode 100644
index 0000000..d749080
--- /dev/null
+++ b/src/Engine/HiColor.cpp
@@ -0,0 +1,266 @@
+#include "HiColor.h"
+#include "Surface.h"
+#include "Screen.h"
+#include <unordered_map>
+#include <deque>
+#include <vector>
+#include <cstring>
+#include "SurfaceSet.h"
+#include "FileMap.h"
+#include "Logger.h"
+#include <SDL_image.h>
+#include <cstdlib>
+#include <algorithm>
+
+namespace OpenXcom
+{
+namespace HiColor
+{
+
+
+namespace
+{
+	std::unordered_map<const Uint8*, const Uint32*> sprites;
+	Uint8 *layerBase = nullptr;
+	int layerW = 0, layerH = 0, layerPitch = 0;
+	std::vector<Uint32> rgb;
+	std::vector<Uint8> tag;
+	// X-COM shades a ramp over 16 steps towards black; light level 0 is full brightness.
+	inline Uint32 shadeOf(Uint32 c, int shade)
+	{
+		if (shade <= 0) return c;
+		if (shade > 15) shade = 15;
+		const int f = 16 - shade; // 16 .. 1
+		const Uint32 r = (((c >> 16) & 0xFF) * f) >> 4;
+		const Uint32 g = (((c >> 8) & 0xFF) * f) >> 4;
+		const Uint32 b = ((c & 0xFF) * f) >> 4;
+		return (r << 16) | (g << 8) | b;
+	}
+}
+
+bool enabled()
+{
+	static int on = -1;
+	if (on < 0)
+	{
+		const char *e = getenv("OXCE_HICOLOR");
+		on = e ? (atoi(e) != 0) : (Screen::hiRes() > 1);
+	}
+	return on != 0;
+}
+
+void registerSprite(const Uint8 *pixels8, const Uint32 *argb)
+{
+	if (pixels8 && argb) sprites[pixels8] = argb;
+}
+
+void unregisterSprite(const Uint8 *pixels8)
+{
+	sprites.erase(pixels8);
+}
+
+static void resolveFrames();   // defined below, beside the registration it resolves
+
+void beginLayer(Uint8 *base, int w, int h, int pitch)
+{
+	if (!enabled()) { layerBase = nullptr; return; }
+	resolveFrames();
+	layerBase = base; layerW = w; layerH = h; layerPitch = pitch;
+	const size_t n = (size_t)w * h;
+	if (rgb.size() != n) { rgb.assign(n, 0); tag.assign(n, 0); }
+	else
+	{
+		std::fill(rgb.begin(), rgb.end(), 0);
+		std::fill(tag.begin(), tag.end(), 0);
+	}
+}
+
+void afterBlit(const SurfaceRaw<Uint8> &dst, const SurfaceRaw<const Uint8> &src, int x, int y, int shade, bool half, int newBaseColor,
+	int clipX0, int clipY0, int clipX1, int clipY1)
+{
+	if (!layerBase || dst.getBuffer() != layerBase || newBaseColor) return;
+	auto it = sprites.find(src.getBuffer());
+	if (it == sprites.end()) return;
+	const Uint32 *argb = it->second;
+	const int sw = src.getWidth(), sh = src.getHeight(), sp = src.getPitch();
+	const int x0 = half ? sw / 2 : 0;
+	for (int sy = 0; sy < sh; ++sy)
+	{
+		const int dy = y + sy;
+		if (dy < 0 || dy >= layerH || dy < clipY0 || dy >= clipY1) continue;
+		const Uint8 *srow = src.getBuffer() + sy * sp;
+		const Uint32 *crow = argb + sy * sw;
+		const Uint8 *drow = layerBase + dy * layerPitch;
+		Uint32 *rrow = rgb.data() + (size_t)dy * layerW;
+		Uint8 *trow = tag.data() + (size_t)dy * layerW;
+		for (int sx = x0; sx < sw; ++sx)
+		{
+			const int dx = x + sx;
+			if (dx < 0 || dx >= layerW || dx < clipX0 || dx >= clipX1) continue;
+			if (srow[sx])
+			{
+				trow[dx] = drow[dx];
+				rrow[dx] = shadeOf(crow[sx], shade);
+				continue;
+			}
+			// pixels the 8-bit sprite leaves empty may still carry a soft edge or a ground shadow:
+			// blend them over whatever full-colour pixel is underneath, if it is still showing
+			const Uint32 a = crow[sx] >> 24;
+			if (!a || trow[dx] != drow[dx] || !drow[dx]) continue;
+			const Uint32 c = shadeOf(crow[sx], shade), u = rrow[dx];
+			const Uint32 r = (((c >> 16) & 0xFF) * a + ((u >> 16) & 0xFF) * (255 - a)) / 255;
+			const Uint32 g = (((c >> 8) & 0xFF) * a + ((u >> 8) & 0xFF) * (255 - a)) / 255;
+			const Uint32 bl = ((c & 0xFF) * a + (u & 0xFF) * (255 - a)) / 255;
+			rrow[dx] = (r << 16) | (g << 8) | bl;
+		}
+	}
+}
+
+const Uint32 *keep(std::vector<Uint32> &&argb)
+{
+	static std::deque<std::vector<Uint32>> store;
+	store.push_back(std::move(argb));
+	return store.back().data();
+}
+
+namespace
+{
+	struct PendingFrame { SurfaceSet *set; int frame; std::string file; };
+	std::vector<PendingFrame> pendingFrames;
+}
+
+void registerSetFrame(SurfaceSet *set, int frame, const std::string &file)
+{
+	if (!enabled() || !set) return;
+	const auto dot = file.find_last_of('.');
+	if (dot == std::string::npos || !FileMap::fileExists(file.substr(0, dot) + "_rgb.png")) return;
+	pendingFrames.push_back({set, frame, file});
+}
+
+/// Resolve what registerSetFrame remembered. Deferred because a set's frames are replaced after
+/// the mod loads, so a Surface* captured then points at nothing by the time anything is drawn.
+static void resolveFrames()
+{
+	if (pendingFrames.empty()) return;
+	std::vector<PendingFrame> todo;
+	todo.swap(pendingFrames);
+	int done = 0;
+	for (const auto &p : todo)
+	{
+		Surface *f = p.set->getFrame(p.frame);
+		if (!f || !f->getBuffer()) continue;
+		const auto dot = p.file.find_last_of('.');
+		const std::string twin = p.file.substr(0, dot) + "_rgb.png";
+		SDL_Surface *img = IMG_Load_RW(FileMap::getRWops(twin), SDL_TRUE);
+		if (!img) { Log(LOG_WARNING) << "Full-colour sprite unreadable: " << twin; continue; }
+		SDL_PixelFormat fmt = {};
+		fmt.BitsPerPixel = 32; fmt.BytesPerPixel = 4;
+		fmt.Rmask = 0x00FF0000; fmt.Gmask = 0x0000FF00; fmt.Bmask = 0x000000FF; fmt.Amask = 0xFF000000;
+		fmt.Rshift = 16; fmt.Gshift = 8; fmt.Bshift = 0; fmt.Ashift = 24;
+		SDL_Surface *conv = SDL_ConvertSurface(img, &fmt, SDL_SWSURFACE);
+		SDL_FreeSurface(img);
+		if (!conv) continue;
+		if (conv->w != f->getWidth() || conv->h != f->getHeight())
+		{
+			Log(LOG_WARNING) << "Full-colour sprite " << twin << " is " << conv->w << "x" << conv->h
+				<< ", expected " << f->getWidth() << "x" << f->getHeight();
+			SDL_FreeSurface(conv); continue;
+		}
+		const int w = conv->w, h = conv->h;
+		std::vector<Uint32> px((size_t)w * h);
+		bool any = false;
+		SDL_LockSurface(conv);
+		for (int y = 0; y < h; ++y)
+		{
+			memcpy(&px[(size_t)y * w], (Uint8*)conv->pixels + y * conv->pitch, (size_t)w * 4);
+			if (!any) for (int x = 0; x < w; ++x) if (px[(size_t)y * w + x] >> 24) { any = true; break; }
+		}
+		SDL_UnlockSurface(conv);
+		SDL_FreeSurface(conv);
+		if (!any) continue;
+		registerSprite(f->getBuffer(), keep(std::move(px)));
+		++done;
+	}
+	if (done) Log(LOG_INFO) << "Full-colour sprites: " << done;
+}
+
+void registerSheet(const std::string &pngPath, SurfaceSet *set, int firstFrame, int sheetW, int sheetH, int subX, int subY)
+{
+	if (!enabled() || !set || subX <= 0 || subY <= 0) return;
+	const auto dot = pngPath.find_last_of('.');
+	if (dot == std::string::npos) return;
+	const std::string twin = pngPath.substr(0, dot) + "_rgb.png";
+	if (!FileMap::fileExists(twin)) return;
+	SDL_Surface *img = IMG_Load_RW(FileMap::getRWops(twin), SDL_TRUE);
+	if (!img) { Log(LOG_WARNING) << "Full-colour sheet unreadable: " << twin; return; }
+	SDL_PixelFormat fmt = {};
+	fmt.BitsPerPixel = 32; fmt.BytesPerPixel = 4;
+	fmt.Rmask = 0x00FF0000; fmt.Gmask = 0x0000FF00; fmt.Bmask = 0x000000FF; fmt.Amask = 0xFF000000;
+	fmt.Rshift = 16; fmt.Gshift = 8; fmt.Bshift = 0; fmt.Ashift = 24;
+	SDL_Surface *conv = SDL_ConvertSurface(img, &fmt, SDL_SWSURFACE);
+	SDL_FreeSurface(img);
+	if (!conv) return;
+	if (conv->w != sheetW || conv->h != sheetH)
+	{
+		Log(LOG_WARNING) << "Full-colour sheet " << twin << " is " << conv->w << "x" << conv->h << ", expected " << sheetW << "x" << sheetH;
+		SDL_FreeSurface(conv); return;
+	}
+	SDL_LockSurface(conv);
+	int frame = firstFrame, used = 0;
+	for (int cy = 0; cy + subY <= sheetH; cy += subY)
+		for (int cx = 0; cx + subX <= sheetW; cx += subX, ++frame)
+		{
+			Surface *f = set->getFrame(frame);
+			if (!f || f->getWidth() != subX || f->getHeight() != subY) continue;
+			std::vector<Uint32> px((size_t)subX * subY);
+			bool any = false;
+			for (int y = 0; y < subY; ++y)
+			{
+				memcpy(&px[(size_t)y * subX], (Uint8*)conv->pixels + (cy + y) * conv->pitch + cx * 4, subX * 4);
+				if (!any) for (int x = 0; x < subX; ++x) if (px[(size_t)y * subX + x] >> 24) { any = true; break; }
+			}
+			if (!any) continue;
+			registerSprite(f->getBuffer(), keep(std::move(px)));
+			++used;
+		}
+	SDL_UnlockSurface(conv);
+	SDL_FreeSurface(conv);
+	Log(LOG_INFO) << "Full-colour sheet: " << twin << " (" << used << " frames)";
+}
+
+bool composite(SDL_Surface *map8, SDL_Surface *screen32, int dx, int dy)
+{
+	if (!layerBase || (Uint8*)map8->pixels != layerBase || screen32->format->BitsPerPixel != 32) return false;
+	const SDL_Color *pal = map8->format->palette->colors;
+	const SDL_PixelFormat *f = screen32->format;
+	Uint32 lut[256];
+	for (int i = 0; i < 256; ++i) lut[i] = SDL_MapRGB(screen32->format, pal[i].r, pal[i].g, pal[i].b);
+	const bool argbOrder = f->Rshift == 16 && f->Gshift == 8 && f->Bshift == 0;
+	if (SDL_MUSTLOCK(screen32)) SDL_LockSurface(screen32);
+	const int w = std::min(layerW, screen32->w - dx), h = std::min(layerH, screen32->h - dy);
+	for (int y = 0; y < h; ++y)
+	{
+		const Uint8 *m = layerBase + y * layerPitch;
+		const Uint32 *r = rgb.data() + (size_t)y * layerW;
+		const Uint8 *t = tag.data() + (size_t)y * layerW;
+		Uint32 *o = (Uint32*)((Uint8*)screen32->pixels + (y + dy) * screen32->pitch) + dx;
+		for (int x = 0; x < w; ++x)
+		{
+			const Uint8 c = m[x];
+			if (c == t[x] && c)
+			{
+				const Uint32 v = r[x];
+				o[x] = argbOrder ? v : SDL_MapRGB(f, (v >> 16) & 0xFF, (v >> 8) & 0xFF, v & 0xFF);
+			}
+			else
+			{
+				o[x] = lut[c];
+			}
+		}
+	}
+	if (SDL_MUSTLOCK(screen32)) SDL_UnlockSurface(screen32);
+	return true;
+}
+
+}
+}
diff --git a/src/Engine/HiColor.h b/src/Engine/HiColor.h
new file mode 100644
index 0000000..4abbbb1
--- /dev/null
+++ b/src/Engine/HiColor.h
@@ -0,0 +1,43 @@
+#pragma once
+/*
+ * G.I. Joe 4x: full-colour battlescape.
+ *
+ * The engine still draws everything in 8 bits. A sprite that also has a 32-bit
+ * twin (registered here by the address of its 8-bit pixels) additionally writes
+ * its true colour into a 32-bit copy of the map layer, together with a tag: the
+ * 8-bit index it left in that pixel. At display time a map pixel is shown in
+ * true colour while its 8-bit value still equals the tag - i.e. nothing without
+ * a twin (a unit, smoke, a cursor) has been drawn over it since.
+ */
+#include <SDL.h>
+#include <vector>
+#include <string>
+
+namespace OpenXcom
+{
+template<typename Pixel> class SurfaceRaw;
+class SurfaceSet;
+
+namespace HiColor
+{
+	/// Is the full-colour path switched on (env OXCE_HICOLOR, default on when OXCE_MAP_HIRES > 1).
+	bool enabled();
+	/// Associates an 8-bit sprite's pixel buffer with its 32-bit twin (0xAARRGGBB, same width/height, pitch = width).
+	void registerSprite(const Uint8 *pixels8, const Uint32 *argb);
+	void unregisterSprite(const Uint8 *pixels8);
+	/// Starts a new frame of the map layer: the 8-bit map surface's buffer and size.
+	void beginLayer(Uint8 *base, int w, int h, int pitch);
+	/// Called by Surface::blitRaw after its 8-bit draw.
+	void afterBlit(const SurfaceRaw<Uint8> &dst, const SurfaceRaw<const Uint8> &src, int x, int y, int shade, bool half, int newBaseColor,
+		int clipX0 = 0, int clipY0 = 0, int clipX1 = 1 << 30, int clipY1 = 1 << 30);
+	/// Keeps a full-colour frame alive for the rest of the run and returns its pixels.
+	const Uint32 *keep(std::vector<Uint32> &&argb);
+	/// For a sprite sheet <file>.png, loads <file>_rgb.png (same size) and registers each subX x subY cell against the matching frame.
+	void registerSheet(const std::string &pngPath, SurfaceSet *set, int firstFrame, int sheetW, int sheetH, int subX, int subY);
+	/// One sprite that came from its own file: <file>_rgb.png. The set's frames are still being
+	/// rebuilt when the mod loads, so this is remembered and resolved at the first frame drawn.
+	void registerSetFrame(SurfaceSet *set, int frame, const std::string &file);
+	/// Writes the map layer to a 32-bit display surface at (dx, dy). Returns false if there is no layer for this surface.
+	bool composite(SDL_Surface *map8, SDL_Surface *screen32, int dx, int dy);
+}
+}
