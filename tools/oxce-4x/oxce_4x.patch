+	/// The window's 8-bit backdrop, smoothly enlarged and dimmed so text reads on it.
+	const BgCache &backdrop(const Surface *bg)
+	{
+		const SDL_Color *pal = base->format->palette->colors;
+		const Uint32 h = palHash(pal);
+		const int W = xs[std::min(bw, bg->getWidth())] - xs[0], H = ys[std::min(bh, bg->getHeight())] - ys[0];
+		for (auto &c : bgCache) if (c.bg == bg && c.palHash == h && c.w == W && c.h == H) return c;
+		if (bgCache.size() > 5) bgCache.erase(bgCache.begin());
+		bgCache.push_back(BgCache{ bg, h, W, H, std::vector<Uint32>((size_t)W * H) });
+		BgCache &c = bgCache.back();
+		const int gw = bg->getWidth(), gh = bg->getHeight(), pitch = bg->getPitch();
+		const Uint8 *src = bg->getBuffer();
+		for (int y = 0; y < H; ++y)
+		{
+			const double fy = (y + 0.5) * gh / H - 0.5; const int y0 = std::max(0, (int)std::floor(fy)), y1 = std::min(gh - 1, y0 + 1); const int ty = (int)((fy - y0) * 256); const int wy = std::min(256, std::max(0, ty));
