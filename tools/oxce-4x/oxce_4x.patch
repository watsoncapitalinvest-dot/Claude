+	}
+
+	// PUBLIC - SECRET until G.I. Joe goes public, then a percentage. There is no
+	// "goes public" state anywhere in the save or the engine yet, so it says
+	// SECRET, which is true of every campaign this build can play.
+	_txtDeskPublic->setText(tr("STR_DESK_SECRET"));
+
+	// THREAT - a word, never a number. There is no provocation gauge yet
+	// (BACK_BURNER.md, queued). Until there is, this reads the month the council
+	// is keeping score of: G.I. Joe's activity plus research score against
+	// Cobra's activity this month, banded at the same lines MonthlyReportState
+	// uses for its rating (TERRIBLE / POOR / OK / GOOD). It is what the council
+	// will say at month end, not what Cobra intends, and everything in it is on
+	// the player's own graphs already.
+	{
+		int xcom = 0, cobra = 0;
+		for (auto *region : *save->getRegions())
+		{
+			if (!region->getActivityXcom().empty()) xcom += region->getActivityXcom().back();
+			if (!region->getActivityAlien().empty()) cobra += region->getActivityAlien().back();
+		}
+		if (!save->getResearchScores().empty()) xcom += save->getResearchScores().back();
+		const int score = xcom - cobra;
+		int threshold = _game->getMod()->getDefeatScore() + 100 * save->getDifficultyCoefficient();
+		{
+			auto &custom = _game->getMod()->getMonthlyRatingThresholds();
+			const size_t diff = (size_t)save->getDifficulty();
+			if (custom.size() > diff && custom[diff] < 0) threshold = custom[diff];
+		}
+		const char *word; Uint32 ink;
+		if (score <= threshold - 300) { word = "STR_THREAT_IMMINENT"; ink = 0xE5483A; }
+		else if (score <= threshold)  { word = "STR_THREAT_HIGH";     ink = 0xE8873A; }
+		else if (score < 0)           { word = "STR_THREAT_ELEVATED"; ink = 0xE8B923; }   // a quiet day one (score 0) reads LOW
+		else                          { word = "STR_THREAT_LOW";      ink = 0x8FC66A; }
+		_txtDeskThreat->setText(tr(word));
+		HiUI::textInk(_txtDeskThreat, ink);
+	}
+
+	// LEADS - dossier entries that research has opened and nobody has read yet.
+	// Entries the game starts with are not leads, so only articles that require
+	// research count. Reading one (ArticleState) clears it.
+	{
+		int fresh = 0;
+		for (const auto &id : _game->getMod()->getUfopaediaList())
+		{
+			ArticleDefinition *art = _game->getMod()->getUfopaediaArticle(id);
+			if (!art || art->_requires.empty() || art->hiddenCommendation) continue;
+			if (art->section == UFOPAEDIA_NOT_AVAILABLE || art->section == UFOPAEDIA_COMMENDATIONS) continue;
+			if (!Ufopaedia::isArticleAvailable(save, art)) continue;
+			if (save->getUfopediaRuleStatus(art->id) == ArticleDefinition::PEDIA_STATUS_NEW) ++fresh;
+		}
+		if (fresh > 0)
+		{
+			_txtDeskLeads->setText(tr("STR_DESK_LEADS_NEW").arg(fresh));
+			HiUI::textInk(_txtDeskLeads, 0xE8B923);
+		}
+		else
+		{
+			_txtDeskLeads->setText("\xE2\x80\x93");   // en dash
+			HiUI::textInk(_txtDeskLeads, 0xB9B5A8);
+		}
+	}
+}
