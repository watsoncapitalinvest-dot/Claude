+int lastTurn() { return turnSeen; }
+
+int aggression(int faction, int own)
+{
+	if (!on() || faction > 1) return own;
+	const char *v = getenv(faction == 0 ? "OXCE_BATTLESIM_JOES" : "OXCE_BATTLESIM_COBRA");
+	const std::string st = v ? v : "normal";
+	if (st == "defensive") return 0;     // holds back, takes cover, falls back when hurt
+	if (st == "aggressive") return 3;    // closes in, shoots first, rarely retreats
+	return faction == 0 ? std::max(own, 1) : own;
+}
