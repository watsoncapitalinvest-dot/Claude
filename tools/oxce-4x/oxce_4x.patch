diff --git a/src/Mod/RuleLead.h b/src/Mod/RuleLead.h
new file mode 100644
index 0000000..5bc7803
--- /dev/null
+++ b/src/Mod/RuleLead.h
@@ -0,0 +1,62 @@
+#pragma once
+/*
+ * G.I. Joe: USA Defense. A lead: intelligence that fills toward finding something.
+ *
+ *   leads:
+ *     - type: STR_LEAD_ABANDONED_FACTORY
+ *       threshold: 100              # points to solve it
+ *       research:                   # a topic finishing adds points
+ *         STR_CARTEL_LEDGER: 60
+ *       items:                      # each one recovered from a battle adds points
+ *         STR_CRATE_SERIAL_PLATE: 40
+ *       revealSiteType: STR_X       # solving discovers one hidden Cobra site of this type
+ *       markSiteType: STR_X         # solving pins every hidden site of this type (not discovered)
+ *       grantResearch: [STR_Y]      # solving hands over these topics (mission scripts can key on them)
+ *       listOrder: 10
+ *
+ * A lead appears on the INTEL board once it has any points.
+ */
+#include <map>
+#include <string>
+#include <vector>
+#include "../Engine/Yaml.h"
+
+namespace OpenXcom
+{
+
+class RuleLead
+{
+private:
+	std::string _type;
+	int _threshold = 100;
+	int _listOrder = 0;
+	std::map<std::string, int> _research, _items;
+	std::string _revealSiteType, _markSiteType;
+	std::vector<std::string> _grantResearch;
+public:
+	RuleLead(const std::string &type) : _type(type) {}
+	void load(const YAML::YamlNodeReader &reader)
+	{
+		if (const auto &parent = reader["refNode"])
+		{
+			load(parent);
+		}
+		reader.tryRead("threshold", _threshold);
+		reader.tryRead("listOrder", _listOrder);
+		reader.tryRead("research", _research);
+		reader.tryRead("items", _items);
+		reader.tryRead("revealSiteType", _revealSiteType);
+		reader.tryRead("markSiteType", _markSiteType);
+		reader.tryRead("grantResearch", _grantResearch);
+	}
+	const std::string &getType() const { return _type; }
+	int getThreshold() const { return _threshold > 0 ? _threshold : 1; }
+	int getListOrder() const { return _listOrder; }
+	const std::map<std::string, int> &getResearch() const { return _research; }
+	const std::map<std::string, int> &getItems() const { return _items; }
+	const std::string &getRevealSiteType() const { return _revealSiteType; }
+	const std::string &getMarkSiteType() const { return _markSiteType; }
+	const std::vector<std::string> &getGrantResearch() const { return _grantResearch; }
+};
+
+}
