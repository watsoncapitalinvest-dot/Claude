new file mode 100644
index 0000000..1a4f3c2
--- /dev/null
+++ b/src/Battlescape/Testbed.cpp
@@ -0,0 +1,156 @@
+/*
+ * G.I. Joe: the TEST RANGE (BUILD-2). See Testbed.h.
+ */
+#include "Testbed.h"
+#include <algorithm>
+#include <set>
+#include <vector>
+#include "BattlescapeGame.h"
+#include "../Engine/Logger.h"
+#include "../Mod/Mod.h"
+#include "../Mod/Armor.h"
+#include "../Mod/RuleItem.h"
+#include "../Mod/RuleSoldier.h"
+#include "../Mod/AlienDeployment.h"
+#include "../Mod/Unit.h"
+#include "../Savegame/Base.h"
+#include "../Savegame/Craft.h"
+#include "../Savegame/ItemContainer.h"
+#include "../Savegame/Vehicle.h"
+#include "../Savegame/Soldier.h"
+#include "../Savegame/SavedGame.h"
+#include "../Savegame/SavedBattleGame.h"
+#include "../Savegame/BattleUnit.h"
+#include "../Savegame/BattleItem.h"
+#include "../Savegame/Tile.h"
+
+namespace OpenXcom
+{
+
+namespace Testbed
+{
+
+const char *MISSION = "STR_GJ_TESTBED";
+
+bool is(const std::string &missionType) { return missionType == MISSION; }
+bool is(const SavedBattleGame *save) { return save && save->getMissionType() == MISSION; }
+
+void loadNewBattle(const Mod *mod, SavedGame *save, Base *base, Craft *craft)
+{
+	// the Cobra side, as the deployment names it: those vehicles stay off the Joes' craft
+	std::set<std::string> cobra;
+	if (const AlienDeployment *dep = mod->getDeployment(MISSION, false))
+		for (const auto &dd : *dep->getDeploymentData())
+			if (!dd.customUnitType.empty()) cobra.insert(dd.customUnitType);
+
+	// every named Joe (a soldier type nobody pays for and nothing has to be researched for): made if the saved New
+	// Battle setup lacks him, then aboard; nobody else
+	auto named = [](const RuleSoldier *r) { return r->getBuyCost() == 0 && r->getRequirements().empty(); };
+	std::set<std::string> have;
+	for (auto *s : *base->getSoldiers()) have.insert(s->getRules()->getType());
+	for (auto &t : mod->getSoldiersList())
+	{
+		const RuleSoldier *r = mod->getSoldier(t, true);
+		if (!named(r) || have.count(t)) continue;
+		Soldier *s = mod->genSoldier(save, r, save->selectSoldierNationalityByLocation(mod, r, nullptr));
+		base->getSoldiers()->push_back(s);
+	}
+	int joes = 0;
+	for (auto *s : *base->getSoldiers())
+	{
+		const bool n = named(s->getRules());
+		s->setCraft(n ? craft : nullptr);
+		if (n) ++joes;
+	}
+
+	// every Joe vehicle: a kit vehicle whose unit is not on Cobra's side
+	bool kit = false;
+	for (auto &t : mod->getItemsList())
+	{
+		const auto &c = mod->getItem(t)->getCategories();
+		if (std::find(c.begin(), c.end(), "STR_JOE_KIT") != c.end()) { kit = true; break; }
+	}
+	for (auto *v : *craft->getVehicles()) delete v;
+	craft->getVehicles()->clear();
+	int vehicles = 0;
+	for (auto &t : mod->getItemsList())
+	{
+		const RuleItem *rule = mod->getItem(t);
+		if (!rule->getVehicleUnit() || !rule->isRecoverable()) continue;
+		const auto &c = rule->getCategories();
+		if (kit && std::find(c.begin(), c.end(), "STR_JOE_KIT") == c.end()) continue;
+		if (cobra.count(rule->getVehicleUnit()->getType())) continue;
+		const int size = rule->getVehicleUnit()->getArmor()->getTotalSize();
+		craft->getVehicles()->push_back(new Vehicle(rule, rule->getVehicleClipSize(), size));
+		++vehicles;
+	}
+	// the armory: every piece of kit a man can carry, topped up to New Battle's numbers (a saved setup may hold less)
+	for (auto &t : mod->getItemsList())
+	{
+		const RuleItem *rule = mod->getItem(t);
+		if (rule->getBattleType() == BT_NONE || rule->getBattleType() == BT_CORPSE || !rule->isInventoryItem() || rule->getVehicleUnit() || !rule->isRecoverable()) continue;
+		const auto &c = rule->getCategories();
+		if (kit && std::find(c.begin(), c.end(), "STR_JOE_KIT") == c.end()) continue;
+		const BattleType bt = rule->getBattleType();
+		const int want = bt == BT_AMMO ? 8 : (bt == BT_GRENADE || bt == BT_PROXIMITYGRENADE) ? 12 : 2;
+		const int now = craft->getItems()->getItem(rule);
+		if (now < want) craft->getItems()->addItem(rule, want - now);
+	}
+	Log(LOG_INFO) << "[testbed] aboard: " << joes << " named Joes, " << vehicles << " vehicles, "
+		<< craft->getItems()->getTotalQuantity() << " items; Cobra side " << cobra.size() << " units";
+}
+
+void prepare(SavedBattleGame *save)
+{
+	if (!is(save)) return;
+	std::vector<BattleItem*> drop;
+	int emptied = 0, cobra = 0;
+	for (auto *it : *save->getItems())
+	{
+		BattleUnit *o = it->getOwner();
+		if (!o || o->getOriginalFaction() != FACTION_HOSTILE) continue;
+		const BattleType bt = it->getRules()->getBattleType();
+		if (bt == BT_GRENADE || bt == BT_PROXIMITYGRENADE || (bt == BT_AMMO && it->getSlot()))
+		{
+			drop.push_back(it);   // thrown or loaded later: take them away
+			continue;
+		}
+		if (it->getRules()->getClipSize() > 0) { it->setAmmoQuantity(0); ++emptied; }
+		for (int s = 0; s < 4; ++s)
+			if (BattleItem *a = it->getAmmoForSlot(s)) { if (a != it) a->setAmmoQuantity(0); ++emptied; }
+	}
+	for (auto *it : drop) save->removeItem(it);
+	for (auto *u : *save->getUnits())
+		if (u->getOriginalFaction() == FACTION_HOSTILE && !u->isOut()) { u->setTimeUnits(0); ++cobra; }
+	// the armory pile: it lands where the first Joe unit stood, and vehicles go first, so it can be under a tank where
+	// no man can reach it. Move it onto the tile of the first man who carries an inventory.
+	BattleUnit *man = nullptr;
+	for (auto *u : *save->getUnits())
+		if (u->getOriginalFaction() == FACTION_PLAYER && u->hasInventory() && u->getArmor()->getSize() == 1 && u->getTile()) { man = u; break; }
+	std::vector<BattleItem*> pile;
+	for (auto *it : *save->getItems())
+		if (!it->getOwner() && it->getTile() && it->getXCOMProperty()) pile.push_back(it);
+	if (man && !pile.empty())
+	{
+		Tile *from = pile.front()->getTile();
+		for (auto *it : pile) { it->getTile()->removeItem(it); man->getTile()->addItem(it, save->getMod()->getInventoryGround()); }
+		Log(LOG_INFO) << "[testbed] the armory: " << pile.size() << " items moved from " << from->getPosition() << " to "
+			<< man->getTile()->getPosition() << ", under " << man->getType();
+	}
+	int joes = 0;
+	for (auto *u : *save->getUnits()) if (u->getOriginalFaction() == FACTION_PLAYER) ++joes;
+	Log(LOG_INFO) << "[testbed] " << cobra << " Cobra standing, " << drop.size() << " grenades and spare clips taken, "
+		<< emptied << " guns emptied; " << joes << " on the Joes' side";
+}
+
+bool freeze(SavedBattleGame *save, BattleUnit *unit, BattleAction *action)
+{
+	if (!is(save) || unit->getOriginalFaction() != FACTION_HOSTILE) return false;
+	unit->setTimeUnits(0);
+	action->type = BA_NONE;
+	return true;
+}
+
+}
+
+}
