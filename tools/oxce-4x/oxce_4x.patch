+	/// Resample by AREA: every output pixel is the exact average of the source
+	/// under it. A painting made at 6x and shown at 4x stays sharp this way;
+	/// bilinear at that ratio skips source pixels and goes soft and grainy.
+	Img resampleArea(const Img &src, int W, int H)
+	{
+		Img out; out.w = W; out.h = H; out.px.assign((size_t)W * H, 0); out.ok = true;
+		if (W <= 0 || H <= 0 || !src.ok) return out;
+		std::vector<float> tmp((size_t)W * src.h * 4, 0.f);
+		const double rx = (double)src.w / W, ry = (double)src.h / H;
+		for (int x = 0; x < W; ++x)
+		{
+			const double a = x * rx, b = (x + 1) * rx;
+			for (int sx = (int)a; sx < std::min(src.w, (int)std::ceil(b)); ++sx)
+			{
+				const float wgt = (float)((std::min(b, sx + 1.0) - std::max(a, (double)sx)) / rx);
+				if (wgt <= 0) continue;
+				for (int y = 0; y < src.h; ++y)
+				{
+					const Uint32 p = src.px[(size_t)y * src.w + sx];
+					float *t = &tmp[((size_t)y * W + x) * 4];
+					t[0] += wgt * ((p >> 24) & 255); t[1] += wgt * ((p >> 16) & 255); t[2] += wgt * ((p >> 8) & 255); t[3] += wgt * (p & 255);
+				}
+			}
+		}
+		for (int y = 0; y < H; ++y)
+		{
+			const double a = y * ry, b = (y + 1) * ry;
+			float acc[4];
+			for (int x = 0; x < W; ++x)
+			{
+				acc[0] = acc[1] = acc[2] = acc[3] = 0;
+				for (int sy = (int)a; sy < std::min(src.h, (int)std::ceil(b)); ++sy)
+				{
+					const float wgt = (float)((std::min(b, sy + 1.0) - std::max(a, (double)sy)) / ry);
+					if (wgt <= 0) continue;
+					const float *t = &tmp[((size_t)sy * W + x) * 4];
+					for (int c = 0; c < 4; ++c) acc[c] += wgt * t[c];
+				}
+				auto cl = [](float v) { return (Uint32)std::max(0, std::min(255, (int)(v + 0.5f))); };
+				out.px[(size_t)y * W + x] = (cl(acc[0]) << 24) | (cl(acc[1]) << 16) | (cl(acc[2]) << 8) | cl(acc[3]);
+			}
+		}
+		return out;
+	}
