+void ResearchTreeState::paintLanes(double X0, double Y0, double k)
+{
+	const Mod *mod = _game->getMod();
+	SavedGame *save = _game->getSavedGame();
+	for (size_t L = 0; L < _laneTypes.size(); ++L)
+	{
+		const double y0 = Y0 + (_laneTop[L] * PY - _scrollY) * k, y1 = y0 + _laneRows[L] * PY * k;
+		HiUI::Paint::rect(X0, y0, X0 + 50 * k, y1, (L % 2) ? 0x1B2023 : 0x14181A);
+		HiUI::Paint::rect(X0, y1 - 0.25 * k, X0 + 50 * k, y1, C_EDGE);
+		const std::string &type = _laneTypes[L];
+		// the lane emblem (ART's round patch)
+		const double cx = X0 + 7 * k, cy = y0 + 8 * k, r = 5.5 * k;
+		if (!HiUI::Paint::image(TREE + laneEmblem(type) + ".png", cx - r, cy - r, cx + r, cy + r))
+		{
+			HiUI::Paint::roundRect(cx - r, cy - r, cx + r, cy + r, r, C_OLIVE);
+			HiUI::Paint::text("stencil", std::string(tr("STR_DEPT_" + type)).substr(0, 1), cx - r, cy - r, cx + r, cy + r, 2.6 * k, 1, 1, C_YELLOW);
+		}
+		HiUI::Paint::text("stencil", tr("STR_DEPT_" + type), X0 + 13.5 * k, y0 + 2.5 * k, X0 + 49 * k, y0 + 8.5 * k, 3.0 * k, 0, 1, C_YELLOW);
+		// head, his state chip, the department's speed bar
+		bool captured = false;
+		const Soldier *s = save->findJoe(save->getDeptHead(type), &captured);
+		std::string chip; Uint32 chipCol = C_GREY;
+		if (!save->hasDeptRoom(mod, type)) { chip = tr("STR_DEPT_NO_ROOM"); }
+		else if (!s) { chip = tr("STR_NO_HEAD"); }
+		else if (captured) { chip = tr("STR_HEAD_CAPTURED"); chipCol = C_DARKRED; }
+		else if (SavedGame::isJoeAway(s)) { chip = tr("STR_HEAD_AWAY"); chipCol = C_ORANGE; }
+		else { chip = tr("STR_HEAD_IN_OFFICE"); chipCol = C_GREEN; }
+		HiUI::Paint::text("label", s ? s->getName() : std::string("-"), X0 + 13.5 * k, y0 + 9 * k, X0 + 49 * k, y0 + 13 * k, 2.2 * k, 0, 1, C_BONE);
+		HiUI::Paint::text("label", chip, X0 + 13.5 * k, y0 + 13.5 * k, X0 + 49 * k, y0 + 17 * k, 1.9 * k, 0, 1, chipCol);
+		if (save->hasDeptRoom(mod, type))
+		{
+			const int spd = save->getDeptSpeed(mod, type);
+			const Uint32 bc = spd >= 100 ? C_GREEN : spd >= 70 ? C_ORANGE : C_RED;
+			HiUI::Paint::rect(X0 + 2 * k, y0 + 19 * k, X0 + 40 * k, y0 + 21 * k, C_EDGE);
+			HiUI::Paint::rect(X0 + 2 * k, y0 + 19 * k, X0 + (2 + 38 * std::min(100, spd) / 100.0) * k, y0 + 21 * k, bc);
+			HiUI::Paint::text("label", std::to_string(spd) + "%", X0 + 41 * k, y0 + 18.2 * k, X0 + 50 * k, y0 + 21.8 * k, 1.6 * k, 0, 1, bc);
+		}
+	}
+}
