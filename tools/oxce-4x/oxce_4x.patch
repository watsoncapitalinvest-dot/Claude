+void vectorFloor(const Surface *floor)
+{
+	if (!base || !floor) return;
+	if (vtag.size() != (size_t)bw * bh) { vtag.assign((size_t)bw * bh, 0); vvalid.assign((size_t)bw * bh, 0); }
+	else std::fill(vvalid.begin(), vvalid.end(), 0);
+	SDL_Surface *own = const_cast<Surface*>(floor)->getSurface();
+	if (!own || own->format->BitsPerPixel != 8) return;
+	const int fx = floor->getX(), fy = floor->getY();
+	for (int y = 0; y < own->h; ++y)
+	{
+		const int by = fy + y;
+		if (by < 0 || by >= bh) continue;
+		const Uint8 *src = (const Uint8*)own->pixels + y * own->pitch;
+		const Uint8 *dst = row8(by);
+		for (int x = 0; x < own->w; ++x)
+		{
+			const int bx = fx + x;
+			if (bx < 0 || bx >= bw || !src[x]) continue;   // 0 is space: no line there
+			vvalid[(size_t)by * bw + bx] = 1;
+			vtag[(size_t)by * bw + bx] = dst[bx];
+		}
+	}
+	vHave = true;
+}
+
+bool composite(SDL_Surface *base8, SDL_Surface *screen32, bool fillBase)
+{
+	if (!base || base8 != base || screen32->format->BitsPerPixel != 32 || screen32->w != sw || screen32->h != sh) return false;
+	const SDL_PixelFormat *f = screen32->format;
+	const bool direct = f->Rshift == 16 && f->Gshift == 8 && f->Bshift == 0;
+	if (SDL_MUSTLOCK(screen32)) SDL_LockSurface(screen32);
+	auto put = [&](int X, int Y, Uint32 c)
+	{
+		((Uint32*)((Uint8*)screen32->pixels + Y * screen32->pitch))[X] = direct ? c : SDL_MapRGB(f, (c >> 16) & 255, (c >> 8) & 255, c & 255);
+	};
+	if (fillBase)
+	{
+		// ONE PASS (12 Nov, performance): the zoomed 8-bit frame is written straight into the
+		// 32-bit screen here, cell by cell, and only where the overlay does not cover it. This
+		// replaces clearing an 8-bit screen-sized buffer, zooming into it, converting it to 32
+		// bits and then overwriting most of it with the overlay - four full-screen passes.
+		Uint32 pal[256];
+		const SDL_Color *c = base8->format->palette->colors;
+		const int nc = base8->format->palette->ncolors;
+		for (int i = 0; i < 256; ++i)
+			pal[i] = i < nc ? (direct ? rgb(c[i].r, c[i].g, c[i].b) : SDL_MapRGB(f, c[i].r, c[i].g, c[i].b)) : 0;
+		// the black bands
+		const Uint32 black = direct ? 0 : SDL_MapRGB(f, 0, 0, 0);
+		for (int Y = 0; Y < sh; ++Y)
+		{
+			Uint32 *d = (Uint32*)((Uint8*)screen32->pixels + Y * screen32->pitch);
+			if (Y < ys[0] || Y >= ys[bh]) { for (int X = 0; X < sw; ++X) d[X] = black; continue; }
+			for (int X = 0; X < xs[0]; ++X) d[X] = black;
+			for (int X = xs[bw]; X < sw; ++X) d[X] = black;
+		}
+		for (int by = 0; by < bh; ++by)
+		{
+			const Uint8 *p = row8(by);
+			const Uint8 *vr = any ? &valid[(size_t)by * bw] : nullptr;
+			const Uint8 *tr = any ? &tag[(size_t)by * bw] : nullptr;
+			for (int Y = ys[by]; Y < ys[by + 1]; ++Y)
+			{
+				Uint32 *d = (Uint32*)((Uint8*)screen32->pixels + Y * screen32->pitch);
+				const Uint32 *o = over.data() + (size_t)Y * sw;
+				for (int bx = 0; bx < bw; ++bx)
+				{
+					const int x0 = xs[bx], x1 = xs[bx + 1];
+					if (vr && vr[bx] && tr[bx] == p[bx])
+					{
+						if (direct) memcpy(d + x0, o + x0, (size_t)(x1 - x0) * 4);
+						else for (int X = x0; X < x1; ++X) put(X, Y, o[X]);
+					}
+					else
+					{
+						const Uint32 v = pal[p[bx]];
+						for (int X = x0; X < x1; ++X) d[X] = v;
+					}
+				}
+			}
+		}
+	}
+	else if (any)
+	{
+		for (int by = 0; by < bh; ++by)
+		{
+			const Uint8 *p = row8(by);
+			for (int bx = 0; bx < bw; ++bx)
+			{
+				if (!valid[by * bw + bx] || tag[by * bw + bx] != p[bx]) continue;
+				for (int Y = ys[by]; Y < ys[by + 1]; ++Y)
+				{
+					const Uint32 *o = over.data() + (size_t)Y * sw;
+					Uint32 *d = (Uint32*)((Uint8*)screen32->pixels + Y * screen32->pitch);
+					if (direct) memcpy(d + xs[bx], o + xs[bx], (xs[bx + 1] - xs[bx]) * 4);
+					else for (int X = xs[bx]; X < xs[bx + 1]; ++X) put(X, Y, o[X]);
+				}
+			}
+		}
+	}
+	// VECTOR STROKES, after the zoomed frame and every claimed overlay pixel, and
+	// before the cursor. Each colour in a layer is rasterised into a coverage
+	// buffer with MAX, then blended once - so where two segments of one border
+	// meet, the joint is not painted twice into a darker bead.
+	if (vHave)
+	{
+		const double sxk = (double)(xs[bw] - xs[0]) / bw, syk = (double)(ys[bh] - ys[0]) / bh;
+		const double ox = xs[0], oy = ys[0];
+		if (vcov.size() != (size_t)sw * sh) vcov.assign((size_t)sw * sh, 0);
+		for (auto &layer : vlayers)
+		{
+			std::vector<Uint32> colours;
+			for (const auto &l : layer)
+				if (std::find(colours.begin(), colours.end(), l.argb) == colours.end()) colours.push_back(l.argb);
+			for (Uint32 col : colours)
+			{
+				vtouched.clear();
+				for (const auto &l : layer)
+				{
+					if (l.argb != col) continue;
+					const double X1 = ox + l.x1 * sxk, Y1 = oy + l.y1 * syk, X2 = ox + l.x2 * sxk, Y2 = oy + l.y2 * syk;
+					const double hw = l.w * 0.5, pad = hw + 1.0;
+					const int x0 = std::max(0, (int)std::floor(std::min(X1, X2) - pad));
+					const int x1 = std::min(sw - 1, (int)std::ceil(std::max(X1, X2) + pad));
+					const int y0 = std::max(0, (int)std::floor(std::min(Y1, Y2) - pad));
+					const int y1 = std::min(sh - 1, (int)std::ceil(std::max(Y1, Y2) + pad));
+					const double dx = X2 - X1, dy = Y2 - Y1, L2 = dx * dx + dy * dy;
+					for (int Y = y0; Y <= y1; ++Y)
+					{
+						const int by = (int)((Y + 0.5 - oy) / syk);
+						if (by < 0 || by >= bh) continue;
+						const Uint8 *row = row8(by);
+						for (int X = x0; X <= x1; ++X)
+						{
+							const int bx = (int)((X + 0.5 - ox) / sxk);
+							if (bx < 0 || bx >= bw) continue;
+							const size_t bi = (size_t)by * bw + bx;
+							// the floor rule: only where the globe's own pixel still shows
+							if (!vvalid[bi] || vtag[bi] != row[bx]) continue;
+							const double px = X + 0.5 - X1, py = Y + 0.5 - Y1;
+							double t = L2 > 0 ? (px * dx + py * dy) / L2 : 0.0;
+							t = t < 0 ? 0 : (t > 1 ? 1 : t);
+							const double qx = px - t * dx, qy = py - t * dy;
+							const double d = std::sqrt(qx * qx + qy * qy);
+							double cov = hw + 0.5 - d;
+							if (cov <= 0) continue;
+							if (cov > 1) cov = 1;
+							const Uint8 c8 = (Uint8)(cov * 255);
+							Uint8 &cell = vcov[(size_t)Y * sw + X];
+							if (cell == 0) vtouched.push_back(Y * sw + X);
+							if (c8 > cell) cell = c8;
+						}
+					}
+				}
+				const int a = col >> 24;
+				const Uint32 rgbc = col & 0xFFFFFF;
+				for (int idx : vtouched)
+				{
+					const int X = idx % sw, Y = idx / sw;
+					const int al = vcov[idx] * a / 255;
+					vcov[idx] = 0;
+					if (al <= 0) continue;
+					Uint32 *d = (Uint32*)((Uint8*)screen32->pixels + Y * screen32->pitch) + X;
+					const Uint32 under = direct ? (*d & 0xFFFFFF) : rgb((*d >> f->Rshift) & 255, (*d >> f->Gshift) & 255, (*d >> f->Bshift) & 255);
+					put(X, Y, mix(under, rgbc, al));
+				}
+			}
+		}
+	}
+	if (curOn && curX >= 0 && curY >= 0 && curX < bw && curY < bh)
+	{
+		const Img *cur = piece("cursor");
+		// drawn where the mouse really is, to the screen pixel: the game's cursor position is in
+		// base pixels, so drawing it there moved the arrow in 6-pixel jumps (the jitter John saw)
+		int mx = 0, my = 0;
+		SDL_GetMouseState(&mx, &my);
+		const bool real = mx >= xs[0] && my >= ys[0] && mx < xs[bw] && my < ys[bh];
+		const int oy = real ? my : ys[curY], ox = real ? mx : xs[curX];
+		if (cur)
+		{
+			const int H = (ys[std::min(bh, curY + 17)] - oy), W = std::max(1, cur->w * H / cur->h);
+			for (int Y = 0; Y < H; ++Y)
+			{
+				const int SY = oy + Y; if (SY < 0 || SY >= sh) continue;
+				Uint32 *d = (Uint32*)((Uint8*)screen32->pixels + SY * screen32->pitch);
+				const int sy2 = std::min(cur->h - 1, Y * cur->h / H);
+				for (int X = 0; X < W; ++X)
+				{
+					const int SX = ox + X; if (SX < 0 || SX >= sw) continue;
+					const Uint32 p = cur->px[(size_t)sy2 * cur->w + std::min(cur->w - 1, X * cur->w / W)];
+					const int al = p >> 24; if (al < 40) continue;
+					const Uint32 c = al >= 230 ? (p & 0xFFFFFF) : mix(direct ? d[SX] : rgb((d[SX] >> f->Rshift & 255), (d[SX] >> f->Gshift & 255), (d[SX] >> f->Bshift & 255)), p & 0xFFFFFF, al);
+					put(SX, SY, c);
+				}
+			}
+		}
+		else
+		{
+		const double s2 = std::max(1.0, (ys[1] - ys[0]) / 5.0);
+		const double P[7][2] = { {0,0},{0,17},{4,13},{7,20},{10,19},{7,12},{12,12} };
+		auto inside = [&](double x, double y)
+		{
+			bool in = false;
+			for (int i = 0, j = 6; i < 7; j = i++)
+				if (((P[i][1] > y) != (P[j][1] > y)) && (x < (P[j][0] - P[i][0]) * (y - P[i][1]) / (P[j][1] - P[i][1]) + P[i][0])) in = !in;
+			return in;
+		};
+		for (int Y = (int)(-2 * s2); Y < (int)(22 * s2); ++Y)
+			for (int X = (int)(-2 * s2); X < (int)(14 * s2); ++X)
+			{
+				const int SX = ox + X, SY = oy + Y;
+				if (SX < 0 || SY < 0 || SX >= sw || SY >= sh) continue;
+				const double x = X / s2, y = Y / s2;
+				if (inside(x, y)) put(SX, SY, rgb(236, 232, 214));
+				else if (inside(x - 1.1, y) || inside(x + 1.1, y) || inside(x, y - 1.1) || inside(x, y + 1.1)) put(SX, SY, rgb(18, 20, 19));
+			}
+		}
+	}
+	if (SDL_MUSTLOCK(screen32)) SDL_UnlockSurface(screen32);
+	return true;
+}
+
+}
+}
diff --git a/src/Engine/HiUI.h b/src/Engine/HiUI.h
new file mode 100644
index 0000000..8a6c127
--- /dev/null
+++ b/src/Engine/HiUI.h
@@ -0,0 +1,203 @@
+#pragma once
+/*
+ * G.I. Joe 4x: menus at screen resolution, in full colour.
+ *
+ * The game still lays out and draws every screen in 8 bits at its base size. Widgets this module
+ * knows (windows, text buttons, text) are drawn a second time, at the display's own resolution,
+ * into an overlay. A base pixel shows the overlay while its 8-bit value is still what it was when
+ * the last such widget finished drawing there; anything else drawn on top shows through as before.
+ */
+#include <SDL.h>
+#include <cstdint>
+#include <string>
+#include <vector>
+#include <functional>
+
+namespace OpenXcom
+{
+class Surface;
+class SurfaceSet;
+
+namespace HiUI
+{
+	bool enabled();
+	/// Start of a frame: the game's 8-bit buffer and the display it will be zoomed onto.
+	void beginFrame(SDL_Surface *base8, int screenW, int screenH, int left, int top, int right, int bottom);
+	/// Around every widget blit in State::blit.
+	void before(Surface *widget);
+	void after(Surface *widget);
+	/// Mouse pointer for this frame, in base coordinates; replaces the 8-bit cursor.
+	void cursor(int x, int y, bool visible);
+	/// A font sheet's sharp twin: <file>_hi.png, each cell K times the size of the 8-bit one.
+	void registerFontImage(const Surface *sheet8, const std::string &file);
+	/// Point one surface at another's registered twin. A state that COPIES a mod
+	/// surface into a widget of its own - the geoscape does, for its side panel -
+	/// holds a different pointer, so the twin can never be found by lookup.
+	void aliasImage(const Surface *dst, const Surface *src);
+	/// A screen background's or a sprite frame's sharp twin: <file>_hi.png, any size.
+	void registerImage(const Surface *img, const std::string &file);
+	/// A sprite frame's sharp twin. The set's frames are not in their final places yet when the mod
+	/// loads, so the file is remembered here and the frame looked up the first time one is drawn.
+	void registerSetFrame(SurfaceSet *set, int frame, const std::string &file);
+	/// A registered surface's sharp twin, drawn inside part of a widget it was copied
+	/// into at (x,y) - widget-relative base px - every time that widget is drawn.
+	/// For a widget composed of several pieces, of which only one has a twin.
+	void spriteIn(const Surface *dst, const Surface *src, int x, int y);
+	/// Draw a registered sprite's sharp twin over the base rect it has just been blitted into.
+	/// Only base pixels the sprite actually wrote are taken over, so its shape stays its own.
+	void sprite(const Surface *frame, int x, int y, int w, int h);
+	/// The same twin, scaled down about the centre of a box (bx,by,bw,bh) so that
+	/// `inset` base px of the box stay clear all round. The 8-bit icon under it
+	/// is hidden. For items in the painted equipment page's compartments.
+	void spriteFit(const Surface *frame, int x, int y, int w, int h, int bx, int by, int bw, int bh, double inset);
+	/// After the 8-bit buffer has been zoomed onto the 32-bit display.
+	/// fillBase: also write the zoomed 8-bit frame itself (one pass); false if HiUI is not on this frame.
+	bool composite(SDL_Surface *base8, SDL_Surface *screen32, bool fillBase = false);
+
+	/// VECTOR STROKES. Lines the game would draw one base pixel wide - country
+	/// borders, radar rings, flight paths, route marks - recorded at full precision
+	/// and stroked anti-aliased at display resolution when the frame is composited,
+	/// instead of being drawn into the 8-bit buffer and zoomed into staircases.
+	/// Layers mirror the 8-bit surfaces they replace, so each is cleared exactly when
+	/// that surface is.
+	enum VectorLayer { VEC_DETAIL = 0, VEC_RADAR = 1, VEC_LAYERS = 2 };
+	void vectorClear(int layer);
+	/// A segment in BASE coordinates; colour 0xAARRGGBB; width in DISPLAY pixels.
+	void vectorLine(int layer, double x1, double y1, double x2, double y2, Uint32 argb, double width);
+	/// The surface the strokes lie on has just been blitted. For the rest of the frame
+	/// a stroke shows only where that surface's own pixels still do - so labels and
+	/// markers blitted after it, and any window opened over it, cover the lines.
+	void vectorFloor(const Surface *floor);
+
+	/// Was the HD layer running on the last frame? (enabled() only says it may.)
+	/// The globe asks this before it stops drawing 8-bit markers and labels.
+	bool active();
+
+	/// THE GLOBE AT DISPLAY RESOLUTION (fix list 12 Nov, items 6-8).
+	///
+	/// The 8-bit globe still draws, and still decides what is land, sea and
+	/// shadow for the game. Over it the earth is drawn again per DISPLAY pixel:
+	/// the orthographic projection inverted to lon/lat, the earth texture
+	/// sampled bilinearly, shaded by the same sun the 8-bit pass uses.
+	struct GlobeView
+	{
+		const Surface *globe = nullptr;     // the globe's own 8-bit surface
+		const Surface *texture = nullptr;   // GLOBE_EARTH (8-bit, index 0 = sea); its _hi twin is used if registered
+		double cenX = 0, cenY = 0, radius = 1;   // base coords, surface offset included
+		double cenLon = 0, cenLat = 0;
+		double sunX = 0, sunY = 0, sunZ = 1;
+		int ocean = 0; bool oceanShading = true;
+		std::vector<float> shade;           // continuous shadow 0..31 over t = 0..256, 4 steps per unit
+	};
+	void globeView(const GlobeView &v);
+	/// A label on the globe: centred on x, top at y, in base coords.
+	/// kind 0 country, 1 city, 2 Joe base, 3 the player's own mark.
+	struct GlobeLabel { std::string text; double x, y; int kind; };
+	void globeLabels(const std::vector<GlobeLabel> &labels);
+	/// A pin on the globe, in base coords. kind: see PinKind. lit: the blink phase.
+	enum PinKind { PIN_JOE_BASE, PIN_COBRA_SITE, PIN_MISSION, PIN_CONTACT, PIN_JOE_CRAFT, PIN_WAYPOINT, PIN_CITY };
+	struct GlobePin { double x, y; int kind; bool lit; };
+	void globePins(const std::vector<GlobePin> &pins);
+	/// An 8-bit marker frame to set on the globe crisp (the player's own marks).
+	struct GlobeArt { const Surface *frame; double x, y; };
+	void globeArt(const std::vector<GlobeArt> &art);
+	/// In Globe::blit, straight after the globe's own surface: paint the earth,
+	/// then the art, pins and labels, and take over the pixels they cover.
+	void globeFloor(const Surface *globe);
+	/// The globe screen is closing.
+	void globeForget(const Surface *globe);
+
+	/// A Text drawn in this colour (0xRRGGBB) instead of its role colour. 0 clears.
+	void textInk(const Surface *text, Uint32 rgb);
+	/// A Text kept in its own pixel font's sharp twin instead of the label face
+	/// (the geoscape clock: a 7-segment display, not type).
+	void pixelText(const Surface *text);
+	/// A Text set in this face ("label" or "stencil") whatever its size.
+	void textFace(const Surface *text, const std::string &face);
+
+	/// NATIVE SCREENS. A screen built at display resolution from scratch rather
+	/// than enlarged from 8 bits: the backdrop, its wells and keys are drawn as
+	/// shapes at the size they are shown, and registered text is set in a real
+	/// typeface (Resources/UI/type_<face>) instead of enlarged pixel letters.
+	/// The 8-bit screen underneath still runs the game; this only paints it.
+	///
+	/// A backdrop surface, painted as the console plate with a well cut for each
+	/// rect (base coords relative to the surface).
+	void nativeBackdrop(const Surface *bg, const std::vector<SDL_Rect> &wells);
+	/// A button drawn as a console key with this legend ("<", ">" and "->" are arrows).
+	/// inArt: the page's painting carries this key's body, so only its legend
+	/// is set on it. A key that is not in the painting is always drawn whole.
+	void nativeKey(const Surface *button, const std::string &legend, bool inArt = true);
+	/// A Text or TextEdit set in the label face.
+	void nativeText(const Surface *text);
+	/// A native key's look (UI standard): 0 steel, 1 the screen's one yellow main
+	/// action, 2 danger red, 3 dimmed (acted / unavailable), 4 olive (active toggle).
+	void nativeKeyStyle(const Surface *button, int style);
+	/// A picture (Resources/UI/<piece>.png) drawn on a native key above its legend (BATTLE_ICONS_BRIEF).
+	void nativeKeyIcon(const Surface *button, const std::string &piece);
+
+	/// THE BATTLE BAR (BATTLE_HUD_SPEC_v1). The bar and the mission panel are 8-bit
+	/// surfaces with nothing on them; everything they show is painted from this.
+	/// Clickable pieces stay ordinary widgets laid over it and drawn as native keys.
+	struct HudHand { std::string label, ammo, name; const Surface *art = nullptr; bool empty = true; };
+	struct HudData
+	{
+		bool on = false;
+		int contentX = 0;                      // left edge of the 320-wide block the bar's contents sit in
+		std::string sub;                       // specialty / rank line under the name
+		const Surface *figure = nullptr;       // the unit's inventory figure, for the portrait crop
+		int tu = 0, tuMax = 1, hp = 0, hpMax = 1, en = 0, enMax = 1, mo = 0, moMax = 100;
+		HudHand hand[2];                       // 0 right, 1 left
+		std::string sigTitle, sigName, sigHow; bool sigOn = false;
+		std::string turn, phase, objective, counts;
+	};
+	void nativeHud(const Surface *bar, const Surface *mission, const HudData &d);
+	/// A PANEL a screen paints itself at display resolution (the research tree). The painter
+	/// is called every frame right after the surface's own 8-bit blit, with the display
+	/// position of the surface's top-left and k = display px per base px; the surface's
+	/// base pixels then show what it painted. Paint:: draws, clipped to the panel.
+	using PanelPainter = std::function<void(double X0, double Y0, double k)>;
+	void nativePanel(const Surface *s, PanelPainter painter);
+	namespace Paint
+	{
+		void rect(double x0, double y0, double x1, double y1, Uint32 rgb, int alpha = 255);
+		void roundRect(double x0, double y0, double x1, double y1, double rad, Uint32 rgb, int alpha = 255);
+		/// An outline w display px thick, inside the rectangle.
+		void frame(double x0, double y0, double x1, double y1, double w, Uint32 rgb);
+		/// face "label" or "stencil"; halign/valign 0 start, 1 centre, 2 end; shrinks to fit across.
+		void text(const std::string &face, const std::string &s, double x0, double y0, double x1, double y1,
+			double capPx, int halign, int valign, Uint32 rgb);
+		/// A picture from the mod (path under the mod root), fitted into the box. progress 0..1
+		/// pixelates and desaturates it (RESEARCH_TREE_SCREEN_SPEC 1b); 1 or more = clean.
+		/// Returns false if the file is missing.
+		bool picture(const std::string &file, double x0, double y0, double x1, double y1, double progress);
+		/// An art piece (path under the mod root) with its own transparency, scaled into the box
+		/// (cached per size). alpha scales its opacity. Returns false if the file is missing.
+		bool image(const std::string &file, double x0, double y0, double x1, double y1, int alpha = 255);
+	}
+	/// The screen is closing: forget everything it registered.
+	void nativeForget(const Surface *s);
+	/// A surface is being destroyed: drop anything keyed by its address (Surface::~Surface).
+	void surfaceGone(const Surface *s);
+	/// Is a native screen up? (Its 8-bit grid, labels and numbers are then not drawn.)
+	bool nativeOn();
+
+	/// THE BASE PLAN, drawn from what it shows rather than from its 8-bit frames.
+	/// Positions are in grid squares; the view maps them.
+	enum RoomKind { ROOM_GENERIC, ROOM_HANGAR, ROOM_LIFT, ROOM_LAB, ROOM_WORKSHOP, ROOM_QUARTERS,
+		ROOM_STORES, ROOM_DEFENCE, ROOM_RADAR, ROOM_PSI, ROOM_PRISON };
+	/// frames: the facility's BASEBITS frames, one per square in BaseView's order. When every
+	/// one has a sharp twin (<frame>_hi.png - the stocked room) that is drawn instead of the shell.
+	struct Room { int x, y, w, h; std::string name; int kind; int buildDays; bool disabled, hadPrevious; int ammo, ammoMax; std::vector<const Surface*> frames; };
+	struct Docked { const Surface *frame; int x, y; };   // a craft sprite and where the view put it (view px)
+	/// After BaseView has blitted. Paints the whole plan over it.
+	void nativeBaseView(const Surface *view, int gridPx, const std::vector<Room> &rooms,
+		const std::vector<std::pair<int, int> > &linksRight, const std::vector<std::pair<int, int> > &linksDown,
+		const std::vector<Docked> &craft);
+	/// The placement selector, after it has blitted (only while it shows).
+	void nativeSelector(const Surface *selector);
+	/// One slot of the base strip: its facilities in grid squares, state 0 built 1 building 2 off.
+	struct MiniBase { bool exists, selected; std::vector<std::pair<SDL_Rect, int> > rooms; };
+	void nativeMiniBases(const Surface *mini, int slotPx, const std::vector<MiniBase> &bases);
+}
+}
