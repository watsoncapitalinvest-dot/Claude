 #include "../resource.h"
 #include <algorithm>
 #include <sstream>
@@ -188,6 +191,19 @@ void Screen::handle(Action *action)
  * of the buffer are resized by that factor (eg. 2 = doubled)
  * before being put on screen.
  */
+int Screen::hiRes()
+{
+	static int h = -1;
+	if (h < 0)
+	{
+		const char *e = getenv("OXCE_MAP_HIRES");
+		h = e ? atoi(e) : 1;
+		if (h < 1 || h > 8) h = 1;
+	}
