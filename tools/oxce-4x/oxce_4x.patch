+/**
+ * G.I. JOE BATTLE BAR (BATTLE_HUD_SPEC_v1, approved 12 Nov).
+ *
+ * The bar is 42 base px (the interface's "icons" height); positions below are the
+ * spec's, with the bar's top at 0. Everything is PAINTED by HiUI from refreshJoeHud's
+ * data; the widgets here are only where clicks land, each drawn as a native key.
+ * Stock buttons the spec has no place for are kept 1 px big in the corner so their
+ * keyboard shortcuts still work.
+ */
+void BattlescapeState::layoutJoeHud()
+{
+	_joeHud = true;
+	const int ox = _icons->getX(), oy = _icons->getY();
+	auto place = [&](Surface *s, int x, int y, int w, int h)
+	{
+		// the bar fills the screen's width (HiUI::hudStretchX); 1 px tucked keys stay where they are
+		const int x0 = (w > 1) ? (int)std::lround(HiUI::hudStretchX(x, ox)) : x;
+		const int x1 = (w > 1) ? (int)std::lround(HiUI::hudStretchX(x + w, ox)) : x + w;
+		s->setX(ox + x0); s->setY(oy + y);
+		s->setWidth(std::max(1, x1 - x0)); s->setHeight(h);
+		// a button's pressed picture was cut from the stock bar at its old size: cut it again (blank)
+		if (auto *bb = dynamic_cast<BattlescapeButton*>(s)) { bb->clear(); bb->initSurfaces(); }
+	};
+	auto tuck = [&](Surface *s) { place(s, 0, 0, 1, 1); };
+	auto key = [&](Surface *s, const std::string &legend) { HiUI::nativeKey(s, legend, false); };
+
+	// HUD v2: the old action grid's buttons move into the MENU; they stay 1 px big so their shortcuts still work
+	BattlescapeButton *grid[8] = { _btnMapUp, _btnMapDown, _btnKneel, _btnCenter, _btnNextSoldier, _btnShowMap, _btnInventory, _btnHelp };
+	for (int i = 0; i < 8; ++i) tuck(grid[i]);
+	// reserve time (196,26 30x13): the label, then the four toggles 2 x 2
+	BattlescapeButton *res[4] = { _btnReserveNone, _btnReserveSnap, _btnReserveAimed, _btnReserveAuto };
+	const char *resLegend[4] = { "NONE", "SNAP", "AIM", "AUTO" };
+	for (int i = 0; i < 4; ++i)
+	{
+		place(res[i], 196 + (i % 2) * 15, 30 + (i / 2) * 4, 14, 4);
+		key(res[i], resLegend[i]);
+	}
+	place(_btnEndTurn, 262, 11, 54, 28);
+	key(_btnEndTurn, "END TURN");
+	HiUI::nativeKeyStyle(_btnEndTurn, 1);
+	place(_btnStats, 36, 11, 54, 8);
+	_txtName->setX(ox + 36); _txtName->setY(oy + 11); _txtName->setWidth(54); _txtName->setHeight(8);
+	// John 18 Nov 01:34 "fix the amount of characters listed": the squad strip now runs the bar's whole width, so the
+	// tooltip moves up off the bar, just above its right end
+	_txtTooltip->setX(ox + 184); _txtTooltip->setY(oy - 9); _txtTooltip->setWidth(132); _txtTooltip->setHeight(8);
+	_txtTooltip->setAlign(ALIGN_RIGHT);
+
+	// no place on the bar: shortcuts only
+	for (Surface *s : { (Surface*)_btnUnitUp, (Surface*)_btnUnitDown, (Surface*)_btnNextStop, (Surface*)_btnShowLayers,
+		(Surface*)_btnAbort, (Surface*)_btnZeroTUs, (Surface*)_btnReserveKneel, (Surface*)_btnLeftHandItem, (Surface*)_btnRightHandItem })
+		tuck(s);
+	// The stock pieces painted instead are parked off the screen: updateSoldierInfo
+	// turns their visibility back on, so hiding alone let them flash through.
+	for (Surface *s : { (Surface*)_rank, (Surface*)_rankTiny, (Surface*)_numLayers, (Surface*)_numTimeUnits, (Surface*)_numEnergy,
+		(Surface*)_numHealth, (Surface*)_numMorale, (Surface*)_barTimeUnits, (Surface*)_barEnergy, (Surface*)_barHealth,
+		(Surface*)_barMorale, (Surface*)_numTwoHandedIndicatorLeft, (Surface*)_numTwoHandedIndicatorRight })
+		{ s->setX(-400); s->setY(-400); }
+	if (_barMana) { _barMana->setX(-400); _barMana->setY(-400); }
+	for (auto *v : { &_numAmmoLeft, &_numAmmoRight, &_numMedikitLeft, &_numMedikitRight })
+		for (auto *n : *v) { n->setX(-400); n->setY(-400); }
+
+	// NEW PIECES
+	for (int i = 0; i < 16; ++i)
+	{
+		_hudChip[i] = new InteractiveSurface(25, 6, ox + 26 + 26 * (i % 6), oy + 2);
+		add(_hudChip[i]);
+		_hudChip[i]->onMouseClick((ActionHandler)&BattlescapeState::hudChipClick);
+	}
+	for (int i = 0; i < 2; ++i)
+	{
+		_hudScroll[i] = new InteractiveSurface(7, 6, ox + (i == 0 ? 26 : 174), oy + 2);
+		add(_hudScroll[i]);
+		_hudScroll[i]->onMouseClick((ActionHandler)&BattlescapeState::hudScrollClick);
+		HiUI::nativeKey(_hudScroll[i], i == 0 ? "<" : ">", false);
+		_hudScroll[i]->setVisible(false);
+	}
+	for (int hnd = 0; hnd < 2; ++hnd)
+	{
+		const int cx = hnd == 0 ? 94 : 145;
+		// the card's own click area stops above its SNAP / AIMED / AUTO keys (y 21): it lay under them, so one click
+		// armed the shot AND opened the full shot menu (John 17 Nov 15:45)
+		_hudCard[hnd] = new InteractiveSurface(47, 10, ox + cx, oy + 10);
+		add(_hudCard[hnd]);
+		_hudCard[hnd]->onMouseClick((ActionHandler)&BattlescapeState::hudCardClick, 0);
+		for (int m = 0; m < 3; ++m)
+		{
+			_hudMode[hnd][m] = new InteractiveSurface(14, 8, ox + cx + 1 + m * 15, oy + 21);
+			add(_hudMode[hnd][m]);
+			_hudMode[hnd][m]->onMouseClick((ActionHandler)&BattlescapeState::hudModeClick);
+		}
+		// HUD v2: THROW, STRIKE, RELOAD, SWAP along the card's foot, each lit only if possible
+		for (int j = 0; j < 4; ++j)
+		{
+			_hudFoot[hnd][j] = new InteractiveSurface(11, 8, ox + cx + 1 + (int)(j * 11.5), oy + 30);
+			add(_hudFoot[hnd][j]);
+			_hudFoot[hnd][j]->onMouseClick((ActionHandler)&BattlescapeState::hudFootClick);
+		}
+	}
+	// HUD v2: the eight choice buttons (196,10, 4 x 2 of 15 x 7) and the list they open over the hand cards
+	for (int i = 0; i < 8; ++i)
+	{
+		_hudChoice[i] = new InteractiveSurface(15, 7, ox + 196 + (i % 4) * 16, oy + 10 + (i / 4) * 8);
+		add(_hudChoice[i]);
+		_hudChoice[i]->onMouseClick((ActionHandler)&BattlescapeState::hudGroupClick);
+	}
+	for (int i = 0; i < 6; ++i)
+	{
+		_hudList[i] = new InteractiveSurface(47, 8, ox + 94 + (i % 2) * 51, oy + 15 + (i / 2) * 8);
+		add(_hudList[i]);
+		_hudList[i]->onMouseClick((ActionHandler)&BattlescapeState::hudListClick);
+		_hudList[i]->setVisible(false);
+	}
+	_hudListPage = new InteractiveSurface(12, 5, ox + 180, oy + 10);
+	add(_hudListPage);
+	_hudListPage->onMouseClick((ActionHandler)&BattlescapeState::hudListClick);
+	_hudListPage->setVisible(false);
+	// the MENU button, first in the squad strip, and the MENU it opens up the left edge (14 x 28 x 8, 1 px apart)
+	_hudMenuBtn = new InteractiveSurface(20, 6, ox + 4, oy + 2);
+	add(_hudMenuBtn);
+	_hudMenuBtn->onMouseClick((ActionHandler)&BattlescapeState::hudMenuBtnClick);
+	HiUI::nativeKey(_hudMenuBtn, "MENU", false);
+	for (int i = 0; i < 16; ++i)
+	{
+		// John (STEALTH_SIGHT item 8): "that left menu needs to be bigger and more legible" - 44 x 11 keys 12 apart (were 28 x 8, 9 apart)
+		const int step = std::max(9, std::min(12, (oy - 6) / 16));   // as big as the room above the HUD allows, 12 at most
+		_hudMenu[i] = new InteractiveSurface(44, step - 1, 0, oy - 4 - step * 16 + step * i);
+		add(_hudMenu[i]);
+		_hudMenu[i]->onMouseClick((ActionHandler)&BattlescapeState::hudMenuClick);
+		_hudMenu[i]->onMouseIn((ActionHandler)&BattlescapeState::hudOverIn);
+		_hudMenu[i]->onMouseOut((ActionHandler)&BattlescapeState::hudOverOut);
+		_hudMenu[i]->setVisible(false);
+	}
+	_hudSig = new InteractiveSurface(30, 13, ox + 228, oy + 26);
+	add(_hudSig);
+	_hudSig->onMouseClick((ActionHandler)&BattlescapeState::hudSigClick);
+	_hudPortrait = new InteractiveSurface(28, 28, ox + 4, oy + 11);
+	add(_hudPortrait);
+	_hudPortrait->onMouseClick((ActionHandler)&BattlescapeState::btnInventoryClick);
+
+	// the mission panel, top right; the special-action buttons move down under it
+	const int screenWidth = Options::baseXResolution;
+	_hudMission = new Surface(76, 27, screenWidth - 80, 4);   // HUD v2: + the ALARM line
+	add(_hudMission);
+	_hudMission->drawRect(0, 0, 76, 27, 15);
+	for (Surface *s : { (Surface*)_btnLaunch, (Surface*)_btnPsi, (Surface*)_btnSpecial, (Surface*)_btnSkills })
+		if (s) s->setY(s->getY() + 28);
+	// the warning strip sat at the stock bar's y+32, which is below the 42 px Joe bar and off the
+	// bottom of the screen (John's F12 shots, 15 Nov): put it just above the bar, centred
+	_warning->setX((screenWidth - _warning->getWidth()) / 2);
+	_warning->setY(oy - _warning->getHeight() - 2);
+	// THE BAR FILLS THE WIDTH (John 17 Nov 15:30): every piece created above on the 320-wide design is moved and
+	// stretched by HiUI::hudStretchX, the same mapping the painting uses (place() already did this for its pieces)
+	{
+		std::vector<Surface*> v = { _txtName, _txtTooltip, _hudListPage, _hudMenuBtn, _hudSig, _hudPortrait };
+		for (auto *c : _hudChip) v.push_back(c);
+		for (auto *c : _hudScroll) v.push_back(c);
+		for (auto *c : _hudCard) v.push_back(c);
+		for (auto &row : _hudMode) for (auto *c : row) v.push_back(c);
+		for (auto &row : _hudFoot) for (auto *c : row) v.push_back(c);
+		for (auto *c : _hudChoice) v.push_back(c);
+		for (auto *c : _hudList) v.push_back(c);
+		for (auto *c : v)
+		{
+			if (!c) continue;
+			const int rx = c->getX() - ox, rw = c->getWidth();
+			const int x0 = (int)std::lround(HiUI::hudStretchX(rx, ox)), x1 = (int)std::lround(HiUI::hudStretchX(rx + rw, ox));
+			c->setX(ox + x0);
+			if (x1 - x0 != rw) c->setWidth(std::max(1, x1 - x0));
+		}
+	}
+	// the bar itself runs the full width; its contents keep their design coordinates (contentX) for the mapping
+	_hudContentX = ox;
+	_icons->setX(0);
+	_icons->setWidth(screenWidth);
+
+	refreshJoeHud();
+}
+
+/**
+ * The bar's contents for this frame: who is selected, what they hold, the squad, the turn.
+ */
+void BattlescapeState::refreshJoeHud()
+{
+	if (!_joeHud || !_hudMission) return;
+	for (Surface *s : { (Surface*)_rank, (Surface*)_rankTiny, (Surface*)_numLayers, (Surface*)_numTimeUnits, (Surface*)_numEnergy,
+		(Surface*)_numHealth, (Surface*)_numMorale, (Surface*)_barTimeUnits, (Surface*)_barEnergy, (Surface*)_barHealth,
+		(Surface*)_barMorale, (Surface*)_numTwoHandedIndicatorLeft, (Surface*)_numTwoHandedIndicatorRight,
+		(Surface*)_btnLeftHandItem, (Surface*)_btnRightHandItem })
+		s->setVisible(false);
+	if (_barMana) _barMana->setVisible(false);
+	for (auto *n : _numAmmoLeft) n->setVisible(false);
+	for (auto *n : _numAmmoRight) n->setVisible(false);
+	for (auto *n : _numMedikitLeft) n->setVisible(false);
+	for (auto *n : _numMedikitRight) n->setVisible(false);
+	HiUI::HudData d;
+	d.on = true;
+	d.contentX = _hudContentX;
+	BattleUnit *u = _save->getSelectedUnit();
+	const bool ours = u && u->getFaction() == FACTION_PLAYER;
+	if (ours)
+	{
+		d.sub = tr(u->getRankString());
+		if (u->getGeoscapeSoldier())
+		{
+			const std::string look = u->getArmor()->getSpriteInventory();
+			d.figure = _game->getMod()->getSurface(look, false);
+			if (!d.figure) d.figure = _game->getMod()->getSurface(look + ".SPK", false);
+		}
+		else if (u->getUnitRules())
+		{
+			// a vehicle: the item it is carried as, and that item's picture
+			static std::map<std::string, int> bigOf;   // by unit type: survives a mod reload
+			if (bigOf.empty())
+				for (auto &it : _game->getMod()->getItemsList())
+				{
+					const RuleItem *r = _game->getMod()->getItem(it);
+					if (r && r->getVehicleUnit() && !bigOf.count(r->getVehicleUnit()->getType())) bigOf[r->getVehicleUnit()->getType()] = r->getBigSprite();
+				}
+			auto f = bigOf.find(u->getUnitRules()->getType());
+			SurfaceSet *bigobs = _game->getMod()->getSurfaceSet("BIGOBS.PCK");
+			if (f != bigOf.end() && f->second >= 0 && bigobs) d.vehicleArt = bigobs->getFrame(f->second);
+		}
+		d.tu = u->getTimeUnits(); d.tuMax = std::max(1, (int)u->getBaseStats()->tu);
+		d.hp = u->getHealth(); d.hpMax = std::max(1, (int)u->getBaseStats()->health);
+		d.en = u->getEnergy(); d.enMax = std::max(1, (int)u->getBaseStats()->stamina);
+		d.mo = u->getMorale(); d.moMax = 100;
+	}
+	// the hands, and the fire-mode keys under each
+	BattleAction *cur = _battleGame->getCurrentAction();
+	for (int hnd = 0; hnd < 2; ++hnd)
+	{
+		HiUI::HudHand &h = d.hand[hnd];
+		h.label = hnd == 0 ? "RIGHT HAND" : "LEFT HAND";
+		BattleItem *item = ours ? (hnd == 0 ? u->getRightHandWeapon() : u->getLeftHandWeapon()) : nullptr;
+		int m = 0;
+		if (item)
+		{
+			const RuleItem *r = item->getRules();
+			h.empty = false;
+			h.name = tr(r->getName());
+			if (r->getBattleType() == BT_FIREARM)
+			{
+				const BattleItem *ammo = item->getAmmoForSlot(0);
+				if (ammo) h.ammo = std::to_string(ammo->getAmmoQuantity()) + "/" + std::to_string(std::max(1, ammo->getRules()->getClipSize()));
+				else h.ammo = "EMPTY";
+			}
+			if (SurfaceSet *big = _game->getMod()->getSurfaceSet("BIGOBS.PCK", false))
+				h.art = big->getFrame(r->getBigSprite());
+			struct ModeDef { BattleActionType t; const char *name; bool ok; };
+			const ModeDef defs[] = {
+				{ BA_SNAPSHOT, "SNAP", r->getBattleType() == BT_FIREARM && r->getCostSnap().Time > 0 },
+				{ BA_AIMEDSHOT, "AIMED", r->getBattleType() == BT_FIREARM && r->getCostAimed().Time > 0 },
+				{ BA_AUTOSHOT, "AUTO", r->getBattleType() == BT_FIREARM && r->getCostAuto().Time > 0 },
+				{ BA_HIT, "STRIKE", r->getCostMelee().Time > 0 },
+				{ BA_THROW, "THROW", r->getBattleType() == BT_GRENADE || r->getBattleType() == BT_PROXIMITYGRENADE },
+			};
+			for (const auto &md : defs)
+			{
+				if (!md.ok || m >= 3) continue;
+				BattleActionCost cost(md.t, u, item);
+				_hudModeType[hnd][m] = md.t;
+				HiUI::nativeKey(_hudMode[hnd][m], std::string(md.name) + " " + std::to_string(cost.Time), false);
+				const bool armed = cur && cur->targeting && cur->weapon == item && cur->type == md.t;
+				const bool can = cost.Time <= u->getTimeUnits();
+				HiUI::nativeKeyStyle(_hudMode[hnd][m], armed ? 1 : can ? 0 : 3);
+				_hudMode[hnd][m]->setVisible(true);
+				++m;
+			}
+		}
+		for (; m < 3; ++m) _hudMode[hnd][m]->setVisible(false);
+		_hudCard[hnd]->setVisible(ours);
+	}
+	_hudPortrait->setVisible(ours);
+
+	// HUD v2 (BATTLE_HUD_SPEC_v2). A vehicle shows ONE armed weapon (the right hand) across both cards. Eight choice
+	// buttons: the five weapon groups (vehicles), SPECIALS, ORDERS, ACTIONS; an open one lays its choices out where
+	// the hand cards are, 6 a page, greyed with the reason when they can't be used now.
+	{
+		static const char *GROUPS[5] = { "GUNS", "MISSILES", "ARTY", "DROPS", "SP. ROUNDS" };
+		static const char *KEYS[8] = { "GUNS", "MISSL", "ARTY", "DROPS", "SP.RD", "SPECL", "ORDER", "ACTN" };
+		static const char *TITLES[8] = { "GUNS", "MISSILES", "ARTY", "DROPS", "SP. ROUNDS", "SPECIALS", "ORDERS", "ACTIONS" };
+		std::vector<HudEntry> lists[8];
+		if (ours)
+		{
+			for (auto *it : *u->getInventory())
+				if (it->getRules()->getBattleType() == BT_FIREARM)
+					for (int g = 0; g < 5; ++g)
+						if (it->getRules()->getGjaGroup() == GROUPS[g])
+						{
+							HudEntry e; e.kind = HE_ARM; e.item = it;
+							const BattleItem *am = it->getAmmoForSlot(0);
+							const int left = am ? am->getAmmoQuantity() : 0;
+							e.label = std::string(tr(it->getRules()->getName())) + "  " + std::to_string(left);
+							e.usable = left > 0; e.why = "EMPTY";
+							lists[g].push_back(e);
+						}
+			// SPECIALS (BUILD-2 specials, VehicleSpecials.cpp): what this unit's type carries, greyed with the reason
+			for (const auto &s : VehicleSpecials::list(_save, u))
+			{ HudEntry e; e.kind = HE_SPECIAL; e.label = s.label; e.usable = s.usable; e.why = s.why; e.id = s.id; lists[5].push_back(e); }
+			// ORDERS: what exists today. The civilian orders (BRIEF_FOR_BUILD_CivilianOrders) are not built yet.
+			{ HudEntry e; e.kind = HE_ABORT; e.label = _battleGame->searchingSecuredSite() ? "END MISSION" : "ABORT MISSION"; lists[6].push_back(e); }
+			// ACTIONS: only what this man can do right now is lit
+			if (u->getGeoscapeSoldier())
+			{
+				{ HudEntry e; e.kind = HE_CUFF; e.label = "CUFF"; e.usable = cuffTarget(u) != nullptr; e.why = "NOBODY TO CUFF"; lists[7].push_back(e); }
+				{ HudEntry e; e.kind = HE_RELOAD; e.label = "RELOAD"; lists[7].push_back(e); }
+				// STEALTH SIGHT items 8 and 12 (John 21:13 "def put in all the new stealth stuff")
+				{ HudEntry e; e.kind = HE_DISTRACT; e.label = "THROW DISTRACTION"; e.usable = u->getTimeUnits() >= 15; e.why = "15 TU"; lists[7].push_back(e); }
+				{ HudEntry e; e.kind = HE_CONCEAL; e.label = "CONCEAL BODY"; e.usable = concealTarget(u) != nullptr && u->getTimeUnits() >= u->getBaseStats()->tu / 2;
+				  e.why = concealTarget(u) ? "HALF A TURN'S TU" : "NO BODY BESIDE HIM"; lists[7].push_back(e); }
+				for (BattleItem *h : { u->getRightHandWeapon(), u->getLeftHandWeapon() })
+				{
+					if (!h) continue;
+					if (h->getRules()->getType() == Mod::sabotageCharge)
+					{ HudEntry e; e.kind = HE_PRIME; e.item = h; e.label = "PLANT CHARGE"; e.usable = h->getFuseTimer() < 0; e.why = "ALREADY SET"; lists[7].push_back(e); }
+					if (h->getRules()->getBattleType() == BT_MEDIKIT)
+					{ HudEntry e; e.kind = HE_MEDIKIT; e.item = h; e.label = "MEDKIT"; lists[7].push_back(e); }
+				}
+			}
+		}
+		bool anyGun = false;
+		for (int g = 0; g < 5; ++g) if (!lists[g].empty()) anyGun = true;
+		_hudVehicle = ours && anyGun && !u->getGeoscapeSoldier();
+		for (int g = 0; g < 8; ++g)
+		{
+			_hudChoice[g]->setVisible(ours);
+			HiUI::nativeKey(_hudChoice[g], KEYS[g], false);
+			HiUI::nativeKeyStyle(_hudChoice[g], lists[g].empty() ? 3 : g == _hudOpenGroup ? 1 : 0);
+		}
+		if (!ours || _hudOpenGroup < 0 || _hudOpenGroup >= 8 || lists[_hudOpenGroup].empty()) _hudOpenGroup = -1;
+		const bool open = _hudOpenGroup >= 0;
+		d.vehicle = _hudVehicle;
+		d.listOpen = open;
+		if (_hudVehicle)
+		{
+			d.hand[0].label = "ARMED WEAPON";
+			if (BattleItem *a = u->getRightHandWeapon())
+				for (int g = 0; g < 5; ++g) if (a->getRules()->getGjaGroup() == GROUPS[g]) d.hand[0].label += std::string(" - ") + GROUPS[g];
+		}
+		// cards hidden under an open list, or the second card of a vehicle
+		for (int hnd = 0; hnd < 2; ++hnd)
+		{
+			const bool hide = open || (_hudVehicle && hnd == 1);
+			if (hide)
+			{
+				_hudCard[hnd]->setVisible(false);
+				for (int mm = 0; mm < 3; ++mm) _hudMode[hnd][mm]->setVisible(false);
+			}
+			// a vehicle's modes sit lower (no foot buttons on a vehicle card)
+			for (int mm = 0; mm < 3; ++mm) _hudMode[hnd][mm]->setY(_icons->getY() + (_hudVehicle ? 30 : 21));
+			// the foot buttons: THROW, STRIKE, RELOAD, SWAP
+			BattleItem *item = ours ? (hnd == 0 ? u->getRightHandWeapon() : u->getLeftHandWeapon()) : nullptr;
+			const RuleItem *r = item ? item->getRules() : nullptr;
+			const bool can[4] = {
+				r && !r->isFixed() && (r->getBattleType() == BT_GRENADE || r->getBattleType() == BT_PROXIMITYGRENADE || r->getCostThrow().Time > 0),
+				r && r->getCostMelee().Time > 0,
+				r && r->getBattleType() == BT_FIREARM && !r->isFixed(),
+				ours && !_hudVehicle && (u->getRightHandWeapon() || u->getLeftHandWeapon()) };
+			static const char *FOOT[4] = { "THROW", "STRIKE", "RELOAD", "SWAP" };
+			for (int j = 0; j < 4; ++j)
+			{
+				const bool show = ours && !hide && !_hudVehicle;
+				_hudFoot[hnd][j]->setVisible(show);
+				if (!show) continue;
+				HiUI::nativeKey(_hudFoot[hnd][j], FOOT[j], false);
+				HiUI::nativeKeyStyle(_hudFoot[hnd][j], can[j] ? 0 : 3);
+			}
+		}
+		if (open)
+		{
+			_hudEntries = lists[_hudOpenGroup];
+			const int n = (int)_hudEntries.size();
+			if (_hudListFirst >= n) _hudListFirst = 0;
+			_hudListFirst -= _hudListFirst % 6;
+			d.listTitle = std::string(TITLES[_hudOpenGroup]) + " - " + std::to_string(n) + (n > 6 ? "  (page " + std::to_string(_hudListFirst / 6 + 1) + ")" : "");
+			for (int i = 0; i < 6; ++i)
+			{
+				const int k = _hudListFirst + i;
+				_hudList[i]->setVisible(k < n);
+				if (k >= n) continue;
+				const HudEntry &e = _hudEntries[k];
+				HiUI::nativeKey(_hudList[i], e.usable ? e.label : e.label + " - " + e.why, false);
+				const bool armed = e.kind == HE_ARM && e.item == u->getRightHandWeapon();
+				HiUI::nativeKeyStyle(_hudList[i], armed ? 1 : e.usable ? 0 : 3);
+			}
+			_hudListPage->setVisible(n > 6);
+			if (n > 6) HiUI::nativeKey(_hudListPage, ">", false);
+		}
+		else
+		{
+			_hudEntries.clear();
+			for (auto *s : _hudList) s->setVisible(false);
+			_hudListPage->setVisible(false);
+		}
+		// the MENU
+		static const char *MENU[16] = { "WALK", "KNEEL", "PRONE", "GROUND", "OVERWATCH", "DOORS", "LEVEL UP", "LEVEL DOWN", "CENTRE", "NEXT MAN", "MAP", "GEAR", "STATS", "OPTIONS", "DISTRACT", "HIDE BODY" };
+		static const char *WALKS[3] = { "WALK", "RUN", "SNEAK" };
+		// the left menu reads as words (John: "bigger and more legible"); the icons were unreadable at this size
+		static const char *ICON[16] = { "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "" };
+		if (getenv("OXCE_HUD_MENU_OPEN")) _hudMenuOpen = true;   // RIG: screenshots of the left menu
+		HiUI::nativeKeyStyle(_hudMenuBtn, _hudMenuOpen ? 1 : 0);
+		for (int i = 0; i < 16; ++i)
+		{
+			_hudMenu[i]->setVisible(_hudMenuOpen);
+			if (!_hudMenuOpen) continue;
+			HiUI::nativeKey(_hudMenu[i], i == 0 ? WALKS[_hudWalkMode] : MENU[i], false);
+			if (ICON[i][0]) HiUI::nativeKeyIcon(_hudMenu[i], std::string("battle_icons/") + ICON[i]);
+			// PRONE, GO TO GROUND, OVERWATCH, DOORS are not built yet: shown, greyed
+			const bool built = !(i >= 2 && i <= 5);
+			HiUI::nativeKeyStyle(_hudMenu[i], !built ? 3 : (i == 1 && ours && u->isKneeled()) ? 4 : 0);
+		}
+	}
+
+	// reserve: the active toggle is olive
+	BattlescapeButton *res[4] = { _btnReserveNone, _btnReserveSnap, _btnReserveAimed, _btnReserveAuto };
+	for (auto *b : res) HiUI::nativeKeyStyle(b, b == _reserve ? 4 : 0);
+	HiUI::nativeKeyStyle(_btnKneel, ours && u->isKneeled() ? 4 : 0);
+
+	// the squad strip: up to six, the window following the selected Joe
+	std::vector<BattleUnit*> squad;
+	int canAct = 0;
+	for (auto *bu : *_save->getUnits())
+	{
+		if (bu->getOriginalFaction() != FACTION_PLAYER || bu->getStatus() == STATUS_IGNORE_ME) continue;
+		if (bu->getStatus() == STATUS_DEAD && !bu->getGeoscapeSoldier()) continue;
+		squad.push_back(bu);
+		if (!bu->isOut() && bu->getTimeUnits() > 0 && bu->getFaction() == FACTION_PLAYER) ++canAct;
+	}
+	// THE WINDOW (John 18 Nov 01:34 "fix the amount of characters listed on the hud bar"). The strip runs from after
+	// MENU to the bar's right end (design x 26..316, stretched like the rest of the bar), so up to 16 Joes show at
+	// once; the chips narrow to fit the squad. Past 16, two scroll keys take the ends and the window follows the
+	// selected Joe, otherwise staying where the player scrolled it.
+	const int n = (int)squad.size();
+	const int MAXC = 16;
+	const bool scroll = n > MAXC;
+	const int K = std::max(1, std::min(n, MAXC));
+	_hudChips = K;
+	if (u != _hudLastSel)
+	{
+		_hudLastSel = u;
+		for (int i = 0; i < n; ++i)
+			if (squad[i] == u)
+			{
+				if (i < _hudFirst) _hudFirst = i;
+				if (i >= _hudFirst + K) _hudFirst = i - K + 1;
+			}
+	}
+	_hudFirst = scroll ? std::max(0, std::min(_hudFirst, n - K)) : 0;
+	{
+		const int ox = _hudContentX, oy = _icons->getY();
+		const double x0 = scroll ? 34.0 : 26.0, x1 = scroll ? 308.0 : 316.0;
+		const double pitch = std::min(26.0, (x1 - x0) / K);
+		auto at = [&](double dx) { return ox + (int)std::lround(HiUI::hudStretchX(dx, ox)); };
+		for (int i = 0; i < MAXC; ++i)
+		{
+			const double a = x0 + pitch * i, b = a + pitch - 1;
+			_hudChip[i]->setX(at(a));
+			_hudChip[i]->setWidth(std::max(4, at(b) - at(a)));
+			_hudChip[i]->setY(oy + 2);
+		}
+		for (int i = 0; i < 2; ++i)
+		{
+			_hudScroll[i]->setX(at(i == 0 ? 26 : 309));
+			_hudScroll[i]->setVisible(scroll);
+			const bool can = i == 0 ? _hudFirst > 0 : _hudFirst + K < n;
+			HiUI::nativeKeyStyle(_hudScroll[i], can ? 0 : 3);
+		}
+	}
+	for (int i = 0; i < MAXC; ++i)
+	{
+		const int si = _hudFirst + i;
+		_hudChipUnit[i] = (i < K && si < n) ? squad[si] : nullptr;
+		_hudChip[i]->setVisible(_hudChipUnit[i] != nullptr);
+		if (!_hudChipUnit[i]) continue;
+		BattleUnit *bu = _hudChipUnit[i];
+		std::string nm = bu->getName(_game->getLanguage());
+		// a vehicle's "(guns)" / "(rockets)" goes first, so "VAMP Mk II (rockets)" reads "VAMP Mk II", not "(rockets)"
+		const auto par = nm.find(" (");
+		if (par != std::string::npos && nm.size() > 12) nm = nm.substr(0, par);
+		const auto sp = nm.find_last_of(' ');
+		if (sp != std::string::npos && nm.size() > 12) nm = nm.substr(sp + 1);
+		// CHIP STATES. Down (out of the fight) and captured (a Joe the enemy now
+		// controls) are marked red; a Joe with no time left this turn is dimmed
+		// and marked DONE; the selected Joe is the yellow one.
+		const bool down = bu->isOut();
+		const bool captured = !down && bu->getFaction() != FACTION_PLAYER;
+		const bool acted = !down && !captured && bu->getTimeUnits() == 0;
+		std::string legend = nm;
+		if (down) legend += " - DOWN";
+		else if (captured) legend += " - CAPTURED";
+		else if (acted) legend += " - DONE";
+		HiUI::nativeKey(_hudChip[i], legend, false);
+		HiUI::nativeKeyStyle(_hudChip[i], bu == u ? 1 : (down || captured) ? 2 : acted ? 3 : 0);
+	}
+	if (_battleGame->searchingSecuredSite())
+		HiUI::nativeKey(_btnEndTurn, "END MISSION|Area secure: search, then leave", false);
+	else
+		HiUI::nativeKey(_btnEndTurn, "END TURN|" + std::to_string(canAct) + (canAct == 1 ? " Joe can still act" : " Joes can still act"), false);
+
+	// signature move: no specials system yet. The slot is the CUFF key when the selected Joe
+	// stands next to a Cobra man with his hands up (capture, John 13 Nov 2026).
+	d.sigOn = false;
+	d.sigTitle = "SIGNATURE MOVE";
+	d.sigName = "NONE";
+	d.sigHow = "Comes with the specials system";
+	if (ours)
+	{
+		if (BattleUnit *t = cuffTarget(u))
+		{
+			const int cost = _game->getMod()->getCuffTU();
+			d.sigOn = u->getTimeUnits() >= cost;
+			d.sigTitle = "PRISONER";
+			d.sigName = "CUFF HIM";
+			d.sigHow = d.sigOn ? std::to_string(cost) + " TU" : "Not enough time";
+			(void)t;
+		}
+	}
+
+	// the mission panel
+	int seen = 0, civ = 0;
+	bool cartel = false;   // G.I. Joe (Day 1 ranch brief): nothing on a cartel job says Cobra
+	for (auto *bu : *_save->getUnits())
+	{
+		if (bu->getOriginalFaction() == FACTION_HOSTILE && bu->getUnitRules() && bu->getUnitRules()->getRace() == "STR_CARTEL") cartel = true;
+		if (bu->isOut()) continue;
+		if (bu->getFaction() == FACTION_HOSTILE && bu->getVisible()) ++seen;
+		if (bu->getOriginalFaction() == FACTION_NEUTRAL) ++civ;
+	}
+	d.turn = "TURN " + std::to_string(_save->getTurn());
+	d.phase = _save->getSide() == FACTION_PLAYER ? "JOE TURN" : cartel ? "CARTEL TURN" : "COBRA TURN";
+	d.objective = tr(_save->getMissionType());
+	d.counts = std::string(cartel ? "Cartel seen: " : "Cobra seen: ") + std::to_string(seen) + "  -  Civilians: " + std::to_string(civ);
+	// HUD v2 s.3: the ALARM line - QUIET / SUSPICIOUS / ALARM, and once raised what is coming
+	{
+		SavedBattleGame *sb = _save;
+		const bool stealth = Stealth::on(sb);
+		const bool vanAlarm = sb->getVanStop("alarm") != 0;
+		if (stealth || vanAlarm)
+		{
+			bool wary = false;
+			for (auto *bu : *sb->getUnits())
+				if (bu->getOriginalFaction() == FACTION_HOSTILE && !bu->isOut() && Stealth::state(sb, bu) >= Stealth::WARY) wary = true;
+			const bool raised = (stealth && Stealth::alarm(sb)) || vanAlarm;
+			d.alarm = raised ? "ALARM" : wary ? "SUSPICIOUS" : "QUIET";
+			d.alarmLevel = raised ? 2 : wary ? 1 : 0;
+			const int turn = sb->getTurn();
+			const int backup = sb->getVanStop("backupTurn", -1);
+			if (raised && backup >= turn) d.alarm += "  -  reinforcements in " + std::to_string(backup - turn) + (backup - turn == 1 ? " turn" : " turns");
+			const AlienDeployment *dep = _game->getMod()->getDeployment(sb->getMissionType(), false);
+			if (vanAlarm && dep && dep->getGetawayTurns() > 0 && !sb->getVanStop("gone"))
+			{
+				const int left = std::max(0, dep->getGetawayTurns() - sb->getVanStop("ends"));
+				d.alarm += "  -  cash leaving in " + std::to_string(left) + (left == 1 ? " turn" : " turns");
+			}
+		}
+	}
+	HiUI::nativeHud(_icons, _hudMission, d);
+}
