+	// inferred from the bonus, because a camp priced at garrisonBonus 0 is still a camp and
+	// would otherwise have left its own region capped.
+	if (!campHere)
+	{
+		for (const auto &siteType : mod->getCobraSitesList())
+		{
+			const RuleCobraSite *rule = mod->getCobraSite(siteType);
+			if (rule && rule->getGarrisonRankUnlock() >= 0
+				&& (cobraSite || rule->getGarrisonAllMissions()))
+			{
+				out.rankUnlock = rule->getGarrisonRankUnlock();
+				break;
+			}
+		}
+	}
+	return out;
+}
+
+void SavedGame::cobraPlan(const Mod *mod)
+{
+	// THE DECISION LAYER. Everything else in the economy is state and rules; this is the only
+	// place that chooses anything, and it is deliberately the dullest code in it.
+	//
+	// It does not pick a region - the mission scripts still do that. It publishes what Cobra
+	// WANTS, as COBRA_BUILD_<TYPE>, and a script runs only when its own type is wanted. So
+	// replacing this with something cleverer, or with a person for a Cobra playthrough, changes
+	// no scheduling code and no ruleset. That is what the whole arrangement was for.
+	//
+	// What it does that the dice roll it replaces did not:
+	//   - rebuild what it has lost, because a type it owns none of is wanted
+	//   - pay its way first, because while it cannot cover upkeep only earners are wanted
+	//   - stop buying what it already has, so it does not field four headquarters
+	std::map<std::string, int> owned;
+	for (auto *base : _alienBases)
+	{
+		if (!base->getSiteType().empty())
+		{
+			owned[base->getSiteType()]++;
+		}
+	}
+
+	// What the network earns and spends in a month, read from the sites themselves rather than
+	// from the balance, so a raid is felt at once instead of a month later.
+	int netFunds = 0, netMateriel = 0;
+	for (const auto &pair : owned)
+	{
+		RuleCobraSite *rule = mod->getCobraSite(pair.first);
+		if (rule == 0)
+		{
+			continue;
+		}
+		netFunds += (rule->getFundsPerMonth() - rule->getUpkeepFunds()) * pair.second;
+		netMateriel += (rule->getMaterielPerMonth() - rule->getUpkeepMateriel()) * pair.second;
+	}
+
+	// Where the planning happens. While Cobra holds a site that runs the show, everything below
+	// applies. With none standing it reverts to dice, and the one thing it must still be able to
+	// do is replace the site that does the thinking - otherwise killing it once ends the game.
+	// The affordability test below is what keeps that reachable rather than instant.
+	bool planning = false;
+	for (const auto &pair : owned)
+	{
+		RuleCobraSite *r = mod->getCobraSite(pair.first);
+		if (r && r->getRunsThePlanning() && pair.second > 0)
+		{
+			planning = true;
+			break;
+		}
+	}
+
+	const int funds = _cobraEconomy->getTotalFunds();
+	const bool broke = netFunds <= 0;
+	const bool starved = netMateriel < 0;
+
+	// Cobra can always establish its first income. Without this it starts with nothing, so
+	// nothing is affordable, so it never earns and the economy never begins - the same deadlock
+	// the ruleset used to dodge by leaving the earner ungated, now stated once where the
+	// deciding happens. Only the cheapest earner, and only while it has none at all.
+	std::string freeEarner;
+	int cheapest = 0;
+	bool hasEarner = false;
+	for (const auto &siteType : mod->getCobraSitesList())
+	{
+		RuleCobraSite *r = mod->getCobraSite(siteType);
+		if (r == 0 || r->getFundsPerMonth() <= r->getUpkeepFunds())
+		{
+			continue;
+		}
+		if (owned.count(siteType) && owned[siteType] > 0)
+		{
+			hasEarner = true;
+		}
+		if (freeEarner.empty() || r->getBuildCostFunds() < cheapest)
+		{
+			freeEarner = siteType;
+			cheapest = r->getBuildCostFunds();
+		}
+	}
+	if (hasEarner)
+	{
+		freeEarner.clear();
+	}
+
+	for (const auto &siteType : mod->getCobraSitesList())
+	{
+		RuleCobraSite *rule = mod->getCobraSite(siteType);
+		if (rule == 0)
+		{
+			continue;
+		}
+		const int have = owned.count(siteType) ? owned[siteType] : 0;
+		const bool earner = rule->getFundsPerMonth() > rule->getUpkeepFunds();
+		const bool maker = rule->getMaterielPerMonth() > rule->getUpkeepMateriel();
+
+		bool wanted;
+		if (!planning)
+		{
+			// Nobody is running the show. Cobra buys whatever it can afford, in no order and
+			// with no thought for whether it can run the thing afterwards - which is exactly
+			// what it did before there was a planner, and measurably worse: three sites in
+			// eleven months against twelve.
+			//
+			// It still checks the price. Stripping that out as well would let a leaderless
+			// Cobra build a Terror Drome it has no money for, and the point is that it is
+			// stupid, not that it is rich.
+			wanted = true;
+		}
+		else if (broke)
+		{
+			// Cannot cover its own upkeep: earners only until that is fixed. This is what
+			// stops Cobra building a headquarters it has no way to run.
+			wanted = earner;
+		}
+		else if (starved && maker)
+		{
+			wanted = true;              // losing materiel faster than it makes it
+		}
+		else
+		{
+			wanted = (have == 0);       // one of everything first; breadth before depth
+		}
+
+		const bool afford = funds >= rule->getBuildCostFunds() || siteType == freeEarner;
+		_alienStrategy->setMissionRun("COBRA_BUILD_" + siteType, (wanted && afford) ? 1 : 0);
+	}
+}
+
+void SavedGame::cobraBuilt(const AlienBase *base, const Mod *mod)
+{
+	if (base->getSiteType().empty())
+	{
+		return;
+	}
+	RuleCobraSite *rule = mod->getCobraSite(base->getSiteType());
+	Region *region = locateRegion(*base);
+	if (rule == 0 || region == 0 || rule->getBuildCostFunds() <= 0)
+	{
+		return;
+	}
+	// The scripts gate on Cobra's TOTAL funds, because a script may pick any region and so
+	// cannot read one region's bank. Spending matches: the region the site stands in pays what
+	// it can and the rest of the network covers the remainder, which is what the design means
+	// by funds being liquid while materiel stays where it is made.
+	_cobraEconomy->spendFunds(region->getRules()->getType(), rule->getBuildCostFunds());
+	_cobraEconomy->mirrorToCounters(*_alienStrategy);
+}
+
+/**
+ * Cobra's economy lines are ON by default, and that is deliberate.
+ *
+ * They used to be behind OXCE_ECON_LOG, which meant a player who hit a crash sent back a log
+ * with no trace of what Cobra had been doing - nobody sets an environment variable before
+ * playing. The whole subsystem was invisible in exactly the situation it most needed to be
+ * visible. Volume is about twenty to thirty lines a month (a line per region, plus bench and
+ * raid events), which is nothing against a crash report that cannot be explained.
+ *
+ * OXCE_ECON_QUIET turns them off for anyone who wants a clean log.
+ */
+static bool cobraLogOn()
+{
+	static const bool on = (getenv("OXCE_ECON_QUIET") == 0);
+	return on;
+}
+
+/**
+ * Names a Cobra site uniquely. AlienBase ids come from SavedGame::getId keyed by the
+ * deployment's MARKER NAME, so every site type starts its own count at 1 - the first depot and
+ * the first research lab are both id 1. A bench keyed on the bare id therefore pointed at two
+ * buildings at once: raiding a depot wiped a lab's current node, and the two shared a pool of
+ * benches. The type has to be part of the key.
+ */
+static std::string cobraSiteKey(const AlienBase *base)
+{
+	return base->getSiteType() + "#" + std::to_string(base->getId());
+}
+
+int SavedGame::cobraRaided(const AlienBase *base, const Mod *mod)
+{
+	if (base->getSiteType().empty())
+	{
+		return 0;                           // an ordinary alien base; nothing to take
+	}
+	RuleCobraSite *rule = mod->getCobraSite(base->getSiteType());
+	Region *region = locateRegion(*base);
+	if (rule == 0 || region == 0)
+	{
+		return 0;
+	}
+	const std::string &regionType = region->getRules()->getType();
+
+	// A depot's loot is whatever the region had been holding, which is the whole point of
+	// raiding one: everything the other sites in that region had banked goes with it.
+	int funds = rule->getLootFunds();
+	int materiel = rule->getLootMateriel();
+	if (rule->getLootsRegionalStockpile())
+	{
+		funds = _cobraEconomy->getFunds(regionType);
+		materiel = _cobraEconomy->getMateriel(regionType);
+	}
+	else
+	{
+		// cannot take more than is there
+		funds = std::min(funds, _cobraEconomy->getFunds(regionType));
+		materiel = std::min(materiel, _cobraEconomy->getMateriel(regionType));
+	}
+	_cobraEconomy->addFunds(regionType, -funds);
+	_cobraEconomy->addMateriel(regionType, -materiel);
+
+	// A raid takes the current node, not the knowledge. John's rule: "cobra retains all
+	// completed knowledge but loses progress on current node." So a finished department is
+	// untouched - Cobra can be delayed but never pushed backwards - and an unfinished one
+	// hosted here drops to zero and goes back on the shelf for some other lab to pick up.
+	// What a raid is worth is therefore exactly how far along that bench had got: taking a
+	// lab that is one month off lasers hurts, taking one that started last week does not.
+	for (auto &project : _cobraEconomy->getProjects())
+	{
+		if (project.labKey == cobraSiteKey(base) && project.progress < project.cost)
+		{
+			if (cobraLogOn())
+			{
+				Log(LOG_INFO) << "[econ] the raid cost Cobra " << project.progress << "/"
+					<< project.cost << " on " << project.type;
+			}
+			project.progress = 0;
+			project.labKey.clear();
+		}
+	}
+
+	// Raiding a lab or a headquarters is how the player learns what Cobra is building.
+	int reveal = rule->getRevealOnRaid();
+	for (auto &project : _cobraEconomy->getProjects())
+	{
+		if (reveal <= 0)
+		{
+			break;
+		}
+		if (!project.known)
+		{
+			project.known = true;
+			--reveal;
+		}
+	}
+
+	// The site itself is about to be deleted, so its production stops by simply no longer
+	// being counted next month. Nothing here needs to undo it.
+	_cobraEconomy->mirrorToCounters(*_alienStrategy);
+	return funds + materiel;
+}
+
+/**
+ * Pays Cobra for a mission the player let run to its end.
+ *
+ * This is the money half of John's early game: "Until it gets a terror drome it should only be
+ * launching missions for money gain and influence. Maybe that's how they expose themselves early."
+ * The influence half already worked - a despawning site adds alien activity to its region and its
+ * country, which erodes funding and raises pact odds - but nothing made a MISSION pay Cobra, so
+ * crime was flavour. Site income is monthly and site-based; this is the first money that comes
+ * from Cobra DOING something.
+ *
+ * Paid on despawn only. The player saw the site on the globe and chose not to go, so the money is
+ * a consequence of his decision rather than something that happens to him; raid it and Cobra
+ * banks nothing. Regional, like the rest of the economy, so robbing banks in North America arms
+ * North America.
+ *
+ * @param deployment The despawning site's deployment, which carries the price.
+ * @param region The region it despawned in; nothing is paid without one.
+ * @return What was banked, for the caller to log.
+ */
+int SavedGame::cobraMissionPaid(const AlienDeployment *deployment, const Region *region)
+{
+	if (deployment == 0 || region == 0)
+	{
+		return 0;
+	}
+	const int paid = deployment->getCobraPayoutFunds();
+	if (paid <= 0)
+	{
+		return 0;
+	}
+	_cobraEconomy->addFunds(region->getRules()->getType(), paid);
+	return paid;
+}
+
+/**
+ * Advances Cobra's research by a month.
+ *
+ * Three things were missing, not one: nothing created a project, nothing advanced one, and
+ * nothing happened when one finished - so the list was permanently empty, the research lab did
+ * nothing for its 800 and 60 a month, and revealOnRaid revealed an empty set.
+ *
+ * Labs turn MATERIEL into progress, so research competes with weapons for the same regional
+ * stockpile. John: "Research costs both time and resources." That also means cutting a region's
+ * supply slows its research as well as arming its men worse, which is the second consequence
+ * starving a region ought to have.
+ *
+ * Pro-rata when a region cannot pay the whole bill, the same way production is - a lab that
+ * stops dead over being one short reads as a bug.
+ */
+void SavedGame::cobraResearch(const Mod *mod)
+{
+	const auto &rules = mod->getCobraProjects();
+	if (rules.empty())
+	{
+		return;                 // no tech tree authored; nothing to advance
+	}
+	auto ruleFor = [&rules](const std::string &type) -> const RuleCobraProject*
+	{
+		for (const auto &cand : rules) { if (cand.type == type) return &cand; }
+		return 0;
+	};
+
+	// ONE project per DEPARTMENT, worldwide. A department is a part of Cobra's organisation,
+	// not of the map: where it is being worked on is whichever lab has claimed it, and the
+	// claim is the project's own labKey. That single field is what makes John's rule - a
+	// department may only be studied in one lab anywhere - true by construction rather than
+	// something to police. (This replaces a per-region list, which asked the player to spread
+	// hubs across regions instead of choosing which branches to run.)
+	if (_cobraEconomy->getProjects().empty())
+	{
+		for (const auto &r : rules)
+		{
+			CobraProject p;
+			p.type = r.type;
+			p.cost = r.cost;
+			_cobraEconomy->getProjects().push_back(p);
+		}
+	}
+
+	const size_t months = (size_t)getCobraMonth();   // Cobra's clock, head start included
+
+	// Every site that can host benches, and how many of each one's are free.
+	std::map<std::string, int> freeSlots;
+	std::map<std::string, const AlienBase*> siteByKey;
+	for (const auto *base : _alienBases)
+	{
+		if (base->getSiteType().empty()) continue;
+		const RuleCobraSite *rule = mod->getCobraSite(base->getSiteType());
+		if (!rule || rule->getLabSlots() <= 0 || rule->getProjectProgressPerMonth() <= 0) continue;
+		const std::string key = cobraSiteKey(base);
+		freeSlots[key] = rule->getLabSlots();
+		siteByKey[key] = base;
+	}
+
+	// Standing claims. A site the player has taken off the board is simply not in the map any
+	// more, so its labs release here and their departments go back on the shelf. A finished
+	// project frees its bench too, which is how a site moves on to the next department.
+	for (auto &p : _cobraEconomy->getProjects())
+	{
+		if (p.labKey.empty()) continue;
+		if (!freeSlots.count(p.labKey) || p.progress >= p.cost)
+		{
+			p.labKey.clear();
+			continue;
+		}
+		--freeSlots[p.labKey];
+	}
+
+	// Which departments already have a node being worked. Cobra runs one node at a time per
+	// department, so a second bench cannot pick up another branch of the same department even
+	// when it is sitting idle - what buys parallel research is DEPARTMENTS, not benches.
+	std::set<std::string> busyDept;
+	for (const auto &p : _cobraEconomy->getProjects())
+	{
+		if (p.labKey.empty() || p.progress >= p.cost) continue;
+		const RuleCobraProject *r = ruleFor(p.type);
+		busyDept.insert(r && !r->department.empty() ? r->department : p.type);
+	}
+
+	// Hand free benches to unclaimed departments, in ruleset order - that order IS the tree.
+	for (auto &p : _cobraEconomy->getProjects())
+	{
+		if (!p.labKey.empty() || p.progress >= p.cost) continue;
+		const RuleCobraProject *pr = ruleFor(p.type);
+		if (!pr) continue;
+		const std::string dept = pr->department.empty() ? p.type : pr->department;
+		if (busyDept.count(dept))
+		{
+			continue;       // this department is already working on something
+		}
+		for (auto &slot : freeSlots)
+		{
+			if (slot.second <= 0) continue;
+			// ARM THE MEN BEFORE STARTING NEW WORK. Without this Cobra claimed every bench it
+			// owned the month it owned it, and with eleven departments that drained the region
+			// faster than its factories filled it: nine months of twelve under the arming
+			// threshold, fielding handguns all year not because the calendar said so but
+			// because it had spent the materiel on benches. Research is what a region does
+			// with its SURPLUS. A department already in hand keeps going - this only refuses
+			// to open a new front - so a raid never strands work that was already running.
+			const AlienBase *host = siteByKey[slot.first];
+			const Region *hostRegion = host ? locateRegion(*host) : 0;
+			if (hostRegion && pr->materielPerProgress > 0)
+			{
+				const std::string &rt = hostRegion->getRules()->getType();
+				if (_cobraEconomy->getMateriel(rt) < mod->getCobraWellSupplied())
+				{
+					continue;   // this region cannot arm its own troops yet
+				}
+			}
+			p.labKey = slot.first;
+			--slot.second;
+			busyDept.insert(dept);
+			if (cobraLogOn())
+			{
+				Log(LOG_INFO) << "[econ] a bench at " << p.labKey << " took up " << p.type
+					<< " (" << dept << ")";
+			}
+			break;
+		}
+	}
+
+	// Advance every department that has a lab. One lab, one department, one rate - labs never
+	// double up on the same branch, so breadth is bought with benches and not with speed.
+	for (auto &p : _cobraEconomy->getProjects())
+	{
+		const RuleCobraProject *r = ruleFor(p.type);
+		if (!r || p.progress >= p.cost)
+		{
+			continue;
+		}
+		// The calendar's far edge lands here however slowly Cobra worked - and whether or not
+		// anyone was ever assigned to it - so the story cannot stall against a player who has
+		// been winning. It used to do this SILENTLY, which made a project that arrived this
+		// way look like one that never existed.
+		if (r->latestMonth > 0 && months >= r->latestMonth)
+		{
+			p.progress = p.cost;
+			p.labKey.clear();
+			if (cobraLogOn())
+			{
+				Log(LOG_INFO) << "[econ] " << p.type << " arrived for free: month " << months
+					<< " passed its latestMonth " << r->latestMonth;
+			}
+			continue;
+		}
+		if (p.labKey.empty())
+		{
+			continue;           // nobody is working on it
+		}
+		const AlienBase *base = siteByKey[p.labKey];
+		const RuleCobraSite *site = mod->getCobraSite(base->getSiteType());
+		Region *there = locateRegion(*base);
+		if (!site || !there)
+		{
+			continue;
+		}
+		const std::string &regionType = there->getRules()->getType();
+		p.region = regionType;  // so a reader of the save can see where the work is being done
+		int push = site->getProjectProgressPerMonth();
+		if (r->materielPerProgress > 0)
+		{
+			const int have = _cobraEconomy->getMateriel(regionType);
+			const int afford = have / r->materielPerProgress;
+			push = std::min(push, afford);
+			if (push <= 0)
+			{
+				continue;       // the lab's own region cannot pay for a single point
+			}
+			_cobraEconomy->addMateriel(regionType, -(push * r->materielPerProgress));
+		}
+		p.progress = std::min(p.cost, p.progress + push);
+		if (cobraLogOn())
+		{
+			Log(LOG_INFO) << "[econ] " << regionType << " researched " << p.type << " "
+				<< p.progress << "/" << p.cost
+				<< (p.progress >= p.cost && months < r->earliestMonth
+					? " (done, waiting for its earliest month)" : "");
+		}
+	}
+}
+
+/**
+ * The best itemSet tier Cobra's finished research allows.
+ *
+ * The calendar's NEAR edge lives here: a project whose progress is full still does not count
+ * until its earliestMonth, so Cobra cannot research its way past the story however rich it is.
+ * Returns -1 when no project names a tier, which leaves the month table in charge and is how the
+ * game behaved before any of this existed.
+ */
+/**
+ * The New Game head start, applied once before the first day.
+ *
+ * Cobra's clock already runs ahead by itself (getCobraMonth), which decides who it may field
+ * and the calendar's weapon ceiling. That alone is not enough: the weapon tier is ALSO capped
+ * by what Cobra has researched, so a month-9 Cobra with an empty lab still carries pistols.
+ * So every project whose earliestMonth the head start has reached is handed over finished -
+ * Cobra had those months. And its home network is given the stock those months would have
+ * banked, at the rate cobraEconomy's headStart* keys set (by default one front company's net
+ * income and one factory's output a month). Sites are not planted: Cobra builds those itself,
+ * and being richer it builds them sooner.
+ */
+void SavedGame::cobraApplyHeadStart(const Mod *mod)
+{
+	if (_cobraHeadStart <= 0)
+	{
+		return;
+	}
+	const auto &rules = mod->getCobraProjects();
+	if (_cobraEconomy->getProjects().empty())
+	{
+		for (const auto &r : rules)
+		{
+			CobraProject p;
+			p.type = r.type;
+			p.cost = r.cost;
+			_cobraEconomy->getProjects().push_back(p);
+		}
+	}
+	int done = 0;
+	for (const auto &r : rules)
+	{
+		if ((size_t)_cobraHeadStart < r.earliestMonth) continue;
+		for (auto &p : _cobraEconomy->getProjects())
+		{
+			if (p.type == r.type && p.progress < p.cost)
+			{
+				p.progress = p.cost;
+				++done;
+			}
+		}
+	}
+	const std::string &region = mod->getCobraHeadStartRegion();
+	_cobraEconomy->addFunds(region, _cobraHeadStart * mod->getCobraHeadStartFunds());
+	_cobraEconomy->addMateriel(region, _cobraHeadStart * mod->getCobraHeadStartMateriel());
+	_cobraEconomy->mirrorToCounters(*_alienStrategy);
+	Log(LOG_INFO) << "[econ] head start " << _cobraHeadStart << " months: " << done
+		<< " projects finished, " << region << " funds=" << _cobraEconomy->getFunds(region)
+		<< " materiel=" << _cobraEconomy->getMateriel(region)
+		<< ", Cobra opens the campaign at month " << (_cobraHeadStart + 1);
+}
+
+int SavedGame::cobraResearchedKitTier(const Mod *mod) const
+{
+	int best = -1;
+	bool anyNamesATier = false;
+	const size_t months = (size_t)getCobraMonth();   // Cobra's clock, head start included
+	for (const auto &r : mod->getCobraProjects())
+	{
+		if (r.unlocksKitTier < 0) continue;
+		anyNamesATier = true;
+		if (months < r.earliestMonth) continue;
+		for (const auto &p : _cobraEconomy->getProjects())
+		{
+			if (p.type == r.type && p.progress >= p.cost && p.cost > 0)
+			{
+				best = std::max(best, r.unlocksKitTier);
+				break;
+			}
+		}
+	}
+	if (!anyNamesATier)
+	{
+		return -1;
+	}
+	return best < 0 ? 0 : best;
+}
