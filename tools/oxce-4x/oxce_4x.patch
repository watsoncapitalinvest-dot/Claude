diff --git a/src/Geoscape/SeaNav.cpp b/src/Geoscape/SeaNav.cpp
new file mode 100644
index 0000000..a36136c
--- /dev/null
+++ b/src/Geoscape/SeaNav.cpp
@@ -0,0 +1,298 @@
+/*
+ * G.I. Joe: boats keep to the water and the rivers (see SeaNav.h).
+ */
+#include "SeaNav.h"
+#include <cmath>
+#ifndef M_PI
+#define M_PI 3.14159265358979323846 // MSVC defines it only with _USE_MATH_DEFINES
+#endif
+#include <queue>
+#include <unordered_map>
+#include <algorithm>
+#include <sstream>
+#include <cstdlib>
+#include "../Mod/Mod.h"
+#include "../Mod/RuleGlobe.h"
+#include "../Mod/Polygon.h"
+#include "../Mod/Texture.h"
+#include "../Engine/Logger.h"
+#include "../fmath.h"
+
+namespace OpenXcom
+{
+namespace SeaNav
+{
+
+namespace
+{
+	const int W = 720, H = 360;         // half-degree cells: lon 0..360, lat -90..90 (the game's: north negative)
+	const int SW = W, SH = H;           // the land raster is the grid itself
+	const double RES = 0.5;             // degrees a cell
+	bool built = false;
+	const Mod *theMod = nullptr;
+	std::vector<unsigned char> water;   // W * H
+	std::vector<std::string> boats;
+
+	struct Plan { int goal = -1; std::vector<int> path; size_t at = 0; bool none = false; };
+	std::unordered_map<const void*, Plan> plans;
+
+	const double D2R = M_PI / 180.0;
+
+	int cellOf(double lon, double lat)
+	{
+		double ld = lon / D2R, bd = lat / D2R;
+		ld = std::fmod(ld, 360.0); if (ld < 0) ld += 360.0;
+		int i = std::min(W - 1, std::max(0, (int)(ld / RES)));
+		int j = std::min(H - 1, std::max(0, (int)((bd + 90.0) / RES)));
+		return j * W + i;
+	}
+	void centreOf(int c, double &lon, double &lat)
+	{
+		lon = ((c % W) + 0.5) * RES * D2R;
+		lat = (((c / W) + 0.5) * RES - 90.0) * D2R;
+	}
+
+	/// the globe's own point-in-polygon test (Globe::getPolygonFromLonLat), for one polygon
+	bool inside(const Polygon *polygon, double lon, double lat)
+	{
+		const double coslat = std::cos(lat), sinlat = std::sin(lat);
+		for (int j = 0; j < polygon->getPoints(); ++j)
+		{
+			const double z = coslat * std::cos(polygon->getLatitude(j)) * std::cos(polygon->getLongitude(j) - lon) + sinlat * std::sin(polygon->getLatitude(j));
+			if (z < 0.75) return false;
+		}
+		bool odd = false;
+		double clat = polygon->getLatitude(0), clon = polygon->getLongitude(0);
+		double x = std::cos(clat) * std::sin(clon - lon);
+		double y = coslat * std::sin(clat) - sinlat * std::cos(clat) * std::cos(clon - lon);
+		for (int j = 0; j < polygon->getPoints(); ++j)
+		{
+			const int k = (j + 1) % polygon->getPoints();
+			clat = polygon->getLatitude(k); clon = polygon->getLongitude(k);
+			const double x2 = std::cos(clat) * std::sin(clon - lon);
+			const double y2 = coslat * std::sin(clat) - sinlat * std::cos(clat) * std::cos(clon - lon);
+			if (((y > 0) != (y2 > 0)) && (0 < (x2 - x) * (0 - y) / (y2 - y) + x)) odd = !odd;
+			x = x2; y = y2;
+		}
+		return odd;
+	}
+
+	double stepCost(int a, int b)
+	{
+		const int ai = a % W, aj = a / W, bi = b % W, bj = b / W;
+		int di = std::abs(ai - bi); if (di > W / 2) di = W - di;
+		const int dj = std::abs(aj - bj);
+		const double c = std::cos((((aj + bj) / 2.0 + 0.5) * RES - 90.0) * D2R);
+		return std::sqrt(di * di * c * c + dj * dj);
+	}
+
+	/// the nearest water cell within r cells (the base on the coast, the target in a harbour)
+	int nearestWater(int c, int r)
+	{
+		if (water[c]) return c;
+		const int ci = c % W, cj = c / W;
+		int best = -1; double bd = 1e9;
+		for (int dj = -r; dj <= r; ++dj)
+			for (int di = -r; di <= r; ++di)
+			{
+				const int j = cj + dj; if (j < 0 || j >= H) continue;
+				const int i = ((ci + di) % W + W) % W;
+				const int n = j * W + i;
+				if (!water[n]) continue;
+				const double d = stepCost(c, n);
+				if (d < bd) { bd = d; best = n; }
+			}
+		return best;
+	}
+
+	std::vector<int> astar(int from, int to)
+	{
+		std::vector<double> g(W * H, 1e18);
+		std::vector<int> prev(W * H, -1);
+		typedef std::pair<double, int> QE;
+		std::priority_queue<QE, std::vector<QE>, std::greater<QE>> open;
+		g[from] = 0;
+		open.push(QE(stepCost(from, to), from));
+		while (!open.empty())
+		{
+			const int c = open.top().second; open.pop();
+			if (c == to) break;
+			const int ci = c % W, cj = c / W;
+			for (int dj = -1; dj <= 1; ++dj)
+				for (int di = -1; di <= 1; ++di)
+				{
+					if (!di && !dj) continue;
+					const int j = cj + dj; if (j < 0 || j >= H) continue;
+					const int n = j * W + ((ci + di) % W + W) % W;
+					if (!water[n]) continue;
+					const double ng = g[c] + stepCost(c, n);
+					if (ng < g[n]) { g[n] = ng; prev[n] = c; open.push(QE(ng + stepCost(n, to), n)); }
+				}
+		}
+		std::vector<int> path;
+		if (g[to] >= 1e18) return path;
+		for (int c = to; c != -1; c = prev[c]) path.push_back(c);
+		std::reverse(path.begin(), path.end());
+		return path;
+	}
+
+	/// is the straight run from one point to another all water (sampled every quarter degree)
+	bool clearRun(double lon1, double lat1, double lon2, double lat2)
+	{
+		double dl = lon2 - lon1;
+		while (dl > M_PI) dl -= 2 * M_PI;
+		while (dl < -M_PI) dl += 2 * M_PI;
+		const double db = lat2 - lat1;
+		const int n = std::max(1, (int)(std::sqrt(dl * dl + db * db) / (0.2 * D2R)));
+		for (int k = 0; k <= n; ++k)
+		{
+			const double t = (double)k / n;
+			if (!water[cellOf(lon1 + dl * t, lat1 + db * t)]) return false;
+		}
+		return true;
+	}
+}
+
+void init(const Mod *mod)
+{
+	if (built || !mod) return;
+	built = true;
+	theMod = mod;
+	const auto &AF = mod->getAirFightRules();
+	for (const auto &u : AF.units)
+	{
+		const auto *r = mod->getAirCraft(u.second);
+		if (r && r->seaOnly) boats.push_back(u.first);
+	}
+	// the land raster: each polygon marks the half-degree samples inside its own bounding box
+	std::vector<unsigned char> land(SW * SH, 0);
+	RuleGlobe *globe = mod->getGlobe();
+	for (const Polygon *p : *globe->getPolygons())
+	{
+		const Texture *tex = globe->getTexture(p->getTexture());
+		if (tex && tex->isCosmeticOcean()) continue;
+		double lo0 = 1e9, lo1 = -1e9, la0 = 1e9, la1 = -1e9;
+		for (int j = 0; j < p->getPoints(); ++j)
+		{
+			lo0 = std::min(lo0, p->getLongitude(j)); lo1 = std::max(lo1, p->getLongitude(j));
+			la0 = std::min(la0, p->getLatitude(j)); la1 = std::max(la1, p->getLatitude(j));
+		}
+		const bool wraps = lo1 - lo0 > M_PI;
+		const int i0 = wraps ? 0 : std::max(0, (int)(lo0 / D2R * 2) - 1), i1 = wraps ? SW - 1 : std::min(SW - 1, (int)(lo1 / D2R * 2) + 1);
+		const int j0 = std::max(0, (int)((la0 / D2R + 90) * 2) - 1), j1 = std::min(SH - 1, (int)((la1 / D2R + 90) * 2) + 1);
+		for (int j = j0; j <= j1; ++j)
+			for (int i = i0; i <= i1; ++i)
+			{
+				if (land[j * SW + i]) continue;
+				const double lon = (i + 0.5) * 0.5 * D2R, lat = ((j + 0.5) * 0.5 - 90) * D2R;
+				if (inside(p, lon, lat)) land[j * SW + i] = 1;
+			}
+	}
+	// a cell is water if its own centre is: the canals and narrow straits are drawn in with the rivers
+	water.assign(W * H, 0);
+	int nWater = 0;
+	for (int c = 0; c < W * H; ++c) { water[c] = !land[c]; nWater += water[c]; }
+	// the rivers, drawn in as water
+	int nRiver = 0;
+	for (const auto &river : AF.rivers)
+	{
+		const auto &pts = river.second;
+		for (size_t k = 0; k + 1 < pts.size(); ++k)
+		{
+			if (pts[k].size() < 2 || pts[k + 1].size() < 2) continue;
+			const double lo1 = pts[k][0], la1 = pts[k][1], lo2 = pts[k + 1][0], la2 = pts[k + 1][1];
+			const int n = std::max(1, (int)(std::hypot(lo2 - lo1, la2 - la1) / 0.1));
+			for (int s = 0; s <= n; ++s)
+			{
+				const double t = (double)s / n;
+				const int c = cellOf((lo1 + (lo2 - lo1) * t) * D2R, (la1 + (la2 - la1) * t) * D2R);
+				if (!water[c]) { water[c] = 1; ++nRiver; }
+			}
+		}
+	}
+	if (getenv("OXCE_SEANAV_TEST"))
+	{
+		// test routes, degrees in the game's convention (north negative)
+		const double T[][4] = { {270, -25, 330, -30}, {270, -25, 240, -20}, {271, -28, 270, -38}, {270, -25, 2.3, -48.9}, {270, -25, 99, -40}, {330, -35, 18, -35}, {18, -35, 60, -20}, {18, -35, 30, -43} };
+		for (const auto &t : T)
+		{
+			const int a = nearestWater(cellOf(t[0] * D2R, t[1] * D2R), 4), b = nearestWater(cellOf(t[2] * D2R, t[3] * D2R), 4);
+			std::vector<int> p = (a >= 0 && b >= 0) ? astar(a, b) : std::vector<int>();
+			double len = 0; for (size_t k = 1; k < p.size(); ++k) len += stepCost(p[k - 1], p[k]);
+			std::ostringstream ss;
+			for (size_t k = 0; k < p.size(); k += std::max<size_t>(1, p.size() / 12)) ss << " (" << (p[k] % W) * RES << "," << (p[k] / W) * RES - 90 << ")";
+			Log(LOG_INFO) << "[seanav] test " << t[0] << "," << t[1] << " -> " << t[2] << "," << t[3] << ": " << p.size() << " cells, " << (int)len << " deg;" << ss.str();
+		}
+	}
+	Log(LOG_INFO) << "[seanav] " << nWater << " water cells of " << W * H << ", " << nRiver << " river cells, " << boats.size() << " boat types";
+}
+
+bool isBoat(const std::string &craftType)
+{
+	return std::find(boats.begin(), boats.end(), craftType) != boats.end();
+}
+
+bool isWater(double lon, double lat)
+{
+	return built && water[cellOf(lon, lat)];
+}
+
+bool isLandExact(double lon, double lat)
+{
+	if (!theMod) return false;
+	RuleGlobe *globe = theMod->getGlobe();
+	for (const Polygon *p : *globe->getPolygons())
+	{
+		const Texture *tex = globe->getTexture(p->getTexture());
+		if (tex && tex->isCosmeticOcean()) continue;
+		if (inside(p, lon, lat)) return true;
+	}
+	return false;
+}
+
+void forget(const void *key)
+{
+	plans.erase(key);
+}
+
+bool nextPoint(const void *key, double lon, double lat, double toLon, double toLat, double &outLon, double &outLat)
+{
+	if (!built) return false;
+	Plan &plan = plans[key];
+	const int start = nearestWater(cellOf(lon, lat), 4);
+	const int goal = nearestWater(cellOf(toLon, toLat), 4);
+	if (start < 0 || goal < 0) { plan.none = true; return false; }
+	if (start == goal || clearRun(lon, lat, toLon, toLat)) { outLon = toLon; outLat = toLat; return true; }
+	if (goal != plan.goal || plan.path.empty())
+	{
+		plan.goal = goal;
+		plan.path = astar(start, goal);
+		plan.at = 0;
+		plan.none = plan.path.empty();
+		Log(LOG_INFO) << "[seanav] route " << plan.path.size() << " cells from " << lon / D2R << "," << lat / D2R << " to " << toLon / D2R << "," << toLat / D2R;
+		if (plan.none) return false;
+	}
+	// where we are on the plan (re-plan if we have drifted off it)
+	size_t here = plan.path.size();
+	for (size_t k = plan.at; k < plan.path.size(); ++k) if (plan.path[k] == start) { here = k; break; }
+	if (here == plan.path.size())
+	{
+		plan.path = astar(start, goal);
+		plan.at = 0; here = 0;
+		if (plan.path.empty()) { plan.none = true; return false; }
+	}
+	plan.at = here;
+	// steer for the furthest cell ahead that open water reaches in a straight line
+	size_t pick = std::min(here + 1, plan.path.size() - 1);
+	for (size_t k = plan.path.size() - 1; k > here + 1; --k)
+	{
+		double cl, cb; centreOf(plan.path[k], cl, cb);
+		if (k - here <= 40 && clearRun(lon, lat, cl, cb)) { pick = k; break; }
+	}
+	if (plan.path[pick] == goal) { outLon = toLon; outLat = toLat; return true; }
+	centreOf(plan.path[pick], outLon, outLat);
+	return true;
+}
+
+}
+}
diff --git a/src/Geoscape/SeaNav.h b/src/Geoscape/SeaNav.h
new file mode 100644
index 0000000..dad2693
--- /dev/null
+++ b/src/Geoscape/SeaNav.h
@@ -0,0 +1,34 @@
+#pragma once
+/*
+ * G.I. Joe: boats keep to the water (John 14 Nov 14:21 "Boats kept to water and rivers").
+ * A half-degree grid of the globe, water or not, built once from the globe's own land polygons, with the
+ * rivers in airFight.rivers drawn in as water. A boat's route is an A* path over it, re-planned when
+ * its target moves to another cell. The S.H.A.R.C. flies, so only seaOnly craft use this.
+ */
+#include <vector>
+#include <map>
+#include <string>
+
+namespace OpenXcom
+{
+
+class Mod;
+
+namespace SeaNav
+{
+	/// build the grid (once; cheap to call again)
+	void init(const Mod *mod);
+	/// is this craft type a boat that keeps to the water
+	bool isBoat(const std::string &craftType);
+	/// the next point to steer for, going from (lon, lat) to (toLon, toLat), all radians.
+	/// Returns false when there is no water route; `key` caches the plan per mover.
+	bool nextPoint(const void *key, double lon, double lat, double toLon, double toLat, double &outLon, double &outLat);
+	/// forget a mover's cached plan
+	void forget(const void *key);
+	/// is this point water (or a river) on the grid
+	bool isWater(double lon, double lat);
+	/// is this exact point on land (the globe's own polygons, not the grid)
+	bool isLandExact(double lon, double lat);
+}
+
+}
