+/**
+ * G.I. Joe squadrons: what the button says. Leading (others fly with this one), flying with a lead, or alone.
+ */
+void CraftInfoState::refreshSquad()
+{
+	if (!_btnSquad) return;
+	const Mod *mod = _game->getMod();
+	if (Craft *lead = Squadron::leadOf(mod, _base, _craft))
+		_btnSquad->setText(tr("STR_SQUAD_WITH").arg(lead->getName(_game->getLanguage())));
+	else if (!_craft->getSquadLead().first.empty())
+		_btnSquad->setText(tr("STR_SQUAD_LEAD_GONE"));
+	else if (int n = Squadron::followers(_base, _craft))
+		_btnSquad->setText(tr("STR_SQUAD_LEADS").arg(n));
+	else
+		_btnSquad->setText(tr("STR_SQUAD_NONE"));
+}
+
+/**
+ * G.I. Joe squadrons: each click joins the next aircraft here that can lead (a named pilot), then flies alone again.
+ * A craft others follow can't itself follow (one level only).
+ */
+void CraftInfoState::btnSquadClick(Action *)
+{
+	const Mod *mod = _game->getMod();
+	if (Squadron::followers(_base, _craft) > 0) { refreshSquad(); return; }
+	std::vector<Craft*> leads;
+	for (auto *c : *_base->getCrafts())
+		if (c != _craft && c->getSquadLead().first.empty() && Squadron::canLead(mod, c)) leads.push_back(c);
+	size_t next = 0;
+	if (!_craft->getSquadLead().first.empty())
+		for (size_t i = 0; i < leads.size(); ++i) if (leads[i]->getUniqueId() == _craft->getSquadLead()) next = i + 1;
+	if (next < leads.size()) _craft->setSquadLead(leads[next]->getUniqueId());
+	else _craft->setSquadLead(CraftId());
+	refreshSquad();
+}
+
 }
