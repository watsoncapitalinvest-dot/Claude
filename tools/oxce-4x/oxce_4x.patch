+/// Piece 7, Major Bludd's hunt (COBRA_ACT1_TIMETABLE beat 5): in months 3-5, once Cobra can pay his fee (60), it hires him
+/// against the named Joe with the biggest Cobra file (ties: the one who has led the most missions). That Joe gets a bounty,
+/// so the hunters already in the game come for him - on his next flight, or at his base after three weeks at home - and
+/// Bludd leads the team (STR_BLUDD_AMBUSH / STR_BLUDD_RAID). Bludd never dies; his calling card comes home with a win.
+static void bluddMonthly(Game *game)
+{
+	SavedGame *save = game->getSavedGame();
+	auto &net = save->getCobraNet();
+	const int cm = save->getCobraMonth();
+	// the grudge (COBRA_ACT1_TIMETABLE): after the first meeting Bludd comes back for the same Joe every 4 months - his
+	// bounty is renewed, so the hunters find him again on a flight or at home
+	if (net.count("bluddHired"))
+	{
+		if (save->getMonthsPassed() - net["bluddHired"] >= 4 && (save->getMonthsPassed() - net["bluddHired"]) % 4 == 0)
+			for (auto *b : *save->getBases())
+				for (auto *s : *b->getSoldiers())
+					if (s->getId() == net["bluddTarget"] && s->getCobraFile() < game->getMod()->getCobraFileRules().bountyAt)
+					{
+						s->setCobraFile(game->getMod()->getCobraFileRules().bountyAt);
+						Log(LOG_INFO) << "[bludd] the grudge: Bludd is back for " << s->getName();
+					}
+		return;
+	}
+	if (cm < 2 || cm > 4) return;
+	const int fee = 60;
+	if (save->getCobraEconomy().getFunds("STR_NORTH_AMERICA") < fee && cm < 4) return;   // by month 5 he is hired anyway
+	Soldier *target = nullptr;
+	for (auto *b : *save->getBases())
+		for (auto *s : *b->getSoldiers())
+		{
+			if (s->isAway()) continue;
+			if (!target || s->getCobraFile() > target->getCobraFile()
+				|| (s->getCobraFile() == target->getCobraFile() && s->getMissions() > target->getMissions()))
+				target = s;
+		}
+	if (!target) return;
+	save->getCobraEconomy().addFunds("STR_NORTH_AMERICA", -std::min(fee, save->getCobraEconomy().getFunds("STR_NORTH_AMERICA")));
+	const auto &cf = game->getMod()->getCobraFileRules();
+	if (target->getCobraFile() < cf.bountyAt) target->setCobraFile(cf.bountyAt);
+	net["bluddHired"] = save->getMonthsPassed();
+	net["bluddTarget"] = target->getId();
+	Log(LOG_INFO) << "[bludd] Cobra hires Major Bludd against " << target->getName();
+}
