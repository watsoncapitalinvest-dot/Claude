+const int CW = 40, CH = 13, PX = 48, PY = 16;      // card size and pitch (spec 216x80 / 288x104 at 1/6)
+}
+
+ResearchTreeState::ResearchTreeState(Base *base) : _base(base)
+{
+	_window = new Window(this, 320, 200, 0, 0);
+	_txtTitle = new Text(310, 13, 5, 3);
+	_lanes = new Surface(50, VH, 2, VY);
+	_view = new InteractiveSurface(VW, VH, VX, VY);
+	_info = new Surface(88, 124, 231, VY);
+	_txtName = new Text(86, 26, 232, VY);
+	_txtInfo = new Text(86, 18, 232, VY + 28);
+	_txtBody = new Text(86, 92, 232, VY + 48);
+	_btnStart = new TextButton(86, 14, 232, 144);
+	_btnLeft = new TextButton(18, 14, 52, 183);
+	_btnRight = new TextButton(18, 14, 72, 183);
+	_btnUp = new TextButton(18, 14, 92, 183);
+	_btnDown = new TextButton(18, 14, 112, 183);
+	_btnOk = new TextButton(86, 14, 232, 183);
+	setInterface("researchMenu");
+	add(_window, "window", "researchMenu");
+	add(_txtTitle, "text", "researchMenu");
+	add(_lanes);
+	add(_view);
+	add(_info);
+	add(_txtName, "text", "researchMenu");
+	add(_txtInfo, "text", "researchMenu");
+	add(_txtBody, "text", "researchMenu");
+	add(_btnStart, "button", "researchMenu");
+	add(_btnLeft, "button", "researchMenu");
