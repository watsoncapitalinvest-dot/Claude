+/**
+ * Applies the escalation calendar to a single unit.
+ *
+ * The calendar is a property of the UNIT, not of the deployment that happens to
+ * field it, because the same deployment data is shared by every generated Cobra
+ * site. Writing the dates into the deployments would mean maintaining the same
+ * calendar in eight places and still getting it wrong for a scripted mission.
+ *
+ * Three parts, as the design has it:
+ *
+ *   earliest  a hard floor. Never before this, whatever Cobra's books say.
+ *   full      by this month it turns out at full strength; between the two it
+ *             ramps, and a well-supplied region gets there faster. That is the
+ *             "organic" half - Cobra's own state decides when inside the window.
+ *   latest    a ceiling, so a unit can be withdrawn as the war moves on.
+ *
+ * missionOnly is the separate rule that B.A.T.s needed. CLAUDE.md: B.A.T.s in
+ * months 4-22 "belong to named missions only". So a unit flagged this way may
+ * be fielded OUTSIDE its window, but only by a deployment that names it
+ * outright - a scripted mission - never by a generic garrison. Set alongside
+ * earliest 22 that reads exactly as the calendar does.
+ *
+ * Returns the unit to field, which may be a substitute, or null to field nobody.
+ */
+const Unit *BattlescapeGenerator::availableUnit(const Unit *rule, bool namedByMission, bool wellSupplied) const
+{
+	const int month = _game->getSavedGame()->getMonthsPassed();
+	if (month < 0)
+	{
+		return rule;    // a New Battle has no campaign clock; the calendar does not apply
+	}
+
+	// A substitute may itself be too early, so this walks the chain. The guard is
+	// not paranoia: substitute lists are ruleset data and a cycle in one would
+	// otherwise hang the generator with the map half built.
+	for (int hops = 0; rule && hops < 8; ++hops)
+	{
+		// A mission that asks for this unit by name outranks the calendar.
+		if (namedByMission && rule->isAvailOverridable())
+		{
+			return rule;
+		}
+		bool ok = true;
+		if (month < rule->getAvailEarliest())
+		{
+			ok = false;
+		}
+		else if (rule->getAvailLatest() > 0 && month > rule->getAvailLatest())
+		{
+			ok = false;
+		}
+		else
+		{
+			const int full = rule->getAvailFull();
+			const int from = rule->getAvailEarliest();
+			if (full > from && month < full)
+			{
+				// inside the window: the chance it turns out climbs across it
+				int chance = 100 * (month - from + 1) / (full - from + 1);
+				if (wellSupplied)
+				{
+					chance += (100 - chance) / 2;   // a region Cobra can pay for gets there sooner
+				}
+				ok = RNG::percent(chance);
+			}
+		}
+		if (ok)
+		{
+			return rule;
+		}
+		const std::string &sub = rule->getAvailSubstitute();
+		Log(LOG_INFO) << "[econ] month " << month << ": " << rule->getType()
+			<< " is not available yet, fielding "
+			<< (sub.empty() ? std::string("nobody") : sub);
+		if (sub.empty())
+		{
+			return 0;
+		}
+		rule = _game->getMod()->getUnit(sub, false);
+	}
+	return rule;
+}
