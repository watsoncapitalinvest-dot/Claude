+	Uint32 palHash(const SDL_Color *c)
+	{
+		Uint32 h = 2166136261u;
+		for (int i = 0; i < 256; ++i) { h = (h ^ c[i].r) * 16777619u; h = (h ^ c[i].g) * 16777619u; h = (h ^ c[i].b) * 16777619u; }
+		return h;
+	}
