+	// The console's colours, the geoscape panel's own (make_panel.py), darker
+	// in the field so equipment reads on it.
+	const Uint32 C_PLATE = 0x282D23, C_WELL = 0x0F100D, C_RIM_DARK = 0x1A1E16, C_RIM_LIGHT = 0x60684F;
+	const Uint32 C_KEY = 0x5C644A, C_KEY_DARK = 0x343A2C, C_KEY_LIT = 0x848C6C, C_INK = 0xE2DEC4, C_LABEL = 0xD6CEA0;
+
+	// UI STANDARD v1 colours (see roleColour)
+	const Uint32 S_TEXT = 0xE9E6DC, S_MUTED = 0xB9B5A8, S_YELLOW = 0xE8B923, S_DANGER_TXT = 0xF0B3A8,
+		S_INFO = 0x8DB4DE, S_GOOD = 0x8FC66A;
+	const Uint32 S_BUTTON = 0x2A3033, S_BUTTON_DOWN = 0x1D2326, S_BUTTON_EDGE = 0x3D464A, S_BUTTON_SHADOW = 0x161B1D,
+		S_INK = 0x0B0D0C, S_OLIVE = 0x4A5640, S_OLIVE_LIT = 0x6B7A3A;
