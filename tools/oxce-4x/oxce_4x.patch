+		S_INFO = 0x8DB4DE, S_GOOD = 0x8FC66A;
+	const Uint32 S_BUTTON = 0x2A3033, S_BUTTON_DOWN = 0x1D2326, S_BUTTON_EDGE = 0x3D464A, S_BUTTON_SHADOW = 0x161B1D,
+		S_INK = 0x0B0D0C, S_OLIVE = 0x4A5640, S_OLIVE_LIT = 0x6B7A3A;
