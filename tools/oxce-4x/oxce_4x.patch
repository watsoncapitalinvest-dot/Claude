+/**
+ * G.I. Joe van stop (13 Nov 2026, John): the Cobra truck caught at a gas station.
+ * - The alarm goes up the first time a Cobra man sees a Joe or is hurt.
+ * - The driver sits in the cab starting the truck and does nothing else. At the end of the
+ *   second Cobra turn after the alarm, if he is still up, the truck leaves with everyone aboard,
+ *   the crates and the lockbox. The fight goes on. Dropping the driver is the only way to stop it.
+ * - The man at the payphone stays on the phone. If he is still up at the end of the first Cobra
+ *   turn after the alarm, the call is made and the backup (reinforcements with onCall) arrives
+ *   on the Cobra turn after next.
+ * - A Joe on a lookout spot at the start of the turn before the backup arrives sees it coming.
+ * Runs on every turn screen; the state lives in SavedBattleGame::_vanStop.
+ */
+std::string NextTurnState::runVanStop()
+{
+	const AlienDeployment* dep = _game->getMod()->getDeployment(_battleGame->getReinforcementsDeployment(), true);
+	if (!dep || !dep->hasVanStopRules() || _battleGame->getTurn() < 1)
+	{
+		return "";
+	}
+	SavedBattleGame& sb = *_battleGame;
+	Log(LOG_INFO) << "VANSTOP screen turn " << sb.getTurn() << " side " << (int)sb.getSide();
+	auto inRect = [](const std::vector<int>& r, Position p, int grow)
+	{
+		return r.size() == 5 && p.z == r[4] && p.x >= r[0] - grow && p.x <= r[2] + grow && p.y >= r[1] - grow && p.y <= r[3] + grow;
+	};
+	auto unitById = [&](int id) -> BattleUnit*
+	{
+		if (id < 0) return nullptr;
+		for (auto* u : *sb.getUnits())
+			if (u->getId() == id) return u;
+		return nullptr;
+	};
+	auto up = [](const BattleUnit* u) { return u && !u->isOut(); };
+	std::vector<int> phone;
+	if (dep->getPayphone().size() == 3)
+	{
+		const auto& p = dep->getPayphone();
+		phone = { p[0], p[1], p[0], p[1], p[2] };
+	}
+	const int reach = dep->getPayphoneReach();
+
+	// 1. who is the driver and who is on the phone (once, on the first turn screen)
+	if (sb.getVanStop("driver", -2) == -2)
+	{
+		int driver = -1, caller = -1;
+		for (auto* u : *sb.getUnits())
+		{
+			if (u->getOriginalFaction() != FACTION_HOSTILE || u->isOut()) continue;
+			if (driver == -1 && inRect(dep->getGetawayCab(), u->getPosition(), 0)) driver = u->getId();
+			else if (caller == -1 && inRect(phone, u->getPosition(), reach)) caller = u->getId();
+		}
+		int leader = -1;
+		if (!dep->getRobberLeader().empty())
+		{
+			for (auto* u : *sb.getUnits())
+			{
+				if (u->getOriginalFaction() == FACTION_HOSTILE && u->getType() == dep->getRobberLeader()) { leader = u->getId(); break; }
+			}
+		}
+		sb.setVanStop("leader", leader);
+		sb.setVanStop("driver", driver);
+		sb.setVanStop("caller", caller);
+		Log(LOG_INFO) << "VANSTOP driver " << driver << " caller " << caller;
+	}
+	BattleUnit* driver = unitById(sb.getVanStop("driver", -1));
+	BattleUnit* caller = unitById(sb.getVanStop("caller", -1));
+
+	// 2. the alarm
+	if (!sb.getVanStop("alarm"))
+	{
+		for (auto* u : *sb.getUnits())
+		{
+			if (u->getOriginalFaction() != FACTION_HOSTILE || u->isIgnored()) continue;
+			bool hurt = u->isOut() || u->getHealth() < u->getBaseStats()->health || u->getStunlevel() > 0;
+			bool sees = false;
+			if (!u->isOut())
+			{
+				for (auto* v : *u->getVisibleUnits())
+				{
+					if (v->getOriginalFaction() == FACTION_PLAYER && !v->isOut()) { sees = true; break; }
+				}
+			}
+			if (hurt || sees)
+			{
+				sb.setVanStop("alarm", 1);
+				Log(LOG_INFO) << "VANSTOP alarm turn " << sb.getTurn() << " side " << (int)sb.getSide() << (hurt ? " hurt" : " sees");
+				break;
+			}
+		}
+	}
+
+	std::string msg;
+	auto add = [&](const std::string& s) { msg = msg.empty() ? s : msg + " " + s; };
+	const bool joeTurn = sb.getSide() == FACTION_PLAYER;
+	const int turn = sb.getTurn();
+
+	// 3. the end of a Cobra turn (= the start of the Joe turn after it)
+	if (joeTurn && turn > 1 && sb.getVanStop("alarm") && sb.getVanStop("lastCounted", 0) != turn)
+	{
+		sb.setVanStop("lastCounted", turn);
+		int ends = sb.getVanStop("ends") + 1;
+		sb.setVanStop("ends", ends);
+
+		if (!sb.getVanStop("call") && up(caller) && inRect(phone, caller->getPosition(), reach))
+		{
+			sb.setVanStop("call", 1);
+			sb.setVanStop("backupTurn", turn + 1);
+			Log(LOG_INFO) << "VANSTOP call made turn " << turn;
+			if (sb.eyesOnTarget(FACTION_PLAYER, caller))
+			{
+				add(tr("STR_VANSTOP_CALL_MADE"));
+			}
+		}
+
+		if (!sb.getVanStop("gone") && ends >= dep->getGetawayTurns() && up(driver) && inRect(dep->getGetawayCab(), driver->getPosition(), 0))
+		{
+			sb.setVanStop("gone", 1);
+			Log(LOG_INFO) << "VANSTOP truck gone turn " << turn;
+			const auto& truck = dep->getGetawayTruck();
+			// everyone aboard goes with it
+			for (auto* u : *sb.getUnits())
+			{
+				if (u->getOriginalFaction() == FACTION_HOSTILE && !u->isOut() && inRect(truck, u->getPosition(), 0))
+				{
+					sb.setVanStop("esc:" + std::to_string(u->getId()), 1);
+					u->setTile(nullptr, &sb);
+					u->setPosition(TileEngine::invalid);
+					u->goToTimeOut();
+				}
+			}
+			if (truck.size() == 5)
+			{
+				Tile* floorFrom = dep->getGetawayFloorFrom().size() == 3 ? sb.getTile(Position(dep->getGetawayFloorFrom()[0], dep->getGetawayFloorFrom()[1], dep->getGetawayFloorFrom()[2])) : nullptr;
+				for (int x = truck[0] - 1; x <= truck[2] + 1; ++x)
+				{
+					for (int y = truck[1] - 1; y <= truck[3] + 1; ++y)
+					{
+						Tile* tile = sb.getTile(Position(x, y, truck[4]));
+						if (!tile) continue;
+						bool aboard = inRect(truck, tile->getPosition(), 0);
+						// the crates and the lockbox go with it; bodies stay
+						if (aboard)
+						{
+							std::vector<BattleItem*> loose(tile->getInventory()->begin(), tile->getInventory()->end());
+							for (auto* item : loose)
+							{
+								if (!item->getUnit()) sb.removeItem(item);
+							}
+						}
+						// and so does the truck
+						for (int part = O_FLOOR; part <= O_OBJECT; ++part)
+						{
+							MapData* md = tile->getMapData((TilePart)part);
+							if (!md || !md->getDataset() || md->getDataset()->getName() != dep->getGetawayDataset()) continue;
+							if (part == O_FLOOR && floorFrom && floorFrom->getMapData(O_FLOOR))
+							{
+								int id, set;
+								floorFrom->getMapData(&id, &set, O_FLOOR);
+								tile->setMapData(floorFrom->getMapData(O_FLOOR), id, set, O_FLOOR);
+							}
+							else
+							{
+								tile->setMapData(nullptr, -1, -1, (TilePart)part);
+							}
+						}
+					}
+				}
+				Position centre((truck[0] + truck[2]) / 2, (truck[1] + truck[3]) / 2, truck[4]);
+				sb.getTileEngine()->calculateLighting(LL_AMBIENT, centre, 8, true);
+				sb.getTileEngine()->recalculateFOV();
+			}
+			add(tr("STR_VANSTOP_TRUCK_GONE"));
+		}
+	}
+
+	// 3b. ROBBERY (John 02:46 + 11:17): the van never moves; it is only the exit. After the alarm, at the
+	// end of each Cobra turn, a robber standing on the exit tiles is gone with whatever he carries.
+	// The leader waits at the van until every robber carrying loot has got there or gone down.
+	const auto& exits = dep->getRobberExit();
+	auto onExit = [&](Position p)
+	{
+		for (const auto& e : exits)
+			if (e.size() == 3 && p == Position(e[0], e[1], e[2])) return true;
+		return false;
+	};
+	auto carriesLoot = [&](BattleUnit* u)
+	{
+		for (auto* item : *u->getInventory())
+			if (std::find(dep->getRobberLoot().begin(), dep->getRobberLoot().end(), item->getRules()->getType()) != dep->getRobberLoot().end()) return true;
+		return false;
+	};
+	const int leaderId = sb.getVanStop("leader", -1);
+	auto carriersLeft = [&]()
+	{
+		for (auto* u : *sb.getUnits())
+			if (u->getOriginalFaction() == FACTION_HOSTILE && !u->isOut() && u->getId() != leaderId && carriesLoot(u)) return true;
+		return false;
+	};
+	auto escape = [&](BattleUnit* u)
+	{
+		sb.setVanStop("esc:" + std::to_string(u->getId()), 1);
+		u->setTile(nullptr, &sb);
+		u->setPosition(TileEngine::invalid);
+		u->goToTimeOut();
+		sb.setVanStop("escaped", sb.getVanStop("escaped") + 1);
+	};
+	if (!exits.empty() && joeTurn && turn > 1 && sb.getVanStop("alarm") && sb.getVanStop("lastExit", 0) != turn)
+	{
+		sb.setVanStop("lastExit", turn);
+		int gone = 0, cash = 0;
+		for (auto* u : *sb.getUnits())
+		{
+			if (u->getOriginalFaction() != FACTION_HOSTILE || u->isOut() || u->getId() == leaderId || !onExit(u->getPosition())) continue;
+			if (carriesLoot(u)) { cash++; sb.setVanStop("lootGone", 1); }
+			escape(u);
+			gone++;
+		}
+		BattleUnit* leader = unitById(leaderId);
+		bool leaderGone = false;
+		if (up(leader) && onExit(leader->getPosition()) && !carriersLeft())
+		{
+			if (carriesLoot(leader)) sb.setVanStop("lootGone", 1);
+			escape(leader);
+			sb.setVanStop("leaderGone", 1);
+			leaderGone = true;
+		}
+		if (gone || leaderGone) Log(LOG_INFO) << "VANSTOP robbers gone " << gone << " with cash " << cash << (leaderGone ? " + leader" : "") << " turn " << turn;
+		if (leaderGone) add(tr("STR_ROBBERY_LEADER_GONE"));
+		if (cash) add(tr("STR_ROBBERY_CASH_GONE").arg(cash));
+		else if (gone) add(tr("STR_ROBBERY_ROBBER_GONE").arg(gone));
+		if (gone || leaderGone) sb.getTileEngine()->recalculateFOV();
+	}
+	// who runs for the van this Cobra turn (read by AIModule::think)
+	if (!exits.empty() && sb.getSide() == FACTION_HOSTILE)
+	{
+		const bool alarm = sb.getVanStop("alarm");
+		const bool left = carriersLeft();
+		for (auto* u : *sb.getUnits())
+		{
+			if (u->getOriginalFaction() != FACTION_HOSTILE || u->isOut()) continue;
+			bool run = alarm && (u->getId() == leaderId ? !left : carriesLoot(u));
+			sb.setVanStop("run:" + std::to_string(u->getId()), run ? 1 : 0);
+		}
+	}
+
+	// 4. the lookout, on the Joe turn before the backup arrives
+	if (joeTurn && sb.getVanStop("call") && turn == sb.getVanStop("backupTurn", -1) && !sb.getVanStop("lookout"))
+	{
+		bool seen = false;
+		for (auto* u : *sb.getUnits())
+		{
+			if (u->getOriginalFaction() != FACTION_PLAYER || u->isOut()) continue;
+			for (const auto& r : dep->getLookouts())
+			{
+				if (inRect(r, u->getPosition(), 0)) { seen = true; break; }
+			}
+			if (seen) break;
+		}
+		if (seen)
+		{
+			sb.setVanStop("lookout", 1);
+			Log(LOG_INFO) << "VANSTOP lookout turn " << turn;
+			add(tr("STR_VANSTOP_LOOKOUT"));
+		}
+	}
+
+	// 5. the driver and the man on the phone are busy: no time for anything else.
+	// And before the alarm nobody on Cobra's side does anything: they don't know the Joes are there.
+	if (sb.getSide() == FACTION_HOSTILE)
+	{
+		if (!sb.getVanStop("alarm") && dep->getQuietUntilAlarm())
+		{
+			for (auto* u : *sb.getUnits())
+			{
+				if (u->getOriginalFaction() == FACTION_HOSTILE && !u->isOut()) u->setTimeUnits(0);
+			}
+		}
+		if (up(driver) && !sb.getVanStop("gone")) driver->setTimeUnits(0);
+		if (up(caller) && !sb.getVanStop("call")) caller->setTimeUnits(0);
+	}
+	return msg;
+}
