+	struct Face
+	{
+		Img img; int em = 0, asc = 0, desc = 0, cap = 0; bool ok = false;
+		struct G { int x = 0, y = 0, w = 0, h = 0, l = 0, t = 0; float adv = 0; bool ok = false; } g[256];
+	};
+	std::unordered_map<std::string, Face> faces;
+	const Face *face(const std::string &name)
+	{
+		auto it = faces.find(name);
+		if (it != faces.end()) return it->second.ok ? &it->second : nullptr;
+		Face f;
+		const std::string base = "Resources/UI/type_" + name;
+		f.img = loadPng(base + ".png");
+		if (f.img.ok && FileMap::fileExists(base + ".txt"))
+		{
+			auto in = FileMap::getIStream(base + ".txt");
+			if (in && (*in >> f.em >> f.asc >> f.desc >> f.cap))
+			{
+				int c, x, y, w, h, l, t; float adv;
+				while (*in >> c >> x >> y >> w >> h >> l >> t >> adv)
+					if (c >= 0 && c < 256) f.g[c] = Face::G{ x, y, w, h, l, t, adv, true };
+				f.ok = f.em > 0 && f.cap > 0;
+			}
+		}
+		if (f.ok) Log(LOG_INFO) << "Typeface: " << name << " (em " << f.em << ")";
+		else Log(LOG_WARNING) << "Typeface missing: " << base;
+		auto &slot = faces[name] = std::move(f);
+		return slot.ok ? &slot : nullptr;
+	}
+
+	/// UTF-8 to the face's Latin-1 range; control tokens dropped, line breaks kept.
+	std::vector<int> latin1(const std::string &s)
+	{
+		std::vector<int> out;
+		for (size_t i = 0; i < s.size();)
+		{
+			unsigned char c = (unsigned char)s[i];
+			int cp, n;
+			if (c < 0x80) { cp = c; n = 1; }
+			else if ((c >> 5) == 6) { cp = c & 0x1F; n = 2; }
+			else if ((c >> 4) == 14) { cp = c & 0x0F; n = 3; }
+			else { cp = c & 0x07; n = 4; }
+			for (int k = 1; k < n && i + k < s.size(); ++k) cp = (cp << 6) | ((unsigned char)s[i + k] & 0x3F);
+			i += n;
+			if (cp == '\n' || cp == 2) { out.push_back('\n'); continue; }
+			if (cp < 32) continue;
+			// the faces carry the en and em dash at their Windows-1252 codes
+			if (cp == 0x2013) { out.push_back(150); continue; }
+			if (cp == 0x2014) { out.push_back(151); continue; }
+			out.push_back(cp < 256 ? cp : '?');
+		}
+		return out;
+	}
+
+	double lineWidth(const Face &f, const std::vector<int> &s, size_t a, size_t b, double size)
+	{
+		double w = 0;
+		for (size_t i = a; i < b; ++i) if (f.g[s[i]].ok) w += f.g[s[i]].adv;
+		return w * size / f.em;
+	}
+
+	/// One line of type. Each output pixel takes the AREA average of the atlas
+	/// under it, which is what makes a 96 px master come down to 20 px clean.
+	void drawLine(const Face &f, const std::vector<int> &s, size_t a, size_t b, double X, double baseline, double size,
+		Uint32 col, int cx0, int cy0, int cx1, int cy1)
+	{
+		const double k = size / f.em;
+		const int n = std::max(1, std::min(6, (int)std::ceil(1.0 / k)));
+		cx0 = std::max(cx0, 0); cy0 = std::max(cy0, 0); cx1 = std::min(cx1, sw); cy1 = std::min(cy1, sh);
+		double pen = X;
+		const double top = baseline - f.asc * k;
+		for (size_t i = a; i < b; ++i)
+		{
+			const Face::G &g = f.g[s[i]];
+			if (!g.ok) continue;
+			if (g.w > 0 && g.h > 0)
+			{
+				const double gx0 = pen + g.l * k, gy0 = top + g.t * k;
+				const int X0 = std::max(cx0, (int)std::floor(gx0)), X1 = std::min(cx1, (int)std::ceil(gx0 + g.w * k));
+				const int Y0 = std::max(cy0, (int)std::floor(gy0)), Y1 = std::min(cy1, (int)std::ceil(gy0 + g.h * k));
+				for (int Y = Y0; Y < Y1; ++Y)
+				{
+					Uint32 *o = over.data() + (size_t)Y * sw;
+					for (int Xp = X0; Xp < X1; ++Xp)
+					{
+						int sum = 0;
+						for (int sy = 0; sy < n; ++sy)
+						{
+							const double fy = (Y + (sy + 0.5) / n - gy0) / k;
+							if (fy < 0 || fy >= g.h) continue;
+							const Uint32 *row = f.img.px.data() + (size_t)(g.y + (int)fy) * f.img.w + g.x;
+							for (int sx = 0; sx < n; ++sx)
+							{
+								const double fx = (Xp + (sx + 0.5) / n - gx0) / k;
+								if (fx < 0 || fx >= g.w) continue;
+								sum += row[(int)fx] >> 24;
+							}
+						}
+						const int cov = sum / (n * n);
+						if (cov > 0) o[Xp] = mix(o[Xp], col, std::min(255, cov));
+					}
+				}
+			}
+			pen += g.adv * k;
+		}
+	}
+
+	/// Set a string inside a display rectangle: size from the wanted cap height,
+	/// shrunk if a line would not fit across, aligned as asked.
+	void setType(const Face &f, const std::string &str, int X0, int Y0, int X1, int Y1, double capPx, double lineH,
+		int halign, int valign, Uint32 col, bool keepInside = true)
+	{
+		const std::vector<int> s = latin1(str);
+		double size = capPx * f.em / f.cap;
+		std::vector<std::pair<size_t, size_t> > lines;
+		size_t a = 0;
+		for (size_t i = 0; i <= s.size(); ++i)
+			if (i == s.size() || s[i] == '\n') { lines.emplace_back(a, i); a = i + 1; }
+		if (keepInside)
+			for (auto &l : lines)
+			{
+				const double w = lineWidth(f, s, l.first, l.second, size);
+				if (w > X1 - X0 - 1) size *= (X1 - X0 - 1) / w;
+			}
+		const double cap = f.cap * size / f.em;
+		const double total = lineH * (lines.size() - 1) + cap;
+		double y = valign == 1 ? (Y0 + Y1 - total) / 2 : valign == 2 ? Y1 - total - (lineH - cap) / 2 : Y0 + (lineH - cap) / 2;
+		for (auto &l : lines)
+		{
+			const double w = lineWidth(f, s, l.first, l.second, size);
+			const double x = halign == 1 ? (X0 + X1 - w) / 2 : halign == 2 ? X1 - w : X0;
+			drawLine(f, s, l.first, l.second, x, y + cap, size, col, X0 - 2, Y0 - 2, X1 + 2, Y1 + 2);
+			y += lineH;
+		}
+	}
