+#pragma once
+/*
+ * G.I. Joe: the TEST RANGE (BUILD-2, John 17 Nov 2026 19:33). A New Battle mission, STR_GJ_TESTBED, that starts with
+ * every named Joe, every Joe vehicle and every piece of kit on the ground at the start, against one of every Cobra
+ * unit standing still with no ammo. For looking at things and trying them, not for play.
+ * Rules: mod/Ruleset/zz_gijoe_testbed.rul (the deployment lists the Cobra side by customUnitType).
+ */
+#include <string>
+
+namespace OpenXcom
+{
+
+class Mod;
+class SavedGame;
+class Base;
+class Craft;
+class SavedBattleGame;
+class BattleUnit;
+struct BattleAction;
+
+namespace Testbed
+{
+	/// the mission type
+	extern const char *MISSION;
+	bool is(const std::string &missionType);
+	bool is(const SavedBattleGame *save);
+	/// New Battle, OK pressed on the test range: every named Joe and every Joe vehicle aboard, whatever the craft holds
+	void loadNewBattle(const Mod *mod, SavedGame *save, Base *base, Craft *craft);
+	/// end of battle generation: Cobra loses its grenades and loose clips, every gun is emptied, no TU for reactions
+	void prepare(SavedBattleGame *save);
+	/// Cobra's turn on the test range: nobody moves (and nobody has TU left to react with on the Joes' turn)
+	bool freeze(SavedBattleGame *save, BattleUnit *unit, BattleAction *action);
+}
+
+}
