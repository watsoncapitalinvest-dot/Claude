+/// THROW, STRIKE, RELOAD, SWAP under a hand card.
+void BattlescapeState::hudFootClick(Action *action)
+{
+	if (!playableUnitSelected() || _battleGame->isBusy()) return;
+	BattleUnit *u = _save->getSelectedUnit();
+	for (int hnd = 0; hnd < 2; ++hnd)
+		for (int j = 0; j < 4; ++j)
+		{
+			if (action->getSender() != _hudFoot[hnd][j]) continue;
+			BattleItem *item = hnd == 0 ? u->getRightHandWeapon() : u->getLeftHandWeapon();
+			if (j == 3)
+			{
+				// SWAP: the two hands change what they hold
+				BattleItem *r = u->getRightHandWeapon(), *l = u->getLeftHandWeapon();
+				if (!r && !l) return;
+				_battleGame->cancelCurrentAction();
+				if (r) r->setSlot(_game->getMod()->getInventoryLeftHand());
+				if (l) l->setSlot(_game->getMod()->getInventoryRightHand());
+				updateSoldierInfo(); refreshJoeHud();
+				return;
+			}
+			if (j == 2) { if (hnd == 0) u->setActiveRightHand(); else u->setActiveLeftHand(); btnReloadClick(action); return; }
+			if (!item) return;
+			_battleGame->cancelCurrentAction();
+			if (hnd == 0) u->setActiveRightHand(); else u->setActiveLeftHand();
+			_battleGame->getCurrentAction()->weapon = item;
+			ActionMenuState *menu = new ActionMenuState(_battleGame->getCurrentAction(), _icons->getX(), _icons->getY() + 16);
+			menu->autoPick(j == 0 ? BA_THROW : BA_HIT);
+			popup(menu);
+			return;
+		}
+}
