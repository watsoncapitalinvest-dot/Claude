@@ -0,0 +1,71 @@
+/*
+ * G.I. Joe: stop and search. See ShipStopState.h.
+ */
+#include "ShipStopState.h"
+#include "../Engine/Game.h"
+#include "../Engine/Options.h"
+#include "../Interface/TextButton.h"
+#include "../Interface/Window.h"
+#include "../Interface/Text.h"
+#include "GeoscapeState.h"
+
+namespace OpenXcom
+{
+
+ShipStopState::ShipStopState(GeoscapeState *state, const std::string &title, const std::string &body, bool canSearch, bool canFire, const std::string &searchLabel) : _state(state)
+{
+	_screen = false;
+	_window = new Window(this, 256, 160, 32, 20, POPUP_BOTH);
+	_txtTitle = new Text(236, 17, 42, 30);
+	_txtBody = new Text(236, 90, 42, 50);
+	_btnSearch = new TextButton(76, 18, 42, 150);
+	_btnFire = new TextButton(76, 18, 122, 150);
+	_btnGo = new TextButton(76, 18, 202, 150);
+
+	setInterface("craftError");
+	add(_window, "window", "craftError");
+	add(_txtTitle, "text1", "craftError");
+	add(_txtBody, "text1", "craftError");
+	add(_btnSearch, "button", "craftError");
+	add(_btnFire, "button", "craftError");
+	add(_btnGo, "button", "craftError");
+	centerAllSurfaces();
+	setWindowBackground(_window, "craftError");
+
+	_txtTitle->setAlign(ALIGN_CENTER);
+	_txtTitle->setBig();
+	_txtTitle->setText(title);
+	_txtBody->setAlign(ALIGN_CENTER);
+	_txtBody->setWordWrap(true);
+	_txtBody->setText(body);
+
+	_btnSearch->setText(tr(searchLabel));
+	_btnSearch->onMouseClick((ActionHandler)&ShipStopState::btnSearchClick);
+	_btnSearch->setVisible(canSearch);
+	_btnFire->setText(tr("STR_SHIP_OPEN_FIRE"));
+	_btnFire->onMouseClick((ActionHandler)&ShipStopState::btnFireClick);
+	_btnFire->setVisible(canFire);
+	_btnGo->setText(tr("STR_SHIP_LET_GO"));
+	_btnGo->onMouseClick((ActionHandler)&ShipStopState::btnGoClick);
+	_btnGo->onKeyboardPress((ActionHandler)&ShipStopState::btnGoClick, Options::keyCancel);
+}
+
+void ShipStopState::btnSearchClick(Action *)
+{
+	_game->popState();
+	_state->shipDecision(0);
+}
+
+void ShipStopState::btnFireClick(Action *)
+{
+	_game->popState();
+	_state->shipDecision(1);
+}
+
+void ShipStopState::btnGoClick(Action *)
+{
+	_game->popState();
+	_state->shipDecision(2);
+}
+
+}
