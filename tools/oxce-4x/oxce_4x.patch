+/**
+ * Turns a finished research topic into LEADS on the globe.
+ *
+ * Spine row 19 is "reveals hidden Terror Dromes on the globe", and the design
+ * is careful that intel is not the same thing as knowing: the player learns a
+ * Drome is out there and roughly where, not its doorstep. So this does NOT
+ * call AlienBase::setDiscovered - the site stays hidden and its own marker
+ * stays off - and instead drops a GlobeMark with fromIntel set.
+ *
+ * That flag is the whole point. Globe::drawMarks already ages an intel mark
+ * down a confidence tier once it is MARK_STALE_MONTHS old, while a pin the
+ * player placed himself never decays, because he is not guessing about his own
+ * guess. Until this existed nothing in the game ever set fromIntel, so the
+ * situation board had a confidence ladder with only the player's own rungs on
+ * it.
+ *
+ * @param siteType the Cobra site type the topic gives a lead on.
+ * @return how many leads were dropped.
+ */
+int SavedGame::addCobraSiteIntel(const std::string &siteType)
+{
+	int dropped = 0;
+	for (auto* ab : _alienBases)
+	{
+		if (ab->getSiteType() != siteType || ab->isDiscovered())
+		{
+			continue;
+		}
+		// one lead per site, however many topics point at it
+		bool already = false;
+		for (const auto& m : _globeMarks)
+		{
+			if (m.fromIntel && std::abs(m.lon - ab->getLongitude()) < 0.0001
+				&& std::abs(m.lat - ab->getLatitude()) < 0.0001)
+			{
+				already = true;
+				break;
+			}
+		}
+		if (already)
+		{
+			continue;
+		}
+		GlobeMark mark;
+		mark.id = ++_globeMarkId;
+		mark.lon = ab->getLongitude();
+		mark.lat = ab->getLatitude();
+		mark.kind = GlobeMark::MARK_PIN;
+		mark.trust = GlobeMark::TRUST_LIKELY;
+		mark.fromIntel = true;
+		mark.placedMonth = _monthsPassed;
+		// the site type is the label a lead can honestly carry: the player has
+		// heard there is a Drome here, not what Cobra calls it
+		mark.label = ab->getSiteType();
+		_globeMarks.push_back(mark);
+		++dropped;
+	}
