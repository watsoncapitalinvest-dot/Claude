+/**
+ * G.I. Joe 4x (John, 15 Nov: "the aim cursor needs to be redone in vector", "the selection box
+ * needs to look more interesting and modern"). The 8-bit CURSOR.PCK box and crosshair, drawn
+ * again as anti-aliased strokes at the display's resolution: a floor plate with lit corner
+ * brackets and a ghost of the cube above it; on aim, a ring with four ticks over the man's chest.
+ * Amber when there is a man in the tile, cyan when it is empty (red on aim), blue a level down.
+ */
+void Map::vecCursor(Position sp, int kind, bool onUnit)
+{
+	const double hr = Screen::hiRes();   // the hi-res map is hr times the base frame
+	const double s = _spriteWidth / 32.0 / hr;
+	const double X = getX() + sp.x / hr, Y = getY() + sp.y / hr;
+	auto P = [&](double x, double y) { return std::make_pair(X + x * s, Y + y * s); };
+	const double ph = (_animFrame % 8) / 8.0 * 6.283185307;
+	const double breathe = 0.5 + 0.5 * std::sin(ph);
+	Uint32 rgb = kind == 1 ? 0x5C8DFF : kind == 2 ? (onUnit ? 0xFFC83C : 0xFF3B30) : (onUnit ? 0xFFC83C : 0x7FE3FF);
+	auto line = [&](std::pair<double,double> a, std::pair<double,double> b, int alpha, double w)
+	{
+		HiUI::vectorLine(HiUI::VEC_MAP, a.first, a.second, b.first, b.second, ((Uint32)alpha << 24) | rgb, w);
+	};
+	auto lerp = [](std::pair<double,double> a, std::pair<double,double> b, double t)
+	{
+		return std::make_pair(a.first + (b.first - a.first) * t, a.second + (b.second - a.second) * t);
+	};
+	// glow then core, so every mark has a soft halo and a hard edge
+	auto mark = [&](std::pair<double,double> a, std::pair<double,double> b, int alpha)
+	{
+		line(a, b, alpha / 4, 7.0);
+		line(a, b, alpha, 2.4);
+	};
+	const std::pair<double,double> f[4] = { P(16, 24), P(32, 32), P(16, 40), P(0, 32) };   // floor diamond
+	const std::pair<double,double> t[4] = { P(16, 0), P(32, 8), P(16, 16), P(0, 8) };     // its top, a storey up
+	const int faint = kind == 1 ? 0x30 : 0x48;
+	for (int i = 0; i < 4; ++i) line(f[i], f[(i + 1) % 4], faint, 1.2);
+	if (kind != 2)
+	{
+		const double len = 0.22 + 0.08 * breathe;
+		const int bright = kind == 1 ? 0x90 : 0xF0;
+		for (int i = 0; i < 4; ++i)
+		{
+			mark(f[i], lerp(f[i], f[(i + 1) % 4], len), bright);
+			mark(f[i], lerp(f[i], f[(i + 3) % 4], len), bright);
+		}
+		if (kind == 0)
+		{
+			// the cube above: posts at the side corners fading upward, and a ghost of the top
+			for (int i = 1; i < 4; i += 2) line(f[i], lerp(f[i], t[i], 0.35), 0x70, 1.4);
+			for (int i = 0; i < 4; ++i) line(t[i], t[(i + 1) % 4], onUnit ? 0x50 : 0x26, 1.0);
+			// a soft fill line through the plate, east to west, breathing
+			line(lerp(f[3], f[1], 0.3), lerp(f[3], f[1], 0.7), (int)(0x30 + 0x30 * breathe), 1.0);
+		}
+		return;
+	}
+	// AIM: a ring at chest height, four ticks that close in when there is a man to shoot
+	const auto c = P(16, 18);
+	const double r = 8.5 * s;
+	const double spin = onUnit ? ph / 4 : 0.0;
+	const int ringA = 0xE8;
+	const int N = 28;
+	for (int i = 0; i < N; ++i)
+	{
+		// the ring is broken where the ticks cross it
+		const double a0 = (i + 0.0) / N * 6.283185307, a1 = (i + 1.0) / N * 6.283185307;
+		double mid = std::fmod((a0 + a1) / 2 - spin + 6.283185307 * 4, 1.5707963);
+		if (mid < 0.16 || mid > 1.5707963 - 0.16) continue;
+		mark(std::make_pair(c.first + r * std::cos(a0), c.second + r * std::sin(a0)), std::make_pair(c.first + r * std::cos(a1), c.second + r * std::sin(a1)), ringA);
+	}
+	const double in = (onUnit ? 0.35 + 0.1 * breathe : 0.55) * r, out = 1.35 * r;
+	for (int k = 0; k < 4; ++k)
+	{
+		const double a = spin + k * 1.5707963;
+		mark(std::make_pair(c.first + in * std::cos(a), c.second + in * std::sin(a)), std::make_pair(c.first + out * std::cos(a), c.second + out * std::sin(a)), 0xF8);
+	}
+	const double d = 0.9 * s;
+	mark(std::make_pair(c.first - d, c.second), std::make_pair(c.first + d, c.second), 0xFF);
+	mark(std::make_pair(c.first, c.second - d), std::make_pair(c.first, c.second + d), 0xFF);
+	// and where it stands: a faint line from the ring down to the plate
+	line(std::make_pair(c.first, c.second + out), lerp(f[0], f[2], 0.5), 0x40, 1.0);
+}
+
+/// A ring on the floor around a tile, radius in tiles, as vector strokes (the iso ellipse a circle on the ground makes).
+/**
+ * John 19 Nov 10:20 "I still don't know how to open the case or where the case is": every container a Joe can open
+ * (gijoeContainerParts) that is still shut and that the squad has seen gets a gold ring on its tile, so the things worth
+ * searching stand out. Empty ones are marked too - you only learn what is inside by opening it (face it, right-click).
+ */
+void Map::drawSearchMarks()
+{
+	if (!_save || !_save->getBattleGame()) return;
+	const Mod *mod = _save->getBattleGame()->getMod();
+	const int z = _camera->getViewLevel();
+	for (int y = 0; y < _save->getMapSizeY(); ++y)
+		for (int x = 0; x < _save->getMapSizeX(); ++x)
+		{
+			Tile *t = _save->getTile(Position(x, y, z));
+			if (!t || !t->isDiscovered(O_FLOOR)) continue;
+			MapData *obj = t->getMapData(O_OBJECT);
+			if (!obj || obj->getAltMCD() <= 0) continue;
+			int part = -1, setId = -1;
+			t->getMapData(&part, &setId, O_OBJECT);
+			if (part < 0 || !mod->isGijoeContainer(obj->getDataset()->getName(), part)) continue;
+			Position sp;
+			_camera->convertMapToScreen(t->getPosition(), &sp);
+			sp += _camera->getMapOffset();
+			// the graphics AI's search mark (Resources/UI/search_mark.png, a 2:1 ground diamond) on the tile; the rings
+			// stay as the fallback if the picture is missing
+			const double hr = Screen::hiRes(), sc = _spriteWidth / 32.0 / hr;
+			const double cx = getX() + sp.x / hr + 16 * sc, cy = getY() + sp.y / hr + 32 * sc;
+			if (!FileMap::fileExists("Resources/UI/search_mark.png"))
+			{
+				vecGroundRing(sp, 0.48, 0xE8B923, false, 0xC0);
+				vecGroundRing(sp, 0.30, 0xE8B923, true, 0x90);
+			}
+			else
+				HiUI::vectorImage(HiUI::VEC_MAP, "Resources/UI/search_mark.png", cx - 16 * sc, cy - 8 * sc, cx + 16 * sc, cy + 8 * sc, 230,
+					getY() + getHeight() / hr * 0.785);
+		}
+}
+
+void Map::vecGroundRing(Position sp, double radTiles, Uint32 rgb, bool dashed, int alpha)
+{
+	const double hr = Screen::hiRes();
+	const double s = _spriteWidth / 32.0 / hr;
+	const double cx = getX() + sp.x / hr + 16 * s, cy = getY() + sp.y / hr + 32 * s;   // the floor centre
+	auto at = [&](double a) { const double dx = radTiles * std::cos(a), dy = radTiles * std::sin(a);
+		return std::make_pair(cx + (dx - dy) * 16 * s, cy + (dx + dy) * 8 * s); };
+	const int N = std::max(24, (int)(radTiles * 20));
+	for (int i = 0; i < N; ++i)
+	{
+		if (dashed && (i % 2)) continue;
+		const auto a = at(i * 6.283185307 / N), b = at((i + 1) * 6.283185307 / N);
+		if (alpha >= 0x80) HiUI::vectorLine(HiUI::VEC_MAP, a.first, a.second, b.first, b.second, ((Uint32)(alpha / 5) << 24) | rgb, 6.0);
+		HiUI::vectorLine(HiUI::VEC_MAP, a.first, a.second, b.first, b.second, ((Uint32)alpha << 24) | rgb, alpha >= 0x80 ? 2.0 : 1.3);
+	}
+}
+
+void Map::vecGroundCone(Position sp, double ang, double half, double nearR, double farR, int level)
+{
+	const double hr = Screen::hiRes();
+	const double s = _spriteWidth / 32.0 / hr;
+	const double cx = getX() + sp.x / hr + 16 * s, cy = getY() + sp.y / hr + 32 * s;
+	auto at = [&](double a, double r) { const double dx = r * std::cos(a), dy = r * std::sin(a);
+		return std::make_pair(cx + (dx - dy) * 16 * s, cy + (dx + dy) * 8 * s); };
+	const Uint32 blue = 0x2A6FD6, edge = level == 2 ? 0xFF2A3A : level == 1 ? 0xFFB020 : 0;
+	const int N = (int)(farR * 6);
+	for (int i = 0; i <= N; ++i)
+	{
+		const double a = ang - half + 2 * half * i / N;
+		const auto o = at(a, 0.4), n = at(a, nearR), f = at(a, farR);
+		HiUI::vectorLine(HiUI::VEC_MAP, o.first, o.second, n.first, n.second, (0x22u << 24) | blue, 6.0);   // near band, deeper
+		HiUI::vectorLine(HiUI::VEC_MAP, n.first, n.second, f.first, f.second, (0x0Cu << 24) | blue, 6.0);
+	}
+	if (edge)
+	{
+		auto line = [&](std::pair<double, double> p, std::pair<double, double> q) {
+			HiUI::vectorLine(HiUI::VEC_MAP, p.first, p.second, q.first, q.second, (0x30u << 24) | edge, 7.0);   // glow
+			HiUI::vectorLine(HiUI::VEC_MAP, p.first, p.second, q.first, q.second, (0xD0u << 24) | edge, 2.0); };
+		line(at(ang - half, 0.4), at(ang - half, farR));
+		line(at(ang + half, 0.4), at(ang + half, farR));
+		for (int i = 0; i < N; ++i) line(at(ang - half + 2 * half * i / N, farR), at(ang - half + 2 * half * (i + 1) / N, farR));
+	}
+}
+
+/// the cones of every Cobra guard the player can see, on the level being viewed (stealth missions only)
+void Map::drawViewCones()
+{
+	if (getenv("OXCE_CONE_LOG")) { static int n = 0; if (n++ < 20) Log(LOG_INFO) << "[cones] hiui " << HiUI::active() << " stealth " << Stealth::on(_save); }
+	if (!HiUI::active() || !Stealth::on(_save) || getenv("OXCE_NO_CONES")) return;
+	static const int vx[8] = { 0, 1, 1, 1, 0, -1, -1, -1 }, vy[8] = { -1, -1, 0, 1, 1, 1, 0, -1 };
+	for (auto *u : *_save->getUnits())
+	{
+		if (u->isOut() || u->getFaction() != FACTION_HOSTILE || !u->getVisible() || !u->getTile()) continue;
+		if (u->isHandsUp() || u->isCuffed()) continue;   // surrendered or cuffed: he is watching nothing (John 19 Nov 10:17)
+		if (u->getPosition().z != _camera->getViewLevel()) continue;
+		const int st = Stealth::state(_save, u);
+		if (st == 1) continue;   // asleep: no cone
+		const int level = Stealth::alarm(_save) || st == 3 ? 2 : st == 2 ? 1 : 0;
+		const int d = u->getDirection() & 7;
+		{
+			const Position look = Stealth::lookTarget(_save, u);   // STEALTH SIGHT item 4: the spot he is going to check
+			if (look != TileEngine::invalid && look.z == _camera->getViewLevel())
+			{
+				Position lp; _camera->convertMapToScreen(look, &lp); lp += _camera->getMapOffset();
+				vecGroundRing(lp, 0.45, 0xFFB020, false, 0xD0);
+				vecGroundRing(lp, 0.25, 0xFFB020, true, 0xA0);
+			}
+		}
+		Position sp;
+		_camera->convertMapToScreen(u->getPosition(), &sp);
+		sp += _camera->getMapOffset();
+		{
+			// John's three cones (18 Nov 22:04), laid on the ground by build/make_view_cones.py: canvas 2R*32 x 2R*16 base px
+			// centred on the guard's floor centre (R = 14 tiles, the same as the script). The vector cone stays as a fallback.
+			static const char *LV[3] = { "unaware", "suspicious", "alert" };
+			// John 22:07 "size them correctly": the reach is this guard's own eyesight now (day or dark, by the map's light,
+			// as the engine's sight check uses), not a fixed 14. The pictures were drawn at 14 tiles: the box scales with R.
+			const bool darkNow = _save->getGlobalShade() > _save->getMod()->getMaxDarknessToSeeUnits();
+			const double hr = Screen::hiRes(), sc = _spriteWidth / 32.0 / hr;
+			// John 22:24 "10": drawn 10 tiles long (shorter if his eyesight is shorter, e.g. in the dark) so it reads on screen
+			const double R = (st == 0 && Stealth::job(_save, u) == Stealth::OFF_DUTY) ? 3.0 : std::min(Stealth::elite(u) ? 13 : 10, std::max(3, darkNow ? u->getMaxViewDistanceAtDark(nullptr) : u->getMaxViewDistanceAtDay(nullptr)));
+			const double cx = getX() + sp.x / hr + 16 * sc, cy = getY() + sp.y / hr + 32 * sc;
+			const std::string f = std::string("Resources/UI/Cones/cone_") + LV[level] + "_" + std::to_string(d) + ".png";
+			// John 22:34 "Can they see through walls" - they cannot, so the cone shows only on tiles he can see: a sight line from
+			// his eyes to chest height over each tile in his arc, worked out once per guard, place, facing and turn.
+			struct ConeMask { int key; std::vector<unsigned char> m; };
+			static std::map<int, ConeMask> masks;
+			static const SavedBattleGame *maskSave = nullptr;
+			if (maskSave != _save) { masks.clear(); maskSave = _save; }
+			const Position up = u->getPosition();
+			const int Ri = (int)R, MW = Ri * 2 * 8, MH = Ri * 2 * 4;   // 8 x 4 mask cells per tile across the iso box
+			const int key = ((up.x * 64 + up.y) * 16 + up.z) * 8 + d + _save->getTurn() * 1000003;
+			ConeMask &cm = masks[u->getId()];
+			if (cm.key != key || cm.m.empty())
+			{
+				cm.key = key; cm.m.assign((size_t)MW * MH, 0);
+				TileEngine *te = _save->getTileEngine();
+				const Position eye = te->getSightOriginVoxel(u);
+				const double fx = vx[d], fy = vy[d], fl = std::sqrt(fx * fx + fy * fy);
+				for (int dy = -Ri; dy <= Ri; ++dy)
+					for (int dx = -Ri; dx <= Ri; ++dx)
+					{
+						const double dist = std::sqrt((double)dx * dx + dy * dy);
+						if (dist > R + 0.5) continue;
+						if (dist > 0.5 && (dx * fx + dy * fy) / (dist * fl) < std::cos(0.80)) continue;   // outside his arc
+						Tile *t = _save->getTile(up + Position(dx, dy, 0));
+						if (!t) continue;
+						bool seen = dist < 1.5;
+						if (!seen)
+						{
+							const Position target((up.x + dx) * 16 + 8, (up.y + dy) * 16 + 8, up.z * 24 + 12);
+							const VoxelType v = te->calculateLineVoxel(eye, target, false, nullptr, u);
+							seen = v == V_EMPTY || v == V_UNIT;
+						}
+						if (!seen) continue;
+						// the tile's diamond in mask cells (centre of the box = the guard's tile)
+						const double mx = MW / 2.0 + (dx - dy) * 4.0, my = MH / 2.0 + (dx + dy) * 2.0;
+						for (int yy = (int)(my - 2); yy <= (int)(my + 2); ++yy)
+							for (int xx = (int)(mx - 4); xx <= (int)(mx + 4); ++xx)
