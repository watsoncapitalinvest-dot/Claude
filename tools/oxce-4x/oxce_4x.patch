+#pragma once
+/*
+ * G.I. Joe: placing a bought room on the Pit's blueprint (PIT_FLOORS_v1 s.1 v2). The sheet of its own floor;
+ * the module follows the mouse, green where it fits, red where it doesn't; right-click (or R) turns it;
+ * left-click builds it there. Moving a room = dismantle + rebuild (STORY's default).
+ */
+#include "../Engine/State.h"
+
+namespace OpenXcom
+{
+
+class Base;
+class RuleBaseFacility;
+class PitBlueprintView;
+class TextButton;
+class Window;
+class Text;
+
+class PitPlaceState : public State
+{
+	Base *_base;
+	const RuleBaseFacility *_rule;
+	PitBlueprintView *_view;
+	TextButton *_btnCancel;
+	Window *_window;
+	Text *_txtFacility, *_txtCost, *_numCost, *_txtTime, *_numTime, *_txtHow, *_txtFit;
+	std::string _lastWhy = "?";
+public:
+	PitPlaceState(Base *base, const RuleBaseFacility *rule);
+	~PitPlaceState();
+	void think() override;
+	void btnCancelClick(Action *action);
+	void viewClick(Action *action);
+	void viewTurn(Action *action);
+};
+
+}
