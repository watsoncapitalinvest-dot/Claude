+// ---- HeldJoeState -------------------------------------------------------------------------------
+
+namespace
+{
+/// A Cobra prisoner's rank, on the Joes' ladder (0 rookie .. 5 commander), from his unit rank.
+int prisonerTier(const Mod *mod, const RuleItem *item)
+{
+	const Unit *u = mod->getUnit(item->getType());
+	if (!u) return 0;
+	const std::string &r = u->getRank();
+	if (r == "STR_LIVE_COMMANDER") return 5;
+	if (r == "STR_LIVE_LEADER") return 4;
+	if (r == "STR_LIVE_ENGINEER") return 2;
+	if (r == "STR_LIVE_MEDIC" || r == "STR_LIVE_NAVIGATOR") return 1;
+	return 0;
+}
+}
+
+HeldJoeState::HeldJoeState(Soldier *soldier) : _soldier(soldier), _offer(0), _cash(0)
+{
+	_screen = false;
+	_window = new Window(this, 256, 140, 32, 30, POPUP_BOTH);
+	_txtTitle = new Text(236, 17, 42, 40);
+	_txtBody = new Text(228, 72, 46, 60);
+	_btnTrade = new TextButton(72, 14, 42, 148);
+	_btnRescue = new TextButton(72, 14, 124, 148);
+	_btnCancel = new TextButton(72, 14, 206, 148);
+	setInterface("fundingWindow");
+	add(_window, "window", "fundingWindow");
+	add(_txtTitle, "text1", "fundingWindow");
+	add(_txtBody, "text2", "fundingWindow");
+	add(_btnTrade, "button", "fundingWindow");
+	add(_btnRescue, "button", "fundingWindow");
+	add(_btnCancel, "button", "fundingWindow");
+	centerAllSurfaces();
+	setWindowBackground(_window, "fundingWindow");
+
+	const Mod *mod = _game->getMod();
+	SavedGame *save = _game->getSavedGame();
+	_txtTitle->setBig();
+	_txtTitle->setAlign(ALIGN_CENTER);
+	_txtTitle->setText(_soldier->getName());
+
+	// The trade: the Cobra prisoner closest to his rank, preferring one at or above it, so the
+	// cash only ever tops up a gap Cobra is short on (John: rank for rank, money to balance).
+	const int joeTier = (int)_soldier->getRank();
+	Base *from = 0;
+	int bestScore = 1 << 30;
+	for (auto *base : *save->getBases())
+	{
+		for (const auto &it : *base->getStorageItems()->getContents())
+		{
+			if (it.second <= 0 || !it.first->isAlien()) continue;
+			const int tier = prisonerTier(mod, it.first);
+			const int score = tier >= joeTier ? (tier - joeTier) : 100 + (joeTier - tier);
+			if (score < bestScore)
+			{
+				bestScore = score;
+				_offer = it.first;
+				from = base;
+			}
+		}
+	}
+	std::ostringstream body;
+	body << tr("STR_HELD_FOR_DAYS").arg(save->getHeldDays(_soldier->getId()));
+	if (_offer)
+	{
+		const int gap = std::max(0, joeTier - prisonerTier(mod, _offer));
+		_cash = (int64_t)gap * mod->getTradeCashPerRank();
+		body << "\n\n" << tr("STR_TRADE_OFFER").arg(tr(_offer->getType())).arg(tr(from->getName()));
+		if (_cash > 0)
+			body << "\n" << tr("STR_TRADE_CASH").arg(Unicode::formatFunding(_cash));
+		if (_cash > save->getFunds())
+		{
+			body << "\n" << tr("STR_TRADE_NO_FUNDS");
+			_offer = 0;
+		}
+	}
+	else
+	{
+		body << "\n\n" << tr("STR_TRADE_NO_PRISONER");
+	}
+	_txtBody->setWordWrap(true);
+	_txtBody->setText(body.str());
+
+	_btnTrade->setText(tr("STR_TRADE"));
+	_btnTrade->onMouseClick((ActionHandler)&HeldJoeState::btnTradeClick);
+	_btnTrade->setVisible(_offer != 0);
+	_btnRescue->setText(tr("STR_RESCUE"));
+	_btnRescue->onMouseClick((ActionHandler)&HeldJoeState::btnRescueClick);
+	_btnCancel->setText(tr("STR_CANCEL"));
+	_btnCancel->onMouseClick((ActionHandler)&HeldJoeState::btnCancelClick);
+	_btnCancel->onKeyboardPress((ActionHandler)&HeldJoeState::btnCancelClick, Options::keyCancel);
+}
+
+void HeldJoeState::btnTradeClick(Action *)
+{
+	if (!_offer) return;
+	SavedGame *save = _game->getSavedGame();
+	Base *home = 0;
+	for (auto *base : *save->getBases())
+	{
+		if (base->getStorageItems()->getItem(_offer) > 0)
+		{
+			base->getStorageItems()->removeItem(_offer);
+			home = base;
+			break;
+		}
+	}
+	if (!home) { _game->popState(); return; }
+	save->setFunds(save->getFunds() - _cash);
+	save->returnCapturedSoldier(_soldier, home);
+	save->addLeadNews(std::string("!") + std::string(tr("STR_TRADE_DONE").arg(_soldier->getName())));
+	_game->popState();
+}
+
+void HeldJoeState::btnRescueClick(Action *)
+{
+	// The rescue mission waits on its map (claude/CAPTURE_DESIGN_v1.md); say so rather than do nothing.
+	_txtBody->setText(tr("STR_RESCUE_NOT_YET"));
+	_btnRescue->setVisible(false);
+	_btnTrade->setVisible(false);
+}
+
+void HeldJoeState::btnCancelClick(Action *)
+{
+	_game->popState();
+}
+
+// ---- SendSpyState -------------------------------------------------------------------------------
+
+SendSpyState::SendSpyState(const std::string &op) : _op(op)
+{
+	_screen = false;
+	_window = new Window(this, 256, 160, 32, 20, POPUP_BOTH);
+	_txtTitle = new Text(236, 17, 42, 30);
+	_txtBody = new Text(228, 48, 46, 50);
+	_lstSpies = new TextList(220, 56, 46, 102);
+	_btnCancel = new TextButton(80, 14, 120, 162);
+	setInterface("fundingWindow");
+	add(_window, "window", "fundingWindow");
+	add(_txtTitle, "text1", "fundingWindow");
+	add(_txtBody, "text2", "fundingWindow");
+	add(_lstSpies, "list", "fundingWindow");
+	add(_btnCancel, "button", "fundingWindow");
+	centerAllSurfaces();
+	setWindowBackground(_window, "fundingWindow");
+
+	const Mod *mod = _game->getMod();
+	SavedGame *save = _game->getSavedGame();
+	const Mod::SpyOperationRule *rule = mod->getSpyOperation(_op);
+	_txtTitle->setBig();
+	_txtTitle->setAlign(ALIGN_CENTER);
+	_txtTitle->setText(tr(_op));
+	std::ostringstream body;
+	if (rule && !rule->desc.empty()) body << tr(rule->desc);
+	body << "\n" << tr("STR_SPY_AWAY_DAYS").arg(rule ? rule->days : 5);
+	_txtBody->setWordWrap(true);
+	_txtBody->setText(body.str());
+
+	// Spies at home and fit: not wounded, not on a craft that is out.
+	_lstSpies->setColumns(2, 140, 80);
+	_lstSpies->setSelectable(true);
+	_lstSpies->setBackground(_window);
+	_lstSpies->onMouseClick((ActionHandler)&SendSpyState::lstSpiesClick);
+	for (auto *base : *save->getBases())
+	{
+		for (auto *s : *base->getSoldiers())
+		{
+			if (!mod->isSpy(s->getRules()->getType()) || s->isWounded() || s->isAway()) continue;
+			if (s->getCraft() && s->getCraft()->getStatus() == "STR_OUT") continue;
+			_spies.push_back(std::make_pair(s, base));
+			_lstSpies->addRow(2, s->getName().c_str(), base->getName().c_str());
+		}
+	}
+	if (_spies.empty())
+	{
+		_lstSpies->addRow(1, tr("STR_SPY_NONE_HOME").c_str());
+	}
+	_btnCancel->setText(tr("STR_CANCEL"));
+	_btnCancel->onMouseClick((ActionHandler)&SendSpyState::btnCancelClick);
+	_btnCancel->onKeyboardPress((ActionHandler)&SendSpyState::btnCancelClick, Options::keyCancel);
+}
+
+void SendSpyState::lstSpiesClick(Action *)
+{
+	unsigned row = _lstSpies->getSelectedRow();
+	if (row >= _spies.size()) return;
+	const Mod::SpyOperationRule *rule = _game->getMod()->getSpyOperation(_op);
+	if (_game->getSavedGame()->sendSpy(_spies[row].first, _spies[row].second, _op, rule ? rule->days : 5))
+	{
+		_game->getSavedGame()->addLeadNews(std::string(tr("STR_SPY_SENT").arg(_spies[row].first->getName()).arg(tr(_op))));
+	}
+	_game->popState();
+}
+
+void SendSpyState::btnCancelClick(Action *)
+{
+	_game->popState();
+}
+
+}
