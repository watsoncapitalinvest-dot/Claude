+void IntelBoardState::fill()
+{
+	const Mod *mod = _game->getMod();
+	SavedGame *save = _game->getSavedGame();
+	_lstBoard->clearList();
+	_heldRows.clear();
+	_opRows.clear();
+
+	auto header = [&](const std::string &key)
+	{
+		if (_lstBoard->getLastRowIndex() >= 0)
+		{
+			_lstBoard->addRow(1, "");
+		}
+		_lstBoard->addRow(1, tr(key).c_str());
+		_lstBoard->setRowColor(_lstBoard->getLastRowIndex(), _lstBoard->getSecondaryColor());
+	};
+
+	// open leads, in their file order
+	std::vector<const RuleLead*> open, solved;
+	for (const auto &id : mod->getLeadsList())
+	{
+		const RuleLead *rule = mod->getLead(id);
+		if (save->isLeadSolved(id))
+			solved.push_back(rule);
+		else if (save->getLeadPoints(id) > 0)
+			open.push_back(rule);
+	}
+	auto byOrder = [](const RuleLead *a, const RuleLead *b) { return a->getListOrder() < b->getListOrder(); };
+	std::stable_sort(open.begin(), open.end(), byOrder);
+	std::stable_sort(solved.begin(), solved.end(), byOrder);
+
+	header("STR_OPEN_LEADS");
+	if (open.empty())
+	{
+		_lstBoard->addRow(1, tr("STR_NO_OPEN_LEADS").c_str());
+	}
+	for (const auto *rule : open)
+	{
+		int have = save->getLeadPoints(rule->getType());
+		int need = rule->getThreshold();
+		const int cells = 10;
+		int lit = std::min(cells, have * cells / need);
+		std::string bar = std::string(lit, '|') + std::string(cells - lit, '.');
+		std::ostringstream pct;
+		pct << (have * 100 / need) << "%";
+		_lstBoard->addRow(3, tr(rule->getType()).c_str(), bar.c_str(), pct.str().c_str());
+	}
+
+	if (!solved.empty())
+	{
+		header("STR_SOLVED_LEADS");
+		for (const auto *rule : solved)
+		{
+			_lstBoard->addRow(3, tr(rule->getType()).c_str(), tr("STR_LEAD_DONE").c_str(), "");
+		}
+	}
+
+	// Cobra sites the Joes have found, and the ones they only have a pin on
+	header("STR_KNOWN_COBRA_SITES");
+	int known = 0;
+	for (const auto *ab : *save->getAlienBases())
+	{
+		if (!ab->isDiscovered())
+			continue;
+		Region *region = save->locateRegion(*ab);
+		std::string what = ab->getSiteType().empty() ? tr("STR_COBRA_SITE") : tr(ab->getSiteType());
+		_lstBoard->addRow(3, what.c_str(), region ? tr(region->getRules()->getType()).c_str() : "", "");
+		++known;
+	}
+	if (!known)
+	{
+		_lstBoard->addRow(1, tr("STR_NONE_FOUND_YET").c_str());
+	}
+	int pins = 0;
+	for (const auto &m : save->getGlobeMarks())
+	{
+		if (m.fromIntel)
+			++pins;
+	}
+	if (pins)
+	{
+		std::ostringstream p;
+		p << pins;
+		_lstBoard->addRow(3, tr("STR_UNCONFIRMED_PINS").c_str(), p.str().c_str(), "");
+	}
+
+	// G.I. Joe spy operations: the ones that can be sent (click to pick a spy) and the ones running.
+	{
+		std::vector<std::string> ready;
+		for (const auto &op : mod->getSpyOperations())
+		{
+			if (save->isSpyOpDone(op.type)) continue;
+			bool running = false;
+			for (const auto &m : save->getSpyMissions()) running = running || m.op == op.type;
+			if (running) continue;
+			bool open = op.requiresAny.empty();
+			for (const auto &r : op.requiresAny)
+				if (const RuleResearch *rr = mod->getResearch(r)) open = open || save->isResearched(rr);
+			if (open) ready.push_back(op.type);
+		}
+		if (!ready.empty() || !save->getSpyMissions().empty())
+		{
+			header("STR_SPY_OPERATIONS");
+			for (const auto &type : ready)
+			{
+				_lstBoard->addRow(3, tr(type).c_str(), tr("STR_SPY_SEND").c_str(), "");
+				_opRows.resize(_lstBoard->getLastRowIndex() + 1);
+				_opRows[_lstBoard->getLastRowIndex()] = type;
+			}
+			for (size_t i = 0; i < save->getSpyMissions().size(); ++i)
+			{
+				const auto &m = save->getSpyMissions()[i];
+				const Soldier *spy = save->getSpy(m);
+				std::string who = spy ? spy->getName() : "";
+				std::ostringstream d;
+				d << m.daysLeft;
+				_lstBoard->addRow(3, tr(m.op).c_str(), who.c_str(), tr("STR_DAYS_LEFT").arg(d.str()).c_str());
+			}
+		}
+	}
+
+	// G.I. Joe capture: Joes Cobra is holding. Click one to trade or rescue him.
+	if (!save->getCapturedSoldiers()->empty())
+	{
+		header("STR_HELD_BY_COBRA");
+		for (auto *s : *save->getCapturedSoldiers())
+		{
+			while ((int)_heldRows.size() <= (int)_lstBoard->getLastRowIndex() + 1) _heldRows.push_back(0);
+			std::ostringstream d;
+			d << save->getHeldDays(s->getId());
+			_lstBoard->addRow(3, s->getName().c_str(), tr(s->getRankString()).c_str(), tr("STR_DAYS_HELD").arg(d.str()).c_str());
+			_heldRows[_lstBoard->getLastRowIndex()] = s;
+		}
+	}
+
+	// craft out on recon: away from home with no destination, i.e. patrolling
+	header("STR_RECON_FLIGHTS");
+	int flying = 0;
+	for (const auto *base : *save->getBases())
+	{
+		for (const auto *craft : *base->getCrafts())
+		{
+			if (craft->getStatus() == "STR_OUT" && craft->getDestination() == 0)
+			{
+				_lstBoard->addRow(3, craft->getName(_game->getLanguage()).c_str(), tr("STR_ON_RECON").c_str(), "");
+				++flying;
+			}
+		}
+	}
+	if (!flying)
+	{
+		_lstBoard->addRow(1, tr("STR_NO_RECON_FLIGHTS").c_str());
+	}
+}
+
+void IntelBoardState::lstBoardClick(Action *)
+{
+	unsigned row = _lstBoard->getSelectedRow();
+	if (row < _heldRows.size() && _heldRows[row])
+	{
+		_game->pushState(new HeldJoeState(_heldRows[row]));
+	}
+	else if (row < _opRows.size() && !_opRows[row].empty())
+	{
+		_game->pushState(new SendSpyState(_opRows[row]));
+	}
+}
+
+void IntelBoardState::btnOkClick(Action *)
+{
+	_game->popState();
+}
+
+void IntelBoardState::btnGraphsClick(Action *)
+{
+	_game->pushState(new GraphsState);
+}
+
+void IntelBoardState::btnCobraClick(Action *)
+{
+	_game->pushState(new CobraIntelState);
+}
