+		for (const Position &e : events)
+		{
+			for (int z = std::max(1, (int)e.z); z <= e.z + 1 && z < _save->getMapSizeZ(); ++z)
+			{
+				int key = (e.x / 4) * 100000 + (e.y / 4) * 100 + z;   // events close together share one pass
+				if (!done.insert(key).second) continue;
+				const int x0 = e.x - WIN, y0 = e.y - WIN, n = WIN * 2 + 1;
+				// budget = how many more tiles of floor this cell can still carry outward.
+				// A support that is part of a run of supports (a wall line) carries SPAN; a lone stub carries 1.
+				std::vector<int> dist(n * n, -1);
+				std::vector<char> sup(n * n, 0);
+				for (int j = 0; j < n; ++j)
+					for (int i = 0; i < n; ++i)
+					{
+						Tile *t = _save->getTile(Position(x0 + i, y0 + j, z));
+						if (!solid(t)) continue;
+						bool border = (i == 0 || j == 0 || i == n - 1 || j == n - 1);
+						sup[j * n + i] = (border || indestructible(t)) ? 2 : (wallBelow(x0 + i, y0 + j, z) ? 1 : 0);
+					}
+				std::vector<int> queue;
+				const int dd[4][2] = { {1,0},{-1,0},{0,1},{0,-1} };
+				for (int j = 0; j < n; ++j)
+					for (int i = 0; i < n; ++i)
+					{
+						int c = j * n + i;
+						if (!sup[c]) continue;
+						bool run = sup[c] == 2;
+						for (auto &d : dd)
+						{
+							int ni = i + d[0], nj = j + d[1];
+							if (ni >= 0 && nj >= 0 && ni < n && nj < n && sup[nj * n + ni]) run = true;
+						}
+						dist[c] = run ? SPAN : 1;
+						queue.push_back(c);
+					}
+				for (size_t q = 0; q < queue.size(); ++q)
+				{
+					int c = queue[q], ci = c % n, cj = c / n;
+					if (dist[c] <= 0) continue;
+					for (auto &d : dd)
+					{
+						int ni = ci + d[0], nj = cj + d[1];
+						if (ni < 0 || nj < 0 || ni >= n || nj >= n) continue;
+						int k = nj * n + ni;
+						if (dist[k] >= dist[c] - 1) continue;
+						if (!solid(_save->getTile(Position(x0 + ni, y0 + nj, z)))) continue;
+						dist[k] = dist[c] - 1; queue.push_back(k);
+					}
+				}
+				for (int j = 0; j < n; ++j)
+					for (int i = 0; i < n; ++i)
+					{
+						Tile *t = _save->getTile(Position(x0 + i, y0 + j, z));
+						if (!t) continue;
+						if (solid(t))
+						{
+							if (dist[j * n + i] == -1) collapse(t);
+						}
+						else
+						{
+							// a wall with no floor under it stands only on the wall below it
+							Tile *b = _save->getTile(Position(x0 + i, y0 + j, z - 1));
+							for (TilePart part : { O_WESTWALL, O_NORTHWALL })
+							{
+								MapData *m = t->getMapData(part);
+								MapData *under = b ? b->getMapData(part) : nullptr;
+								bool held = under && (under->getLoftID(10) != 0 || under->getLoftID(11) != 0);
+								if (m && m->getArmor() != 255 && !held)
+								{
+									t->setMapData(nullptr, -1, -1, part);
+									Tile::destroyedLog.push_back(t->getPosition());
+									changed.push_back(t->getPosition());
+								}
+							}
+						}
+					}
+			}
+		}
+	}
+	Tile::destroyedLog.clear();
+	if (!changed.empty())
+	{
+		int minx = changed[0].x, maxx = minx, miny = changed[0].y, maxy = miny;
+		for (auto &p : changed) { minx = std::min(minx, (int)p.x); maxx = std::max(maxx, (int)p.x); miny = std::min(miny, (int)p.y); maxy = std::max(maxy, (int)p.y); }
+		Position c((minx + maxx) / 2, (miny + maxy) / 2, changed[0].z);
+		int r = std::max(maxx - minx, maxy - miny) / 2 + 2;
+		calculateLighting(LL_AMBIENT, c, r, true);
+		calculateFOV(c, r, true, true);
+	}
+}
