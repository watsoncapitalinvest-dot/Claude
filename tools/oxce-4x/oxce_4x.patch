+	inline Uint32 rgb(int r, int g, int b) { return ((Uint32)r << 16) | ((Uint32)g << 8) | (Uint32)b; }
+	inline Uint32 mix(Uint32 a, Uint32 b, int t) // t 0..255 of b
+	{
+		const int r = (((a >> 16) & 255) * (255 - t) + ((b >> 16) & 255) * t) / 255;
+		const int g = (((a >> 8) & 255) * (255 - t) + ((b >> 8) & 255) * t) / 255;
+		const int bl = ((a & 255) * (255 - t) + (b & 255) * t) / 255;
+		return rgb(r, g, bl);
+	}
+	inline const Uint8 *row8(int y) { return (const Uint8*)base->pixels + y * base->pitch; }
