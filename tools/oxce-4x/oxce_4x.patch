+			{
+				const double fx = (x + 0.5) * gw / W - 0.5; const int x0 = std::max(0, (int)std::floor(fx)), x1 = std::min(gw - 1, x0 + 1); const int wx = std::min(256, std::max(0, (int)((fx - x0) * 256)));
