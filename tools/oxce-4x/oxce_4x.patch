+ */
+#include "../Engine/State.h"
+
+namespace OpenXcom
+{
+
+class TextButton;
+class Window;
+class Text;
+class TextList;
+
+/**
+ * What the player has worked out about Cobra's network, region by region.
+ *
+ * It reports only what has been found. A site counts once its base is discovered, and the two
+ * figures are what those known sites are worth per month - not what the region is actually
+ * holding, which the player has no way of knowing. So the screen sharpens as the player finds
+ * more, which is what gives a research lab or a hidden HQ a job beyond its own production.
+ *
+ * The mirror of the funding screen, and reached from it: that one says what the world pays
+ * X-COM, this one says what Cobra is earning.
+ */
+class CobraIntelState : public State
+{
+private:
+	TextButton *_btnOk;
+	Window *_window;
+	Text *_txtTitle, *_txtRegion, *_txtSites, *_txtFunds, *_txtMateriel, *_txtNote;
+	TextList *_lstRegions;
+
+public:
+	CobraIntelState();
+	~CobraIntelState() = default;
+	void btnOkClick(Action *action);
+};
+
+}
diff --git a/src/Geoscape/CobraNetwork.cpp b/src/Geoscape/CobraNetwork.cpp
new file mode 100644
index 0000000..cf8402a
--- /dev/null
+++ b/src/Geoscape/CobraNetwork.cpp
@@ -0,0 +1,933 @@
+/*
+ * G.I. Joe 4x: the Act 1 campaign layer, pieces 1-5. See CobraNetwork.h.
+ *
+ * The answers it implements (claude/BRIEF_FOR_BUILD_Act1Layer_Part1_Answers.txt, all approved by John 17 Nov):
+ *  1  Cobra starts with 3 front companies, 2 depots and 2 cells, hidden, in towns rolled from a fixed North American list,
+ *     none within 300 km of the Pit and at least one within 1,500 km; 400 funds and 150 materiel. Every 6 months of head
+ *     start adds a front and a cell, every 12 a depot. Sites are spotted at half the usual chance; cells never from the air.
+ *  2  From month 2 each cell strikes a small local target 20% a month (x difficulty): 4-6 troopers, growing about one man
+ *     every 3 months to 8, an officer from month 4. A strike that gets away fills the cell's purse (80) and emboldens Cobra
+ *     in that region; at 300 a cell becomes a front company in its own town.
+ *  3  Each front company and cell tries a crime 25% a month (x difficulty, x1.25 the month after a getaway in its region).
+ *     Fronts: armored car, convoy, van stop. Cells: bank job, van stop. One crime per site a month; a stopped crime makes it
+ *     wait another. Stopped with the leader alive = its site found; stopped otherwise = one lead (2 leads = found); a
+ *     getaway pays 150 (the deployment's cobraPayoutFunds) and leaves one lead as a trail.
+ *  4  The front cap and the month's wait after a front is shut live in SavedGame::cobraPlan; this records the shutting.
+ *  5  The broadcast on its own day (20-60); the factory comes back on its day (50-60) unless the factory was won first,
+ *     with a warning 7 days before once the production schedule is researched.
+ * The warning network: informants or SIGINT give 2-3 days' notice; otherwise the police scanner gives 12 hours. No item
+ * called a police scanner exists in the game, so it is treated as standard kit (BUILD's call, 17 Nov).
+ */
+#include "CobraNetwork.h"
+#include "GeoscapeState.h"
+#include "../Engine/Game.h"
+#include "../Engine/Language.h"
+#include "../Engine/Logger.h"
+#include "../Engine/RNG.h"
+#include "../Mod/Mod.h"
+#include "../Mod/AlienDeployment.h"
+#include "../Mod/RuleRegion.h"
+#include "../Mod/RuleResearch.h"
+#include "../Mod/RuleCobraSite.h"
+#include "../Savegame/SavedGame.h"
+#include "../Savegame/AlienBase.h"
+#include "../Savegame/Base.h"
+#include "../Savegame/Soldier.h"
+#include "../Savegame/MissionSite.h"
+#include "../Savegame/Region.h"
+#include "../Savegame/GameTime.h"
+#include "../Savegame/CobraEconomy.h"
+#include "../Savegame/ItemContainer.h"
+#include "../Mod/RuleItem.h"
+#include "../Mod/RuleEvent.h"
+#include <algorithm>
+#include <cmath>
+#include <cstdlib>
+#include <sstream>
+#include <vector>
+
+namespace OpenXcom
+{
+namespace CobraNetwork
+{
+
+namespace
+{
+const double PI_ = 3.14159265358979323846, EARTH_KM = 6371.0;
+const char *CELL = "STR_COBRA_CELL", *FRONT = "STR_COBRA_FRONT_COMPANY", *DEPOT = "STR_COBRA_DEPOT";
+
+struct Town { std::string name; double lon, lat; std::string kind; };   // radians, engine convention (south positive)
+
+std::vector<Town> towns(const Mod *mod)
+{
+	std::vector<Town> out;
+	for (const auto &t : mod->getCobraNetworkRules().towns)
+	{
+		std::stringstream ss(t);
+		std::string name, lon, lat, kind;
+		std::getline(ss, name, ','); std::getline(ss, lon, ','); std::getline(ss, lat, ','); std::getline(ss, kind, ',');
+		Town w;
+		w.name = name;
+		w.lon = atof(lon.c_str()) * PI_ / 180.0;
+		if (w.lon < 0) w.lon += 2 * PI_;
+		w.lat = -atof(lat.c_str()) * PI_ / 180.0;
+		w.kind = kind;
+		out.push_back(w);
+	}
+	return out;
+}
+
+double km(double lon1, double lat1, double lon2, double lat2)
+{
+	// great circle on the engine's coordinates (latitude sign does not matter for distance as long as both agree)
+	const double c = std::sin(lat1) * std::sin(lat2) + std::cos(lat1) * std::cos(lat2) * std::cos(lon1 - lon2);
+	return std::acos(std::max(-1.0, std::min(1.0, c))) * EARTH_KM;
+}
+
+std::string siteKey(const AlienBase *b) { return b->getSiteType() + "#" + std::to_string(b->getId()); }
+
+int diffIndex(const SavedGame *save) { return std::max(0, std::min(4, (int)save->getDifficulty())); }
+
+int pick(const std::vector<int> &v, int i, int def) { return v.empty() ? def : v[std::min(i, (int)v.size() - 1)]; }
+
+bool researched(const Game *game, const std::string &name)
+{
+	const RuleResearch *r = game->getMod()->getResearch(name, false);
+	return r && game->getSavedGame()->isResearched(r, false);
+}
+
+std::string tr(Game *game, const std::string &key) { return std::string(game->getLanguage()->getString(key)); }
+
+void replaceAll(std::string &s, const std::string &from, const std::string &to)
+{
+	for (size_t p = s.find(from); p != std::string::npos; p = s.find(from, p + to.size())) s.replace(p, from.size(), to);
+}
+
+std::vector<std::string> split(const std::string &s, char d)
+{
+	std::vector<std::string> out; std::stringstream ss(s); std::string x;
+	while (std::getline(ss, x, d)) out.push_back(x);
+	return out;
+}
+
+AlienBase *plant(Game *game, const std::string &deploymentName, const Town &t, double jitterKm)
+{
+	SavedGame *save = game->getSavedGame();
+	AlienDeployment *dep = game->getMod()->getDeployment(deploymentName);
+	if (!dep) { Log(LOG_ERROR) << "[network] no deployment " << deploymentName; return nullptr; }
+	AlienBase *ab = new AlienBase(dep, save->getMonthsPassed());
+	ab->setAlienRace("STR_COBRA");
+	ab->setSiteType(dep->getCobraSiteType());
+	ab->setId(save->getId(dep->getMarkerName()));
+	const double j = jitterKm / EARTH_KM;
+	ab->setLongitude(t.lon + RNG::generate(-100, 100) / 100.0 * j);
+	ab->setLatitude(t.lat + RNG::generate(-100, 100) / 100.0 * j);
+	save->getAlienBases()->push_back(ab);
+	save->getCobraNet()["town:" + siteKey(ab)] = 0;
+	Log(LOG_INFO) << "[network] " << ab->getSiteType() << " #" << ab->getId() << " hidden in " << t.name;
+	return ab;
+}
+
+std::string townOf(SavedGame *save, const AlienBase *b, const std::vector<Town> &ts)
+{
+	// the nearest candidate town names it (the site was planted in one, or grew there)
+	std::string best; double bd = 1e9;
+	for (const auto &t : ts)
+	{
+		const double d = km(b->getLongitude(), b->getLatitude(), t.lon, t.lat);
+		if (d < bd) { bd = d; best = t.name; }
+	}
+	(void)save;
+	return best;
+}
+
+AlienBase *baseByKey(SavedGame *save, const std::string &key)
+{
+	for (auto *b : *save->getAlienBases()) if (siteKey(b) == key) return b;
+	return nullptr;
+}
+
+/// One lead on a site; the second finds it. found=true finds it outright.
+void addLead(Game *game, const std::string &key, bool found)
+{
+	SavedGame *save = game->getSavedGame();
+	AlienBase *b = baseByKey(save, key);
+	if (!b || b->isDiscovered() || save->getCobraNet().count("sleeper:" + key)) return;
+	int &n = save->getCobraNet()["leads:" + key];
+	n += found ? 2 : 1;
+	if (n >= 2)
+	{
+		b->setDiscovered(true);
+		save->addLeadNews("!STR_RECON_SITE_SPOTTED");
+		Log(LOG_INFO) << "[network] " << key << " found (leads " << n << ")";
+	}
+}
+
+/// The warning the Joes get: hours of notice, and whether it is the tip-off (days) or the scanner (hours).
+int noticeHours(Game *game, bool &tipoff)
+{
+	const auto &r = game->getMod()->getCobraNetworkRules();
+	tipoff = false;
+	for (const auto &t : r.tipoffResearch) if (researched(game, t)) tipoff = true;
+	if (tipoff)
+	{
+		const int lo = pick(r.tipoffDays, 0, 2), hi = pick(r.tipoffDays, 1, 3);
+		return RNG::generate(lo, hi) * 24;
+	}
+	return r.scannerHours;
+}
+
+MissionSite *spawnSite(Game *game, const std::string &missionRule, const std::string &deploymentName, const AlienBase *near,
+	const std::string &record, const std::string &alertKey, const std::string &town, const std::string &target)
+{
+	SavedGame *save = game->getSavedGame();
+	const RuleAlienMission *rule = game->getMod()->getAlienMission(missionRule);
+	AlienDeployment *dep = game->getMod()->getDeployment(deploymentName);
+	if (!rule || !dep) { Log(LOG_ERROR) << "[network] cannot spawn " << deploymentName; return nullptr; }
+	MissionSite *ms = new MissionSite(rule, dep, nullptr);
+	const double j = 40.0 / EARTH_KM;   // the job is in or near its town
+	ms->setLongitude(near->getLongitude() + RNG::generate(-100, 100) / 100.0 * j);
+	ms->setLatitude(near->getLatitude() + RNG::generate(-100, 100) / 100.0 * j);
+	// one counter for every network site: the record is keyed by this id, and per-marker ids collided (Bank Job #1 and the
+	// M.A.R.S. Convoy #1 shared a key, so the bank fight was booked to the convoy)
+	ms->setId(save->getId("STR_COBRA_NET_SITE"));
+	bool tipoff = false;
+	const int hours = noticeHours(game, tipoff);
+	ms->setSecondsRemaining((size_t)hours * 3600);
+	ms->setAlienRace("STR_COBRA");
+	ms->setDetected(true);
+	ms->setCity(town);
+	save->getMissionSites()->push_back(ms);
+	save->getCobraNetSites()[ms->getId()] = record + "|" + town + "|" + target + "|" + deploymentName;
+	std::string text = tr(game, alertKey + (tipoff ? "_TIPOFF" : "_SCANNER"));
+	replaceAll(text, "{TOWN}", town);
+	replaceAll(text, "{TARGET}", target.empty() ? std::string() : tr(game, "STR_CELL_TARGET_" + target));
+	replaceAll(text, "{HOURS}", std::to_string(hours));
+	replaceAll(text, "{DAYS}", std::to_string(hours / 24));
+	save->addLeadNews("!" + text);
+	Log(LOG_INFO) << "[network] " << record << " -> " << deploymentName << " near " << town << ", " << hours << "h notice";
+	return ms;
+}
