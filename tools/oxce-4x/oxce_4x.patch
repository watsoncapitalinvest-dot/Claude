+/**
+ * G.I. Joe capture (John 13 Nov 2026, CAPTURE_DESIGN_v1.md), run on every turn screen.
+ * - A Cobra man gives up (hands up, gun down, out of the fight) when badly hurt, when two or
+ *   more Joes are close, or when his morale has broken.
+ * - A Joe next to him cuffs him with the CUFF key (BattlescapeState::hudSigClick): he is secured.
+ * - Not cuffed, and a Cobra man reaches him at the end of Cobra's turn: Cobra shoots him as a
+ *   deserter, unless he is a named Cobra, whom they free to fight again.
+ * Anyone with his hands up when the Joes win comes home a prisoner (debriefing's surrender rule).
+ */
+std::string NextTurnState::runCapture()
+{
+	const Mod* mod = _game->getMod();
+	SavedBattleGame& sb = *_battleGame;
+	if (!mod->isCaptureOn() || sb.getTurn() < 1) return "";
+	std::string msg;
+	auto add = [&](const std::string& s) { msg = msg.empty() ? s : msg + " " + s; };
+	auto near = [](const BattleUnit* a, const BattleUnit* b, int range)
+	{
+		Position d = a->getPosition() - b->getPosition();
+		return std::abs(d.z) <= 1 && std::max(std::abs(d.x), std::abs(d.y)) <= range;
+	};
+	std::vector<BattleUnit*> units(sb.getUnits()->begin(), sb.getUnits()->end());
+	bool killed = false;
+	for (auto* u : units)
+	{
+		if (u->getOriginalFaction() != FACTION_HOSTILE || u->getFaction() != FACTION_HOSTILE || u->isOut()) continue;
+		const bool named = mod->isNamedCobra(u->getType());
+		if (u->isHandsUp())
+		{
+			if (!u->isCuffed() && sb.getSide() == FACTION_PLAYER)
+			{
+				for (auto* c : units)
+				{
+					if (c == u || c->getOriginalFaction() != FACTION_HOSTILE || c->getFaction() != FACTION_HOSTILE || c->isOut() || c->isHandsUp() || !near(c, u, 1)) continue;
+					if (named)
+					{
+						u->setHandsUp(false);
+						u->kneel(false);
+						add(tr("STR_CAPTURE_FREED"));
+					}
+					else
+					{
+						u->damage(Position(0, 0, 0), 1000, mod->getDamageType(DT_AP), &sb, {});
+						u->killedBy(FACTION_HOSTILE);
+						killed = true;
+						add(tr("STR_CAPTURE_DESERTER_SHOT"));
+					}
+					Log(LOG_INFO) << "CAPTURE " << (named ? "freed " : "shot ") << u->getType() << " " << u->getId();
+					break;
+				}
+			}
+			if (u->isHandsUp() && sb.getSide() == FACTION_HOSTILE) u->setTimeUnits(0);
+			continue;
+		}
+		const bool hurt = u->getHealth() * 100 < u->getBaseStats()->health * mod->getSurrenderHealthPct();
+		int joes = 0;
+		for (auto* j : units)
+		{
+			if (j->getOriginalFaction() == FACTION_PLAYER && !j->isOut() && near(j, u, mod->getSurroundRange())) joes++;
+		}
+		const bool surrounded = joes >= mod->getSurroundJoes();
+		const bool broken = u->wantsToSurrender() || u->getStatus() == STATUS_PANICKING;
+		if (!(hurt || surrounded || broken)) continue;
+		// hands up: guns down on the floor, kneeling, out of the fight
+		for (BattleItem* w : { u->getRightHandWeapon(), u->getLeftHandWeapon() })
+		{
+			if (w && u->getTile()) sb.getTileEngine()->itemDrop(u->getTile(), w, false);
+		}
+		u->setHandsUp(true);
+		u->kneel(true);
+		if (sb.getSide() == FACTION_HOSTILE) u->setTimeUnits(0);
+		Log(LOG_INFO) << "CAPTURE hands up " << u->getType() << " " << u->getId() << (hurt ? " hurt" : "") << (surrounded ? " surrounded" : "") << (broken ? " broken" : "");
+		if (u->getVisible()) add(tr("STR_CAPTURE_SURRENDERS"));
+	}
+	if (killed && sb.getBattleGame())
+	{
+		sb.getBattleGame()->checkForCasualties(nullptr, BattleActionAttack{}, true, false);
+	}
+	return msg;
+}
+
 }
