+/**
+ * Hands the HD layer what it needs to draw this globe again at display
+ * resolution: where it is, which way it faces, where the sun is, and the
+ * texture. The 8-bit globe above is unchanged and still the one the game
+ * reads; this only lets the screen show it sharp (HiUI::globeFloor).
+ */
+void Globe::publishHiView()
+{
+	if (!HiUI::enabled())
+		return;
+	static std::vector<float> shadeLut;
+	if (shadeLut.empty())
+	{
+		// CreateShadow::getShadowValue without its noise: the dithered terminator
+		// becomes the smooth one it was dithering towards. t runs 0..256 in
+		// quarter steps, exactly the `temp.x` the 8-bit pass indexes by.
+		shadeLut.resize(1024);
+		for (int i = 0; i < 1024; ++i)
+		{
+			const double t = i / 4.0;
+			const int o = Clamp((int)t, 0, GlobeStaticData::shade_gradient_max - 1);
+			const double rem = t - o;
+			const double middle = static_data.shade_seq[o] + static_data.shade_step[o] * rem - GlobeStaticData::shade_step_max / 2;
+			shadeLut[i] = (float)Clamp(static_data.shade_gradient[o] + middle / GlobeStaticData::shade_step_max, 0.0, 31.0);
+		}
+	}
+	HiUI::GlobeView v;
+	v.globe = this;
+	v.texture = _game->getMod()->getSurface("GLOBE_EARTH", false);
+	v.cenX = _cenX + getX();
+	v.cenY = _cenY + getY();
+	v.radius = _radius;
+	v.cenLon = _cenLon;
+	v.cenLat = _cenLat;
+	const Cord sun = getSunDirection(_cenLon, _cenLat);
+	v.sunX = sun.x; v.sunY = sun.y; v.sunZ = sun.z;
+	v.ocean = OCEAN_COLOR;
+	v.oceanShading = OCEAN_SHADING;
+	v.shade = shadeLut;
+	HiUI::globeView(v);
+	std::vector<HiUI::GlobePin> pins = _hdPins;
+	pins.insert(pins.end(), _hdCityPins.begin(), _hdCityPins.end());
+	HiUI::globePins(pins);
+	HiUI::globeLabels(_hdLabels);
+	HiUI::globeArt(_hdArt);
 }
 
 
