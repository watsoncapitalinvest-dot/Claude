+void Globe::drawMarks()
+{
+	_hdArt.clear();
+	if (!_showMarks || MARK_ICONS.empty())
+	{
+		return;
+	}
+	const auto& marks = _game->getSavedGame()->getGlobeMarks();
+	if (marks.empty())
+	{
+		return;
+	}
+	const int month = _game->getSavedGame()->getMonthsPassed();
+
+	// routes first, so a pin always sits on top of its own line
+	_radars->lock();
+	for (const auto& m : marks)
+	{
+		if (m.kind != GlobeMark::MARK_ROUTE || m.route.size() < 4)
+		{
+			continue;
+		}
+		double phase = 0.0;
+		for (size_t i = 0; i + 3 < m.route.size(); i += 2)
+		{
+			drawMarkPath(m.route[i], m.route[i+1], m.route[i+2], m.route[i+3],
+			             ROUTE_COLOR, &phase);
+		}
+	}
+	_radars->unlock();
+
+	for (const auto& m : marks)
+	{
+		int trust = m.trust;
+		if (m.fromIntel && month >= 0 && month - m.placedMonth >= MARK_STALE_MONTHS)
+		{
+			trust = std::max((int)GlobeMark::TRUST_RUMOUR, trust - 1);
+		}
+
+		size_t slot;
+		switch (m.kind)
+		{
+		case GlobeMark::MARK_NOTE:    slot = 3; break;
+		case GlobeMark::MARK_UNKNOWN: slot = 4; break;
+		case GlobeMark::MARK_ROUTE:   slot = 5; break;
+		case GlobeMark::MARK_AREA:    slot = 7; break;
+		default:
+			// confirmed, likely, rumour are icons 0,1,2 - highest trust first
+			slot = (size_t)(2 - Clamp(trust, 0, 2));
+			break;
+		}
+		if (slot >= MARK_ICONS.size())
+		{
+			continue;
+		}
+
+		// a route draws its start, then a waypoint at every bend
+		if (m.kind == GlobeMark::MARK_ROUTE && m.route.size() >= 2)
+		{
+			for (size_t i = 0; i + 1 < m.route.size(); i += 2)
+			{
+				const size_t icon = (i == 0) ? 5 : 6;
+				if (icon >= MARK_ICONS.size()) break;
+				drawMarkAt(m.route[i], m.route[i+1], MARK_ICONS[icon]);
+			}
+			continue;
+		}
+		drawMarkAt(m.lon, m.lat, MARK_ICONS[slot]);
+	}
+}
