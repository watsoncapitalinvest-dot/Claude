+	lock();
+	for (int y = y0; y <= y1; ++y)
+	{
+		const double dy = y - _cenY;
+		for (int x = x0; x <= x1; ++x)
+		{
+			const double dx = x - _cenX;
+			if (dx * dx + dy * dy > r2)
+			{
+				continue;
+			}
+			double lon, lat;
+			cartToPolar((Sint16)x, (Sint16)y, &lon, &lat);
+			// LONGITUDE WRAPS, IT DOES NOT CLAMP. cartToPolar builds lon from
+			// atan2, which returns -PI..PI, plus _cenLon - so lon goes negative
+			// west of centre and past 2*PI east of it. Clamping sent every pixel
+			// in the western hemisphere to texture column 0, one texel per row,
+			// which painted flat horizontal bands of land over half the globe and
+			// looked exactly like the old untextured polygons showing through.
+			// Latitude is different and is still clamped: the poles are real limits.
+			int u = (int)std::floor(lon / (2 * M_PI) * tw);
+			u = ((u % tw) + tw) % tw;
+			int v = (int)((M_PI / 2 - lat) / M_PI * th);
+			v = Clamp(v, 0, th - 1);
+			const Uint8 col = tex->getPixel(u, v);
+			if (col)
+			{
+				setPixel(x, y, col);
+			}
+		}
+	}
+	unlock();
+}
