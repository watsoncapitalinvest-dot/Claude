+	_barOdds = new Bar(200, 6, 60, 136);
+	_btnFight = new TextButton(100, 18, canAuto ? 48 : 110, 150);
+	_btnAuto = new TextButton(100, 18, 172, 150);
+
+	setInterface("craftError");
+	add(_window, "window", "craftError");
+	add(_txtTitle, "text1", "craftError");
+	add(_txtBody, "text1", "craftError");
+	add(_txtOdds, "text1", "craftError");
+	add(_barOdds);
+	add(_btnFight, "button", "craftError");
+	add(_btnAuto, "button", "craftError");
+	centerAllSurfaces();
+	setWindowBackground(_window, "craftError");
+
+	_txtTitle->setAlign(ALIGN_CENTER);
+	_txtTitle->setBig();
+	_txtTitle->setText(title);
+	_txtBody->setAlign(ALIGN_CENTER);
+	_txtBody->setWordWrap(true);
+	_txtBody->setText(body);
+
+	// the odds (design section 8): red = the Joes ahead, blue = behind; the rest of the bar is Cobra's share
+	_txtOdds->setAlign(ALIGN_CENTER);
+	_txtOdds->setText(odds < 0 ? tr("STR_AF_ODDS_LATER") : tr("STR_AF_ODDS").arg(odds));
+	_barOdds->setScale(2.0);
+	_barOdds->setMax(100);
+	_barOdds->setColor(odds >= 50 ? 14 : 248); // the geoscape palette: red, blue
+	_barOdds->setBorderColor(odds >= 50 ? 14 : 248);
+	_barOdds->setValue(std::max(0, odds));
+	_barOdds->setValue2(0);
+	_barOdds->setSecondValueOnTop(false);
+	_barOdds->setVisible(odds >= 0);
+
+	_btnFight->setText(tr("STR_AF_FIGHT"));
+	_btnFight->onMouseClick((ActionHandler)&AirFightChoiceState::btnFightClick);
+	_btnFight->onKeyboardPress((ActionHandler)&AirFightChoiceState::btnFightClick, Options::keyOk);
+	_btnAuto->setText(tr("STR_AF_AUTO_RESOLVE"));
+	_btnAuto->onMouseClick((ActionHandler)&AirFightChoiceState::btnAutoClick);
+	_btnAuto->setVisible(canAuto);
