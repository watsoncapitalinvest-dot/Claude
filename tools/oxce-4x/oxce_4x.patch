+	/// Plate and wells for a backdrop, painted once per size into a cache.
+	void paintBackdrop(const Surface *w, NativeBg &nb, int X0, int Y0, int X1, int Y1)
+	{
+		if (!(nb.cache.ok && nb.cx0 == X0 && nb.cy0 == Y0 && nb.cx1 == X1 && nb.cy1 == Y1))
+		{
+			// PAINTED ART, when the graphics AI's version of this page is installed
+			// (TAC01_hi.png): the painting carries the plate, the wells and the key
+			// bodies, brought to the exact display size by area. The keys then
+			// only set their legends on it, and all the type stays live.
+			auto art = bgImages.find(w);
+			if (art != bgImages.end() && art->second.ok)
+			{
+				nb.cache = resampleArea(art->second, X1 - X0, Y1 - Y0);
+				for (auto &p : nb.cache.px) p &= 0x00FFFFFFu;
+				nb.painted = true;
+				nb.cx0 = X0; nb.cy0 = Y0; nb.cx1 = X1; nb.cy1 = Y1;
+				nativePainted = true;
+				for (int Y = Y0; Y < Y1; ++Y) memcpy(over.data() + (size_t)Y * sw + X0, &nb.cache.px[(size_t)(Y - Y0) * nb.cache.w], (size_t)nb.cache.w * 4);
+				return;
+			}
+			nb.painted = false;
+			nativePainted = false;
+			const double k = SK();
+			// the plate: brushed streaks running down, a lift from the upper left, grain
+			for (int Y = Y0; Y < Y1; ++Y)
+			{
+				Uint32 *o = over.data() + (size_t)Y * sw;
+				const double v = (double)(Y - Y0) / std::max(1, Y1 - Y0);
+				for (int X = X0; X < X1; ++X)
+				{
+					const double u = (double)(X - X0) / std::max(1, X1 - X0);
+					const int col = (int)((X - X0) / std::max(1.0, k * 0.5));
+					const int streak = (int)(hash2(col, 7) % 7) - 3;
+					const int grain = (int)(hash2(X, Y) % 5) - 2;
+					const int lift = (int)((1.0 - u * 0.5 - v * 0.5) * 10.0);
+					const int d = streak + grain + lift;
+					const int r = std::max(0, std::min(255, (int)((C_PLATE >> 16) & 255) + d));
+					const int g = std::max(0, std::min(255, (int)((C_PLATE >> 8) & 255) + d));
+					const int b = std::max(0, std::min(255, (int)(C_PLATE & 255) + d));
+					o[X] = rgb(r, g, b);
+				}
+			}
+			// the wells: shadow cast in at the top left, light caught on the lower lip
+			const double bx = w->getX(), by = w->getY();
+			for (const SDL_Rect &c : nb.wells)
+			{
+				const double x0 = DX(bx + c.x + 1.15), y0 = DY(by + c.y + 1.15);
+				const double x1 = DX(bx + c.x + c.w - 0.15), y1 = DY(by + c.y + c.h - 0.15);
+				const double r = k * 0.9;
+				roundRect(x0 - 1, y0 - 0.5, x1 + 1.5, y1 + 1.5, r + 1.5, C_RIM_LIGHT);
+				roundRect(x0 - 1.5, y0 - 1.5, x1 + 0.5, y1 + 0.5, r + 1.5, C_RIM_DARK);
+				roundRect(x0, y0, x1, y1, r, C_WELL);
+			}
+			nb.cache.w = X1 - X0; nb.cache.h = Y1 - Y0; nb.cache.px.resize((size_t)nb.cache.w * nb.cache.h);
+			for (int Y = Y0; Y < Y1; ++Y) memcpy(&nb.cache.px[(size_t)(Y - Y0) * nb.cache.w], over.data() + (size_t)Y * sw + X0, (size_t)nb.cache.w * 4);
+			nb.cache.ok = true; nb.cx0 = X0; nb.cy0 = Y0; nb.cx1 = X1; nb.cy1 = Y1;
+			return;
+		}
+		nativePainted = nb.painted;
+		for (int Y = Y0; Y < Y1; ++Y) memcpy(over.data() + (size_t)Y * sw + X0, &nb.cache.px[(size_t)(Y - Y0) * nb.cache.w], (size_t)nb.cache.w * 4);
+	}
