+#pragma once
+/*
+ * G.I. Joe: artillery called in from a battle (SHELLING_DESIGN_v1, BRIEF_FOR_BUILD_Shelling; BUILD-2).
+ * A soldier with the field radio "fires" it at a tile: SNAP = HE, AIMED = SMOKE, AUTO = INCENDIARY. Nothing flies:
+ * the call is logged and spends his remaining TU; at the start of his side's next turn the salvo lands (4 shells,
+ * scattered), real engine explosions. A gun must be in range: a craft of a gun type sent to this mission or within
+ * its range, or an outpost facility within its range; Cobra's when its project is done. Rules: artillery:.
+ */
+#include <string>
+
+namespace OpenXcom
+{
+
+class BattlescapeGame;
+class BattleUnit;
+struct BattleAction;
+
+namespace Artillery
+{
+	/// ProjectileFlyBState::init: a shot with the radio is a call. Returns true if it was (the caller pops the state).
+	bool onShot(BattlescapeGame *game, BattleAction &action);
+	/// BattlescapeGame::endTurn, after the side changed: salvoes called by this side last turn land now
+	void turnStart(BattlescapeGame *game);
+	/// AIModule: Cobra's spotter (its leader) may call a salvo on the Joes it sees. True if it did (action set).
+	bool aiCall(BattlescapeGame *game, BattleUnit *u, BattleAction *action);
+}
+
+}
