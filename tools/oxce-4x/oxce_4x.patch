+/**
+ * G.I. Joe 4x: the interception decided at once, with the dogfight's own rules, as a stand-in
+ * until the tactical air war is built. The craft attacks on Standard; at half damage it breaks
+ * off if it is allowed to. Each step is the same update() the window would have run.
+ */
+std::string DogfightState::autoResolve()
+{
+	_autoResolved = true;
+	if (_ufoIsAttacking || _missileCraft) { _mode = _btnAggressive; btnAggressivePress(nullptr); }
+	else { _mode = _btnStandard; btnStandardPress(nullptr); }
+	bool brokeOff = false;
+	for (int step = 0; step < 50000 && !_endDogfight && !_minimized; ++step)
+	{
+		if (!brokeOff && !_disableDisengage && !_craft->isDestroyed() && !_ufo->isCrashed() && _craft->getDamagePercentage() >= 50)
+		{
+			_mode = _btnDisengage; btnDisengagePress(nullptr);
+			brokeOff = true;
+		}
+		think();
+	}
+	if (_minimized) return "";                       // waiting on land or altitude: stock rules carry on
+	if (_craft->isDestroyed()) return "STR_AUTO_INTERCEPT_CRAFT_LOST";
+	if (_ufo->isDestroyed()) return "STR_AUTO_INTERCEPT_DESTROYED";
+	if (_ufo->isCrashed()) return "STR_AUTO_INTERCEPT_CRASHED";
+	if (brokeOff) return "STR_AUTO_INTERCEPT_BROKE_OFF";
+	return "STR_AUTO_INTERCEPT_ESCAPED";
+}
+
 }
