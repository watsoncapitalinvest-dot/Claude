+	/// A raised console key on the button's own hitbox.
+	void stdButton(int X0, int Y0, int X1, int Y1, bool down, Uint32 fill = 0);
+	void paintKey(const std::string &legend, int bx0, int by0, int bx1, int by1, bool down, bool inArt, int style = 0, const Img *icon = nullptr)
+	{
+		const double k = SK();
+		const double x0 = DX(bx0 + 0.6), y0 = DY(by0 + 0.6), x1 = DX(bx1 - 0.6), y1 = DY(by1 - 0.6);
+		const double r = k * 1.4, push = down ? k * 0.5 : 0;
+		if (nativePainted && inArt)
+		{
+			// the painting has the key; only say it is down
+			if (down) roundRect(x0 + 1.5, y0 + 1.5, x1 - 1.5, y1 - 1.5, r - 1, rgb(196, 118, 42), 80);
+		}
+		else if (face("label"))
+		{
+			// THE STANDARD (12 Nov): a key that is not part of a painting is the
+			// standard's flat steel button, like every other button in the game
+			const Uint32 fills[5] = { 0, (Uint32)(down ? 0xC9A01C : 0xE8B923), (Uint32)(down ? 0x5A221E : 0x6B2A24), (Uint32)(down ? 0x1B2023 : 0x22282A), (Uint32)0x6B7A3A };
+			stdButton((int)x0, (int)y0, (int)x1, (int)y1, down && style != 4, fills[std::max(0, std::min(4, style))]);
+		}
+		else
+		{
+		if (!down) roundRect(x0 + k * 0.4, y0 + k * 0.6, x1 + k * 0.4, y1 + k * 0.6, r, 0x0E0F0C, 200);
+		roundRect(x0, y0 + push, x1, y1 + push, r, 0x16190F);
+		roundRect(x0 + 1.5, y0 + 1.5 + push, x1 - 1.5, y1 - 1.5 + push, r - 1, down ? 0x4C5340 : C_KEY_DARK);
+		roundRect(x0 + 1.5, y0 + 1.5 + push, x1 - 1.5, y1 - k * 0.55 + push, r - 1, down ? 0x4C5340 : C_KEY);
+		if (!down) roundRect(x0 + r * 0.6, y0 + 2 + push, x1 - r * 0.6, y0 + k * 0.9 + push, k * 0.4, C_KEY_LIT, 140);
+		if (down) roundRect(x0 + 1.5, y0 + 1.5 + push, x1 - 1.5, y1 - 1.5 + push, r - 1, rgb(196, 118, 42), 70);
+		}
+		const double cx = (x0 + x1) / 2, cy = (y0 + y1) / 2 - k * 0.3 + push;
+		const double ink = C_INK, sh = 0x181B12;
+		(void)ink;
+		auto tri = [&](double s, int dir)
+		{
+			std::vector<std::pair<double, double> > p{ { cx + dir * s * 1.1, cy }, { cx - dir * s * 0.8, cy - s }, { cx - dir * s * 0.8, cy + s } };
+			std::vector<std::pair<double, double> > q = p;
+			for (auto &e : q) { e.first += k * 0.4; e.second += k * 0.4; }
+			polygonAA(q, (Uint32)sh, 200);
+			polygonAA(p, style == 3 ? (Uint32)0x5C5A52 : C_INK);   // a key that can do nothing now reads dim
+		};
+		if (legend == "<" || legend == ">") { tri(std::min(x1 - x0, y1 - y0) * 0.24, legend == "<" ? -1 : 1); return; }
+		if (legend == "->")
+		{
+			const double s = (y1 - y0) * 0.26, L = (x1 - x0) * 0.30;
+			std::vector<std::pair<double, double> > shaft{ { cx - L, cy - s * 0.32 }, { cx + L * 0.25, cy - s * 0.32 }, { cx + L * 0.25, cy + s * 0.32 }, { cx - L, cy + s * 0.32 } };
+			std::vector<std::pair<double, double> > head{ { cx + L, cy }, { cx + L * 0.2, cy - s }, { cx + L * 0.2, cy + s } };
+			polygonAA(shaft, C_INK); polygonAA(head, C_INK);
+			return;
+		}
+		if (!(nativePainted && inArt) && face("label"))
+		{
+			// the standard's button legend: Oswald, cream, no stencil
+			const Face *f = face("label");
+			const Uint32 inks[5] = { S_TEXT, 0x14181A, 0xF0B3A8, 0x6E6C64, 0xF2EFE4 };
+			const Uint32 ink = inks[std::max(0, std::min(4, style))];
+			const auto bar = legend.find('|');
+			if (bar != std::string::npos)
+			{
+				// two lines: the legend, and a small line under it ("END TURN" / "3 Joes can still act")
+				const Face *st = style == 1 && face("stencil") ? face("stencil") : f;
+				const double h = y1 - y0;
+				setType(*st, legend.substr(0, bar), (int)(x0 + k), (int)(y0 + h * 0.12), (int)(x1 - k), (int)(y0 + h * 0.62), h * 0.22, h * 0.3, 1, 1, ink);
+				setType(*f, legend.substr(bar + 1), (int)(x0 + k), (int)(y0 + h * 0.60), (int)(x1 - k), (int)(y0 + h * 0.88), h * 0.10, h * 0.14, 1, 1, ink);
+			}
+			else if (icon)
+			{
+				// BATTLE_ICONS_BRIEF: the symbol on top, the word under it
+				const double h = y1 - y0, w = x1 - x0;
+				const double cap = std::min(h * 0.17, k * 2.0);
+				const double textTop = y1 - cap * 1.9;
+				const double side = std::max(4.0, std::min(w * 0.62, textTop - y0 - h * 0.07));
+				const double ix = (x0 + x1) / 2 - side / 2, iy = y0 + h * 0.06 + push;
+				stretch(*icon, 0, 0, icon->w, icon->h, (int)ix, (int)iy, (int)(ix + side), (int)(iy + side));
+				if (style == 3) fillRect((int)ix, (int)iy, (int)(ix + side), (int)(iy + side), 0x22282A, 120);
+				setType(*f, legend, (int)(x0 + k * 0.4), (int)(textTop + push), (int)(x1 - k * 0.4), (int)(y1 + push - k * 0.15), cap, cap, 1, 1, ink);
+			}
+			else
+			{
+				const double cap = std::min((y1 - y0) * 0.36, k * 3.4);
+				setType(*f, legend, (int)(x0 + k * 0.6), (int)(y0 + push), (int)(x1 - k * 0.6), (int)(y1 + push - k * 0.3), cap, cap, 1, 1, ink);
+			}
+		}
+		else if (const Face *f = face("stencil"))
+		{
+			const double cap = (y1 - y0) * 0.42;
+			const double m = k * 3.0;     // a margin of face either side of the legend
+			setType(*f, legend, (int)(x0 + m + k * 0.4), (int)(y0 + push + k * 0.4), (int)(x1 - m + k * 0.4), (int)(y1 + push - k * 0.55 + k * 0.4), cap, cap, 1, 1, (Uint32)sh);
+			setType(*f, legend, (int)(x0 + m), (int)(y0 + push), (int)(x1 - m), (int)(y1 + push - k * 0.55), cap, cap, 1, 1, C_INK);
+		}
+	}
