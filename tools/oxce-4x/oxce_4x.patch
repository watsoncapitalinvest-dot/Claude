+
+void GeoscapeState::startAirFight(bool autoPlay)
+{
+	const Mod *mod = _game->getMod();
+	const auto &AF = mod->getAirFightRules();
+	std::vector<Craft*> crafts;
+	Ufo *ufo = nullptr;
+	bool hunted = false;
+	for (auto *dfs : _airPending)
+	{
+		crafts.push_back(dfs->getCraft());
+		ufo = dfs->getUfo();
+		hunted = hunted || dfs->isUfoAttacking();
+	}
+	if (!ufo || crafts.empty()) { _airPending.clear(); return; }
+	// the ground below: the globe under the fight (section 1b.7)
+	int texture = -1, shade = 0;
+	_globe->getPolygonTextureAndShade(ufo->getLongitude(), ufo->getLatitude(), &texture, &shade);
+	std::string terrain = AF.defaultTerrain;
+	auto it = AF.textureTerrains.find(texture);
+	if (it != AF.textureTerrains.end()) terrain = it->second;
+	else if (texture < 0 && !AF.oceanTerrain.empty()) terrain = AF.oceanTerrain;
+	if (std::find(AF.ships.begin(), AF.ships.end(), ufo->getRules()->getType()) != AF.ships.end() && !AF.seaTerrain.empty())
+		terrain = AF.seaTerrain; // a ship: a sea fight, the water and the sea floor below
+	SavedBattleGame *bgame = new SavedBattleGame(_game->getMod(), _game->getLanguage());
+	_game->getSavedGame()->setBattleGame(bgame);
+	BattlescapeGenerator bgen(_game);
+	bgen.setWorldShade(shade);
+	bgen.runAirFight(crafts, ufo, terrain, hunted, autoPlay);
+	for (auto *c : crafts) c->setInBattlescape(true);
+	BriefingState *brief = new BriefingState(crafts.front());
+	_game->pushState(brief);
+	if (autoPlay)
+	{
+		// no briefing to read and every animation at full speed; AirFight::finish puts the speeds back
+		if (Options::battleXcomSpeedOrig == -1) { Options::battleXcomSpeedOrig = Options::battleXcomSpeed; Options::battleXcomSpeed = 1; }
+		if (Options::battleAlienSpeedOrig == -1) { Options::battleAlienSpeedOrig = Options::battleAlienSpeed; Options::battleAlienSpeed = 1; }
+		brief->btnOkClick(nullptr);
+	}
+}
+
+void GeoscapeState::finishAirFight(const AirFightResult &res)
+{
+	const Mod *mod = _game->getMod();
+	const auto &AF = mod->getAirFightRules();
+	auto pending = _airPending;
+	_airPending.clear();
+	std::ostringstream report;
+	Craft *credit = nullptr;
+	for (const auto &one : res.crafts)
+	{
+		Craft *c = one.craft;
+		if (!c) continue;
+		if (!credit && !one.lost) credit = c;
+		report << c->getName(_game->getLanguage()) << ": ";
+		if (one.lost)
+		{
+			// the pilot ejects: a named Joe always comes home hurt; an unnamed one lives on a roll (section 7)
+			for (auto *b : *_game->getSavedGame()->getBases())
+				for (auto *s : *b->getSoldiers())
+				{
+					if (s->getId() != one.pilotId || s->getCraft() != c) continue;
+					const bool named = !mod->isGreenshirt(s->getRules()->getType());
+					if (named || RNG::percent(AF.unnamedSurvive))
+					{
+						s->setCraft(nullptr);
+						s->setWoundRecovery(RNG::generate(AF.namedEjectMin, AF.namedEjectMax));
+						report << tr("STR_AF_LOST_EJECTED").arg(s->getName());
+					}
+					else
+					{
+						report << tr("STR_AF_LOST_PILOT_KILLED").arg(s->getName());
+					}
+				}
+			c->setDamage(c->getDamageMax());
+		}
+		else
+		{
+			c->setDamage(std::min(c->getDamageMax() - 1, c->getDamageMax() * (100 - one.healthPct) / 100));
+			report << tr("STR_AF_CRAFT_HEALTH").arg(one.healthPct);
+		}
+		report << "\n";
+	}
+	Ufo *ufo = res.ufo;
+	if (ufo)
+	{
+		const int dmax = ufo->getRules()->getStats().damageMax;
+		const std::string ufoName = ufo->getName(_game->getLanguage()); // before it becomes a crash site
+		const auto &SH = mod->getShippingRules();
+		if (Shipping::isMerchant(ufo))
+		{
+			// G.I. Joe: a merchant the Joes fired on (sea design 12d, 12g). An innocent one costs goodwill;
+			// a Cobra one stopped is boarded like any Cobra ship; sunk takes its cargo down with it
+			_shipFire.erase(std::remove(_shipFire.begin(), _shipFire.end(), ufo->getUniqueId()), _shipFire.end());
+			if (res.ufoDisabled && ufo->gjCobra)
+			{
+				bool boarding = false;
+				report << Shipping::search(_game, ufo, nullptr, &boarding);
+				if (boarding && credit) credit->setDestination(_game->getSavedGame()->getMissionSites()->back());
+			}
+			else if (res.ufoDisabled || res.ufoDown)
+			{
+				const bool sunk = !res.ufoDisabled;
+				if (!ufo->gjCobra) Shipping::goodwill(_game->getSavedGame(), ufo, sunk ? -SH.sinkInnocent : -SH.damageInnocent, sunk ? SH.sinkExposure : 0);
+				report << tr(sunk ? (ufo->gjCobra ? "STR_SHIP_SUNK_COBRA" : "STR_SHIP_SUNK_INNOCENT") : "STR_SHIP_DISABLED_INNOCENT").arg(ufoName)
+					.arg(sunk ? SH.sinkInnocent : SH.damageInnocent);
+				ufo->setDetected(false);
+				ufo->setStatus(Ufo::DESTROYED);
+			}
+			else
+			{
+				if (!ufo->gjCobra && res.ufoHealthPct < 100) Shipping::goodwill(_game->getSavedGame(), ufo, -SH.damageInnocent, 0);
+				report << tr(res.ufoThrough ? "STR_AF_UFO_THROUGH" : "STR_AF_UFO_BROKE_OFF").arg(ufoName);
+			}
+		}
+		else
+		if (res.ufoDisabled)
+		{
+			// dead in the water: the fight ends, the boarding begins (sea design section 7) - a deck mission
+			// on the spot; the ship itself leaves the map as a moving target
+			const RuleAlienMission *mrule = mod->getAlienMission("STR_COBRA_SHIP_BOARDING_MISSION");
+			AlienDeployment *dep = mod->getDeployment("STR_COBRA_SHIP_BOARDING");
+			if (mrule && dep)
+			{
+				MissionSite *ms = new MissionSite(mrule, dep, nullptr);
+				ms->setLongitude(ufo->getLongitude());
+				ms->setLatitude(ufo->getLatitude());
+				ms->setId(_game->getSavedGame()->getId(dep->getMarkerName()));
+				ms->setSecondsRemaining(2 * 24 * 3600);
+				ms->setAlienRace(ufo->getAlienRace());
+				ms->setDetected(true);
+				_game->getSavedGame()->getMissionSites()->push_back(ms);
+			}
+			ufo->setDetected(false);
+			ufo->setStatus(Ufo::DESTROYED);
+			report << tr("STR_SEA_DISABLED").arg(ufoName);
+		}
+		else if (res.ufoDown && std::find(AF.ships.begin(), AF.ships.end(), ufo->getRules()->getType()) != AF.ships.end())
+		{
+			// sunk: gone, cargo and all (a wreck the divers can work comes with the dive missions)
+			if (!credit && !res.crafts.empty()) credit = res.crafts.front().craft;
+			if (credit) ufo->setShotDownByCraftId(credit->getUniqueId());
+			ufo->setDamage(dmax * 2, mod);
+			report << tr("STR_SEA_SUNK").arg(ufoName);
+		}
+		else if (res.ufoDown)
+		{
+			if (!credit && !res.crafts.empty()) credit = res.crafts.front().craft;
+			if (credit) ufo->setShotDownByCraftId(credit->getUniqueId());
+			ufo->setDamage(dmax / 2 + 1, mod); // down, not blown apart: a crash site (section 7)
+			ufo->setSpeed(0);
+			ufo->setDestination(0);
+			report << tr("STR_AF_UFO_DOWN").arg(ufoName);
+		}
+		else
+		{
+			ufo->setDamage(std::min(dmax / 2, dmax * (100 - res.ufoHealthPct) / 100), mod);
+			report << tr(res.ufoThrough ? "STR_AF_UFO_THROUGH" : "STR_AF_UFO_BROKE_OFF").arg(ufoName);
+		}
+	}
+	for (auto *dfs : pending)
+	{
+		if (std::find(_dogfights.begin(), _dogfights.end(), dfs) == _dogfights.end()) continue;
+		dfs->concludeAirFight();
+	}
+	popup(new CraftErrorState(this, report.str(), true, nullptr));
+}
