+// ---- G.I. Joe BattleAI 6-10 (BUILD-2) helpers ----
+static bool gjIn(const std::vector<std::string> &v, const std::string &t)
+{
+	return std::find(v.begin(), v.end(), t) != v.end();
+}
+/// sets up a walk to goal if a path exists
+static bool gjWalk(SavedBattleGame *save, BattleUnit *u, const Position &goal, BattleAction *action)
+{
+	save->getPathfinding()->calculate(u, goal, BAM_NORMAL);
+	const bool can = save->getPathfinding()->getStartDirection() != -1;
+	save->getPathfinding()->abortPath();
+	if (!can) return false;
+	action->type = BA_WALK;
+	action->target = goal;
+	return true;
+}
+/// the open tile next to p (same floor) that u can reach for the fewest TU (or invalid). Remembered under key,
+/// so a man walking there keeps one goal instead of swapping between routes as he moves.
+static Position gjBeside(SavedBattleGame *save, BattleUnit *u, const Position &p, const std::string &key = "")
+{
+	if (!key.empty())
+	{
+		const int v = save->getVanStop(key);
+		if (v)
+		{
+			const int vv = v - 1;
+			const Position q(vv / 100000, (vv / 100) % 1000, vv % 100);
+			Tile *t = save->getTile(q);
+			if (q == u->getPosition()) return q;
+			if (t && (!t->getUnit() || t->getUnit() == u) && Position::distance2d(q, p) <= 1 && q.z == p.z) return q;
+		}
+	}
+	Position best = TileEngine::invalid;
+	int bestCost = INT_MAX;
+	for (int dx = -1; dx <= 1; ++dx) for (int dy = -1; dy <= 1; ++dy)
+	{
+		if (!dx && !dy) continue;
+		const Position q(p.x + dx, p.y + dy, p.z);
+		Tile *t = save->getTile(q);
+		if (!t || (t->getUnit() && t->getUnit() != u)) continue;
+		if (t->getTUCost(O_OBJECT, u->getMovementType()) == Pathfinding::INVALID_MOVE_COST) continue;
+		int cost = 0;
+		if (q != u->getPosition())
+		{
+			save->getPathfinding()->calculate(u, q, BAM_NORMAL);
+			if (save->getPathfinding()->getStartDirection() == -1) { save->getPathfinding()->abortPath(); continue; }
+			cost = save->getPathfinding()->getTotalTUCost();
+			save->getPathfinding()->abortPath();
+		}
+		if (cost < bestCost) { bestCost = cost; best = q; }
+	}
+	if (!key.empty() && best != TileEngine::invalid) save->setVanStop(key, best.x * 100000 + best.y * 100 + best.z + 1);
+	return best;
+}
+static bool gjAlive(SavedBattleGame *save, int idPlus1)
+{
+	for (auto *u : *save->getUnits()) if (u->getId() + 1 == idPlus1 && !u->isOut()) return true;
+	return false;
+}
+static bool gjHurt(const BattleUnit *b, int pct)
+{
+	return b->getFatalWounds() > 0 || b->getHealth() * 100 <= b->getBaseStats()->health * pct;
+}
+
 /**
  * Runs any code the state needs to keep updating every AI cycle.
  * @param action (possible) AI action to execute after thinking is done.
  */
 void AIModule::think(BattleAction *action)
+{
+	// rig hook: Cobra sits out turn 1 so the staged specials test (OXCE_VS_SELFTEST=3) has a Joe left on turn 2
+	if (getenv("OXCE_VS_SELFTEST") && std::string(getenv("OXCE_VS_SELFTEST")) == "3" && _save->getTurn() == 1) { action->type = BA_NONE; return; }
+	if (Testbed::freeze(_save, _unit, action)) return;   // G.I. Joe test range: Cobra stands still
+	_gjVillainActed = false;
+	_gjStock = false;
+	thinkCore(action);
+	if (_unit->getFaction() != FACTION_HOSTILE || _unit->isOut() || !_save->getMod()->getBattleAIRules().on) return;
+	gjAssignGuards();
+	gjPairs(action);
+	gjGuard(action);
+	gjSilent(action);
+}
+
+static int gjEnc(const Position &p) { return p.x * 100000 + p.y * 100 + p.z + 1; }
+static Position gjDec(int v) { --v; return Position(v / 100000, (v / 100) % 1000, v % 100); }
+
+/// once a battle: the Cobra nearest each objective (a clue or evidence item lying in the map, or a map objective
+/// tile) are tied to it, guardsPer of them, if they start within guardFrom tiles
+void AIModule::gjAssignGuards()
+{
+	if (_save->getVanStop("guardsSet")) return;
+	_save->setVanStop("guardsSet", 1);
+	const auto &BA = _save->getMod()->getBattleAIRules();
+	if (getenv("OXCE_AITRACE"))
+		for (auto *u : *_save->getUnits())
+			if (u->getFaction() == FACTION_HOSTILE) Log(LOG_INFO) << "[ai] cobra #" << u->getId() << " " << u->getType() << " at " << u->getPosition();
+	// rig hook: knock out the Cobra nearest a medic so the medic has someone to get up
+	if (getenv("OXCE_AITEST_STUN"))
+	{
+		for (auto *m : *_save->getUnits())
+		{
+			if (m->isOut() || m->getFaction() != FACTION_HOSTILE || !gjIn(BA.medics, m->getType())) continue;
+			BattleUnit *v = nullptr; int bestD = 99;
+			for (auto *u : *_save->getUnits())
+			{
+				if (u == m || u->isOut() || u->getFaction() != FACTION_HOSTILE || !u->isSmallUnit()) continue;
+				const int d = Position::distance2d(u->getPosition(), m->getPosition());
+				if (d < bestD) { bestD = d; v = u; }
+			}
+			if (v)
+			{
+				Log(LOG_INFO) << "[aitest] knocking out " << v->getType() << " at " << v->getPosition() << ", " << bestD << " tiles from medic " << m->getType() << " at " << m->getPosition();
+				v->knockOut(_save->getBattleGame());
+				v->healStun(-40); // well under: out for several turns
+				_save->getBattleGame()->checkForCasualties(nullptr, BattleActionAttack{ BA_NONE, nullptr });
+			}
+			break;
+		}
+	}
+	// rig hook: drop a clue item two tiles from a Cobra trooper so there is something to guard
+	if (getenv("OXCE_AITEST_CLUE"))
+		for (auto *u : *_save->getUnits())
+		{
+			if (u->isOut() || u->getFaction() != FACTION_HOSTILE || !u->isSmallUnit() || gjIn(BA.medics, u->getType()) || gjIn(BA.silent, u->getType())) continue;
+			Tile *t = _save->getTile(u->getPosition() + Position(2, 0, 0));
+			if (!t) t = _save->getTile(u->getPosition());
+			_save->createItemForTile("STR_CLUE_CARGO_EVIDENCE", t);
+			Log(LOG_INFO) << "[aitest] clue dropped at " << t->getPosition() << " beside " << u->getType() << " at " << u->getPosition();
+			break;
+		}
+	// rig hook: wound the Cobra farthest from a medic (but in medicRange) to 25% so he has to go to the medic
+	if (getenv("OXCE_AITEST_HURT"))
+		for (auto *m : *_save->getUnits())
+		{
+			if (m->isOut() || m->getFaction() != FACTION_HOSTILE || !gjIn(BA.medics, m->getType())) continue;
+			BattleUnit *v = nullptr; int bestD = 1;
+			for (auto *u : *_save->getUnits())
+			{
+				if (u == m || u->isOut() || u->getFaction() != FACTION_HOSTILE || !u->isSmallUnit() || gjIn(BA.medics, u->getType())) continue;
+				const int d = Position::distance2d(u->getPosition(), m->getPosition());
+				if (d > bestD && d <= BA.medicRange) { bestD = d; v = u; }
+			}
+			if (v)
+			{
+				v->setHealthDirect(std::max(1, v->getBaseStats()->health / 4));
+				Log(LOG_INFO) << "[aitest] wounded " << v->getType() << " #" << v->getId() << " at " << v->getPosition() << " to " << v->getHealth() << ", " << bestD << " tiles from medic at " << m->getPosition();
+			}
+			break;
+		}
+	// rig hook: put a silent unit in the open about 12 tiles from a Joe, where the stock AI would shoot
+	if (getenv("OXCE_AITEST_SILENT"))
+	{
+		BattleUnit *ss = nullptr, *joe = nullptr;
+		for (auto *u : *_save->getUnits())
+		{
+			if (u->isOut()) continue;
+			if (!ss && u->getFaction() == FACTION_HOSTILE && gjIn(BA.silent, u->getType())) ss = u;
+			if (!joe && u->getFaction() == FACTION_PLAYER) joe = u;
+		}
+		if (ss && joe)
+		{
+			Tile *spot = nullptr;
+			for (int d = 0; d < 8 && !spot; ++d)
+			{
+				Position v; Pathfinding::directionToVector(d, &v);
+				for (int k = 12; k <= 14 && !spot; ++k)
+				{
+					Tile *t = _save->getTile(joe->getPosition() + Position(v.x * k, v.y * k, 0));
+					if (t && !t->getUnit() && !t->hasNoFloor(_save) && t->getTUCost(O_OBJECT, MT_WALK) != Pathfinding::INVALID_MOVE_COST) spot = t;
+				}
+			}
+			if (spot)
+			{
+				ss->setPosition(spot->getPosition()); ss->setTile(spot, _save);
+				_save->getTileEngine()->calculateFOV(ss);
+				Log(LOG_INFO) << "[aitest] silent " << ss->getType() << " put at " << spot->getPosition() << ", " << Position::distance2d(spot->getPosition(), joe->getPosition()) << " tiles from a Joe, sees him " << (ss->hasVisibleUnit(joe) ? "yes" : "no");
+			}
+		}
+	}
+	if (BA.guardsPer <= 0) return;
+	struct Post { Position at; int item; };
+	std::vector<Post> posts;
+	auto near = [&](const Position &p) { for (auto &q : posts) if (q.at.z == p.z && Position::distance2d(q.at, p) <= 3) return true; return false; };
+	for (auto *it : *_save->getItems())
+	{
+		if (!it->getTile() || it->getOwner() || it->getUnit()) continue;
+		const std::string &t = it->getRules()->getType();
+		bool hit = false;
+		for (auto &pre : BA.guardItems) if (t.compare(0, pre.size(), pre) == 0) hit = true;
+		if (!hit) continue;
+		const Position p = it->getTile()->getPosition();
+		if (!near(p)) posts.push_back({ p, it->getId() + 1 });
+	}
+	if (getenv("OXCE_AITRACE")) Log(LOG_INFO) << "[ai] " << posts.size() << " objective posts";
+	for (auto &post : posts)
+	{
+		std::vector<std::pair<int, BattleUnit*>> cand;
+		for (auto *bu : *_save->getUnits())
+		{
+			if (bu->isOut() || bu->getFaction() != FACTION_HOSTILE || !bu->isSmallUnit()) continue;
+			if (gjIn(BA.medics, bu->getType()) || gjIn(BA.silent, bu->getType())) continue;
+			if (_save->getVanStop("guardAt:" + std::to_string(bu->getId()))) continue;
+			const int d = Position::distance2d(bu->getPosition(), post.at);
+			if (d <= BA.guardFrom) cand.push_back({ d, bu });
+		}
+		std::sort(cand.begin(), cand.end(), [](const std::pair<int, BattleUnit*> &a, const std::pair<int, BattleUnit*> &b) { return a.first < b.first; });
+		for (int i = 0; i < (int)cand.size() && i < BA.guardsPer; ++i)
+		{
+			const std::string id = std::to_string(cand[i].second->getId());
+			_save->setVanStop("guardAt:" + id, gjEnc(post.at));
+			_save->setVanStop("guardItem:" + id, post.item);
+			Log(LOG_INFO) << "[ai] " << cand[i].second->getType() << " guards " << post.at;
+		}
+	}
+}
+
+/// a guard does not walk further than guardLeash from his post; away from it, he goes back
+void AIModule::gjGuard(BattleAction *action)
+{
+	const std::string id = std::to_string(_unit->getId());
+	const int enc = _save->getVanStop("guardAt:" + id);
+	if (!enc || _save->getVanStop("retreat") || _unit->isCarrying()) return;
+	const Position post = gjDec(enc);
+	// the thing he guards is gone (picked up, destroyed): he is free
+	const int item = _save->getVanStop("guardItem:" + id);
+	if (item)
+	{
+		bool there = false;
+		for (auto *it : *_save->getItems())
+			if (it->getId() + 1 == item && it->getTile() && !it->getOwner() && Position::distance2d(it->getTile()->getPosition(), post) <= 1) there = true;
+		if (!there)
+		{
+			_save->setVanStop("guardAt:" + id, 0);
+			Log(LOG_INFO) << "[ai] " << _unit->getType() << " stops guarding (objective gone)";
+			return;
+		}
+	}
+	const int leash = _save->getMod()->getBattleAIRules().guardLeash;
+	const Position me = _unit->getPosition();
+	const bool away = me.z != post.z || Position::distance2d(me, post) > leash;
+	const bool walkingOff = action->type == BA_WALK && (action->target.z != post.z || Position::distance2d(action->target, post) > leash);
+	if (!walkingOff && !(away && (action->type == BA_NONE || action->type == BA_WALK))) return;
+	if (away)
+	{
+		Position to = post;
+		Tile *t = _save->getTile(post);
+		if (!t || (t->getUnit() && t->getUnit() != _unit)) to = gjBeside(_save, _unit, post);
+		if (to != TileEngine::invalid && gjWalk(_save, _unit, to, action)) return;
+	}
+	if (getenv("OXCE_AITRACE")) Log(LOG_INFO) << "[ai] guard " << _unit->getType() << " holds post " << post;
+	action->type = BA_NONE; // holds his post, time left for reaction fire
+}
+
+/// the reachable tile no known Joe can see that gets him nearest goal (invalid if none is nearer than where he is)
+Position AIModule::gjHiddenStepToward(const Position &goal)
+{
+	const Position me = _unit->getPosition();
+	std::vector<std::pair<int, Position>> cand;
+	for (int index : _reachable)
+	{
+		Position p = _save->getTileCoords(index);
+		const int d = Position::distanceSq(p, goal);
+		if (d >= Position::distanceSq(me, goal)) continue;
+		Tile *t = _save->getTile(p);
+		if (!t || (t->getUnit() && t->getUnit() != _unit)) continue;
+		cand.push_back({ d, p });
+	}
+	std::sort(cand.begin(), cand.end(), [](const std::pair<int, Position> &a, const std::pair<int, Position> &b) { return a.first < b.first; });
+	int checked = 0;
+	for (auto &c : cand)
+	{
+		if (++checked > 40) break;
+		if (getSpottingUnits(c.second) == 0) return c.second;
+	}
+	return TileEngine::invalid;
+}
+
+/// a silent unit nobody can see now does not step where a known Joe can see him, and fires only at a Joe within
+/// silentStrike tiles; otherwise he creeps closer unseen. Once he is seen, he fights like anyone else.
+void AIModule::gjSilent(BattleAction *action)
+{
+	const auto &BA = _save->getMod()->getBattleAIRules();
+	if (_gjVillainActed || !gjIn(BA.silent, _unit->getType()) || _unit->getVisible()) return;
+	if (_save->getVanStop("retreat")) return;
+	const Position me = _unit->getPosition();
+	const bool attack = action->type == BA_SNAPSHOT || action->type == BA_AIMEDSHOT || action->type == BA_AUTOSHOT
+		|| action->type == BA_THROW || action->type == BA_LAUNCH;
+	if (attack)
+	{
+		if (Position::distance2d(action->target, me) <= BA.silentStrike) return;
+		if (getenv("OXCE_AITRACE")) Log(LOG_INFO) << "[ai] silent " << _unit->getType() << " holds fire at " << Position::distance2d(action->target, me) << " tiles";
+		const Position step = gjHiddenStepToward(action->target);
+		if (step != TileEngine::invalid && gjWalk(_save, _unit, step, action)) return;
+		action->type = BA_NONE;
+		return;
+	}
+	if (action->type == BA_WALK && getSpottingUnits(action->target) > 0)
+	{
+		if (getenv("OXCE_AITRACE")) Log(LOG_INFO) << "[ai] silent " << _unit->getType() << " won't step into view at " << action->target;
+		const Position step = gjHiddenStepToward(action->target);
+		if (step != TileEngine::invalid && step != action->target && gjWalk(_save, _unit, step, action)) return;
+		action->type = BA_NONE;
+	}
+}
+
+/// BattleAI 7: Cobra remembers where Joes were seen (shared, like a radio); with no Joe in sight, a patrolling man
+/// heads for the newest sighting (last 3 turns) and moves with a buddy: never more than pairGap tiles from him,
+/// leapfrogging (the man behind moves, the man ahead waits), preferring tiles no known Joe can see.
+void AIModule::gjPairs(BattleAction *action)
+{
+	const auto &BA = _save->getMod()->getBattleAIRules();
+	const int turn = _save->getTurn();
+	for (auto *bu : *_unit->getVisibleUnits())
+	{
+		if (bu->getFaction() != FACTION_PLAYER || bu->isOut()) continue;
+		const std::string b = std::to_string(bu->getId());
+		_save->setVanStop("seenAt:" + b, gjEnc(bu->getPosition()));
+		_save->setVanStop("seenTurn:" + b, turn);
+	}
+	if (!BA.pairs || !_gjStock || _visibleEnemies > 0 || _spottingEnemies > 0 || _AIMode == AI_ESCAPE || action->type != BA_WALK) return;
+	const std::string id = std::to_string(_unit->getId());
+	auto freeMan = [&](BattleUnit *u) {
+		return u && !u->isOut() && u->getFaction() == FACTION_HOSTILE && u->isSmallUnit()
+			&& !gjIn(BA.medics, u->getType()) && !gjIn(BA.silent, u->getType())
+			&& !_save->getVanStop("guardAt:" + std::to_string(u->getId()));
+	};
+	if (!freeMan(_unit) || _save->getVanStop("retreat") || _unit->isCarrying()) return;
+	// the buddy
+	BattleUnit *buddy = nullptr;
+	const int bid = _save->getVanStop("buddy:" + id);
+	for (auto *u : *_save->getUnits()) if (bid && u->getId() + 1 == bid) buddy = u;
+	if (!freeMan(buddy))
+	{
+		buddy = nullptr;
+		int bestD = 11;
+		for (auto *u : *_save->getUnits())
+		{
+			if (u == _unit || !freeMan(u)) continue;
+			const int theirs = _save->getVanStop("buddy:" + std::to_string(u->getId()));
+			if (theirs && theirs != _unit->getId() + 1 && gjAlive(_save, theirs)) continue;
+			const int d = Position::distance2d(u->getPosition(), _unit->getPosition());
+			if (d < bestD) { bestD = d; buddy = u; }
+		}
+		_save->setVanStop("buddy:" + id, buddy ? buddy->getId() + 1 : 0);
+		if (buddy) _save->setVanStop("buddy:" + std::to_string(buddy->getId()), _unit->getId() + 1);
+	}
+	// where to: the newest sighting, when he is only patrolling
+	Position goal = action->target;
+	if (_AIMode == AI_PATROL)
+	{
+		int newest = turn - 4;
+		for (auto *bu : *_save->getUnits())
+		{
+			if (bu->getFaction() != FACTION_PLAYER || bu->isOut()) continue;
+			const std::string b = std::to_string(bu->getId());
+			const int t = _save->getVanStop("seenTurn:" + b, -100);
+			if (t > newest) { newest = t; goal = gjDec(_save->getVanStop("seenAt:" + b)); }
+		}
+	}
+	if (!buddy)
+	{
+		if (goal != action->target) gjWalk(_save, _unit, goal, action);
+		return;
+	}
+	const Position me = _unit->getPosition(), bp = buddy->getPosition();
+	if (Position::distance2d(goal, bp) <= BA.pairGap)
+	{
+		if (goal != action->target) gjWalk(_save, _unit, goal, action);
+		return;
+	}
+	// a tile within pairGap of the buddy, nearer the goal than here; out of sight if there is one
+	std::vector<std::pair<int, Position>> cand;
+	const int mine = Position::distanceSq(me, goal);
+	for (int index : _reachable)
+	{
+		const Position p = _save->getTileCoords(index);
+		if (std::abs(p.z - bp.z) > 1 || Position::distance2d(p, bp) > BA.pairGap || p == bp) continue;
+		const int d = Position::distanceSq(p, goal);
+		if (d >= mine) continue;
+		Tile *t = _save->getTile(p);
+		if (!t || (t->getUnit() && t->getUnit() != _unit)) continue;
