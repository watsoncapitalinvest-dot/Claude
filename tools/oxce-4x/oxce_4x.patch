+/**
+ * G.I. Joe air fights (DOGFIGHT_DESIGN_v1 section 1): an interception between a craft and a Cobra aircraft
+ * that both have a battle unit is offered as FIGHT / AUTO-RESOLVE. Every Joe craft already on the same Cobra
+ * aircraft joins. Helicopters are never fought. Returns true if the offer was made.
+ */
+bool GeoscapeState::offerAirFight(DogfightState *dfs)
+{
+	const Mod *mod = _game->getMod();
+	const auto &AF = mod->getAirFightRules();
+	Ufo *ufo = dfs->getUfo();
+	Craft *craft = dfs->getCraft();
+	if (!AF.on || !ufo || !craft || !_airPending.empty()) return false;
+	if (!AF.units.count(ufo->getRules()->getType()) || !AF.units.count(craft->getRules()->getType())) return false;
+	if (std::find(AF.helicopters.begin(), AF.helicopters.end(), ufo->getRules()->getType()) != AF.helicopters.end()) return false;
+	if (ufo->isCrashed() || craft->isDestroyed()) return false;
+	std::ostringstream body;
+	int n = 0;
+	for (auto *d : _dogfights)
+	{
+		if (d->getUfo() != ufo || d->isMinimized() || d->isAutoResolved() || !d->getCraft()) continue;
+		if (!AF.units.count(d->getCraft()->getRules()->getType())) continue;
+		_airPending.push_back(d);
+		auto pilots = d->getCraft()->getPilotList(false, mod);
+		body << d->getCraft()->getName(_game->getLanguage());
+		if (!pilots.empty()) body << " - " << pilots.front()->getName();
+		body << "  " << (100 - d->getCraft()->getDamagePercentage()) << "%\n";
+		++n;
+	}
+	if (n == 0) return false;
+	body << "\n" << tr("STR_AF_VERSUS").arg(ufo->getName(_game->getLanguage()));
+	std::vector<Craft*> crafts;
+	for (auto *d : _airPending) crafts.push_back(d->getCraft());
+	const int odds = AirFight::odds(mod, crafts, ufo);
+	// story fights and 5+ a side are always flown (section 1); no story fight yet, so only the 5+ rule applies
+	popup(new AirFightChoiceState(this, tr("STR_AF_TITLE"), body.str(), n < 5, odds));
+	return true;
+}
+
+void GeoscapeState::shipDecision(int choice)
+{
+	if (_shipPending.empty()) return;
+	DogfightState *first = _shipPending.front();
+	_shipPending.clear();
+	if (std::find(_dogfights.begin(), _dogfights.end(), first) == _dogfights.end()) return;
+	Ufo *ufo = first->getUfo();
+	Craft *craft = first->getCraft();
+	if (!ufo || !craft) return;
+	if (choice == 1)
+	{
+		// open fire: the sea fight takes it from here (offerAirFight on the next tick)
+		_shipFire.push_back(ufo->getUniqueId());
+		return;
+	}
+	std::string report;
+	bool boarding = false;
+	if (choice == 0) report = Shipping::search(_game, ufo, craft, &boarding);
+	for (auto *d : _dogfights)
+	{
+		if (d->getUfo() != ufo || d->dogfightEnded()) continue;
+		Craft *c = d->getCraft();
+		d->endDogfight();
+		if (c && !(boarding && c == craft)) c->returnToBase();
+	}
+	if (boarding)
+	{
+		// the boarding team goes aboard (the site Shipping::search put on the spot)
+		auto *sites = _game->getSavedGame()->getMissionSites();
+		if (!sites->empty()) craft->setDestination(sites->back());
+	}
+	if (!report.empty()) popup(new CraftErrorState(this, report, true, nullptr));
+}
