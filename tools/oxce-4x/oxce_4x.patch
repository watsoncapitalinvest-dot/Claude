+/**
+ * Puts one marker frame on the globe at a lon/lat, if it is on the near face.
+ * Centred on the frame's own size, exactly as drawTarget does, so an oversized
+ * icon lands where it should.
+ */
+void Globe::drawMarkAt(double lon, double lat, int frame)
+{
+	if (pointBack(lon, lat))
+	{
+		return;
+	}
+	Surface *marker = _markerSet->getFrame(frame);
+	if (!marker)
+	{
+		return;
+	}
+	Sint16 x, y;
+	polarToCart(lon, lat, &x, &y);
+	if (HiUI::active())
+	{
+		// set crisp by the HD layer; drawn into the globe it would be painted over
+		_hdArt.push_back(HiUI::GlobeArt{ marker, (double)(x - marker->getWidth() / 2 + getX()), (double)(y - marker->getHeight() / 2 + getY()) });
+		return;
+	}
+	ShaderMove<const Uint8> surf{ marker, x - marker->getWidth() / 2, y - marker->getHeight() / 2 };
+	ShaderMove<Uint8> dest{ this };
+	ShaderDrawFunc(
+		[](Uint8& destStuff, Uint8 srcStuff)
+		{
+			if (srcStuff)
+			{
+				destStuff = srcStuff;
+			}
+		},
+		dest,
+		surf
+	);
+}
