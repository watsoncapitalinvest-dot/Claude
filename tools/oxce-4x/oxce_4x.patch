+	// ===================================================================== NATIVE
+	// Everything below draws in DISPLAY pixels from shapes and outlines, so it is
+	// as sharp as the screen it lands on. Base coordinates are mapped with the
+	// same affine the zoom uses, not snapped to whole base pixels.
+	inline double DX(double bx) { return xs[0] + bx * (double)(xs[bw] - xs[0]) / bw; }
+	inline double DY(double by) { return ys[0] + by * (double)(ys[bh] - ys[0]) / bh; }
+	inline double SK() { return (double)(ys[bh] - ys[0]) / bh; }   // display px per base px
