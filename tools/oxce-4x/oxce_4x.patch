+AirRaidState::~AirRaidState()
+{
+}
+
+void AirRaidState::refresh()
+{
+	const Mod *mod = _game->getMod();
+	const auto &R = mod->getAirRaidRules();
+	if (!_flown && _defend)
+	{
+		std::ostringstream ss;
+		ss << tr("STR_AR_DEFEND_PLAN").arg((int)_planes.size()).arg(tr(R.bomberName));
+		if (_shots.empty()) ss << "\n" << tr("STR_AR_NO_GUNS");
+		_txtInfo->setText(ss.str());
+		for (size_t i = 0; i < _btnShots.size(); ++i)
+		{
+			const auto &sh = _shots[i];
+			std::ostringstream s;
+			s << tr(sh.gun) << " > " << tr(R.bomberName) << " " << (sh.plane + 1) << " - " << tr("STR_AR_LEAD") << " " << tr(AirRaid::speedName(sh.lead));
+			_btnShots[i]->setText(s.str());
+			_btnShots[i]->setVisible(!_flown);
+		}
+	}
+	else if (!_flown)
+	{
+		// what the Joes know of the defence: the guns this kind of site has (stand-in table, phase 1)
+		std::map<std::string, int> guns;
+		auto it = R.siteGuns.find(_siteType);
+		if (it != R.siteGuns.end()) for (const auto &g : it->second) guns[g]++;
+		std::ostringstream ss;
+		ss << tr("STR_AR_PLAN") << "\n" << tr("STR_AR_DEFENCES");
+		if (guns.empty()) ss << " " << tr("STR_AR_NONE");
+		for (const auto &g : guns) ss << "\n  " << g.second << " x " << tr(g.first);
+		_txtInfo->setText(ss.str());
+	}
+	bool ready = !_planes.empty();
+	for (size_t i = 0; i < _planes.size() && i < _btnPlanes.size(); ++i)
+	{
+		const auto &p = _planes[i];
+		std::ostringstream s;
+		if (p.craft) s << (int)(i + 1) << ". " << p.craft->getName(_game->getLanguage()) << " - " << tr(AirRaid::speedName(p.speed));
+		else s << tr(R.bomberName) << " " << (int)(i + 1) << (_flown ? " - " + std::string(tr(AirRaid::speedName(p.speed))) : "");   // its speed is Cobra's secret until the pass
+		if (p.craft) s << (p.tx < 0 ? " - ?" : "");
+		if (_flown) s << (p.down ? " - " + std::string(tr("STR_AR_DOWN")) : "");
+		_btnPlanes[i]->setText(s.str());
+		if (p.tx < 0) ready = false;
+	}
+	if (_defend) ready = true;
+	_btnFly->setVisible(!_flown ? ready : true);
+	_btnFly->setText(tr(_flown ? "STR_OK" : _defend ? "STR_AR_FIRE" : "STR_AR_FLY"));
+	_btnCancel->setVisible(!_flown && !_defend);
+	_map->setSelected(_selected);
+}
+
+void AirRaidState::btnShotClick(Action *action)
+{
+	if (_flown || _planes.empty()) return;
+	for (size_t i = 0; i < _btnShots.size(); ++i)
+		if (action->getSender() == _btnShots[i]) _shots[i].plane = (_shots[i].plane + 1) % (int)_planes.size();
+	refresh();
+}
+
+void AirRaidState::btnShotRightClick(Action *action)
+{
+	if (_flown) return;
+	for (size_t i = 0; i < _btnShots.size(); ++i)
+		if (action->getSender() == _btnShots[i]) _shots[i].lead = (_shots[i].lead + 1) % 3;
+	refresh();
+}
+
+void AirRaidState::btnPlaneClick(Action *action)
+{
+	if (_flown || _defend) return;
+	for (size_t i = 0; i < _btnPlanes.size(); ++i)
+	{
+		if (action->getSender() != _btnPlanes[i]) continue;
+		// first click picks the plane to aim; a click on the picked plane changes its speed
+		if ((int)i == _selected) _planes[i].speed = (_planes[i].speed + 1) % 3;
+		_selected = (int)i;
+	}
+	refresh();
+}
+
+void AirRaidState::mapClick(Action *)
+{
+	if (_flown || _planes.empty() || _defend) return;
+	int x, y;
+	if (!_map->tileUnderMouse(x, y)) return;
+	_planes[_selected].tx = x;
+	_planes[_selected].ty = y;
+	// on to the next plane without a target
+	for (size_t n = 1; n <= _planes.size(); ++n)
+	{
+		const int j = (_selected + (int)n) % (int)_planes.size();
+		if (_planes[j].tx < 0) { _selected = j; break; }
+	}
+	refresh();
+}
+
+void AirRaidState::btnCancelClick(Action *)
+{
+	_game->getSavedGame()->setBattleGame(nullptr);
+	for (auto &p : _planes) p.craft->returnToBase();
+	_game->popState();
+}
+
+void AirRaidState::btnFlyClick(Action *)
+{
+	if (_flown) { finish(); return; }
+	fly();
+}
+
+void AirRaidState::fly()
+{
+	Mod *mod = _game->getMod();
+	const auto &R = mod->getAirRaidRules();
+	SavedBattleGame *save = _game->getSavedGame()->getSavedBattle();
+	std::ostringstream log;
+	const int W = save->getMapSizeX(), H = save->getMapSizeY();
+
+	// 1. the guns fire first, every shot from every gun; each was planned blind: a plane and a lead
+	std::vector<Shot> shots;
+	if (_defend) shots = _shots;   // the player's plan
+	else
+	{
+		// Cobra's guns: a lead guessed per shot, spread over the planes still flying
+		auto it = R.siteGuns.find(_siteType);
+		if (it != R.siteGuns.end())
+			for (const auto &gunType : it->second)
+			{
+				auto g = R.guns.find(gunType);
+				if (g == R.guns.end()) continue;
+				for (int s = 0; s < g->second.shots; ++s)
+				{
+					Shot sh; sh.gun = gunType; sh.plane = -1;
+					const int roll = RNG::generate(0, 99);
+					sh.lead = roll < 25 ? 0 : roll < 65 ? 1 : 2;
+					shots.push_back(sh);
+				}
+			}
+	}
+	int nShot = 0;
+	for (const auto &sh : shots)
+	{
+		auto g = R.guns.find(sh.gun);
+		if (g == R.guns.end()) continue;
+		const auto &gun = g->second;
+		int pi = sh.plane;
+		if (pi < 0)
+		{
+			std::vector<int> alive;
+			for (size_t i = 0; i < _planes.size(); ++i) if (!_planes[i].down) alive.push_back((int)i);
+			if (alive.empty()) break;
+			pi = alive[nShot++ % alive.size()];
+		}
+		if (pi >= (int)_planes.size()) continue;
+		auto &p = _planes[pi];
+		log << tr(sh.gun) << " > " << (pi + 1) << ": ";
+		if (p.down) { log << tr("STR_AR_SHOT_ALREADY_DOWN") << "\n"; continue; }
+		const int d = std::abs(sh.lead - p.speed);
+		bool hit = false, graze = false;
+		if (gun.kind == "mg") hit = p.speed == 0 && d == 0 && RNG::percent(gun.chance);   // low planes only
+		else if (gun.kind == "missile") hit = RNG::percent(d == 0 ? gun.chance : gun.chance / 2);
+		else if (gun.kind == "aa" || gun.kind == "flak") { if (d == 0) hit = RNG::percent(gun.chance); else if (d == 1) graze = true; }
+		else { if (d == 0) hit = RNG::percent(gun.chance); else if (d == 1) hit = RNG::percent(gun.chance / 2); }
+		if (hit)
+		{
+			if (p.hit || RNG::percent(R.downOnHit)) { p.down = true; log << tr("STR_AR_SHOT_DOWN"); }
+			else { p.hit = true; log << tr("STR_AR_SHOT_HIT"); }
+			if (gun.kind == "flak")
+				for (auto &o : _planes)
+					if (&o != &p && !o.down && std::abs(o.tx - p.tx) <= R.flakSplash && std::abs(o.ty - p.ty) <= R.flakSplash)
+						o.grazes++;
+		}
+		else if (graze) { p.grazes++; log << tr("STR_AR_SHOT_GRAZE"); }
+		else log << tr("STR_AR_SHOT_MISS");
+		log << "\n";
+	}
+
+	// 2. every plane still flying drops on its target; every bomb lands somewhere
+	int unitsBefore = 0, hpBefore = 0;
+	for (auto *u : *save->getUnits()) if (u->getOriginalFaction() == FACTION_HOSTILE && u->getHealth() > 0) { ++unitsBefore; hpBefore += u->getHealth(); }
+	// what stands before the bombs: every part of every tile (a part destroyed is gone or swapped for its wreck)
+	const std::vector<const MapData*> before = AirRaid::snapshot(save);
+	const RuleDamageType *he = mod->getDamageType(DT_HE);
+	auto inMap = [&](int &x, int &y) { x = std::max(0, std::min(W - 1, x)); y = std::max(0, std::min(H - 1, y)); };
+	for (size_t i = 0; i < _planes.size(); ++i)
+	{
+		auto &p = _planes[i];
+		if (p.down) continue;
+		int acc = R.accuracy.size() > (size_t)p.speed ? R.accuracy[p.speed] : 80;
+		acc -= R.graze * p.grazes + (p.hit ? R.hit : 0);
+		acc = std::max(0, std::min(100, acc));
+		// one bombing run (John 16 Nov 15:39): one roll on the ladder, the whole load lands as a stick along the run
+		{
+			const int r = RNG::generate(0, 99);
+			int kind = r < acc ? 0 : 1 + std::min(2, (r - acc) * 3 / std::max(1, 100 - acc));
+			int x = p.tx, y = p.ty;
+			if (kind == 1)
+			{
+				// beside it: the nearest structure two to four tiles off
+				bool found = false;
+				for (int rad = 2; rad <= 4 && !found; ++rad)
+				{
+					std::vector<std::pair<int, int> > cand;
+					for (int dy = -rad; dy <= rad; ++dy)
+						for (int dx = -rad; dx <= rad; ++dx)
+						{
+							if (std::max(std::abs(dx), std::abs(dy)) != rad) continue;
+							int cx = p.tx + dx, cy = p.ty + dy;
+							if (cx < 0 || cy < 0 || cx >= W || cy >= H) continue;
+							if (AirRaid::structure(save, cx, cy)) cand.push_back({ cx, cy });
+						}
+					if (!cand.empty()) { auto c = cand[RNG::generate(0, (int)cand.size() - 1)]; x = c.first; y = c.second; found = true; }
+				}
+				if (!found) { x += RNG::generate(-2, 2); y += 2; }
+			}
+			else if (kind == 2)
+			{
+				// short, on the way in: the first wall on its run from the south edge
+				bool found = false;
+				for (int yy = p.ty + 3; yy < H && !found; ++yy)
+					if (AirRaid::structure(save, p.tx, yy)) { y = yy; found = true; }
+				if (!found) kind = 3;
+			}
+			if (kind == 3)
+			{
+				const double a = RNG::generate(0, 359) * 3.14159265358979 / 180.0;
+				const int rad = RNG::generate(6, 9);
+				x = p.tx + (int)std::lround(std::cos(a) * rad);
+				y = p.ty + (int)std::lround(std::sin(a) * rad);
+			}
+			for (int b = 0; b < p.bombs; ++b)
+			{
+				int bx = x, by = y + 2 * b - (p.bombs - 1);   // two tiles apart, north-south, the way it flies
+				inMap(bx, by);
+				const int z = std::max(0, AirRaid::topLevel(save, bx, by));
+				const Position voxel(bx * 16 + 8, by * 16 + 8, z * 24 + 2);
+				save->getTileEngine()->explode(BattleActionAttack{ }, voxel, p.heavy ? R.heavyPower : R.lightPower, he,
+					p.heavy ? R.heavyRadius : R.lightRadius);
+				_impacts.push_back(AirRaid::Impact{ (int)i, bx, by, kind });
+			}
+			static const char *KINDS[4] = { "STR_AR_DIRECT", "STR_AR_NEAR", "STR_AR_WALL", "STR_AR_CLEAN" };
+			log << (i + 1) << ": " << tr(KINDS[kind]) << "\n";
+		}
+	}
+	int unitsAfter = 0, hpAfter = 0;
+	for (auto *u : *save->getUnits()) if (u->getOriginalFaction() == FACTION_HOSTILE && u->getHealth() > 0) { ++unitsAfter; hpAfter += u->getHealth(); }
+	const std::vector<const MapData*> after = AirRaid::snapshot(save);
+	// what broke stays broken until Cobra repairs it: record it on the site, newest over oldest
+	if (_base) AirRaid::recordWreck(_base, save, before);
+	int parts = 0, standing = 0;
+	for (size_t i = 0; i < before.size(); ++i) { if (before[i]) ++standing; if (before[i] && before[i] != after[i]) ++parts; }
+	std::ostringstream res;
+	int lossPct = 0, taken = 0;
+	if (_defend)
+	{
+		// the outpost: a direct hit wrecks the module the plane was after, a near miss damages the one beside it;
+		// either way it is out until repaired (half the build cost now, half the build days: AIR_RAID_DESIGN_v1 s.1)
+		std::vector<BaseFacility*> hitList;
+		int down = 0;
+		for (size_t i = 0; i < _planes.size(); ++i)
+		{
+			if (_planes[i].down) { ++down; continue; }
+			int kind = 3;
+			for (const auto &im : _impacts) if (im.plane == (int)i) { kind = im.kind; break; }
+			BaseFacility *f = nullptr;
+			if (kind == 0) f = i < _planeTargets.size() ? _planeTargets[i] : nullptr;
+			else if (kind == 1)
+			{
+				std::vector<BaseFacility*> others;
+				for (auto *g : *_outpost->getFacilities())
+					if (g != (i < _planeTargets.size() ? _planeTargets[i] : nullptr) && g->getBuildTime() == 0 && !g->getRules()->isLift()) others.push_back(g);
+				if (!others.empty()) f = others[RNG::generate(0, (int)others.size() - 1)];
+			}
+			if (f && f->getBuildTime() == 0 && std::find(hitList.begin(), hitList.end(), f) == hitList.end()) hitList.push_back(f);
+		}
+		int cost = 0;
+		for (auto *f : hitList)
+		{
+			f->setBuildTime(std::max(1, f->getRules()->getBuildTime() / 2));
+			cost += f->getRules()->getBuildCost() / 2;
+			_hitReport.push_back(tr(f->getRules()->getType()));
+		}
+		_game->getSavedGame()->setFunds(_game->getSavedGame()->getFunds() - cost);
+		std::ostringstream wrecked;
+		for (size_t j = 0; j < _hitReport.size(); ++j) wrecked << (j ? ", " : "") << _hitReport[j];
+		res << tr("STR_AR_DEFEND_RESULT").arg(down).arg((int)_planes.size()).arg(_hitReport.empty() ? std::string(tr("STR_AR_NOTHING")) : wrecked.str()).arg(Unicode::formatFunding(cost))
+			<< "\n\n" << log.str();
+		lossPct = (int)hitList.size();
+	}
+	else
+	{
+		lossPct = std::min(R.lossCap, parts * 100 * R.lossScale / std::max(1, standing));
+		taken = _game->getSavedGame()->cobraBombed(_base, mod, lossPct);
+		res << tr("STR_AR_RESULT").arg(parts).arg(unitsBefore - unitsAfter).arg(std::max(0, hpBefore - hpAfter - 0)).arg(taken) << "\n\n" << log.str();
+	}
+	_txtInfo->setVisible(false);
+	_txtResult->setVisible(true);
+	_txtResult->setText(res.str());
+	Log(LOG_INFO) << "[airraid] " << (_defend ? std::string("defence") : _siteType) << ": " << _impacts.size() << " bombs, " << parts << " parts destroyed, "
+		<< (unitsBefore - unitsAfter) << " Cobra down, " << lossPct << "% loss (" << taken << ")";
+	for (auto *b : _btnPlanes) b->setVisible(false);
+	for (auto *b : _btnShots) b->setVisible(false);
+	_flown = true;
+	refresh();
+}
+
+void AirRaidState::finish()
+{
+	const auto &R = _game->getMod()->getAirRaidRules();
+	if (_defend)
+	{
+		int down = 0;
+		for (auto &p : _planes) if (p.down) ++down;
+		_game->getSavedGame()->cobraBombersLost(_game->getMod(), _outpost, down);
+		_outpost->addAirRaid();
+		_game->getSavedGame()->setBattleGame(nullptr);
+		_outpost->setInBattlescape(false);
+		_game->popState();
+		return;
+	}
+	GeoscapeState::AirFightResult res;
+	for (auto &p : _planes)
+	{
+		GeoscapeState::AirFightResult::One one;
+		one.craft = p.craft;
+		one.lost = p.down;
+		one.pilotId = p.pilotId;
+		const int now = p.craft->getDamageMax() > 0 ? 100 - p.craft->getDamage() * 100 / p.craft->getDamageMax() : 100;
+		one.healthPct = std::max(1, now - R.grazeDamage * p.grazes - (p.hit ? R.hitDamage : 0));
+		res.crafts.push_back(one);
+		if (!p.down) p.craft->returnToBase();
+	}
+	_game->getSavedGame()->setBattleGame(nullptr);
+	_game->popState();
+	if (GeoscapeState *gs = _game->getGeoscapeState()) gs->finishAirFight(res);
+}
+
+}
diff --git a/src/Geoscape/AirRaid.h b/src/Geoscape/AirRaid.h
new file mode 100644
index 0000000..242ac59
--- /dev/null
+++ b/src/Geoscape/AirRaid.h
@@ -0,0 +1,137 @@
+#pragma once
+/*
+ * G.I. Joe: AIR RAIDS, phase 1 - the Joes bomb a Cobra site (claude/AIR_RAID_DESIGN_v1.md; BRIEF_FOR_BUILD_AirRaids;
+ * John 16 Nov 14:26 "Go"). One pass, Battleship-style:
+ *   1. the Joes plan in secret: each plane a speed (slow / medium / fast) and one target on the site's map;
+ *   2. Cobra's guns plan in secret: each shot a plane and a lead (its guess at that plane's speed);
+ *   3. every gun fires all its shots, then every plane still flying drops on its target;
+ *   4. each bomb is a real engine explosion on the site's real battle map (collapse included); the ladder
+ *      (direct / near miss / wall / clean miss) only decides where it lands.
+ * Phase 1 limits, said plainly: the site's guns are a STAND-IN per site type (airRaid: siteGuns) until
+ * COBRA_OUTPOSTS_v1 settles what Cobra builds; the wreckage does NOT persist yet (phase 2) - what a raid takes
+ * from Cobra now is men and a share of the site's funds and materiel.
+ */
+#include <string>
+#include <vector>
+#include "../Engine/State.h"
+#include "../Engine/InteractiveSurface.h"
+#include "../Battlescape/Position.h"
+
+namespace OpenXcom
+{
+
+class Mod;
+class Game;
+class Craft;
+class AlienBase;
+class SavedBattleGame;
+class MapData;
+class Texture;
+class Base;
+class BaseFacility;
+class Window;
+class Text;
+class TextButton;
+
+namespace AirRaid
+{
+	struct Plane
+	{
+		Craft *craft = nullptr;
+		int speed = 1;            ///< 0 slow, 1 medium, 2 fast
+		int tx = -1, ty = -1;     ///< target tile
+		int bombs = 1;
+		bool heavy = false;
+		bool down = false, hit = false;
+		int grazes = 0;
+		int pilotId = 0;
+	};
+	struct Impact { int plane; int x, y; int kind; };   ///< kind 0 direct, 1 near miss, 2 wall, 3 clean miss
+	/// can this craft fly a raid?
+	bool canBomb(const Mod *mod, const Craft *craft);
+	/// the Cobra site type the raid can be flown on ("" = none)
+	bool canBeBombed(const Mod *mod, const AlienBase *base);
+	/// every part of every tile of a battle map, in tile order
+	std::vector<const MapData*> snapshot(SavedBattleGame *save);
+	/// what changed since 'before' is kept on the site until Cobra repairs it (SABOTAGE_DESIGN: lasting damage);
+	/// returns how many parts changed
+	int recordWreck(AlienBase *base, SavedBattleGame *save, const std::vector<const MapData*> &before);
+}
+
+/// G.I. Joe SQUADRONS (phase 4; John 13:36-13:47): two or more aircraft that launch, fly and come home together,
+/// at the slowest one's speed. The lead plane needs a named pilot. A travel group only: every plane is its own unit
+/// in a dogfight or an air raid; no bonus, no penalty.
+namespace Squadron
+{
+	/// can this craft lead a squadron (an aircraft with a named pilot in the seat)?
+	bool canLead(const Mod *mod, Craft *craft);
+	/// the lead this craft flies with (nullptr: none, or the lead is gone or can't lead)
+	Craft *leadOf(const Mod *mod, Base *base, const Craft *craft);
+	/// how many fly with this lead
+	int followers(Base *base, const Craft *lead);
+	/// every 5 seconds: followers launch with their lead, keep with it, come home with it
+	void sync(Game *game);
+}
+
+/// The overhead view of the site (painted at display resolution), the targets and, after the pass, the impacts.
+class AirRaidMapView : public InteractiveSurface
+{
+	const Mod *_mod = nullptr;
+	SavedBattleGame *_save = nullptr;
+	std::vector<AirRaid::Plane> *_planes = nullptr;
+	std::vector<AirRaid::Impact> *_impacts = nullptr;
+	int _selected = 0;
+	double _mx = -1, _my = -1;
+	double cell() const;
+	void paint(double X0, double Y0, double k);
+public:
+	AirRaidMapView(int width, int height, int x, int y);
+	~AirRaidMapView();
+	void setup(const Mod *mod, SavedBattleGame *save, std::vector<AirRaid::Plane> *planes, std::vector<AirRaid::Impact> *impacts);
+	void setSelected(int i) { _selected = i; }
+	/// the tile under the mouse; false off the map
+	bool tileUnderMouse(int &x, int &y) const;
+	void mouseOver(Action *action, State *state) override;
+	void mousePress(Action *action, State *state) override;
+	void draw() override;
+};
+
+/// The raid: plan, the pass, the results.
+class AirRaidState : public State
+{
+	AlienBase *_base = nullptr;
+	// phase 3: Cobra bombs a Joe outpost; the player is the defence
+	Base *_outpost = nullptr;
+	bool _defend = false;
+	struct Shot { std::string gun; int plane = 0; int lead = 1; };
+	std::vector<Shot> _shots;
+	std::vector<TextButton*> _btnShots;
+	std::vector<BaseFacility*> _planeTargets;   ///< what each Cobra plane is after (defend)
+	std::vector<std::string> _hitReport;
+	Window *_window;
+	Text *_txtTitle, *_txtInfo, *_txtResult;
+	AirRaidMapView *_map;
+	std::vector<TextButton*> _btnPlanes;
+	TextButton *_btnFly, *_btnCancel;
+	std::vector<AirRaid::Plane> _planes;
+	std::vector<AirRaid::Impact> _impacts;
+	int _selected = 0;
+	bool _flown = false;
+	std::string _siteType;
+	void refresh();
+	void fly();
+	void finish();
+public:
+	AirRaidState(Craft *craft, AlienBase *base, Texture *missionTexture, Texture *globeTexture, int shade);
+	/// Cobra's bombers over a Joe outpost (phase 3)
+	AirRaidState(Base *outpost, int planes);
+	void btnShotClick(Action *action);
+	void btnShotRightClick(Action *action);
+	~AirRaidState();
+	void btnPlaneClick(Action *action);
+	void mapClick(Action *action);
+	void btnFlyClick(Action *action);
+	void btnCancelClick(Action *action);
+};
+
+}
