+Uint8 ResearchTreeState::nearest(Uint32 rgb) const
+{
+	const SDL_Color *pal = _view->getPalette();
+	int best = 1, bd = INT_MAX;
+	const int r = (rgb >> 16) & 255, g = (rgb >> 8) & 255, b = rgb & 255;
+	for (int i = 1; i < 256; ++i)
+	{
+		const int d = (pal[i].r - r) * (pal[i].r - r) + (pal[i].g - g) * (pal[i].g - g) + (pal[i].b - b) * (pal[i].b - b);
+		if (d < bd) { bd = d; best = i; }
+	}
+	return (Uint8)best;
+}
