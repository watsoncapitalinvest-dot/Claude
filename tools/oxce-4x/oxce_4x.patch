+void result(const std::string &line)
+{
+	if (campaign() > 0 && line.compare(0, 9, "CAMPAIGN ") != 0)
+	{
+		// a campaign fights many battles: each result is a line in battles.txt, and the run goes on
+		Log(LOG_INFO) << "[sim] BATTLE " << line;
+		std::ofstream b(out("battles.txt"), std::ios::app);
+		b << line << "\n";
+		note("BATTLE " + line);
+		return;
+	}
+	if (resultWritten) return;
+	resultWritten = true;
+	Log(LOG_INFO) << "[sim] RESULT " << line;
+	std::ofstream f(out("result.txt"), std::ios::trunc);
+	f << line << "\n";
+}
