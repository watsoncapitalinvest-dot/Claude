+void plantStart(Game *game)
+{
+	SavedGame *save = game->getSavedGame();
+	const Mod *mod = game->getMod();
+	const auto &r = mod->getCobraNetworkRules();
+	if (!r.on || save->getCobraNet().count("planted") || save->getBases()->empty()) return;
+	save->getCobraNet()["planted"] = 1;
+	const Base *pit = save->getBases()->front();
+	std::vector<Town> all = towns(mod), ok;
+	for (const auto &t : all)
+		if (km(t.lon, t.lat, pit->getLongitude(), pit->getLatitude()) >= r.minKmFromPit) ok.push_back(t);
+	if (ok.empty()) ok = all;
+	// rolled each campaign: shuffle the candidates, then make sure one front is within reach of the Pit
+	for (size_t i = ok.size(); i > 1; --i) std::swap(ok[i - 1], ok[RNG::generate(0, (int)i - 1)]);
+	std::vector<Town> townsOnly, junctions;
+	for (const auto &t : ok) (t.kind == "junction" ? junctions : townsOnly).push_back(t);
+	for (size_t i = 0; i < townsOnly.size(); ++i)
+		if (km(townsOnly[i].lon, townsOnly[i].lat, pit->getLongitude(), pit->getLatitude()) <= r.nearKmFromPit)
+		{
+			std::swap(townsOnly[0], townsOnly[i]);
+			break;
+		}
+	const int hs = save->getCobraHeadStart();
+	const int fronts = r.startFronts + (r.headStartFrontPerMonths > 0 ? hs / r.headStartFrontPerMonths : 0);
+	const int cells = r.startCells + (r.headStartCellPerMonths > 0 ? hs / r.headStartCellPerMonths : 0);
+	const int depots = r.startDepots + (r.headStartDepotPerMonths > 0 ? hs / r.headStartDepotPerMonths : 0);
+	std::vector<Town> frontTowns;
+	for (int i = 0; i < fronts && i < (int)townsOnly.size(); ++i)
+	{
+		if (plant(game, "STR_COBRA_FRONT_COMPANY_SITE", townsOnly[i], 8)) frontTowns.push_back(townsOnly[i]);
+	}
+	// cells in the same towns as the fronts or close by
+	for (int i = 0; i < cells; ++i)
+	{
+		const Town &t = !frontTowns.empty() ? frontTowns[i % frontTowns.size()] : townsOnly[(fronts + i) % townsOnly.size()];
+		// a cell hides in a rented house or a farmhouse (answers 2a; the apartment over a shop waits for its map)
+		plant(game, game->getMod()->getDeployment("STR_COBRA_CELL_FARM_SITE") && RNG::percent(50) ? "STR_COBRA_CELL_FARM_SITE" : "STR_COBRA_CELL_SITE", t, 25);
+	}
+	if (junctions.empty()) junctions = townsOnly;
+	for (int i = 0; i < depots && !junctions.empty(); ++i) plant(game, "STR_COBRA_DEPOT_SITE", junctions[i % junctions.size()], 8);
+	// the money it starts with, in North America where the network stands
+	std::string region;
+	if (!save->getAlienBases()->empty())
+		if (Region *rg = save->locateRegion(*save->getAlienBases()->back())) region = rg->getRules()->getType();
+	if (!region.empty())
+	{
+		save->getCobraEconomy().addFunds(region, r.startFunds);
+		save->getCobraEconomy().addMateriel(region, r.startMateriel);
+	}
+	// the two dates, rolled now and kept
+	save->getCobraNet()["broadcastDay"] = RNG::generate(pick(r.broadcastDays, 0, 20), pick(r.broadcastDays, 1, 60));
+	save->getCobraNet()["factoryDay"] = RNG::generate(pick(r.factoryDays, 0, 50), pick(r.factoryDays, 1, 60));
+	Log(LOG_INFO) << "[network] planted " << fronts << " fronts, " << cells << " cells, " << depots << " depots; broadcast day "
+		<< save->getCobraNet()["broadcastDay"] << ", factory day " << save->getCobraNet()["factoryDay"];
+}
+
+void daily(Game *game, GeoscapeState *geo)
+{
+	SavedGame *save = game->getSavedGame();
+	Mod *mod = game->getMod();
+	const auto &r = mod->getCobraNetworkRules();
+	// G.I. Joe: events keyed on a topic being known (gijoeEventsOnResearch), e.g. the ranch lost -> the flight spotted
+	for (const auto &kv : mod->getGijoeEventsOnResearch())
+	{
+		auto &flags = save->getCobraNet();
+		const std::string key = "evt|" + kv.first;
+		if (flags.count(key)) continue;
+		const RuleResearch *t = mod->getResearch(kv.first, false);
+		if (!t || !save->isResearched(t)) continue;
+		flags[key] = 1;
+		if (const RuleEvent *e = mod->getEvent(kv.second, false))
+		{
+			save->spawnEvent(e);
+			Log(LOG_INFO) << "[cartel] " << kv.first << " known: " << kv.second << " spawned";
+		}
+	}
+	if (!r.on) return;
+	if (!save->getCobraNet().count("planted")) plantStart(game);
+	if (!save->getCobraNet().count("planted")) return;
+	auto &net = save->getCobraNet();
+	const int day = save->getDaysPassed();
+	(void)geo;
+
+	// test rig (OXCE_CRIME_TODAY=<deployment>): one crime from the first cell, set down beside the first Joe base, 48 h
+	if (const char *t = getenv("OXCE_CRIME_TODAY"))
+		if (!net.count("crimeTested") && !save->getBases()->empty())
+			for (auto *b : *save->getAlienBases())
+				if (b->getSiteType() == CELL)
+				{
+					net["crimeTested"] = 1;
+					if (MissionSite *ms = spawnSite(game, "STR_COBRA_CRIME_MISSION", *t ? t : "STR_COBRA_BANK_JOB", b, "crime|" + siteKey(b),
+						"STR_ALERT_BANK_ROBBERY", townOf(save, b, towns(mod)), ""))
+					{
+						Base *home = save->getBases()->front();
+						ms->setLongitude(home->getLongitude() + 0.01); ms->setLatitude(home->getLatitude() + 0.01);
+						ms->setSecondsRemaining(48 * 3600);
+					}
+					break;
+				}
+	// test rig (OXCE_RESEARCH_TODAY=<topic>): that topic counts as researched from today, once (to see what it sets off)
+	if (const char *t = getenv("OXCE_RESEARCH_TODAY"))
+		if (!net.count("researchTested") && mod->getResearch(t, false))
+		{
+			net["researchTested"] = 1;
+			save->addFinishedResearch(mod->getResearch(t, false), mod, save->getBases()->empty() ? nullptr : save->getBases()->front(), false);
+			Log(LOG_INFO) << "[rig] " << t << " researched";
+		}
+	// The Drome seen without its plans (the plans' own research plays act1DromePlans): the reconnaissance photograph
+	if (!net.count("dromeSeen"))
+	{
+		for (auto *b : *save->getAlienBases())
+			if (b->getSiteType() == "STR_COBRA_TERROR_DROME" && b->isDiscovered())
+			{
+				net["dromeSeen"] = day;
+				if (!researched(game, "STR_TERROR_DROME_PLANS"))
+					if (const RuleEvent *ev = mod->getEvent("STR_EVENT_DROME_NO_PLANS")) save->spawnEvent(ev);
+				break;
+			}
+	}
+	// The close of Act 1: once the M.A.R.S. rifle is read. A if no Drome stands any more, B if one does.
+	if (net.count("marsWeapon") && !net.count("act1Closed") && researched(game, "STR_MARS_MARKED_WEAPON"))
+	{
+		bool stands = false;
+		for (auto *b : *save->getAlienBases()) if (b->getSiteType().compare(0, 22, "STR_COBRA_TERROR_DROME") == 0) stands = true;
+		net["act1Closed"] = day;
+		if (const RuleEvent *ev = mod->getEvent(stands ? "STR_EVENT_ACT1_CLOSE_STANDS" : "STR_EVENT_ACT1_CLOSE_TAKEN")) save->spawnEvent(ev);
+		Log(LOG_INFO) << "[network] Act 1 closes: the Drome " << (stands ? "still stands" : "has fallen");
+	}
+
+	// STEALTH SIGHT item 14: readiness eases back a step every 30 quiet days (no loud mission in the region)
+	for (auto &kv : net)
+	{
+		if (kv.first.compare(0, 6, "ready:") != 0 || kv.second <= 0) continue;
+		const std::string rg = kv.first.substr(6);
+		int &since = net["readyDay:" + rg];
+		if (day - since >= 30)
+		{
+			--kv.second; since = day;
+			save->addLeadNews("STR_COBRA_READINESS_DOWN|" + std::string(game->getLanguage()->getString(rg)) + " (" + std::to_string(kv.second) + "/3)");
+			Log(LOG_INFO) << "[network] Cobra readiness in " << rg << " eases to " << kv.second;
+		}
+	}
+	// 5a: Cobra Commander's broadcast on its own day
+	if (!net.count("broadcastDone") && day >= net["broadcastDay"])
+	{
+		net["broadcastDone"] = day;
+		net["firstJobDay"] = day + RNG::generate(pick(r.firstJobDays, 0, 2), pick(r.firstJobDays, 1, 4));   // Cobra's first job follows the broadcast within days (below)
+		if (const RuleEvent *ev = mod->getEvent("STR_EVENT_COBRA_BROADCAST")) save->spawnEvent(ev);
+		Log(LOG_INFO) << "[network] Cobra Commander's broadcast, day " << day;
+	}
+	// 5d-f: the factory's date
+	const int fday = net["factoryDay"];
+	if (!net.count("factoryWarned") && researched(game, r.factoryScheduleResearch) && day >= fday - r.factoryWarnDays && day < fday)
+	{
+		net["factoryWarned"] = day;
+		if (const RuleEvent *ev = mod->getEvent("STR_EVENT_FACTORY_WARNING")) save->spawnEvent(ev);
+	}
+	if (!net.count("factoryDone") && day >= fday)
+	{
+		net["factoryDone"] = day;
+		if (researched(game, r.factoryWonResearch))
+		{
+			if (const RuleEvent *ev = mod->getEvent("STR_EVENT_FACTORY_WRECKED")) save->spawnEvent(ev);
+			Log(LOG_INFO) << "[network] the factory date passed with the factory already won: the gates are chained";
+		}
+		else
+		{
+			Town f; f.name = "West Texas";
+			f.lon = r.factoryLon * PI_ / 180.0; if (f.lon < 0) f.lon += 2 * PI_;
+			f.lat = -r.factoryLat * PI_ / 180.0;
+			if (AlienBase *ab = plant(game, "STR_COBRA_FACTORY_SITE", f, 0))
+			{
+				ab->setDiscovered(true);   // the player knew where the plant was; now it is running
+				net["factorySite"] = ab->getId();
+				net["rearmed"] = 1;
+			}
+			// the abandoned-factory mission, if still open, is over: Cobra holds the plant now
+			for (auto it = save->getMissionSites()->begin(); it != save->getMissionSites()->end(); ++it)
+				if ((*it)->getDeployment() && (*it)->getDeployment()->getType() == "STR_ABANDONED_FACTORY" && !(*it)->isInBattlescape())
+				{
+					delete *it; save->getMissionSites()->erase(it); break;
+				}
+			if (const RuleEvent *ev = mod->getEvent("STR_EVENT_FACTORY_REACTIVATED")) save->spawnEvent(ev);
+			Log(LOG_INFO) << "[network] the factory reopened, day " << day;
+		}
+	}
+	// the rearmed region drops back once the live factory is shut
+	if (net.count("rearmed") && net["rearmed"])
+	{
+		bool standing = false;
+		for (auto *b : *save->getAlienBases()) if (b->getSiteType() == "STR_COBRA_FACTORY" && b->getId() == net["factorySite"]) standing = true;
+		if (!standing) net["rearmed"] = 0;
+	}
+
+	// piece 6: Cobra Commander's will, once a month
+	if (net["willMonth"] != save->getMonthsPassed() + 1)
+	{
+		net["willMonth"] = save->getMonthsPassed() + 1;
+		willMonthly(game);
+		bluddMonthly(game);
+		// New cells (COBRA_OUTPOSTS 4i, answers 2h): Cobra plants a cell beside a front company when it has fewer than two,
+		// for 100 of its funds; one in three is a SLEEPER, silent and unfindable for 2-4 months before it wakes.
+		{
+			int cells = 0;
+			std::vector<AlienBase*> fronts;
+			for (auto *b : *save->getAlienBases()) { if (b->getSiteType() == CELL) cells++; if (b->getSiteType() == FRONT) fronts.push_back(b); }
+			if (cells < 2 && !fronts.empty() && save->getCobraEconomy().getFunds("STR_NORTH_AMERICA") >= 100 && save->getMonthsPassed() >= 1)
+			{
+				AlienBase *f = fronts[RNG::generate(0, (int)fronts.size() - 1)];
+				Town t; t.name = townOf(save, f, towns(mod)); t.lon = f->getLongitude(); t.lat = f->getLatitude();
+				if (AlienBase *c = plant(game, RNG::percent(50) && mod->getDeployment("STR_COBRA_CELL_FARM_SITE") ? "STR_COBRA_CELL_FARM_SITE" : "STR_COBRA_CELL_SITE", t, 25))
+				{
+					save->getCobraEconomy().addFunds("STR_NORTH_AMERICA", -100);
+					if (RNG::percent(33))
+					{
+						net["sleeper:" + siteKey(c)] = save->getMonthsPassed() + RNG::generate(2, 4);
+						Log(LOG_INFO) << "[network] the new cell is a sleeper";
+					}
+				}
+			}
+		}
+		// piece 9, the M.A.R.S. standing order (John's rule, Act1Fixes item 8): Cobra always buys some guns - the larger of
+		// a flat 40 and a tenth of its funds - and they come in by road, a convoy the Joes can stop. A convoy that gets
+		// through delivers the materiel to the region; one that is stopped delivers nothing.
+		{
+			const int funds = save->getCobraEconomy().getFunds("STR_NORTH_AMERICA");
+			const int buy = std::min(funds, std::max(40, funds / 10));
+			AlienBase *dest = nullptr;
+			for (auto *b : *save->getAlienBases()) if (b->getSiteType() == DEPOT) { dest = b; break; }
+			if (!dest) for (auto *b : *save->getAlienBases()) if (b->getSiteType() == FRONT) { dest = b; break; }
+			if (buy >= 40 && dest && !net.count("broadcastDone"))
+			{
+				// John 18 Nov 02:45 "Shouldn't be seeing cobra so early": before the broadcast the guns arrive unseen
+				save->getCobraEconomy().addFunds("STR_NORTH_AMERICA", -buy);
+				save->getCobraEconomy().addMateriel("STR_NORTH_AMERICA", buy);
+				Log(LOG_INFO) << "[network] the M.A.R.S. order came in unseen (before the broadcast): " << buy << " materiel";
+			}
+			else if (buy >= 40 && dest)
+			{
+				if (MissionSite *ms = spawnSite(game, "STR_COBRA_CRIME_MISSION", "STR_COBRA_CONVOY", dest, "mars|" + siteKey(dest),
+					"STR_ALERT_CONVOY", townOf(save, dest, towns(mod)), ""))
+				{
+					save->getCobraEconomy().addFunds("STR_NORTH_AMERICA", -buy);
+					net["mars:" + std::to_string(ms->getId())] = buy;
+				}
+			}
+		}
+		// piece 9, money to a starving region (ledger 1.7, Act1Fixes item 6): with fewer than 4 working sites in North
+		// America, Cobra sends in 150 funds for each one missing. STAND-IN: it comes by road (the van stop), not by air,
+		// until a cargo flight can be tracked from launch to landing; stop the van and the money never arrives.
+		{
+			int working = 0;
+			for (auto *b : *save->getAlienBases())
+				if (!b->getSiteType().empty() && b->getSiteType() != "STR_COBRA_TERROR_DROME_BUILDING" && b->getSiteType() != "STR_CARTEL_STASH_HOUSE") working++;
+			if (working < 4 && save->getMonthsPassed() >= 1)
+			{
+				AlienBase *dest = nullptr;
+				for (auto *b : *save->getAlienBases()) if (!b->getSiteType().empty() && b->getSiteType() != "STR_COBRA_TERROR_DROME_BUILDING") { dest = b; break; }
+				if (dest)
+					if (MissionSite *ms = spawnSite(game, "STR_COBRA_CRIME_MISSION", "STR_COBRA_VAN_STOP", dest, "money|" + siteKey(dest),
+						"STR_ALERT_VAN_STOP", townOf(save, dest, towns(mod)), ""))
+						net["mars:" + std::to_string(ms->getId())] = 150 * (4 - working);
+			}
+		}
+	}
+
+	// 2, 3: the crimes and the strikes, rolled a day at a time (a monthly chance spread over thirty days)
+	const int month = save->getMonthsPassed();
+	const int di = diffIndex(save);
+	const int mult = pick(r.diffChance, di, 100);
+	const std::vector<Town> ts = towns(mod);
+	std::vector<AlienBase *> launchers;
+	for (auto *b : *save->getAlienBases())
+		if (b->getSiteType() == FRONT || b->getSiteType() == CELL) launchers.push_back(b);
+	for (auto *b : launchers)
+	{
+		const std::string key = siteKey(b);
+		const bool isCell = b->getSiteType() == CELL;
+		if (isCell && net.count("sleeper:" + key))
+		{
+			if (net["sleeper:" + key] > month) continue;   // still asleep: no jobs, nothing to find
+			net.erase("sleeper:" + key);
+			Log(LOG_INFO) << "[network] the sleeper cell " << key << " wakes";
+		}
+		Region *rg = save->locateRegion(*b);
+		const std::string region = rg ? rg->getRules()->getType() : std::string();
+		const int bold = (net.count("bold:" + region) && net["bold:" + region] == month) ? 125 : 100;
+		// one job per site a month; a stopped one makes it wait another
+		if (!net.count("cool:" + key) || net["cool:" + key] <= day)
+		{
+			const double p = r.crimeChance / 100.0 * mult / 100.0 * bold / 100.0;
+			if (RNG::generate(0, 99999) < (int)(p / 30.0 * 100000))
+			{
+				// John 18 Nov 02:45 "Shouldn't be seeing cobra so early": until Cobra Commander's broadcast (day 20-60) the
+				// network's jobs are done by hired hands - only the cartel's own jobs run; nothing that fields Cobra men
+				std::vector<std::string> list = isCell ? r.cellCrimes : r.frontCrimes;
+				// 18 Nov (BUILD-1's 60-day run): the hired hands' armored-car job turned up outside Billings on day 19, a second
+				// "armored car" robbery before the cartel arc's own one (its step 4, tipped off by the informant, on US-90) and
+				// far from the cartel's border. So before the broadcast the network does no jobs at all; the opening belongs to
+				// the cartel arc. Cobra's jobs start the day after the broadcast.
+				if (!net.count("broadcastDone"))
+					list.clear();
+				if (!list.empty())
+				{
+					const std::string dep = list[RNG::generate(0, (int)list.size() - 1)];
+					auto a = r.crimeAlerts.find(dep);
+					const std::string alert = "STR_ALERT_" + (a != r.crimeAlerts.end() ? a->second : std::string("VAN_STOP"));
+					if (spawnSite(game, "STR_COBRA_CRIME_MISSION", dep, b, "crime|" + key, alert, townOf(save, b, ts), ""))
+					{
+						net["cool:" + key] = day + 30;
+						net["firstJobDone"] = day;
+					}
+				}
+			}
+		}
+		// the cell strike, from month 2
+		if (isCell && month >= r.strikeFirstMonth && net.count("broadcastDone") && (!net.count("scool:" + key) || net["scool:" + key] <= day))
+		{
+			const double p = r.strikeChance / 100.0 * mult / 100.0 * bold / 100.0;
+			if (RNG::generate(0, 99999) < (int)(p / 30.0 * 100000) && !r.strikeTargets.empty())
+			{
+				const auto parts = split(r.strikeTargets[RNG::generate(0, (int)r.strikeTargets.size() - 1)], ',');
+				const std::string target = parts.empty() ? "POLICE" : parts[0], map = parts.size() > 1 ? parts[1] : "TOWN";
+				// 4-6 men in month 2, a man more about every 3 months, 8 at most; an officer from month 4
+				const int tier = month < 3 ? 1 : (month < 6 ? 2 : 3);
+				const std::string dep = "STR_COBRA_CELL_STRIKE_" + map + "_" + std::to_string(tier);
+				if (spawnSite(game, "STR_COBRA_CELL_STRIKE_MISSION", dep, b, "strike|" + key, "STR_ALERT_CELL_STRIKE", townOf(save, b, ts), target))
+					net["scool:" + key] = day + 30;
+			}
+		}
+	}
+	// The broadcast's follow-through (BUILD-1 18 Nov, John "1"): at 25% a site a month Cobra's first job came on average three
+	// to four weeks after the broadcast (day 44 -> day 59 in the 60-day run), so the broadcast landed on nothing. Now one job
+	// is pulled 2-4 days after it, from a front company if one is awake, else a cell; the daily rolls carry on after.
+	if (net.count("broadcastDone") && !net.count("firstJobDone") && net.count("firstJobDay") && day >= net["firstJobDay"])
+	{
+		AlienBase *from = nullptr;
+		for (int pass = 0; pass < 2 && !from; ++pass)
+			for (auto *b : launchers)
+			{
+				const bool isCell = b->getSiteType() == CELL;
+				if ((pass == 0) == isCell) continue;   // fronts first
+				if (isCell && net.count("sleeper:" + siteKey(b))) continue;
+				from = b; break;
+			}
+		net["firstJobDone"] = day;   // once, whether or not a site could send it
+		if (from)
+		{
+			const std::string key = siteKey(from);
+			// the first one reads as Cobra's: not a second armored-car robbery straight after the cartel's own
+			std::vector<std::string> list;
+			for (const auto &c : from->getSiteType() == CELL ? r.cellCrimes : r.frontCrimes)
+				if (c != "STR_ARMORED_CAR_AMBUSH") list.push_back(c);
+			if (!list.empty())
+			{
+				const std::string dep = list[RNG::generate(0, (int)list.size() - 1)];
+				auto a = r.crimeAlerts.find(dep);
+				const std::string alert = "STR_ALERT_" + (a != r.crimeAlerts.end() ? a->second : std::string("VAN_STOP"));
+				if (spawnSite(game, "STR_COBRA_CRIME_MISSION", dep, from, "crime|" + key, alert, townOf(save, from, ts), ""))
+				{
+					net["cool:" + key] = day + 30;
+					Log(LOG_INFO) << "[network] Cobra's first job after the broadcast, day " << day << ": " << dep;
+				}
+			}
+		}
+	}
+	// a cell whose purse reached the mark becomes a front company in its own town
+	for (auto *b : launchers)
+	{
+		if (b->getSiteType() != CELL) continue;
+		const std::string key = siteKey(b);
+		if (!net.count("purse:" + key) || net["purse:" + key] < r.cellGrowsAt) continue;
+		Town t; t.name = townOf(save, b, ts); t.lon = b->getLongitude(); t.lat = b->getLatitude();
+		const bool known = b->isDiscovered();
+		for (auto it = save->getAlienBases()->begin(); it != save->getAlienBases()->end(); ++it)
+			if (*it == b) { save->getAlienBases()->erase(it); break; }
+		net.erase("purse:" + key);
+		delete b;
+		if (AlienBase *f = plant(game, "STR_COBRA_FRONT_COMPANY_SITE", t, 2)) { if (known) f->setDiscovered(true); }
+		Log(LOG_INFO) << "[network] the cell in " << t.name << " grew into a front company";
+		break;   // the list is stale now; the next one grows tomorrow
+	}
+}
+
+void siteExpired(Game *game, MissionSite *site)
+{
+	SavedGame *save = game->getSavedGame();
+	if (!owns(save, site)) return;
+	auto it = save->getCobraNetSites().find(site->getId());
+	const auto parts = split(it->second, '|');
+	save->getCobraNetSites().erase(it);
+	if (parts.size() < 3) return;
+	const std::string kind = parts[0], key = parts[1], town = parts[2], target = parts.size() > 3 ? parts[3] : "";
+	const auto &r = game->getMod()->getCobraNetworkRules();
+	auto &net = save->getCobraNet();
+	Region *rg = save->locateRegion(*site);
+	if (rg) net["bold:" + rg->getRules()->getType()] = save->getMonthsPassed() + 1;   // bolder there next month
+	if (kind == "dromeStrike")
+	{
+		// nobody met it: the strike hits the base unopposed and pulls back to its Drome. It still closes Act 1 (John 13 Nov
+		// 21:08, "win or lose"), and the rifle comes from what it left at the gate.
+		Base *hit = nullptr;
+		for (auto *b : *save->getBases()) if (b->getName() == town) hit = b;
+		Log(LOG_INFO) << "[will] the Drome's strike on " << town << " went unanswered";
+		dromeFight(game, hit);
+		return;
+	}
+	if (kind == "money")
+	{
+		const std::string mk = "mars:" + std::to_string(site->getId());
+		if (rg) save->getCobraEconomy().addFunds(rg->getRules()->getType(), net[mk]);
+		Log(LOG_INFO) << "[network] Cobra's money run got through near " << town << ": " << net[mk] << " funds";
+		net.erase(mk);
+		return;
+	}
+	if (kind == "mars")
+	{
+		// the guns got through
+		const std::string mk = "mars:" + std::to_string(site->getId());
+		if (rg) save->getCobraEconomy().addMateriel(rg->getRules()->getType(), net[mk]);
+		Log(LOG_INFO) << "[network] the M.A.R.S. convoy got through near " << town << ": " << net[mk] << " materiel";
+		net.erase(mk);
+		return;
+	}
+	if (kind == "strike") net["purse:" + key] += r.strikePayout;
+	addLead(game, key, false);   // the getaway leaves a trail
+	std::string title = kind == "strike" ? tr(game, "STR_EVENT_CELL_STRIKE_MISSED") : tr(game, "STR_EVENT_CRIME_STOPPED");
+	if (kind != "strike")
+	{
+		const std::string dep = parts.size() > 4 ? parts[4] : "";
+		auto a = r.crimeAlerts.find(dep);
+		const std::string what = a != r.crimeAlerts.end() ? a->second : "VAN_STOP";
+		title = tr(game, what == "ARMORED_CAR" ? "STR_EVENT_ROBBERY_MISSED" : "STR_EVENT_" + what + "_MISSED");
+	}
+	replaceAll(title, "{TOWN}", town);
+	save->addLeadNews(title);
+	Log(LOG_INFO) << "[network] " << kind << " from " << key << " got away near " << town;
+}
+
+void battleResult(Game *game, int siteId, bool success, bool leaderTaken)
+{
+	SavedGame *save = game->getSavedGame();
+	auto it = save->getCobraNetSites().find(siteId);
+	if (it == save->getCobraNetSites().end()) return;
+	const auto parts = split(it->second, '|');
+	save->getCobraNetSites().erase(it);
+	if (parts.size() < 3) return;
+	const std::string kind = parts[0], key = parts[1], town = parts[2];
+	auto &net = save->getCobraNet();
+	if (kind == "dromeStrike")
+	{
+		Log(LOG_INFO) << "[will] the Drome's strike was " << (success ? "beaten off" : "not beaten off");
+		return;   // the base fight itself closes Act 1 (dromeFight); nothing to cool down or trace
+	}
+	if (kind == "mars" || kind == "money")
+	{
+		net.erase("mars:" + std::to_string(siteId));   // stopped or not, a convoy that was fought delivers nothing
+		if (success) addLead(game, key, false);
+		Log(LOG_INFO) << "[network] the M.A.R.S. convoy near " << town << (success ? " was stopped" : " was fought");
+		return;
+	}
+	if (success)
+	{
+		// stopped: the crew is lost and the site's next job waits a month; the leader taken alive gives the site away
+		net[(kind == "strike" ? "scool:" : "cool:") + key] = save->getDaysPassed() + 60;
+		addLead(game, key, leaderTaken);
+		std::string t = tr(game, leaderTaken ? "STR_EVENT_CRIME_LEADER_TALKS" : (kind == "strike" ? "STR_EVENT_CELL_STRIKE_STOPPED" : "STR_EVENT_CRIME_STOPPED"));
+		replaceAll(t, "{TOWN}", town);
+		save->addLeadNews("!" + t);
+	}
+	else
+	{
+		const auto &r = game->getMod()->getCobraNetworkRules();
+		if (kind == "strike") net["purse:" + key] += r.strikePayout;
+		addLead(game, key, false);
+	}
+	Log(LOG_INFO) << "[network] " << kind << " from " << key << (success ? " stopped" : " not stopped") << (leaderTaken ? ", leader taken" : "");
+}
+
+bool owns(const SavedGame *save, const MissionSite *site)
+{
+	if (!site || !site->getDeployment()) return false;
+	auto &m = const_cast<SavedGame*>(save)->getCobraNetSites();
+	auto it = m.find(site->getId());
+	if (it == m.end()) return false;
+	const std::string &dep = site->getDeployment()->getType();
+	// the record ends with the deployment it was made for: an unrelated site that happens to share the id is not ours
+	return it->second.size() > dep.size() && it->second.compare(it->second.size() - dep.size() - 1, std::string::npos, "|" + dep) == 0;
+}
+
+void dromeFight(Game *game, Base *home)
+{
+	SavedGame *save = game->getSavedGame();
+	auto &net = save->getCobraNet();
+	if (net.count("marsWeapon")) return;
+	if (!home && !save->getBases()->empty()) home = save->getBases()->front();
+	const RuleItem *gun = game->getMod()->getItem("STR_MARS_MARKED_WEAPON");
+	if (!home || !gun) return;
+	home->getStorageItems()->addItem(gun, 1);
+	net["marsWeapon"] = save->getDaysPassed();
+	Log(LOG_INFO) << "[network] a M.A.R.S.-marked rifle comes home from the Drome fight to " << home->getName();
+}
+
+Base *strikeDue(Game *game)
+{
+	SavedGame *save = game->getSavedGame();
+	auto &net = save->getCobraNet();
+	if (!net.count("strikeDay") || net.count("strikeFight") || save->getDaysPassed() < net["strikeDay"]) return nullptr;
+	const int idx = net["strikeBase"];
+	net.erase("strikeDay");
+	if (idx < 0 || idx >= (int)save->getBases()->size()) return nullptr;
+	Base *at = save->getBases()->at(idx);
+	if (at->getAvailableSoldiers(true, true) == 0 && at->getVehicles()->empty())
+	{
+		// nobody home to hold it: the strike goes through unopposed and pulls back to its Drome (the base stands: Act 1
+		// closes, John 13 Nov 21:08 "win or lose"); the rifle comes from what it left at the gate
+		Log(LOG_INFO) << "[will] the Drome's strike on " << at->getName() << " met nobody";
+		dromeFight(game, at);
+		return nullptr;
+	}
+	net["strikeFight"] = idx;
+	return at;
+}
+
+void strikeFought(Game *game, bool held)
+{
+	SavedGame *save = game->getSavedGame();
+	auto &net = save->getCobraNet();
+	if (!net.count("strikeFight")) return;
+	const int idx = net["strikeFight"];
+	net.erase("strikeFight");
+	Base *at = idx >= 0 && idx < (int)save->getBases()->size() ? save->getBases()->at(idx) : nullptr;
+	Log(LOG_INFO) << "[will] the Drome's strike was " << (held ? "beaten off" : "not beaten off");
+	dromeFight(game, at);
+}
+
+void siteShut(SavedGame *save, const AlienBase *base)
+{
+	if (base->getSiteType() == FRONT) save->getCobraNet()["frontShut"] = save->getMonthsPassed();
+}
+
+int findPercent(const Game *game, const AlienBase *base)
+{
+	const auto &r = game->getMod()->getCobraNetworkRules();
+	if (!r.on || base->getSiteType().empty()) return 100;
+	if (base->getSiteType() == CELL) return 0;   // cells are never spotted from the air
+	// before Cobra Commander's broadcast nobody is looking for Cobra: no site of the network turns up by chance
+	// (18 Nov: the month-end operatives roll found a front company on day 31, with the broadcast due on day 42)
+	if (base->getSiteType() != "STR_CARTEL_STASH_HOUSE" && !game->getSavedGame()->getCobraNet().count("broadcastDone")) return 0;
+	// the Drome, finished or building, is found only through the spine (Terror Drome Plans), never by chance
+	if (base->getSiteType().compare(0, 22, "STR_COBRA_TERROR_DROME") == 0) return 0;
+	return pick(r.diffFind, diffIndex(game->getSavedGame()), 50);
+}
+
+std::string fill(Game *game, const std::string &text, int siteId)
+{
+	if (text.find('{') == std::string::npos) return text;
+	std::string out = text;
+	auto it = game->getSavedGame()->getCobraNetSites().find(siteId);
+	if (it != game->getSavedGame()->getCobraNetSites().end())
+	{
+		const auto parts = split(it->second, '|');
+		if (parts.size() > 2) { replaceAll(out, "{TOWN}", parts[2]); replaceAll(out, "{BASE}", parts[2]); }
+		if (parts.size() > 3 && !parts[3].empty()) replaceAll(out, "{TARGET}", tr(game, "STR_CELL_TARGET_" + parts[3]));
+	}
+	return out;
+}
+
+} // namespace CobraNetwork
+} // namespace OpenXcom
diff --git a/src/Geoscape/CobraNetwork.h b/src/Geoscape/CobraNetwork.h
new file mode 100644
index 0000000..8725d17
--- /dev/null
+++ b/src/Geoscape/CobraNetwork.h
@@ -0,0 +1,48 @@
+#pragma once
+/*
+ * G.I. Joe 4x: the Act 1 campaign layer, pieces 1-5 (BRIEF_FOR_BUILD_Act1Layer_Part1_Answers, approved by John 17 Nov 2026).
+ *
+ * Cobra's own year: the hidden network it starts with, the crimes its front companies and cells run, the cell strikes,
+ * Cobra Commander's broadcast on its own date, and the cartel factory coming back on its date. Rules in
+ * zz_gijoe_act1_layer.rul (build/gen_act1_layer.py); state in SavedGame::getCobraNet() / getCobraNetSites().
+ */
+#include <string>
+
+namespace OpenXcom
+{
+class Game;
+class GeoscapeState;
+class MissionSite;
+class SavedGame;
+class Mod;
+class AlienBase;
+class Base;
+
+namespace CobraNetwork
+{
+	/// Plants the hidden starting network once, on the campaign's first day (needs the Pit placed).
+	void plantStart(Game *game);
+	/// The day's work: dates, crimes, cell strikes, cells growing into fronts.
+	void daily(Game *game, GeoscapeState *geo);
+	/// A crime or strike site ran out with nobody there: the getaway (pays, emboldens, leaves a trail).
+	void siteExpired(Game *game, MissionSite *site);
+	/// A crime or strike battle ended: stopped, or not.
+	void battleResult(Game *game, int siteId, bool success, bool leaderTaken);
+	/// A Cobra site was taken off the map by a raid (front companies wait a month to come back).
+	void siteShut(SavedGame *save, const AlienBase *base);
+	/// A Drome fight (the assault on it, finished or not, or its strike on a Joe base), won or lost: the first one sends a
+	/// M.A.R.S.-marked rifle home, whose research closes Act 1 (COBRA_ACT1_TIMETABLE, "The Drome strikes first").
+	void dromeFight(Game *game, Base *home);
+	/// The Drome's strike, if its day has come: the base it lands on (a base defence to fight), or null (not due, or
+	/// nobody there to hold it, which closes it at once).
+	Base *strikeDue(Game *game);
+	/// The strike's base defence ended (held or not).
+	void strikeFought(Game *game, bool held);
+	/// Whether this mission site is one of the network's (its record, and made for this deployment).
+	bool owns(const SavedGame *save, const MissionSite *site);
+	/// The share of the usual spotting chance a Cobra site gets (0 = never spotted: cells).
+	int findPercent(const Game *game, const AlienBase *base);
+	/// Replaces {TOWN} {TARGET} {HOURS} {DAYS} {REGION} {BAND} for the site the text is about (-1: none).
+	std::string fill(Game *game, const std::string &text, int siteId);
+}
+}
