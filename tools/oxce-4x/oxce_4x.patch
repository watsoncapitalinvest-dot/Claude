+void BattlescapeState::hudModeClick(Action *action)
+{
+	if (!playableUnitSelected() || _battleGame->isBusy()) return;
+	for (int hnd = 0; hnd < 2; ++hnd)
+		for (int m = 0; m < 3; ++m)
+		{
+			if (action->getSender() != _hudMode[hnd][m]) continue;
+			BattleUnit *u = _save->getSelectedUnit();
+			BattleItem *item = hnd == 0 ? u->getRightHandWeapon() : u->getLeftHandWeapon();
+			if (!item) return;
+			_battleGame->cancelCurrentAction();
+			if (hnd == 0) u->setActiveRightHand(); else u->setActiveLeftHand();
+			_battleGame->getCurrentAction()->weapon = item;
+			ActionMenuState *menu = new ActionMenuState(_battleGame->getCurrentAction(), _icons->getX(), _icons->getY() + 16);
+			menu->autoPick((BattleActionType)_hudModeType[hnd][m]);
+			popup(menu);
+			return;
+		}
 }
 
 
