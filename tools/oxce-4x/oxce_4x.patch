+namespace OpenXcom
+{
+
+class Window;
+class Text;
+class TextEdit;
+class TextButton;
+class Globe;
+
+/**
+ * Drops a mark on the globe where the player right-clicked, or clears the one
+ * already there.
+ *
+ * The player's pins and the leads intel gives him are one structure, so this
+ * writes the same GlobeMark the game writes - only with fromIntel false. What
+ * the player types goes in the label, which is the "pins with notes" half.
+ */
+class GlobeMarkState : public State
+{
+private:
+	Globe *_globe;
+	double _lon, _lat;
+	int _existing;              ///< id of a mark already under the cursor, or 0
+	Window *_window;
+	Text *_txtTitle, *_txtWhere, *_txtLabel;
+	TextEdit *_edtLabel;
+	TextButton *_btnConfirmed, *_btnLikely, *_btnRumour, *_btnArea;
+	TextButton *_btnRoute, *_btnRemove, *_btnCancel;
+	/// Writes a mark of this kind and trust, then closes.
+	void place(int kind, int trust);
+public:
+	/// Creates the state for a point on the globe.
+	GlobeMarkState(Globe *globe, double lon, double lat);
+	/// Cleans up.
+	~GlobeMarkState();
+	void btnConfirmedClick(Action *action);
+	void btnLikelyClick(Action *action);
+	void btnRumourClick(Action *action);
+	void btnAreaClick(Action *action);
+	void btnRouteClick(Action *action);
+	void btnRemoveClick(Action *action);
+	void btnCancelClick(Action *action);
+};
+
+}
