# FOUR SAMPLE FACILITIES - not loaded by the mod, not in metadata.yml.
#
# These exist so John can correct the costing model on four concrete cases rather
# than specify it in the abstract. Every number is anchored to its vanilla analogue,
# which is printed beside it; nothing here is a figure this desk made up.
#
# The premise behind the scaling: The Pit has 104 rooms where vanilla has about 20,
# so each Joe facility does LESS than its vanilla counterpart and should cost less.
# A vanilla Laboratory is the whole research wing; j_lab is one lab among several.
# The proposal is roughly half the vanilla cost for a specialist 1x1, and a quarter
# for a basic one, with capacities cut to match.
#
# spriteFacility is the FIRST frame. The engine walks +1 per square, which is why
# vanilla's 2x2 hangar carries a single index, and why build/baseview_frames.json
# stores `first` and `frames` rather than a list.
#
# mapName is vanilla's XBASE_xx as a PLACEHOLDER. It only matters for base defence
# missions, which is the other half of task 52 and not built. Left wrong on purpose
# and visibly, rather than omitted and forgotten.

facilities:

# 1. BASIC 1x1, provides personnel.   vanilla STR_LIVING_QUARTERS: 400000 / 16d / 10000 / 50
#    A bunkroom is not a barracks wing, so a quarter of the cost and a fifth of the beds.
#    This is a starting facility, hence buildCost 0 and the lift-adjacency exemption.
  - type: STR_JOE_BUNKS
    spriteShape: 1
    spriteFacility: 155
    buildCost: 100000
    buildTime: 8
    monthlyCost: 2500
    personnel: 10
    mapName: XBASE_01

# 2. SPECIALIST 1x1, provides research.   vanilla STR_LABORATORY: 750000 / 26d / 30000 / 50 labs
#    Half the cost, half the capacity: one lab among several rather than the whole wing.
  - type: STR_JOE_LAB
    spriteShape: 1
    spriteFacility: 178
    buildCost: 375000
    buildTime: 20
    monthlyCost: 15000
    laboratories: 25
    mapName: XBASE_02

# 3. 2x2, provides craft.   vanilla STR_HANGAR: 200000 / 25d / 25000 / 1 craft / 5 storage
#    Kept at vanilla, because a hangar is a hangar - it holds one aircraft either way,
#    and this is the one case where the Joe version is not a subdivision of the vanilla one.
  - type: STR_JOE_HANGAR
    spriteShape: 9
    spriteFacility: 167
    sizeX: 2
    sizeY: 2
    buildCost: 200000
    buildTime: 25
    monthlyCost: 25000
    crafts: 1
    storage: 5
    mapName: XBASE_16

# 4. 2x1, NO VANILLA ANALOGUE. Twelve rooms are 2x1 or 1x2 and vanilla's square `size:`
#    cannot express them; OXCE reads sizeX and sizeY separately (RuleBaseFacility.cpp:100).
#    Priced as 1.5x a basic 1x1 for the footprint. What it PROVIDES is the open question:
#    there is no vanilla stat for "training", so it wants either an OXCE
#    provideBaseFunc feeding a transformation, or soldier stat growth, and that is a
#    design call rather than a number.
  - type: STR_JOE_TRAINING
    spriteShape: 1
    spriteFacility: 211
    sizeX: 2
    sizeY: 1
    buildCost: 150000
    buildTime: 12
    monthlyCost: 4000
    mapName: XBASE_01
