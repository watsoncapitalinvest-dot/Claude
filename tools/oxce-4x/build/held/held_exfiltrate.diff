  */
 void Projectile::applyAccuracy(Position origin, Position *target, double accuracy, bool keepRange, bool extendLine)
 {
+	// G.I. Joe air fights: the design's own hit formula (DOGFIGHT_DESIGN_v1 section 6) decides hit or miss;
+	// a hit goes to the target's centre, a miss is thrown wide of it
+	if (_action.type != BA_HIT && _action.actor && AirFight::rule(_save->getMod(), _action.actor))
+	{
+		const Tile *tt = _save->getTile(_action.target);
+		const BattleUnit *tu = tt ? tt->getUnit() : nullptr;
+		if (tu && tu != _action.actor)
+		{
+			const int airChance = AirFight::hitChance(_save->getMod(), _action.actor, tu, _action.weapon);
+			const bool airHit = RNG::percent(airChance);
+			Log(LOG_INFO) << "[air] shot " << _action.actor->getType() << " -> " << tu->getType() << " " << airChance << "% " << (airHit ? "HIT" : "miss");
+			if (airHit)
+			{
+				// on through the target's centre, so the line meets it whatever floor it is on
+				*target = Position(origin.x + (target->x - origin.x) * 2, origin.y + (target->y - origin.y) * 2, origin.z + (target->z - origin.z) * 2);
+				return;
+			}
+			// a clean miss: push the aim point a tile and a half sideways and on past the target
+			const int dx = target->x - origin.x, dy = target->y - origin.y;
+			const double len = std::max(1.0, std::sqrt((double)dx * dx + (double)dy * dy));
+			const int side = RNG::generate(0, 1) ? 1 : -1;
+			target->x += (int)std::lround(-dy / len * 24 * side + dx / len * 16);
+			target->y += (int)std::lround(dx / len * 24 * side + dy / len * 16);
+			target->z += RNG::generate(-6, 6);
+			return;
+		}
+	}
+
 	int xdiff = origin.x - target->x;
 	int ydiff = origin.y - target->y;
 	int zdiff = origin.z - target->z;
