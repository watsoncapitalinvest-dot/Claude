+void BattlescapeGenerator::applyPitModules()
+{
+	const auto &pb = _game->getMod()->getPitBattleRules();
+	// the library map, read straight from its file (same terrain sets, same size as the canon map)
+	int lx = 0, ly = 0, lz = 0;
+	std::vector<unsigned int> lib;
+	if (!pb.library.empty() && FileMap::fileExists("MAPS/" + pb.library + ".MAP2"))
+	{
+		auto f = FileMap::getIStream("MAPS/" + pb.library + ".MAP2");
+		unsigned char h[3];
+		f->read((char*)h, 3);
+		ly = h[0]; lx = h[1]; lz = h[2];
+		unsigned char v[2];
+		while (f->read((char*)v, 2)) lib.push_back((unsigned int)v[0] | ((unsigned int)v[1] << 8));
+		if (lib.size() != (size_t)lx * ly * lz * 4) { Log(LOG_ERROR) << "[pit] library " << pb.library << " is the wrong size"; lib.clear(); }
+	}
+	typedef std::array<std::pair<int,int>, O_MAX> Parts;
+	auto fromMap = [&](int x, int y, int z) {
+		Parts parts;
+		Tile *t = _save->getTile(Position(x, y, z));
+		for (int k = 0; k < O_MAX; ++k)
+		{
+			int id = -1, set = -1;
+			if (t) t->getMapData(&id, &set, (TilePart)k);
+			parts[k] = std::make_pair(id, set);
+		}
+		return parts;
+	};
+	auto fromLib = [&](int x, int y, int z) {
+		Parts parts;
+		for (int k = 0; k < O_MAX; ++k) parts[k] = std::make_pair(-1, -1);
+		if (lib.empty() || x < 0 || y < 0 || z < 0 || x >= lx || y >= ly || z >= lz) return parts;
+		const size_t i = (((size_t)(lz - 1 - z) * ly + y) * lx + x) * 4;
+		for (int k = 0; k < O_MAX; ++k)
+		{
+			unsigned int id = lib[i + k];
+			if (!id) continue;
+			int set = 0;
+			MapData *md = _terrain->getMapData(&id, &set);
+			if (md) parts[k] = std::make_pair((int)id, set);
+		}
+		return parts;
+	};
+	// a bare slot's look is read from this map before any slot is written
+	std::map<std::string, std::vector<Parts>> dsnap;
+	for (const auto &g : pb.groups)
+		for (const auto &kv : g.from)
+			if (kv.second.compare(0, 2, "D:") == 0 && !dsnap.count(kv.second))
+				if (const Mod::PitSlot *s = pb.slot(kv.second.substr(2)))
+				{
+					auto &v = dsnap[kv.second];
+					for (int y = 0; y < s->h; ++y) for (int x = 0; x < s->w; ++x) v.push_back(fromMap(s->x + x, s->y + y, s->z));
+				}
+	for (const auto &g : pb.groups)
+	{
+		std::vector<std::string> fill;
+		for (const auto &type : g.facilities)
+			for (const auto *f : *_base->getFacilities())
+				if (f->getRules()->getType() == type && f->getBuildTime() == 0) fill.push_back(type);
+		for (size_t i = 0; i < g.slots.size(); ++i)
+		{
+			const Mod::PitSlot *s = pb.slot(g.slots[i]);
+			if (!s) continue;
+			const std::string fac = i < fill.size() ? fill[i] : std::string();
+			auto it = g.from.find(fac + "|" + s->id);
+			if (it == g.from.end()) it = g.from.find("|" + s->id);
+			if (it == g.from.end()) continue;
+			const bool library = it->second.compare(0, 2, "S:") == 0;
+			const Mod::PitSlot *src = pb.slot(it->second.substr(2));
+			if (!src || src->w != s->w || src->h != s->h) continue;
+			if (library && lib.empty()) continue;
+			const bool full = src->id == s->id;
+			size_t n = 0;
+			for (int y = 0; y < s->h; ++y)
+				for (int x = 0; x < s->w; ++x, ++n)
+				{
+					Tile *t = _save->getTile(Position(s->x + x, s->y + y, s->z));
+					if (!t) continue;
+					const Parts p = library ? fromLib(src->x + x, src->y + y, src->z) : dsnap[it->second][n];
+					for (int k = 0; k < O_MAX; ++k)
+					{
+						if (!full && (k == O_WESTWALL || k == O_NORTHWALL)) continue;
+						const auto &pr = p[k];
+						MapData *md = pr.first >= 0 && pr.second >= 0 ? _save->getMapDataSets()->at(pr.second)->getObject(pr.first) : nullptr;
+						t->setMapData(md, md ? pr.first : -1, md ? pr.second : -1, (TilePart)k);
+					}
+				}
+			Log(LOG_INFO) << "[pit] slot " << s->id << ": " << (fac.empty() ? std::string("bare") : fac) << " from " << it->second;
+		}
+	}
+}
