+#pragma once
+/*
+ * G.I. Joe: air fights on the battle engine (claude/DOGFIGHT_DESIGN_v1.md, claude/AIR_SEA_BUILD_PLAN_v1.md).
+ * Aircraft are battle units, the floors are the decks. These are the rules the battle engine asks.
+ */
+#include <string>
+#include <vector>
+#include "Position.h"
+#include "../Mod/Mod.h"
+
+namespace OpenXcom
+{
+
+class BattleUnit;
+class SavedBattleGame;
+class Game;
+class Craft;
+class Ufo;
+struct BattleAction;
+class BattleItem;
+class Tile;
+
+namespace AirFight
+{
+	/// the air rules for this unit, or nullptr if it is not an aircraft
+	const Mod::AirCraftRule *rule(const Mod *mod, const BattleUnit *unit);
+	/// is the battle an air fight (or a sea fight: the same framework)
+	bool isAirFight(const Mod *mod, const SavedBattleGame *save);
+	/// is the battle a sea fight (floors: 0 underwater, 1 surface, 2 air)
+	bool isSeaFight(const Mod *mod, const SavedBattleGame *save);
+	/// the floors this unit may use in this battle
+	void floorRange(const Mod *mod, const SavedBattleGame *save, const BattleUnit *unit, int &lo, int &hi);
+	/// a ship's system (engines / guns / steering) knocked out
+	bool systemOut(const Mod *mod, const SavedBattleGame *save, const BattleUnit *unit, const std::string &sys);
+	/// a ship with its engines out: dead in the water, can be boarded
+	bool isDisabled(const SavedBattleGame *save, const BattleUnit *unit);
+	/// a unit was hit: a ship's systems take it by where it came from (sea design section 6)
+	void onHit(SavedBattleGame *save, const BattleUnit *attacker, BattleUnit *target);
+	/// direction 0-7 from one tile to another (0 = north, clockwise)
+	int dirTo(Position from, Position to);
+	/// is the target inside the shooter's gun arc (forward / any / rear)
+	bool inArc(const BattleUnit *shooter, Position target, const std::string &arc);
+	/// the chance (5-95) that this shooter hits this target, by the design's formula (section 6)
+	int hitChance(const Mod *mod, const BattleUnit *shooter, const BattleUnit *target, const BattleItem *weapon = nullptr);
+	/// why this shot can't be fired ("" = it can): arc, deck, damage
+	std::string fireCheck(const Mod *mod, const SavedBattleGame *save, const BattleUnit *shooter, Position target, const BattleItem *weapon = nullptr);
+	/// may this unit stand on this floor
+	bool floorAllowed(const Mod *mod, const SavedBattleGame *save, const BattleUnit *unit, int z);
+	/// is this tile in the outer ring of the map (where an aircraft may disengage)
+	bool onOuterRing(const SavedBattleGame *save, const BattleUnit *unit);
+	/// has this aircraft left the fight (disengaged, escaped at its exit edge)
+	bool hasLeft(const SavedBattleGame *save, const BattleUnit *unit);
+	/// take an aircraft out of the fight (DISENGAGE, or its exit edge); it can't come back
+	void leave(SavedBattleGame *save, BattleUnit *unit);
+	/// the player's DISENGAGE (design section 2): "" if it left, else why not
+	std::string disengage(SavedBattleGame *save, BattleUnit *unit);
+	/// a craft type that is a boat (it can only take on ships)
+	bool isBoat(const Mod *mod, const std::string &craftType);
+	/// a Cobra aircraft (ufo) type that is a ship
+	bool isShipType(const Mod *mod, const std::string &ufoType);
+	/// is this weapon a torpedo (it is launched, not fired: it runs on its own; sea design section 5)
+	bool isTorpedo(const Mod *mod, const BattleItem *weapon);
+	/// launch a torpedo from this unit along its heading; "" if launched, else why not
+	std::string launchTorpedo(SavedBattleGame *save, BattleUnit *shooter, BattleItem *weapon);
