+#pragma once
+/*
+ * G.I. Joe: the named villains' Moves and traits (ROSTER's records, roster_cobra_b1/b2.yaml; BUILD 15 Nov).
+ * Stock OpenXcom's AI can't choose to use a special ability, so each villain's Move is engine code here,
+ * called from AIModule::think. The table (which villain has which Move and trait) is the ruleset's
+ * `villains:` list, written by build/gen_villains.py. A Move is used once a mission.
+ */
+#include <string>
+
+namespace OpenXcom
+{
+
+class SavedBattleGame;
+class BattleUnit;
+class BattleItem;
+struct BattleAction;
+
+namespace Villains
+{
+	/// the AI's turn: a villain may use his Move. True if it set the action.
+	bool think(SavedBattleGame *save, BattleUnit *unit, BattleAction *action);
+	/// damage percentage for a hit (traits: marked list, vehicle hunter, close quarters)
+	int damagePct(SavedBattleGame *save, const BattleUnit *attacker, const BattleUnit *victim);
+	/// accuracy added to a shot (Major Bludd's mark: every Cobra +20 against the marked Joe)
+	int accuracyBonus(SavedBattleGame *save, const BattleUnit *attacker, const BattleUnit *target);
+	/// no morale loss from wounds (Buzzer)
+	bool steady(SavedBattleGame *save, const BattleUnit *unit);
+	/// a villain never dies: a killing hit leaves him down instead (named characters never die)
+	bool neverDies(SavedBattleGame *save, const BattleUnit *unit);
+	/// this unit draws no reaction fire (only the OXCE_VILLAIN_TEST bench uses it now)
+	bool noReactions(SavedBattleGame *save, const BattleUnit *unit);
+	/// an item the Joes never see on the floor (Firefly's charge)
+	bool hiddenItem(SavedBattleGame *save, const BattleItem *item);
+	/// a Cobra man walking past a villain's charge doesn't set it off
+	bool ignoresCharge(SavedBattleGame *save, const BattleItem *item, const BattleUnit *walker);
+	/// launcher targets: Joe vehicles first (Scrap-Iron)
+	bool prefersVehicles(SavedBattleGame *save, const BattleUnit *unit);
+	/// a Joe vehicle (a player unit with no soldier behind it)
+	bool isJoeVehicle(const BattleUnit *unit);
+}
+
+}
