--- /dev/null
+++ b/src/Battlescape/Stealth.h
@@ -0,0 +1,71 @@
+#pragma once
+/*
+ * G.I. Joe: sound and stealth (claude/SOUND_STEALTH_DESIGN_v1.md, approved by John 14 Nov 23:35).
+ * Noise travels from what a unit does; Cobra units that hear it wake, look and raise the alarm.
+ * All state lives in SavedBattleGame's key/int store (getVanStop / setVanStop), so it saves with the battle.
+ *   st:on        stealth runs in this battle          st:alarm   the alarm is up
+ *   st:quiet     the battle started quiet              st:radio   the radio man's unit id
+ *   st:s:<id>    0 on post / patrol, 1 asleep, 2 wary, 3 alert          st:at:<id>  alert turns left
+ *   st:look:<id> a packed tile the unit is walking to look at          st:mk*      Joe hearing markers
+ */
+#include <string>
+#include "Position.h"
+
+namespace OpenXcom
+{
+
+class BattleUnit;
+class BattleItem;
+class SavedBattleGame;
+class Mod;
+
+namespace Stealth
+{
+	enum State { ON_POST = 0, ASLEEP = 1, WARY = 2, ALERT = 3 };
+
+	/// does stealth run in this battle (set up on the first turn)
+	bool on(const SavedBattleGame *save);
+	/// first turn: quiet or loud, who is asleep, who is the radio man
+	void begin(SavedBattleGame *save);
+	/// every turn screen: sleepers lose their turn, alerts settle, seen Joes and bodies raise the alarm
+	std::string turnStart(SavedBattleGame *save);
+
+	/// a unit's state (Cobra only; anyone else reads ALERT)
+	int state(const SavedBattleGame *save, const BattleUnit *u);
+	bool asleep(const SavedBattleGame *save, const BattleUnit *u);
+	/// asleep, on post, patrolling or wary: what a silent takedown works on
+	bool unaware(const SavedBattleGame *save, const BattleUnit *u);
+	/// reactions: 0 asleep, 0.7 on post / patrolling, 1 otherwise
+	float reactionFactor(const SavedBattleGame *save, const BattleUnit *u);
+
+	/// a noise of this radius (tiles) at this tile, made by this unit (may be null).
+	/// loud = unsilenced gunfire or an explosion (it raises the alarm if a Cobra unit hears it)
+	void noise(SavedBattleGame *save, Position at, int radius, const BattleUnit *maker, bool loud);
+	/// the noise of firing this weapon (picks the radius from the noise table)
+	void shot(SavedBattleGame *save, const BattleUnit *shooter, const BattleItem *weapon, const BattleItem *ammo);
+	/// a unit stepped onto a new tile
+	void step(SavedBattleGame *save, const BattleUnit *u);
+	/// named noises from the table (door, window, car, explosion, melee...)
+	int radius(const SavedBattleGame *save, const std::string &kind);
+
+	/// a melee or dart attack: -1 not a takedown, 0 failed (noise 8, target alert), 1 silent success
+	int takedown(SavedBattleGame *save, BattleUnit *attacker, BattleUnit *target, const BattleItem *weapon, bool dart);
+	/// is this weapon a dart gun (quiet shots, takedowns at range)
+	bool isDart(const SavedBattleGame *save, const BattleItem *weapon);
+
+	/// the alarm tries to go up (a radio man must be alive and awake to call it)
+	bool tryAlarm(SavedBattleGame *save, const char *why);
+	bool alarm(const SavedBattleGame *save);
+	/// the battle started quiet and the alarm never went up: the quiet-mission rewards apply
+	bool quietWin(const SavedBattleGame *save);
+
+	/// a Cobra unit heard something: the tile it should walk to look at, or invalid
+	Position lookTarget(const SavedBattleGame *save, const BattleUnit *u);
+	void clearLook(SavedBattleGame *save, const BattleUnit *u);
+
+	/// markers for noises the Joes heard but cannot see (this turn): count and tile
+	int markers(const SavedBattleGame *save);
+	Position marker(const SavedBattleGame *save, int i);
+}
+
+}
