+
+namespace
+{
+	SavedBattleGame *mut(const SavedBattleGame *s) { return const_cast<SavedBattleGame*>(s); }
+	std::string key(const char *k, const BattleUnit *u) { return std::string(k) + std::to_string(u->getId()); }
+	int pack(Position p) { return (p.x & 2047) | ((p.y & 2047) << 11) | ((p.z & 31) << 22); }
+	Position unpack(int v) { return Position(v & 2047, (v >> 11) & 2047, (v >> 22) & 31); }
+	bool cobra(const BattleUnit *u) { return u && u->getOriginalFaction() == FACTION_HOSTILE && u->getFaction() == FACTION_HOSTILE; }
+	int seniority(const BattleUnit *u)
+	{
+		static const char *ranks[] = { "STR_LIVE_COMMANDER", "STR_LIVE_LEADER", "STR_LIVE_ENGINEER", "STR_LIVE_MEDIC", "STR_LIVE_NAVIGATOR", "STR_LIVE_SOLDIER", "STR_LIVE_TERRORIST" };
+		for (int i = 0; i < 7; ++i) if (u->getRankString() == ranks[i]) return i;
+		return 8;
+	}
+	bool listed(const std::vector<std::string> &v, const std::string &t) { return std::find(v.begin(), v.end(), t) != v.end(); }
+	std::string typeOf(const BattleUnit *u)
+	{
+		if (u->getGeoscapeSoldier()) return u->getGeoscapeSoldier()->getRules()->getType();
+		return u->getType();
+	}
+	float hearing(const SavedBattleGame *save, const BattleUnit *u)
+	{
+		float h = 0.75f + u->getBaseStats()->reactions / 200.0f;
+		if (listed(save->getMod()->getStealthRules().keenEars, typeOf(u))) h *= 1.25f;
+		if (asleep(save, u)) h *= 0.5f;
+		return h;
+	}
+	/// the radius left after walls (halve each) and floors (quarter each) between two tiles
+	float carried(SavedBattleGame *save, Position from, Position to, float r)
+	{
+		const int dz = std::abs(from.z - to.z);
+		for (int i = 0; i < dz && r >= 1; ++i) r /= 4.0f;
+		// walk the line on the listener's level
+		int x0 = from.x, y0 = from.y;
+		const int x1 = to.x, y1 = to.y, z = to.z;
+		const int dx = std::abs(x1 - x0), sx = x0 < x1 ? 1 : -1, dy = -std::abs(y1 - y0), sy = y0 < y1 ? 1 : -1;
+		int err = dx + dy, walls = 0;
+		Tile *prev = save->getTile(Position(x0, y0, z));
+		while ((x0 != x1 || y0 != y1) && r >= 1 && walls < 6)
+		{
+			const int e2 = 2 * err;
+			if (e2 >= dy) { err += dy; x0 += sx; }
+			if (e2 <= dx) { err += dx; y0 += sy; }
+			Tile *t = save->getTile(Position(x0, y0, z));
+			if (prev && t && save->getTileEngine()->horizontalBlockage(prev, t, DT_NONE, true) > 0) { r /= 2.0f; ++walls; }
+			prev = t;
+		}
+		return r;
+	}
+	int noiseOf(const SavedBattleGame *save, const char *k, int def)
+	{
+		const auto &n = save->getMod()->getStealthRules().noise;
+		auto i = n.find(k);
+		return i == n.end() ? def : i->second;
+	}
+	void setState(SavedBattleGame *save, const BattleUnit *u, int st)
+	{
+		save->setVanStop(key("st:s:", u), st);
+		if (st == ALERT) save->setVanStop(key("st:at:", u), save->getMod()->getStealthRules().alertTurns);
+	}
+	void addMarker(SavedBattleGame *save, Position p)
+	{
+		int n = save->getVanStop("st:mkn");
+		if (n >= 12) return;
+		// within 2 tiles of the true spot
+		p.x += RNG::generate(-2, 2); p.y += RNG::generate(-2, 2);
+		p.x = std::max(0, std::min(save->getMapSizeX() - 1, (int)p.x));
+		p.y = std::max(0, std::min(save->getMapSizeY() - 1, (int)p.y));
+		save->setVanStop("st:mk" + std::to_string(n), pack(p));
+		save->setVanStop("st:mkn", n + 1);
+	}
+	void burnClues(SavedBattleGame *save)
+	{
+		const int pct = save->getMod()->getStealthRules().burnCluesPct;
+		if (pct <= 0) return;
+		std::vector<BattleItem*> clues;
+		for (auto *it : *save->getItems())
+		{
+			if (!it->getTile() || it->getOwner()) continue;
+			const std::string &t = it->getRules()->getType();
+			if (t.rfind("STR_CLUE_", 0) == 0 && t.find("DECOY") == std::string::npos) clues.push_back(it);
+		}
+		int burn = (int)clues.size() * pct / 100;
+		for (int i = 0; i < burn; ++i)
+		{
+			const int j = RNG::generate(0, (int)clues.size() - 1);
+			save->removeItem(clues[j]);
+			clues.erase(clues.begin() + j);
+		}
+		if (burn > 0) Log(LOG_INFO) << "[stealth] the alarm burned " << burn << " clue items";
+	}
+}
+
+bool on(const SavedBattleGame *save) { return save && save->getVanStop("st:on") != 0; }
+bool alarm(const SavedBattleGame *save) { return save->getVanStop("st:alarm") != 0; }
+
+int state(const SavedBattleGame *save, const BattleUnit *u)
+{
+	if (!on(save) || !cobra(u)) return ALERT;
+	if (alarm(save)) return ALERT;
+	return save->getVanStop(key("st:s:", u), ON_POST);
+}
+bool asleep(const SavedBattleGame *save, const BattleUnit *u) { return on(save) && cobra(u) && state(save, u) == ASLEEP; }
+bool unaware(const SavedBattleGame *save, const BattleUnit *u) { return on(save) && cobra(u) && state(save, u) != ALERT; }
+float reactionFactor(const SavedBattleGame *save, const BattleUnit *u)
+{
+	if (!on(save) || !cobra(u)) return 1.0f;
+	const int s = state(save, u);
+	return s == ASLEEP ? 0.0f : s == ON_POST ? 0.7f : 1.0f;
+}
+
+void begin(SavedBattleGame *save)
+{
+	if (save->getVanStop("st:init")) return;
+	save->setVanStop("st:init", 1);
+	const Mod *mod = save->getMod();
+	const auto &r = mod->getStealthRules();
+	if (!r.on || AirFight::isAirFight(mod, save)) return;
+	save->setVanStop("st:on", 1);
+	const std::string &dep = save->getMissionType();
+	bool quiet = false;
+	for (const auto &q : r.quietDeployments)
+	{
+		if (!q.empty() && q.back() == '*' ? dep.rfind(q.substr(0, q.size() - 1), 0) == 0 : dep == q) { quiet = true; break; }
+	}
+	// the bank's own rule says it is quiet until its alarm
+	const AlienDeployment *ad = mod->getDeployment(dep, false);
+	if (ad && ad->getQuietUntilAlarm()) quiet = true;
+	if (!quiet)
+	{
+		save->setVanStop("st:alarm", 1);
+		Log(LOG_INFO) << "[stealth] " << dep << " starts loud";
+		return;
+	}
+	save->setVanStop("st:quiet", 1);
+	const bool night = save->getGlobalShade() >= 9;
+	const int sleepPct = night ? r.sleepNight : r.sleepDay;
+	BattleUnit *radio = nullptr;
+	int sleepers = 0, n = 0;
+	for (auto *u : *save->getUnits())
+	{
+		if (!cobra(u) || u->isOut()) continue;
+		++n;
+		const bool zz = RNG::percent(sleepPct);
+		setState(save, u, zz ? ASLEEP : ON_POST);
+		if (zz) ++sleepers;
+		// the radio man: the senior man awake
+		if (!zz && (!radio || seniority(u) < seniority(radio))) radio = u;
+	}
+	if (radio) save->setVanStop("st:radio", radio->getId() + 1);
+	Log(LOG_INFO) << "[stealth] " << dep << " starts quiet: " << n << " Cobra, " << sleepers << " asleep (" << (night ? "night" : "day")
+		<< "), radio man " << (radio ? radio->getType() : std::string("none"));
+}
+
+bool tryAlarm(SavedBattleGame *save, const char *why)
+{
+	if (!on(save) || alarm(save)) return false;
+	const int rid = save->getVanStop("st:radio") - 1;
+	BattleUnit *radio = nullptr;
+	for (auto *u : *save->getUnits()) if (u->getId() == rid) radio = u;
+	if (!radio || radio->isOut() || asleep(save, radio) || radio->getStunlevel() >= radio->getHealth())
+	{
+		Log(LOG_INFO) << "[stealth] alarm wanted (" << why << ") but nobody can call it in";
+		return false;
+	}
+	save->setVanStop("st:alarm", 1);
+	for (auto *u : *save->getUnits()) if (cobra(u) && !u->isOut()) setState(save, u, ALERT);
+	burnClues(save);
+	save->setVanStop("st:alarmNews", 1);
+	Log(LOG_INFO) << "[stealth] ALARM (" << why << ") turn " << save->getTurn();
+	return true;
+}
+
+bool quietWin(const SavedBattleGame *save) { return on(save) && save->getVanStop("st:quiet") && !alarm(save); }
+
+void noise(SavedBattleGame *save, Position at, int rad, const BattleUnit *maker, bool loud)
+{
+	if (!on(save) || rad <= 0) return;
+	const auto &r = save->getMod()->getStealthRules();
+	const bool byCobra = maker && maker->getOriginalFaction() == FACTION_HOSTILE;
+	std::vector<BattleUnit*> goers;
+	bool joeHeard = false;
+	int nearest = 9999, heard = 0;
+	for (auto *u : *save->getUnits())
+	{
+		if (u->isOut() || u == maker || !u->getTile()) continue;
+		const bool listenerCobra = cobra(u);
+		if (byCobra == listenerCobra) continue;
+		if (!listenerCobra && u->getOriginalFaction() != FACTION_PLAYER) continue;
+		const float reach = rad * hearing(save, u);
+		const int d = Position::distance2d(at, u->getPosition());
+		if (listenerCobra) nearest = std::min(nearest, d);
+		if (d > reach) continue;
+		const float c = carried(save, at, u->getPosition(), reach);
+		if (listenerCobra && d <= 15) Log(LOG_DEBUG) << "[stealth]  " << u->getType() << " at " << u->getPosition() << " d " << d << " reach " << reach << " after walls " << c;
+		if (c < std::max(1, d)) continue;
+		if (!listenerCobra) { joeHeard = true; continue; }
+		// a Cobra unit heard it
+		++heard;
+		if (alarm(save)) continue;
+		const int was = state(save, u);
+		setState(save, u, ALERT);
+		bool holds = false;
+		for (auto *g : goers) if (Position::distance2d(g->getPosition(), u->getPosition()) <= r.pairRadius) holds = true;
+		if (!holds) { goers.push_back(u); save->setVanStop(key("st:look:", u), pack(at) + 1); }
+		// the shout: everyone near turns to face the noise
+		for (auto *v : *save->getUnits())
+		{
+			if (v == u || !cobra(v) || v->isOut() || asleep(save, v)) continue;
+			if (Position::distance2d(v->getPosition(), u->getPosition()) > r.shoutRadius) continue;
+			v->lookAt(at);
+			while (v->getStatus() == STATUS_TURNING) v->turn();
+		}
+		if (was == ASLEEP) Log(LOG_INFO) << "[stealth] " << u->getType() << " " << u->getId() << " woke";
+		if (loud) tryAlarm(save, "gunfire heard");
+	}
+	if (!byCobra && rad >= 10) Log(LOG_INFO) << "[stealth] noise " << rad << " at " << at << (loud ? " (loud)" : "") << ": nearest Cobra " << nearest << " tiles, " << heard << " heard it";
+	if (byCobra && joeHeard && !(maker && maker->getVisible()))
+	{
+		addMarker(save, at);
+	}
+}
+
+int radius(const SavedBattleGame *save, const std::string &kind)
+{
+	static const std::map<std::string, int> defs = {
+		{"pistol", 15}, {"rifle", 20}, {"heavy", 25}, {"launcher", 30}, {"explosion", 35}, {"silenced", 4}, {"silencedSniper", 6},
+		{"melee", 2}, {"dart", 2}, {"failedTakedown", 8}, {"window", 8}, {"car", 15}, {"door", 3}, {"walk", 2}, {"run", 5}, {"crouch", 1} };
+	auto d = defs.find(kind);
+	return noiseOf(save, kind.c_str(), d == defs.end() ? 0 : d->second);
+}
+
+bool isDart(const SavedBattleGame *save, const BattleItem *weapon)
+{
+	return weapon && listed(save->getMod()->getStealthRules().dartWeapons, weapon->getRules()->getType());
+}
+
+void shot(SavedBattleGame *save, const BattleUnit *shooter, const BattleItem *weapon, const BattleItem *ammo)
+{
+	if (!on(save) || !shooter || !weapon) return;
+	const RuleItem *w = weapon->getRules();
+	const RuleItem *a = ammo ? ammo->getRules() : w;
+	std::string kind;
+	if (isDart(save, weapon)) kind = "dart";
+	else
+	{
+		const auto *dt = a->getDamageType();
+		const bool blast = dt && (dt->ResistType == DT_HE || dt->ResistType == DT_IN) || w->getArcingShot() || a->getArcingShot();
+		if (blast) kind = "launcher";
+		else if (w->getConfigAuto()->shots >= 5 || w->getWeight() >= 12 || (w->getAccuracyAimed() >= 110 && w->getConfigAuto()->shots <= 1)) kind = "heavy";
+		else if (!w->isTwoHanded()) kind = "pistol";
+		else kind = "rifle";
+	}
+	noise(save, shooter->getPosition(), radius(save, kind), shooter, kind != "dart");
+}
+
+void step(SavedBattleGame *save, const BattleUnit *u)
+{
+	if (!on(save) || !u) return;
+	const std::string k = "st:steps:" + std::to_string(u->getId()) + ":" + std::to_string(save->getTurn());
+	const int n = save->getVanStop(k) + 1;
+	save->setVanStop(k, n);
+	const char *kind = u->isKneeled() ? "crouch" : n > save->getMod()->getStealthRules().runTiles ? "run" : "walk";
+	noise(save, u->getPosition(), radius(save, kind), u, false);
+}
+
+int takedown(SavedBattleGame *save, BattleUnit *attacker, BattleUnit *target, const BattleItem *weapon, bool dart)
+{
+	if (!on(save) || !attacker || !target || target->isOut()) return -1;
+	const bool targetCobra = cobra(target);
+	if (targetCobra && !unaware(save, target)) return -1;
+	if (!targetCobra && !(cobra(attacker) && !attacker->getVisible())) return -1;   // a Cobra ninja the Joes can't see
+	// from behind: outside the target's three front directions
+	const int to = save->getTileEngine()->getDirectionTo(target->getPosition(), attacker->getPosition());
+	const int diff = std::abs(((to - target->getDirection()) + 12) % 8 - 4);   // 4 = straight ahead ... 0 = straight behind
+	if (diff >= 3 && !asleep(save, target)) return -1;
+	const auto &r = save->getMod()->getStealthRules();
+	int chance;
+	if (listed(r.silentUnits, typeOf(attacker))) chance = 100;
+	else
+	{
+		chance = dart ? attacker->getBaseStats()->firing : attacker->getBaseStats()->melee;
+		chance = std::min(chance, r.takedownCap);
+	}
+	const bool ok = RNG::percent(chance);
+	Log(LOG_INFO) << "[stealth] takedown " << attacker->getType() << " on " << target->getType() << " " << chance << "% -> " << (ok ? "silent" : "FAILED");
+	if (!ok)
+	{
+		if (targetCobra) setState(save, target, ALERT);
+		noise(save, target->getPosition(), radius(save, "failedTakedown"), attacker, false);
+	}
+	return ok ? 1 : 0;
+}
+
+Position lookTarget(const SavedBattleGame *save, const BattleUnit *u)
+{
+	const int v = save->getVanStop(key("st:look:", u));
+	return v ? unpack(v - 1) : TileEngine::invalid;
+}
+void clearLook(SavedBattleGame *save, const BattleUnit *u) { save->setVanStop(key("st:look:", u), 0); }
+
+int markers(const SavedBattleGame *save) { return on(save) ? save->getVanStop("st:mkn") : 0; }
+Position marker(const SavedBattleGame *save, int i) { return unpack(save->getVanStop("st:mk" + std::to_string(i))); }
+
+std::string turnStart(SavedBattleGame *save)
+{
+	begin(save);
+	if (!on(save)) return "";
+	std::string msg;
+	if (save->getSide() == FACTION_HOSTILE)
+	{
+		save->setVanStop("st:mkn", 0);
+		for (auto *u : *save->getUnits())
+		{
+			if (!cobra(u) || u->isOut()) continue;
+			const int s = state(save, u);
+			if (s == ASLEEP) { u->setTimeUnits(0); continue; }
+			if (s == ALERT && !alarm(save))
+			{
+				int left = save->getVanStop(key("st:at:", u)) - 1;
+				save->setVanStop(key("st:at:", u), left);
+				if (left <= 0) setState(save, u, WARY);
+			}
+			// a man who sees a Joe and is still standing at his next turn
+			for (auto *v : *u->getVisibleUnits())
+			{
+				if (v->getOriginalFaction() == FACTION_PLAYER && !v->isOut())
+				{
+					setState(save, u, ALERT);
+					tryAlarm(save, "a Joe seen");
+					break;
+				}
+			}
+			// a body he can see
+			if (!alarm(save))
+			{
+				for (auto *b : *save->getUnits())
+				{
+					if (!b->isOut() || b->getOriginalFaction() != FACTION_HOSTILE || !b->getTile()) continue;
+					if (Position::distance2d(b->getPosition(), u->getPosition()) > 20) continue;
+					if (save->getTileEngine()->visible(u, b->getTile()))
+					{
+						setState(save, u, ALERT);
+						tryAlarm(save, "a body found");
+						break;
+					}
+				}
+			}
+		}
+	}
+	if (save->getVanStop("st:alarmNews"))
+	{
+		save->setVanStop("st:alarmNews", 0);
+		msg = "STR_COBRA_ALARM_UP";
+	}
+	return msg;
+}
