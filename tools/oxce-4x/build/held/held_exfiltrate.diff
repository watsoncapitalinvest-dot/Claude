+ * Year 1 Moves (John 15 Nov "1"): Major Bludd's mark, Firefly's booby trap, Storm Shadow's silent shot from hiding (John replaced his strike),
+ * Scrap-Iron's remote missile (the stock launcher AI, vehicles first), Copperhead's Water Moccasin drop, Buzzer's
+ * cut-through, Ripper's door, Torch's cut and burn. Each is used once a mission (SavedBattleGame's vanStop store:
+ * "gjv:<id>"). Zartan's disguise and Wild Weasel's strafing run are not built (the disguise fork is parked; the
+ * strafing run belongs to the air fights).
+ */
+#include "Villains.h"
+#include <algorithm>
+#include <climits>
+#include <cstdlib>
+#include "../Savegame/SavedBattleGame.h"
+#include "../Savegame/BattleUnit.h"
+#include "../Savegame/BattleItem.h"
+#include "../Savegame/Tile.h"
+#include "../Savegame/Soldier.h"
+#include "../Battlescape/TileEngine.h"
+#include "../Battlescape/Pathfinding.h"
+#include "../Battlescape/BattlescapeState.h"
+#include "../Battlescape/BattlescapeGame.h"
+#include "../Mod/Mod.h"
+#include "../Mod/RuleItem.h"
+#include "../Mod/Armor.h"
+#include "../Mod/MapData.h"
+#include "../Mod/Unit.h"
+#include "../Mod/RuleSoldier.h"
+#include "../Engine/Game.h"
+#include "../Engine/Logger.h"
+#include "../Engine/Language.h"
+
+namespace OpenXcom
+{
+namespace Villains
+{
+
+namespace
+{
+
+const Mod::VillainRule *rule(SavedBattleGame *save, const BattleUnit *u)
+{
+	if (!u || !save) return nullptr;
+	return save->getMod()->getVillainRule(u->getType());
+}
+
+std::string key(const char *what, const BattleUnit *u) { return std::string(what) + ":" + std::to_string(u->getId()); }
+bool used(SavedBattleGame *save, const BattleUnit *u) { return save->getVanStop(key("gjv", u)) > 0; }
+void markUsed(SavedBattleGame *save, const BattleUnit *u) { save->setVanStop(key("gjv", u), 1); }
+
+int encode(const Position &p) { return 1 + p.x + p.y * 1000 + p.z * 1000000; }
+Position decode(int v) { --v; return Position(v % 1000, (v / 1000) % 1000, v / 1000000); }
+
+std::string nameOf(SavedBattleGame *save, BattleUnit *u)
+{
+	BattlescapeState *st = save->getBattleState();
+	if (!st) return u->getType();
+	return u->getName(st->getGame()->getLanguage(), false);
+}
+
+void notice(SavedBattleGame *save, const std::string &k, BattleUnit *a, BattleUnit *b = nullptr)
+{
+	BattlescapeState *st = save->getBattleState();
+	if (!st) return;
+	std::string s = st->tr(k).arg(nameOf(save, a)).arg(b ? nameOf(save, b) : std::string());
+	st->warningRaw(s);
+}
+
+/// the type a record names him by: a Joe's soldier type (STR_DUKE), else the unit type
+std::string typeOf(const BattleUnit *b)
+{
+	if (b && b->getGeoscapeSoldier()) return b->getGeoscapeSoldier()->getRules()->getType();
+	return b ? b->getType() : std::string();
+}
+
+bool isJoe(const BattleUnit *b) { return b && b->getFaction() == FACTION_PLAYER && !b->isOut() && b->getTile(); }
+
+/// the nearest Joe Cobra knows about (seen this turn or lately), or any Joe if allowAny
+BattleUnit *nearestKnownJoe(SavedBattleGame *save, BattleUnit *u, bool allowAny)
+{
+	BattleUnit *best = nullptr;
+	int bd = INT_MAX;
+	for (auto *b : *save->getUnits())
+	{
+		if (!isJoe(b)) continue;
+		// OXCE_VILLAIN_TEST: the villains know where every Joe is, so each Move can be seen in a short test
+		static const bool test = getenv("OXCE_VILLAIN_TEST") != nullptr;
+		if (!allowAny && !test && b->getTurnsSinceSpottedByFaction(FACTION_HOSTILE) > 2) continue;
+		const int d = Position::distanceSq(b->getPosition(), u->getPosition());
+		if (d < bd) { bd = d; best = b; }
+	}
+	return best;
+}
+
+/// the tile part between two orthogonal neighbours a -> b (the wall you'd walk through), or false
+bool boundary(SavedBattleGame *save, const Position &a, const Position &b, Tile **tile, TilePart *part)
+{
+	if (a.z != b.z) return false;
+	const int dx = b.x - a.x, dy = b.y - a.y;
+	if (std::abs(dx) + std::abs(dy) != 1) return false;
+	if (dx == 1) { *tile = save->getTile(b); *part = O_WESTWALL; }
+	else if (dx == -1) { *tile = save->getTile(a); *part = O_WESTWALL; }
+	else if (dy == 1) { *tile = save->getTile(b); *part = O_NORTHWALL; }
+	else { *tile = save->getTile(a); *part = O_NORTHWALL; }
+	return *tile && (*tile)->getMapData(*part) && !(*tile)->getMapData(*part)->isGravLift();
+}
+
+bool isDoorPart(Tile *t, TilePart p)
+{
+	MapData *md = t ? t->getMapData(p) : nullptr;
+	return md && (md->isDoor() || md->isUFODoor());
+}
+
+/// tear out a wall or door part and let the battle see through the gap
+void breach(SavedBattleGame *save, Tile *t, TilePart p, bool fire, const Position &other)
+{
+	t->destroy(p, save->getObjectiveType());
+	if (fire)
+	{
+		t->ignite(60);
+		if (Tile *o = save->getTile(other)) o->ignite(60);
+	}
+	save->getTileEngine()->calculateLighting(LL_FIRE, t->getPosition(), 1, true);
+	save->getTileEngine()->calculateFOV(t->getPosition(), 1, true, true);
+}
+
+BattleItem *meleeWeapon(BattleUnit *u)
+{
+	for (BattleItem *w : { u->getRightHandWeapon(), u->getLeftHandWeapon() })
+		if (w && w->getRules()->getBattleType() == BT_MELEE) return w;
+	return nullptr;
+}
+
+/// a free tile with a floor (or the ground) a man can stand on
+bool standable(SavedBattleGame *save, const Position &p)
+{
+	Tile *t = save->getTile(p);
+	if (!t || t->getUnit()) return false;
+	if (t->getTUCost(O_OBJECT, MT_WALK) == Pathfinding::INVALID_MOVE_COST) return false;
+	return !t->hasNoFloor(save);
+}
+
+/// a two-step plan: walk to a tile, then act there. Returns the stored target, or invalid.
+Position plan(SavedBattleGame *save, const BattleUnit *u, const char *what)
+{
+	const int v = save->getVanStop(key(what, u));
+	return v > 0 ? decode(v) : TileEngine::invalid;
+}
+
+bool walkTo(SavedBattleGame *save, BattleUnit *u, const Position &to, BattleAction *action)
+{
+	save->getPathfinding()->calculate(u, to, BAM_NORMAL);
+	const bool can = save->getPathfinding()->getStartDirection() != -1;
+	save->getPathfinding()->abortPath();
+	if (!can) return false;
+	action->type = BA_WALK;
+	action->target = to;
+	return true;
+}
+
+std::vector<Position> reachable(SavedBattleGame *save, BattleUnit *u, const BattleActionCost &cost)
+{
+	std::vector<Position> out;
+	for (int i : save->getPathfinding()->findReachable(u, cost))
+	{
+		out.push_back(save->getTileCoords(i));
+	}
+	return out;
+}
+
+// ---- the Moves ----
+
+/// Major Bludd: marks one Joe in sight; every Cobra +20 to hit him for the rest of the mission
+bool moveMark(SavedBattleGame *save, BattleUnit *u, const Mod::VillainRule &r)
+{
+	BattleUnit *pick = nullptr;
+	int bd = INT_MAX;
+	for (auto *b : *u->getVisibleUnits())
+	{
+		if (!isJoe(b)) continue;
+		int d = Position::distanceSq(b->getPosition(), u->getPosition());
+		if (std::find(r.marked.begin(), r.marked.end(), typeOf(b)) != r.marked.end()) d -= 100000;
+		if (d < bd) { bd = d; pick = b; }
+	}
+	if (!pick) return false;
+	save->setVanStop("gjvMark", pick->getId() + 1);
+	markUsed(save, u);
+	Log(LOG_INFO) << "[villain] " << u->getType() << " marks " << typeOf(pick) << " #" << pick->getId();
+	notice(save, "STR_GJV_MARK", u, pick);
+	return false; // a free action: he goes on with his turn
+}
+
+/// Firefly: walks to a door or doorway toward the Joes and leaves a hidden charge there
+bool moveTrap(SavedBattleGame *save, BattleUnit *u, const Mod::VillainRule &r, BattleAction *action)
+{
+	const RuleItem *charge = save->getMod()->getItem(r.item, false);
+	if (!charge) return false;
+	Position goal = plan(save, u, "gjvT");
+	if (goal == TileEngine::invalid)
+	{
+		BattleUnit *joe = nearestKnownJoe(save, u, false);
+		if (!joe) return false;
+		int best = INT_MIN;
+		for (const auto &p : reachable(save, u, BattleActionCost()))
+		{
+			if (p.z != u->getPosition().z) continue;
+			const int dj = Position::distance2d(p, joe->getPosition());
+			if (dj < 3 || dj > 14) continue;
+			Tile *t = save->getTile(p);
+			if (!t || (t->getUnit() && t->getUnit() != u)) continue;
+			bool door = isDoorPart(t, O_WESTWALL) || isDoorPart(t, O_NORTHWALL)
+				|| isDoorPart(save->getTile(p + Position(1, 0, 0)), O_WESTWALL) || isDoorPart(save->getTile(p + Position(0, 1, 0)), O_NORTHWALL);
+			const int score = (door ? 20 : 0) - dj;
+			if (score > best) { best = score; goal = p; }
+		}
+		if (goal == TileEngine::invalid) goal = u->getPosition();
+		save->setVanStop(key("gjvT", u), encode(goal));
+	}
+	if (u->getPosition() != goal)
+	{
+		if (walkTo(save, u, goal, action)) return true;
+		goal = u->getPosition(); // can't get there: leave it where he stands
+	}
+	BattleItem *it = save->createItemForTile(charge, save->getTile(goal));
+	it->setFuseTimer(0);
+	save->setVanStop("gjvCharge:" + std::to_string(it->getId()), 1);
+	markUsed(save, u);
+	save->setVanStop(key("gjvT", u), 0);
+	u->spendTimeUnits(std::min(15, u->getTimeUnits()));
+	Log(LOG_INFO) << "[villain] " << u->getType() << " leaves a charge at " << goal << " (item " << it->getId() << ")";
+	return false;
+}
+
+/// Storm Shadow (John 15 Nov, replacing the Arashikage Strike): the silent assassin. From hiding - no Joe can see
+/// him - one aimed bow shot at a Joe who hasn't seen him: double damage, and it doesn't give him away.
+bool moveAssassin(SavedBattleGame *save, BattleUnit *u, BattleAction *action)
+{
+	BattleItem *bow = u->getRightHandWeapon();
+	if (!bow || bow->getRules()->getBattleType() != BT_FIREARM || !bow->haveAnyAmmo()) bow = u->getLeftHandWeapon();
+	if (!bow || bow->getRules()->getBattleType() != BT_FIREARM || !bow->haveAnyAmmo()) return false;
+	for (auto *b : *save->getUnits()) // hidden: no Joe sees him now
+		if (isJoe(b) && std::find(b->getVisibleUnits()->begin(), b->getVisibleUnits()->end(), u) != b->getVisibleUnits()->end()) return false;
+	BattleActionCost cost(BA_AIMEDSHOT, u, bow);
+	if (!cost.haveTU()) return false;
+	BattleUnit *pick = nullptr;
+	int bd = INT_MAX;
+	for (auto *b : *u->getVisibleUnits())
+	{
+		if (!isJoe(b)) continue;
+		const int d = Position::distanceSq(b->getPosition(), u->getPosition());
+		if (d < bd) { bd = d; pick = b; }
+	}
+	if (!pick) return false;
+	action->type = BA_AIMEDSHOT;
+	action->weapon = bow;
+	action->target = pick->getPosition();
+	save->setVanStop(key("gjvAss", u), pick->getId() + 1);
+	save->setVanStop(key("gjvAssT", u), save->getTurn() + 1);
+	markUsed(save, u);
+	Log(LOG_INFO) << "[villain] " << u->getType() << " shoots " << typeOf(pick) << " from hiding";
+	notice(save, "STR_GJV_ASSASSIN", u);
+	return true;
+}
+
+/// Buzzer, Ripper, Torch: through a wall or door. Buzzer goes for a Joe behind a wall and cuts him down; Ripper
+/// tears a door off on the way to the Joes; Torch cuts a wall or door on the way and sets it burning.
+bool moveBreach(SavedBattleGame *save, BattleUnit *u, const Mod::VillainRule &r, BattleAction *action)
+{
+	const bool buzzer = r.move == "CUT_THROUGH", doorsOnly = r.move == "RIP_DOOR", fire = r.move == "CUT_BURN";
+	BattleItem *melee = meleeWeapon(u);
+	Position at = plan(save, u, "gjvB"), through = plan(save, u, "gjvBT");
+	if (at == TileEngine::invalid)
+	{
+		BattleUnit *joe = nearestKnownJoe(save, u, false);
+		if (!joe) return false;
+		const BattleActionCost cost = buzzer && melee ? BattleActionCost(BA_HIT, u, melee) : BattleActionCost();
+		std::vector<Position> can = reachable(save, u, cost);
+		can.push_back(u->getPosition());
+		int best = INT_MAX;
+		static const Position dirs[4] = { Position(1, 0, 0), Position(-1, 0, 0), Position(0, 1, 0), Position(0, -1, 0) };
+		for (const auto &p : can)
+		{
+			for (const auto &d : dirs)
+			{
+				const Position n = p + d;
+				Tile *t; TilePart part;
+				if (!boundary(save, p, n, &t, &part)) continue;
+				if (doorsOnly && !isDoorPart(t, part)) continue;
+				int score;
+				Tile *nt = save->getTile(n);
+				if (buzzer && nt && isJoe(nt->getUnit()))
+				{
+					score = Position::distanceSq(p, u->getPosition()); // a Joe right behind the wall: best of all
+				}
+				else if (buzzer && Position::distanceSq(n, joe->getPosition()) > 25)
+				{
+					continue; // otherwise only a wall within 5 tiles of a Joe is worth cutting
+				}
+				else
+				{
+					const int dn = Position::distanceSq(n, joe->getPosition()), dp = Position::distanceSq(p, joe->getPosition());
+					if (dn >= dp || n.z != joe->getPosition().z) continue;
+					score = 1000 + dn * 4 + Position::distanceSq(p, u->getPosition());
+				}
+				if (score < best) { best = score; at = p; through = n; }
+			}
+		}
+		if (at == TileEngine::invalid) return false;
+		save->setVanStop(key("gjvB", u), encode(at));
+		save->setVanStop(key("gjvBT", u), encode(through));
+	}
+	if (u->getPosition() != at)
+	{
+		if (walkTo(save, u, at, action)) return true;
+		save->setVanStop(key("gjvB", u), 0);
+		save->setVanStop(key("gjvBT", u), 0);
+		return false;
+	}
+	save->setVanStop(key("gjvB", u), 0);
+	save->setVanStop(key("gjvBT", u), 0);
+	Tile *t; TilePart part;
+	if (!boundary(save, at, through, &t, &part)) return false;
+	breach(save, t, part, fire, through);
+	markUsed(save, u);
+	u->spendTimeUnits(std::min(10, u->getTimeUnits()));
+	Log(LOG_INFO) << "[villain] " << u->getType() << " breaches " << at << " -> " << through;
+	notice(save, buzzer ? "STR_GJV_BREACH" : fire ? "STR_GJV_BURN" : "STR_GJV_DOOR", u);
+	Tile *nt = save->getTile(through);
+	if (buzzer && melee && nt && isJoe(nt->getUnit()))
+	{
+		BattleActionCost c(BA_HIT, u, melee);
+		if (c.haveTU())
+		{
+			action->type = BA_HIT;
+			action->weapon = melee;
+			action->target = through;
+			return true;
+		}
+	}
+	return false;
+}
+
+/// Copperhead: his Water Moccasin crosses the map in one turn and drops Cobra troops close to the Joes, out of
+/// their sight; he comes with them, and his turn is spent
+bool moveDrop(SavedBattleGame *save, BattleUnit *u, const Mod::VillainRule &r, BattleAction *action)
+{
+	const Unit *type = save->getMod()->getUnit(r.spawn, false);
+	BattleUnit *joe = nearestKnownJoe(save, u, false);
+	if (!type || !joe) return false;
+	const Position jp = joe->getPosition();
+	auto seen = [&](const Position &p) {
+		for (auto *b : *save->getUnits())
+			if (isJoe(b) && save->getTileEngine()->visible(b, save->getTile(p))) return true;
+		return false;
+	};
+	Position drop = TileEngine::invalid;
+	for (int r2 = 6; r2 <= 12 && drop == TileEngine::invalid; ++r2)
+		for (int dx = -r2; dx <= r2 && drop == TileEngine::invalid; ++dx)
+			for (int dy = -r2; dy <= r2 && drop == TileEngine::invalid; ++dy)
+			{
+				if (std::max(std::abs(dx), std::abs(dy)) != r2) continue;
+				const Position p = jp + Position(dx, dy, 0);
+				if (!standable(save, p) || seen(p)) continue;
+				int room = 0;
+				for (int ax = -1; ax <= 1; ++ax) for (int ay = -1; ay <= 1; ++ay) if (standable(save, p + Position(ax, ay, 0))) ++room;
+				if (room >= r.count + 2) drop = p;
+			}
+	if (drop == TileEngine::invalid) return false;
+	// Copperhead himself
+	save->setUnitPosition(u, drop);
+	u->setDirection(save->getTileEngine()->getDirectionTo(drop, jp));
+	int made = 0;
+	for (int ax = -1; ax <= 1 && made < r.count; ++ax)
+		for (int ay = -1; ay <= 1 && made < r.count; ++ay)
+		{
+			const Position p = drop + Position(ax, ay, 0);
+			if (!standable(save, p)) continue;
+			BattleUnit *nu = save->createTempUnit(type, FACTION_HOSTILE);
+			nu->setTile(save->getTile(p), save);
+			nu->setPosition(p);
+			nu->setDirection(save->getTileEngine()->getDirectionTo(p, jp));
+			nu->clearTimeUnits();
+			nu->setVisible(false);
+			save->getUnits()->push_back(nu);
+			save->initUnit(nu, 0);
+			++made;
+		}
+	save->getTileEngine()->calculateFOV(drop);
+	markUsed(save, u);
+	u->clearTimeUnits();
+	Log(LOG_INFO) << "[villain] " << u->getType() << " drops " << made << " troopers at " << drop;
+	notice(save, "STR_GJV_MOCCASIN", u);
+	action->type = BA_NONE;
+	return true;
+}
+
+} // namespace
+
+bool think(SavedBattleGame *save, BattleUnit *unit, BattleAction *action)
+{
+	static const bool test = getenv("OXCE_VILLAIN_TEST") != nullptr;
+	if (test) // the test: Cobra knows where every Joe is
+		for (auto *b : *save->getUnits())
+			if (isJoe(b)) { b->setTurnsSinceSpottedByFaction(FACTION_HOSTILE, 0); b->setTurnsLeftSpottedForSnipersByFaction(FACTION_HOSTILE, 2); }
+	const Mod::VillainRule *r = rule(save, unit);
+	if (!r || r->move.empty() || r->move == "NONE" || unit->getFaction() != FACTION_HOSTILE) return false;
+	if (used(save, unit)) return false;
+	if (r->move == "MARK") return moveMark(save, unit, *r);
+	if (r->move == "SILENT_ASSASSIN") return moveAssassin(save, unit, action);
+	if (r->move == "BOOBY_TRAP") return moveTrap(save, unit, *r, action);
+	if (r->move == "CUT_THROUGH" || r->move == "RIP_DOOR" || r->move == "CUT_BURN") return moveBreach(save, unit, *r, action);
+	if (r->move == "MOCCASIN_DROP") return moveDrop(save, unit, *r, action);
+	return false; // REMOTE_MISSILE is the stock launcher AI (prefersVehicles), one bomb
+}
+
+int damagePct(SavedBattleGame *save, const BattleUnit *attacker, const BattleUnit *victim)
+{
+	const Mod::VillainRule *r = rule(save, attacker);
+	if (!r || !victim) return 100;
+	// Storm Shadow's shot from hiding: double damage, that one shot
+	if (save->getVanStop(key("gjvAss", attacker)) == victim->getId() + 1 && save->getVanStop(key("gjvAssT", attacker)) == save->getTurn() + 1)
+	{
+		save->setVanStop(key("gjvAss", attacker), 0);
+		Log(LOG_INFO) << "[villain] " << attacker->getType() << "'s shot from hiding hits " << typeOf(victim) << ": double damage";
+		return 200;
+	}
+	if (r->trait.empty()) return 100;
+	if (r->trait == "MARKED_LIST")
+	{
+		const bool marked = std::find(r->marked.begin(), r->marked.end(), typeOf(victim)) != r->marked.end();
+		return marked ? r->pct : 100;
+	}
+	if (r->trait == "VEHICLE_HUNTER") return isJoeVehicle(victim) ? r->pct : 100;
+	if (r->trait == "CLOSE_QUARTERS")
+		return Position::distance2d(attacker->getPosition(), victim->getPosition()) <= r->range ? r->pct : 100;
+	return 100;
+}
+
+int accuracyBonus(SavedBattleGame *save, const BattleUnit *attacker, const BattleUnit *target)
+{
+	if (!attacker || !target || attacker->getFaction() != FACTION_HOSTILE) return 0;
+	return save->getVanStop("gjvMark") == target->getId() + 1 ? 20 : 0;
+}
+
+bool steady(SavedBattleGame *save, const BattleUnit *unit)
+{
+	const Mod::VillainRule *r = rule(save, unit);
+	return r && r->trait == "STEADY";
+}
+
+bool neverDies(SavedBattleGame *save, const BattleUnit *unit)
+{
+	return rule(save, unit) != nullptr;
+}
+
+bool noReactions(SavedBattleGame *save, const BattleUnit *unit)
+{
+	static const bool test = getenv("OXCE_VILLAIN_TEST") != nullptr; // the test: Joes hold fire so every Move is seen
+	if (test && unit && unit->getFaction() == FACTION_HOSTILE) return true;
+	return save && unit && save->getVanStop(key("gjvNR", unit)) == save->getTurn() + 1;
+}
+
+bool hiddenItem(SavedBattleGame *save, const BattleItem *item)
+{
+	return save && item && save->getVanStop("gjvCharge:" + std::to_string(item->getId())) > 0;
+}
+
+bool ignoresCharge(SavedBattleGame *save, const BattleItem *item, const BattleUnit *walker)
+{
+	return walker && walker->getFaction() == FACTION_HOSTILE && hiddenItem(save, item);
+}
+
+bool prefersVehicles(SavedBattleGame *save, const BattleUnit *unit)
+{
+	const Mod::VillainRule *r = rule(save, unit);
+	return r && r->move == "REMOTE_MISSILE";
+}
+
+bool isJoeVehicle(const BattleUnit *unit)
+{
+	return unit && unit->getOriginalFaction() == FACTION_PLAYER && !unit->getGeoscapeSoldier();
+}
+
+}
+}
