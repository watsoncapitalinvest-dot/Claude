+	bool waterSurface(const SavedBattleGame *save, const Tile *tile);
+	/// is this unit a running torpedo
+	bool isTorpedoUnit(const SavedBattleGame *save, const BattleUnit *unit);
+	/// is this weapon a depth charge (sea design 5: the 3x3 under the boat, no aim roll)
+	bool isDepthCharge(const Mod *mod, const BattleItem *weapon);
+	/// roll a depth charge off this boat: everything under the water below it and round it takes the damage; "" if done
+	std::string dropDepthCharge(SavedBattleGame *save, BattleUnit *shooter, BattleItem *weapon);
+	/// is this weapon a mine layer
+	bool isMineLayer(const Mod *mod, const BattleItem *weapon);
+	/// lay a mine where this unit is, on its own level; "" if laid
+	std::string layMine(SavedBattleGame *save, BattleUnit *layer, BattleItem *weapon);
+	/// a unit has just moved: a mine under it goes off (true), and the layer's own mines arm once it has moved off them
+	bool mineCheck(SavedBattleGame *save, BattleUnit *unit);
+	/// the computer's pilot (design section 9); true when it has set the action
+	bool aiThink(SavedBattleGame *save, BattleUnit *unit, BattleAction *action);
+	/// end of a side's turn: its aircraft on the outer ring leave the fight
+	void endTurnStep(SavedBattleGame *save);
+	/// the odds (0-100) of a Joe win, from a fast abstract simulation of many fights (design section 8);
+	/// -1 if it can't be worked out. An estimate: the real fight is played by the battle AI and can differ.
+	int odds(const Mod *mod, const std::vector<Craft*> &crafts, const Ufo *ufo, int runs = 400);
+	/// the battle is over: craft damage, pilots, Cobra aircraft shot down or got away, back to the world map
+	void finish(Game *game);
+}
