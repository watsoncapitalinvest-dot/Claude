@@ -0,0 +1,995 @@
+/*
+ * G.I. Joe: air fights on the battle engine (claude/DOGFIGHT_DESIGN_v1.md, claude/AIR_SEA_BUILD_PLAN_v1.md).
+ */
+#include "AirFight.h"
+#include <algorithm>
+#include <cmath>
+#include "../Savegame/BattleUnit.h"
+#include "../Savegame/SavedBattleGame.h"
+#include "../Mod/Mod.h"
+#include "../Mod/RuleItem.h"
+#include "../Mod/RuleInventory.h"
+#include "../Mod/RuleCraft.h"
+#include "../Mod/RuleUfo.h"
+#include "../Mod/Armor.h"
+#include "../Mod/Unit.h"
+#include "../Savegame/BattleItem.h"
+#include "../Savegame/SavedGame.h"
+#include "../Savegame/Craft.h"
+#include "../Savegame/Ufo.h"
+#include "../Savegame/Base.h"
+#include "../Savegame/Soldier.h"
+#include "../Engine/Game.h"
+#include "../Engine/RNG.h"
+#include "../Engine/Logger.h"
+#include "../Engine/Language.h"
+#include "../Engine/Options.h"
+#include "../Engine/Screen.h"
+#include "../Interface/Cursor.h"
+#include "../Geoscape/GeoscapeState.h"
+#include "BattlescapeGame.h"
+#include "Pathfinding.h"
+#include "TileEngine.h"
+#include "../Savegame/Tile.h"
+
+namespace OpenXcom
+{
+namespace AirFight
+{
+
+const Mod::AirCraftRule *rule(const Mod *mod, const BattleUnit *unit)
+{
+	if (!mod || !unit) return nullptr;
+	return mod->getAirCraft(unit->getType());
+}
+
+bool isAirFight(const Mod *mod, const SavedBattleGame *save)
+{
+	return mod && save && mod->getAirFightRules().on
+		&& (save->getMissionType() == mod->getAirFightRules().deployment || save->getMissionType() == mod->getAirFightRules().seaDeployment);
+}
+
+bool isSeaFight(const Mod *mod, const SavedBattleGame *save)
+{
+	return mod && save && mod->getAirFightRules().on && save->getMissionType() == mod->getAirFightRules().seaDeployment;
+}
+
+void floorRange(const Mod *mod, const SavedBattleGame *save, const BattleUnit *unit, int &lo, int &hi)
+{
+	const auto *r = rule(mod, unit);
+	lo = 0; hi = 99;
+	if (!r) return;
+	if (isSeaFight(mod, save)) { lo = r->seaMinFloor; hi = r->seaMaxFloor; }
+	else { lo = r->minFloor; hi = r->maxFloor; }
+}
+
+namespace
+{
+	Position centre(const BattleUnit *u)
+	{
+		// the middle tile of a big unit (a 5x5 ship's corner is 4 tiles from its far side)
+		const int h = (u->getArmor()->getSize() - 1) / 2;
+		return u->getPosition() + Position(h, h, 0);
+	}
+	int sysCount(const SavedBattleGame *save, const BattleUnit *u, const char *sys)
+	{
+		return save->getVanStop(std::string("sys:") + std::to_string(u->getId()) + ":" + sys);
+	}
+}
+
+bool systemOut(const Mod *mod, const SavedBattleGame *save, const BattleUnit *unit, const std::string &sys)
+{
+	const auto *r = rule(mod, unit);
+	if (!r || r->systemHits <= 0) return false;
+	return sysCount(save, unit, sys.c_str()) >= r->systemHits;
+}
+
+void onHit(SavedBattleGame *save, const BattleUnit *attacker, BattleUnit *target)
+{
+	const Mod *mod = save->getMod();
+	const auto *r = rule(mod, target);
+	if (!r || r->systemHits <= 0 || !attacker || target->isOut()) return;
+	Log(LOG_INFO) << "[sea] " << target->getType() << " hit, health " << target->getHealth() << "/" << target->getBaseStats()->health;
+	// which system the hit strikes, by where it comes from (sea design section 6)
+	const int from = dirTo(centre(target), centre(attacker));
+	int gap = 2;
+	if (from >= 0) { int g = std::abs(from - target->getDirection()) % 8; gap = g > 4 ? 8 - g : g; }
+	const int roll = RNG::generate(0, 99);
+	const char *sys = nullptr;
+	if (gap >= 3) sys = roll < 60 ? "engines" : nullptr;                                       // from behind: mostly the engines
+	else if (gap <= 1) sys = roll < 40 ? "guns" : roll < 70 ? "steering" : nullptr;              // from the front: guns and steering
+	else sys = roll < 30 ? "guns" : nullptr;                                                    // from the side: the hull, some guns
+	if (!sys) return;
+	const std::string key = std::string("sys:") + std::to_string(target->getId()) + ":" + sys;
+	save->setVanStop(key, save->getVanStop(key) + 1);
+	Log(LOG_INFO) << "[sea] " << target->getType() << " hit in the " << sys << " (" << save->getVanStop(key) << "/" << r->systemHits << ")";
+	if (std::string(sys) == "engines" && save->getVanStop(key) >= r->systemHits)
+	{
+		save->setVanStop("afDisabled:" + std::to_string(target->getId()), 1);
+		target->setTimeUnits(0);
+	}
+}
+
+bool isDisabled(const SavedBattleGame *save, const BattleUnit *unit)
+{
+	return save->getVanStop("afDisabled:" + std::to_string(unit->getId())) != 0;
+}
+
+int dirTo(Position from, Position to)
+{
+	const int dx = to.x - from.x, dy = to.y - from.y;
+	if (dx == 0 && dy == 0) return -1;
+	// 0 = north (-y), clockwise in 45 degree steps
+	const double a = std::atan2((double)dx, (double)-dy); // 0 at north, positive clockwise
+	const double quarterPi = 0.78539816339744830962;
+	int d = (int)std::lround(a / quarterPi);
+	return (d % 8 + 8) % 8;
+}
+
+namespace
+{
+	/// the steps (0-4) between two directions, either way round
+	int dirGap(int a, int b)
+	{
+		int g = std::abs(a - b) % 8;
+		return g > 4 ? 8 - g : g;
+	}
+}
+
+bool inArc(const BattleUnit *shooter, Position target, const std::string &arc)
+{
+	if (arc == "any") return true;
+	const int d = dirTo(centre(shooter), target);
+	if (d < 0) return true;
+	const int gap = dirGap(d, shooter->getDirection());
+	if (arc == "rear") return gap >= 3;
+	return gap <= 1; // the 90 degree cone ahead: forward, forward-left, forward-right
+}
+
+int hitChance(const Mod *mod, const BattleUnit *shooter, const BattleUnit *target, const BattleItem *weapon)
+{
+	const auto *w = weapon ? mod->getAirWeapon(weapon->getRules()->getType()) : nullptr;
+	const auto &R = mod->getAirFightRules();
+	int c = R.baseHit;
+	c += (shooter->getBaseStats()->firing - 50) / 2;
+	// the angle: from the target's rear cone +, from its front cone -
+	const int fromTarget = dirTo(centre(target), centre(shooter));
+	if (fromTarget >= 0)
+	{
+		const int gap = dirGap(fromTarget, target->getDirection());
+		if (gap >= 3) c += R.rearBonus;
+		else if (gap <= 1) c -= R.headOnMalus;
+	}
+	const int dist = Position::distance2d(centre(shooter), centre(target));
+	c -= R.perTile * std::max(0, dist - R.freeRange);
+	if (shooter->getPosition().z != target->getPosition().z && !w) c -= R.deckMalus; // a turret is built to reach its floor
+	if (const auto *tr = rule(mod, target)) c -= tr->agility;
+	c -= target->getBaseStats()->reactions / 5;
+	return std::max(5, std::min(95, c));
+}
+
+std::string fireCheck(const Mod *mod, const SavedBattleGame *save, const BattleUnit *shooter, Position target, const BattleItem *weapon)
+{
+	const auto *r = rule(mod, shooter);
+	if (!r) return "";
+	const auto &R = mod->getAirFightRules();
+	if (!weapon) weapon = shooter->getMainHandWeapon(false);
+	const auto *w = weapon ? mod->getAirWeapon(weapon->getRules()->getType()) : nullptr;
+	if (r->systemHits <= 0 && shooter->getHealth() * 100 < shooter->getBaseStats()->health * R.noAttackBelow)
+		return "STR_AF_TOO_DAMAGED";
+	if (systemOut(mod, save, shooter, "guns"))
+		return "STR_SEA_GUNS_OUT";
+	if (std::abs(target.z - shooter->getPosition().z) > 1)
+		return "STR_AF_DECK_OUT_OF_REACH";
+	// a sea fight: the waterline - only a weapon made for it reaches underwater (a torpedo, a depth charge)
+	const int minF = w ? w->minFloor : (isSeaFight(mod, save) ? 1 : 0);
+	const int maxF = w ? w->maxFloor : 99;
+	if (target.z < minF || target.z > maxF)
+		return target.z < minF ? "STR_SEA_CANT_REACH_BELOW" : "STR_SEA_CANT_REACH_ABOVE";
+	if (!inArc(shooter, target, w && !w->arc.empty() ? w->arc : r->arc))
+		return "STR_AF_OUT_OF_ARC";
+	return "";
+}
+
+bool floorAllowed(const Mod *mod, const SavedBattleGame *save, const BattleUnit *unit, int z)
+{
+	if (!rule(mod, unit) || !isAirFight(mod, save)) return true;
+	int lo, hi;
+	floorRange(mod, save, unit, lo, hi);
+	return z >= lo && z <= hi;
+}
+
+bool onOuterRing(const SavedBattleGame *save, const BattleUnit *unit)
+{
+	const Position p = unit->getPosition();
+	const int s = unit->getArmor()->getSize();
+	return p.x <= 0 || p.y <= 0 || p.x + s >= save->getMapSizeX() || p.y + s >= save->getMapSizeY();
+}
+
+
+bool hasLeft(const SavedBattleGame *save, const BattleUnit *unit)
+{
+	return const_cast<SavedBattleGame*>(save)->getVanStop("afEsc:" + std::to_string(unit->getId())) != 0;
+}
+
+namespace
+{
+	/// turn on the spot, 2 TU per 45 degrees (design section 4); false if it can't afford it
+	bool turnTo(BattleUnit *u, int dir, const SavedBattleGame *save = nullptr)
+	{
+		if (dir < 0) return true;
+		if (save && systemOut(save->getMod(), save, u, "steering")) return false; // steering gone: straight on only
+		const int steps = dirGap(dir, u->getDirection());
+		if (steps == 0) return true;
+		if (u->getTimeUnits() < steps * 2) return false;
+		u->setTimeUnits(u->getTimeUnits() - steps * 2);
+		u->setDirection(dir);
+		u->setFaceDirection(dir);
+		return true;
+	}
+	bool walkTo(SavedBattleGame *save, BattleUnit *u, BattleAction *action, Position p, int budget = 100000, int facing = -1)
+	{
+		Tile *t = save->getTile(p);
+		if (!t || (t->getUnit() && t->getUnit() != u) || p == u->getPosition()) return false;
+		save->getPathfinding()->calculate(u, p, BAM_NORMAL);
+		const bool ok = save->getPathfinding()->getStartDirection() != -1 && save->getPathfinding()->getTotalTUCost() <= budget;
+		if (!ok && getenv("OXCE_AIRFIGHT_TRACE"))
+			Log(LOG_INFO) << "[air] no path " << u->getType() << " " << u->getPosition() << " -> " << p << " dir " << save->getPathfinding()->getStartDirection() << " cost " << save->getPathfinding()->getTotalTUCost();
+		save->getPathfinding()->abortPath();
+		if (!ok) return false;
+		action->finalFacing = facing;
+		action->type = BA_WALK;
+		action->target = p;
+		Log(LOG_INFO) << "[air] " << u->getType() << " at " << u->getPosition() << " dir " << u->getDirection() << " TU " << u->getTimeUnits() << " -> " << p;
+		return true;
+	}
+	/// the nearest point on the map edge on this deck
+	Position nearestEdge(const SavedBattleGame *save, Position at, int size = 1)
+	{
+		// a 2x2 aircraft's corner can only go as far as the map less its size
+		const int W = save->getMapSizeX() - (size - 1), H = save->getMapSizeY() - (size - 1);
+		const int dl = at.x, dr = W - 1 - at.x, dt = at.y, db = H - 1 - at.y;
+		const int m = std::min(std::min(dl, dr), std::min(dt, db));
+		if (m == dl) return Position(0, at.y, at.z);
+		if (m == dr) return Position(W - 1, at.y, at.z);
+		if (m == dt) return Position(at.x, 0, at.z);
+		return Position(at.x, H - 1, at.z);
+	}
+	bool runFor(SavedBattleGame *save, BattleUnit *u, BattleAction *action, Position e)
+	{
+		if (onOuterRing(save, u)) { action->type = BA_NONE; return true; }
+		const int s = u->getArmor()->getSize();
+		e.x = std::min((int)e.x, save->getMapSizeX() - s);
+		e.y = std::min((int)e.y, save->getMapSizeY() - s);
+		for (int k = 0; k < 6; ++k)
+		{
+			Position p = e;
+			if (p.x == 0 || p.x == save->getMapSizeX() - s) p.y += (k % 2 ? 1 : -1) * ((k + 1) / 2) * 2;
+			else p.x += (k % 2 ? 1 : -1) * ((k + 1) / 2) * 2;
+			if (walkTo(save, u, action, p)) return true;
+		}
+		action->type = BA_NONE;
+		return true;
+	}
+}
+
+bool aiThink(SavedBattleGame *save, BattleUnit *unit, BattleAction *action)
+{
+	const Mod *mod = save->getMod();
+	if (isTorpedoUnit(save, unit)) { unit->setTimeUnits(0); action->actor = unit; action->type = BA_NONE; return true; }
+	const auto *r = rule(mod, unit);
+	if (!r) return false;
+	action->actor = unit;
+	const int hpPct = unit->getHealth() * 100 / std::max(1, (int)unit->getBaseStats()->health);
+	const std::string id = std::to_string(unit->getId());
+
+	// a ship with its engines knocked out lies dead in the water
+	if (isDisabled(save, unit)) { unit->setTimeUnits(0); action->type = BA_NONE; return true; }
+	// a ship going somewhere: its turrets fire at anything they reach, once a turn, then it steams on
+	if (r->role == "ship")
+	{
+		const int turn = save->getTurn();
+		if (save->getVanStop("afFired:" + id) != turn)
+		{
+			for (BattleItem *w : { unit->getRightHandWeapon(), unit->getLeftHandWeapon() })
+			{
+				if (!w || !w->haveAnyAmmo()) continue;
+				const RuleItemUseCost cost = unit->getActionTUs(BA_SNAPSHOT, w);
+				if (unit->getTimeUnits() < cost.Time) continue;
+				BattleUnit *pick = nullptr; int pc = -1;
+				for (auto *bu : *save->getUnits())
+				{
+					if (bu->getFaction() == unit->getFaction() || bu->getFaction() == FACTION_NEUTRAL || bu->isOut() || !bu->getTile() || hasLeft(save, bu)) continue;
+					if (Position::distance2d(centre(unit), centre(bu)) > w->getRules()->getMaxRange()) continue;
+					if (!fireCheck(mod, save, unit, bu->getPosition(), w).empty()) continue;
+					const int c = hitChance(mod, unit, bu, w);
+					if (c > pc) { pc = c; pick = bu; }
+				}
+				if (pick)
+				{
+					save->setVanStop("afFired:" + id, turn);
+					action->type = BA_SNAPSHOT;
+					action->weapon = w;
+					action->target = centre(pick);
+					Log(LOG_INFO) << "[sea] " << unit->getType() << " fires " << w->getRules()->getType() << " at " << pick->getType() << " chance " << pc;
+					return true;
+				}
+			}
+		}
+	}
+	// a boat over something under the water rolls a depth charge (sea design 5), once a turn
+	if (unit->getPosition().z == 1 && isSeaFight(mod, save) && save->getVanStop("afDepth:" + id) != save->getTurn())
+	{
+		if (getenv("OXCE_AIRFIGHT_TRACE"))
+			for (BattleItem *w : *unit->getInventory())
+				Log(LOG_INFO) << "[sea] " << unit->getType() << " carries " << w->getRules()->getType() << " slot " << (w->getSlot() ? w->getSlot()->getId() : "-") << " ammo " << w->haveAnyAmmo();
+		for (BattleItem *w : *unit->getInventory())
+		{
+			if (!isDepthCharge(mod, w) || !w->haveAnyAmmo()) continue;
+			if (unit->getTimeUnits() < unit->getActionTUs(BA_SNAPSHOT, w).Time) continue;
+			const Position p = unit->getPosition();
+			const int s = unit->getArmor()->getSize();
+			bool below = false;
+			for (auto *bu : *save->getUnits())
+			{
+				if (bu->getFaction() == unit->getFaction() || bu->isOut() || !bu->getTile() || isTorpedoUnit(save, bu)) continue;
+				const Position q = bu->getPosition();
+				if (q.z == 0 && q.x >= p.x - 1 && q.x <= p.x + s && q.y >= p.y - 1 && q.y <= p.y + s) below = true;
+			}
+			if (!below) continue;
+			save->setVanStop("afDepth:" + id, save->getTurn());
+			action->type = BA_SNAPSHOT;
+			action->weapon = w;
+			// aim at the water's surface just ahead: the shot itself is never fired, the charge rolls off the stern
+			action->target = Position(std::min(save->getMapSizeX() - 1, p.x + s), p.y, 1);
+			Log(LOG_INFO) << "[sea] " << unit->getType() << " goes to roll a depth charge";
+			return true;
+		}
+	}
+	// cargo, recon, bomber, ship: run for the exit edge; a door or tail gun only answers in reaction fire
+	if (r->role == "cargo" || r->role == "recon" || r->role == "bomber" || r->role == "transport" || r->role == "ship")
+	{
+		const int exit = save->getVanStop("afExit:" + id); // 1 = east (the only crossing used so far)
+		Position at = unit->getPosition();
+		Position e = hpPct < mod->getAirFightRules().noAttackBelow || exit == 0 ? nearestEdge(save, at, unit->getArmor()->getSize()) : Position(save->getMapSizeX() - 1, at.y, at.z);
+		return runFor(save, unit, action, e);
+	}
+	// strike and fighter
+	const int breakAt = r->role == "strike" ? 40 : mod->getAirFightRules().noAttackBelow;
+	if (hpPct < breakAt)
+	{
+		return runFor(save, unit, action, nearestEdge(save, unit->getPosition(), unit->getArmor()->getSize()));
+	}
+	// the gun is the hand weapon that shoots: not the depth charges, the mines or a torpedo tube
+	BattleItem *gun = nullptr;
+	for (BattleItem *w : { unit->getRightHandWeapon(), unit->getLeftHandWeapon() })
+		if (w && !gun && !isDepthCharge(mod, w) && !isMineLayer(mod, w) && !isTorpedo(mod, w)) gun = w;
+	if (gun && !gun->haveAnyAmmo())
+	{
+		// bursts all spent: nothing left to fight with, so it heads out
+		return runFor(save, unit, action, nearestEdge(save, unit->getPosition(), unit->getArmor()->getSize()));
+	}
+	int flo, fhi;
+	floorRange(mod, save, unit, flo, fhi);
+	BattleUnit *best = nullptr;
+	int bestChance = -1;
+	for (auto *bu : *save->getUnits())
+	{
+		if (bu->getFaction() == unit->getFaction() || bu->getFaction() == FACTION_NEUTRAL || bu->isOut() || !bu->getTile() || hasLeft(save, bu)) continue;
+		const int c = hitChance(mod, unit, bu);
+		if (c > bestChance) { bestChance = c; best = bu; }
+	}
+	if (!best) { action->type = BA_NONE; return true; }
+	const Position tp = centre(best); // a big target is aimed at its middle
+	const int range = gun ? gun->getRules()->getMaxRange() : 0;
+	const bool inRange = gun && Position::distance2d(unit->getPosition(), tp) <= range && std::abs(tp.z - unit->getPosition().z) <= 1;
+	Log(LOG_INFO) << "[air] think " << unit->getType() << " at " << unit->getPosition() << " dir " << unit->getDirection() << " TU " << unit->getTimeUnits()
+		<< " target " << best->getType() << " at " << tp << " gun " << (gun ? 1 : 0) << " ammo " << (gun && gun->haveAnyAmmo() ? 1 : 0)
+		<< " inRange " << inRange << " arc " << inArc(unit, tp, r->arc) << " chance " << hitChance(mod, unit, best);
+	// a torpedo at a big hull on the water, once a turn: point the bow at it and let it run (sea design 5)
+	if (isSeaFight(mod, save) && unit->getPosition().z <= 1 && tp.z <= 1 && best->getArmor()->getSize() >= 3
+		&& save->getVanStop("afTorp:" + id) != save->getTurn())
+	{
+		for (BattleItem *w : *unit->getInventory())
+		{
+			const auto *aw = w ? mod->getAirWeapon(w->getRules()->getType()) : nullptr;
+			if (!aw || aw->torpedo <= 0 || !w->haveAnyAmmo()) continue;
+			const int reach = aw->torpedoSpeed * aw->torpedoRounds;
+			const int want = dirTo(centre(unit), tp);
+			const RuleItemUseCost cost = unit->getActionTUs(BA_SNAPSHOT, w);
+			if (Position::distance2d(centre(unit), tp) > reach) break;
+			if (unit->getTimeUnits() < cost.Time + 2 * dirGap(want, unit->getDirection())) break;
+			turnTo(unit, want, save);
+			save->setVanStop("afTorp:" + id, save->getTurn());
+			action->type = BA_SNAPSHOT;
+			action->weapon = w;
+			action->target = tp;
+			Log(LOG_INFO) << "[sea] " << unit->getType() << " lines up a torpedo on " << best->getType();
+			return true;
+		}
+	}
+	// something under the water and depth charges aboard: get over it (the charge rolls next turn, above)
+	if (isSeaFight(mod, save) && tp.z == 0 && unit->getPosition().z == 1 && unit->getTimeUnits() >= 8)
+	{
+		bool charges = false;
+		for (BattleItem *w : *unit->getInventory())
+			if (isDepthCharge(mod, w) && w->haveAnyAmmo()) charges = true;
+		if (charges)
+		{
+			const int s = unit->getArmor()->getSize();
+			for (int k = 0; k < 9; ++k)
+			{
+				Position p(tp.x - (s - 1) + (k % 3) - 1 + (s > 1 ? 1 : 0), tp.y - (s - 1) + (k / 3) - 1 + (s > 1 ? 1 : 0), 1);
+				if (k == 0) p = Position(tp.x - s / 2, tp.y - s / 2, 1);
+				p.x = std::max(0, std::min(save->getMapSizeX() - s, (int)p.x));
+				p.y = std::max(0, std::min(save->getMapSizeY() - s, (int)p.y));
+				if (walkTo(save, unit, action, p, unit->getTimeUnits() - 10)) return true;
+			}
+		}
+	}
+	if (gun && inRange && gun->haveAnyAmmo())
+	{
+		const RuleItemUseCost cost = unit->getActionTUs(BA_SNAPSHOT, gun);
+		if (!inArc(unit, tp, r->arc) && unit->getTimeUnits() >= cost.Time + 2 * dirGap(dirTo(unit->getPosition(), tp), unit->getDirection()))
+		{
+			turnTo(unit, dirTo(unit->getPosition(), tp), save);
+		}
+		if (fireCheck(mod, save, unit, tp, gun).empty() && unit->getTimeUnits() >= cost.Time && hitChance(mod, unit, best) >= 30)
+		{
+			action->type = BA_SNAPSHOT;
+			action->weapon = gun;
+			action->target = tp;
+			Log(LOG_INFO) << "[air] " << unit->getType() << " fires at " << best->getType() << " chance " << hitChance(mod, unit, best) << " TU " << unit->getTimeUnits();
+			return true;
+		}
+	}
+	// move: to where it will be - a few tiles behind the end of its next move, on its deck, facing the way
+	// it flies - keeping a burst's TU in hand for reaction fire as it goes past (design sections 6, 9)
+	if (unit->getTimeUnits() >= 8)
+	{
+		static const int vx[8] = { 0, 1, 1, 1, 0, -1, -1, -1 }, vy[8] = { -1, -1, 0, 1, 1, 1, 0, -1 };
+		const int d = best->getDirection();
+		const int speed = std::max(1, (int)best->getBaseStats()->tu / 4);
+		const int z = std::max(flo, std::min(fhi, (int)tp.z));
+		const int reserve = gun ? unit->getActionTUs(BA_SNAPSHOT, gun).Time + 4 : 0;
+		auto clampP = [&](Position p)
+		{
+			p.x = std::max(1, std::min(save->getMapSizeX() - 3, (int)p.x));
+			p.y = std::max(1, std::min(save->getMapSizeY() - 3, (int)p.y));
+			p.z = z;
+			return p;
+		};
+		for (int pass = 0; pass < 2; ++pass)
+		{
+			const int budget = pass == 0 ? unit->getTimeUnits() - reserve : 100000;
+			for (int lead : { speed, speed / 2, 0 })
+				for (int back : { 3, 5, 2, 6 })
+				{
+					Position p = clampP(Position(tp.x + vx[d] * (lead - back), tp.y + vy[d] * (lead - back), z));
+					if (walkTo(save, unit, action, p, budget, d)) return true;
+				}
+		}
+	}
+	turnTo(unit, dirTo(unit->getPosition(), tp), save);
+	action->type = BA_NONE;
+	return true;
+}
+
+void leave(SavedBattleGame *save, BattleUnit *u)
+{
+	const std::string id = std::to_string(u->getId());
+	save->setVanStop("afEsc:" + id, 1);
+	// a crossing plane that reached its own exit edge got through; anything else disengaged
+	const int exit = save->getVanStop("afExit:" + id);
+	if (exit == 1 && u->getPosition().x + u->getArmor()->getSize() >= save->getMapSizeX()) save->setVanStop("afThrough:" + id, 1);
+	u->setTile(nullptr, save);
+	u->setPosition(TileEngine::invalid);
+	u->goToTimeOut();
+	Log(LOG_INFO) << "[air] " << u->getType() << " " << u->getId() << (save->getVanStop("afThrough:" + id) ? " got through" : " left the fight");
+}
+
+std::string disengage(SavedBattleGame *save, BattleUnit *u)
+{
+	if (!u || !rule(save->getMod(), u) || !u->getTile() || hasLeft(save, u)) return "STR_AF_CANT_DISENGAGE";
+	if (isDisabled(save, u)) return "STR_SEA_GUNS_OUT";
+	if (!onOuterRing(save, u)) return "STR_AF_DISENGAGE_EDGE";
+	leave(save, u);
+	return "";
+}
+
+bool isBoat(const Mod *mod, const std::string &craftType)
+{
+	const auto &AF = mod->getAirFightRules();
+	auto it = AF.units.find(craftType);
+	if (it == AF.units.end()) return false;
+	const auto *r = mod->getAirCraft(it->second);
+	return r && r->seaOnly;
+}
+
+bool isShipType(const Mod *mod, const std::string &ufoType)
+{
+	const auto &ships = mod->getAirFightRules().ships;
+	return std::find(ships.begin(), ships.end(), ufoType) != ships.end();
+}
+
+bool isTorpedo(const Mod *mod, const BattleItem *weapon)
+{
+	if (!mod || !weapon) return false;
+	const auto *w = mod->getAirWeapon(weapon->getRules()->getType());
+	return w && w->torpedo > 0;
+}
+
+bool isTorpedoUnit(const SavedBattleGame *save, const BattleUnit *unit)
+{
+	return unit && save->getVanStop("torp:" + std::to_string(unit->getId())) > 0;
+}
+
+namespace
+{
+	const int DX[8] = { 0, 1, 1, 1, 0, -1, -1, -1 };
+	const int DY[8] = { -1, -1, 0, 1, 1, 1, 0, -1 };
+
+	void removeTorpedo(SavedBattleGame *save, BattleUnit *t)
+	{
+		save->setVanStop("torp:" + std::to_string(t->getId()), 0);
+		if (t->getTile()) t->setTile(nullptr, save);
+		t->setPosition(TileEngine::invalid);
+		t->goToTimeOut();
+	}
+
+	/// the first hull on this tile a torpedo running on floor z can strike (under the water it reaches the surface hulls too)
+	BattleUnit *hullAt(SavedBattleGame *save, Position p, const BattleUnit *torp, int firedBy)
+	{
+		for (int z = p.z; z <= std::min(p.z + 1, 1); ++z)
+		{
+			Tile *t = save->getTile(Position(p.x, p.y, z));
+			BattleUnit *u = t ? t->getUnit() : nullptr;
+			if (!u || u == torp || u->isOut() || isTorpedoUnit(save, u) || u->getId() == firedBy) continue;
+			if (z != p.z && z != 1) continue;
+			return u;
+		}
+		return nullptr;
+	}
+
+	/// one step of every running torpedo: half a round's run (sea design 5: 8 tiles a round, up to 3 rounds)
+	void stepTorpedoes(SavedBattleGame *save)
+	{
+		std::vector<BattleUnit*> torps;
+		for (auto *u : *save->getUnits()) if (isTorpedoUnit(save, u) && u->getTile()) torps.push_back(u);
+		bool anyHit = false;
+		for (auto *t : torps)
+		{
+			const std::string id = std::to_string(t->getId());
+			const int dir = save->getVanStop("torpDir:" + id), dmg = save->getVanStop("torpDmg:" + id);
+			const int firedBy = save->getVanStop("torpBy:" + id), speed = std::max(1, save->getVanStop("torpSpeed:" + id));
+			int left = save->getVanStop("torp:" + id);
+			Position p = t->getPosition();
+			bool done = false;
+			for (int k = 0; k < (speed + 1) / 2 && !done; ++k)
+			{
+				p += Position(DX[dir], DY[dir], 0);
+				if (p.x < 0 || p.y < 0 || p.x >= save->getMapSizeX() || p.y >= save->getMapSizeY()) { done = true; break; }
+				if (BattleUnit *hull = hullAt(save, p, t, firedBy))
+				{
+					// a target sees it running and steers out of its path: a big ship rarely can, a fast boat often does
+					const auto *hr = rule(save->getMod(), hull);
+					const int chance = hull->getArmor()->getSize() >= 3 ? 85 : std::max(5, 85 - 4 * (hr ? hr->agility : 0));
+					if (RNG::percent(chance))
+					{
+						// always to the hull, never to its systems: a torpedo sinks, it doesn't disable
+						const int hp = std::max(0, hull->getHealth() - dmg);
+						hull->setHealthDirect(hp);
+						Log(LOG_INFO) << "[sea] torpedo hits " << hull->getType() << " (" << chance << "%), health " << hp << "/" << hull->getBaseStats()->health;
+						anyHit = true;
+						done = true;
+						break;
+					}
+					Log(LOG_INFO) << "[sea] torpedo misses " << hull->getType() << " (" << chance << "%)";
+					continue; // it runs on past
+				}
+			}
+			if (!done)
+			{
+				// move it to where it got to, if that water is clear (else it ran under something and sank)
+				if (--left <= 0 || !save->setUnitPosition(t, p)) done = true;
+				else { t->setDirection(dir); save->setVanStop("torp:" + id, left); }
+			}
+			if (done) removeTorpedo(save, t);
+		}
+		if (anyHit && save->getBattleGame())
+			save->getBattleGame()->checkForCasualties(save->getMod()->getDamageType(DT_HE), BattleActionAttack{}, false, false);
+	}
+}
+
+std::string launchTorpedo(SavedBattleGame *save, BattleUnit *shooter, BattleItem *weapon)
+{
+	const Mod *mod = save->getMod();
+	const auto *w = mod->getAirWeapon(weapon->getRules()->getType());
+	if (!w || w->torpedo <= 0) return "STR_SEA_NOT_A_TORPEDO";
+	const int fz = shooter->getPosition().z;
+	if (isSeaFight(mod, save) && fz > 1) return "STR_SEA_TORPEDO_FROM_WATER";
+	const Unit *ur = mod->getUnit(w->torpedoUnit, false);
+	if (!ur) return "STR_SEA_NOT_A_TORPEDO";
+	const int dir = shooter->getDirection();
+	// it leaves from the bow: one tile past the firer's own footprint along its heading
+	const int half = shooter->getArmor()->getSize() / 2;
+	Position c = centre(shooter);
+	Position p = c + Position(DX[dir] * (half + 1), DY[dir] * (half + 1), 0);
+	BattleUnit *t = save->createTempUnit(ur, FACTION_NEUTRAL);
+	if (!save->getTile(p) || !save->setUnitPosition(t, p)) { delete t; return "STR_SEA_TORPEDO_BLOCKED"; }
+	t->setDirection(dir);
+	save->getUnits()->push_back(t);
+	save->initUnit(t);
+	t->setTimeUnits(0);
+	const std::string id = std::to_string(t->getId());
+	// two steps a round (after each side's turn), so a target gets its turn to steer out of the path
+	save->setVanStop("torp:" + id, std::max(1, w->torpedoRounds) * 2);
+	save->setVanStop("torpDir:" + id, dir);
+	save->setVanStop("torpDmg:" + id, w->torpedo);
+	save->setVanStop("torpSpeed:" + id, w->torpedoSpeed);
+	save->setVanStop("torpBy:" + id, shooter->getId());
+	Log(LOG_INFO) << "[sea] " << shooter->getType() << " launches a torpedo from " << p << " heading " << dir;
+	return "";
+}
+
+bool waterSurface(const SavedBattleGame *save, const Tile *tile)
+{
+	return tile && tile->getPosition().z == 1 && isSeaFight(save->getMod(), save);
+}
+
+bool isDepthCharge(const Mod *mod, const BattleItem *weapon)
+{
+	if (!mod || !weapon) return false;
+	const auto *w = mod->getAirWeapon(weapon->getRules()->getType());
+	return w && w->depthCharge > 0;
+}
+
+std::string dropDepthCharge(SavedBattleGame *save, BattleUnit *shooter, BattleItem *weapon)
+{
+	const Mod *mod = save->getMod();
+	const auto *w = mod->getAirWeapon(weapon->getRules()->getType());
+	if (!w || w->depthCharge <= 0) return "STR_SEA_NOT_A_DEPTH_CHARGE";
+	if (!isSeaFight(mod, save) || shooter->getPosition().z != 1) return "STR_SEA_DEPTH_CHARGE_SURFACE";
+	// the water under the boat's own footprint and one tile round it (a 1x1 boat: the 3x3 below)
+	const Position p = shooter->getPosition();
+	const int s = shooter->getArmor()->getSize();
+	std::vector<BattleUnit*> hit;
+	for (int x = p.x - 1; x <= p.x + s; ++x)
+		for (int y = p.y - 1; y <= p.y + s; ++y)
+		{
+			Tile *t = save->getTile(Position(x, y, 0));
+			BattleUnit *u = t ? t->getUnit() : nullptr;
+			if (!u || u->isOut() || isTorpedoUnit(save, u) || std::find(hit.begin(), hit.end(), u) != hit.end()) continue;
+			hit.push_back(u);
+		}
+	for (auto *u : hit)
+	{
+		const int hp = std::max(0, u->getHealth() - w->depthCharge);
+		u->setHealthDirect(hp);
+		Log(LOG_INFO) << "[sea] depth charge hits " << u->getType() << ", health " << hp << "/" << u->getBaseStats()->health;
+	}
+	Log(LOG_INFO) << "[sea] " << shooter->getType() << " drops a depth charge at " << p << ": " << hit.size() << " under the water hit";
+	if (!hit.empty() && save->getBattleGame())
+		save->getBattleGame()->checkForCasualties(mod->getDamageType(DT_HE), BattleActionAttack{}, false, false);
+	return "";
+}
+
+bool isMineLayer(const Mod *mod, const BattleItem *weapon)
+{
+	if (!mod || !weapon) return false;
+	const auto *w = mod->getAirWeapon(weapon->getRules()->getType());
+	return w && w->mine > 0;
+}
+
+std::string layMine(SavedBattleGame *save, BattleUnit *layer, BattleItem *weapon)
+{
+	const Mod *mod = save->getMod();
+	const auto *w = mod->getAirWeapon(weapon->getRules()->getType());
+	if (!w || w->mine <= 0) return "STR_SEA_NOT_A_MINE";
+	if (isSeaFight(mod, save) && layer->getPosition().z > 1) return "STR_SEA_MINE_FROM_WATER";
+	const RuleItem *mr = mod->getItem("STR_SEA_MINE", false);
+	// it goes in the water at the stern: the layer's own corner tile, on its level
+	Tile *t = save->getTile(centre(layer));
+	if (!mr || !t) return "STR_SEA_NOT_A_MINE";
+	BattleItem *m = save->createItemForTile(mr, t);
+	const std::string id = std::to_string(m->getId());
+	save->setVanStop("mine:" + id, w->mine);
+	save->setVanStop("mineBy:" + id, layer->getId() + 1);
+	save->setVanStop("mineArm:" + id, 0);
+	Log(LOG_INFO) << "[sea] " << layer->getType() << " lays a mine at " << t->getPosition();
+	return "";
+}
+
+bool mineCheck(SavedBattleGame *save, BattleUnit *unit)
+{
+	if (!isAirFight(save->getMod(), save) || !unit->getTile()) return false;
+	const Position p = unit->getPosition();
+	const int s = unit->getArmor()->getSize();
+	auto under = [&](const Position &q) { return q.z == p.z && q.x >= p.x && q.x < p.x + s && q.y >= p.y && q.y < p.y + s; };
+	BattleItem *boom = nullptr;
+	for (BattleItem *it : *save->getItems())
+	{
+		if (!it->getTile()) continue;
+		const std::string id = std::to_string(it->getId());
+		if (save->getVanStop("mine:" + id) <= 0) continue;
+		const Position q = it->getTile()->getPosition();
+		const bool mine = save->getVanStop("mineBy:" + id) == unit->getId() + 1;
+		if (!save->getVanStop("mineArm:" + id))
+		{
+			// it arms once the boat that laid it has moved off it
+			if (mine && !under(q)) save->setVanStop("mineArm:" + id, 1);
+			continue;
+		}
+		if (!boom && under(q)) boom = it;
+	}
+	if (!boom) return false;
+	const std::string id = std::to_string(boom->getId());
+	const int dmg = save->getVanStop("mine:" + id);
+	const int hp = std::max(0, unit->getHealth() - dmg);
+	unit->setHealthDirect(hp);
+	Log(LOG_INFO) << "[sea] " << unit->getType() << " runs onto a mine at " << boom->getTile()->getPosition() << ", health " << hp << "/" << unit->getBaseStats()->health;
+	save->setVanStop("mine:" + id, 0);
+	save->removeItem(boom);
+	if (save->getBattleGame())
+		save->getBattleGame()->checkForCasualties(save->getMod()->getDamageType(DT_HE), BattleActionAttack{}, false, false);
+	return true;
+}
+
+void endTurnStep(SavedBattleGame *save)
+{
+	if (!isAirFight(save->getMod(), save)) return;
+	const UnitFaction side = save->getSide();
+	if (side != FACTION_NEUTRAL) stepTorpedoes(save);
+	for (auto *u : *save->getUnits())
+	{
+		if (u->getOriginalFaction() != side || u->isOut() || !u->getTile() || hasLeft(save, u)) continue;
+		if (!rule(save->getMod(), u) || !onOuterRing(save, u) || isDisabled(save, u)) continue;
+		// the player's own aircraft leave only by DISENGAGE; the computer's (and auto-resolve's) leave here
+		if (u->getOriginalFaction() == FACTION_PLAYER && !save->getVanStop("afAuto")) continue;
+		leave(save, u);
+	}
+	// a sea fight is over once every Cobra vessel is sunk, gone or dead in the water (boarding is next)
+	if (isSeaFight(save->getMod(), save))
+	{
+		bool anyFree = false, anyDisabled = false;
+		for (auto *u : *save->getUnits())
+		{
+			if (u->getOriginalFaction() != FACTION_HOSTILE || u->isOut() || !u->getTile() || hasLeft(save, u)) continue;
+			if (!save->getVanStop("afUfo:" + std::to_string(u->getId()))) continue; // an escort doesn't hold the fight open
+			if (isDisabled(save, u)) anyDisabled = true; else anyFree = true;
+		}
+		if (!anyFree && anyDisabled)
+		{
+			Log(LOG_INFO) << "[sea] every Cobra vessel is stopped: the fight ends";
+			save->setTurnLimit(save->getTurn());
+		}
+	}
+}
+
+namespace
+{
+	/// one aircraft in the odds simulation
+	struct SimCraft
+	{
+		bool joe = false;
+		std::string role;
+		int hp = 1, hpMax = 1, armor = 0, agility = 0, tu = 40, firing = 50, reactions = 40;
+		int power = 0, range = 0, bursts = 0, tuSnap = 12, systemHits = 0;
+		bool down = false, gone = false, disabled = false;
+		int engines = 0, leaveAt = 0;
+		bool going() const { return role == "cargo" || role == "recon" || role == "bomber" || role == "ship" || role == "transport"; }
+	};
+
+	bool simFrom(const Mod *mod, const std::string &type, bool joe, int damagePct, SimCraft &out, int targetFloor = -1)
+	{
+		const auto &AF = mod->getAirFightRules();
+		auto it = AF.units.find(type);
+		if (it == AF.units.end()) return false;
+		const Unit *u = mod->getUnit(it->second, false);
+		if (!u || !u->getArmor()) return false;
+		const auto *r = mod->getAirCraft(it->second);
+		out.joe = joe;
+		out.role = r ? r->role : "fighter";
+		out.agility = r ? r->agility : 0;
+		out.systemHits = r ? r->systemHits : 0;
+		out.hpMax = std::max(1, (int)u->getStats()->health);
+		out.hp = std::max(1, out.hpMax - out.hpMax * damagePct / 100);
+		out.armor = u->getArmor()->getFrontArmor();
+		out.tu = u->getStats()->tu;
+		out.firing = u->getStats()->firing;
+		out.reactions = u->getStats()->reactions;
+		// the gun: the hardest-hitting built-in that reaches the enemy's floor (a ship's anti-aircraft gun against
+		// jets, its deck gun against boats; a boat's deck gun against a ship). Torpedoes are left out.
+		for (const RuleItem *w : u->getArmor()->getBuiltInWeapons())
+		{
+			if (!w || w->getPower() <= 0) continue;
+			const auto *aw = mod->getAirWeapon(w->getType());
+			if (aw && aw->torpedo > 0) continue;
+			if (aw && targetFloor >= 0 && (targetFloor < aw->minFloor || targetFloor > aw->maxFloor)) continue;
+			if (w->getPower() > out.power)
+			{
+				out.power = w->getPower();
+				out.range = w->getMaxRange();
+				out.bursts = std::max(1, w->getClipSize());
+				out.tuSnap = std::max(1, (int)w->getCostSnap().Time);
+			}
+		}
+		return true;
+	}
+
+	/// a typical shot (about 5 tiles): a plane running away is shot from behind, mostly on its own deck;
+	/// a dogfight is a little better than side-on, half the time across a deck. Tuned against STORY's
+	/// dogfight_sim numbers (DOGFIGHT_DESIGN_v1 3c) and the engine's own AI fights, 14 Nov.
+	int simChance(const Mod *mod, const SimCraft &a, const SimCraft &t)
+	{
+		const auto &R = mod->getAirFightRules();
+		int c = R.baseHit + (a.firing - 50) / 2;
+		if (t.going() || t.leaveAt) c += R.rearBonus - R.deckMalus / 4;
+		else c += 5 - R.deckMalus / 4;
+		c -= R.perTile * std::max(0, 5 - R.freeRange);
+		c -= t.agility + t.reactions / 5;
+		return std::max(5, std::min(95, c));
+	}
+}
+
+int odds(const Mod *mod, const std::vector<Craft*> &crafts, const Ufo *ufo, int runs)
+{
+	if (!mod || !ufo || crafts.empty()) return -1;
+	const auto &R = mod->getAirFightRules();
+	std::vector<SimCraft> start;
+	const bool sea = std::find(R.ships.begin(), R.ships.end(), ufo->getRules()->getType()) != R.ships.end();
+	int joeFloor = -1;
+	for (auto *c : crafts)
+	{
+		SimCraft s;
+		const int dmg = c->getDamageMax() > 0 ? c->getDamage() * 100 / c->getDamageMax() : 0;
+		if (!simFrom(mod, c->getRules()->getType(), true, dmg, s, sea ? 1 : -1)) continue;
+		if (sea && joeFloor < 0)
+		{
+			const auto *ar = mod->getAirCraft(R.units.at(c->getRules()->getType()));
+			joeFloor = ar ? std::max(ar->seaMinFloor, std::min(ar->seaMaxFloor, 1)) : 2;
+		}
+		auto pilots = c->getPilotList(false, mod);
+		if (!pilots.empty())
+		{
+			s.firing = pilots.front()->getCurrentStats()->firing;
+			s.reactions = pilots.front()->getCurrentStats()->reactions;
+			s.tu += std::min(std::max(0, (pilots.front()->getCurrentStats()->bravery - 50) / 10), s.tu / 10);
+		}
+		start.push_back(s);
+	}
+	if (start.empty()) return -1;
+	{
+		SimCraft s;
+		const int dmax = ufo->getRules()->getStats().damageMax;
+		if (!simFrom(mod, ufo->getRules()->getType(), false, dmax > 0 ? ufo->getDamage() * 100 / dmax : 0, s, sea ? joeFloor : -1)) return -1;
+		start.push_back(s);
+	}
+	const int crossTiles = 36, breakRounds = 3, maxShots = 4, dogfightMoveTU = 24;
+	int wins = 0;
+	for (int run = 0; run < runs; ++run)
+	{
+		std::vector<SimCraft> f = start;
+		auto alive = [&](const SimCraft &x) { return !x.down && !x.gone; };
+		auto canShoot = [&](const SimCraft &x) { return alive(x) && !x.leaveAt && x.power > 0 && x.bursts > 0 && !x.disabled && x.hp * 100 >= x.hpMax * R.noAttackBelow; };
+		for (int round = 1; round <= R.rounds; ++round)
+		{
+			for (int side = 0; side < 2; ++side)
+			{
+				for (auto &a : f)
+				{
+					if (a.joe != (side == 0) || !canShoot(a) || round < 2) continue; // round 1: closing in
+					std::vector<SimCraft*> all, going;
+					for (auto &t : f)
+						if (t.joe != a.joe && alive(t) && !t.disabled) { all.push_back(&t); if (t.going()) going.push_back(&t); }
+					if (all.empty()) continue;
+					// the Joes go for Cobra's cargo plane first, then the weakest; Cobra shoots whoever is near
+					SimCraft *t = all[RNG::generate(0, (int)all.size() - 1)];
+					if (a.joe)
+					{
+						const auto &pool = going.empty() ? all : going;
+						t = pool.front();
+						for (auto *x : pool) if (x->hp < t->hp) t = x;
+					}
+					// keeping up with a plane that is running costs the TU to follow it
+					const int keep = (t->going() || t->leaveAt) ? t->tu * 4 / 5 : dogfightMoveTU;
+					const int shots = std::max(1, std::min(maxShots, (a.tu - keep) / a.tuSnap));
+					for (int k = 0; k < shots && a.bursts > 0 && alive(*t) && !t->disabled; ++k)
+					{
+						--a.bursts;
+						if (!RNG::percent(simChance(mod, a, *t))) continue;
+						t->hp -= std::max(1, RNG::generate(a.power * 75 / 100, a.power * 125 / 100) - t->armor);
+						if (t->systemHits > 0 && RNG::percent(30) && ++t->engines >= t->systemHits) t->disabled = true;
+						if (t->hp <= 0) t->down = true;
+					}
+				}
+			}
+			// the end of the round: who gets through, who breaks for the edge (and takes a few rounds to reach it)
+			for (auto &a : f)
+			{
+				if (!alive(a) || a.disabled || a.joe) continue;
+				const int pct = a.hp * 100 / a.hpMax;
+				if (a.going() && round * std::max(1, a.tu / 4) >= crossTiles) a.gone = true;
+				else if (!a.going() && (pct < (a.role == "strike" ? 40 : R.noAttackBelow) || a.bursts <= 0))
+				{
+					if (!a.leaveAt) a.leaveAt = round + breakRounds;
+					if (round >= a.leaveAt) a.gone = true;
+				}
+			}
+			bool cobraLeft = false, joeLeft = false;
+			for (auto &a : f)
+			{
+				if (!alive(a)) continue;
+				if (a.joe && canShoot(a)) joeLeft = true;
+				if (!a.joe && !a.disabled) cobraLeft = true;
+			}
+			if (!cobraLeft || !joeLeft) break;
+		}
+		bool win = true;
+		for (auto &a : f) if (!a.joe && !a.down && !a.disabled) win = false;
+		if (win) ++wins;
+	}
+	return wins * 100 / std::max(1, runs);
+}
+
+void finish(Game *game)
+{
+	SavedBattleGame *save = game->getSavedGame()->getSavedBattle();
+	const Mod *mod = game->getMod();
+	const auto &AF = mod->getAirFightRules();
+	GeoscapeState::AirFightResult res;
+	for (auto *u : *save->getUnits())
+	{
+		const std::string id = std::to_string(u->getId());
+		const bool down = u->getStatus() == STATUS_DEAD || u->getHealth() <= 0;
+		const int hpPct = std::max(0, u->getHealth()) * 100 / std::max(1, (int)u->getBaseStats()->health);
+		// a Joe craft
+		for (auto *b : *game->getSavedGame()->getBases())
+			for (auto *c : *b->getCrafts())
+			{
+				if (save->getVanStop("afCraft:" + id + ":" + c->getRules()->getType()) != c->getId() || c->getId() == 0) continue;
+				GeoscapeState::AirFightResult::One one;
+				one.craft = c;
+				one.healthPct = down ? 0 : hpPct;
+				one.lost = down;
+				one.pilotId = save->getVanStop("afPilot:" + id);
+				res.crafts.push_back(one);
+			}
+		// the Cobra aircraft
+		const int ufoId = save->getVanStop("afUfo:" + id);
+		if (ufoId)
+		{
+			for (auto *ufo : *game->getSavedGame()->getUfos())
+			{
+				if (ufo->getId() + 1 != ufoId) continue;
+				res.ufo = ufo;
+				res.ufoDown = down;
+				res.ufoHealthPct = down ? 0 : hpPct;
+				res.ufoDisabled = !down && isDisabled(save, u);
+				res.ufoThrough = !res.ufoDisabled && (save->getVanStop("afThrough:" + id) != 0 || (!down && !hasLeft(save, u)));
+			}
+		}
+	}
+	(void)AF;
+	if (save->getVanStop("afAuto"))
+	{
+		if (Options::battleXcomSpeedOrig >= 1) { Options::battleXcomSpeed = Options::battleXcomSpeedOrig; Options::battleXcomSpeedOrig = -1; }
+		if (Options::battleAlienSpeedOrig >= 1) { Options::battleAlienSpeed = Options::battleAlienSpeedOrig; Options::battleAlienSpeedOrig = -1; }
+	}
+	// close the battle the way a preview closes (no debriefing: nothing on the ground to recover)
+	Options::baseXResolution = Options::baseXGeoscape;
+	Options::baseYResolution = Options::baseYGeoscape;
+	game->getScreen()->resetDisplay(false);
+	game->getCursor()->setVisible(true);
+	game->getSavedGame()->setBattleGame(0);
+	for (auto *xbase : *game->getSavedGame()->getBases())
+	{
+		xbase->setInBattlescape(false);
+		for (auto *craft : *xbase->getCrafts()) craft->setInBattlescape(false);
+	}
+	game->getMod()->playMusic("GMGEO");
+	if (game->getGeoscapeState()) game->getGeoscapeState()->finishAirFight(res);
+}
+
+}
+}
