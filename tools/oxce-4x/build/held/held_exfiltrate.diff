+/**
+ * G.I. Joe: a base defence in a Pit (not an outpost) is fought on MAPS' canon Pit (BRIEF_FOR_BUILD_PitBase), when
+ * the map is installed. Without MAPS/<map>.MAP2 (the map is private, zip only) the old room-by-room map stays.
+ */
+bool BattlescapeGenerator::isPitBattle() const
+{
+	if (!_base || _save->getMissionType() != "STR_BASE_DEFENSE") return false;
+	const auto &pb = _game->getMod()->getPitBattleRules();
+	if (!_game->getMod()->getPitFloorRules().on || pb.deployment.empty() || pb.map.empty()) return false;
+	const auto *k = Outposts::kindOf(_game->getMod(), _base);
+	if (k && !k->pit) return false;
+	return FileMap::fileExists("MAPS/" + pb.map + ".MAP2") && _game->getMod()->getDeployment(pb.deployment, false);
