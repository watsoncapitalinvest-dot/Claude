+/**
+ * G.I. Joe: an air fight (DOGFIGHT_DESIGN_v1 section 2, AIR_SEA_BUILD_PLAN_v1). The map is the deployment's
+ * sky - the ground picture on floor 0, the decks on floors 1-4 - over the terrain picked for the spot.
+ * Every Joe craft in the fight and the Cobra aircraft become units; nobody walks.
+ * A Cobra plane that is going somewhere crosses the map from a side edge; the Joes cut in from the south.
+ * A Cobra plane that came to fight starts about 25 tiles off, facing them.
+ */
+void BattlescapeGenerator::runAirFight(const std::vector<Craft*> &crafts, Ufo *ufo, const std::string &terrain, bool joeTransportHunted, bool autoPlay)
+{
+	Tile::destroyedLog.clear();
+	const Mod *mod = _game->getMod();
+	const auto &AF = mod->getAirFightRules();
+	// a Cobra ship makes it a sea fight: underwater, surface and air on floors 0-2 (SEA_BATTLES_DESIGN_v1)
+	const bool sea = ufo && std::find(AF.ships.begin(), AF.ships.end(), ufo->getRules()->getType()) != AF.ships.end();
+	const std::string &depName = sea ? AF.seaDeployment : AF.deployment;
+	const AlienDeployment *ruleDeploy = mod->getDeployment(depName, true);
+	_save->setMissionType(depName);
+	_save->setTurnLimit(AF.rounds);
+	_save->setChronoTrigger(FORCE_ABORT);
+	_save->setCheatTurn(ruleDeploy->getCheatTurn());
+	ruleDeploy->getDimensions(&_mapsize_x, &_mapsize_y, &_mapsize_z);
+	_unitSequence = BattleUnit::MAX_SOLDIER_ID;
+	_terrain = mod->getTerrain(terrain, false);
+	if (!_terrain && !ruleDeploy->getTerrains().empty()) _terrain = mod->getTerrain(ruleDeploy->getTerrains().front(), true);
+	if (!_terrain) throw Exception("Air fight: no sky terrain " + terrain);
+	setDepth(ruleDeploy, false);
+	if (ruleDeploy->getShade() != -1) _worldShade = ruleDeploy->getShade();
+	_save->setAlienItemLevel(0);
+	const std::vector<MapScript*> *script = mod->getMapScript(ruleDeploy->getRandomMapScript());
+	if (!script) throw Exception("Air fight: map script " + ruleDeploy->getRandomMapScript() + " not found");
+	_save->setLastUsedMapScript(ruleDeploy->getRandomMapScript());
+	_save->setStartingCondition(nullptr);
+	generateMap(script, "", nullptr);
+	setupObjectives(ruleDeploy);
+	_save->applyEnviroEffects(nullptr);
+
+	const int W = _mapsize_x, H = _mapsize_y;
+	auto unitFor = [&](const std::string &type) -> Unit*
+	{
+		auto it = AF.units.find(type);
+		return it == AF.units.end() ? nullptr : mod->getUnit(it->second, false);
+	};
+	auto place = [&](BattleUnit *u, Position p, int dir) -> bool
+	{
+		// nearest free spot on that deck, spiralling out
+		for (int r = 0; r < 8; ++r)
+			for (int dx = -r; dx <= r; ++dx)
+				for (int dy = -r; dy <= r; ++dy)
+				{
+					if (std::max(std::abs(dx), std::abs(dy)) != r) continue;
+					Position q(p.x + dx, p.y + dy, p.z);
+					const int s = u->getArmor()->getSize();
+					if (q.x < 1 || q.y < 1 || q.x + s >= W || q.y + s >= H) continue;
+					if (_save->setUnitPosition(u, q))
+					{
+						u->setDirection(dir);
+						u->setFaceDirection(dir);
+						_save->getUnits()->push_back(u);
+						_save->initUnit(u);
+						return true;
+					}
+				}
+		return false;
+	};
+	const auto *cobraRule = ufo ? mod->getAirCraft(AF.units.count(ufo->getRules()->getType()) ? AF.units.at(ufo->getRules()->getType()) : "") : nullptr;
+	const bool cobraGoing = cobraRule && (cobraRule->role == "cargo" || cobraRule->role == "recon" || cobraRule->role == "bomber");
+	const int midY = H / 2 + RNG::generate(-6, 6);
+
+	// the Joes
+	int n = 0;
+	for (auto *craft : crafts)
+	{
+		Unit *rule = unitFor(craft->getRules()->getType());
+		if (!rule) continue;
+		BattleUnit *u = _save->createTempUnit(rule, FACTION_PLAYER, _unitSequence++);
+		// the pilot flies it: his Firing, Reactions and Bravery; +1 TU per 10 Bravery over 50, at most +10%
+		auto pilots = craft->getPilotList(false, mod);
+		if (!pilots.empty())
+		{
+			const UnitStats *ps = pilots.front()->getCurrentStats();
+			UnitStats *us = u->getBaseStats();
+			us->firing = ps->firing;
+			us->reactions = ps->reactions;
+			us->bravery = ps->bravery;
+			const int bonus = std::min(std::max(0, (ps->bravery - 50) / 10), us->tu / 10);
+			us->tu += bonus;
+			u->setTimeUnits(us->tu);
+			_save->setVanStop("afPilot:" + std::to_string(u->getId()), pilots.front()->getId());
+		}
+		_save->setVanStop("afCraft:" + std::to_string(u->getId()) + ":" + craft->getRules()->getType(), craft->getId());
+		if (craft->getDamage() > 0 && craft->getDamageMax() > 0)
+		{
+			const int hp = u->getBaseStats()->health;
+			u->setHealthDirect(std::max(1, hp - hp * craft->getDamage() / craft->getDamageMax()));
+		}
+		if (autoPlay || getenv("OXCE_AIRFIGHT_AUTO"))
+		{
+			// AUTO-RESOLVE (design section 8): the computer flies the Joes too, one real battle, no screen
+			_save->setVanStop("afAuto", 1);
+			if (!autoPlay) _save->setVanStop("afAutoShow", 1); // the test rig watches it
+			u->setAIModule(new AIModule(_save, u, 0));
+		}
+		const auto *jr = mod->getAirCraft(rule->getType());
+		const bool crossing = joeTransportHunted && jr && jr->role == "transport";
+		int flo = 2, fhi = 2;
+		AirFight::floorRange(mod, _save, u, flo, fhi);
+		// deck 2 in the air; in a sea fight a boat starts on the surface (floor 1), a jet in the air
+		const int jz = std::max(flo, std::min(fhi, AirFight::isSeaFight(mod, _save) ? 1 : 2));
+		Position p = crossing ? Position(4, midY + n * 3, jz) : Position(W / 2 - 2 + n * 3, H - 5, jz);
+		const int dir = crossing ? 2 : 0;
+		if (crossing) _save->setVanStop("afExit:" + std::to_string(u->getId()), 1); // east
+		if (!place(u, p, dir)) delete u;
+		++n;
+	}
+	// Cobra
+	if (ufo)
+	{
+		Unit *rule = unitFor(ufo->getRules()->getType());
+		if (rule)
+		{
+			BattleUnit *u = _save->createTempUnit(rule, FACTION_HOSTILE, _unitSequence++);
+			u->setRankInt(0);
+			_save->setVanStop("afUfo:" + std::to_string(u->getId()), ufo->getId() + 1); // +1: a Cobra aircraft can be number 0
+			Position p; int dir;
+			int flo = 2, fhi = 3;
+			AirFight::floorRange(mod, _save, u, flo, fhi);
+			const int cz = RNG::generate(std::max(flo, std::min(fhi, 2)), std::min(fhi, 3));
+			const bool goingSomewhere = cobraGoing || (cobraRule && cobraRule->role == "ship");
+			if (goingSomewhere && !joeTransportHunted) { p = Position(4, midY, cz); dir = 2; _save->setVanStop("afExit:" + std::to_string(u->getId()), 1); }
+			else { p = Position(W / 2, H - 5 - 25, cz); dir = 4; }
+			// a little damage carried over from earlier fights (design 1b.5)
+			if (ufo->getRules()->getStats().damageMax > 0 && ufo->getDamage() > 0)
+			{
+				const int hp = u->getBaseStats()->health;
+				u->setHealthDirect(std::max(1, hp - hp * ufo->getDamage() / ufo->getRules()->getStats().damageMax));
+			}
+			if (!place(u, p, dir)) delete u;
+			// its escorts sail with it (sea: a Sea Sled under the water), on the lowest level they may use
+			auto es = AF.escorts.find(ufo->getRules()->getType());
+			Log(LOG_INFO) << "[sea] escorts listed: " << AF.escorts.size();
+			if (es != AF.escorts.end())
+			{
+				int k = 0;
+				for (const auto &type : es->second)
+				{
+					Unit *er = mod->getUnit(type, false);
+					if (!er) continue;
+					BattleUnit *e = _save->createTempUnit(er, FACTION_HOSTILE, _unitSequence++);
+					e->setRankInt(0);
+					int elo = 1, ehi = 1;
+					AirFight::floorRange(mod, _save, e, elo, ehi);
+					Position ep(p.x + 2 + 2 * (k % 3), p.y + (k % 2 ? 7 : -3), elo);
+					if (getenv("OXCE_SEA_TEST_UNDER")) ep = Position(W / 2 + 2, H - 8, elo); // test rig: start it near the Joes
+					if (!place(e, ep, dir)) { Log(LOG_WARNING) << "[sea] escort " << type << " could not be placed near " << ep; delete e; }
+					else Log(LOG_INFO) << "[sea] escort " << type << " at " << e->getPosition();
+					++k;
+				}
+			}
+		}
+	}
+	if (_save->getUnits()->empty())
+	{
+		throw Exception("Air fight: no aircraft could be placed.");
+	}
+	for (auto *u : *_save->getUnits())
+	{
+		if (u->getFaction() == FACTION_PLAYER) { _save->setSelectedUnit(u); break; }
+	}
+	_save->revealMap();   // open sky: the ground below is all in view (aircraft are still seen by sight)
+	if (!_save->getSelectedUnit())
+	{
+		throw Exception("Air fight: no Joe aircraft could be placed.");
+	}
+	setMusic(ruleDeploy, false);
+	_save->setGlobalShade(_worldShade);
+	_save->getTileEngine()->calculateLighting(LL_AMBIENT, TileEngine::invalid, 0, true);
+}
