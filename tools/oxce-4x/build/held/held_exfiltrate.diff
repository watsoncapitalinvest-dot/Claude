+/**
+ * G.I. Joe: Cobra retreats (John 13 Nov 22:44-22:50). A Cobra squad breaks when half its men are down
+ * or gone, when its leader is down, when it has what it came for (a man carrying off a Joe), or when it
+ * is clearly outnumbered by the Joes it can see. Once broken it stays broken: troopers run for the map
+ * edge, officers and villains pull back firing (AIModule), B.A.T.s never retreat. A man who reaches the
+ * edge on Cobra's turn is gone - not killed, not captured, he tells Cobra what he saw.
+ */
+void BattlescapeGame::retreatStep()
+{
+	const Mod::RetreatRules &rr = getMod()->getRetreatRules();
+	if (!rr.on || AirFight::isAirFight(getMod(), _save)) return; // an air fight has its own breaking-off rules
+	if (getenv("OXCE_VILLAIN_TEST")) return; // the villain test: Cobra stays to show every Move
+	auto never = [&](BattleUnit *u) { return std::find(rr.neverRetreat.begin(), rr.neverRetreat.end(), u->getType()) != rr.neverRetreat.end(); };
+	auto escaped = [&](BattleUnit *u) { return _save->getVanStop("esc:" + std::to_string(u->getId())) != 0; };
+	int total = 0, down = 0, standing = 0, seenJoes = 0;
+	bool leaderDown = false, carrying = false;
+	for (auto *u : *_save->getUnits())
+	{
+		if (u->getOriginalFaction() == FACTION_HOSTILE)
+		{
+			++total;
+			if (u->isOut() || escaped(u))
+			{
+				++down;
+				const std::string &r = u->getRankString();
+				if (!escaped(u) && (r == "STR_LIVE_LEADER" || r == "STR_LIVE_COMMANDER")) leaderDown = true;
+			}
+			else
+			{
+				++standing;
+				if (u->isCarrying()) carrying = true;
+			}
+		}
+		else if (u->getOriginalFaction() == FACTION_PLAYER && !u->isOut() && u->getTurnsSinceSpottedByFaction(FACTION_HOSTILE) == 0)
+		{
+			++seenJoes;
+		}
+	}
+	int start = _save->getVanStop("cobraStart", -1);
+	if (start < 0) { start = total; _save->setVanStop("cobraStart", total); }
+	if (!_save->getVanStop("retreat") && standing > 0 && !(Stealth::on(_save) && !Stealth::alarm(_save)))
+	{
+		// a chance, not a line (John 23:20 "to stiff"): nothing below breakFrom% of the men down, certain at
+		// breakAt%, more likely with the leader down or the Joes they can see outnumbering them; a man
+		// carrying off a Joe means the job is done and they go
+		const int lostPct = start > 0 ? down * 100 / start : 0;
+		int chance = rr.breakAt > rr.breakFrom ? (lostPct - rr.breakFrom) * 100 / (rr.breakAt - rr.breakFrom) : 0;
+		chance = std::max(0, std::min(100, chance));
+		if (leaderDown) chance += rr.leaderDownAdd;
+		const bool outnumbered = rr.outnumbered > 0 && seenJoes >= standing * rr.outnumbered;
+		if (outnumbered) chance += rr.outnumberedAdd;
+		if (carrying) chance = 100;
+		if (chance > 0 && RNG::percent(std::min(100, chance)))
+		{
+			_save->setVanStop("retreat", 1);
+			_parentState->warning("STR_COBRA_PULLING_OUT");
+			Log(LOG_INFO) << "[retreat] Cobra breaks (" << chance << "%): losses " << down << "/" << start << ", leader down " << leaderDown
+				<< ", carrying " << carrying << ", Joes seen " << seenJoes << " vs " << standing << " standing";
+		}
+	}
+	if (_save->getVanStop("retreat") && _save->getSide() == FACTION_HOSTILE)
+	{
+		const int W = _save->getMapSizeX(), H = _save->getMapSizeY();
+		for (auto *u : *_save->getUnits())
+		{
+			if (u->getOriginalFaction() != FACTION_HOSTILE || u->isOut() || escaped(u) || never(u) || u->isCarrying()) continue;
+			const Position p = u->getPosition();
+			if (p.x <= 0 || p.y <= 0 || p.x >= W - 1 || p.y >= H - 1)
+			{
+				_save->setVanStop("esc:" + std::to_string(u->getId()), 1);
+				_save->setVanStop("escaped", _save->getVanStop("escaped") + 1);
+				u->setTile(nullptr, _save);
+				u->setPosition(TileEngine::invalid);
+				u->goToTimeOut();
+				Log(LOG_INFO) << "[retreat] " << u->getType() << " " << u->getId() << " got away";
+			}
+		}
+	}
+}
