# MAPS' 17 Nov maps: HQ v3.1 (the Joe HQ raid map, replaces HQ airfield v2) and four villain-arrival maps (Motel, Bait Shop,
# Overpass, Office Tower). Briefs: claude/BRIEF_FOR_BUILD_HQv3 / Motel / BaitShop / Overpass / Tower. Each map padded to a multiple of 10
# by build/pad_map2.py (empty past the east and south edges). Terrain order exactly as each <MAP>_terrain.json.
# The arrival missions are NOT built (John: no build until he says go): the four maps are New Battle only, with a stand-in
# garrison of Cobra troopers; their spots files (villain start, witness room, trucks, barges, records room) are not wired yet.
terrains:
  - name: HQ3_T                    # HQ v3.1: 100 x 80 x 7, 1,118 parts
    mapDataSets: [BLANKS, HQ3KIT, HQKIT, SHIPKIT, FURN, INTER, EMMAI, LABSCI, PITB, PITC, PIT, PITMECH]
    mapBlocks:
      - {name: HQ3, width: 100, length: 80, height: 7}
  - name: MOTEL_T
    mapDataSets: [BLANKS, EMMA, INTER, EMMAI, FURN, LABSCI, PITC, SHIPKIT, STATION, TOWN]
    mapBlocks:
      - {name: MOTEL, width: 60, length: 50, height: 3}
  - name: BAITSHOP_T
    mapDataSets: [BLANKS, BSCRUB, SMUGGLR, STASH, SHIPKIT, EMMAI]
    mapBlocks:
      - {name: BAITSHOP, width: 60, length: 50, height: 3}
  - name: OVERPASS_T
    mapDataSets: [BLANKS, EMMA, BOXTRUCK, AMBUSH, TOWN, STATION, HQKIT, PIT]
    mapBlocks:
      - {name: OVERPASS, width: 60, length: 50, height: 3}
  - name: TOWER_T
    mapDataSets: [BLANKS, EMMA, HQ3KIT, HQKIT, SHIPKIT, FURN, INTER, EMMAI, LABSCI, BANK, TOWN]
    mapBlocks:
      - {name: TOWER, width: 50, length: 40, height: 6}

mapScripts:
  - type: HQ3_SCRIPT
    commands:
      - type: addBlock
        size: [10, 8]
        rects:
          - [0, 0, 10, 8]
        blocks: [0]
  - type: MOTEL_SCRIPT
    commands:
      - type: addBlock
        size: [6, 5]
        rects:
          - [0, 0, 6, 5]
        blocks: [0]
  - type: BAITSHOP_SCRIPT
    commands:
      - type: addBlock
        size: [6, 5]
        rects:
          - [0, 0, 6, 5]
        blocks: [0]
  - type: OVERPASS_SCRIPT
    commands:
      - type: addBlock
        size: [6, 5]
        rects:
          - [0, 0, 6, 5]
        blocks: [0]
  - type: TOWER_SCRIPT
    commands:
      - type: addBlock
        size: [5, 4]
        rects:
          - [0, 0, 5, 4]
        blocks: [0]

alienDeployments:
  - type: STR_MAP_MOTEL                  # villain arrival 1 (Storm Shadow, Silent Night); night
    terrains: [MOTEL_T]
    script: MOTEL_SCRIPT
    width: 60
    length: 50
    height: 3
    shade: 12
    data:
      - alienRank: 5
        lowQty: 6
        highQty: 8
        dQty: 1
        percentageOutsideUfo: 100
        itemSets:
          - [STR_PISTOL, STR_PISTOL_CLIP, STR_PISTOL_CLIP]
          - [STR_RIFLE, STR_RIFLE_CLIP, STR_RIFLE_CLIP]
          - [STR_RIFLE, STR_RIFLE_CLIP, STR_RIFLE_CLIP]
    civilians: 10
    briefing: {palette: 0, title: STR_MAP_MOTEL, desc: STR_MAP_ARRIVAL_TEST_BRIEFING}
  - type: STR_MAP_BAITSHOP                  # villain arrival 2 (Zartan + the Dreadnoks, Swamp Rat)
    terrains: [BAITSHOP_T]
    script: BAITSHOP_SCRIPT
    width: 60
    length: 50
    height: 3
    shade: 0
    data:
      - alienRank: 5
        lowQty: 6
        highQty: 8
        dQty: 1
        percentageOutsideUfo: 100
        itemSets:
          - [STR_PISTOL, STR_PISTOL_CLIP, STR_PISTOL_CLIP]
          - [STR_RIFLE, STR_RIFLE_CLIP, STR_RIFLE_CLIP]
          - [STR_RIFLE, STR_RIFLE_CLIP, STR_RIFLE_CLIP]
    civilians: 2
    briefing: {palette: 0, title: STR_MAP_BAITSHOP, desc: STR_MAP_ARRIVAL_TEST_BRIEFING}
  - type: STR_MAP_OVERPASS                  # villain arrival 4 (the Baroness, Chain of Custody)
    terrains: [OVERPASS_T]
    script: OVERPASS_SCRIPT
    width: 60
    length: 50
    height: 3
    shade: 0
    data:
      - alienRank: 5
        lowQty: 6
        highQty: 8
        dQty: 1
        percentageOutsideUfo: 100
        itemSets:
          - [STR_PISTOL, STR_PISTOL_CLIP, STR_PISTOL_CLIP]
          - [STR_RIFLE, STR_RIFLE_CLIP, STR_RIFLE_CLIP]
          - [STR_RIFLE, STR_RIFLE_CLIP, STR_RIFLE_CLIP]
    civilians: 6
    briefing: {palette: 0, title: STR_MAP_OVERPASS, desc: STR_MAP_ARRIVAL_TEST_BRIEFING}
  - type: STR_MAP_TOWER                  # villain arrival 5 (Tomax and Xamot, Hostile Takeover)
    terrains: [TOWER_T]
    script: TOWER_SCRIPT
    width: 50
    length: 40
    height: 6
    shade: 0
    data:
      - alienRank: 5
        lowQty: 8
        highQty: 10
        dQty: 1
        percentageOutsideUfo: 100
        itemSets:
          - [STR_PISTOL, STR_PISTOL_CLIP, STR_PISTOL_CLIP]
          - [STR_RIFLE, STR_RIFLE_CLIP, STR_RIFLE_CLIP]
          - [STR_RIFLE, STR_RIFLE_CLIP, STR_RIFLE_CLIP]
    civilians: 10
    briefing: {palette: 0, title: STR_MAP_TOWER, desc: STR_MAP_ARRIVAL_TEST_BRIEFING}

extraStrings:
  - type: en-US
    strings: &maps17
      STR_MAP_MOTEL: "Roadside Motel"
      MAP_MOTEL_T: "Roadside Motel"
      STR_MAP_BAITSHOP: "Swamp Bait Shop"
      MAP_BAITSHOP_T: "Swamp Bait Shop"
      STR_MAP_OVERPASS: "Highway Overpass"
      MAP_OVERPASS_T: "Highway Overpass"
      STR_MAP_TOWER: "Office Tower"
      MAP_TOWER_T: "Office Tower"
      MAP_HQ3_T: "G.I. Joe HQ (v3.1)"
      STR_MAP_ARRIVAL_TEST_BRIEFING: "Map test. The mission that brings a villain here is not built yet: these are stand-in Cobra troopers."
  - type: en-GB
    strings: *maps17
