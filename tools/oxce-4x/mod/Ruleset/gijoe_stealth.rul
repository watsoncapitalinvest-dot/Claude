# G.I. Joe sound and stealth (claude/SOUND_STEALTH_DESIGN_v1.md, approved by John 14 Nov 23:35).
# Every number is a first guess for tuning (TUNING_RECORD rows 35-38). The engine side is Battlescape/Stealth.cpp.
stealth:
  noise:                     # radius in tiles
    pistol: 15
    rifle: 20                # rifle, SMG, shotgun
    heavy: 25                # machine gun, sniper rifle
    launcher: 30
    explosion: 35
    silenced: 4              # (silencers wait for the attachments system)
    silencedSniper: 6
    melee: 2
    dart: 2
    failedTakedown: 8
    window: 8                # also a smoke grenade's pop
    car: 15
    door: 3
    walk: 2
    run: 5                   # more than runTiles tiles in one turn
    crouch: 1                # moving while kneeling
  runTiles: 6
  sleepNight: 30
  sleepDay: 10
  alertTurns: 5
  shoutRadius: 6
  pairRadius: 5
  takedownCap: 95
  burnCluesPct: 50
  quietScorePct: 20
  quietGoodwill: 1
  quietExposurePct: 50
  quietInterrogationPct: 50
  # These start QUIET (Cobra doesn't know the Joes are there). Everything else starts LOUD (the alarm is already up).
  quietDeployments:
    - STR_COBRA_FRONT
    - STR_COBRA_FRONT_COMPANY_SITE
    - STR_COBRA_FACTORY_SITE
    - STR_COBRA_TRAINING_CAMP_SITE
    - STR_COBRA_DEPOT_SITE
    - STR_COBRA_RESEARCH_LAB_SITE
    - STR_COBRA_TERROR_DROME_SITE
    - STR_COBRA_BROADCAST_STATION_SITE
    - STR_COBRA_HIDDEN_HQ_SITE
    - STR_ALIEN_BASE_ASSAULT
    - STR_CARTEL_RANCH
    - STR_CARTEL_STASH_HOUSE
    - STR_CARTEL_SAFEHOUSE
    - STR_ABANDONED_FACTORY
    - STR_MAP_LAB_OUTPOST
    - STR_MAP_COBRA_LAIR
    # New Battle test maps, so the system can be tried out (Cobra hiding in a town)
    - STR_EMMA250
    - STR_EMMA500
    - STR_SPRING500
    - STR_SHIP_HIJACK            # the hostage ship (John 17 Nov: "can I sneak up to them"): the hijackers start unaware
    - STR_MAP_HIJACKED_SHIP      # its New Battle copy
    - STR_MAP_EMMAVILLE
    - STR_MAP_EMMA_LANDMARK
    - STR_MAP_EMMA_UNDERGROUND
    - STR_MAP_SMALL_CITY
    - STR_MAP_CHOPSHOP
    - STR_MAP_JUNKYARD
  # Silent trait: a takedown always works (ROSTER may add more)
  silentUnits:
    - STR_SNAKE_EYES
    - STR_STALKER
    - STR_SPIRIT
    - STR_STORM_SHADOW_UNIT
    - STR_NB_STORM_SHADOW
    - STR_FIREFLY_UNIT
  keenEars: []
  # quiet shots that can take a man down at range
  dartWeapons:
    - STR_TRANQ_GUN
    - STR_GJ_XK1_CROSSBOW

extraStrings:
  - type: en-US
    strings: &stealthstr
      STR_COBRA_ALARM_UP: "COBRA HAS RAISED THE ALARM!"
      STR_QUIET_MISSION: "No alarm raised"
  - type: en-GB
    strings: *stealthstr
