# Wired now: the two of CAST's weapons that exist as items today.
items:
  - type: STR_GRENADE           # frag grenade: smaller than the big explosion (John approved)
    hitSound: [712, 713, 714]
  - type: STR_SMOKE_GRENADE     # pop + hiss
    hitSound: [745, 746, 747]

