# G.I. Joe battle bar (BATTLE_HUD_SPEC_v1, approved 12 Nov): 42 base px tall instead of
# X-COM's 56, so more of the map shows. The engine lays the bar out and paints it
# (BattlescapeState::layoutJoeHud, HiUI::nativeHud); this only sets its height.
interfaces:
  - type: battlescape
    elements:
      - id: icons
        size: [320, 42]
