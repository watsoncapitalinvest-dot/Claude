# THE CARTEL'S OWN SIDE (STORY 17 Nov, BRIEF Day 1 cartel ranch; John 14:20 "the first cartel mission it is cobra",
# 14:28 "cartel boss isn't on every mission").
#
# Every cartel job fields CARTEL GUNMEN: the ranch, the armored-car ambush, the stash house, the safehouse and the
# cartel's arrival at the abandoned factory (each deployment says race: STR_CARTEL). The CARTEL BOSS is at the ranch
# only; the other jobs' leaders are gunmen with leader rank (STR_ROBBERY_LEADER on the armored car).
# Nothing on these jobs says Cobra: the unit names, the mission card ("Cartel seen", "CARTEL TURN"), the debrief title
# and its score lines (STR_..._CARTEL, read by the engine when the deployment's race is STR_CARTEL).
#
# The race is mission-only: no mission script sends it, so it never enters the Cobra calendar or the garrisons.
#
# BODIES: the cartel men ARE John's Cobra Recruit (ski mask, navy zip jacket, plain armband, jeans), rendered on the
# Walk16 sheet 17 Nov (build/sprites/render_walk16.sh cobra_recruit -> cartel_gunman_body.png). The boss wears the
# same body, as the brief says; he is told apart by his shotgun and his name.
#
# EVERY OUTCOME STARTS THE LEAD: the ranch lost, pulled out of or never raided grants STR_RANCH_LOST; the engine
# then spawns STR_EVENT_RANCH_LOST (gijoeEventsOnResearch), which pops 3-5 days later and hands over
# STR_CARTEL_FLIGHT_ROUTE (step 2 of the arc, fewer lead points than a win: no ledger, plate, stencil or boss).
# The factory lost or pulled out of still teaches STR_FACTORY_REACTIVATION_DATE. The armored car already had
# STR_ROBBERY_MISSED. Anything a Joe carries to the transport and out comes home on any result (stock).

extraSprites:
  - type: GIJOE_CARTEL_GUNMAN_HD.PCK
    width: 2048
    height: 12160            # 1216 frames: + stairs up/down and hands up (17 Nov 23:40)
    subX: 128
    subY: 160
    files:
      0: Resources/Units/cartel_gunman_body.png

armors:
  - type: CARTEL_GUNMAN_ARMOR
    spriteSheet: GIJOE_CARTEL_GUNMAN_HD.PCK
    drawingRoutine: 23
    deathFrames: 8
    corpseBattle: [STR_CORPSE_CARTEL]
    frontArmor: 4
    sideArmor: 4
    rearArmor: 2
    underArmor: 0
    loftempsSet: [ 3 ]
  - type: CARTEL_BOSS_ARMOR
    spriteSheet: GIJOE_CARTEL_GUNMAN_HD.PCK
    drawingRoutine: 23
    deathFrames: 8
    corpseBattle: [STR_CORPSE_CARTEL]
    frontArmor: 6
    sideArmor: 5
    rearArmor: 3
    underArmor: 0
    loftempsSet: [ 3 ]

units:
  - type: STR_CARTEL_GUNMAN
    race: STR_CARTEL
    rank: STR_LIVE_SOLDIER
    stats:                       # a little under a Cobra trooper (the trooper is half a regular Joe)
      tu: 50
      stamina: 55
      health: 18
      bravery: 20
      reactions: 25
      firing: 26
      throwing: 25
      strength: 30
      psiStrength: 40
      psiSkill: 0
      melee: 30
    armor: CARTEL_GUNMAN_ARMOR
    standHeight: 22
    kneelHeight: 14
    value: 8
    deathSound: 41
    intelligence: 2
    aggression: 2
  - type: STR_CARTEL_BOSS        # the ranch only; better than his men (MAP_DESIGN_M1 s.6), a shotgun
    race: STR_CARTEL
    rank: STR_LIVE_LEADER
    stats:
      tu: 56
      stamina: 90
      health: 40
      bravery: 80
      reactions: 55
      firing: 55
      throwing: 50
      strength: 40
      psiStrength: 40
      psiSkill: 0
      melee: 60
    armor: CARTEL_BOSS_ARMOR
    standHeight: 22
    kneelHeight: 14
    value: 20
    deathSound: 41
    intelligence: 3
    aggression: 1

alienRaces:
  - id: STR_CARTEL
    members:                     # every rank is a gunman; the boss and the leaders come by customUnitType
      - STR_CARTEL_GUNMAN
      - STR_CARTEL_GUNMAN
      - STR_CARTEL_GUNMAN
      - STR_CARTEL_GUNMAN
      - STR_CARTEL_GUNMAN
      - STR_CARTEL_GUNMAN
      - STR_CARTEL_GUNMAN
      - STR_CARTEL_GUNMAN

items:
  - type: STR_CORPSE_CARTEL
    name: STR_CORPSE
    weight: 22
    bigSprite: 65
    floorSprite: 85
    invWidth: 2
    invHeight: 3
    battleType: 11
    recover: false               # nothing to learn from a cartel gunman's body; it is counted, not stored
    costSell: 0

research:
  - name: STR_RANCH_LOST         # granted by losing, pulling out of or never raiding the ranch
    cost: 1
    points: 0
    dependencies: [STR_STORY_LOCK]
  # A WON ranch with neither the ledger nor the boss (safe left shut, boss dead) used to dead-end: the plate opened
  # nothing and the flight route needs the ledger or the boss, so the arc sat still until the robbery's backstop date,
  # about day 41 (BUILD-1's 120-day run, 18 Nov). The arc's rule is that every outcome has a version: the plate or the
  # stencil now opens the flight route too. Slower than the ledger by its own read time (plate 40, stencil 30 v 30 + the
  # ledger's head start), and with fewer lead points, as STORY_CartelArc_v1 has it for "ledger burned".
  - name: STR_CRATE_SERIAL_PLATE
    unlocks: [STR_CARTEL_FLIGHT_ROUTE]
  - name: STR_COBRA_STENCIL
    unlocks: [STR_WHO_IS_COBRA, STR_CARTEL_FLIGHT_ROUTE]
  # The informant's tip puts the robbery on the map DAYS ahead, as STORY's arc has it - not at the next month's script
  # run (mission scripts only run at a month's start; a tip on day 12 brought the robbery on day 34). Same pattern as
  # the factory and the safehouse in gijoe_cartel_arc.rul: the topic fires an event, the event runs the ad-hoc script.
  - name: STR_INFORMANT_TIP
    spawnedEvent: STR_EVENT_ROBBERY_TIPPED

events:
  - name: STR_EVENT_ROBBERY_TIPPED      # text: BUILD-1 placeholder for STORY (below)
    description: STR_EVENT_ROBBERY_TIPPED_DESCRIPTION
    adhocMissionScriptTags: [cartelRobbery]
    timer: 2880                          # two days after the tip is read; the job itself is on the map a day later
  - name: STR_EVENT_RANCH_LOST   # the text is STORY's (gijoe_story_act1_text.rul)
    description: STR_EVENT_RANCH_LOST_DESCRIPTION
    background: BACK16.SCR
    timer: 4320                  # 3 days
    timerRandom: 2880            # + up to 2 more
    researchList: [STR_CARTEL_FLIGHT_ROUTE]

adhocScripts:
  - type: armoredCarTippedNow
    adhocMissionScriptTags: [cartelRobbery]
    maxRuns: 1
    varName: armoredCarRobbery          # shared with gijoe_maps_ambush.rul's two monthly scripts: the robbery happens once
    executionOdds: 100
    researchTriggers:
      STR_INFORMANT_TIP: true
    missionWeights:
      0:
        STR_ARMORED_CAR_AMBUSH_MISSION: 100
    regionWeights:
      0:
        STR_NORTH_AMERICA: 100

gijoeEventsOnResearch:
  STR_RANCH_LOST: STR_EVENT_RANCH_LOST

extraStrings:
  - type: en-US
    strings: &cartelStrings
      STR_CARTEL: "Cartel"
      # PLACEHOLDERS for STORY (18 Nov): the tipped robbery's notice
      STR_EVENT_ROBBERY_TIPPED: "THE JOB IS ON"
      STR_EVENT_ROBBERY_TIPPED_DESCRIPTION: "SCARLETT: My courier came through. The cartel hits the SECURE-TRANS payroll car at Sundown Gas on US-90 tomorrow. Six men and a getaway van. We know where and we know when."
      STR_CARTEL_GUNMAN: "Cartel Gunman"
      STR_CARTEL_BOSS: "Cartel Boss"
      STR_CARTEL_DEFEATED: "Cartel gunmen defeated"
      STR_ALIENS_KILLED_CARTEL: "CARTEL GUNMEN KILLED"
      STR_COBRA_GOT_AWAY_CARTEL: "Cartel men who got away"          # 18 Nov: fell back to "Cobra men who got away" on cartel jobs
      STR_SMART_TAKEN_ALIVE_CARTEL: "Smart play: cartel man taken alive"
      STR_SMART_LOOT_RECOVERED_CARTEL: "Smart play: the cash stayed here"
      STR_SMART_NONE_ESCAPED_CARTEL: "Smart play: no robber got away"
      STR_SMART_NO_CIVILIAN_HURT_CARTEL: "Smart play: no civilian hurt"
      STR_CIVILIANS_SAVED_CARTEL: "CIVILIANS SAVED"
      STR_XCOM_OPERATIVES_KILLED_CARTEL: "G.I. JOE OPERATIVES KILLED"
      STR_ALIEN_CORPSES_RECOVERED_CARTEL: "CARTEL BODIES"
      STR_LIVE_ALIENS_RECOVERED_CARTEL: "CARTEL GUNMEN TAKEN ALIVE"
      STR_LIVE_ALIENS_SURRENDERED_CARTEL: "CARTEL GUNMEN SURRENDERED"
      STR_RANCH_LOST: "The ranch abandoned"
  - type: en-GB
    strings: *cartelStrings
