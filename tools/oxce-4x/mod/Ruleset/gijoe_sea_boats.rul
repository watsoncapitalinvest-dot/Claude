# Joe boats in the sea fights (SEA_BATTLES_DESIGN_v1 section 4) and the torpedo (section 5).
# Devilfish: 2x2 attack boat, the surface only. S.H.A.R.C.: 2x2 flying submarine, all three levels.
# Both open with their research (STR_DEVILFISH, STR_SHARC in gijoe_research_joe.rul) and need a pilot.
# A boat only takes on ships: sent after an aircraft it turns for home (engine: AirFight::isBoat).
#
# The torpedo (STR_SEA_TORPEDO_TUBE) is launched, not fired: a torpedo unit runs along the firer's heading,
# 8 tiles a round for 3 rounds, and strikes the first hull it meets for 60, always to the hull. A ship of
# 3x3 and up is hit 85% of the time, a smaller boat 85% less 4% per point of its agility (engine: AirFight).
#
# Depth charges (STR_SEA_DEPTH_CHARGE, 4 on the Devilfish): rolled off a boat on the surface, 35 to everything
# under the water below it and one tile round, no aim roll, 10 TU (sea design 5). The computer's boats roll one
# on anything under the water beneath them.
# Mines (STR_SEA_MINE_RACK): laid where the boat is, on its level, 8 TU; 50 to whatever next enters that tile.
# They arm once the boat that laid them has moved off. Nothing carries the rack yet (the design gives mines to
# no Joe boat by name): STORY to say which.
#
# NOT YET: Devilfish missiles (Phase 2, with the air missiles); divers; sonar; a mine hidden from its enemy;
# the S.H.A.R.C. diving under the water (it may use floors 0-2, the AI keeps it on the surface or in the air).
# Boats keep to the water and the rivers below on the world map (engine: SeaNav, a half-degree water grid).
# A boat sent where the water doesn't go turns for home. The S.H.A.R.C. flies, so it is not held to water.

airFight:
  units:
    STR_DEVILFISH: STR_SEA_DEVILFISH
    STR_SHARC: STR_SEA_SHARC
  aircraft:
    STR_SEA_DEVILFISH: {role: fighter, agility: 14, minFloor: 1, maxFloor: 1, seaMinFloor: 1, seaMaxFloor: 1, arc: forward, seaOnly: true}
    STR_SEA_SHARC: {role: fighter, agility: 16, minFloor: 1, maxFloor: 4, seaMinFloor: 0, seaMaxFloor: 2, arc: forward}
  # Navigable rivers for boats (John 14 Nov: "kept to water and rivers"). [lon, lat] in degrees, the game's
  # convention: lon 0-360 east, lat NORTH NEGATIVE. Hand-drawn from city points along each river, mouth first:
  # approximate, good to the half-degree grid the boats route on (engine: SeaNav).
  rivers:
    MISSISSIPPI: [[270.75, -29.15], [269.93, -29.95], [268.81, -30.45], [268.6, -31.56], [269.12, -32.35], [269.95, -35.15], [270.82, -37.0], [269.81, -38.63], [266.74, -44.98]]
    OHIO: [[270.82, -37.0], [274.24, -38.25], [275.49, -39.1], [280.0, -40.44]]
    RIO_GRANDE: [[262.85, -25.95], [262.5, -25.9], [260.5, -27.5]]
    HUDSON: [[286.0, -40.7], [286.25, -42.65]]
    ST_LAWRENCE: [[296.0, -49.5], [288.8, -46.8], [286.45, -45.5], [283.5, -44.1]]
    AMAZON: [[310.0, -0.0], [305.3, 2.4], [300.0, 3.1], [295.3, 3.35], [286.75, 3.75]]
    ORINOCO: [[299.0, -8.6], [296.45, -8.12], [292.4, -5.66]]
    PARANA: [[301.6, 34.6], [299.35, 32.95], [301.2, 27.47], [302.4, 25.3]]
    NILE: [[31.0, -31.5], [31.23, -30.04], [32.64, -25.69], [32.9, -24.09], [32.53, -15.6]]
    CONGO: [[12.3, 6.0], [13.45, 5.82], [15.3, 4.32], [18.26, -0.05], [25.2, -0.52]]
    NIGER: [[6.0, -4.3], [6.78, -6.14], [6.74, -7.8], [2.1, -13.5]]
    RHINE: [[4.0, -51.95], [6.76, -51.43], [6.96, -50.94], [8.27, -50.0], [7.59, -47.56]]
    SEINE: [[0.1, -49.5], [2.35, -48.86]]
    DANUBE: [[29.6, -45.2], [25.95, -43.85], [20.46, -44.82], [19.04, -47.5], [16.37, -48.21]]
    VOLGA: [[48.03, -46.35], [44.5, -48.7], [50.1, -53.2], [49.1, -55.8]]
    YANGTZE: [[121.9, -31.4], [118.8, -32.06], [114.3, -30.6], [111.3, -30.7], [106.55, -29.56]]
    MEKONG: [[106.6, -9.9], [104.92, -11.56], [102.6, -17.97]]
    GANGES: [[88.5, -21.7], [88.36, -22.57], [85.14, -25.6], [83.0, -25.32]]
    # canals and narrow straits the half-degree grid would close (same convention)
    PANAMA_CANAL: [[280.1, -9.35], [280.47, -8.95], [280.47, -8.5]]
    SUEZ_CANAL: [[32.3, -31.7], [32.3, -31.26], [32.55, -29.97], [32.6, -29.5], [33.2, -28.6], [33.8, -27.8], [34.2, -27.3]]
    GIBRALTAR: [[353.5, -36.0], [354.5, -35.95], [355.5, -36.1]]
    DARDANELLES_BOSPORUS: [[26.0, -40.0], [26.7, -40.4], [28.0, -40.9], [29.0, -41.0], [29.1, -41.3]]
    DANISH_STRAITS: [[10.6, -57.7], [11.5, -56.5], [12.6, -56.0], [12.7, -55.4]]
    BAB_EL_MANDEB: [[43.0, -13.0], [43.4, -12.6], [43.8, -12.3]]
    HORMUZ: [[56.0, -26.0], [56.5, -26.5], [57.0, -26.0]]
    MALACCA: [[95.5, -5.5], [98.0, -4.0], [100.3, -2.8], [101.5, -2.0], [103.5, -1.2], [104.0, -1.3]]
  weapons:
    STR_SEA_DEVILFISH_GUN: {minFloor: 1, maxFloor: 1}           # a boat's gun: the surface
    STR_SEA_SHARC_GUN: {minFloor: 1, maxFloor: 2}
    STR_SEA_TORPEDO_TUBE: {minFloor: 0, maxFloor: 1, torpedo: 60, torpedoSpeed: 8, torpedoRounds: 3}
    STR_SEA_DEPTH_CHARGE: {arc: any, minFloor: 0, maxFloor: 2, depthCharge: 35}
    STR_SEA_MINE_RACK: {arc: any, minFloor: 0, maxFloor: 2, mine: 50}

