# Joe boats in the sea fights (SEA_BATTLES_DESIGN_v1 section 4) and the torpedo (section 5).
# Devilfish: 2x2 attack boat, the surface only. S.H.A.R.C.: 2x2 flying submarine, all three levels.
# Both open with their research (STR_DEVILFISH, STR_SHARC in gijoe_research_joe.rul) and need a pilot.
# A boat only takes on ships: sent after an aircraft it turns for home (engine: AirFight::isBoat).
#
# The torpedo (STR_SEA_TORPEDO_TUBE) is launched, not fired: a torpedo unit runs along the firer's heading,
# 8 tiles a round for 3 rounds, and strikes the first hull it meets for 60, always to the hull. A ship of
# 3x3 and up is hit 85% of the time, a smaller boat 85% less 4% per point of its agility (engine: AirFight).
#
# NOT YET: Devilfish missiles (Phase 2, with the air missiles) and its depth charges; mines; divers;
# the S.H.A.R.C. diving under the water (it may use floors 0-2, the AI keeps it on the surface or in the air).
# KNOWN LIMIT: boats travel the world map like aircraft, over land too. Water-only routes are not built.

airFight:
  units:
    STR_DEVILFISH: STR_SEA_DEVILFISH
    STR_SHARC: STR_SEA_SHARC
  aircraft:
    STR_SEA_DEVILFISH: {role: fighter, agility: 14, minFloor: 1, maxFloor: 1, seaMinFloor: 1, seaMaxFloor: 1, arc: forward, seaOnly: true}
    STR_SEA_SHARC: {role: fighter, agility: 16, minFloor: 1, maxFloor: 4, seaMinFloor: 0, seaMaxFloor: 2, arc: forward}
  weapons:
    STR_SEA_DEVILFISH_GUN: {minFloor: 1, maxFloor: 1}           # a boat's gun: the surface
    STR_SEA_SHARC_GUN: {minFloor: 1, maxFloor: 2}
    STR_SEA_TORPEDO_TUBE: {minFloor: 0, maxFloor: 1, torpedo: 60, torpedoSpeed: 8, torpedoRounds: 3}

crafts:
  - type: STR_DEVILFISH
    requires: [STR_DEVILFISH]
    sprite: 3
    fuelMax: 800
    damageMax: 100
    speedMax: 900
    accel: 3
    weapons: 0
    soldiers: 1
    pilots: 1
    allowLanding: false
    costBuy: 450000
    refuelRate: 50
    transferTime: 96
    score: 200
  - type: STR_SHARC
    requires: [STR_SHARC]
    sprite: 3
    fuelMax: 800
    damageMax: 80
    speedMax: 1600
    accel: 4
    weapons: 0
    soldiers: 1
    pilots: 1
    allowLanding: false
    costBuy: 650000
    refuelRate: 50
    transferTime: 96
    score: 200

