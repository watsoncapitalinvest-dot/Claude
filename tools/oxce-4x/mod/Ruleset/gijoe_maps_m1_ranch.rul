# MAPS 12 Nov 2026: mission 1, the cartel ranch on the Rio Grande (fixed 50 x 40 x 4 map).
# Terrain order matters: MAP part ids are BLANKS(0-1), BSCRUB, BARNYRD, RANCH, SMUGGLR, in this order.
terrains:
  - name: M1RANCH
    mapDataSets:
      - BLANKS
      - BSCRUB
      - BARNYRD
      - RANCH
      - SMUGGLR
    mapBlocks:
      - name: M1RANCH
        width: 50
        length: 40
        height: 4
        groups: [0]
# Suggested map script (BUILD owns the mission and craft wiring): one fixed block, nothing random.
mapScripts:
  - type: M1RANCH_SCRIPT
    commands:
      - type: addBlock
        size: [5, 4]
        groups: [0]
        rects:
          - [0, 0, 5, 4]

# BUILD 12 Nov: the battle that uses it. Mission 1's story wiring (Day 1 opener, the boss
# taken alive, the ledger) is STORY's; this deployment is what that wiring will name.
# Placeholder garrison (SHORTCUTS.md #14): ten Cobra troopers standing in for the cartel
# gunmen, pistols only (months 1-3), the boss as the officer rank; two civilians.
alienDeployments:
  - type: STR_CARTEL_RANCH
    data:
      - alienRank: 5
        lowQty: 8
        highQty: 10
        dQty: 1
        percentageOutsideUfo: 100
        itemSets:
          - [STR_PISTOL, STR_PISTOL_CLIP, STR_PISTOL_CLIP]
          - [STR_PISTOL, STR_PISTOL_CLIP, STR_PISTOL_CLIP]
          - [STR_PISTOL, STR_PISTOL_CLIP, STR_PISTOL_CLIP]
      - alienRank: 4
        customUnitType: STR_CARTEL_BOSS   # taken alive -> STR_CARTEL_BOSS (interrogation)
        lowQty: 1
        highQty: 1
        dQty: 0
        percentageOutsideUfo: 100
        itemSets:
          - [STR_PISTOL, STR_PISTOL_CLIP]
          - [STR_PISTOL, STR_PISTOL_CLIP]
          - [STR_PISTOL, STR_PISTOL_CLIP]
    civilians: 2
    width: 50
    length: 40
    height: 4
    terrains: [M1RANCH]
    script: M1RANCH_SCRIPT
    shade: 0
    duration: [24, 48]
    briefing:
      palette: 0
      title: STR_CARTEL_RANCH
      desc: STR_CARTEL_RANCH_BRIEFING
extraStrings:
  - type: en-US
    strings:
      STR_CARTEL_RANCH: Cartel Ranch
      STR_CARTEL_RANCH_BRIEFING: "A drug cartel runs guns and product through a ranch on the Rio Grande. Hit it, clear the gunmen, and take the boss alive if you can."
  - type: en-GB
    strings:
      STR_CARTEL_RANCH: Cartel Ranch
      STR_CARTEL_RANCH_BRIEFING: "A drug cartel runs guns and product through a ranch on the Rio Grande. Hit it, clear the gunmen, and take the boss alive if you can."
