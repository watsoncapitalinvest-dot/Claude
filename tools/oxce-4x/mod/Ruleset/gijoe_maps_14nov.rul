# MAPS' 13-14 Nov maps, wired so they load and play (New Battle lists every deployment here).
# No campaign mission sends any of these yet, and the special hooks their briefs ask for are NOT built
# (hostage shooting, container doors waking the minders, the riot lift exit, the weapons locker, Clutch as a Joe).
# Terrains and scripts for small city, lab outpost and bank are MAPS' own files: gijoe_maps_small_city.rul,
# gijoe_maps_lab_outpost.rul (the .MAP2 version), gijoe_maps_bank.rul.
# Node ranks in every one of these maps: 0 civilians/hostages, 1 Joe start, 2 hostiles, 4 a leader.

terrains:
  - name: HARBOUR_T                # BRIEF_FOR_BUILD_Harbour: 100 x 50 x 8, .MAP2, 962 parts
    mapDataSets: [BLANKS, SHIPKIT, SHIPF_A, SHIPF_B, SHIPF_C, CONTX, HARBX, HARBT]
    mapBlocks:
      - {name: HARBOUR, width: 100, length: 50, height: 8}
  - name: HIJACKED_T               # BRIEF_FOR_BUILD_HijackedShip: the freighter hull, its own nodes
    mapDataSets: [BLANKS, SHIPKIT, SHIPX, SHIPF_A, SHIPF_B, SHIPF_C]
    mapBlocks:
      - {name: HIJACKED, width: 60, length: 20, height: 8}
  - name: CONTSHIP_T               # BRIEF_FOR_BUILD_ContainerShip: 60 x 20 x 8, .MAP2, 666 parts
    mapDataSets: [BLANKS, SHIPKIT, CONTX, SHIPF_A, SHIPF_B, SHIPF_C]
    mapBlocks:
      - {name: CONTSHIP, width: 60, length: 20, height: 8}
  - name: RIOT                     # BRIEF_FOR_BUILD_Transport_Riot map 2: 30 x 30 x 2
    mapDataSets: [BLANKS, PIT]
    mapBlocks:
      - {name: RIOT, width: 30, length: 30, height: 2}
  - name: CHOPSHOP                 # BRIEF_FOR_BUILD_ChopShop_Junkyard map 1: 40 x 40 x 2
    mapDataSets: [BLANKS, JUNK, JCARS]
    mapBlocks:
      - {name: CHOPSHOP, width: 40, length: 40, height: 2}
  - name: JUNKYARD                 # map 2: 50 x 50 x 2
    mapDataSets: [BLANKS, JUNK, JCARS]
    mapBlocks:
      - {name: JUNKYARD, width: 50, length: 50, height: 2}

mapScripts:
  - type: HARBOUR_SCRIPT
    commands:
      - type: addBlock
        size: [10, 5]
        rects:
          - [0, 0, 10, 5]
  - type: HIJACKED_SCRIPT
    commands:
      - type: addBlock
        size: [6, 2]
        rects:
          - [0, 0, 6, 2]
  - type: CONTSHIP_SCRIPT
    commands:
      - type: addBlock
        size: [6, 2]
        rects:
          - [0, 0, 6, 2]
  - type: RIOT_SCRIPT
    commands:
      - type: addBlock
        size: [3, 3]
  - type: CHOPSHOP_SCRIPT
    commands:
      - type: addBlock
        size: [4, 4]
  - type: JUNKYARD_SCRIPT
    commands:
      - type: addBlock
        size: [5, 5]

alienDeployments:
  - type: STR_MAP_HARBOUR
    data:
      - &trooper
        alienRank: 5
        lowQty: 8
        highQty: 10
        dQty: 1
        percentageOutsideUfo: 100
        itemSets:
          - [STR_PISTOL, STR_PISTOL_CLIP, STR_PISTOL_CLIP]
          - [STR_RIFLE, STR_RIFLE_CLIP, STR_RIFLE_CLIP]
          - [STR_RIFLE, STR_RIFLE_CLIP, STR_RIFLE_CLIP]
    civilians: 5                   # the dock workers
    width: 100
    length: 50
    height: 8
    terrains: [HARBOUR_T]
    script: HARBOUR_SCRIPT
    shade: 0
    briefing: {palette: 0, title: STR_MAP_HARBOUR, desc: STR_MAP_HARBOUR_BRIEFING}

  - type: STR_MAP_HIJACKED_SHIP
    data:
      - *trooper
      - alienRank: 5               # the hijack leader by the wheel (rank-4 node)
        customUnitType: STR_ROBBERY_LEADER
        lowQty: 1
        highQty: 1
        dQty: 0
        percentageOutsideUfo: 100
        itemSets:
          - [STR_PISTOL, STR_PISTOL_CLIP]
    civilians: 12                  # the hostages: 5 officers on the bridge, 7 in the mess
    width: 60
    length: 20
    height: 8
    terrains: [HIJACKED_T]
    script: HIJACKED_SCRIPT
    shade: 0
    briefing: {palette: 0, title: STR_MAP_HIJACKED_SHIP, desc: STR_MAP_HIJACKED_SHIP_BRIEFING}

  - type: STR_MAP_CONTAINER_SHIP
    data:
      - *trooper
    civilians: 9                   # the crew
    width: 60
    length: 20
    height: 8
    terrains: [CONTSHIP_T]
    script: CONTSHIP_SCRIPT
    shade: 0
    briefing: {palette: 0, title: STR_MAP_CONTAINER_SHIP, desc: STR_MAP_CONTAINER_SHIP_BRIEFING}

  - type: STR_MAP_RIOT
    data:
      - alienRank: 5               # the prisoners: unarmed until they reach the weapons locker
        lowQty: 8
        highQty: 12
        dQty: 1
        percentageOutsideUfo: 100
        itemSets:
          - []
    width: 30
    length: 30
    height: 2
    terrains: [RIOT]
    script: RIOT_SCRIPT
    shade: 0
    briefing: {palette: 0, title: STR_MAP_RIOT, desc: STR_MAP_RIOT_BRIEFING}

  - type: STR_MAP_CHOPSHOP
    data:
      - alienRank: 5
        lowQty: 10
        highQty: 12
        dQty: 1
        percentageOutsideUfo: 100
        itemSets:
          - [STR_PISTOL, STR_PISTOL_CLIP, STR_PISTOL_CLIP]
    civilians: 1                   # Clutch, tied to the chair (a civilian stand-in until he is a Joe here)
    width: 40
    length: 40
    height: 2
    terrains: [CHOPSHOP]
    script: CHOPSHOP_SCRIPT
    shade: 0
    briefing: {palette: 0, title: STR_MAP_CHOPSHOP, desc: STR_MAP_CHOPSHOP_BRIEFING}

  - type: STR_MAP_JUNKYARD
    data:
      - alienRank: 5
        lowQty: 10
        highQty: 12
        dQty: 1
        percentageOutsideUfo: 100
        itemSets:
          - [STR_PISTOL, STR_PISTOL_CLIP, STR_PISTOL_CLIP]
    width: 50
    length: 50
    height: 2
    terrains: [JUNKYARD]
    script: JUNKYARD_SCRIPT
    shade: 0
    briefing: {palette: 0, title: STR_MAP_JUNKYARD, desc: STR_MAP_JUNKYARD_BRIEFING}

  - type: STR_MAP_SMALL_CITY
    data:
      - *trooper
    civilians: 16
    width: 100
    length: 100
    height: 4
    terrains: [CITYDAY]
    script: CITY_SCRIPT
    shade: 0
    briefing: {palette: 0, title: STR_MAP_SMALL_CITY, desc: STR_MAP_SMALL_CITY_BRIEFING}

  - type: STR_MAP_SMALL_CITY_TERROR
    data:
      - *trooper
    civilians: 16
    width: 100
    length: 100
    height: 4
    terrains: [CITYDAYDMG]
    script: CITY_SCRIPT
    shade: 0
    briefing: {palette: 0, title: STR_MAP_SMALL_CITY_TERROR, desc: STR_MAP_SMALL_CITY_TERROR_BRIEFING}

  - type: STR_MAP_LAB_OUTPOST
    data:
      - *trooper
    width: 100
    length: 100
    height: 5
    terrains: [LB12RING]           # the ring blocks take the mission's terrain; desert is the only ring set yet
    script: LB1_SCRIPT2
    shade: 0
    briefing: {palette: 0, title: STR_MAP_LAB_OUTPOST, desc: STR_MAP_LAB_OUTPOST_BRIEFING}

  - type: STR_MAP_BANK_ROBBERY     # the cartel arc's bank job; uses the armored-car robbery's hooks
    data:
      - alienRank: 5
        lowQty: 8
        highQty: 9
        dQty: 0
        percentageOutsideUfo: 100
        itemSets:
          - [STR_PISTOL, STR_PISTOL_CLIP, STR_BANDED_CASH]
      - alienRank: 5               # the leader in the vault: node 0
        customUnitType: STR_ROBBERY_LEADER
        lowQty: 1
        highQty: 1
        dQty: 0
        percentageOutsideUfo: 100
        itemSets:
          - [STR_PISTOL, STR_PISTOL_CLIP]
    civilians: 8                   # 4 hostages on the lobby floor, 2 tellers, the manager, the loan officer
    robberExit: [[30, 2, 0], [30, 3, 0], [31, 2, 0], [31, 3, 0], [32, 2, 0], [32, 3, 0], [29, 2, 0], [29, 3, 0]]
    robberLoot: [STR_BANDED_CASH]
    robberLeader: STR_ROBBERY_LEADER
    smartPoints:                   # BANK1_spots.json
      leaderAlive: 30
      otherAlive: 10
      noneEscaped: 20
      lootRecovered: 15
      noCivilianHurt: 30
    width: 50
    length: 40
    height: 3
    terrains: [BANK1]
    script: BANK1_SCRIPT
    shade: 0
    briefing: {palette: 0, title: STR_MAP_BANK_ROBBERY, desc: STR_MAP_BANK_ROBBERY_BRIEFING}

extraStrings:
  - type: en-US
    strings: &mapstr
      MAP_HARBOUR_T: "Harbour"
      MAP_HIJACKED_T: "Hijacked ship"
      MAP_CONTSHIP_T: "Container ship"
      MAP_FREIGHTER_T: "Freighter"
      MAP_RIOT: "The Pit cell block"
      MAP_CHOPSHOP: "Chop shop"
      MAP_JUNKYARD: "Junkyard"
      MAP_CITYDAY: "Small city"
      MAP_CITYDAYDMG: "Small city (damaged)"
      MAP_LB12RING: "Cobra lab (desert)"
      MAP_BANK1: "Millville bank"
      STR_MAP_HARBOUR: "Harbour"
      STR_MAP_HARBOUR_BRIEFING: "A freighter tied up at the quay, a warehouse, a container crane. Cobra is on the quay and aboard."
      STR_MAP_HIJACKED_SHIP: "Hijacked Ship"
      STR_MAP_HIJACKED_SHIP_BRIEFING: "Hijackers hold the crew on the bridge and in the mess. You come over the forecastle rail."
      STR_MAP_CONTAINER_SHIP: "Container Ship"
      STR_MAP_CONTAINER_SHIP_BRIEFING: "Stop and search. Twelve containers on deck; open them."
      STR_MAP_RIOT: "Riot in the Pit"
      STR_MAP_RIOT_BRIEFING: "The Cobra prisoners are out of their cells. Keep them from the weapons locker and the lift."
      STR_MAP_CHOPSHOP: "Chop Shop"
      STR_MAP_CHOPSHOP_BRIEFING: "The cartel holds Clutch in the back office of a garage. Get him out."
      STR_MAP_JUNKYARD: "Junkyard"
      STR_MAP_JUNKYARD_BRIEFING: "A fenced scrapyard full of wrecks and cartel guns."
      STR_MAP_SMALL_CITY: "Small City"
      STR_MAP_SMALL_CITY_BRIEFING: "Downtown. Cobra is in the streets."
      STR_MAP_SMALL_CITY_TERROR: "Small City (under attack)"
      STR_MAP_SMALL_CITY_TERROR_BRIEFING: "The attack is already under way when you land."
      STR_MAP_LAB_OUTPOST: "Cobra Lab"
      STR_MAP_LAB_OUTPOST_BRIEFING: "The Gen-Tek research park is a Cobra lab, crewed and armed."
      STR_MAP_BANK_ROBBERY: "Bank Robbery"
      STR_MAP_BANK_ROBBERY_BRIEFING: "Robbers hold Millville Savings & Trust. Their van is in the back alley."
  - type: en-GB
    strings: *mapstr
