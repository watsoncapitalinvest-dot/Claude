# G.I. Joe vehicle specials (BUILD-2, 17 Nov 2026; engine: Battlescape/VehicleSpecials.cpp).
# Design: VEHICLE_SPECIALS_v1 (STORY), assignments s.2 / s.2b approved by John 16 Nov 08:40 / 08:43, signatures s.3.
# Only the vehicles that exist as battle units today are listed; a new vehicle gets a line here when its unit lands.
# Every number below is a first guess (TUNING_RECORD row 57) - BUILD-2's where the design gives none.
vehicleSpecials:
  units:
    STR_GJ_VEH_VAMP: [FLANK_SPEED, SUPPRESSING_FIRE]
    STR_GJ_VEH_VAMP_MK2: [FLANK_SPEED, FULL_SALVO]
    STR_GJ_VEH_MOBAT: [HULL_DOWN, RAM, STEAMROLLER]
    STR_GJ_VEH_WOLVERINE: [FULL_SALVO]
    STR_GJ_VEH_TRIPLE_T: [HULL_DOWN, FULL_SALVO]
    STR_GJ_VEH_MAULER: [HULL_DOWN, RAM]
    STR_GJ_VEH_STINGER: [FULL_SALVO, FLANK_SPEED]
    STR_GJ_VEH_HISS: [RAM, FLANK_SPEED, SENTRY_LOCK]
    STR_GJ_VEH_FERRET: [FLANK_SPEED, JUMP]
    STR_GJ_VEH_THUNDER: [RAM, SUPPRESSING_FIRE]
  # uses per battle (anything not listed: no limit)
  uses:
    FULL_SALVO: 1
    RAM: 3
    STEAMROLLER: 1
    SMOKE_SCREEN: 2
    RADAR_SWEEP: 2
    RESUPPLY: 3
    FIELD_REPAIR: 3
    FLAME_SWEEP: 2
    SPOTTER: 3
    BRIDGE_CLEAR: 3
  # TU cost, % of the vehicle's full TU (armed specials pay for the shot they ride on; Full Salvo takes all TU)
  tu:
    RAM: 30
    JUMP: 40
    SMOKE_SCREEN: 20
    RADAR_SWEEP: 30
    RESUPPLY: 25
    FIELD_REPAIR: 40
    BRIDGE_CLEAR: 50
  hullDownArmorPct: 50      # Hull Down: front armour +50%
  suppressRadius: 1         # Suppressing Fire: the 3x3 round the aim point
  suppressMorale: 15
  salvoMax: 9               # Full Salvo: rockets at most, into the 3x3
  ramDamage: 30             # Ram: per tile of the rammer's width; it takes ramSelfPct% of what it dealt
  ramSelfPct: 25
  spotterBonus: 15          # Spotter: every shot at the marked target, this turn
  sentryBonus: 15           # Sentry Lock: its reaction shots
  sentryShots: 2
  sentryArc: 45             # half of the 90-degree arc
  smokeRadius: 3
  smokeAmount: 15
  skyWatchFactor: 2
  laserChargePct: 200
  steamrollerCoverArmor: 30 # Steamroller: knocks flat any object or wall up to this armour
  steamrollerTiles: 8
  flankSpeedPct: 100        # Flank Speed: +100% TU
  repairHP: 20
  shieldWallPenalty: 30
  radarRange: 15
  flameRange: 5
