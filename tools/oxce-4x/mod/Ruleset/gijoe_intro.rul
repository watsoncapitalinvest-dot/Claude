# Replaces the original intro movie with the mod's own title card.
cutscenes:
  - delete: intro
  - type: intro
    slideshow:
      musicId: GIJOE_THEME     # the theme starts with the studio card and runs on into the menu
      transitionSeconds: 4
      slides:
        - imagePath: Resources/Intro/watson_capital.png
        - imagePath: Resources/Intro/microdose.png        # John 22 Nov: Watson Capital, Micro Dose, the title, then the menu
        - imagePath: Resources/Intro/title_card.png      # John's logo (13 Nov): the splash before the menu
