# Strings for options and screens BUILD-1 adds to the engine.
extraStrings:
  - type: en-US
    strings: &buildstr
      STR_GJ_FAST_BATTLES: "Fast battles"
      STR_GJ_FAST_BATTLES_DESC: "Every wait in a battle - walking, turning, a fall, an explosion, the pause after a shot - at 60% of its length; rounds fly faster; the camera follows them smoothly. On by default."
      STR_GJ_TESTBED_BRIEFING: "The test range. Every Joe and every vehicle against one of every Cobra unit. Six targets along the north edge to blow up."
      MAP_TESTRANGE: "Test Range"
      # the monthly report (was X-COM's council of funding nations, "the Cobra invasion", "the Cobra visitors"; month 1 comes before
      # anyone has heard the name Cobra)
      STR_COUNCIL_IS_GENERALLY_SATISFIED: "The Joint Chiefs are satisfied with your progress so far."
      STR_COUNCIL_IS_VERY_PLEASED: "The Joint Chiefs are very pleased with your progress. Keep up the good work."
      STR_COUNCIL_IS_DISSATISFIED: "The Joint Chiefs are not satisfied with your results. Improve them, or the G.I. Joe program will be shut down."
      STR_YOU_HAVE_NOT_SUCCEEDED: "The Joint Chiefs have lost confidence in G.I. Joe. The program is shut down, the team is dispersed, and the threat is left to the regular agencies to handle as best they can."
      STR_INTERCEPTION_CRAFT: "AIRCRAFT AND TRANSPORTS"   # was X-COM's heading on the base's craft list
  - type: en-GB
    strings: *buildstr
