# Strings for options and screens BUILD-1 adds to the engine.
extraStrings:
  - type: en-US
    strings: &buildstr
      STR_GJ_FAST_BATTLES: "Fast battles"
      STR_GJ_FAST_BATTLES_DESC: "Every wait in a battle - walking, turning, a fall, an explosion, the pause after a shot - at 60% of its length; rounds fly faster; the camera follows them smoothly. On by default."
      STR_INTERCEPTION_CRAFT: "AIRCRAFT AND TRANSPORTS"   # was X-COM's heading on the base's craft list
  - type: en-GB
    strings: *buildstr
