# Strings for options and screens BUILD-1 adds to the engine.
extraStrings:
  - type: en-US
    strings: &buildstr
      STR_GJ_FAST_BATTLES: "Fast battles"
      STR_GJ_TIPS: "G.I. Joe tips"
      STR_GJ_TIPS_DESC: "A short tip the first time something new turns up in a campaign (a suspicious guard, an alarm spreading, a cartel boat ...). Each shows once. Off = no tips."
      STR_GJ_TIME_SLOW: "SLOW"
      STR_GJ_LZ_TITLE: "WHERE DO WE SET DOWN?"
      STR_GJ_LZ_HELP: "Pick the part of the map the transport lands in, laid out as you will see the battle."
      STR_GJ_LZ_PILOT: "Let the pilot choose"
      STR_GJ_LZ_TOP: "TOP"
      STR_GJ_LZ_UPPER_RIGHT: "UPPER RIGHT"
      STR_GJ_LZ_RIGHT: "RIGHT"
      STR_GJ_LZ_UPPER_LEFT: "UPPER LEFT"
      STR_GJ_LZ_CENTRE: "CENTRE"
      STR_GJ_LZ_LOWER_RIGHT: "LOWER RIGHT"
      STR_GJ_LZ_LEFT: "LEFT"
      STR_GJ_LZ_LOWER_LEFT: "LOWER LEFT"
      STR_GJ_LZ_BOTTOM: "BOTTOM"
      STR_GJ_CHOOSE_ENTRY: "CHOOSE WHERE YOU COME IN{NEWLINE}Scroll the map and click open ground: the squad and its vehicles come in there.{NEWLINE}Right-click to start where you are."
      STR_GJ_ENTRY_DONE: "Squad in position"
      STR_GJ_ENTRY_PROMPT: "Click open ground to bring the squad in there - right-click to stay"
      STR_GJ_ENTRY_KEPT: "Starting at the transport"
      STR_GJ_ENTRY_NO_ROOM: "No room for the whole squad there - pick more open ground"
      STR_GJ_TIME_DAY: "1 DAY"
      STR_COBRA_CELL_SITE_: "COBRA CELL"         # placeholder: the cell site briefing title (STORY to word)
      STR_WEAPONS_CREW_HWPS: "GUNS / MEN / VEH"   # one line: the two-line header ran into itself on the tablet (John screen 202)
      STR_GJ_DF_STANDOFF: "STAND OFF"
      STR_GJ_DF_CAUTIOUS: "CAUTIOUS"
      STR_GJ_DF_STANDARD: "STANDARD"
      STR_GJ_DF_AGGRESSIVE: "ATTACK"
      STR_GJ_DF_DISENGAGE: "BREAK OFF"
      STR_GJ_DF_LOOK: "LOOK"
      STR_GJ_SIGHTINGS: "Unidentified aircraft over {REGION}: {NOW} this month, {LAST} last month."
      # Screen titles: X-COM leftovers replaced so the menus say what the tablet brief says (John, 19 Nov)
      STR_PHYSICAL_TRAINING: "TRAINING"
      STR_REMAINING_TRAINING_FACILITY_CAPACITY: "TRAINING PLACES LEFT> {ALT}{0}"
      STR_INTERNATIONAL_RELATIONS: "FUNDING"
      STR_GJ_TIME_STEADY: "STEADY"
      STR_GJ_TIME_GO: "GO"
      # continue or exfiltrate (John 16 Nov 00:19; his words for the title). Button labels are BUILD's; STORY may reword.
      STR_GJ_SECURE_TITLE: "ALL TARGETS NEUTRALIZED"
      # regional readiness (STEALTH SIGHT item 14) - BUILD-1 placeholders for STORY
      STR_COBRA_READINESS_UP: "Cobra is on edge in {0}: more men on duty, fewer asleep, quicker to suspect."
      STR_COBRA_READINESS_DOWN: "Cobra in {0} is settling down."
      STR_GJ_SECURE_ASK: "Search the area for what Cobra left behind, or pull out now? Either way it counts as a win. If you stay, END MISSION takes the squad home when you are done."
      STR_GJ_SECURE_CONTINUE: "SEARCH THE AREA"
      STR_GJ_SECURE_EXFILTRATE: "EXFILTRATE"
      STR_GJ_FAST_BATTLES_DESC: "Every wait in a battle - walking, turning, a fall, an explosion, the pause after a shot - at 60% of its length; rounds fly faster; the camera follows them smoothly. On by default."
      STR_GJ_TESTBED_BRIEFING: "The test range. Every Joe and every vehicle against one of every Cobra unit. Six targets along the north edge to blow up."
      MAP_TESTRANGE: "Test Range"
      # the monthly report (was X-COM's council of funding nations, "the Cobra invasion", "the Cobra visitors"; month 1 comes before
      # anyone has heard the name Cobra)
      STR_COUNCIL_IS_GENERALLY_SATISFIED: "The Joint Chiefs are satisfied with your progress so far."
      STR_COUNCIL_IS_VERY_PLEASED: "The Joint Chiefs are very pleased with your progress. Keep up the good work."
      STR_COUNCIL_IS_DISSATISFIED: "The Joint Chiefs are not satisfied with your results. Improve them, or the G.I. Joe program will be shut down."
      STR_YOU_HAVE_NOT_SUCCEEDED: "The Joint Chiefs have lost confidence in G.I. Joe. The program is shut down, the team is dispersed, and the threat is left to the regular agencies to handle as best they can."
      STR_COBRA_SITE_DESTROYED: "Cobra site destroyed"     # the debrief title at any Cobra site but the Drome (was "Terror Drome destroyed" everywhere)
      STR_COBRA_SITE_STILL_INTACT: "Cobra site still standing"
      STR_SMALL_ROCKET: "RPG-7 Rocket"    # the RPG-7's round; was X-COM's "Small Rocket" (on the re-equip list after the ranch)
      # PLACEHOLDER for STORY (John 18 Nov "later fallback"): the robbery that comes without Scarlett's tip. STORY's own text with
      # the courier line swapped; BriefingState uses it while STR_INFORMANT_TIP is not researched.
      STR_INTERCEPTION_CRAFT: "AIRCRAFT AND TRANSPORTS"   # was X-COM's heading on the base's craft list
  - type: en-GB
    strings: *buildstr
