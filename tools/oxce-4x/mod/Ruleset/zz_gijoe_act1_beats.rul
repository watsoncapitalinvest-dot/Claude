# ACT 1, DAYS 50-90: THREE TEASE BEATS (BRIEF_FOR_BUILD_Act1_Day50to90_Answers, DESIGN with John, 24 Nov).
# Cobra behind the cartel: Cobra is a clue here, never a mission label. Fixed order a -> b -> c, brought onto the map by
# the pacing rail (pacingPull in zz_gijoe_act1_layer.rul) after 7 idle days. All words are BUILD placeholders for STORY.
#
#   a SOMEONE GOT THERE FIRST - a cartel safehouse (FARM1), the cartel men already dead (engine gjFoundDead), unfamiliar
#     casings lying on one of the bodies (gjPlantItems). No enemies, no shooting: search, pick up, leave.
#   b THE BOARDED BOAT - a cartel boat (FREIGHTER_T). The crew starts quiet (quietUntilAlarm): slip in and take the
#     stencilled crate from the hold, or fight. The crate is a clue item: it comes home carried, on any result.
#   c THE DARK-KIT BANK JOB - "cartel" men in matching dark kit who fight better than cartel and carry no ID (BANK1).
#     A guaranteed fight. What they leave is the BODY (their corpse is STR_UNIDENTIFIED_BODY); no research opens from
#     it before its month (Year 1 research map).
#
# Missed once (expired, lost or pulled out of): it comes back about 10 days later, harder. Missed twice: gone; the chain
# moves on. Done or finally lost, beat c sets the broadcast a few days later (cobraNetwork broadcastAfterResearch).
#
# STAND-INS:
#   - b's boat is a site on land in North America (spawnZone 9, like the safehouse). The brief wants a scripted boat
#     on the sea lanes; that needs a sea site and is NOT built.
#   - the dark-kit men wear the Cobra trooper's sheet. If the sheet shows a Cobra badge, it gives the game away early.

items:
  - type: STR_UNFAMILIAR_CASINGS
    size: 0.1
    weight: 1
    bigSprite: 100
    floorSprite: 100
    invWidth: 1
    invHeight: 1
    recover: true
    battleType: 0
    costSell: 0
  - type: STR_STENCILLED_CRATE
    size: 0.1
    weight: 4
    bigSprite: 100
    floorSprite: 100
    invWidth: 1
    invHeight: 1
    recover: true
    battleType: 0
    costSell: 0
  - type: STR_UNIDENTIFIED_BODY     # the dark-kit men's corpse: recovered, stored, NOT researchable yet
    name: STR_UNIDENTIFIED_BODY
    weight: 22
    bigSprite: 65
    floorSprite: 85
    invWidth: 2
    invHeight: 3
    battleType: 11
    recover: true
    costSell: 0

armors:
  - type: GJ_UNKNOWN_CREW_ARMOR
    drawingRoutine: 23
    deathFrames: 8
    spriteSheet: GIJOE_COBRA_SOLDIER_BODY_HD.PCK   # STAND-IN: the Cobra trooper's sheet
    corpseBattle: [STR_UNIDENTIFIED_BODY]
    frontArmor: 10
    sideArmor: 8
    rearArmor: 5
    underArmor: 2
    loftempsSet: [ 3 ]

units:
  - type: STR_GJ_UNKNOWN_GUNMAN
    race: STR_GJ_UNKNOWN_CREW
    rank: STR_LIVE_SOLDIER
    stats:                          # better than cartel (firing 26) and the trooper (28): trained men
      tu: 54
      stamina: 60
      health: 24
      bravery: 50
      reactions: 40
      firing: 40
      throwing: 35
      strength: 30
      psiStrength: 40
      psiSkill: 0
      melee: 35
    armor: GJ_UNKNOWN_CREW_ARMOR
    standHeight: 22
    kneelHeight: 14
    value: 12
    deathSound: 41
    intelligence: 3
    aggression: 1

alienRaces:
  - id: STR_GJ_UNKNOWN_CREW
    members: [STR_GJ_UNKNOWN_GUNMAN, STR_GJ_UNKNOWN_GUNMAN, STR_GJ_UNKNOWN_GUNMAN, STR_GJ_UNKNOWN_GUNMAN,
              STR_GJ_UNKNOWN_GUNMAN, STR_GJ_UNKNOWN_GUNMAN, STR_GJ_UNKNOWN_GUNMAN, STR_GJ_UNKNOWN_GUNMAN]

alienDeployments:
  # ---- a: someone got there first ----
  - type: STR_GJ_BEAT_A
    race: STR_CARTEL
    gjFoundDead: true
    gjPlantItems: [STR_UNFAMILIAR_CASINGS]
    data:
      - alienRank: 5
        lowQty: 5
        highQty: 6
        dQty: 0
        percentageOutsideUfo: 100
        itemSets:
          - [STR_PISTOL, STR_PISTOL_CLIP]
    civilians: 0
    width: 50
    length: 40
    height: 3
    terrains: [FARM1]
    script: FARM1_SCRIPT
    shade: 12
    duration: [96, 120]
    markerName: STR_GJ_BEAT_A_SITE
    markerIcon: 22
    unlockedResearch: STR_GJ_BEAT_A_DONE
    unlockedResearchOnFailure: STR_GJ_BEAT_A_MISSED
    unlockedResearchOnDespawn: STR_GJ_BEAT_A_MISSED
    alert: STR_GJ_BEAT_A_ALERT
    briefing: {palette: 0, title: STR_GJ_BEAT_A_TITLE, desc: STR_GJ_BEAT_A_BRIEFING}
  - type: STR_GJ_BEAT_A_RETURN      # 10 days on: the men who did it are back to clean up
    race: STR_GJ_UNKNOWN_CREW
    gjPlantItems: [STR_UNFAMILIAR_CASINGS]
    data:
      - alienRank: 5
        lowQty: 3
        highQty: 4
        dQty: 1
        percentageOutsideUfo: 100
        itemSets:
          - [STR_PISTOL, STR_PISTOL_CLIP, STR_PISTOL_CLIP]
    width: 50
    length: 40
    height: 3
    terrains: [FARM1]
    script: FARM1_SCRIPT
    shade: 12
    duration: [72, 96]
    markerName: STR_GJ_BEAT_A_SITE
    markerIcon: 22
    unlockedResearch: STR_GJ_BEAT_A_DONE
    unlockedResearchOnFailure: STR_GJ_BEAT_A_LOST
    unlockedResearchOnDespawn: STR_GJ_BEAT_A_LOST
    alert: STR_GJ_BEAT_A_RETURN_ALERT
    briefing: {palette: 0, title: STR_GJ_BEAT_A_TITLE, desc: STR_GJ_BEAT_A_RETURN_BRIEFING}

  # ---- b: the boarded boat ----
  - type: STR_GJ_BEAT_B
    race: STR_CARTEL
    quietUntilAlarm: true
    gjPlantItems: [STR_STENCILLED_CRATE]
    data:
      - alienRank: 5
        lowQty: 3
        highQty: 4
        dQty: 1
        percentageOutsideUfo: 100
        itemSets:
          - [STR_PISTOL, STR_PISTOL_CLIP, STR_PISTOL_CLIP]
    width: 60
    length: 20
    height: 8
    terrains: [FREIGHTER_T]
    script: FREIGHTER_SCRIPT
    shade: 10
    duration: [48, 72]
    markerName: STR_GJ_BEAT_B_SITE
    markerIcon: 22
    unlockedResearch: STR_GJ_BEAT_B_DONE
    unlockedResearchOnFailure: STR_GJ_BEAT_B_MISSED
    unlockedResearchOnDespawn: STR_GJ_BEAT_B_MISSED
    alert: STR_GJ_BEAT_B_ALERT
    briefing: {palette: 0, title: STR_GJ_BEAT_B_TITLE, desc: STR_GJ_BEAT_B_BRIEFING}
  - type: STR_GJ_BEAT_B_RETURN
    race: STR_CARTEL
    quietUntilAlarm: true
    gjPlantItems: [STR_STENCILLED_CRATE]
    data:
      - alienRank: 5
        lowQty: 6
        highQty: 7
        dQty: 1
        percentageOutsideUfo: 100
        itemSets:
          - [STR_PISTOL, STR_PISTOL_CLIP, STR_PISTOL_CLIP]
          - [STR_RIFLE, STR_RIFLE_CLIP, STR_RIFLE_CLIP]
    width: 60
    length: 20
    height: 8
    terrains: [FREIGHTER_T]
    script: FREIGHTER_SCRIPT
    shade: 10
    duration: [36, 48]
    markerName: STR_GJ_BEAT_B_SITE
    markerIcon: 22
    unlockedResearch: STR_GJ_BEAT_B_DONE
    unlockedResearchOnFailure: STR_GJ_BEAT_B_LOST
    unlockedResearchOnDespawn: STR_GJ_BEAT_B_LOST
    alert: STR_GJ_BEAT_B_RETURN_ALERT
    briefing: {palette: 0, title: STR_GJ_BEAT_B_TITLE, desc: STR_GJ_BEAT_B_RETURN_BRIEFING}

  # ---- c: the dark-kit bank job ----
  - type: STR_GJ_BEAT_C
    race: STR_GJ_UNKNOWN_CREW
    data:
      - alienRank: 5
        lowQty: 5
        highQty: 6
        dQty: 1
        percentageOutsideUfo: 100
        itemSets:
          - [STR_PISTOL, STR_PISTOL_CLIP, STR_PISTOL_CLIP]
    civilians: 8
    width: 50
    length: 40
    height: 3
    terrains: [BANK1]
    script: BANK1_SCRIPT
    shade: 0
    duration: [12, 24]
    markerName: STR_GJ_BEAT_C_SITE
    markerIcon: 22
    unlockedResearch: STR_GJ_BEAT_C_DONE
    unlockedResearchOnFailure: STR_GJ_BEAT_C_MISSED
    unlockedResearchOnDespawn: STR_GJ_BEAT_C_MISSED
    alert: STR_GJ_BEAT_C_ALERT
    briefing: {palette: 0, title: STR_GJ_BEAT_C_TITLE, desc: STR_GJ_BEAT_C_BRIEFING}
  - type: STR_GJ_BEAT_C_RETURN
    race: STR_GJ_UNKNOWN_CREW
    data:
      - alienRank: 5
        lowQty: 7
        highQty: 8
        dQty: 1
        percentageOutsideUfo: 100
        itemSets:
          - [STR_PISTOL, STR_PISTOL_CLIP, STR_PISTOL_CLIP]   # months 1-3 are handguns: harder = more of them
    civilians: 8
    width: 50
    length: 40
    height: 3
    terrains: [BANK1]
    script: BANK1_SCRIPT
    shade: 0
    duration: [12, 24]
    markerName: STR_GJ_BEAT_C_SITE
    markerIcon: 22
    unlockedResearch: STR_GJ_BEAT_C_DONE
    unlockedResearchOnFailure: STR_GJ_BEAT_C_LOST
    unlockedResearchOnDespawn: STR_GJ_BEAT_C_LOST
    alert: STR_GJ_BEAT_C_RETURN_ALERT
    briefing: {palette: 0, title: STR_GJ_BEAT_C_TITLE, desc: STR_GJ_BEAT_C_RETURN_BRIEFING}

alienMissions:
  - type: STR_GJ_BEAT_A_MISSION
    points: 0
    objective: 3
    spawnZone: 9
    raceWeights: {0: {STR_COBRA: 100}}
    waves: [{ufo: STR_GJ_BEAT_A, count: 1, trajectory: P0, timer: 60, objective: true}]
  - type: STR_GJ_BEAT_A_RETURN_MISSION
    points: 0
    objective: 3
    spawnZone: 9
    raceWeights: {0: {STR_COBRA: 100}}
    waves: [{ufo: STR_GJ_BEAT_A_RETURN, count: 1, trajectory: P0, timer: 60, objective: true}]
  - type: STR_GJ_BEAT_B_MISSION
    points: 0
    objective: 3
    spawnZone: 9
    raceWeights: {0: {STR_COBRA: 100}}
    waves: [{ufo: STR_GJ_BEAT_B, count: 1, trajectory: P0, timer: 60, objective: true}]
  - type: STR_GJ_BEAT_B_RETURN_MISSION
    points: 0
    objective: 3
    spawnZone: 9
    raceWeights: {0: {STR_COBRA: 100}}
    waves: [{ufo: STR_GJ_BEAT_B_RETURN, count: 1, trajectory: P0, timer: 60, objective: true}]
  - type: STR_GJ_BEAT_C_MISSION
    points: 0
    objective: 3
    spawnZone: 9
    raceWeights: {0: {STR_COBRA: 100}}
    waves: [{ufo: STR_GJ_BEAT_C, count: 1, trajectory: P0, timer: 60, objective: true}]
  - type: STR_GJ_BEAT_C_RETURN_MISSION
    points: 0
    objective: 3
    spawnZone: 9
    raceWeights: {0: {STR_COBRA: 100}}
    waves: [{ufo: STR_GJ_BEAT_C_RETURN, count: 1, trajectory: P0, timer: 60, objective: true}]

# The first showing is brought by the pacing rail (never by a monthly roll); the return comes by event, 10 days after
# the miss. Each script runs once.
adhocScripts:
  - type: gjBeatA
    adhocMissionScriptTags: [gjBeatANever]   # nothing fires this tag: only the pacing rail runs it
    maxRuns: 1
    varName: gjBeatA
    executionOdds: 100
    missionWeights: {0: {STR_GJ_BEAT_A_MISSION: 100}}
    regionWeights: {0: {STR_NORTH_AMERICA: 100}}
  - type: gjBeatB
    adhocMissionScriptTags: [gjBeatBNever]   # nothing fires this tag: only the pacing rail runs it
    maxRuns: 1
    varName: gjBeatB
    executionOdds: 100
    missionWeights: {0: {STR_GJ_BEAT_B_MISSION: 100}}
    regionWeights: {0: {STR_NORTH_AMERICA: 100}}
  - type: gjBeatC
    adhocMissionScriptTags: [gjBeatCNever]   # nothing fires this tag: only the pacing rail runs it
    maxRuns: 1
    varName: gjBeatC
    executionOdds: 100
    missionWeights: {0: {STR_GJ_BEAT_C_MISSION: 100}}
    regionWeights: {0: {STR_NORTH_AMERICA: 100}}
  - type: gjBeatAReturn
    adhocMissionScriptTags: [gjBeatAReturn]
    maxRuns: 1
    varName: gjBeatAReturn
    executionOdds: 100
    missionWeights: {0: {STR_GJ_BEAT_A_RETURN_MISSION: 100}}
    regionWeights: {0: {STR_NORTH_AMERICA: 100}}
  - type: gjBeatBReturn
    adhocMissionScriptTags: [gjBeatBReturn]
    maxRuns: 1
    varName: gjBeatBReturn
    executionOdds: 100
    missionWeights: {0: {STR_GJ_BEAT_B_RETURN_MISSION: 100}}
    regionWeights: {0: {STR_NORTH_AMERICA: 100}}
  - type: gjBeatCReturn
    adhocMissionScriptTags: [gjBeatCReturn]
    maxRuns: 1
    varName: gjBeatCReturn
    executionOdds: 100
    missionWeights: {0: {STR_GJ_BEAT_C_RETURN_MISSION: 100}}
    regionWeights: {0: {STR_NORTH_AMERICA: 100}}

events:
  - name: STR_EVENT_GJ_BEAT_A_RETURN
    description: STR_EVENT_GJ_BEAT_A_RETURN_DESCRIPTION
    adhocMissionScriptTags: [gjBeatAReturn]
    timer: 14400                    # 10 days after the miss
  - name: STR_EVENT_GJ_BEAT_B_RETURN
    description: STR_EVENT_GJ_BEAT_B_RETURN_DESCRIPTION
    adhocMissionScriptTags: [gjBeatBReturn]
    timer: 14400
  - name: STR_EVENT_GJ_BEAT_C_RETURN
    description: STR_EVENT_GJ_BEAT_C_RETURN_DESCRIPTION
    adhocMissionScriptTags: [gjBeatCReturn]
    timer: 14400

research:
  # outcome markers: granted by the missions, never researched by hand
  - {name: STR_GJ_BEAT_A_DONE, cost: 1, points: 0, dependencies: [STR_STORY_LOCK]}
  - {name: STR_GJ_BEAT_A_MISSED, cost: 1, points: 0, dependencies: [STR_STORY_LOCK], spawnedEvent: STR_EVENT_GJ_BEAT_A_RETURN}
  - {name: STR_GJ_BEAT_A_LOST, cost: 1, points: 0, dependencies: [STR_STORY_LOCK]}
  - {name: STR_GJ_BEAT_B_DONE, cost: 1, points: 0, dependencies: [STR_STORY_LOCK]}
  - {name: STR_GJ_BEAT_B_MISSED, cost: 1, points: 0, dependencies: [STR_STORY_LOCK], spawnedEvent: STR_EVENT_GJ_BEAT_B_RETURN}
  - {name: STR_GJ_BEAT_B_LOST, cost: 1, points: 0, dependencies: [STR_STORY_LOCK]}
  - {name: STR_GJ_BEAT_C_DONE, cost: 1, points: 0, dependencies: [STR_STORY_LOCK]}
  - {name: STR_GJ_BEAT_C_MISSED, cost: 1, points: 0, dependencies: [STR_STORY_LOCK], spawnedEvent: STR_EVENT_GJ_BEAT_C_RETURN}
  - {name: STR_GJ_BEAT_C_LOST, cost: 1, points: 0, dependencies: [STR_STORY_LOCK]}
  # the clues
  - name: STR_UNFAMILIAR_CASINGS    # a: opens research (placeholder; STORY says what it leads to)
    lane: ARMORY
    cost: 30
    points: 10
    needItem: true
    destroyItem: true
  - name: STR_STENCILLED_CRATE      # b: opens the stencil lead, as the ranch's stencil does
    lane: INTEL
    cost: 30
    points: 10
    needItem: true
    destroyItem: true
    unlocks: [STR_WHO_IS_COBRA]

extraStrings:
  - type: en-US
    strings:
      STR_UNFAMILIAR_CASINGS: "Unfamiliar Casings"
      STR_STENCILLED_CRATE: "Stencilled Crate"
      STR_UNIDENTIFIED_BODY: "Unidentified Body"
      STR_GJ_UNKNOWN_GUNMAN: "Unknown Gunman"
      STR_GJ_UNKNOWN_CREW: "Unknown"
      STR_GJ_BEAT_A_SITE: "Cartel safehouse - gone quiet"
      STR_GJ_BEAT_A_MISSION: "Cartel safehouse - gone quiet"
      STR_GJ_BEAT_A_RETURN_MISSION: "Cartel safehouse - someone's back"
      STR_GJ_BEAT_A_TITLE: "SOMEONE GOT THERE FIRST"
      STR_GJ_BEAT_A_ALERT: "An informant says a cartel safehouse has gone silent. Nobody in, nobody out for two days."
      STR_GJ_BEAT_A_BRIEFING: "[PLACEHOLDER] The cartel crew at this farm stopped answering. Go in, find out why, and bring back anything that doesn't belong. Search the bodies."
      STR_GJ_BEAT_A_RETURN_ALERT: "Lights at the silent safehouse. Somebody has come back for something."
      STR_GJ_BEAT_A_RETURN_BRIEFING: "[PLACEHOLDER] The men who hit the cartel's safehouse are back, cleaning up. They are not cartel. Take what they missed before they finish."
      STR_GJ_BEAT_B_SITE: "Cartel boat"
      STR_GJ_BEAT_B_MISSION: "Cartel boat"
      STR_GJ_BEAT_B_RETURN_MISSION: "Cartel boat - second run"
      STR_GJ_BEAT_B_TITLE: "THE BOARDED BOAT"
      STR_GJ_BEAT_B_ALERT: "A cartel boat is tied up and loading at night. Our man says the crates aren't drugs."
      STR_GJ_BEAT_B_BRIEFING: "[PLACEHOLDER] Get aboard and get a look in the hold. The crew hasn't been warned: go quiet and take a crate, or take the boat. Either way, bring a crate home."
      STR_GJ_BEAT_B_RETURN_ALERT: "The same boat is loading again, with more guns on deck this time."
      STR_GJ_BEAT_B_RETURN_BRIEFING: "[PLACEHOLDER] The boat is back and so is the cargo, with twice the crew. One crate is all we need."
      STR_GJ_BEAT_C_SITE: "Bank robbery"
      STR_GJ_BEAT_C_MISSION: "Bank robbery"
      STR_GJ_BEAT_C_RETURN_MISSION: "Bank robbery - second job"
      STR_GJ_BEAT_C_TITLE: "THE DARK-KIT BANK JOB"
      STR_GJ_BEAT_C_ALERT: "Police scanner: armed robbery in progress. Witnesses say the cartel - but they all wore the same dark gear."
      STR_GJ_BEAT_C_BRIEFING: "[PLACEHOLDER] A crew calling itself cartel is holding a bank. Cartel men don't move like this. Stop them, and bring back one of them if you can."
      STR_GJ_BEAT_C_RETURN_ALERT: "Police scanner: the dark-kit crew has hit another bank, more of them this time."
      STR_GJ_BEAT_C_RETURN_BRIEFING: "[PLACEHOLDER] The same crew, bigger and bolder. They will not get a third."
      STR_EVENT_GJ_BEAT_A_RETURN: "THE SAFEHOUSE"
      STR_EVENT_GJ_BEAT_A_RETURN_DESCRIPTION: "[PLACEHOLDER] Someone has gone back to the dead safehouse."
      STR_EVENT_GJ_BEAT_B_RETURN: "THE BOAT"
      STR_EVENT_GJ_BEAT_B_RETURN_DESCRIPTION: "[PLACEHOLDER] The cartel boat is loading again."
      STR_EVENT_GJ_BEAT_C_RETURN: "THE DARK-KIT CREW"
      STR_EVENT_GJ_BEAT_C_RETURN_DESCRIPTION: "[PLACEHOLDER] The crew in dark kit is working again."
      STR_GJ_BEAT_A_DONE: "The silent safehouse"
      STR_GJ_BEAT_A_MISSED: "The silent safehouse, missed"
      STR_GJ_BEAT_A_LOST: "The silent safehouse, lost"
      STR_GJ_BEAT_B_DONE: "The boarded boat"
      STR_GJ_BEAT_B_MISSED: "The boarded boat, missed"
      STR_GJ_BEAT_B_LOST: "The boarded boat, lost"
      STR_GJ_BEAT_C_DONE: "The dark-kit crew"
      STR_GJ_BEAT_C_MISSED: "The dark-kit crew, missed"
      STR_GJ_BEAT_C_LOST: "The dark-kit crew, lost"
