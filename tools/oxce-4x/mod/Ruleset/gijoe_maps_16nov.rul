# MAPS' 16 Nov maps (BRIEF_FOR_BUILD_MAPS_16Nov_Bundle): the Joe HQ airfield v2 and the Tactical Battle Platform v8.
# Both are the raid maps of their outposts (gijoe_outposts.rul) and are listed in New Battle.
# Node ranks: 1 Joe start, 2 Cobra. NOT built from their briefs: the laser fence switching off with the grid panel
# (laser_* is a 255-armour wall for now), a crewable devastation cannon / particle beam gun, the firing slots (untested),
# the TTBP's free-placement modules (on John's hold list).

terrains:
  - name: HQAIR_T                  # BRIEF_FOR_BUILD_HQAirfield v2: 64 x 56 x 6, .MAP2, 302 parts
    mapDataSets: [BLANKS, HQKIT, TTBPKIT, SHIPKIT]
    mapBlocks:
      - {name: HQAIR, width: 70, length: 60, height: 6}   # padded from 64 x 56 by build/pad_map2.py
  - name: TTBP_T                   # BRIEF_FOR_BUILD_TTBP v8: 30 x 30 x 8, .MAP2, 144 parts
    mapDataSets: [BLANKS, TTBPKIT, SHIPKIT]
    mapBlocks:
      - {name: TTBP, width: 30, length: 30, height: 8}

mapScripts:
  - type: HQAIR_SCRIPT
    commands:
      - type: addBlock
        size: [7, 6]
        rects:
          - [0, 0, 7, 6]
        blocks: [0]
  - type: TTBP_SCRIPT
    commands:
      - type: addBlock
        size: [3, 3]
        rects:
          - [0, 0, 3, 3]
        blocks: [0]
