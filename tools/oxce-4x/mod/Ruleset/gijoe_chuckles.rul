# Chuckles: built from the action figure. Sprites come from the rigged model (CHARS.chuckles in
# rig.html); the equipment-screen figure is the figure photograph itself.
extraSprites:
  - type: GIJOE_CHUCKLES_HD.PCK
    width: 2048
    height: 2880
    subX: 128
    subY: 160
    files:
      0: Resources/Units/chuckles.png
  - type: GIJOE_CHUCKLES_INV.SPK
    singleImage: true
    width: 320
    height: 200
    files:
      0: Resources/Inventory/chuckles_inv.png

armors:
  - type: STR_CHUCKLES_UC
    spriteSheet: GIJOE_CHUCKLES_HD.PCK
    spriteInv: GIJOE_CHUCKLES_INV
    corpseBattle: [STR_CORPSE_DUKE]
    frontArmor: 10
    sideArmor: 8
    rearArmor: 5
    underArmor: 2
    loftempsSet: [ 3 ]

soldiers:
  - type: STR_CHUCKLES
    costBuy: 0   # pulled from the hire list 12 Nov (John: out until he is tightened up). Was 40000.
    costSalary: 20000
    minStats:
      tu: 54
      stamina: 44
      health: 24
      bravery: 20
      reactions: 42
      firing: 44
      throwing: 46
      strength: 18
      psiStrength: 0
      psiSkill: 0
      melee: 28
    maxStats:
      tu: 66
      stamina: 74
      health: 38
      bravery: 70
      reactions: 74
      firing: 68
      throwing: 72
      strength: 36
      psiStrength: 100
      psiSkill: 16
      melee: 52
    statCaps:
      tu: 84
      stamina: 100
      health: 58
      bravery: 100
      reactions: 120
      firing: 110
      throwing: 110
      strength: 66
      psiStrength: 100
      psiSkill: 100
      melee: 120
    armor: STR_CHUCKLES_UC
    standHeight: 22
    kneelHeight: 14
    femaleFrequency: 0
    soldierNames:
      - delete
      - Resources/Names/Chuckles.nam
    deathMale: [41, 42, 43]
    deathFemale: [44, 45, 46]

extraStrings:
