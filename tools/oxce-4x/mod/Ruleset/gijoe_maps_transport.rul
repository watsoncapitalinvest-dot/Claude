# TRANSPORT (MAPS' transport.zip, BRIEF_FOR_BUILD_Transport_Riot.txt): a country road, a Joe A.P.C. and
# its V.A.M.P. escort, Cobra coming out of the brush from two corners. 50 x 40 x 2.
# Used now for a truck transfer ambushed on the road (John 13 Nov): win and it drives on, lose and
# Cobra takes the load. The prisoner transport to the authorities (capture, Part 1b) uses it too, later.
terrains:
  - name: TRANSPORT
    mapDataSets:
      - BLANKS
      - RFARM
      - JROAD
      - TRANS
    mapBlocks:
      - name: TRANSPORT
        width: 50
        length: 40
        height: 2

mapScripts:
  - type: TRANSPORT_SCRIPT
    commands:
      - type: addBlock
        size: [5, 4]

alienDeployments:
  - type: STR_CONVOY_AMBUSHED
    data:
      - alienRank: 5
        lowQty: 6
        highQty: 8
        dQty: 1
        percentageOutsideUfo: 100
        itemSets:
          - [STR_PISTOL, STR_PISTOL_CLIP, STR_PISTOL_CLIP]
          - [STR_RIFLE, STR_RIFLE_CLIP, STR_RIFLE_CLIP]
          - [STR_RIFLE, STR_RIFLE_CLIP, STR_RIFLE_CLIP]
    width: 50
    length: 40
    height: 2
    terrains: [TRANSPORT]
    script: TRANSPORT_SCRIPT
    shade: 0
    duration: [48, 48]
    markerName: STR_CONVOY_AMBUSHED_SITE
    markerIcon: 22
    alert: STR_CONVOY_AMBUSHED_ALERT
    briefingData:
      palette: 0
      title: STR_CONVOY_AMBUSHED

alienMissions:
  - type: STR_CONVOY_AMBUSH
    points: 0
    objective: 3
    raceWeights:
      0:
        STR_COBRA: 100
    waves:
      - ufo: STR_CONVOY_AMBUSHED
        count: 1
        trajectory: P0
        timer: 60
        objective: true

extraStrings:
  - type: en-US
    strings: &convoystr
      STR_CONVOY_AMBUSHED: "Convoy Ambushed"
      STR_CONVOY_AMBUSHED_SITE: "Ambushed truck transfer"
      STR_CONVOY_AMBUSHED_ALERT: "Cobra has ambushed a truck transfer on the road. Get there before they take the load."
  - type: en-GB
    strings: *convoystr
