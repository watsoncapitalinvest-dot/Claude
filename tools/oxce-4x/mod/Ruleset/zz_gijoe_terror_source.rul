# ONE SOURCE FOR TERROR ATTACKS: THE TERROR DROME.
#
# John: "Should be one source. The terror drone. Terror attacks should be
# cheap and maybe they gain cobra money and influence 1 a month sounds
# good. 3 a month left alone."
#
# Before this file there were TWO sources pulling against each other:
#
#   vanilla's recurringTerror   a mission script on its own schedule, with
#                               startDelay 150 so it lands about month 5
#                               whether or not Cobra owns a single Drome
#   the Terror Drome            genMission at a daily percentage per Drome
#
# Having both makes the Drome's contribution invisible noise on top of a
# fixed schedule - flatten every Cobra site and the attacks keep coming,
# which reads as the economy not mattering. So vanilla's script goes.
missionScripts:
  - delete: recurringTerror

# AND THE DROME HAS TO BE AFFORDABLE, or one source means NO source.
#
# At 900 funds the Drome was the second most expensive site Cobra can build.
# Across a 400-day run it wanted one from month 11 and never bought it - the
# planner kept spending on cheaper things - so Cobra reached month 14 with no
# Drome at all. With vanilla's script deleted that would be zero terror
# attacks in the whole first year, against a calendar that wants the first
# ones at months 4 to 8.
#
# 450 puts it level with the broadcast station and below the factory, so it
# lands inside the window Cobra can actually reach early. Raise it again once
# the first-attack timing has been watched in a real run - this number is
# aimed at the calendar, not measured against it yet.
cobraSites:
  - type: STR_COBRA_TERROR_DROME
    buildCostFunds: 450

# RATE. genMissionFreq is a DAILY percentage, so the monthly count is
# roughly freq x 30 / 100 per Drome:
#
#   freq 3  ->  0.9 attacks a month per Drome   = John's "1 a month"
#   freq 4  ->  1.2                               (what shipped)
#
# "3 a month left alone" then needs no new mechanism: it is three Dromes.
# Leaving Cobra unmolested is exactly how it accumulates them, and the
# per-site genMission already scales with how many it owns.
alienDeployments:
  - type: STR_COBRA_TERROR_DROME_SITE
    genMissionFreq: 3
