# CONVOY RAID, mission 3 (MAPS' convoy_m3, 13 Nov 2026): two Cobra semis stopped on a spike strip,
# I-10 in the West Texas desert. Map, terrains and routes: MAPS (Reference\BRIEF_FOR_BUILD_convoy_m3.txt).
# Mission wiring: BUILD. Terrain order matters: BLANKS, JDESERT, JROAD, CSEMI (BOXTRUCK is shipped for
# the box-truck convoys and unused here). Ground is level 1; the wash and culvert are level 0.
terrains:
  - name: M3CONVOY
    mapDataSets:
      - BLANKS
      - JDESERT
      - JROAD
      - CSEMI
    mapBlocks:
      - name: M3CONVOY
        width: 50
        length: 40
        height: 4
        groups: [0]
        # Cargo in the trailers (crate cells, ground = z 1). Guns and ammo in four stacks, and the
        # evidence: a serial plate and the Cobra stencil off the crates, a shipping manifest in
        # each cab's lockbox. All of it counts for leads when it comes home (gijoe_leads.rul).
        randomizedItems:
          - position: [6, 25, 1]
            amount: 2
            mixed: true
            itemList: [STR_PISTOL, STR_PISTOL_CLIP, STR_RIFLE, STR_RIFLE_CLIP]
          - position: [11, 26, 1]
            amount: 2
            mixed: true
            itemList: [STR_PISTOL_CLIP, STR_RIFLE_CLIP, STR_GRENADE]
          - position: [24, 25, 1]
            amount: 2
            mixed: true
            itemList: [STR_PISTOL, STR_PISTOL_CLIP, STR_RIFLE, STR_RIFLE_CLIP]
          - position: [29, 26, 1]
            amount: 2
            mixed: true
            itemList: [STR_RIFLE_CLIP, STR_PISTOL_CLIP, STR_GRENADE]
        items:
          STR_CRATE_SERIAL_PLATE:
            - [9, 25, 1]
          STR_COBRA_STENCIL:
            - [27, 26, 1]
          STR_SHIPPING_MANIFEST:
            - [17, 25, 1]
            - [35, 25, 1]
mapScripts:
  - type: M3CONVOY_SCRIPT
    commands:
      - type: addBlock
        size: [5, 4]
        groups: [0]
        rects:
          - [0, 0, 5, 4]

# The battle. Months 1-3 calendar: Cobra Troopers with handguns (rank 5 is the only rank the
# calendar lets out this early). Two drivers, four guards, an officer, a lookout. Turn 8: four
# more come in from the far end of the road if nobody stopped them.
# Destroying the engines is NOT a win condition yet: the stock "must destroy" mode would stop
# "kill every guard and take the cargo" from ending the battle, and John wants that choice.
alienDeployments:
  - type: STR_COBRA_CONVOY
    data:
      - alienRank: 5
        lowQty: 8
        highQty: 8
        dQty: 0
        percentageOutsideUfo: 100
        itemSets:
          - [STR_PISTOL, STR_PISTOL_CLIP, STR_PISTOL_CLIP]
          - [STR_PISTOL, STR_PISTOL_CLIP, STR_PISTOL_CLIP]
          - [STR_PISTOL, STR_PISTOL_CLIP, STR_PISTOL_CLIP]
    reinforcements:
      - type: STR_CONVOY_BACKUP
        turns: [8]
        maxRuns: 1
        useSpawnNodes: false
        spawnZLevels: [1]
        maxDistanceFromBorders: 3
        minDistanceFromXcomUnits: 15
        data:
          - alienRank: 5
            lowQty: 4
            highQty: 4
            dQty: 0
            itemSets:
              - [STR_PISTOL, STR_PISTOL_CLIP, STR_PISTOL_CLIP]
              - [STR_PISTOL, STR_PISTOL_CLIP, STR_PISTOL_CLIP]
              - [STR_PISTOL, STR_PISTOL_CLIP, STR_PISTOL_CLIP]
    civilians: 0
    width: 50
    length: 40
    height: 4
    terrains: [M3CONVOY]
    script: M3CONVOY_SCRIPT
    shade: 0
    duration: [24, 48]
    markerName: STR_COBRA_CONVOY_SITE
    markerIcon: 22
    alert: STR_COBRA_CONVOY_ALERT
    briefing:
      palette: 0
      title: STR_COBRA_CONVOY
      desc: STR_COBRA_CONVOY_BRIEFING

# One convoy on the globe, two days into a new game, on I-10 (zone 7, zz_gijoe_day1_opener.rul).
alienMissions:
  - type: STR_COBRA_CONVOY_MISSION
    points: 0
    objective: 3
    spawnZone: 7
    raceWeights:
      0:
        STR_COBRA: 100
    waves:
      - ufo: STR_COBRA_CONVOY
        count: 1
        trajectory: P0
        timer: 60
        objective: true

missionScripts:
  - type: cobraConvoyFirst
    firstMonth: 0
    lastMonth: 0
    maxRuns: 1
    varName: cobraConvoyFirstRun
    executionOdds: 100
    startDelay: 2880
    missionWeights:
      0:
        STR_COBRA_CONVOY_MISSION: 100
    regionWeights:
      0:
        STR_NORTH_AMERICA: 100

extraStrings:
  - type: en-US
    strings: &convoystr
      STR_COBRA_CONVOY: Cobra Convoy
      STR_COBRA_CONVOY_SITE: Cobra Convoy
      STR_COBRA_CONVOY_MISSION: Cobra Convoy
      STR_COBRA_CONVOY_ALERT: COBRA CONVOY STOPPED
      STR_INTERSTATE_10: Interstate 10
      STR_CONVOY_BACKUP: Cobra reinforcements
      STR_COBRA_CONVOY_BRIEFING: "Two Cobra semis hit a spike strip on I-10 in the West Texas desert. The drivers and guards are holding the trucks and the officer is on the radio: more are coming. Take the cargo or wreck the rigs. Careful with explosives: the paperwork in the crates and cabs burns."
  - type: en-GB
    strings: *convoystr
