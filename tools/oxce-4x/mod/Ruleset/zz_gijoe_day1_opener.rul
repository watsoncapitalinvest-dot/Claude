alienMissions:
  - type: STR_CARTEL_RANCH_MISSION
    points: 0
    objective: 3
    spawnZone: 6
    raceWeights:
      0:
        STR_COBRA: 100
    waves:
      - ufo: STR_CARTEL_RANCH        # a deployment name: the site spawns directly, no craft
        count: 1
        trajectory: P0
        timer: 60
        objective: true

missionScripts:
  - type: cartelRanchOpening
    firstMonth: 0
    lastMonth: 0
    maxRuns: 1
    varName: cartelRanchOpened
    executionOdds: 100
    startDelay: 60
    missionWeights:
      0:
        STR_CARTEL_RANCH_MISSION: 100
    regionWeights:
      0:
        STR_NORTH_AMERICA: 100

alienDeployments:
  - type: STR_CARTEL_RANCH
    markerName: STR_CARTEL_RANCH_SITE
    alert: STR_CARTEL_RANCH_ALERT
    duration: [720, 720]

extraStrings:
  - type: en-US
    strings:
      STR_RIO_GRANDE: Rio Grande
      STR_CARTEL_RANCH_SITE: Cartel Ranch
      STR_CARTEL_RANCH_MISSION: Cartel Ranch
      STR_CARTEL_RANCH_ALERT: CARTEL RANCH LOCATED
  - type: en-GB
    strings:
      STR_RIO_GRANDE: Rio Grande
      STR_CARTEL_RANCH_SITE: Cartel Ranch
      STR_CARTEL_RANCH_MISSION: Cartel Ranch
      STR_CARTEL_RANCH_ALERT: CARTEL RANCH LOCATED
