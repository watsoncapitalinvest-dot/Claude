# CAPTURE, step 1 (John 13 Nov 2026, claude/CAPTURE_DESIGN_v1.md). Engine: BattleUnit::damage
# (knockouts), NextTurnState::runCapture (surrender; Cobra shooting or freeing its own),
# BattlescapeState::hudSigClick (the CUFF key), UnitWalkBState (a cuffed man follows his captor)
# and DebriefingState (a cuffed man at the APC comes home on a pull-out).
capture:
  knockoutChance: 10          # percent: a pistol or rifle hit that would kill an ordinary man knocks him out instead
  cuffTU: 8                   # the CUFF key (signature slot): time units it costs the Joe
  knockoutWeapons:            # pistols and rifles only; explosives and heavy guns always kill
    - STR_PISTOL              # Uzi
    - STR_RIFLE               # M4 Carbine
    - STR_LASER_PISTOL
    - STR_LASER_RIFLE         # Sniper Rifle
    - STR_PLASMA_PISTOL       # Pulse Pistol
    - STR_PLASMA_RIFLE        # Pulse Rifle
  overflowPerRoom: 2          # men cuffed outside the cells, per detainment room
  escapeChance: 10            # percent a week, each man outside the cells
  escapeChanceNamed: 30       # ...a named Cobra
  surrenderHealthPct: 33      # badly hurt: below a third of his health
  surroundJoes: 2             # surrounded: this many Joes...
  surroundRange: 3            # ...within this many tiles
  namedCobra:                 # Cobra frees these instead of shooting them as deserters
    - STR_COBRA_COMMANDER_UNIT
    - STR_DESTRO_UNIT
    - STR_STORM_SHADOW_UNIT
  # A Joe held by Cobra (step 4, John 13 Nov: "5 days", "leaks with time / choice is trade or rescue").
  heldFirstLeak: 5            # days before a greenshirt starts to talk
  heldFirstLeakNamed: 10      # ...a named Joe holds out longer
  heldLeakEvery: 7            # then a leak this often
  heldLeakEveryNamed: 10
  tradeCashPerRank: 25000     # rank for rank; cash covers each rank the Cobra prisoner is short
  greenshirtTypes:            # every other Joe type is a named Joe
    - STR_SOLDIER
    - STR_REGULAR_JOE
    - STR_REGULAR_JOE_UC
    - STR_JOE_MEDIC
    - STR_JOE_MEDIC_UC
    - STR_JOE_PILOT
    - STR_JOE_PILOT_UC

extraStrings:
  - type: en-US
    strings: &capturestr
      STR_CAPTURE_SURRENDERS: "A Cobra man throws down his gun and puts his hands up."
      STR_CAPTURE_DESERTER_SHOT: "Cobra shot one of their own who had surrendered."
      STR_PRISONER_ESCAPED: "A prisoner cuffed outside the full cells slipped away."
      STR_NAMED_PRISONER_ESCAPED: "A named Cobra prisoner escaped from detainment!"
      STR_CAPTURE_FREED: "Cobra freed their man before the Joes could cuff him. He is back in the fight."
      STR_HELD_BY_COBRA: "HELD BY COBRA (click to trade or rescue)"
      STR_DAYS_HELD: "{0} days"
      STR_HELD_FOR_DAYS: "Held by Cobra for {0} days."
      STR_LEAK_SITE_MOVED: "{0} talked. Cobra knows we found one of its sites and has moved it."
      STR_LEAK_QUESTIONED: "Cobra is questioning {0}. Nothing we know has leaked yet."
      STR_TRADE_OFFER: "Cobra will trade him for our prisoner, {0}, held at {1}."
      STR_TRADE_CASH: "Our prisoner is lower rank. Cobra wants {0} as well."
      STR_TRADE_NO_FUNDS: "We cannot cover the cash."
      STR_TRADE_NO_PRISONER: "We have no Cobra prisoner to trade for him."
      STR_TRADE: "TRADE"
      STR_RESCUE: "RESCUE"
      STR_RESCUE_NOT_YET: "The rescue mission is not in the game yet. It waits on its map."
      STR_TRADE_DONE: "{0} is home, traded for a Cobra prisoner."
  - type: en-GB
    strings: *capturestr
