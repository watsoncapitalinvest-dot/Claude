# CAPTURE, step 1 (John 13 Nov 2026, claude/CAPTURE_DESIGN_v1.md). Engine: BattleUnit::damage
# (knockouts), NextTurnState::runCapture (surrender; Cobra shooting or freeing its own),
# BattlescapeState::hudSigClick (the CUFF key), UnitWalkBState (a cuffed man follows his captor)
# and DebriefingState (a cuffed man at the APC comes home on a pull-out).
capture:
  knockoutChance: 10          # percent: a pistol or rifle hit that would kill an ordinary man knocks him out instead
  cuffTU: 8                   # the CUFF key (signature slot): time units it costs the Joe
  knockoutWeapons:            # pistols and rifles only; explosives and heavy guns always kill
    - STR_PISTOL              # Uzi
    - STR_RIFLE               # M4 Carbine
    - STR_LASER_PISTOL
    - STR_LASER_RIFLE         # Sniper Rifle
    - STR_PLASMA_PISTOL       # Pulse Pistol
    - STR_PLASMA_RIFLE        # Pulse Rifle
  overflowPerRoom: 2          # men cuffed outside the cells, per detainment room
  escapeChance: 10            # percent a week, each man outside the cells
  escapeChanceNamed: 30       # ...a named Cobra
  surrenderHealthPct: 33      # badly hurt: below a third of his health
  surroundJoes: 2             # surrounded: this many Joes...
  surroundRange: 3            # ...within this many tiles
  namedCobra:                 # Cobra frees these instead of shooting them as deserters
    - STR_COBRA_COMMANDER_UNIT
    - STR_DESTRO_UNIT
    - STR_STORM_SHADOW_UNIT
  # A Joe held by Cobra (step 4, John 13 Nov: "5 days", "leaks with time / choice is trade or rescue").
  heldFirstLeak: 5            # days before a greenshirt starts to talk
  heldFirstLeakNamed: 10      # ...a named Joe holds out longer
  heldLeakEvery: 7            # then a leak this often
  heldLeakEveryNamed: 10
  tradeCashPerRank: 25000     # rank for rank; cash covers each rank the Cobra prisoner is short
  spyTypes:                   # Joes with Covert Ops & Intel who can be sent on operations. Day 1: Scarlett.
    - STR_SCARLETT            # The other named intel Joes go here as ROSTER adds them
    - STR_CHUCKLES            # (Lady Jaye, Claymore, Law & Order, Psyche-Out, Bullhorn, Big Ben, Mace).
  unnamedSpyKilled: 50        # percent: a caught greenshirt spy is killed (missing in action); else held.
                              # A named spy is always held (named Joes never die).
  # NAMED JOES OUT OF ACTION (John 13 Nov, BUILD_DESIGN_ANSWERS_13Nov_Evening A1-A2). A blow that
  # would kill a named Joe knocks him down instead (named Joes never die); he is out 2-4 weeks, longer
  # the further past death the blow went. A medic at home heals everyone there faster.
  # TRANSFER FLIGHTS (John 13 Nov, A3): everything moving between bases flies. A craft moves itself;
  # everything else goes by courier, at courierFeeMult times the stock transfer price. Cobra can
  # intercept: each Cobra site within interceptRadius (radians; 0.15 = about 950 km) of the route adds
  # interceptPerSite percent, each flying Cobra craft near it interceptPerUfo, capped at interceptCap.
  courierFeeMult: 3
  interceptRadius: 0.15
  interceptPerSite: 12
  interceptPerUfo: 10
  interceptCap: 60
  # INSTRUCTORS (John 13 Nov, A4): a named Joe set as instructor (his APPOINT list), at home at a
  # base with a Training Room, trains up to classSize unnamed Joes there: one mission's worth every
  # daysPerMission days, in the two stats his own main specialty leads in, never past their caps.
  training:
    rooms: [STR_TRAINING_ROOM]
    classSize: 6
    daysPerMission: 30
    stats:
      STR_GJR_SPEC_COMMAND: [bravery, reactions]
      STR_GJR_SPEC_HEAVY_WEAPONS: [firing, strength]
      STR_GJR_SPEC_INFANTRY: [firing, reactions]
      STR_GJR_SPEC_COMMS_TECH: [reactions, tu]
      STR_GJR_SPEC_COVERT_OPS_INTEL: [reactions, melee]
      STR_GJR_SPEC_MARTIAL_ARTS: [melee, reactions]
      STR_GJR_SPEC_MEDIC: [bravery, stamina]
      STR_GJR_SPEC_PILOT: [reactions, firing]
      STR_GJR_SPEC_AIRBORNE: [stamina, tu]
      STR_GJR_SPEC_DEMOLITIONS_ENGINEERING: [throwing, strength]
      STR_GJR_SPEC_RECON_SNIPER: [firing, reactions]
      STR_GJR_SPEC_ARMOR_VEHICLES: [strength, stamina]
      STR_GJR_SPEC_ARCTIC_MOUNTAIN: [stamina, strength]
      STR_GJR_SPEC_NAVAL_DIVERS: [stamina, tu]
  downedDaysMin: 14
  downedDaysMax: 28
  medicBonus: 15              # percent faster healing with the best medic at home
  medicBonusInfirmary: 25     # ...with an infirmary room at that base
  medicSecondPct: 67          # a medic by second specialty (Airborne) gives about two-thirds
  medicSpecialties: [STR_GJR_SPEC_MEDIC]
  infirmaryRooms: [STR_INFIRMARY_ROOM]
  greenshirtTypes:            # every other Joe type is a named Joe
    - STR_SOLDIER
    - STR_REGULAR_JOE
    - STR_REGULAR_JOE_UC
    - STR_JOE_MEDIC
    - STR_JOE_MEDIC_UC
    - STR_JOE_PILOT
    - STR_JOE_PILOT_UC

# SPY OPERATIONS (John 13 Nov: 5 days, 80/15/5, the first one always succeeds). Offered on the INTEL
# board once any requiresAny topic is researched. A caught spy is held by Cobra like any captured Joe.
spyOperations:
  # The cartel arc, step 3 (STORY_CartelArc_v1): offered once the stash house is known. Until the
  # tail mechanic and the stash house site exist, "known" = the flight route or the logbook decoded.
  - type: STR_OP_SCARLETT_STASH_HOUSE         # Operation: Quiet Courier (STORY's name and text)
    desc: STR_OP_SCARLETT_STASH_HOUSE_DESC
    requiresAny: [STR_CARTEL_FLIGHT_ROUTE, STR_CARTEL_LOGBOOK]
    days: 5
    success: 80
    empty: 15                                 # caught: the other 5
    once: true
    items: {STR_INFORMANT_TIP: 1}             # researched, it opens the robbery ahead of time
    lead: STR_LEAD_CARTEL_SUPPLIER
    leadPoints: 10                            # the lead's step-3 share (gijoe_leads.rul)

extraStrings:
  - type: en-US
    strings: &capturestr
      STR_CAPTURE_SURRENDERS: "A Cobra man throws down his gun and puts his hands up."
      STR_CAPTURE_DESERTER_SHOT: "Cobra shot one of their own who had surrendered."
      STR_PRISONER_ESCAPED: "A prisoner cuffed outside the full cells slipped away."
      STR_NAMED_PRISONER_ESCAPED: "A named Cobra prisoner escaped from detainment!"
      STR_CAPTURE_FREED: "Cobra freed their man before the Joes could cuff him. He is back in the fight."
      STR_HELD_BY_COBRA: "HELD BY COBRA (click to trade or rescue)"
      STR_DAYS_HELD: "{0} days"
      STR_HELD_FOR_DAYS: "Held by Cobra for {0} days."
      STR_LEAK_SITE_MOVED: "{0} talked. Cobra knows we found one of its sites and has moved it."
      STR_LEAK_QUESTIONED: "Cobra is questioning {0}. Nothing we know has leaked yet."
      STR_TRADE_OFFER: "Cobra will trade him for our prisoner, {0}, held at {1}."
      STR_TRADE_CASH: "Our prisoner is lower rank. Cobra wants {0} as well."
      STR_TRADE_NO_FUNDS: "We cannot cover the cash."
      STR_TRADE_NO_PRISONER: "We have no Cobra prisoner to trade for him."
      STR_TRADE: "TRADE"
      STR_RESCUE: "RESCUE"
      STR_RESCUE_NOT_YET: "The rescue mission is not in the game yet. It waits on its map."
      STR_TRADE_DONE: "{0} is home, traded for a Cobra prisoner."
      STR_SPY_OPERATIONS: "OPERATIONS (click one to send a spy)"
      STR_SPY_SEND: "SEND"
      STR_DAYS_LEFT: "{0} days left"
      STR_SPY_AWAY_DAYS: "The spy is away for {0} days: still on the roster, but no craft, no battle, no training until back."
      STR_SPY_NONE_HOME: "No spy is at home and fit to go."
      STR_SPY_SENT: "{0} is away on {1}."
      STR_SPY_OP_SUCCESS: "{0} is back from {1}, and came through."
      STR_SPY_AWAY: "AWAY"
      STR_SPY_OP_KILLED: "{0} was caught on {1} and killed. Listed missing in action."
      STR_SPY_OP_EMPTY: "{0} is back from {1} with nothing. The contact never showed."
      STR_SPY_OP_CAUGHT: "{0} was caught on {1}. They are holding our spy. Trade or rescue from the INTEL board."
  - type: en-GB
    strings: *capturestr
