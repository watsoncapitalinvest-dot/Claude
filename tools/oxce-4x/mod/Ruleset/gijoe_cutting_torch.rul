# The CUTTING TORCH (MAPS, BRIEF_FOR_BUILD_Emmaville_v8 c): the quiet way through a manhole cover, a locked door
# or a false wall. Point-blank, accurate, all its damage goes to the tile and none to people. Armour MAPS gave:
# covers 90, locked doors 70, false walls 45, the lair's blast door 255 (never). 20 x 6.0 = 120 to the tile a burn,
# so one burn opens a cover or a door; a melee-range "shot" (maxRange 2), 30 TU.
# STAND-IN PICTURE: the pistol's. Sold at the base for New Battle and testing; no research yet (STORY to place it).
items:
  - type: STR_CUTTING_TORCH
    size: 0.2
    costBuy: 1500
    costSell: 500
    weight: 6
    bigSprite: 3
    floorSprite: 3
    handSprite: 96
    bulletSprite: 1
    fireSound: 4
    battleType: 1
    clipSize: 10
    power: 20
    damageType: 4                 # laser: a hit on one spot, no blast
    damageAlter: {ToTile: 6.0, ToHealth: 0, ToArmor: 0, ToStun: 0, ToWound: 0}
    accuracySnap: 120
    tuSnap: 30
    flatRate: true
    maxRange: 2
    invWidth: 1
    invHeight: 2
    listOrder: 9000
extraStrings:
  - type: en-US
    strings: &torch
      STR_CUTTING_TORCH: "Cutting torch"
  - type: en-GB
    strings: *torch
