# G.I. Joe voices and theme (pulled from John's Generals mod, 13 Nov 2026).
# The audio files are NOT in the public repo (.gitignore); they reach the game in mod_update.zip.
# If they are missing the game still loads: these sounds are simply silent.

musics:
  - type: GIJOE_THEME
    name: gijoe_theme          # Sound/gijoe_theme.mp3

# The theme starts with the studio title card (gijoe_intro.rul musicId) and carries on into the main menu:
# playMusic does not restart a track that is already playing.
interfaces:
  - type: mainMenu
    music: GIJOE_THEME

extraSounds:
  - type: BATTLE.CAT
    files:
      200: Resources/Sound/gj_yojoe.wav
      201: Resources/Sound/gj_duke_yojoe.wav
      202: Resources/Sound/gj_roadb_yojoe.wav
      203: Resources/Sound/gj_snake_yojoe.wav
      204: Resources/Sound/gj_duke_hurt.wav
      205: Resources/Sound/gj_roadb_hurt.wav
      206: Resources/Sound/gj_snake_hurt.wav
      207: Resources/Sound/gj_cobra.wav
      208: Resources/Sound/gj_cc_intro.wav
      209: Resources/Sound/gj_cobradeath1.wav
      210: Resources/Sound/gj_cobradeath2.wav
      211: Resources/Sound/gj_cobradeath3.wav
      212: Resources/Sound/gj_cobradeath4.wav
      213: Resources/Sound/gj_cobradeath5.wav
      214: Resources/Sound/gj_cobradeath6.wav

# Joes: "Yo Joe!" when selected; Duke, Roadblock and Snake Eyes have their own, and their own cry when they go down.
soldiers:
  - type: STR_HAWK
    selectUnitMale: [200]
  - type: STR_DUKE
    selectUnitMale: [201]
    deathMale: [204]
  - type: STR_SOLDIER
    selectUnitMale: [202]
    deathMale: [205]
  - type: STR_ROCK_N_ROLL
    selectUnitMale: [200]
  - type: STR_GRAND_SLAM
    selectUnitMale: [200]
  - type: STR_SHORT_FUZE
    selectUnitMale: [200]
  - type: STR_ZAP
    selectUnitMale: [200]
  - type: STR_GRUNT
    selectUnitMale: [200]
  - type: STR_STALKER
    selectUnitMale: [200]
  - type: STR_BREAKER
    selectUnitMale: [200]
  - type: STR_FLASH
    selectUnitMale: [200]
  - type: STR_SCARLETT
    selectUnitMale: [200]
  - type: STR_SNAKE_EYES
    selectUnitMale: [203]
    deathMale: [206]
  - type: STR_DOC
    selectUnitMale: [200]
  - type: STR_ACE
    selectUnitMale: [200]
  - type: STR_AIRBORNE
    selectUnitMale: [200]
  - type: STR_BEACH_HEAD
    selectUnitMale: [200]
  - type: STR_REGULAR_JOE
    selectUnitMale: [200]
  - type: STR_JOE_MEDIC
    selectUnitMale: [200]
  - type: STR_JOE_PILOT
    selectUnitMale: [200]

# Cobra: "Cobra!" when they spot a Joe, and a cry when they fall. Cobra Commander has his own line.
units:
  - type: STR_COBRA_COMMANDER_UNIT
    aggroSound: [208]
    deathSound: [209, 210, 211, 212, 213, 214]
  - type: STR_DESTRO_UNIT
    aggroSound: [207]
    deathSound: [209, 210, 211, 212, 213, 214]
  - type: STR_VIPER_ENGINEER
    aggroSound: [207]
    deathSound: [209, 210, 211, 212, 213, 214]
  - type: STR_VIPER_MEDIC
    aggroSound: [207]
    deathSound: [209, 210, 211, 212, 213, 214]
  - type: STR_STORM_SHADOW_UNIT
    aggroSound: [207]
    deathSound: [209, 210, 211, 212, 213, 214]
  - type: STR_COBRA_TROOPER
    aggroSound: [207]
    deathSound: [209, 210, 211, 212, 213, 214]
  - type: STR_BAT_TERRORIST
