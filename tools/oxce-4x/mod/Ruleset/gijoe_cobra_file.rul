# COBRA'S FILE ON EACH NAMED JOE (John 13 Nov 2026, BUILD_DESIGN_ANSWERS_13Nov_Evening A6; STORY's numbers,
# UNNAMED_JOES_DESIGN_v1 section 3). Unnamed Joes have no file.
#
# +1 on a named Joe's file for every mission where Cobra saw him and a Cobra man lived through it (one was
# still standing or got away, or Cobra held the field). The engine records "seen by Cobra" for the Joe,
# not which Cobra man saw him, so "that man survived" is read as "any Cobra man survived".
# -decayPerMonth for each month he goes unseen.
# At knownAt (KNOWN): the Cobra AI shoots at him first (he counts as knownTargetBonus tiles closer), and a
#   transfer he rides on is knownInterceptPct% as likely to be intercepted.
# At bountyAt (BOUNTY): Cobra hunts him.
#   - Out on a craft that is flying home or patrolling: craftAmbushChance% a day that a hunter team jumps
#     it; the craft is turned toward the ambush site (24 hours).
#   - A transfer he rides on: +bountyInterceptAdd% to its interception chance (a crash site or road ambush).
#   - At home homeDaysBeforeRaid days in a row: a strike team turns up outside his base (raidHours).
#     John 22:43: "fight at the gate and into the base if they can and have to". Beat them at the gate and
#     that is the end of it. Lose at the gate, or leave them alone until it lapses, and they push into the
#     base after him: a fight inside the base on its own map (STR_HUNTER_INSIDE below). Lose that and he is
#     taken (held by Cobra; trade or rescue him) - the base itself is NOT lost. If he is not at the base when
#     they would come in (out on a craft, away), they don't come in; the bounty stands.
#   Win a hunter mission (gate or inside) and his file drops back to resetTo. Lose it and the bounty stands.
# Both lists are on the INTEL board under COBRA'S FILES. Every number is BUILD's first pass.
#
# STAND-IN MAPS: both hunter missions use MAPS' road map (TRANSPORT) until there is a base-perimeter map.

cobraFile:
  knownAt: 5
  bountyAt: 10
  resetTo: 5
  decayPerMonth: 1
  knownTargetBonus: 6
  knownInterceptPct: 125
  bountyInterceptAdd: 40
  craftAmbushChance: 20
  homeDaysBeforeRaid: 21
  raidHours: 48

alienDeployments:
  - type: STR_HUNTER_AMBUSH
    data:
      - alienRank: 5
        lowQty: 6
        highQty: 8
        dQty: 1
        percentageOutsideUfo: 100
        itemSets:
          - [STR_PISTOL, STR_PISTOL_CLIP, STR_PISTOL_CLIP]
          - [STR_RIFLE, STR_RIFLE_CLIP, STR_RIFLE_CLIP]
          - [STR_RIFLE, STR_RIFLE_CLIP, STR_RIFLE_CLIP]
    width: 50
    length: 40
    height: 2
    terrains: [TRANSPORT]
    script: TRANSPORT_SCRIPT
    shade: 0
    duration: [24, 24]
    markerName: STR_HUNTER_SITE
    markerIcon: 22
    briefingData:
      palette: 0
      title: STR_HUNTER_AMBUSH
      desc: STR_HUNTER_AMBUSH_BRIEFING
  - type: STR_HUNTER_RAID
    data:
      - alienRank: 5
        lowQty: 6
        highQty: 8
        dQty: 1
        percentageOutsideUfo: 100
        itemSets:
          - [STR_PISTOL, STR_PISTOL_CLIP, STR_PISTOL_CLIP]
          - [STR_RIFLE, STR_RIFLE_CLIP, STR_RIFLE_CLIP]
          - [STR_RIFLE, STR_RIFLE_CLIP, STR_RIFLE_CLIP]
    width: 50
    length: 40
    height: 2
    terrains: [TRANSPORT]
    script: TRANSPORT_SCRIPT
    shade: 0
    duration: [48, 48]
    markerName: STR_HUNTER_SITE
    markerIcon: 22
    briefingData:
      palette: 0
      title: STR_HUNTER_RAID
      desc: STR_HUNTER_RAID_BRIEFING

  - type: STR_HUNTER_INSIDE          # the strike team inside the base (base defence map, only these men)
    data:
      - alienRank: 5
        lowQty: 6
        highQty: 8
        dQty: 1
        percentageOutsideUfo: 100
        itemSets:
          - [STR_PISTOL, STR_PISTOL_CLIP, STR_PISTOL_CLIP]
          - [STR_RIFLE, STR_RIFLE_CLIP, STR_RIFLE_CLIP]
          - [STR_RIFLE, STR_RIFLE_CLIP, STR_RIFLE_CLIP]
    width: 50
    length: 50
    height: 2

alienMissions:
  - type: STR_HUNTER_MISSION
    points: 0
    objective: 3
    raceWeights:
      0:
        STR_COBRA: 100
    waves:
      - ufo: STR_HUNTER_AMBUSH
        count: 1
        trajectory: P0
        timer: 60
        objective: true

extraStrings:
  - type: en-US
    strings: &cfstr
      STR_COBRA_FILES: "COBRA'S FILES"
      STR_FILE_KNOWN: "Known"
      STR_FILE_BOUNTY: "BOUNTY"
      STR_FILE_POINTS: "file {0}"
      STR_COBRA_FILE_KNOWN: "Cobra knows {0}'s face now. Their gunmen will go for him first."
      STR_COBRA_FILE_BOUNTY: "Cobra has put a price on {0}. Hunters will come for him: on the road, in the air, or at home."
      STR_HUNTERS_JUMP_CRAFT: "A Cobra hunter team is waiting for {0}. {1} has been forced down to meet them."
      STR_HUNTERS_AT_BASE: "A Cobra strike team is outside {1}, after {0}. Meet them at the gate within two days, or they come in after him."
      STR_HUNTERS_TOOK: "The Cobra strike team got in. {0} is in Cobra's hands."
      STR_HUNTERS_GOT_IN_TITLE: "THE STRIKE TEAM GOT AWAY WITH HIM"
      STR_HUNTERS_BEATEN: "The hunters are beaten. Cobra's price on {0} is off, for now."
      STR_HUNTER_SITE: "Cobra hunters"
      STR_HUNTER_AMBUSH: "Hunter Ambush"
      STR_HUNTER_AMBUSH_BRIEFING: "Cobra has put a price on one of ours, and a hunter team has caught up with his craft. They want him alive. Beat them off."
      STR_HUNTER_RAID: "Strike Team"
      STR_HUNTER_RAID_BRIEFING: "A Cobra strike team has come for one of ours at his own base. Stop them at the gate. If they get past us, they will come inside after him."
  - type: en-GB
    strings: *cfstr
