# SEA FIGHTS on the battle engine (claude/SEA_BATTLES_DESIGN_v1.md, claude/AIR_SEA_BUILD_PLAN_v1.md step 2).
# The same framework as the air fights (gijoe_air_fight.rul, engine AirFight): an interception of a Cobra
# ship (a ufo type listed under airFight.ships) is a sea fight on three floors - 0 underwater, 1 surface,
# 2 air. Jets keep to the air, ships to the surface. Guns can't reach under the waterline.
# A ship's engines, guns and steering take hits by where they come from; engines out = dead in the water =
# the fight ends and a boarding mission appears on the spot (MAPS' FREIGHTER deck).
#
# FIRST SLICE (14 Nov): jets against a Cobra-flagged ship in the Gulf of Mexico.
# NOT YET: the ship is a 1-tile unit (5x5 needs big units), Joe boats, subs, divers, torpedoes, mines,
# depth charges, sonar, the Flagg, freighters as fixed pieces, shipping lanes and Cobra's money
# (SEA design 12h), stop and search, the wreck dive.

airFight:
  units:
    STR_COBRA_FLAGGED_SHIP: STR_SEA_COBRA_SHIP
  ships: [STR_COBRA_FLAGGED_SHIP]
  seaDeployment: STR_SEA_FIGHT
  seaTerrain: SEA_OCEAN
  aircraft:
    STR_SEA_COBRA_SHIP: {role: ship, agility: 0, seaMinFloor: 1, seaMaxFloor: 1, arc: any, systemHits: 4}
  weapons:
    STR_SEA_DECK_GUN: {arc: any, minFloor: 1, maxFloor: 1}     # a turret: the surface only
    STR_SEA_AA_GUN: {arc: any, minFloor: 2, maxFloor: 2}       # anti-air: the air only

terrains:
  - name: SEA_OCEAN
    mapDataSets: [BLANKS, SEA_OCEAN]
    mapBlocks:
      - {name: SEAOCE0, width: 10, length: 10}
      - {name: SEAOCE1, width: 10, length: 10}
      - {name: SEAOCE2, width: 10, length: 10}
      - {name: SEAOCE3, width: 10, length: 10}
  - name: FREIGHTER_T              # MAPS' freighter (BRIEF_FOR_BUILD_Freighter): 60 x 20 x 8, .MAP2
    mapDataSets: [BLANKS, SHIPKIT, SHIPX, SHIPF_A, SHIPF_B, SHIPF_C]
    mapBlocks:
      - {name: FREIGHTER, width: 60, length: 20}

mapScripts:
  - type: SEA_SCRIPT
    commands:
      - type: fillArea
  - type: FREIGHTER_SCRIPT
    commands:
      - type: addBlock
        size: [6, 2]
        rects:
          - [0, 0, 6, 2]

alienDeployments:
  - type: STR_SEA_FIGHT
    data: []
    width: 40
    length: 40
    height: 3
    terrains: [SEA_OCEAN]
    script: SEA_SCRIPT
    shade: 0
    briefing:
      palette: 0
      title: STR_SEA_BRIEFING_TITLE
      desc: STR_SEA_BRIEFING
      showCraft: false
  - type: STR_COBRA_SHIP_BOARDING
    data:
      - alienRank: 5
        lowQty: 6
        highQty: 8
        dQty: 1
        percentageOutsideUfo: 100
        itemSets:
          - [STR_PISTOL, STR_PISTOL_CLIP, STR_PISTOL_CLIP]
          - [STR_RIFLE, STR_RIFLE_CLIP, STR_RIFLE_CLIP]
          - [STR_RIFLE, STR_RIFLE_CLIP, STR_RIFLE_CLIP]
    width: 60
    length: 20
    height: 8
    terrains: [FREIGHTER_T]
    script: FREIGHTER_SCRIPT
    shade: 0
    duration: [24, 48]
    markerName: STR_COBRA_SHIP_DISABLED_SITE
    markerIcon: 22
    briefing:
      palette: 0
      title: STR_BRIEFING_COBRA_SHIP_BOARDING_TITLE
      desc: STR_BRIEFING_COBRA_SHIP_BOARDING

alienMissions:
  - type: STR_COBRA_SHIP_BOARDING_MISSION    # the site a disabled ship leaves (engine: GeoscapeState::finishAirFight)
    points: 0
    objective: 3
    raceWeights:
      0:
        STR_COBRA: 100
    waves:
      - ufo: STR_COBRA_SHIP_BOARDING
        count: 1
        trajectory: P0
        timer: 60
        objective: true
  - type: STR_COBRA_SHIPPING                 # a Cobra-flagged ship sails the Gulf and leaves (first slice)
    points: 0
    objective: 0
    raceWeights:
      0:
        STR_COBRA: 100
    waves:
      - ufo: STR_COBRA_FLAGGED_SHIP
        count: 1
        trajectory: P_SHIP_LANE
        timer: 600

ufoTrajectories:
  - id: P_SHIP_LANE
    groundTimer: 1
    waypoints:
      - [11, 1, 100]
      - [11, 1, 100]
      - [11, 1, 100]
      - [11, 1, 100]
      - [11, 1, 100]

missionScripts:
  - type: cobraShippingGulf                  # STAND-IN until Cobra's money sails the ships (SEA 12h)
    firstMonth: 0
    executionOdds: 100
    targetBaseRegion: false
    missionWeights:
      0:
        STR_COBRA_SHIPPING: 100
    regionWeights:
      0:
        STR_NORTH_AMERICA: 100

ufos:
  - type: STR_COBRA_FLAGGED_SHIP
    size: STR_LARGE
    sprite: 3
    damageMax: 300
    speedMax: 380
    power: 0
    range: 0
    score: 60
    reload: 56
    breakOffTime: 400
    battlescapeTerrainData:
      name: UFO1A
      mapDataSets:
        - BLANKS
        - UFO1
      mapBlocks:
        - name: UFO1A
          width: 10
          length: 10

extraSprites:
  - type: SEA_COBRA_SHIP_BODY_HD.PCK
    width: 2048
    height: 5120
    subX: 128
    subY: 160
    files:
      0: Resources/Units/air_cobra_ship_body.png

armors:
  - type: SEA_COBRA_SHIP_ARMOR
    spriteSheet: SEA_COBRA_SHIP_BODY_HD.PCK
    drawingRoutine: 23
    deathFrames: 8
    movementType: 1
    size: 1
    frontArmor: 6
    sideArmor: 6
    rearArmor: 6
    underArmor: 6
    visibilityAtDay: 14
    visibilityAtDark: 14
    corpseBattle: [STR_AF_WRECK]
    loftempsSet: [3]
    builtInWeapons: [STR_SEA_DECK_GUN, STR_SEA_AA_GUN]
    allowsKneeling: false
    allowsRunning: false

units:
  - type: STR_SEA_COBRA_SHIP
    race: STR_COBRA
    rank: STR_LIVE_SOLDIER
    armor: SEA_COBRA_SHIP_ARMOR
    stats: {tu: 30, stamina: 100, health: 300, bravery: 50, reactions: 40, firing: 55, throwing: 0, strength: 100, psiStrength: 100, psiSkill: 0, melee: 0}
    standHeight: 10
    kneelHeight: 10
    floatHeight: 0
    value: 60
    deathSound: 22
    intelligence: 3
    aggression: 1

items:
  - type: STR_SEA_DECK_GUN
    size: 0.1
    weight: 1
    bigSprite: 0
    floorSprite: 0
    handSprite: 0
    invWidth: 1
    invHeight: 1
    battleType: 1
    fixedWeapon: true
    recover: false
    clipSize: 14
    power: 22
    damageType: 1
    damageAlter: {RandomType: 10, ArmorEffectiveness: 1.0, ToArmor: 0, ToTile: 0, ToStun: 0, ToWound: 0, IgnoreDirection: true}
    tuSnap: 12
    flatRate: true
    accuracySnap: 100
    maxRange: 7
    bulletSprite: 1
    fireSound: 4
    hitSound: 12
    hitAnimation: 26
  - type: STR_SEA_AA_GUN
    size: 0.1
    weight: 1
    bigSprite: 0
    floorSprite: 0
    handSprite: 0
    invWidth: 1
    invHeight: 1
    battleType: 1
    fixedWeapon: true
    recover: false
    clipSize: 14
    power: 18
    damageType: 1
    damageAlter: {RandomType: 10, ArmorEffectiveness: 1.0, ToArmor: 0, ToTile: 0, ToStun: 0, ToWound: 0, IgnoreDirection: true}
    tuSnap: 12
    flatRate: true
    accuracySnap: 100
    maxRange: 8
    bulletSprite: 1
    fireSound: 4
    hitSound: 12
    hitAnimation: 26

extraStrings:
  - type: en-US
    strings: &seastr
      STR_COBRA_FLAGGED_SHIP: "Cobra-flagged ship"
      STR_SEA_COBRA_SHIP: "Cobra-flagged ship"
      STR_SEA_DECK_GUN: "Deck gun"
      STR_SEA_AA_GUN: "Anti-aircraft gun"
      STR_SEA_FIGHT: "Sea fight"
      STR_COBRA_SHIPPING: "Cobra shipping"
      STR_COBRA_SHIP_BOARDING: "Board the ship"
      STR_COBRA_SHIP_BOARDING_MISSION: "Board the ship"
      STR_COBRA_SHIP_DISABLED_SITE: "Disabled ship"
      STR_COBRA_SHIP_DISABLED_SITE_: "Disabled ship"
      STR_SEA_GUNS_OUT: "Its guns are knocked out"
      STR_SEA_CANT_REACH_BELOW: "Guns can't reach below the waterline"
      STR_SEA_CANT_REACH_ABOVE: "That gun can't reach that high"
      STR_SEA_DISABLED: "{0}: ENGINES OUT - dead in the water. Board her before Cobra gets a tug out."
      STR_SEA_SUNK: "{0} SUNK"
      STR_SEA_BRIEFING_TITLE: "SEA FIGHT"
      STR_SEA_BRIEFING: "Floor 0 is under the water, floor 1 the surface, floor 2 the air.{NEWLINE}Jets fly on floor 2 and strike down at the ship. Its deck gun reaches the surface, its anti-aircraft gun the air.{NEWLINE}Hits from BEHIND go for the engines: knock them out and the ship stops dead - then it can be boarded. Hits from the front go for guns and steering. Enough hits anywhere sink her, cargo and all.{NEWLINE}12 rounds; a ship that reaches its exit edge gets away."
      STR_BRIEFING_COBRA_SHIP_BOARDING_TITLE: "BOARD THE SHIP"
      STR_BRIEFING_COBRA_SHIP_BOARDING: "She's dead in the water and her crew knows we're coming. Get aboard, take the bridge, and find out what's in the hold and where it was going. The manifest is aft in the hold; the log is on the chart table on the bridge."
  - type: en-GB
    strings: *seastr
