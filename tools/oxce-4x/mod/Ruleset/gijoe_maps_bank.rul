# MAPS 13 Nov 2026: BANK ROBBERY (cartel arc): the cartel robbing Millville Savings & Trust, Main Street, Millville (fixed 50 x 40 x 3, ground on level 0).
# Terrain order matters: MAP part ids are BLANKS(0-1), TOWN, AMBUSH, BANK, in this order. TOWN and AMBUSH are the same files as the ambush map's.
terrains:
  - name: BANK1
    mapDataSets:
      - BLANKS
      - TOWN
      - AMBUSH
      - BANK
    mapBlocks:
      - name: BANK1
        width: 50
        length: 40
        height: 3
        groups: [0]
mapScripts:
  - type: BANK1_SCRIPT
    commands:
      - type: addBlock
        size: [5, 4]
        groups: [0]
        rects:
          - [0, 0, 5, 4]
