# BUILD 14 Nov: test deployment for New Battle, Cobra data as for EMMA500.
alienDeployments:
  - type: STR_SPRING500
    terrains: [SPRING500]
    script: SPRING500
    width: 500
    length: 500
    height: 7
    shade: 0
    data:
      - alienRank: 5
        lowQty: 20
        highQty: 26
        dQty: 2
        percentageOutsideUfo: 100
        itemSets:
          - [STR_PISTOL, STR_PISTOL_CLIP, STR_PISTOL_CLIP]
          - [STR_RIFLE, STR_RIFLE_CLIP, STR_RIFLE_CLIP]
          - [STR_RIFLE, STR_RIFLE_CLIP, STR_RIFLE_CLIP]
    civilians: 24
    briefing: {palette: 0, title: STR_SPRING500, desc: STR_MAP_SPRINGFIELD_BRIEFING}

extraStrings:
  - type: en-US
    strings: &spring500
      STR_SPRING500: "Springfield 500"
      MAP_SPRING500: "Springfield (500 x 500)"
      STR_MAP_SPRINGFIELD_BRIEFING: "Springfield: a layout and play test. Downtown and the town square to the north, Rex Lewis Used Cars on the main crossroads, houses to the south. Ground is level 1; level 0 is the sewers. Cobra is spread through the town."
  - type: en-GB
    strings: *spring500
