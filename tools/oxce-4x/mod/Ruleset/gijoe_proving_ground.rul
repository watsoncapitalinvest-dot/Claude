# BEACH HEAD'S PROVING GROUND (John 13 Nov 2026, BUILD_DESIGN_ANSWERS_13Nov_Evening A4; John 21:24: it is Beach Head).
# Once a Training Room is finished, Beach Head turns up near that base to test the squad. It is a drill:
# every hit only stuns (the engine turns all damage into stun on STR_PROVING_GROUND), nobody is hurt,
# nobody is taken, and the whole squad comes home whatever happens. Put down every man of the cadre to
# pass: Beach Head joins at that base. Fail, pull out, or let it lapse (6 days), and he is back a week
# later, every week until the squad passes. GeoscapeState::time1Day spawns it; DebriefingState scores it.
#
# STAND-INS, to replace: the map is the Cartel Ranch (M1RANCH) until MAPS draws a proving ground
# (BRIEF_FOR_MAPS_ProvingGround.txt). The cadre wear Beach Head's and the greenshirt rifleman's looks,
# so they look like Joes, which is what they are; an armband or a vest for the cadre is ART's call.
# Beach Head's stats are the placeholder soldier ones until ROSTER's records are loaded (SHORTCUTS #5).

armors:
  - type: STR_DRILL_CADRE_BH_UC
    spriteSheet: GIJOE_BEACH_HEAD_BODY_HD.PCK
    spriteInv: GIJOE_DUKE_INV
    drawingRoutine: 23
    deathFrames: 8
    corpseBattle: [STR_DRILL_CADRE_DOWN]   # not recoverable: nobody brings the cadre home
    frontArmor: 12
    sideArmor: 8
    rearArmor: 5
    underArmor: 2
    loftempsSet: [ 3 ]
  - type: STR_DRILL_CADRE_UC
    spriteSheet: GIJOE_BEACH_HEAD_BODY_HD.PCK
    spriteInv: GIJOE_GREENSHIRT_RIFLEMAN_INV
    drawingRoutine: 23
    deathFrames: 8
    corpseBattle: [STR_DRILL_CADRE_DOWN]
    frontArmor: 10
    sideArmor: 6
    rearArmor: 4
    underArmor: 2
    loftempsSet: [ 3 ]

items:
  - type: STR_DRILL_CADRE_DOWN
    name: STR_CORPSE
    weight: 22
    bigSprite: 62
    floorSprite: 82
    invWidth: 2
    invHeight: 3
    battleType: 11
    recover: false

units:
  - type: STR_DRILL_BEACH_HEAD
    race: STR_DRILL_CADRE
    rank: STR_LIVE_LEADER
    stats: {tu: 70, stamina: 100, health: 50, bravery: 100, reactions: 70, firing: 70, throwing: 60, strength: 45, psiStrength: 40, psiSkill: 0, melee: 70}
    armor: STR_DRILL_CADRE_BH_UC
    standHeight: 22
    kneelHeight: 14
    value: 0
    deathSound: 41
    intelligence: 5
    aggression: 2
  - type: STR_DRILL_TRAINEE
    race: STR_DRILL_CADRE
    rank: STR_LIVE_SOLDIER
    stats: {tu: 56, stamina: 80, health: 35, bravery: 70, reactions: 50, firing: 52, throwing: 50, strength: 40, psiStrength: 40, psiSkill: 0, melee: 50}
    armor: STR_DRILL_CADRE_UC
    standHeight: 22
    kneelHeight: 14
    value: 0
    deathSound: 41
    intelligence: 3
    aggression: 2

alienRaces:
  - id: STR_DRILL_CADRE
    members:
      - STR_DRILL_BEACH_HEAD     # rank 0: Beach Head himself
      - STR_DRILL_TRAINEE
      - STR_DRILL_TRAINEE
      - STR_DRILL_TRAINEE
      - STR_DRILL_TRAINEE
      - STR_DRILL_TRAINEE
      - STR_DRILL_TRAINEE
      - STR_DRILL_TRAINEE

alienDeployments:
  - type: STR_PROVING_GROUND
    data:
      - alienRank: 0
        lowQty: 1
        highQty: 1
        dQty: 0
        percentageOutsideUfo: 100
        itemSets:
          - [STR_TRANQ_GUN, STR_TRANQ_DARTS, STR_TRANQ_DARTS]
      - alienRank: 5
        lowQty: 6
        highQty: 8
        dQty: 1
        percentageOutsideUfo: 100
        itemSets:
          - [STR_TRANQ_GUN, STR_TRANQ_DARTS, STR_TRANQ_DARTS]
    width: 50
    length: 40
    height: 4
    terrains: [M1RANCH]          # stand-in map
    script: M1RANCH_SCRIPT
    shade: 0
    duration: [144, 144]         # six days, then he is back in a week
    markerName: STR_PROVING_GROUND_SITE
    markerIcon: 22
    briefingData:
      palette: 0
      title: STR_PROVING_GROUND
      desc: STR_PROVING_GROUND_BRIEFING

alienMissions:
  - type: STR_PROVING_GROUND_MISSION
    points: 0
    objective: 3
    raceWeights:
      0:
        STR_DRILL_CADRE: 100
    waves:
      - ufo: STR_PROVING_GROUND
        count: 1
        trajectory: P0
        timer: 60
        objective: true

extraStrings:
  - type: en-US
    strings: &pgstr
      STR_DRILL_CADRE: "Drill Cadre"
      STR_DRILL_BEACH_HEAD: "Beach Head"
      STR_DRILL_TRAINEE: "Drill Cadre"
      STR_DRILL_CADRE_DOWN: "Downed cadre"
      STR_PROVING_GROUND: "Proving Ground"
      STR_PROVING_GROUND_SITE: "Proving ground"
      STR_PROVING_GROUND_BRIEFING: "A Ranger named Beach Head has heard you built a Training Room, and he does not think much of your people. He has set up a course and brought his own cadre. Every round is a stun round: nobody gets hurt, everybody gets embarrassed. Put down every one of them, Beach Head included, and he will come and train your Joes. Pull out or get put down yourselves, and he will be back next week."
      STR_PROVING_GROUND_UP: "Beach Head has set up a proving ground near {0}. Beat his cadre and he joins. Every hit only stuns."
      STR_PROVING_GROUND_PASSED: "Beach Head passed the squad. He has joined G.I. Joe at {0}."
      STR_PROVING_GROUND_FAILED: "Beach Head was not impressed. He will be back in a week."
  - type: en-GB
    strings: *pgstr
