# DAY 1 (DAY1_SETUP.md, all decided by John 12 Nov 2026). Shortcuts are listed in SHORTCUTS.md.
#
# Money: $1.0M a month from the Pentagon, $4M in the bank on Day 1 (the New Game slider
# starts on startingFunds and can move it).
initialFunding: 1000
startingFunds: 4000

# The A.P.C.: G.I. Joe's Day 1 troop truck. SHORTCUT #4: it is a craft that can cross water
# and lands on the Tomahawk's battle map until it has its own.
crafts:
  - type: STR_APC
    sprite: 0
    fuelMax: 3000
    damageMax: 120
    speedMax: 200
    accel: 1
    soldiers: 12          # the squad cap (DAY1_SETUP.md section 2)
    vehicles: 0
    costBuy: 0
    costRent: 0
    refuelRate: 100
    transferTime: 48
    score: 100
    battlescapeTerrainData:
      name: JOEHELO
      mapDataSets:
        - BLANKS
        - JOEHELO
      mapBlocks:
        - name: JOEHELO
          width: 10
          length: 10

# The Pit, level 1: Bare 5 (DAY1_SETUP.md section 4). SHORTCUT #3: stock room types under
# their Pit names - Access Lift is Command, Living Quarters the Barracks, General Stores the
# Stores, Laboratory the Lab, Hangar the Motor Pool. No radar on Day 1, no workshop.
startingBase:
  facilities:
    - type: STR_ACCESS_LIFT
      x: 2
      y: 2
    - type: STR_HANGAR
      x: 2
      y: 0
    - type: STR_LIVING_QUARTERS
      x: 3
      y: 2
    - type: STR_GENERAL_STORES
      x: 2
      y: 3
    - type: STR_LABORATORY
      x: 3
      y: 3
  # the starting 16 named Joes and 8 greenshirts (section 2). STR_SOLDIER is Roadblock.
  randomSoldiers:
    STR_HAWK: 1
    STR_DUKE: 1
    STR_SOLDIER: 1
    STR_ROCK_N_ROLL: 1
    STR_GRAND_SLAM: 1
    STR_SHORT_FUZE: 1
    STR_ZAP: 1
    STR_GRUNT: 1
    STR_STALKER: 1
    STR_BREAKER: 1
    STR_FLASH: 1
    STR_SCARLETT: 1
    STR_SNAKE_EYES: 1
    STR_DOC: 1
    STR_ACE: 1
    STR_AIRBORNE: 1
    STR_REGULAR_JOE: 6
    STR_JOE_MEDIC: 2
  crafts:
    - type: STR_APC
      id: 1
      fuel: 3000
      damage: 0
      status: STR_READY
  # Section 5, with the guns that exist as items today (SHORTCUT #7): the M4 Carbine for the
  # M-16, the Uzi for the pistol; no shotguns or flak vests yet; signature weapons where the
  # gun exists (Roadblock's .50 cal, Duke's M-32, Zap's launcher). 4 clips a gun.
  items:
    STR_RIFLE: 10
    STR_RIFLE_CLIP: 40
    STR_PISTOL: 6
    STR_PISTOL_CLIP: 24
    STR_GRENADE: 20
    STR_SMOKE_GRENADE: 10
    STR_MEDI_KIT: 4
    STR_HEAVY_CANNON: 1
    STR_HC_AP_AMMO: 4
    STR_AUTO_CANNON: 1
    STR_AC_AP_AMMO: 4
    STR_ROCKET_LAUNCHER: 1
    STR_SMALL_ROCKET: 4
  scientists: 10
  engineers: 10

extraStrings:
  - type: en-US
    strings:
      STR_APC: A.P.C.
  - type: en-GB
    strings:
      STR_APC: A.P.C.
