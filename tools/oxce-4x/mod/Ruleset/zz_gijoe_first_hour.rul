# THE FIRST HOUR (STORY's BRIEF_FOR_BUILD_FirstHour + Fixes2; John 16:39 "tighten up at least an hour of gameplay") and
# NOTE_FOR_BUILD_Hercules_Defiant (John 16:57 "hercules is the c130, defiant is the space shuttle at the outpost").
#
# The 26-seat cargo plane (STR_AVENGER, the AC-130 on the JOEDEFI apron) is the C-130 HERCULES, and needs its research.
# The Defiant is the shuttle complex at an outpost, a later design; nothing of it is a transport.
crafts:
  - type: STR_AVENGER
    requires: [STR_C130_HERCULES]

extraStrings:
  - type: en-US
    strings: &firstHourStrings
      STR_AVENGER: C-130 HERCULES
  - type: en-GB
    strings: *firstHourStrings
