# SABOTAGE (claude/SABOTAGE_DESIGN_v1.md, BRIEF_FOR_BUILD_Sabotage; John 16 Nov 02:41 go). Numbers: TUNING_RECORD row 53.
# The demolition charge: plant it beside a gun or a module (prime it, drop it), 40 TU, a demolitions specialist 20.
# Its timer is set between 2 and 5 turns. One charge destroys the target outright (a big blast on a small radius,
# hard on walls and objects). What it breaks at a Cobra site stays broken until Cobra repairs it (the site keeps
# its map from its first battle on).
# Specialists: the soldiers gijoe_departments.rul gives STR_GJR_SPEC_DEMOLITIONS_ENGINEERING, and Tripwire and
# Torpedo, whose dossiers make them demolitions men.
# NOT YET: Cobra disarming planted charges after the alarm (an AI change, next).

sabotage:
  charge: STR_DEMO_CHARGE
  timerMin: 2
  timerMax: 5
  specialists: [STR_SHORT_FUZE, STR_ZAP, STR_TRIPWIRE, STR_TORPEDO]

items:
  - type: STR_DEMO_CHARGE
    size: 0.2
    costBuy: 2500
    costSell: 1500
    weight: 6
    bigSprite: 22
    floorSprite: 22
    power: 220
    damageType: 3
    damageAlter:
      ToTile: 3.0
      RadiusReduction: 70
    battleType: 4
    invWidth: 2
    invHeight: 1
    blastRadius: 2
    fuseType: -1
    costPrime:
      time: 40
    flatPrime:
      time: 1                        # 40 TU flat, not 40% of the soldier's TU
    requiresBuy:
      - STR_C4_DEMOLITIONS
    listOrder: 2405

extraStrings:
  - type: en-US
    strings:
      STR_DEMO_CHARGE: Demolition Charge
