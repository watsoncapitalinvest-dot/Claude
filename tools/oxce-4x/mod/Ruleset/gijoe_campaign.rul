  - STR_PSI_LAB
  getOneFree:
  - STR_SNAKEMAN
  - STR_MUTON
  - STR_ETHEREAL
  - STR_FLOATER
  - STR_CHRYSSALID
  - STR_SECTOPOD
  - STR_CYBERDISC
  - STR_SILACOID
