# Every alien race fights as Cobra. Captured Cobra ranks interrogate like the alien ranks they replace.
# The war starts on 1 January 1982 (DAY1_SETUP.md, John 12 Nov). Vanilla's vars.rul sets
# 1 Jan 1999; this overrides it. 1 January 1982 was a Friday, and the engine counts
# weekdays from Sunday = 1, so Friday is 6.
startingTime:
  second: 0
  minute: 0
  hour: 12
  weekday: 6
  day: 1
  month: 1
  year: 1982
alienRaces:
- id: STR_SECTOID
  members:
  - STR_COBRA_COMMANDER_UNIT
  - STR_DESTRO_UNIT
  - STR_VIPER_ENGINEER
  - STR_VIPER_MEDIC
  - STR_STORM_SHADOW_UNIT
  - STR_COBRA_TROOPER
  - STR_BAT_TERRORIST
  - STR_BAT_TERRORIST
- id: STR_SNAKEMAN
  members:
  - STR_COBRA_COMMANDER_UNIT
  - STR_DESTRO_UNIT
  - STR_VIPER_ENGINEER
  - STR_VIPER_MEDIC
  - STR_STORM_SHADOW_UNIT
  - STR_COBRA_TROOPER
  - STR_BAT_TERRORIST
  - STR_BAT_TERRORIST
- id: STR_ETHEREAL
  members:
  - STR_COBRA_COMMANDER_UNIT
  - STR_DESTRO_UNIT
  - STR_VIPER_ENGINEER
  - STR_VIPER_MEDIC
  - STR_STORM_SHADOW_UNIT
  - STR_COBRA_TROOPER
  - STR_BAT_TERRORIST
  - STR_BAT_TERRORIST
- id: STR_MUTON
  members:
  - STR_COBRA_COMMANDER_UNIT
  - STR_DESTRO_UNIT
  - STR_VIPER_ENGINEER
  - STR_VIPER_MEDIC
  - STR_STORM_SHADOW_UNIT
  - STR_COBRA_TROOPER
  - STR_BAT_TERRORIST
  - STR_BAT_TERRORIST
- id: STR_FLOATER
  members:
  - STR_COBRA_COMMANDER_UNIT
  - STR_DESTRO_UNIT
  - STR_VIPER_ENGINEER
  - STR_VIPER_MEDIC
  - STR_STORM_SHADOW_UNIT
  - STR_COBRA_TROOPER
  - STR_BAT_TERRORIST
  - STR_BAT_TERRORIST
- id: STR_MIXED
  members:
  - STR_COBRA_COMMANDER_UNIT
  - STR_DESTRO_UNIT
  - STR_VIPER_ENGINEER
  - STR_VIPER_MEDIC
  - STR_STORM_SHADOW_UNIT
  - STR_COBRA_TROOPER
  - STR_BAT_TERRORIST
  - STR_BAT_TERRORIST
items:
- type: STR_COBRA_COMMANDER_UNIT
  size: 0.0
  recover: true
  liveAlien: true
  costSell: 60000
- type: STR_DESTRO_UNIT
  size: 0.0
  recover: true
  liveAlien: true
  costSell: 60000
- type: STR_VIPER_ENGINEER
  size: 0.0
  recover: true
  liveAlien: true
  costSell: 40000
- type: STR_VIPER_MEDIC
  size: 0.0
  recover: true
  liveAlien: true
  costSell: 40000
- type: STR_STORM_SHADOW_UNIT
  size: 0.0
  recover: true
  liveAlien: true
  costSell: 40000
- type: STR_COBRA_TROOPER
  size: 0.0
  recover: true
  liveAlien: true
  costSell: 40000
- type: STR_BAT_TERRORIST
  size: 0.0
  recover: true
  liveAlien: true
  costSell: 40000
# EVERY ONE OF THESE USED TO SAY `lookup: STR_SECTOID`, so interrogating Cobra
# Commander and interrogating a trooper opened the same article - the Viper
# one. It was not that only one article existed. en-US.yml already carries
# distinct Cobra entries, bound to the vanilla race slots:
#
#   STR_SECTOID    Viper          STR_MUTON     Iron Grenadier
#   STR_SNAKEMAN   Arashikage     STR_FLOATER   Air Viper
#   STR_ETHEREAL   Cobra Command  + six B.A.T. variants
#
# They were simply all pointed at the same one. A Viper, a Viper Medic and a
# Viper Engineer are all Vipers, so those three are right as they stand.
#
# STILL WRONG, and both need a decision rather than a guess:
#   STR_DESTRO_UNIT    - the only article that fits him is Cobra Command's,
#                        which puts him and Cobra Commander on the same page,
#                        one level up from the bug this fixes.
#   STR_BAT_TERRORIST  - there is no GENERIC B.A.T. article, only six named
#                        variants. Its stats lean Infiltrator (melee 60 over
#                        firing 50, aggression 3), but a rank 6-7 garrison
#                        filler reading as the Infiltrator is a design call.
#                        A captured B.A.T. is a machine, so a TEARDOWN entry
#                        may be the right shape instead - three already exist.
research:
- name: STR_COBRA_COMMANDER_UNIT
  cost: 192
  points: 50
  needItem: true
  destroyItem: true
  lookup: STR_ETHEREAL
  unlocks:
  - STR_LEADER_PLUS
  - STR_COMMANDER_PLUS
  - STR_ALIEN_ORIGINS
  - STR_PSI_LAB
- name: STR_DESTRO_UNIT
  cost: 192
  points: 50
  needItem: true
  destroyItem: true
