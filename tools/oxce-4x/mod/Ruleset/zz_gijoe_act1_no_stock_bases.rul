# G.I. Joe 4x, Act 1 layer: no stock X-COM alien bases anywhere in the world.
# The stock regions build an alien base (a "Terror Drome" in our strings) in the Pacific, Siberia, the poles... from month 1,
# and each one runs a monthly supply flight (200 "Cobra Supply" flights in a fast-forward year). The approved Act 1 has one
# Drome, built by Cobra's own network in North America and found only through the research chain (CobraNetwork.cpp).
# Weight 0 removes the option from the region; every other stock mission (research, harvest, abduction, infiltration,
# terror, retaliation) is left as it is until STORY/DESIGN say otherwise. New campaigns only: a save keeps its weights.
regions:
  - type: STR_NORTH_AMERICA
    missionWeights:
      STR_ALIEN_BASE: 0
  - type: STR_ARCTIC
    missionWeights:
      STR_ALIEN_BASE: 0
  - type: STR_ANTARCTICA
    missionWeights:
      STR_ALIEN_BASE: 0
  - type: STR_SOUTH_AMERICA
    missionWeights:
      STR_ALIEN_BASE: 0
  - type: STR_EUROPE
    missionWeights:
      STR_ALIEN_BASE: 0
  - type: STR_NORTH_AFRICA
    missionWeights:
      STR_ALIEN_BASE: 0
  - type: STR_SOUTHERN_AFRICA
    missionWeights:
      STR_ALIEN_BASE: 0
  - type: STR_CENTRAL_ASIA
    missionWeights:
      STR_ALIEN_BASE: 0
  - type: STR_SOUTH_EAST_ASIA
    missionWeights:
      STR_ALIEN_BASE: 0
  - type: STR_SIBERIA
    missionWeights:
      STR_ALIEN_BASE: 0
  - type: STR_AUSTRALASIA
    missionWeights:
      STR_ALIEN_BASE: 0
  - type: STR_PACIFIC
    missionWeights:
      STR_ALIEN_BASE: 0
