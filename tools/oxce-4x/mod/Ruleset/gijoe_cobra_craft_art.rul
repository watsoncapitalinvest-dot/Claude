# Cobra craft pictures. From build/install_fang_art.py.
#
# The interception window's picture of a Cobra craft. Vanilla cuts a 160x52
# strip out of INTERWIN.DAT by the ufo's sprite index; modSprite names a
# surface of its own instead, on PAL_GEOSCAPE. Its _hi twin is drawn over it by
# DogfightState (HiUI::spriteIn, 12 Nov engine).
extraSprites:
  - type: JOE_FANG_INTERCEPT
    singleImage: true
    width: 160
    height: 52
    files:
      0: Resources/Cobra/fang_intercept.png

ufos:
  - type: STR_SMALL_SCOUT          # the FANG
    modSprite: JOE_FANG_INTERCEPT
