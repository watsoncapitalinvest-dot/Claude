# G.I. Joe artillery called in from a battle (BUILD-2, 17 Nov 2026; engine: Battlescape/Artillery.cpp).
# Design: SHELLING_DESIGN_v1 / BRIEF_FOR_BUILD_Shelling (STORY), approved John 16 Nov 20:22-20:40; numbers TUNING_RECORD row 67.
# John 17 Nov 13:31: the Thunderclap goes to a mission like a landing craft (like the Tomahawk), so a gun craft sent to
# the mission is in range; one parked within rangeKm of the site also is.
# THE CALL: arm the field radio and "fire" it at a tile the Joes can see: SNAP = HE, AIMED = SMOKE, AUTO = INCENDIARY.
# It spends all his remaining TU; the salvo lands at the start of his side's next turn. Silent until the first impact,
# which raises the alarm.
artillery:
  radio: STR_FIELD_RADIO
  roundHE: STR_ARTY_ROUND_HE
  roundSmoke: STR_ARTY_ROUND_SMOKE
  roundIncendiary: STR_ARTY_ROUND_INCENDIARY
  shells: 4
  salvoes: 3                # per gun per battle
  scatter: 10               # tiles
  specialistScatter: 3
  dangerBlast: 5            # DANGER CLOSE: a Joe within scatter + this of the aim point gets a warning; call again to confirm
  # specialistTypes: [..]   # soldier types who always count as specialists (none named yet)
  specialistSpecialties: [STR_GJR_SPEC_COMMS_TECH, STR_GJR_SPEC_RECON_SNIPER]  # BUILD-2's pick: no artillery specialty exists
  guns:
    # Joes. The Thunderclap: VFACTORY built it 17 Nov as two 3x3 battle units (tractor + trailer); the gun counts while
    # either half is on the field. STR_THUNDERCLAP stays as the craft id in case it also becomes a landing craft.
    - {id: ANNIHILATOR, side: JOE, label: ANNIHILATOR, crafts: [STR_THUNDERCLAP], units: [STR_GJ_VEH_THUNDERCLAP_TRACTOR, STR_GJ_VEH_THUNDERCLAP_TRAILER], rangeKm: 40}
    - {id: EX700, side: JOE, label: EX-700 HOWITZER, facilities: [STR_GJ_MOUNTAIN_HOWITZER], rangeKm: 25}
    - {id: MORTAR, side: JOE, label: MORTAR, facilities: [STR_GJ_MORTAR_DEFENSE, STR_GJ_MORTAR_LAUNCHER], rangeKm: 6}
    # Cobra: fires once Cobra has the project. Neither project exists in Cobra's tree yet (STORY to add), so Cobra
    # does not shell until they do. Its spotter is its leader.
    - {id: MAGGOT, side: COBRA, label: MAGGOT RAP LONG-RANGE, cobraProject: STR_COBRA_MAGGOT, rangeKm: 40}
    - {id: ADDER, side: COBRA, label: WHITE HEAT II, cobraProject: STR_COBRA_ADDER, rangeKm: 80}

items:
  - type: STR_FIELD_RADIO
    categories: [STR_JOE_KIT]
    size: 0.1
    costBuy: 3000
    costSell: 1500
    weight: 4
    bigSprite: 23
    floorSprite: 23
    battleType: 1
    twoHanded: false
    clipSize: -1
    invWidth: 1
    invHeight: 2
    accuracySnap: 100
    accuracyAimed: 100
    accuracyAuto: 100
    tuSnap: 10
    tuAimed: 10
    tuAuto: 10
    autoShots: 1
    maxRange: 250
    confSnap: {name: STR_ARTY_CALL_HE}
    confAimed: {name: STR_ARTY_CALL_SMOKE}
    confAuto: {name: STR_ARTY_CALL_INCENDIARY}
    recover: true
  # the rounds: never carried, made at the moment each shell lands
  - type: STR_ARTY_ROUND_HE
    size: 0
    battleType: 4
    power: 120
    damageType: 3
    blastRadius: 4
  - type: STR_ARTY_ROUND_SMOKE
    size: 0
    battleType: 4
    power: 70
    damageType: 9
    blastRadius: 5
  - type: STR_ARTY_ROUND_INCENDIARY
    size: 0
    battleType: 4
    power: 70
    damageType: 2
    blastRadius: 4

extraStrings:
  - type: en-US
    strings:
      STR_FIELD_RADIO: Field Radio
      STR_ARTY_CALL_HE: Call HE
      STR_ARTY_CALL_SMOKE: Call Smoke
      STR_ARTY_CALL_INCENDIARY: Call Incendiary
      STR_ARTY_ROUND_HE: Artillery HE
      STR_ARTY_ROUND_SMOKE: Artillery smoke
      STR_ARTY_ROUND_INCENDIARY: Artillery incendiary
      STR_ARTY_CALLED_HE: "Fire mission called: HE lands next turn"
      STR_ARTY_CALLED_SMOKE: "Fire mission called: smoke lands next turn"
      STR_ARTY_CALLED_INCENDIARY: "Fire mission called: incendiary lands next turn"
      STR_ARTY_NO_GUN: "No gun in range"
      STR_ARTY_NO_SALVOES: "The guns have no salvoes left"
      STR_ARTY_NOT_SEEN: "Pick a spot he can see"
      STR_ARTY_DANGER_CLOSE: "Danger close: Joes in the impact zone. Call again on the same spot to confirm"
  - type: en-GB
    strings:
      STR_FIELD_RADIO: Field Radio
      STR_ARTY_CALL_HE: Call HE
      STR_ARTY_CALL_SMOKE: Call Smoke
      STR_ARTY_CALL_INCENDIARY: Call Incendiary
      STR_ARTY_ROUND_HE: Artillery HE
      STR_ARTY_ROUND_SMOKE: Artillery smoke
      STR_ARTY_ROUND_INCENDIARY: Artillery incendiary
      STR_ARTY_CALLED_HE: "Fire mission called: HE lands next turn"
      STR_ARTY_CALLED_SMOKE: "Fire mission called: smoke lands next turn"
      STR_ARTY_CALLED_INCENDIARY: "Fire mission called: incendiary lands next turn"
      STR_ARTY_NO_GUN: "No gun in range"
      STR_ARTY_NO_SALVOES: "The guns have no salvoes left"
      STR_ARTY_NOT_SEEN: "Pick a spot he can see"
      STR_ARTY_DANGER_CLOSE: "Danger close: Joes in the impact zone. Call again on the same spot to confirm"
