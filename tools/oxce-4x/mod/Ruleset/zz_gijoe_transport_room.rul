# How many men and vehicles each transport carries (BUILD-1, 19 Nov, John: "1 and 2").
# A vehicle takes seats by its footprint: Ferret 4, VAMP/Wolverine/Stinger/Thunder 9,
# Mobat/H.I.S.S. 16, Mauler 25. 'soldiers' is the seat count; maxSoldiers caps the men,
# so the seat count decides which vehicles physically fit. The A.P.C. is in gijoe_day1.rul.
crafts:
  - type: STR_SKYRANGER      # Tomahawk: one LIGHT vehicle (up to 9 seats) with 6 men, or 14 men.
    soldiers: 15             # a Mobat (16) or Mauler (25) does not fit
    maxSoldiers: 14
    vehicles: 1
    maxVehicles: 1
  - type: STR_AVENGER        # C-130 Hercules: two of anything, Mauler included, with the squad.
    soldiers: 67             # 26 men + Mauler 25 + Mobat 16
    maxSoldiers: 26
    vehicles: 2
    maxVehicles: 2
