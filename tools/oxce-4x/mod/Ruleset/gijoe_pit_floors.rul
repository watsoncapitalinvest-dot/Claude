# The Pit's five floors and its surface (claude/PIT_FLOORS_v1.md, approved by John 15 Nov 02:14-08:38).
# Engine: Mod::PitFloorRules, Outposts::canBuild / canList, BaseView, Base::getDisconnectedFacilities.
# The 6 x 6 grid is six blocks of 3 x 2 free squares, one per floor (the fixed shaft column is not drawn):
#   Surface (cols 0-2, rows 0-1)    1 Staging (cols 3-5, rows 0-1)
#   2 Operations (0-2, 2-3)         3 Training (3-5, 2-3)
#   4 Quarters (0-2, 4-5)           5 Utility (3-5, 4-5)
# A room goes only on its own floor, wholly inside it; every floor is reached by the shafts, so no corridors.
# A room not listed here can't be built in a Pit (the Aircraft Hangar: jets fly from an outpost).
# NOT YET: the HQ airfield Day 1 outpost; the
# Research Lab and Manufacturing outposts; the big Lab / Fabrication Shop as outpost add-ons; base defence on
# the stacked canon Pit (MAPS) - until then the six floors fight side by side on one flat map.
pitFloors:
  surfaceCap: 99                  # no cap (John 12:52, BRIEF_FOR_BUILD_SurfaceInstall): every surface defence can go in
  names: [STR_PIT_FLOOR_SURFACE, STR_PIT_FLOOR_STAGING, STR_PIT_FLOOR_OPERATIONS, STR_PIT_FLOOR_TRAINING, STR_PIT_FLOOR_QUARTERS, STR_PIT_FLOOR_UTILITY]
  floors:
    STR_SMALL_RADAR_SYSTEM: 0
    STR_LARGE_RADAR_SYSTEM: 0
    STR_MISSILE_DEFENSES: 0
    STR_LASER_DEFENSES: 0
    STR_PLASMA_DEFENSES: 0
    STR_GRAV_SHIELD: 0              # the Sonic Barrier (gijoe_pit_surface.rul)
    STR_GJ_AA_GUN: 0
    STR_GJ_AIR_DEFENSE: 0
    STR_GJ_MORTAR_DEFENSE: 0
    STR_GJ_MORTAR_LAUNCHER: 0
    STR_GJ_MOUNTAIN_HOWITZER: 0
    STR_GJ_LAW: 0
    STR_HANGAR: 1                 # Motor Pool and Vehicle Lift
    STR_WORKSHOP: 1               # Workbench
    STR_ACCESS_LIFT: 2            # Command Center
    STR_COMPUTER_STATION: 2
    STR_JOE_COMMS_CENTER: 2
    STR_HYPER_WAVE_DECODER: 2     # Signals Intelligence Center
    STR_TRAINING_ROOM: 3
    STR_RECRUITING_OFFICE: 3
    STR_LIVING_QUARTERS: 4        # Bunks / Barracks
    STR_GENERAL_STORES: 4         # Weapons Locker / stores
    STR_JOE_ARMORY: 4
    STR_INFIRMARY_ROOM: 4
    STR_LABORATORY: 5             # Lab Bench
    STR_ALIEN_CONTAINMENT: 5      # Detention Block
    STR_PSIONIC_LABORATORY: 5     # Brainwave Laboratory
    STR_MIND_SHIELD: 5            # Jammer

facilities:
  - type: STR_LABORATORY          # a Lab Bench seats 10 (PIT_FLOORS_v1 section 4; the big Lab is off site)
    laboratories: 10

extraStrings:
  - type: en-US
    strings: &pitfl
      STR_PIT_FLOOR_SURFACE: "SURFACE"
      STR_PIT_FLOOR_STAGING: "1 STAGING"
      STR_PIT_FLOOR_OPERATIONS: "2 OPERATIONS"
      STR_PIT_FLOOR_TRAINING: "3 TRAINING"
      STR_PIT_FLOOR_QUARTERS: "4 QUARTERS"
      STR_PIT_FLOOR_UTILITY: "5 UTILITY"
      STR_ACCESS_LIFT: "Command Center"
      STR_HANGAR: "Motor Pool"
      STR_LABORATORY: "Lab Bench"
      STR_WORKSHOP: "Workbench"
      STR_PIT_SURFACE_FULL: "The Surface is full: the cover can hide only so much. Motor Pool Cover I and II make room for more."
      STR_PIT_WRONG_FLOOR: "That room goes on another floor of the Pit. The build list says which."
  - type: en-GB
    strings: *pitfl
