# A photographic earth painted over the flat polygons. Globe::drawEarthTexture
# looks this up by name and does nothing at all if it is absent, so the mod
# still runs without it.
#
# The image is an 8-bit equirectangular map on PAL_GEOSCAPE, Greenwich at the
# LEFT edge, with index 0 meaning "sea - leave it to drawOcean" and no land
# pixel anywhere in the ocean block 192-223. Both of those are required by
# drawShadow, not stylistic.
extraSprites:
  - type: GLOBE_EARTH
    singleImage: true
    width: 2048
    height: 1024
    files:
      0: Resources/Globe/earth.png
