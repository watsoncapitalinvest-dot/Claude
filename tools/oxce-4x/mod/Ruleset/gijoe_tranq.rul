# TRANQUILIZER GUN (John 13 Nov 2026, CAPTURE_DESIGN_v1 Part 1: stun gear, researched first).
# John 17:31: no existing topic opens it, so it is its own topic, researchable from Day 1.
# A dart pistol: stun damage only, so a man it drops is knocked out, not killed, and comes home as a
# prisoner if the Joes win. Bought once researched (Day 1 has no workshop), or built in a workshop.
# Placeholder look: the stock pistol's sprites until ART draws it. Numbers are BUILD's first pass.

research:
  - name: STR_TRANQ_GUN
    lane: ARMORY
    cost: 60
    points: 10
    costFunds: 60000

items:
  - type: STR_TRANQ_GUN
    size: 0.1
    costBuy: 1500
    costSell: 900
    requiresBuy: [STR_TRANQ_GUN]
    weight: 5
    bigSprite: 3
    floorSprite: 3
    handSprite: 96
    bulletSprite: 1
    fireSound: 4
    compatibleAmmo:
      - STR_TRANQ_DARTS
    accuracySnap: 55
    accuracyAimed: 75
    tuSnap: 20
    tuAimed: 32
    maxRange: 12                 # a dart pistol: short range
    battleType: 1
    invWidth: 1
    invHeight: 2
  - type: STR_TRANQ_DARTS
    size: 0.1
    costBuy: 100
    costSell: 60
    requiresBuy: [STR_TRANQ_GUN]
    weight: 2
    bigSprite: 4
    floorSprite: 4
    hitSound: 22
    hitAnimation: 26
    power: 45
    damageType: 6                # stun: knocks out, never kills
    clipSize: 6
    battleType: 2
    armor: 12

manufacture:
  - name: STR_TRANQ_GUN
    category: STR_WEAPON
    requires: [STR_TRANQ_GUN]
    space: 2
    time: 150
    cost: 1200
  - name: STR_TRANQ_DARTS
    category: STR_AMMUNITION
    requires: [STR_TRANQ_GUN]
    space: 2
    time: 40
    cost: 80

ufopaedia:
  - id: STR_TRANQ_GUN
    type_id: 4
    section: STR_WEAPONS_AND_EQUIPMENT
    requires: [STR_TRANQ_GUN]
    text: STR_TRANQ_GUN_UFOPEDIA
  - id: STR_TRANQ_DARTS
    type_id: 4
    section: STR_NOT_AVAILABLE

extraStrings:
  - type: en-US
    strings: &tranqstr
      STR_TRANQ_GUN: "Tranquilizer Gun"
      STR_TRANQ_DARTS: "Tranquilizer Darts"
      STR_TRANQ_GUN_UFOPEDIA: "A dart pistol that puts a man down without killing him. Short range and slow to fire, but whoever it drops can be cuffed and questioned. Six darts to a magazine."
  - type: en-GB
    strings: *tranqstr
