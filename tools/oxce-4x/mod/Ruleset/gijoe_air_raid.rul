# AIR RAIDS, phase 1: the Joes bomb a Cobra site (claude/AIR_RAID_DESIGN_v1.md; John 16 Nov 14:26 "Go").
# Engine: Geoscape/AirRaid.cpp. A bomber that reaches a Cobra site is offered BOMB beside landing.
# Numbers are TUNING_RECORD rows 51 and 55 (first guesses). Two are BUILD's, not the design's:
#   bombers  - which Joe aircraft carry bombs, and how many (nobody has said yet)
#   siteGuns - what each Cobra site defends itself with: a STAND-IN until COBRA_OUTPOSTS_v1 settles it
#   downOnHit - a hit downs the plane half the time, else it drops at -40 (the design says both, not which)
airRaid:
  # A plane makes ONE bombing run: one roll on the ladder, its whole load lands as a stick along the run
  # (John 16 Nov 15:39). The Tomahawk can't bomb (John 15:39).
  bombers:
    STR_INTERCEPTOR: {bombs: 2}        # Skystriker
    STR_FIRESTORM: {bombs: 2}          # Conquest
  accuracy: [95, 80, 55]               # direct-hit chance: slow, medium, fast
  guns:
    STR_AR_GUN_AA: {shots: 3, chance: 50, kind: aa}
    STR_AR_GUN_FLAK: {shots: 4, chance: 35, kind: flak}
    STR_AR_GUN_AIR: {shots: 2, chance: 60, kind: air}
    STR_AR_GUN_MISSILE: {shots: 2, chance: 75, kind: missile}
    STR_AR_GUN_MG: {shots: 2, chance: 15, kind: mg}
  siteGuns:
    STR_COBRA_FRONT_COMPANY: []
    STR_COBRA_FACTORY: [STR_AR_GUN_AA]
    STR_COBRA_TRAINING_CAMP: [STR_AR_GUN_MG, STR_AR_GUN_MG]
    STR_COBRA_DEPOT: [STR_AR_GUN_AA]
    STR_COBRA_RESEARCH_LAB: [STR_AR_GUN_AA]
    STR_COBRA_TERROR_DROME: [STR_AR_GUN_AA, STR_AR_GUN_AA, STR_AR_GUN_AIR]
    STR_COBRA_BROADCAST_STATION: [STR_AR_GUN_MG]
    STR_COBRA_HIDDEN_HQ: [STR_AR_GUN_AA, STR_AR_GUN_FLAK, STR_AR_GUN_MISSILE]
    STR_COBRA_AIRSTRIP: [STR_AR_GUN_AA, STR_AR_GUN_AA]
  graze: 20
  hit: 40
  downOnHit: 50
  flakSplash: 3
  lightPower: 120
  lightRadius: 4
  heavyPower: 200
  heavyRadius: 6
  grazeDamage: 10
  hitDamage: 50
  lossScale: 3                         # Cobra loses 3% of what the site holds for every 1% of the site's parts destroyed
  lossCap: 60
  repairDays: 10                       # Cobra repairs a bombed site in 10 days, starting the day its region can pay half the build cost

  # --- phase 3: Cobra bombs the Joes' outposts (AIR_RAID_DESIGN_v1 s.1; TUNING_RECORD row 52) ---
  # Only an outpost Cobra has found (the engine's retaliation mark), never the Pit, and only with Rattlers based
  # at a Cobra airstrip within reach. Monthly chance = 10% per threat point, at most 60%, rolled a day at a time.
  # Not in yet: +1 threat per Cobra loss the outpost caused that month (nothing counts those losses yet).
  threatByKind:
    STR_OUTPOST_LISTENING_POST: 3
    STR_OUTPOST_AIRSTRIP: 3
    STR_OUTPOST_HQ_AIRFIELD: 3
    STR_OUTPOST_PORT: 2
    STR_OUTPOST_MANUFACTURING: 2
    STR_OUTPOST_RESEARCH_LAB: 1
    STR_OUTPOST_FORWARD_CAMP: 1
    STR_OUTPOST_TTBP: 1
  chancePerThreat: 10
  chanceCap: 60
  rangeKm: 3000                        # a Rattler's reach from its airstrip (BUILD's first number)
  maxPlanes: 6
  bomberRebuildDays: 14                # an airstrip builds back a lost Rattler in 14 days, one at a time
  bomberName: STR_AR_RATTLER
  # what a Joe facility fires as in the pass (the HQ cannon counts as a flak gun: TUNING_RECORD row 54)
  facilityGuns:
    STR_OP_FLAK_GUN: STR_AR_GUN_FLAK
    STR_OP_PLATFORM_AA: STR_AR_GUN_AA
    STR_OP_OUTPOST_DEFENDER: STR_AR_GUN_MG
    STR_GJ_AA_GUN: STR_AR_GUN_AA
    STR_GJ_AIR_DEFENSE: STR_AR_GUN_AIR

extraStrings:
  - type: en-US
    strings:
      STR_AR_BOMB: BOMB IT
      STR_AR_TITLE: "AIR RAID: {0}"
      STR_AR_FLY: FLY
      STR_AR_CANCEL: CANCEL
      STR_AR_PLAN: "Click a plane to pick it, click it again to change its speed, then click the map for its target. Slow aims best and is easiest to hit."
      STR_AR_DEFENCES: "Its guns:"
      STR_AR_NONE: none known
      STR_AR_SLOW: SLOW
      STR_AR_MEDIUM: MEDIUM
      STR_AR_FAST: FAST
      STR_AR_DOWN: DOWN
      STR_AR_SHOT_DOWN: shot down
      STR_AR_SHOT_HIT: hit
      STR_AR_SHOT_GRAZE: grazed
      STR_AR_SHOT_MISS: missed
      STR_AR_DIRECT: direct hit
      STR_AR_NEAR: near miss
      STR_AR_WALL: short, on the wall
      STR_AR_CLEAN: clean miss
      STR_AR_RESULT: "{0} parts of the site destroyed. Cobra men down: {1} (health lost {2}). Cobra's books lose {3}."
      STR_AR_GUN_AA: AA gun
      STR_AR_GUN_FLAK: Flak gun
      STR_AR_GUN_AIR: Air defence
      STR_AR_GUN_MISSILE: Missile defence
      STR_AR_GUN_MG: MG nest
      STR_AR_RATTLER: Rattler
      STR_AR_FIRE: FIRE
      STR_AR_LEAD: lead
      STR_AR_NOTHING: nothing
      STR_AR_SHOT_ALREADY_DOWN: already down
      STR_AR_DEFEND_TITLE: "COBRA BOMBERS: {0}"
      STR_AR_DEFEND_PLAN: "{0} x {1} inbound. You can't see their speeds or targets. Each row is one shot: left-click picks the plane, right-click the lead (your guess at its speed). Slow needs a short lead."
      STR_AR_NO_GUNS: "No guns here: nothing to fire."
      STR_AR_DEFEND_RESULT: "Planes down: {0} of {1}. Out of action until repaired: {2}. Repairs: {3}."
