# G.I. Joe: the Tomahawk's landing craft (MAPS 16 Nov, TOMCRAFT v3.2 / TOMCRAFTG v2.1 / TOMCRAFTM v2 / TOMCRAFTGM v1).
# The Tomahawk (craft STR_SKYRANGER) lands on MAPS' gutted, repainted Generals model: a 12 x 24 x 4 map padded to 20 x 30
# (build/pad_map2.py). A battle map lower than 4 levels is raised to fit it (engine). The squad starts in the troop bay.
# Variants (engine craftVariants): the last one whose research is done is the map. The door-gun and missile upgrades are
# BUILD placeholders until STORY writes them (NOTE_TomahawkUpgrades.txt). Rules (John 16 Nov): the door guns are remote
# turrets the PILOT works from the cockpit - on the map only with a pilot aboard - and they take 2 of the squad's seats (John 17 Nov
# 11:06); the missiles are scenery on the battle map.
# Maps, routes and terrain are private (John's Generals model): zip only.
terrains:
  - name: TOMCRAFTG_T
    mapDataSets: [BLANKS, TOMHULL, TOMTOP, TOMGUN]
    mapBlocks:
      - {name: TOMCRAFTG, width: 20, length: 30, height: 4}
  - name: TOMCRAFTM_T
    mapDataSets: [BLANKS, TOMHULLM, TOMTOP]
    mapBlocks:
      - {name: TOMCRAFTM, width: 20, length: 30, height: 4}
  - name: TOMCRAFTGM_T
    mapDataSets: [BLANKS, TOMHULLM, TOMTOP, TOMGUN]
    mapBlocks:
      - {name: TOMCRAFTGM, width: 20, length: 30, height: 4}

crafts:
  - type: STR_SKYRANGER
    deployment: []
    craftInventoryTile: [4, 10, 0]
    battlescapeTerrainData:
      name: TOMCRAFT
      mapDataSets: [BLANKS, TOMHULL, TOMTOP]
      mapBlocks:
        - name: TOMCRAFT
          width: 20
          length: 30
          height: 4

craftVariants:
  - {craft: STR_SKYRANGER, research: STR_TOMAHAWK_DOOR_GUNS, terrain: TOMCRAFTG_T, guns: [[4, 10, 0], [7, 10, 0]], gunUnit: STR_TOM_DOOR_GUN, gunItem: STR_TOM_DOOR_GUN, seatsLost: 2}
  - {craft: STR_SKYRANGER, research: STR_TOMAHAWK_MISSILE_RACKS, terrain: TOMCRAFTM_T}
  - {craft: STR_SKYRANGER, research: STR_TOMAHAWK_DOOR_GUNS+STR_TOMAHAWK_MISSILE_RACKS, terrain: TOMCRAFTGM_T, guns: [[4, 10, 0], [7, 10, 0]], gunUnit: STR_TOM_DOOR_GUN, gunItem: STR_TOM_DOOR_GUN, seatsLost: 2}

research:
  - name: STR_TOMAHAWK_DOOR_GUNS        # BUILD placeholder (STORY to write); John 16 Nov 22:41-22:56
    lane: AIR_WING
    cost: 60
    points: 5
    dependencies: [STR_TOMAHAWK]
  - name: STR_TOMAHAWK_MISSILE_RACKS    # BUILD placeholder (STORY to write); John 16 Nov 23:02-23:21; scenery on the battle map
    lane: AIR_WING
    cost: 60
    points: 5
    dependencies: [STR_TOMAHAWK]

extraSprites:
  - type: TOM_DOORGUN.PCK
    width: 2048
    height: 5120
    subX: 128
    subY: 160
    files:
      0: Resources/VehiclesPrivate/tom_doorgun_body.png

units:
  - type: STR_TOM_DOOR_GUN
    race: STR_TOM_DOOR_GUN
    armor: GJ_TOM_DOOR_GUN_ARMOR
    stats: {tu: 50, stamina: 100, health: 40, bravery: 110, reactions: 50, firing: 60, throwing: 0, strength: 100, psiStrength: 100, psiSkill: 0, melee: 0}
    standHeight: 16
    kneelHeight: 16
    value: 0
    deathSound: 23
    energyRecovery: 50

armors:
  - type: GJ_TOM_DOOR_GUN_ARMOR
    spriteSheet: TOM_DOORGUN.PCK
    drawingRoutine: 23
    deathFrames: 8
    size: 1
    frontArmor: 40
    sideArmor: 30
    rearArmor: 20
    underArmor: 20
    allowInv: false
    allowsKneeling: false
    allowsRunning: false
    allowsMoving: false
    corpseBattle: [STR_AF_WRECK]
    loftempsSet: [3]

items:
  - type: STR_TOM_DOOR_GUN
    battleType: 1
    fixedWeapon: true
    invWidth: 2
    invHeight: 3
    weight: 1
    size: 1
    bigSprite: 340
    floorSprite: 0
    handSprite: 0
    bulletSprite: 2
    fireSound: [727, 728, 729]
    compatibleAmmo: [STR_TOM_DOOR_GUN_AMMO]
    recover: false
    accuracySnap: 50
    tuSnap: 25
    accuracyAuto: 40
    tuAuto: 35
    confAuto: {shots: 6}
  - type: STR_TOM_DOOR_GUN_AMMO
    battleType: 2
    clipSize: 300
    power: 32
    damageType: 1
    weight: 1
    invWidth: 1
    invHeight: 1
    bigSprite: 12
    floorSprite: 12
    recover: false
    hitSound: [577, 578, 579, 574, 575]
    hitAnimation: 26

extraStrings:
  - type: en-US
    strings: &tomstr
      STR_TOM_DOOR_GUN: Door Gun
      STR_TOM_DOOR_GUN_AMMO: Door Gun Belt
      STR_TOMAHAWK_DOOR_GUNS: Tomahawk Door Guns
      STR_TOMAHAWK_MISSILE_RACKS: Tomahawk Missile Racks
      STR_TOMAHAWK_DOOR_GUNS_UFOPEDIA: "Two chain guns on the troop-bay doors, worked from the cockpit by the pilot. Bring a pilot and they cover the landing."
      STR_TOMAHAWK_MISSILE_RACKS_UFOPEDIA: "M.M.S. missiles under the stub wings."
  - type: en-GB
    strings: *tomstr
