armors:
  - type: STR_ROADBLOCK_UC
    spriteSheet: GIJOE_ROADBLOCK_HD.PCK
    spriteInv: GIJOE_ROADBLOCK_INV
    corpseBattle: [STR_CORPSE_ROADBLOCK]
    frontArmor: 14
    sideArmor: 10
    rearArmor: 6
    underArmor: 2
    loftempsSet: [ 3 ]
  - type: STR_SNAKE_EYES_UC
    drawingRoutine: 23
    deathFrames: 8
    spriteSheet: GIJOE_SNAKE_EYES_BODY_HD.PCK   # whole-body frames, see gijoe_body_sheets.rul
    spriteInv: GIJOE_SNAKE_INV
    corpseBattle: [STR_CORPSE_SNAKE]
    frontArmor: 12
    sideArmor: 8
    rearArmor: 5
    underArmor: 2
    loftempsSet: [ 3 ]
