# OPTIONAL, and it belongs with zz_gijoe_frontops_economy.rul - delete either
# or both, nothing else changes.
#
# Your front-op scripts in gijoe_frontops.rul name no region, so they put
# fronts anywhere on the globe. That was fine while they were scenery. The
# moment the economy file tells it those fronts are earners, Cobra's economy
# goes worldwide with them - measured over eleven months, fourteen Cobra
# sites with nine of them outside North America.
#
# Only North America has G.I. Joe terrain. A raid on the other nine lands on
# a map that looks like X-COM, which is the thing the region lock exists to
# prevent.
#
# So this holds the front ops to North America, the same way the generated
# Cobra site scripts are held. Over the same eleven months:
#
#   economy file alone        14 sites, 9 of them outside North America
#   both files               (this run, see below)
#   neither                   3 sites, all North America
#
# When the rest of the world gets terrain, delete this file and Cobra
# expands into it on its own.

missionScripts:
  - type: cobraFronts
    regionWeights:
      0:
        STR_NORTH_AMERICA: 100
  - type: cobraFrontOpening
    regionWeights:
      0:
        STR_NORTH_AMERICA: 100
