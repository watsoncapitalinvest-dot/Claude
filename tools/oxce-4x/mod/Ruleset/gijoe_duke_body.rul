# Duke in the approved look (design chat, 12 Nov): whole-body frames rendered from
# the rigged model by build/sprites/render_soldier.py + assemble_sheet.py, drawn by
# UnitSprite::drawRoutineWhole (routine 23). Hands per frame in
# Resources/Units/anchors/GIJOE_DUKE_BODY_HD.PCK.txt hold whatever weapon he carries.
# The armour that uses it (STR_DUKE_UC) is in gijoe_units.rul.
extraSprites:
  - type: GIJOE_DUKE_BODY_HD.PCK
    width: 2048
    height: 3200
    subX: 128
    subY: 160
    files:
      0: Resources/Units/duke_body.png
