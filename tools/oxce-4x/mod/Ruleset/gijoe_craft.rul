# The Joe transport: the Skyranger's battle map is replaced by a tandem-rotor helicopter on a helipad.
crafts:
  - type: STR_SKYRANGER
    battlescapeTerrainData:
      name: JOEHELO
      mapDataSets:
        - BLANKS
        - JOEHELO
      mapBlocks:
        - name: JOEHELO
          width: 10
          length: 10
# Phantom X-19 (the old Lightning): Comanche on a pad. Defiant (the old Avenger): AC-130 on a 10x20 apron.
  - type: STR_LIGHTNING
    deployment: []   # the stock fixed positions were inside the old interior
    battlescapeTerrainData:
      name: JOEPHANT
      mapDataSets:
        - BLANKS
        - JOEPHANT
      mapBlocks:
        - name: JOEPHANT
          width: 10
          length: 10
  - type: STR_AVENGER
    deployment: []
    battlescapeTerrainData:
      name: JOEDEFI
      mapDataSets:
        - BLANKS
        - JOEDEFI
      mapBlocks:
        - name: JOEDEFI
          width: 10
          length: 20
