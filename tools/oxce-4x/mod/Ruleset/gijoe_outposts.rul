alienDeployments:
  - type: STR_OUTPOST_RAID_FORWARD_CAMP
    data:
      - alienRank: 5
        lowQty: 6
        highQty: 8
        dQty: 1
        percentageOutsideUfo: 100
        itemSets:
          - [STR_PISTOL, STR_PISTOL_CLIP, STR_PISTOL_CLIP]
          - [STR_RIFLE, STR_RIFLE_CLIP, STR_RIFLE_CLIP]
          - [STR_RIFLE, STR_RIFLE_CLIP, STR_RIFLE_CLIP]
    width: 50
    length: 50
    height: 4
    terrains: [CULTA]
    script: FARM
    shade: 0
    briefing:
      palette: 0
      title: STR_OUTPOST_RAID_TITLE
      desc: STR_OUTPOST_RAID_BRIEFING
