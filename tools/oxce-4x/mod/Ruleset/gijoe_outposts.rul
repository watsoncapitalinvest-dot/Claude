# G.I. Joe OUTPOSTS (claude/OUTPOSTS_v2_DECISIONS.md, John 14 Nov 15:40-16:31). Engine: src/Geoscape/Outposts.
# An outpost is a base underneath, but a fixed place drawn by MAPS: it comes with its buildings in place and
# the player builds add-ons only on its pads. Founding: pick the spot on the globe, then the kind.
# Boats are kept only at piers (outposts.boats / piers). A raid on an outpost plays on its own deployment.
#
# PLACEHOLDERS until MAPS' maps (BRIEF_FOR_MAPS_Outposts.txt) and STORY's research arrive:
# - the raid maps are stock farmland (land kinds) and the freighter's deck (the TTBP);
# - the buildings and add-ons wear the Pit's room art;
# - add-ons need no research yet; the TTBP and the extra Pit wait on STORY's topics
#   (STR_TACTICAL_BATTLE_PLATFORM, STR_SECOND_PIT), which do not exist yet, so neither can be founded.

outposts:
  capBase: 1
  capResearch: [STR_FORWARD_OPERATIONS_1, STR_FORWARD_OPERATIONS_2, STR_FORWARD_OPERATIONS_3]
  piers: {STR_OP_SMALL_PIER: 1, STR_OP_LARGE_PIER: 2}
  boats: {STR_DEVILFISH: 1, STR_SHARC: 1, STR_KILLER_WHALE: 2}
  addonOnly: [STR_OP_HQ_BARRACKS, STR_OP_HELIPAD, STR_OP_VEHICLE_PARK, STR_OP_RADIO_MAST, STR_OP_BOATHOUSE, STR_OP_FUEL_POINT, STR_OP_HANGAR, STR_OP_CONTROL_TOWER, STR_OP_BUNKER, STR_OP_RADAR_DISH, STR_OP_ANTENNA, STR_OP_PLATFORM_DECK, STR_OP_PLATFORM_HELIPAD, STR_OP_PLATFORM_AA, STR_OP_WATCH_TOWER, STR_OP_FLAK_GUN, STR_OP_EXTRA_BARRACKS, STR_OP_FUEL_TANKS, STR_OP_AMMO_DUMP, STR_OP_RIFLE_RANGE, STR_OP_CHECK_POINT, STR_OP_OUTPOST_DEFENDER, STR_OP_RADAR_STATION, STR_OP_CAMO_NET]
  kinds:
    - type: STR_OUTPOST_FORWARD_CAMP
      place: land
      cost: 300000
      days: 10
      fixed:
        - {facility: STR_OP_HQ_BARRACKS, x: 2, y: 2}
        - {facility: STR_OP_HELIPAD, x: 3, y: 2}
        - {facility: STR_OP_VEHICLE_PARK, x: 2, y: 3}
        - {facility: STR_OP_RADIO_MAST, x: 3, y: 3}
      pads: [[1, 2], [4, 2], [2, 1], [3, 1], [2, 4], [3, 4]]
      addons: [STR_OP_WATCH_TOWER, STR_OP_EXTRA_BARRACKS, STR_OP_AMMO_DUMP, STR_OP_RIFLE_RANGE, STR_OP_OUTPOST_DEFENDER, STR_OP_CHECK_POINT, STR_OP_FLAK_GUN, STR_OP_CAMO_NET]
      deployment: STR_OUTPOST_RAID_FORWARD_CAMP
    - type: STR_OUTPOST_PORT
      place: coast
      cost: 300000
      days: 10
      fixed:
        - {facility: STR_OP_HQ_BARRACKS, x: 2, y: 2}
        - {facility: STR_OP_BOATHOUSE, x: 3, y: 2}
        - {facility: STR_OP_FUEL_POINT, x: 1, y: 2}
        - {facility: STR_OP_SMALL_PIER, x: 1, y: 3}
        - {facility: STR_OP_LARGE_PIER, x: 2, y: 3}
      pads: [[4, 2], [4, 3], [1, 4], [2, 1]]
      addons: [STR_OP_SMALL_PIER, STR_OP_FLAK_GUN, STR_OP_WATCH_TOWER, STR_OP_FUEL_TANKS, STR_OP_EXTRA_BARRACKS]
      deployment: STR_OUTPOST_RAID_PORT
    - type: STR_OUTPOST_AIRSTRIP
      place: land
      cost: 300000
      days: 10
      fixed:
        - {facility: STR_OP_HQ_BARRACKS, x: 2, y: 1}
        - {facility: STR_OP_CONTROL_TOWER, x: 3, y: 1}
        - {facility: STR_OP_HANGAR, x: 2, y: 2}
      pads: [[1, 2], [4, 2], [1, 3], [4, 3]]
      addons: [STR_OP_FLAK_GUN, STR_OP_FUEL_TANKS, STR_OP_RADAR_STATION, STR_OP_HELIPAD]
      deployment: STR_OUTPOST_RAID_AIRSTRIP
    - type: STR_OUTPOST_LISTENING_POST
      place: land
      cost: 300000
      days: 10
      fixed:
        - {facility: STR_OP_BUNKER, x: 2, y: 2}
        - {facility: STR_OP_RADAR_DISH, x: 3, y: 2}
        - {facility: STR_OP_ANTENNA, x: 2, y: 3}
      pads: [[1, 2], [4, 2], [3, 3], [2, 1]]
      addons: [STR_OP_RADAR_STATION, STR_OP_CAMO_NET, STR_OP_OUTPOST_DEFENDER, STR_OP_WATCH_TOWER]
      deployment: STR_OUTPOST_RAID_LISTENING_POST
    - type: STR_OUTPOST_TTBP
      place: ocean
      cost: 500000
      days: 20
      requires: [STR_TACTICAL_BATTLE_PLATFORM]
      fixed:
        - {facility: STR_OP_PLATFORM_DECK, x: 2, y: 2}
        - {facility: STR_OP_PLATFORM_HELIPAD, x: 3, y: 2}
        - {facility: STR_OP_SMALL_PIER, x: 2, y: 3}
        - {facility: STR_OP_PLATFORM_AA, x: 3, y: 3}
      pads: [[1, 2], [4, 2], [2, 1], [3, 4]]
      addons: [STR_OP_FLAK_GUN, STR_OP_SMALL_PIER, STR_OP_FUEL_TANKS, STR_OP_RADAR_STATION]
      deployment: STR_OUTPOST_RAID_TTBP
    - type: STR_OUTPOST_SECOND_PIT     # a full Pit: the room grid and access lift (John 16:10)
      place: land
      pit: true
      counts: false
      cost: 1500000
      days: 30
      goodwill: 60
      requires: [STR_SECOND_PIT]

