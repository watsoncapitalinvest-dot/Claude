# New Battle only: Cobra's people as soldiers you can pick (John, 15 Nov 00:27 "put cobra soldiers available for choice").
# They need STR_NEW_BATTLE_ONLY, a topic nothing can research (it needs a base function no room has); New Battle
# marks every topic done, so they appear there and never in a campaign. Stats = their Cobra unit's.

research:
  - name: STR_NEW_BATTLE_ONLY
    cost: 999999
    points: 0
    requiresBaseFunc: [STR_NEVER_BUILT]

soldiers:
  - type: STR_NB_COBRA_COMMANDER
    requires: [STR_NEW_BATTLE_ONLY]
    costBuy: 0
    costSalary: 0
    minStats: {tu: 60, stamina: 90, health: 45, bravery: 90, reactions: 60, firing: 60, throwing: 50, strength: 40, psiStrength: 40, psiSkill: 0, melee: 60}
    maxStats: {tu: 60, stamina: 90, health: 45, bravery: 90, reactions: 60, firing: 60, throwing: 50, strength: 40, psiStrength: 40, psiSkill: 0, melee: 60}
    statCaps: {tu: 60, stamina: 90, health: 45, bravery: 90, reactions: 60, firing: 60, throwing: 50, strength: 40, psiStrength: 40, psiSkill: 0, melee: 60}
    allowPromotion: false
    armor: COBRA_CC_ARMOR
    standHeight: 22
    kneelHeight: 14
    femaleFrequency: 0
    soldierNames:
      - delete
      - Resources/Names/NB_CobraCommander.nam
  - type: STR_NB_DESTRO
    requires: [STR_NEW_BATTLE_ONLY]
