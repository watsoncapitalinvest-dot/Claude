# The turn screen (John 13 Nov 2026): build/install_turn_screen.py.
extraSprites:
  - type: GIJOE_TURN_SCREEN.SCR
    singleImage: true
    width: 320
    height: 200
    files:
      0: Resources/Backgrounds/turn_screen.png

# The page's two lines without X-COM's "TURN>" arrows (John 14 Nov 19:14: the text should look better).
extraStrings:
  - type: en-US
    strings: &turnstr
      STR_TURN: "TURN {0}"
      STR_SIDE: "SIDE: {0}"
  - type: en-GB
    strings: *turnstr
