# BUILD-1 19 Nov 2026. John 00:43: "So what's the point of searching for a clue if I get them all automatically. Make me
# find the stuff." The ranch's clues used to come home on any win (gijoeBounties). Now they are where MAP_DESIGN_M1 s.7 and
# CLUE_SYSTEM_DESIGN s.6 put them, and nothing exists until a Joe opens what holds it.
#
# HOW: stand next to the crate / safe / desk / footlocker, face it and RIGHT-CLICK it (8 TU). It swaps to its open
# picture (MAPS drew every one closed and open) and its contents drop on that tile. Pick them up, or just hold the
# field: on a win, stock recovery brings home what is lying out. Abort and only what your men carried to the exit comes.
# A container blown up before it is opened takes its contents with it - the ledger burns.
# Won without opening anything that held a clue: the lead moves the way a loss moves it (STR_RANCH_LOST), so the arc
# never dead-ends. Scarlett/Stalker spotting clues from 2 tiles (CLUE_SYSTEM_DESIGN s.7) is NOT in yet.

# object parts that open, per terrain (index in the .MCD; the alt MCD is the open twin)
gijoeContainerParts:
  RANCH: [34, 37, 42, 45]          # desk, office safe, footlocker, kitchen counter drawer
  BARNYRD: [12, 13, 14]            # the gun crates (three printings)

# what is inside, per deployment: [x, y, z, item, item...]  (z 0 = ground floor; coordinates from M1RANCH.MAP)
gijoeContainers:
  STR_CARTEL_RANCH:
    - [31, 18, 1, STR_CARTEL_LEDGER]        # the safe in the boss's office, upstairs: the payoff
    - [41, 21, 0, STR_CRATE_SERIAL_PLATE]   # barn crate, east row
    - [36, 25, 0, STR_COBRA_STENCIL]        # barn crate, south-west
    - [37, 20, 0, STR_PISTOL]               # barn crate: the gun (the filed-off serial has no item of its own yet)
    - [40, 20, 0, STR_PISTOL_CLIP]          # barn crates: guns and ammo or nothing
    - [41, 20, 0, STR_PISTOL_CLIP]
    - [12, 19, 0, STR_PISTOL_CLIP]          # bunkhouse footlockers: loot only
    # empty on mission 1: crates (36,20) (36,21) (37,25), the office desk (28,19,1), the kitchen drawer (28,18,0),
    # the upstairs footlocker (22,18,1), the second bunkhouse footlocker (14,19,0)
