# THE ESCALATION CALENDAR, as a property of each unit.
#
# From CLAUDE.md, which transcribes John's master design doc:
#
#   1-3    Cobra Recruits, Cobra Soldiers, Viper Pilots
#   4-8    + Cobra Officers, Medi-Vipers, Stinger Drivers
#          B.A.T.s ONLY where a specific mission calls for them
#   9-14   + Arashikage and Storm Shadow
#   15-22  + Crimson Guard, Destro, the Baroness
#   23-30  + Dr. Mindbender, B.A.T. legions, Toxo-Zombies
#   31-60  + Serpentor's guard, Cobra Commander's guard, Iron Grenadiers
#
# Three parts per unit, and the middle one is the point:
#
#   earliest   a hard floor. Never before this, whatever Cobra's books say.
#   full       by this month it turns out at full strength. BETWEEN the two the
#              chance ramps, and a region Cobra can supply gets there sooner -
#              which is the "organic" half. John: "I'd like to aim for the dates
#              given by massaging it organically." A switch would field nobody
#              in month 13 and everybody in month 14.
#   latest     a ceiling, so a unit can be withdrawn later. 0 = never.
#
#   missionOnly: true  lets a deployment that NAMES this unit field it outside
#              its window. That is what "only where a specific mission calls for
#              them" means, and it is why a B.A.T. can appear in a scripted
#              Act 1 mission while never turning up in a month-2 garrison.
#
#   substitute what to field instead when the unit is refused. Without it the
#              slot is simply empty, which quietly thins every early garrison.
#
# Months are campaign months counted from zero: monthsPassed 0 is month 1.

units:
  # 1-3. The backbone. No window - these are what Cobra has from the start.
  - type: STR_COBRA_TROOPER

  # 4-8. The specialists.
  - type: STR_VIPER_ENGINEER
    availability:
      earliest: 3
      full: 7
      substitute: STR_COBRA_TROOPER
  - type: STR_VIPER_MEDIC
    availability:
      earliest: 3
      full: 7
      substitute: STR_COBRA_TROOPER

  # 9-14. Storm Shadow was available from month 1, because garrisonRankUnlock
  # always permits rank 4 and above. The rank gate answers "is there a camp",
  # the calendar answers "what month is it", and they are not the same question.
  - type: STR_STORM_SHADOW_UNIT
    availability:
      earliest: 8
      full: 13
      missionOnly: true
      substitute: STR_COBRA_TROOPER

  # 15-22. Destro arrived twelve months early the moment a training camp lifted
  # the rank gate in month 3.
  - type: STR_DESTRO_UNIT
    availability:
      earliest: 14
      full: 21
      missionOnly: true
      substitute: STR_COBRA_TROOPER

  # 23-30 as a general force. Before that, named missions only - which is the
  # whole reason missionOnly exists. The Cobra race puts B.A.T.s in ranks 6 and
  # 7, and every generated Cobra site deployment uses ranks 5,4,3,2,1,6,7, so
  # a raid on a front company in month 2 was fielding Battle Android Troopers.
  - type: STR_BAT_TERRORIST
    availability:
      earliest: 22
      full: 29
      missionOnly: true
      substitute: STR_COBRA_TROOPER

  # Cobra Commander does not stand in a generic garrison. Story missions name
  # him; the calendar keeps him out of everything else until his own act.
  - type: STR_COBRA_COMMANDER_UNIT
    availability:
      earliest: 30
      missionOnly: true
      substitute: STR_COBRA_TROOPER
