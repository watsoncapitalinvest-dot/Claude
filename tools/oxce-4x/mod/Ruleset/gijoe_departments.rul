# GENERATED by build/gen_departments.py - edit that, not this file.
# Department heads (John 13 Nov 2026, claude/DEPARTMENT_HEADS_DESIGN_v1.md). Engine: Mod::_departments,
# SavedGame department heads, GeoscapeState research step, DepartmentsState / AppointHeadState.
# A department's topics (research lane:) need one of its rooms at that base; building a room
# prompts for a head. PLACEHOLDER rooms below stand in until STORY's real rooms are installed.
departments:
  speeds: {main: 100, second: 70, away: 70, awaySecond: 60, none: 60}
  topKick: {specialties: [STR_GJR_SPEC_COMMAND], bonus: 15}   # Duke's seat: +15% at his base
  list:
    - type: COMMAND
      name: STR_DEPT_COMMAND
      rooms: [STR_ACCESS_LIFT]
      specialties: [STR_GJR_SPEC_COMMAND]
    - type: INTEL
      name: STR_DEPT_INTEL
      rooms: [STR_COMPUTER_STATION]
      specialties: [STR_GJR_SPEC_COVERT_OPS_INTEL]
    - type: MOTOR_POOL
      name: STR_DEPT_MOTOR_POOL
      rooms: [STR_HANGAR]
      specialties: [STR_GJR_SPEC_ARMOR_VEHICLES]
    - type: ARMORY
      name: STR_DEPT_ARMORY
      rooms: [STR_GENERAL_STORES]
      specialties: [STR_GJR_SPEC_HEAVY_WEAPONS, STR_GJR_SPEC_RECON_SNIPER, STR_GJR_SPEC_DEMOLITIONS_ENGINEERING]
    - type: MEDICAL
      name: STR_DEPT_MEDICAL
      rooms: [STR_INFIRMARY_ROOM]
      specialties: [STR_GJR_SPEC_MEDIC]
    - type: COMMS
      name: STR_DEPT_COMMS
      rooms: [STR_JOE_COMMS_CENTER]
      specialties: [STR_GJR_SPEC_COMMS_TECH]
    - type: AIR_WING
      name: STR_DEPT_AIR_WING
      rooms: [STR_AIRCRAFT_HANGAR]
      specialties: [STR_GJR_SPEC_PILOT]
    - type: TRAINING
      name: STR_DEPT_TRAINING
      rooms: [STR_TRAINING_ROOM, STR_RECRUITING_OFFICE]
      specialties: []
      soldierTypes: [STR_BEACH_HEAD, STR_SGT_SLAUGHTER]
soldierSpecialties:   # main first, then second (roster/roster_day1.yaml)
  STR_HAWK: [STR_GJR_SPEC_COMMAND, STR_GJR_SPEC_COMMS_TECH]
  STR_DUKE: [STR_GJR_SPEC_COMMAND]
  STR_SOLDIER: [STR_GJR_SPEC_HEAVY_WEAPONS]
  STR_ROCK_N_ROLL: [STR_GJR_SPEC_HEAVY_WEAPONS]
  STR_GRAND_SLAM: [STR_GJR_SPEC_HEAVY_WEAPONS, STR_GJR_SPEC_COMMS_TECH]
  STR_SHORT_FUZE: [STR_GJR_SPEC_HEAVY_WEAPONS, STR_GJR_SPEC_DEMOLITIONS_ENGINEERING]
  STR_ZAP: [STR_GJR_SPEC_HEAVY_WEAPONS, STR_GJR_SPEC_DEMOLITIONS_ENGINEERING]
  STR_GRUNT: [STR_GJR_SPEC_INFANTRY]
  STR_STALKER: [STR_GJR_SPEC_INFANTRY, STR_GJR_SPEC_COMMAND]
  STR_BREAKER: [STR_GJR_SPEC_COMMS_TECH]
  STR_FLASH: [STR_GJR_SPEC_COMMS_TECH]
  STR_SCARLETT: [STR_GJR_SPEC_COVERT_OPS_INTEL, STR_GJR_SPEC_MARTIAL_ARTS]
  STR_SNAKE_EYES: [STR_GJR_SPEC_MARTIAL_ARTS]
  STR_DOC: [STR_GJR_SPEC_MEDIC]
  STR_ACE: [STR_GJR_SPEC_PILOT]
  STR_AIRBORNE: [STR_GJR_SPEC_AIRBORNE, STR_GJR_SPEC_MEDIC]

