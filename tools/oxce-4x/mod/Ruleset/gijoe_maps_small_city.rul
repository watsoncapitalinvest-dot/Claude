mapScripts:
  - type: CITY_SCRIPT          # 100 x 100 (John 13:06): a 10 x 10 grid of 10x10 blocks
    commands:
      - type: addCraft          # the Joes' transport (terror / crash-in-town missions); BUILD: drop it for missions with start groups
      - type: addLine
        direction: both
        verticalGroup: 2      # BUILD 14 Nov: OXCE's defaults are 3/2/4 (1 = landing zone); MAPS' blocks are EW 1, NS 2, crossing 3
        horizontalGroup: 1
        crossingGroup: 3
      - type: addLine
        direction: both
        verticalGroup: 2      # BUILD 14 Nov: OXCE's defaults are 3/2/4 (1 = landing zone); MAPS' blocks are EW 1, NS 2, crossing 3
        horizontalGroup: 1
        crossingGroup: 3
        executionChances: 70
      - type: addBlock          # 20 x 20 landmarks (city hall, department store)
        size: [2, 2]
        groups: [4]
        executions: 2
        executionChances: 80
      - type: fillArea
        groups: [0]
