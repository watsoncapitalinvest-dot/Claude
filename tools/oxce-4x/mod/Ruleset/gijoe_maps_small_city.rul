# MAPS 13 Nov 2026: SMALL CITY, generic 1980s US downtown (John 13:05-13:06). 100 x 100 x 4 from 10x10 blocks.
# Terrain order matters: BLANKS, TOWN, BANK, CITY (TOWN = the ambush/bank files, BANK = the bank map's). CITYDAY / CITYNIGHT / CITYDAYDMG / CITYNIGHTDMG share the script (DMG = terror damage, John 13:28).
# randomizedItems = the random clue spots (gen_clues.py). Item names are PLACEHOLDERS: STORY names, DESIGN values, BUILD defines them.
# Roads: group 1 = east-west, 2 = north-south, 3 = crossing; lots group 0; 20x20 landmarks group 4. Mapscript dimensions: set the
# mission's map size to 100 x 100 (mapScript + terrain); if 100x100 is too slow the same blocks work at 80x80 / 60x60.
terrains:
  - name: CITYDAY
    mapDataSets:
      - BLANKS
      - TOWN
      - BANK
      - CITY
    mapBlocks:
      - name: CTROADEW
        width: 10
        length: 10
        height: 4
        groups: [1]
      - name: CTROADNS
        width: 10
        length: 10
        height: 4
        groups: [2]
      - name: CTROADX
        width: 10
        length: 10
        height: 4
        groups: [3]
        randomizedItems:
          - position: [0, 8, 0]   # phone (comms)
            amount: 1
            mixed: false
            itemList: [STR_CLUE_DECOY_COMMS, STR_CLUE_DECOY_COMMS, STR_CLUE_DECOY_COMMS, STR_CLUE_DECOY_COMMS, STR_CLUE_DECOY_COMMS, STR_CLUE_DECOY_COMMS, STR_CLUE_DECOY_COMMS, STR_CLUE_DECOY_COMMS, STR_CLUE_DECOY_COMMS, STR_CLUE_DECOY_COMMS, STR_CLUE_DECOY_COMMS, STR_CLUE_DECOY_COMMS, STR_CLUE_DECOY_COMMS, STR_CLUE_DECOY_COMMS, STR_CLUE_DECOY_COMMS, STR_CLUE_DECOY_COMMS, STR_CLUE_DECOY_COMMS, STR_CLUE_DECOY_COMMS, STR_CLUE_DECOY_COMMS, STR_CLUE_DECOY_COMMS, STR_CLUE_DECOY_COMMS, STR_CLUE_COMMS_TRACE, STR_CLUE_COMMS_TRACE, STR_CLUE_COMMS_TRACE, STR_CLUE_COMMS_TRACE, STR_CLUE_COMMS_TRACE, STR_CLUE_COMMS_TRACE, STR_CLUE_COMMS_TRACE, STR_CLUE_COMMS_EVIDENCE, STR_CLUE_COMMS_EVIDENCE, STR_CLUE_COMMS_EVIDENCE, STR_CLUE_COMMS_EVIDENCE, STR_CLUE_COMMS_PAYOFF]
