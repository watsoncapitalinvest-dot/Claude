# The globe names a site by its markerName + "_", with {0} the site's number (engine Target::getMarkerName).
# Without these the globe and the briefing show the raw id. One-off story sites get no number.
extraStrings:
  - type: en-US
    strings: &mk
      STR_ABANDONED_FACTORY_SITE_: "Abandoned factory"
      STR_ARMORED_CAR_AMBUSH_SITE_: "Robbery-{0}"
      STR_CARTEL_RANCH_SITE_: "Cartel Ranch"
      STR_CARTEL_SAFEHOUSE_SITE_: "Cartel safehouse"
      STR_CARTEL_STASH_HOUSE_SITE_: "Cartel stash house"
      STR_COBRA_BROADCAST_STATION_: "Cobra Broadcast Station-{0}"
      STR_COBRA_CONVOY_SITE_: "Cobra Convoy-{0}"
      STR_COBRA_DEPOT_: "Cobra Depot-{0}"
      STR_COBRA_FACTORY_: "Cobra Factory-{0}"
      STR_COBRA_FRONT_: "Cobra Front-{0}"
      STR_COBRA_FRONT_COMPANY_: "Cobra Front Company-{0}"
      STR_COBRA_HIDDEN_HQ_: "Cobra Hidden HQ"
      STR_COBRA_RESEARCH_LAB_: "Cobra Research Lab-{0}"
      STR_COBRA_TERROR_DROME_: "Cobra Terror Drome-{0}"
      STR_COBRA_TRAINING_CAMP_: "Cobra Training Camp-{0}"
      STR_COBRA_VAN_STOP_SITE_: "Cobra Truck-{0}"
      STR_CONVOY_AMBUSHED_SITE_: "Ambushed truck transfer-{0}"
      STR_HUNTER_SITE_: "Cobra hunters-{0}"
      STR_PROVING_GROUND_SITE_: "Proving ground"
      STR_TRANSPORT_CRASH_SITE_: "Downed transfer flight-{0}"
  - type: en-GB
    strings: *mk
