ufopaedia:
  - id: STR_SKYRANGER
    image_id: JOE_UP004_CPAL
    # Dossier pictures from build/install_craft_art.py: the aircraft sits in
    # (124,20)-(316,132), so the text runs down the left and the stats along the bottom.
    rect_text: {x: 5, y: 58, width: 114, height: 74}
    rect_stats: {x: 5, y: 136, width: 310, height: 60}
  - id: STR_SMALL_SCOUT
    # The FANG. A UFO article takes a whole-page picture since the 12 Nov engine
    # (ArticleStateUfo reads image_id / rect_text / rect_stats, as a craft one does).
    # Picture from build/install_fang_art.py: the craft sits in (124,20)-(316,132).
    # Same boxes as the Tomahawk and Skystriker pages. Under 64 px tall the four
    # stat rows are set small, as a craft page's are (64 or more sets them big).
    image_id: JOE_UP_FANG_CPAL
    rect_text: {x: 5, y: 58, width: 114, height: 74}
    rect_stats: {x: 5, y: 136, width: 310, height: 60}
  - id: STR_LIGHTNING
    image_id: JOE_UP003_CPAL
  - id: STR_AVENGER
    image_id: JOE_UP001_CPAL
  - id: STR_INTERCEPTOR
    image_id: JOE_UP002_CPAL
    # Dossier pictures from build/install_craft_art.py: the aircraft sits in
    # (124,20)-(316,132), so the text runs down the left and the stats along the bottom.
    rect_text: {x: 5, y: 58, width: 114, height: 74}
    rect_stats: {x: 5, y: 136, width: 310, height: 60}
  - id: STR_FIRESTORM
    image_id: JOE_UP005_CPAL
