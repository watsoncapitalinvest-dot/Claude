# LEADS and RECON (13 Nov 2026). Engine: Mod/RuleLead.h, SavedGame::addLeadPoints, IntelBoardState.
#
# A lead fills from research (a topic finishing) and from evidence brought home (items recovered
# in the debriefing). At its threshold it is solved: revealSiteType discovers one hidden Cobra site
# of that type, markSiteType pins every hidden one (the player learns roughly where, not the
# doorstep), and grantResearch hands over topics that mission scripts can key on
# (researchTriggers). Solving one opens the INTEL board by itself.
#
# The hooks are STORY's (claude/status/STORY.md, 21:25 note, item 4). Points are BUILD's first
# numbers: a payoff clue is worth most of a lead, evidence about a third, a trace a fifth.

leads:
  - type: STR_LEAD_ABANDONED_FACTORY
    listOrder: 10
    threshold: 100
    research:
      STR_CARTEL_LEDGER: 60          # payoff: the ledger in the ranch safe
      STR_CRATE_SERIAL_PLATE: 40     # evidence: the plate on the barn crates
      STR_COBRA_STENCIL: 20          # trace: the snake stencil on the same crates
      STR_CARTEL_BOSS: 40            # the boss, if he was taken alive
    items:
      STR_CRATE_SERIAL_PLATE: 20     # the plate itself, the day it comes home
    grantResearch: [STR_FACTORY_LEAD_SOLVED]   # mission 2 keys on this once its map exists

  - type: STR_LEAD_COBRA_CELL
    listOrder: 20
    threshold: 100
    research:
      STR_BROADCAST_RECORDING: 40
      STR_TRACE_THE_BROADCAST: 60
    revealSiteType: STR_COBRA_BROADCAST_STATION   # one Cobra cell, never the Drome

  - type: STR_LEAD_FRONT_COMPANIES
    listOrder: 30
    threshold: 100
    research:
      STR_EXTENSIVE_ENTERPRISES: 100
    markSiteType: STR_COBRA_FRONT_COMPANY

  - type: STR_LEAD_COBRA_DEPOTS
    listOrder: 40
    threshold: 100
    research:
      STR_COBRA_FLIGHT_ROUTES: 40
      STR_COBRA_DEPOTS: 60
    items:
      STR_SHIPPING_MANIFEST: 25      # a manifest off a convoy
    markSiteType: STR_COBRA_DEPOT

  - type: STR_LEAD_TERROR_DROME
    listOrder: 50
    threshold: 100
    research:
      STR_TERROR_DROME_RUMOURS: 40
      STR_TERROR_DROME_PLANS: 60
    revealSiteType: STR_COBRA_TERROR_DROME

# The topic the factory lead hands over. Never researched by hand.
research:
  - name: STR_FACTORY_LEAD_SOLVED
    cost: 1
    points: 0
    requiresBaseFunc: [STR_STORY_NEVER]

# RECON (John 13 Nov): fly directly over a hidden site for about an even chance of seeing it; any
# Joe with the recon trait aboard does better. A craft sent to a point and left there (patrolling)
# checks every 10 minutes: 15% right overhead, falling to nothing at the edge of its sight, so an
# hour parked over a site finds it about 60% of the time, or 75% with Scarlett or Stalker aboard.
recon:
  chance: 15
  traitBonus: 50
  soldierTypes: [STR_SCARLETT, STR_STALKER]

# The A.P.C. can drive recon (John: "very limited range"). Ground vehicle: it sees 60 nm around it
# and carries about 20 hours of driving, roughly 2,000 nm out and back.
crafts:
  - type: STR_APC
    sightRange: 60
    fuelMax: 240

extraStrings:
  - type: en-US
    strings: &leadstr
      STR_INTEL_BOARD: INTEL BOARD
      STR_INTEL_GRAPHS: GRAPHS
      STR_INTEL_NOTHING_NEW: Nothing new since you last looked.
      STR_LEAD_SOLVED: "LEAD SOLVED: {0}"
      STR_LEAD_PROGRESS: "New intel on: {0}"
      STR_OPEN_LEADS: OPEN LEADS
      STR_NO_OPEN_LEADS: No leads yet. Bring back evidence and research it.
      STR_SOLVED_LEADS: SOLVED
      STR_LEAD_DONE: SOLVED
      STR_KNOWN_COBRA_SITES: KNOWN COBRA SITES
      STR_COBRA_SITE: Cobra site
      STR_NONE_FOUND_YET: None found yet.
      STR_UNCONFIRMED_PINS: Unconfirmed pins on the map
      STR_RECON_FLIGHTS: OUT ON RECON
      STR_ON_RECON: searching
      STR_NO_RECON_FLIGHTS: Nothing out. Send a craft to a point and leave it there to search.
      STR_RECON_SITE_SPOTTED: "RECON: a Cobra site has been spotted."
      STR_LEAD_ABANDONED_FACTORY: The abandoned factory
      STR_LEAD_COBRA_CELL: Where the broadcast came from
      STR_LEAD_FRONT_COMPANIES: Cobra's front companies
      STR_LEAD_COBRA_DEPOTS: Cobra's supply depots
      STR_LEAD_TERROR_DROME: The Terror Drome
      STR_FACTORY_LEAD_SOLVED: The abandoned factory, located
  - type: en-GB
    strings: *leadstr
