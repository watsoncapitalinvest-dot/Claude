# THE HQ AIRFIELD ARRIVES (BRIEF_FOR_BUILD_HQArrival, HQ_AIRFIELD_DESIGN_v1 s.0; John 16 Nov 01:53-02:19).
# Not on Day 1. Winning the abandoned factory (either version: it is one deployment, phase 2 is its turn-12
# reinforcements) grants STR_HQ_ARRIVAL_WON, whose event hands over the outpost at once (engine: research a mission
# unlocks fires its spawnedEvent; Outposts::grantByEvent founds the grant in gijoe_outposts.rul, built and garrisoned).
# Never won: the month-4 ceiling (about day 120) fires the LATE version instead. Each event stands down if the
# other has already come (interruptResearch), and the grant founds the HQ only once.
# Texts: STORY's, gijoe_story_act1_text.rul (03b1712).

research:
  - name: STR_HQ_ARRIVAL_WON
    cost: 1
    points: 0
    spawnedEvent: STR_EVENT_HQ_ARRIVES
    requiresBaseFunc: [STR_STORY_NEVER]
  - name: STR_HQ_ARRIVAL_LATE_MARK     # set by the late event, so the factory win after it stays silent
    cost: 1
    points: 0
    requiresBaseFunc: [STR_STORY_NEVER]

alienDeployments:
  - type: STR_ABANDONED_FACTORY
    unlockedResearch: STR_HQ_ARRIVAL_WON

events:
  - name: STR_EVENT_HQ_ARRIVES
    description: STR_EVENT_HQ_ARRIVES_DESCRIPTION
    interruptResearch: STR_HQ_ARRIVAL_LATE_MARK
    timer: 60
  - name: STR_EVENT_HQ_ARRIVES_LATE
    description: STR_EVENT_HQ_ARRIVES_LATE_DESCRIPTION
    interruptResearch: STR_HQ_ARRIVAL_WON
    researchList: [STR_HQ_ARRIVAL_LATE_MARK]
    timer: 60

eventScripts:
  - type: hqArrivesLate
    firstMonth: 4
    oneTimeSequentialEvents: [STR_EVENT_HQ_ARRIVES_LATE]
    researchTriggers:
      STR_HQ_ARRIVAL_WON: false

extraStrings:
  - type: en-US
    strings: &hqstr
      STR_HQ_ARRIVAL_WON: The Pentagon hands over the HQ
      STR_HQ_ARRIVAL_LATE_MARK: The Pentagon hands over the HQ
  - type: en-GB
    strings: *hqstr
