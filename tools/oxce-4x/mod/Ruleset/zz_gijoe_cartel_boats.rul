# CARTEL BOATS on the shipping lanes (BUILD-1, 19 Nov; STORY's item 3, John 18:50 B: contraband and money only, no story
# link). From Day 1 until the stash house falls, about 1 ship in 10 on the Gulf and Caribbean lanes is a cartel boat
# (2-3 at a time). Stop and search one: contraband about half the time (a sellable bale; a gun half of those times), a bag
# of cash about a quarter, a boarding fight with 4-6 cartel gunmen about a quarter. Searching an honest ship costs goodwill
# as before. Text: STORY's STR_CARTEL_BOAT* (gijoe_story_ops_text.rul). Engine: Geoscape/Shipping.cpp (gjCobra 3).
shipping:
  cartelLanes: [GULF_COAST, GULF_FLORIDA, MEXICO_GULF, GULF_CANAL, COLOMBIA_GULF, COLOMBIA_FLORIDA, JAMAICA_CANAL, JAMAICA_NEW_YORK]
  cartelShare: 0.12
  cartelUntil: STR_CARTEL_STASH_HOUSE
  boardCartel: STR_SHIP_SEARCH_CARTEL
  cartelContraband: STR_CARTEL_CONTRABAND
  cartelGun: STR_PISTOL
  cartelContrabandPct: 50
  cartelCashPct: 25
  cartelCash: 30000

items:
  - type: STR_CARTEL_CONTRABAND          # a bale from under the fish: worth money, worth nothing else
    name: STR_CARTEL_CONTRABAND
    size: 0.2
    costSell: 25000
    weight: 6
    bigSprite: 65
    floorSprite: 85
    invWidth: 2
    invHeight: 2
    recover: true

alienDeployments:
  - type: STR_SHIP_SEARCH_CARTEL         # the crew went for the guns under the nets
    race: STR_CARTEL
    missionCompleteText: STR_CARTEL_DEFEATED
    data:
      - alienRank: 5
        lowQty: 4
        highQty: 6
        dQty: 1
        percentageOutsideUfo: 100
        itemSets:
          - [STR_PISTOL, STR_PISTOL_CLIP, STR_PISTOL_CLIP]
          - [STR_PISTOL, STR_PISTOL_CLIP, STR_PISTOL_CLIP]
          - [STR_RIFLE, STR_RIFLE_CLIP, STR_RIFLE_CLIP]
    width: 60
    length: 20
    height: 8
    terrains: [CONTSHIP_T]
    script: CONTSHIP_SCRIPT
    shade: 0
    duration: [12, 12]
    markerName: STR_SHIP_STOPPED_SITE
    markerIcon: 22
    briefing: {palette: 0, title: STR_CARTEL_BOAT, desc: STR_CARTEL_BOAT_FIGHT}

extraStrings:
  - type: en-US
    strings: &cbstr
      STR_CARTEL_CONTRABAND: "Contraband bale"
      STR_SHIP_SEARCH_CARTEL: "Cartel boat"
  - type: en-GB
    strings: *cbstr
