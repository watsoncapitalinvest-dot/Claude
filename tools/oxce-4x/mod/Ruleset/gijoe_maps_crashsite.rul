# CRASH SITE: a Joe transfer flight shot down (John 13 Nov, BUILD_DESIGN_ANSWERS_13Nov_Evening A3).
# MAPS' crashsite.zip (BRIEF_FOR_BUILD_CrashSite.txt): the Tomahawk wreck in a clearing, 50 x 50 x 2.
# The site is made by the engine (SavedGame flights, GeoscapeState), never by a mission script.
# Win it and what was aboard goes on to where it was going; lose it, or let the timer run out, and
# Cobra has it: named Joes held, unnamed Joes 50/50 dead or held, cargo gone.
# One biome for now (forest); the other eight ring sets are in TERRAIN and only need a terrain entry each.
terrains:
  - name: CRASHSITE_FOREST
    mapDataSets:
      - BLANKS
      - RFOREST
      - CRASH
    mapBlocks:
      - name: CRASHSITE
        width: 50
        length: 50
        height: 2

mapScripts:
  - type: CRASHSITE_SCRIPT
    commands:
      - type: addBlock
        size: [5, 5]

alienDeployments:
  - type: STR_TRANSPORT_CRASH
    data:
      - alienRank: 5
        lowQty: 6
        highQty: 8
        dQty: 1
        percentageOutsideUfo: 100
        itemSets:
          - [STR_PISTOL, STR_PISTOL_CLIP, STR_PISTOL_CLIP]
          - [STR_RIFLE, STR_RIFLE_CLIP, STR_RIFLE_CLIP]
          - [STR_RIFLE, STR_RIFLE_CLIP, STR_RIFLE_CLIP]
    width: 50
    length: 50
    height: 2
    terrains: [CRASHSITE_FOREST]
    script: CRASHSITE_SCRIPT
    shade: 0
    duration: [48, 48]               # Cobra's capture team gets there in two days
    markerName: STR_TRANSPORT_CRASH_SITE
    markerIcon: 22
    alert: STR_TRANSPORT_SHOT_DOWN_ALERT
    briefingData:
      palette: 0
      title: STR_TRANSPORT_CRASH

alienMissions:
  - type: STR_TRANSPORT_SHOT_DOWN
    points: 0
    objective: 3
    raceWeights:
      0:
        STR_COBRA: 100
    waves:
      - ufo: STR_TRANSPORT_CRASH
        count: 1
        trajectory: P0
        timer: 60
        objective: true

extraStrings:
  - type: en-US
    strings: &crashstr
      STR_TRANSPORT_CRASH: "Transfer Flight Down"
      STR_TRANSPORT_CRASH_SITE: "Downed transfer flight"
      STR_TRANSPORT_SHOT_DOWN_ALERT: "Cobra has shot down a transfer flight. Get to the wreck before their capture team does."
      STR_TRANSPORT_CRASH_BRIEFING: "Cobra brought down our transfer flight. Everyone and everything aboard is at the wreck. Their capture team is coming in from the north. Hold the wreck and get our people out."
      STR_TRANSFER_SHOT_DOWN: "A transfer flight to {0} was shot down. It is on the world map: two days before Cobra's capture team reaches it."
      STR_TRANSFER_RECOVERED: "The downed transfer flight to {0} was recovered. What was aboard is on its way again."
      STR_TRANSFER_LOST: "Cobra reached the downed transfer flight to {0} first. Our people there are in Cobra's hands and the cargo is gone."
      STR_TRANSFER_RISK: "Cobra could intercept this flight: {0}% chance on this route."
      STR_SEND_COURIER: "COURIER"
      STR_SEND_TOMAHAWK: "TOMAHAWK"
      STR_SEND_TRUCK: "TRUCK"
      STR_TRANSFER_RISKS: "Chance Cobra hits it: courier plane {0}% (fee, fastest), Tomahawk {1}% (free, twice as long), truck {2}% (free, three times as long, land only)."
  - type: en-GB
    strings: *crashstr
