# 2x2 aircraft in the air fights (DOGFIGHT_DESIGN_v1 section 3): the transports and the bomber.
# Drawn by the whole-body routine across the four tiles (engine: UnitSprite::drawRoutineWhole, size 2);
# sheets from build/make_air_units.py, 256 x 320 cells: 0-7 the headings, then 8 death frames each.
#
# IN: the Tomahawk (STR_SKYRANGER, Joe transport helicopter) and the Condor (STR_BATTLESHIP, Cobra bomber).
# NOT YET: the C-130 and the Vulture have no craft or Cobra-aircraft type in the game to hang them on.
# STAND-IN ART: the Condor is the Skystriker's swept-wing top view, scaled up and painted Cobra blue-black,
# until its own top view or render arrives.

airFight:
  units:
    STR_SKYRANGER: STR_AF_TOMAHAWK
    STR_BATTLESHIP: STR_AF_CONDOR
  aircraft:
    STR_AF_TOMAHAWK:
      role: transport
      agility: 5
    STR_AF_CONDOR:
      role: bomber
      agility: 0
      arc: rear          # the tail gun covers the rear 90 degrees only

extraSprites:
- type: AIR_TOMAHAWK_BIG_HD.PCK
  width: 2048
  height: 2880
  subX: 256
  subY: 320
  files:
    0: Resources/Units/air_tomahawk_big_body.png
- type: AIR_CONDOR_HD.PCK
  width: 2048
  height: 2880
  subX: 256
  subY: 320
  files:
    0: Resources/Units/air_condor_body.png

armors:
- type: AF_TOMAHAWK_ARMOR
  spriteSheet: AIR_TOMAHAWK_BIG_HD.PCK
  drawingRoutine: 23
  deathFrames: 8
  movementType: 1
  size: 2
  frontArmor: 3
  sideArmor: 3
  rearArmor: 3
  underArmor: 3
  visibilityAtDay: 14
  visibilityAtDark: 14
  corpseBattle: [STR_AF_WRECK, STR_AF_WRECK, STR_AF_WRECK, STR_AF_WRECK]
  loftempsSet: [3, 3, 3, 3]
  builtInWeapons: []        # no door guns until Transport Door Guns is researched (3b)
  allowsKneeling: false
  allowsRunning: false
- type: AF_CONDOR_ARMOR
  spriteSheet: AIR_CONDOR_HD.PCK
  drawingRoutine: 23
  deathFrames: 8
  movementType: 1
  size: 2
  frontArmor: 5
  sideArmor: 5
  rearArmor: 5
  underArmor: 5
  visibilityAtDay: 14
  visibilityAtDark: 14
  corpseBattle: [STR_AF_WRECK, STR_AF_WRECK, STR_AF_WRECK, STR_AF_WRECK]
  loftempsSet: [3, 3, 3, 3]
  builtInWeapons: [STR_AF_GUN_CONDOR_TAIL]
  allowsKneeling: false
  allowsRunning: false

units:
- type: STR_AF_TOMAHAWK
  armor: AF_TOMAHAWK_ARMOR
  stats: {tu: 36, stamina: 100, health: 120, bravery: 50, reactions: 40, firing: 50, throwing: 0, strength: 100, psiStrength: 100, psiSkill: 0, melee: 0}
  standHeight: 10
  kneelHeight: 10
  floatHeight: 6
  value: 0
  deathSound: 22
  intelligence: 3
  aggression: 0
- type: STR_AF_CONDOR
  armor: AF_CONDOR_ARMOR
  stats: {tu: 34, stamina: 100, health: 220, bravery: 50, reactions: 40, firing: 55, throwing: 0, strength: 100, psiStrength: 100, psiSkill: 0, melee: 0}
  standHeight: 10
  kneelHeight: 10
  floatHeight: 6
  value: 60
  deathSound: 22
  intelligence: 3
  aggression: 1

items:
- type: STR_AF_GUN_CONDOR_TAIL
  size: 0.1
  weight: 1
  bigSprite: 0
  floorSprite: 0
  handSprite: 0
  invWidth: 1
  invHeight: 1
  battleType: 1
  fixedWeapon: true
  recover: false
  clipSize: 12
  power: 18
  damageType: 1
  damageAlter: {RandomType: 10, ArmorEffectiveness: 1.0, ToArmor: 0, ToTile: 0, ToStun: 0, ToWound: 0, IgnoreDirection: true}
  tuSnap: 12
  flatRate: true
  accuracySnap: 100
  maxRange: 6
  minRange: 0
  bulletSprite: 1
  fireSound: 4
  hitSound: 12
  hitAnimation: 26

extraStrings:
- type: en-US
  strings: &bigstr
    STR_AF_TOMAHAWK: Tomahawk
    STR_AF_CONDOR: Condor
    STR_AF_GUN_CONDOR_TAIL: Tail gun
- type: en-GB
  strings: *bigstr
