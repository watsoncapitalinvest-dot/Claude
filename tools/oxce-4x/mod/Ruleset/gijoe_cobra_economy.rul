# Cobra's eight kinds of site.
#
# A site earns its place by what raiding it changes, not by flavour. Two of them produce and
# six of them spend, so a region that has lost its front company and its factory cannot keep
# the rest running - which is the whole point of a target list.
#
# EVERY NUMBER HERE IS A PLACEHOLDER AND JOHN'S TO TUNE. They are internally coherent rather
# than balanced: funds are in units where a modest site costs a few hundred to build, and the
# two producers between them roughly cover the upkeep of three or four consumers. Nothing here
# has been played.
#
# As priced below, one of each nets -190 funds a month, so Cobra needs two or three front
# companies running to keep a full set of sites alive. That is the shape to preserve while
# tuning: the producers have to be few enough that losing one hurts, or the target list stops
# mattering. Check it with: one front company at +110 against everything else at -300.
#
# Nothing spawns these yet. A site learns what it is from the AlienDeployment that creates it
# (cobraSiteType: <one of the types below>), so eight deployments are still needed - they can
# share a map and differ only in name and marker, but they do have to exist, and that wants
# verifying by generating a battle rather than by writing plausible YAML.
#
# projectProgressPerMonth, goodwillErosionPerMonth and garrisonRefillPerMonth are read and
# stored but nothing consumes them yet - that is step 4. They are declared now so the numbers
# live in one place from the start rather than being retrofitted.

cobraSites:
  # ---- the two that pay for everything else
  - type: STR_COBRA_FRONT_COMPANY
    fundsPerMonth: 120
    upkeepFunds: 10
    buildCostFunds: 400
    lootFunds: 60

    # Its income rides on a cargo flight. Shoot one down and this site earns nothing
    # that month - it still pays its upkeep, because the staff do not go home because
    # its takings did not arrive. That is the pressure an intercepted run should create.
    incomeNeedsShipment: true
  - type: STR_COBRA_FACTORY
    materielPerMonth: 80
    # Guns are made, not conjured: the factory spends this to turn out the 80 above,
    # on top of its upkeep. So it costs 88 a month all in, against a front company
    # netting 110 - roughly one earner keeps one factory running. A Cobra that cannot
    # cover it makes the share it can pay for, pro-rata, and the kit rule then turns
    # its garrisons out on sidearms a month or two later. Set 0 to make guns free again.
    materielCostFunds: 48
    upkeepFunds: 40
    buildCostFunds: 600
    lootMateriel: 100

  # ---- the six that spend
    # Its income rides on a cargo flight. Shoot one down and this site earns nothing
    # that month - it still pays its upkeep, because the staff do not go home because
    # its crates did not arrive. That is the pressure an intercepted run should create.
    incomeNeedsShipment: true
  - type: STR_COBRA_TRAINING_CAMP
    upkeepFunds: 30
    upkeepMateriel: 20
    buildCostFunds: 500
    # A camp cannot refill a garrison - Cobra keeps none, the defenders are built from the
    # deployment every time you raid. So it hardens the region it stands in instead.
    #
    # garrisonBonus      extra defenders on EVERY rank entry of a Cobra site in this region.
    #                    A site deployment has seven rank entries, so 1 here is about seven
    #                    more men on the map. Raise with care.
    # garrisonRankUnlock low rank numbers are the elites: 0 Cobra Commander, 1 Destro,
    #                    2 Viper Engineer, 3 Viper Medic, 4 Storm Shadow, 5 trooper,
    #                    6 and 7 B.A.T.s. With no camp in the region, ranks BELOW this stay
    #                    home. At 4 that means no Commander, no Destro and no Vipers unless
    #                    a camp stands nearby. Set -1 to leave ranks alone.
    # garrisonAllMissions false: only raids on Cobra sites. true: every Cobra battle in the
    #                    region, crash sites and terror sites too.
    #
    # All three are guesses. The mechanism is built; these numbers are not balanced.
    garrisonBonus: 1
    garrisonRankUnlock: 4
    garrisonAllMissions: false

  - type: STR_COBRA_DEPOT
    upkeepFunds: 10
    buildCostFunds: 300
    stockpileCap: 500
    # the depot is the one site whose loot is whatever the region had been holding
    lootsRegionalStockpile: true

  - type: STR_COBRA_RESEARCH_LAB
    # THE EXPOSED OPTION. A lab out on the globe: cheap, stands on its own, holds ONE
    # department, and has only its own small garrison. Its point is not efficiency - a Drome
    # houses four benches for not much more - its point is that the department head is HERE,
    # reachable in an ordinary raid, instead of behind a Drome's garrison.
    #
    # So it is priced to be what poor Cobra builds: 200 against a Drome's 450. Early Cobra
    # cannot afford Dromes, so its research sits out in the open and its heads are catchable,
    # which is Acts 1 and 2 - exactly when the interrogation spine needs to start producing.
    # Rich Cobra consolidates into Dromes and the heads go behind the wire. The escalation
    # falls out of the economy rather than out of a date.
    upkeepFunds: 25
    upkeepMateriel: 10
    buildCostFunds: 200
    projectProgressPerMonth: 10   # per bench, and identical wherever a bench stands:
    labSlots: 1                   # exposure is bought with money, never with speed
    revealOnRaid: 1

  - type: STR_COBRA_TERROR_DROME
    # THE PROTECTED OPTION, and the hub everything else already launches from. Four benches
    # behind the hardest garrison in the game. A Cobra that stacks every department in one
    # Drome is running its whole programme out of one building - efficient, and one raid ends
    # every line of research at once.
    projectProgressPerMonth: 10
    labSlots: 4
    upkeepFunds: 50
    upkeepMateriel: 30
    buildCostFunds: 900
    # It raises the mission rate without any code that knows what a Terror Drome is: the economy
    # publishes COBRA_SITES_STR_COBRA_TERROR_DROME_<REGION> every month, and a missionScript
    # gates on it like any other counter.
    # THE DROME IS THE HQ. John: "It's where the planning happens."
    #
    # While Cobra holds one of these, SavedGame::cobraPlan decides what it builds - pay the
    # upkeep first, one of everything before two of anything, replace what you destroyed.
    # With none standing, Cobra reverts to buying whatever it can afford in no particular
    # order, which is what it did before there was a planner and is measurably worse: three
    # sites in eleven months against twelve.
    #
    # So killing the Drome does not just cost Cobra a building, it costs Cobra its judgement
    # until it manages to put another one up. It still checks prices while leaderless, which
    # is the only reason it can ever rebuild this one.
    runsThePlanning: true
    # It is now the big prize as well as the brain. These were the Hidden HQ's numbers; the
    # HQ is redundant and still sits in the list doing nothing - see the note at the top.
    lootFunds: 200
    lootMateriel: 100
    revealOnRaid: 3
  - type: STR_COBRA_BROADCAST_STATION
    upkeepFunds: 30
    buildCostFunds: 450
    # Raised from 5. The station earns Cobra no money at all, so influence is the entire
    # return on 450 up front and 30 a month - and 5 was too little to be worth that to
    # Cobra, which made the building irrational for it to build. Erosion adds alien activity
    # to the region AND the country, so funding falls and a pact gets likelier. A mission
    # site scores 20-50 once; 15 a month is about a third of a terror attack arriving
    # forever, from a transmitter nobody has found. That is also the Act 1 trace target -
    # Cobra Commander's broadcast - so the story already points the player at it.
    goodwillErosionPerMonth: 15

  - type: STR_COBRA_HIDDEN_HQ
    # 1200 to build, 80 and 20 materiel a month, and no ONGOING effect for any of it: since
    # the Terror Drome took runsThePlanning, the HQ's only mechanics were raid outcomes
    # (lootFunds 200, lootMateriel 100, revealOnRaid 3 - a genuine intel prize, so it was
    # never fully dead). It is not deleted: deleting a site type breaks any save holding one,
    # which is the recurringTerror lesson from this evening. Instead it earns its upkeep the
    # way an HQ should - it is the hardest target in the region. garrisonBonus is the
    # verified mechanism (+4 men on every deployment there) and needs no engine code.
    garrisonBonus: 4
    # And it hosts research, which is the job the design doc gives it and a better one than
    # the garrison bonus alone: two benches, as well defended as the HQ itself.
    projectProgressPerMonth: 10
    labSlots: 2
    upkeepFunds: 80
    upkeepMateriel: 20
    buildCostFunds: 1200
    lootFunds: 200
    lootMateriel: 100
    revealOnRaid: 3

# ---------------------------------------------------------------------------
# Cobra's own research. The lab above declares projectProgressPerMonth and for
# a day nothing consumed it, so the lab cost 800 up front and 60 a month to be
# decoration. These are what it pays for.
#
# This is the ORGANIC half of the escalation calendar (tools/oxce-4x/CLAUDE.md).
# maxKitTierByMonth in gijoe_tuning.rul is the FLOOR - never earlier than the
# story allows. These decide when inside the window, out of Cobra's own books.
# Whichever is lower wins, so research can only ever make Cobra worse armed
# than the calendar, never better. latestMonth is the ceiling, so a player who
# has been burning Cobra's labs still meets the story on time.
#
# Tier 0 - handguns and knives - needs no project: with any project naming a
# tier, an unresearched Cobra is clamped to 0. So Cobra opens the game on
# handguns everywhere, which is months 1-3 of the calendar, and has to work.
#
# A region's labs push ONE project a month in the order written here, so this
# order IS the tree. Materiel spent here is materiel not arming troopers, and
# that is deliberate: a region that pours everything into lasers fields men
# who cannot reach the 50 the kit rule wants, and shows up carrying pistols.
cobraProjects:
  - type: STR_COBRA_RIFLES
    cost: 40                   # one lab at 10/month = 4 months
    materielPerProgress: 2     # 80 materiel all told
    unlocksKitTier: 1          # rifles and grenades
    earliestMonth: 3           # calendar: months 4-8
    latestMonth: 8

  - type: STR_COBRA_LASERS
    cost: 90                   # one lab = 9 more months; two = half that
    materielPerProgress: 3     # 270 materiel all told
    unlocksKitTier: 2          # first Cobra lasers, M.A.R.S. heavy weapons
    earliestMonth: 8           # calendar: months 9-14
    latestMonth: 14
