# Cobra's eight kinds of site.
#
# A site earns its place by what raiding it changes, not by flavour. Two of them produce and
# six of them spend, so a region that has lost its front company and its factory cannot keep
# the rest running - which is the whole point of a target list.
#
# EVERY NUMBER HERE IS A PLACEHOLDER AND JOHN'S TO TUNE. They are internally coherent rather
# than balanced: funds are in units where a modest site costs a few hundred to build, and the
# two producers between them roughly cover the upkeep of three or four consumers. Nothing here
# has been played.
#
# As priced below, one of each nets -190 funds a month, so Cobra needs two or three front
# companies running to keep a full set of sites alive. That is the shape to preserve while
# tuning: the producers have to be few enough that losing one hurts, or the target list stops
# mattering. Check it with: one front company at +110 against everything else at -300.
#
# Nothing spawns these yet. A site learns what it is from the AlienDeployment that creates it
# (cobraSiteType: <one of the types below>), so eight deployments are still needed - they can
# share a map and differ only in name and marker, but they do have to exist, and that wants
# verifying by generating a battle rather than by writing plausible YAML.
#
# projectProgressPerMonth, goodwillErosionPerMonth and garrisonRefillPerMonth are read and
# stored but nothing consumes them yet - that is step 4. They are declared now so the numbers
# live in one place from the start rather than being retrofitted.

cobraSites:
  # ---- the two that pay for everything else
  - type: STR_COBRA_FRONT_COMPANY
    fundsPerMonth: 120
    upkeepFunds: 10
    buildCostFunds: 400
    lootFunds: 60

  - type: STR_COBRA_FACTORY
    materielPerMonth: 80
    upkeepFunds: 40
    buildCostFunds: 600
    lootMateriel: 100

  # ---- the six that spend
  - type: STR_COBRA_TRAINING_CAMP
    upkeepFunds: 30
    upkeepMateriel: 20
    buildCostFunds: 500
    # A camp cannot refill a garrison - Cobra keeps none, the defenders are built from the
    # deployment every time you raid. So it hardens the region it stands in instead.
    #
    # garrisonBonus      extra defenders on EVERY rank entry of a Cobra site in this region.
    #                    A site deployment has seven rank entries, so 1 here is about seven
    #                    more men on the map. Raise with care.
    # garrisonRankUnlock low rank numbers are the elites: 0 Cobra Commander, 1 Destro,
    #                    2 Viper Engineer, 3 Viper Medic, 4 Storm Shadow, 5 trooper,
    #                    6 and 7 B.A.T.s. With no camp in the region, ranks BELOW this stay
    #                    home. At 4 that means no Commander, no Destro and no Vipers unless
    #                    a camp stands nearby. Set -1 to leave ranks alone.
    # garrisonAllMissions false: only raids on Cobra sites. true: every Cobra battle in the
    #                    region, crash sites and terror sites too.
    #
    # All three are guesses. The mechanism is built; these numbers are not balanced.
    garrisonBonus: 1
    garrisonRankUnlock: 4
    garrisonAllMissions: false

  - type: STR_COBRA_DEPOT
    upkeepFunds: 10
    buildCostFunds: 300
    stockpileCap: 500
    # the depot is the one site whose loot is whatever the region had been holding
    lootsRegionalStockpile: true

  - type: STR_COBRA_RESEARCH_LAB
    upkeepFunds: 60
    upkeepMateriel: 10
    buildCostFunds: 800
    projectProgressPerMonth: 10
    revealOnRaid: 1

  - type: STR_COBRA_TERROR_DROME
    upkeepFunds: 50
    upkeepMateriel: 30
    buildCostFunds: 900
    lootMateriel: 50
    # It raises the mission rate without any code that knows what a Terror Drome is: the economy
    # publishes COBRA_SITES_STR_COBRA_TERROR_DROME_<REGION> every month, and a missionScript
    # gates on it like any other counter.

  - type: STR_COBRA_BROADCAST_STATION
    upkeepFunds: 30
    buildCostFunds: 450
    goodwillErosionPerMonth: 5

  - type: STR_COBRA_HIDDEN_HQ
    upkeepFunds: 80
    upkeepMateriel: 20
    buildCostFunds: 1200
    lootFunds: 200
    lootMateriel: 100
    revealOnRaid: 3
