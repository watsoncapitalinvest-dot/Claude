# THE PIT'S SURFACE DEFENCES: researched, then INSTALLED into fixed hiding spots (BRIEF_FOR_BUILD_SurfaceInstall,
# SURFACE_FACILITIES_v1 v1.1; John 15 Nov 08:37, 12:52 no cap, 12:53 the 13th spot). Nothing is placed on the surface:
# Build Facilities installs a defence straight into its spot (engine Basescape/PitPlace surfaceSpot*; the base screen's
# Surface tab shows the 13 spots). Install cost, days and upkeep are the facility's own (FACILITY_STATS_v1).
# Spot ids follow MAPS' PITSURF_spots.json, so the surface battle map can open the right roofs.
# Seven defences had no facility in the game; they are added here with FACILITY_STATS_v1's numbers. Their base-screen
# frame is the missile-defence picture until the graphics team's 24 pictures land (BRIEF_FOR_GRAPHICS_AI_SurfaceFacilities).

pitSurface:
  spots:
    - {id: aa_gun, name: STR_PIT_SPOT_MOTOR_POOL_HATCH, facilities: [STR_GJ_AA_GUN]}
    - {id: law, name: STR_PIT_SPOT_MOTOR_POOL_ROOF, facilities: [STR_GJ_LAW]}
    - {id: howitzer, name: STR_PIT_SPOT_HEAVY_ELEVATOR, facilities: [STR_GJ_MOUNTAIN_HOWITZER]}
    - {id: laser, name: STR_PIT_SPOT_HEAVY_PANEL_A, facilities: [STR_LASER_DEFENSES]}
    - {id: pulse, name: STR_PIT_SPOT_HEAVY_PANEL_B, facilities: [STR_PLASMA_DEFENSES]}
    - {id: radar, name: STR_PIT_SPOT_WATER_TOWER, facilities: [STR_SMALL_RADAR_SYSTEM]}
    - {id: lr_radar, name: STR_PIT_SPOT_WATER_TOWER_2, facilities: [STR_LARGE_RADAR_SYSTEM]}
    - {id: missile_def, name: STR_PIT_SPOT_GYM_ROOF_A, facilities: [STR_MISSILE_DEFENSES]}
    - {id: air_def, name: STR_PIT_SPOT_GYM_ROOF_B, facilities: [STR_GJ_AIR_DEFENSE]}
    - {id: mortar_def, name: STR_PIT_SPOT_BOILER_A, facilities: [STR_GJ_MORTAR_DEFENSE]}
    - {id: mortar, name: STR_PIT_SPOT_BOILER_B, facilities: [STR_GJ_MORTAR_LAUNCHER]}
    - {id: sonic, name: STR_PIT_SPOT_SIRENS, facilities: [STR_GRAV_SHIELD]}
    - {id: gym_mount, name: STR_PIT_SPOT_GYM_COMPARTMENT, flexible: true}   # the 13th: a second copy of any researched defence

facilities:
  - type: STR_GJ_AA_GUN
    spriteShape: 2
    spriteFacility: 184
    buildCost: 150000
    buildTime: 12
    monthlyCost: 4000
    defense: 300
    hitRatio: 50
    fireSound: 5
    hitSound: 10
    mapName: XBASE_06
    requires: [STR_ANTI_AIRCRAFT_GUN]
  - type: STR_GJ_AIR_DEFENSE
    spriteShape: 2
    spriteFacility: 184
    buildCost: 180000
    buildTime: 14
    monthlyCost: 4500
    defense: 400
    hitRatio: 55
    fireSound: 5
    hitSound: 10
    mapName: XBASE_06
    requires: [STR_ANTI_AIRCRAFT_GUN]
  - type: STR_GJ_MORTAR_DEFENSE
    spriteShape: 2
    spriteFacility: 184
    buildCost: 120000
    buildTime: 10
    monthlyCost: 3000
    defense: 300
    hitRatio: 40
    fireSound: 5
    hitSound: 10
    mapName: XBASE_06
    requires: [STR_BATTLE_STATIONS]
  - type: STR_GJ_MORTAR_LAUNCHER
    spriteShape: 2
    spriteFacility: 184
    buildCost: 150000
    buildTime: 12
    monthlyCost: 3500
    defense: 350
    hitRatio: 40
    fireSound: 5
    hitSound: 10
    mapName: XBASE_06
    requires: [STR_BATTLE_STATIONS]
  - type: STR_GJ_MOUNTAIN_HOWITZER
    spriteShape: 2
    spriteFacility: 184
    buildCost: 250000
    buildTime: 16
    monthlyCost: 6000
    defense: 600
    hitRatio: 40
    fireSound: 5
    hitSound: 10
    mapName: XBASE_06
    requires: [STR_MOUNTAIN_HOWITZER]
  - type: STR_GJ_LAW
    spriteShape: 2
    spriteFacility: 180
    buildCost: 500000
    buildTime: 26
    monthlyCost: 18000
    defense: 900
    hitRatio: 60
    fireSound: 5
    hitSound: 10
    mapName: XBASE_06
    requires: [STR_LASER_DEFENSE]         # later act: with the Laser Battery
  - type: STR_MISSILE_DEFENSES
    requires: [STR_BATTLE_STATIONS]
  - type: STR_SMALL_RADAR_SYSTEM
    requires: [STR_RADAR_ROOM]
  - type: STR_LARGE_RADAR_SYSTEM
    requires: [STR_LONG_RANGE_RADAR]

extraStrings:
  - type: en-US
    strings: &pitsurf
      STR_GJ_AA_GUN: Anti-Aircraft Gun
      STR_GJ_AIR_DEFENSE: Air Defense
      STR_GJ_MORTAR_DEFENSE: Mortar Defense Unit
      STR_GJ_MORTAR_LAUNCHER: Mortar Launcher
