      STR_LARGE_RADAR_SYSTEM: Long-Range Radar
      STR_MISSILE_DEFENSES: Missile Defense Unit
      STR_LASER_DEFENSES: Laser Battery
      STR_PLASMA_DEFENSES: Pulse Battery
      STR_PIT_SPOT_MOTOR_POOL_HATCH: Motor pool, garage hatch
      STR_PIT_SPOT_MOTOR_POOL_ROOF: Motor pool, roof hatch
      STR_PIT_SPOT_HEAVY_ELEVATOR: Heavy-equipment elevator
      STR_PIT_SPOT_HEAVY_PANEL_A: Heavy-equipment roof, west panel
      STR_PIT_SPOT_HEAVY_PANEL_B: Heavy-equipment roof, east panel
      STR_PIT_SPOT_WATER_TOWER: Water tower
      STR_PIT_SPOT_WATER_TOWER_2: Water tower, second mast
      STR_PIT_SPOT_GYM_ROOF_A: Gym roof, north
      STR_PIT_SPOT_GYM_ROOF_B: Gym roof, south
      STR_PIT_SPOT_BOILER_A: Boiler house, west hatch
      STR_PIT_SPOT_BOILER_B: Boiler house, east hatch
      STR_PIT_SPOT_SIRENS: Sirens on the roof corners
      STR_PIT_SPOT_GYM_COMPARTMENT: Gym roof compartment (any)
