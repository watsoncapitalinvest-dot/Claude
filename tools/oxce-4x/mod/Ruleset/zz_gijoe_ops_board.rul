# THE OPERATIONS BOARD, first five (BUILD-1, 19 Nov; John 18:48 "build the Operations board now"). STORY's table and text:
# claude/NOTE_FOR_BUILD1_OpsBoard_FromSTORY.txt, gijoe_story_ops_text.rul (titles from EPISODE_NAMES_v1). Engine: the spy
# operations (CAPTURE_DESIGN_v1) plus unlessResearched / cost / grantResearch / boost / bonusIf (BUILD-1, 19 Nov).
# Who goes: the spies (Scarlett on Day 1; others as they join). The first operation of a campaign always succeeds.
# NOT YET: the department speed-ups (Hawk -1 day on Joe's Night Out, Scarlett's office / Breaker on the others), "blown warns
# Cobra" on Night Shift and Dead Air, the bartender's $5k a month after the first, the JSOC / INTEL headings on the board.
spyOperations:
  - type: STR_OP_PAPER_TRAIL                   # Twenty Questions: the border bank's man
    desc: STR_OP_PAPER_TRAIL_DESC
    requiresAny: [STR_ROBBERY_LEADER, STR_GETAWAY_PAPERS, STR_SLOW_MONEY_TRACE]   # the bank trace is on offer
    unlessResearched: [STR_BORDER_BANK_TRACE]
    days: 4
    success: 75
    empty: 20
    once: true
    boost: {STR_BORDER_BANK_TRACE: 50}         # cuts the trace short if it is under way
    lead: STR_LEAD_CARTEL_SUPPLIER
    leadPoints: 10                             # and if it is not, the lead still moves
  - type: STR_OP_LONG_NIGHT                    # My Brother's Keeper: the ranch's survivors
    desc: STR_OP_LONG_NIGHT_DESC
    requiresAny: [STR_RANCH_LOST, STR_CARTEL_LEDGER, STR_CRATE_SERIAL_PLATE, STR_COBRA_STENCIL, STR_CARTEL_BOSS]   # the ranch is done
    unlessResearched: [STR_FACTORY_LEAD_SOLVED]
    days: 3
    success: 70
    empty: 25
    bonusIf: {STR_CARTEL_BOSS: 15}             # the boss held and talking
    once: true
    lead: STR_LEAD_CARTEL_SUPPLIER
    leadPoints: 15
  - type: STR_OP_NIGHT_SHIFT                   # Joe's Night Out (JSOC): watching the factory gate
    desc: STR_OP_NIGHT_SHIFT_DESC
    requiresAny: [STR_FACTORY_LEAD_SOLVED]
    unlessResearched: [STR_FACTORY_REACTIVATION_DATE]
    days: 5
    success: 80
    empty: 15
    once: true
    grantResearch: [STR_FACTORY_REACTIVATION_DATE]   # the reopening date, days ahead
  - type: STR_OP_FRIENDLY_BARTENDER            # The Spy Who Rooked Me: an informant in a border town
    desc: STR_OP_FRIENDLY_BARTENDER_DESC
    days: 2
    success: 70
    empty: 25
    cost: 15000
    once: true
    grantResearch: [STR_INFORMANT_NETWORK]     # notice of the next job, as the informant network gives (2-3 days)
  - type: STR_OP_DEAD_AIR                      # Cobra Soundwaves: the broadcast's relay
    desc: STR_OP_DEAD_AIR_DESC
    requiresAny: [STR_COBRA_SHOWN]             # after Cobra Commander's broadcast
    unlessResearched: [STR_TRACE_THE_BROADCAST]
    days: 4
    success: 70
    empty: 25
    once: true
    boost: {STR_BROADCAST_RECORDING: 50}
    lead: STR_LEAD_COBRA_CELL
    leadPoints: 20
