# GOODWILL + EXPOSURE (John 13 Nov 2026, BUILD_DESIGN_ANSWERS_13Nov_Evening A5). Every number is BUILD's first pass.
#
# PER-COUNTRY GOODWILL, 0-100, starts at `start`. It sets what the country pays: 50 pays what it paid on
# Day 1, 100 pays double, 0 pays nothing (never above the country's fundingCap). It replaces the stock
# month-end funding roll; pacts with Cobra still work as before. Shown on REPORTS beside each country.
# It moves with:
#   - the month: (Joe activity - Cobra activity in that country) / perActivity, at most +/- monthlyCap
#     (Cobra's broadcast stations already add Cobra activity, so they wear goodwill down through this)
#   - a mission fought there: +win if won, -loss if lost
#   - civilians killed there: -civilianDead each, at most -civilianCap a mission
#   - exposure there while G.I. Joe is still secret: -1 per exposureGoodwillPer points
#   - Pentagon directives: not designed yet
#
# WORLD EXPOSURE. A mission with any civilians on the map adds exposurePerJoe per named Joe on it
# (exposureCity in a city: the deployments listed below). At publicAt, G.I. Joe goes public, once.
# From then the PUBLIC readout shows public confidence (starts at confidenceStart): +confidenceWin a won
# mission, -confidenceLoss a lost one, -confidenceCivilian per civilian killed (at most civilianCap).
# Confidence scales every country's cheque: 0 = 75%, 50 = 100%, 100 = 125%.
#
# NOT YET: police and press units (civilians stand in for them), Pentagon directives, and "a high public
# profile makes the Pit easier for Cobra to find" (needs Cobra's search for the Pit, which does not exist).

goodwill:
  start: 50
  perActivity: 30
  monthlyCap: 8
  win: 3
  loss: 5
  civilianDead: 1
  civilianCap: 5
  exposurePerJoe: 1
  exposureCity: 2
  exposureGoodwillPer: 4
  publicAt: 100
  confidenceStart: 50
  confidenceWin: 3
  confidenceLoss: 4
  confidenceCivilian: 1
  cityDeployments:
    - STR_TERROR_MISSION
    - STR_ARMORED_CAR_AMBUSH
    - STR_COBRA_VAN_STOP

extraStrings:
  - type: en-US
    strings: &gwstr
      STR_JOE_GOES_PUBLIC: "G.I. JOE IS PUBLIC. Too many people have seen our Joes in action, and the papers have a name for us. From now on the whole world is watching: wins raise public confidence and funding everywhere; losses and civilian deaths cost us."
  - type: en-GB
    strings: *gwstr
