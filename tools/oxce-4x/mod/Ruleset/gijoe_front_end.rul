# Front end art (FRONT_END_ART_BRIEF.txt, delivered 12 Nov). Each picture is a 320x200
# 8-bit image with a 1920x1200 twin (<name>_hi.png) that HiUI draws instead.
extraSprites:
  - type: JOE_TITLE.SCR
    singleImage: true
    width: 320
    height: 200
    files:
      0: Resources/FrontEnd/title.png
  - type: JOE_MENU_PLATE.SCR
    singleImage: true
    width: 320
    height: 200
    files:
      0: Resources/FrontEnd/menu_plate.png
interfaces:
  - type: mainMenu
    backgroundImage: JOE_TITLE.SCR
  - type: newGameMenu
    backgroundImage: JOE_MENU_PLATE.SCR
  - type: optionsMenu
    backgroundImage: JOE_MENU_PLATE.SCR
  - type: modsMenu
    backgroundImage: JOE_MENU_PLATE.SCR
  - type: saveMenus
    backgroundImage: JOE_MENU_PLATE.SCR
# The opening briefing: plays when a new campaign starts (NewGameState), before the
# base is placed. The narration lines are a DRAFT for John and the design chat to replace.
cutscenes:
  - type: openingBriefing
    slideshow:
      transitionSeconds: 7
      slides:
        - imagePath: Resources/FrontEnd/brief_1.png
          caption: STR_BRIEF_1
          captionPos: [16, 152]
          captionSize: [288, 44]
          captionColor: 1
          captionAlign: 1
          captionVerticalAlign: 1
        - imagePath: Resources/FrontEnd/brief_2.png
          caption: STR_BRIEF_2
          captionPos: [16, 152]
          captionSize: [288, 44]
          captionColor: 1
          captionAlign: 1
          captionVerticalAlign: 1
        - imagePath: Resources/FrontEnd/brief_3.png
          caption: STR_BRIEF_3
          captionPos: [16, 152]
          captionSize: [288, 44]
          captionColor: 1
          captionAlign: 1
          captionVerticalAlign: 1
        - imagePath: Resources/FrontEnd/brief_4.png
          caption: STR_BRIEF_4
          captionPos: [16, 152]
          captionSize: [288, 44]
          captionColor: 1
          captionAlign: 1
          captionVerticalAlign: 1
