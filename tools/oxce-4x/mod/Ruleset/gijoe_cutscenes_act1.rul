# Act 1 cutscenes. Written by build/install_cutscenes.py - edit the script, not this file.
# Captions are STORY's (gijoe_story_act1_text.rul); STORY triggers these ids.
cutscenes:
  - type: act1FactoryReopened
    slideshow:
      transitionSeconds: 7
      slides:
        - imagePath: Resources/Cutscenes/Act1/factory_a1.png
          caption: STR_CUT_FACTORY_A1
          captionPos: [16, 152]
          captionSize: [288, 44]
          captionColor: 1
          captionAlign: 1
          captionVerticalAlign: 1
