# AIR FIGHTS on the battle engine (claude/DOGFIGHT_DESIGN_v1.md Phase 1, claude/AIR_SEA_BUILD_PLAN_v1.md).
# An interception between a craft and a Cobra aircraft that both have a unit below is offered as FIGHT /
# AUTO-RESOLVE (engine: GeoscapeState::offerAirFight). FIGHT is a battle on a 40 x 40 sky: floor 0 is the
# ground seen from the air, floors 1-4 are the decks. Numbers are the design's section 3 table.
#
# NOT YET (Phase 1 gaps, see the plan): the odds bar (the screen says so), auto-resolve still uses the old
# one-line stand-in, the Tomahawk and the C-130 are not in (2x2 units: their sheets need the big-unit
# layout), damage is +-50% (the design says +-25%), a Joe aircraft leaves by ending its turn on the edge
# (no DISENGAGE button yet), craft fly with or without an assigned pilot.

# (merge keys expanded: the engine reads them flat)

airFight:
  units:
    STR_INTERCEPTOR: STR_AF_SKYSTRIKER
    STR_FIRESTORM: STR_AF_CONQUEST
    STR_LIGHTNING: STR_AF_PHANTOM
    STR_LARGE_SCOUT: STR_AF_RATTLER
    STR_MEDIUM_SCOUT: STR_AF_FIREBAT
    STR_ABDUCTOR: STR_AF_NIGHT_RAVEN
    STR_CARTEL_PLANE: STR_AF_CARTEL_PLANE
  aircraft:
    STR_AF_SKYSTRIKER:
      role: fighter
      agility: 15
    STR_AF_CONQUEST:
      role: fighter
      agility: 22
    STR_AF_PHANTOM:
      role: recon
      agility: 18
    STR_AF_RATTLER:
      role: strike
      agility: 8
    STR_AF_FIREBAT:
      role: fighter
      agility: 16
    STR_AF_NIGHT_RAVEN:
      role: recon
      agility: 20
    STR_AF_CARTEL_PLANE:
      role: cargo
      agility: 4
  helicopters: [STR_SMALL_SCOUT, STR_HARVESTER]
  textureTerrains:
    0: AIR_FOREST
    1: AIR_FARM
    2: AIR_FARM
    3: AIR_FARM
    4: AIR_FARM
    5: AIR_MOUNTAIN
    6: AIR_FOREST
    7: AIR_DESERT
    8: AIR_DESERT
    9: AIR_MOUNTAIN
    10: AIR_FOREST
    11: AIR_FOREST
    12: AIR_FARM
  oceanTerrain: AIR_OCEAN
  defaultTerrain: AIR_FARM
  deployment: STR_AIR_FIGHT
  rounds: 12
  baseHit: 60
  rearBonus: 20
  headOnMalus: 10
  freeRange: 3
  perTile: 3
  deckMalus: 15
  noAttackBelow: 25
  namedEjectMin: 3
  namedEjectMax: 7
  unnamedSurvive: 50
