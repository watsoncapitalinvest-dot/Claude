# BUILD-1 19 Nov 2026. John 01:22 / 01:25: Day 1 is Hawk, Duke and greenshirts; every named Joe who is not story-locked
# can be hired from the purchase screen on Day 1. One of each: the row goes once he is on the books (engine:
# gijoeUniqueSoldiers, PurchaseState). Price is a placeholder for tuning: $100,000 to hire, the usual salary after.
# Story-locked, so NOT here: Ace (arrives with the HQ airfield), Chuckles (pulled, SHORTCUTS #15), Hawk and Duke (Day 1).
# Department heads come with the man: no Scarlett / Doc / Breaker / Roadblock hired = that department runs headless
# (60%) until you hire him. Scarlett runs the operations board.
gijoeUniqueSoldiers: [STR_HAWK, STR_DUKE, STR_SOLDIER, STR_SNAKE_EYES, STR_SCARLETT, STR_ROCK_N_ROLL, STR_GRAND_SLAM,
  STR_ZAP, STR_GRUNT, STR_STALKER, STR_BREAKER, STR_FLASH, STR_DOC, STR_AIRBORNE, STR_FLINT, STR_SHORT_FUZE,
  STR_BEACH_HEAD, STR_ACE, STR_CHUCKLES]
soldiers:
  - type: STR_SOLDIER        # Roadblock
    costBuy: 100000
  - type: STR_SNAKE_EYES
    costBuy: 100000
  - type: STR_SCARLETT
    costBuy: 100000
  - type: STR_ROCK_N_ROLL
    costBuy: 100000
  - type: STR_GRAND_SLAM
    costBuy: 100000
  - type: STR_ZAP
    costBuy: 100000
  - type: STR_GRUNT
    costBuy: 100000
  - type: STR_STALKER
    costBuy: 100000
  - type: STR_BREAKER
    costBuy: 100000
  - type: STR_FLASH
    costBuy: 100000
  - type: STR_DOC
    costBuy: 100000
  - type: STR_AIRBORNE
    costBuy: 100000
  - type: STR_FLINT
    costBuy: 100000
  - type: STR_SHORT_FUZE
    costBuy: 100000
  - type: STR_BEACH_HEAD
    costBuy: 100000
