# ACT 1 BATTLE AI, step 1: settings only (BRIEF_FOR_BUILD_BattleAI 1; GAME_LOGIC_v1 Part C; John 14:25 approved).
# Loads after gijoe_units.rul / gijoe_villains.rul and changes only these keys.
#   trooper aggression 1 (takes cover, doesn't charge); officers and leaders 0 and spotters (they hang back and
#   call targets); B.A.T.s high and never panic.
# There is no Cobra sniper unit yet, so no sniper flag is set.
units:
  - type: STR_COBRA_TROOPER
    aggression: 1
  - type: STR_GJV_DROP_TROOPER
    aggression: 1
  - type: STR_VIPER_ENGINEER
    aggression: 1
  - type: STR_VIPER_MEDIC
    aggression: 0
  - type: STR_COBRA_COMMANDER_UNIT
    aggression: 0
    spotter: 2
  - type: STR_DESTRO_UNIT
    aggression: 0
    spotter: 2
  - type: STR_BARONESS_UNIT
    aggression: 0
    spotter: 2
  - type: STR_CARTEL_BOSS
    aggression: 0
    spotter: 2
  - type: STR_ROBBERY_LEADER
    aggression: 0
    spotter: 2
  - type: STR_BAT_TERRORIST
    aggression: 3
    canPanic: false

# Steps 2, 4, 5 (engine: AIModule::getTargetAttackWeight). Target weight, 100 = an ordinary target:
#   a Joe at a third of his health or less x3 (the one it can finish this turn - a stand-in: health, not damage);
#   + 2 per point of his Cobra file; + (20 - tiles away) for being near;
#   a heavy weapon (power 70+) on a vehicle x2, on a man x0.75;
#   civilians are not targets at all except in a terror attack (they can still be hit by a shot at a Joe).
battleAI:
  finishPct: 34
  finishMul: 300
  filePerPoint: 2
  nearBonus: 20
  heavyPower: 70
  heavyOnVehicle: 200
  heavyOnMan: 75
  terrorDeployments: [STR_TERROR_MISSION, STR_MAP_SMALL_CITY_TERROR, STR_TERROR_SHIP]
