# ACT 1 BATTLE AI, step 1: settings only (BRIEF_FOR_BUILD_BattleAI 1; GAME_LOGIC_v1 Part C; John 14:25 approved).
# Loads after gijoe_units.rul / gijoe_villains.rul and changes only these keys.
#   trooper aggression 1 (takes cover, doesn't charge); officers and leaders 0 and spotters (they hang back and
#   call targets); B.A.T.s high and never panic.
# There is no Cobra sniper unit yet, so no sniper flag is set.
units:
  - type: STR_COBRA_TROOPER
    aggression: 1
  - type: STR_GJV_DROP_TROOPER
    aggression: 1
  - type: STR_VIPER_ENGINEER
    aggression: 1
  - type: STR_VIPER_MEDIC
    aggression: 0
  - type: STR_COBRA_COMMANDER_UNIT
    aggression: 0
    spotter: 2
  - type: STR_DESTRO_UNIT
    aggression: 0
    spotter: 2
  - type: STR_BARONESS_UNIT
    aggression: 0
    spotter: 2
  - type: STR_CARTEL_BOSS
    aggression: 0
    spotter: 2
  - type: STR_ROBBERY_LEADER
    aggression: 0
    spotter: 2
  - type: STR_BAT_TERRORIST
    aggression: 3
    canPanic: false

# Steps 2, 4, 5 (engine: AIModule::getTargetAttackWeight). Target weight, 100 = an ordinary target:
#   a Joe at a third of his health or less x3 (the one it can finish this turn - a stand-in: health, not damage);
#   + 2 per point of his Cobra file; + (20 - tiles away) for being near;
#   a heavy weapon (power 70+) on a vehicle x2, on a man x0.75;
#   civilians are not targets at all except in a terror attack (they can still be hit by a shot at a Joe).
battleAI:
  finishPct: 34
  finishMul: 300
  filePerPoint: 2
  nearBonus: 20
  heavyPower: 70
  heavyOnVehicle: 200
  heavyOnMan: 75
  terrorDeployments: [STR_TERROR_MISSION, STR_MAP_SMALL_CITY_TERROR, STR_TERROR_SHIP]
  # Steps 6-9 (BUILD-2, 16 Nov; engine: AIModule::think's after-filter, gj* functions). Every number is BUILD-2's first pass.
  # 6 MEDIC: a medic walks to a downed Cobra (a stunned man or a villain who went down; a man killed outright
  #   stays dead) within medicRange tiles and gets him up (medicTU TU, ends his turn), or patches a hurt man
  #   beside him (+medicHeal HP, bleeding stopped). Under fire he only goes to a man within 4 tiles.
  #   medicUses revives + patches per medic per battle. A Cobra at hurtPct % health or bleeding walks to a medic.
  medics: [STR_VIPER_MEDIC]
  medicRange: 12
  medicTU: 25
  medicUses: 3
  medicHeal: 10
  hurtPct: 34
  # 8 GUARDING: at the start, the guardsPer Cobra nearest each objective (a clue or evidence item lying in the
  #   map; MAPS' stand-in for the vault, the safe, the bench) and within guardFrom tiles are tied to it; they go
  #   no further than guardLeash tiles from it, walk back if pushed off, and are freed when it is taken.
  guardsPer: 2
  guardFrom: 10
  guardLeash: 3
  guardItems: [STR_CLUE_]
  # 9 SILENT: while no Joe can see him, a silent unit fires only at a Joe within silentStrike tiles and never
  #   steps where a Joe Cobra knows about can see him; otherwise he creeps closer unseen. Seen = fights normally.
  silent: [STR_STORM_SHADOW_UNIT, STR_NB_STORM_SHADOW, STR_FIREFLY_UNIT]
  silentStrike: 8
  # 7 PAIRS: with no Joe in sight, a patrolling Cobra heads for the newest sighting (last 3 turns, shared) and
  #   moves with a buddy, never more than pairGap tiles apart: the man behind moves, the man ahead waits.
  pairs: true
  pairGap: 4
