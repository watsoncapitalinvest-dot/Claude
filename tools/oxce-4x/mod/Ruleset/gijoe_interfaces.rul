# Interface colours this conversion overrides.
#
# Indices are into PAL_GEOSCAPE (palette 0 of PALETTES.DAT), NOT into the
# basescape palette. The two disagree, and judging a colour against the wrong
# one is how a lavender facility floor got "corrected" that was already right.

interfaces:
  - type: geoscape
    elements:
      # The clock reads red. "clockText" is ours: it colours the five time
      # widgets - hours, both separators, minutes, seconds - and nothing else,
      # so the weekday and the date keep the pale "text" colour they share with
      # the rest of the panel.
      #
      # 13 is rgb(252,0,0). Block 0 of this palette is a scatter of UI colours
      # rather than a ramp, so a Text started at 13 shades into 14 (192,0,0),
      # which is the house red and gives a clean two-step. Starting at 14 shades
      # into 15, which is black.
      - id: clockText
        color: 13
