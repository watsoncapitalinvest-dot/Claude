    width: 100
    length: 100
    height: 6
    terrains: [EMMA_CIVIC, EMMA_COURT, EMMA_DOWNTOWN, EMMA_HIGHWAY, EMMA_HOMES, EMMA_HOSPITAL, EMMA_PORT, EMMA_STATION, EMMA_TOWNHALL]
