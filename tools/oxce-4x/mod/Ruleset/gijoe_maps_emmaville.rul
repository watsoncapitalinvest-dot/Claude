# Emmaville (MAPS, BRIEF_FOR_BUILD_Emmaville v7, 14 Nov): sample pieces of the planned city, each a .MAP2 with
# its OWN terrain list (the order is the piece's <NAME>_terrain.json, which the .MAP2 ids assume).
# GENERATED by build/gen_emmaville_rul.py from MAPS' samples folder; edit the script, not this file.
# Node ranks: 0 civilians, 1 Joe start (south edge), 2 hostiles. New Battle only: no campaign mission sends a piece yet.
terrains:
  - name: EMMA_BRIDGE
    mapDataSets: [BLANKS, EMMA, EMMAI, FURN, INTER, EMMAV, EMMAX]
    mapBlocks:
      - {name: EMMA_BRIDGE, width: 100, length: 200, height: 6}
  - name: EMMA_CIVIC
    mapDataSets: [BLANKS, EMMA, EMMAI, FURN, INTER, EMMAV, EMMAX, EMMAW]
    mapBlocks:
      - {name: EMMA_CIVIC, width: 100, length: 100, height: 6}
