mapScripts:
  - type: EMMA_SCRIPT_70x50
    commands:
      - type: addBlock
        size: [7, 5]
        rects:
          - [0, 0, 7, 5]
  - type: EMMA_SCRIPT_100x100
    commands:
      - type: addBlock
        size: [10, 10]
        rects:
          - [0, 0, 10, 10]
  - type: EMMA_SCRIPT_100x200
    commands:
      - type: addBlock
        size: [10, 20]
        rects:
          - [0, 0, 10, 20]
  - type: EMMA_SCRIPT_240x60
    commands:
      - type: addBlock
        size: [24, 6]
        rects:
          - [0, 0, 24, 6]

