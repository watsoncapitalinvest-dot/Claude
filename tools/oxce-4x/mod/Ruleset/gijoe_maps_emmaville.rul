mapScripts:
  - type: EMMA_SCRIPT_80x80
    commands:
      - type: addBlock
        size: [8, 8]
        rects:
          - [0, 0, 8, 8]
  - type: EMMA_SCRIPT_100x100
    commands:
      - type: addBlock
        size: [10, 10]
        rects:
          - [0, 0, 10, 10]
  - type: EMMA_SCRIPT_100x200
    commands:
      - type: addBlock
        size: [10, 20]
        rects:
          - [0, 0, 10, 20]
  - type: EMMA_SCRIPT_240x60
    commands:
      - type: addBlock
        size: [24, 6]
        rects:
          - [0, 0, 24, 6]

alienDeployments:
  - type: STR_MAP_EMMA_BRIDGE
    data:
      - alienRank: 5
        lowQty: 8
        highQty: 10
        dQty: 1
        percentageOutsideUfo: 100
        itemSets:
          - [STR_PISTOL, STR_PISTOL_CLIP, STR_PISTOL_CLIP]
          - [STR_RIFLE, STR_RIFLE_CLIP, STR_RIFLE_CLIP]
          - [STR_RIFLE, STR_RIFLE_CLIP, STR_RIFLE_CLIP]
    civilians: 12
    width: 100
    length: 200
    height: 6
    terrains: [EMMA_BRIDGE]
    script: EMMA_SCRIPT_100x200
    shade: 0
    briefing: {palette: 0, title: STR_MAP_EMMA_BRIDGE, desc: STR_MAP_EMMAVILLE_BRIEFING}
  - type: STR_MAP_EMMAVILLE
    data:
      - alienRank: 5
        lowQty: 8
        highQty: 10
        dQty: 1
