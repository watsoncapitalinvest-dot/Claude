# ARMORED-CAR AMBUSH (MAPS' ambush_hwy, 13 Nov 2026): the cartel robbing the SECURE-TRANS payroll car
# at Sundown Gas on US-90 (cartel arc step 4, STORY_CartelArc_v1). Map, terrains, routes: MAPS
# (Reference\BRIEF_FOR_BUILD_ambush_hwy.txt). Wiring: BUILD. Fixed 50 x 40 x 3, ground on level 0.
# Terrain order matters: BLANKS, SUNDOWN, AMBUSH, TOWN. TOWN is the van stop's set (same files).
# Route nodes 1 and 2 (loading at the armored car) were raised from priority 8 to 9 so the two
# gunmen carrying cash always start there.
#
# John (02:46, 11:17): the van never moves; it is only the exit. Engine side in
# NextTurnState::runVanStop + AIModule::think:
# - The robbers don't know the Joes are there until the alarm (a robber sees a Joe or gets hurt).
# - After the alarm, robbers carrying cash run for the van. At the end of each Cobra turn a robber
#   standing on the van tiles is gone, with what he carries.
# - The leader waits at the van until every robber carrying cash has got there or gone down; then
#   he goes too. Take him alive -> STR_ROBBERY_LEADER. The getaway papers lie in the van's open rear.
terrains:
  - name: AMHWY
    mapDataSets:
      - BLANKS
      - SUNDOWN
      - AMBUSH
      - TOWN
    mapBlocks:
      - name: AMHWY
        width: 50
        length: 40
        height: 3
        groups: [0]
        items:
          STR_BANDED_CASH:        # the cash stacks in the armored car
            - [29, 18, 0]
            - [30, 18, 0]
            - [30, 20, 0]
          STR_GETAWAY_PAPERS:     # the van's open rear
            - [23, 21, 0]
mapScripts:
  - type: AMHWY_SCRIPT
    commands:
      - type: addBlock
        size: [5, 4]
        groups: [0]
        rects:
          - [0, 0, 5, 4]

units:
  - type: STR_ROBBERY_LEADER
    race: STR_COBRA
    rank: STR_LIVE_LEADER
    stats:
      tu: 56
      stamina: 90
      health: 40
      bravery: 80
      reactions: 55
      firing: 55
      throwing: 50
      strength: 40
      psiStrength: 40
      psiSkill: 0
      melee: 60
    armor: COBRA_TROOPER_ARMOR
    standHeight: 22
    kneelHeight: 14
    value: 20
    deathSound: 41
    intelligence: 3
    aggression: 1
  - type: STR_CARTEL_BOSS
    race: STR_COBRA
    rank: STR_LIVE_LEADER
    stats:
      tu: 56
      stamina: 90
      health: 40
      bravery: 80
      reactions: 55
      firing: 55
      throwing: 50
      strength: 40
      psiStrength: 40
      psiSkill: 0
      melee: 60
    armor: COBRA_TROOPER_ARMOR
    standHeight: 22
    kneelHeight: 14
    value: 20
    deathSound: 41
    intelligence: 3
    aggression: 1

alienDeployments:
  - type: STR_ARMORED_CAR_AMBUSH
    data:
      - alienRank: 5            # the two loading at the armored car: nodes 1-2, cash in hand
        lowQty: 2
        highQty: 2
        dQty: 0
        percentageOutsideUfo: 100
        itemSets:
          - [STR_PISTOL, STR_PISTOL_CLIP, STR_BANDED_CASH]
          - [STR_PISTOL, STR_PISTOL_CLIP, STR_BANDED_CASH]
          - [STR_PISTOL, STR_PISTOL_CLIP, STR_BANDED_CASH]
      - alienRank: 5            # the store, the east lot, the pumps: nodes 3-5
        lowQty: 3
        highQty: 3
        dQty: 0
        percentageOutsideUfo: 100
        itemSets:
          - [STR_PISTOL, STR_PISTOL_CLIP, STR_PISTOL_CLIP]
          - [STR_PISTOL, STR_PISTOL_CLIP, STR_PISTOL_CLIP]
          - [STR_PISTOL, STR_PISTOL_CLIP, STR_PISTOL_CLIP]
      - alienRank: 5            # the leader at the van's rear: node 0
        customUnitType: STR_ROBBERY_LEADER
        lowQty: 1
        highQty: 1
        dQty: 0
        percentageOutsideUfo: 100
        itemSets:
          - [STR_PISTOL, STR_PISTOL_CLIP]
          - [STR_PISTOL, STR_PISTOL_CLIP]
          - [STR_PISTOL, STR_PISTOL_CLIP]
    civilians: 6
    quietUntilAlarm: true
    robberExit: [[24, 21, 0], [24, 22, 0], [25, 21, 0], [25, 22, 0], [26, 21, 0], [26, 22, 0], [23, 21, 0], [23, 22, 0]]
    robberLoot: [STR_BANDED_CASH]
    robberLeader: STR_ROBBERY_LEADER
    lookouts:
      - [13, 15, 23, 19, 1]    # the canopy roof
    smartPoints:              # MAPS' suggested list (AMHWY_spots.json)
      leaderAlive: 30
      otherAlive: 10
      noneEscaped: 20
      lootRecovered: 15
      noCivilianHurt: 20
    width: 50
    length: 40
    height: 3
    terrains: [AMHWY]
    script: AMHWY_SCRIPT
    shade: 0
    duration: [6, 12]
    markerName: STR_ARMORED_CAR_AMBUSH_SITE
    markerIcon: 22
    alert: STR_ARMORED_CAR_AMBUSH_ALERT
    briefingData:
      palette: 0
      title: STR_ARMORED_CAR_AMBUSH
      desc: STR_ARMORED_CAR_AMBUSH_BRIEFING

# On the globe: the informant's tip (Scarlett's operation) puts the robbery on the map a few days
# ahead. Without the tip, it comes in month 2 anyway, without warning (STORY: every outcome has a
# version). Zone 9: US-90 near Del Rio, Texas.
alienMissions:
  - type: STR_ARMORED_CAR_AMBUSH_MISSION
    points: 0
    objective: 3
    spawnZone: 9
    raceWeights:
      0:
        STR_COBRA: 100
    waves:
      - ufo: STR_ARMORED_CAR_AMBUSH
        count: 1
        trajectory: P0
        timer: 60
        objective: true

missionScripts:
  - type: armoredCarTipped
    firstMonth: 0
    maxRuns: 1
    varName: armoredCarRobbery
    executionOdds: 100
    startDelay: 4320
    researchTriggers:
      STR_INFORMANT_TIP: true
    missionWeights:
      0:
        STR_ARMORED_CAR_AMBUSH_MISSION: 100
    regionWeights:
      0:
        STR_NORTH_AMERICA: 100
  - type: armoredCarUnwarned
    firstMonth: 1
    lastMonth: 1
    maxRuns: 1
    varName: armoredCarRobbery        # shared with the tipped version: the robbery happens once
    executionOdds: 100
    startDelay: 14400
    researchTriggers:
      STR_INFORMANT_TIP: false
      STR_FACTORY_LEAD_SOLVED: false
    missionWeights:
      0:
        STR_ARMORED_CAR_AMBUSH_MISSION: 100
    regionWeights:
      0:
        STR_NORTH_AMERICA: 100

extraStrings:
  - type: en-US
    strings: &ambushstr
      STR_ARMORED_CAR_AMBUSH: Armored-Car Ambush
      STR_ARMORED_CAR_AMBUSH_MISSION: Armored-Car Robbery
      STR_ARMORED_CAR_AMBUSH_SITE: Robbery
      STR_ARMORED_CAR_AMBUSH_ALERT: ARMORED-CAR ROBBERY
      STR_US_90: US-90
      STR_ROBBERY_LEADER: Robbery Leader
      STR_CARTEL_BOSS: Cartel Boss
      STR_ROBBERY_LEADER_GONE: "The robbery leader climbed into the van. He is gone."
      STR_ROBBERY_CASH_GONE: "{0} robber(s) made it to the van with the cash."
      STR_ROBBERY_ROBBER_GONE: "{0} robber(s) made it to the van."
      STR_SMART_LEADER_ALIVE: "Smart play: leader taken alive"
      STR_SMART_NONE_ESCAPED: "Smart play: no robber got away"
      STR_SMART_LOOT_RECOVERED: "Smart play: the cash stayed here"
      STR_SMART_NO_CIVILIAN_HURT: "Smart play: no civilian hurt"
      STR_ARMORED_CAR_AMBUSH_BRIEFING: "The cartel has hit the SECURE-TRANS payroll car at Sundown Gas on US-90. The deputies have fled. Six gunmen: two loading the cash, the leader at the getaway van. You are in place and they don't know it. Anyone who reaches the van is gone with what he carries, and the leader leaves once the cash is aboard. Take the leader alive if you can."
  - type: en-GB
    strings: *ambushstr
