# G.I. Joe VIEW BASE and the Pit's placed defences (John 22 Nov: "machine gun turrets, security gates, check points,
# missile turrets, costs money"). Engine: Battlescape/BaseDefences.cpp (prices there: MG $150k, missile $300k,
# gate $50k, checkpoint $80k - BUILD's guesses). Every defence is a fixed G.I. Joe unit that cannot move.
# LOOKS (23 Nov, the graphics AI): the MG turret, missile turret and checkpoint have their own sheets; the gate draws
# its own picture over its door. Before that everything wore the Tomahawk door gun's sprite
# (art_briefs/BASE_DEFENCES_BRIEF.txt). The SECURITY GATE is a real door from the Pit's own tiles, set into the tile's
# north wall (west if the north is taken): Joes open it, nobody else can, so Cobra has to shoot or blow it down.

alienDeployments:
  - type: STR_GJ_BASE_WALK        # the walk round the Pit: nobody comes
    data: []

units:
  - type: STR_GJ_DEF_MG
    race: STR_GJ_DEF_MG
    armor: GJ_DEF_MG_ARMOR          # 23 Nov: its own look (the graphics AI's MG turret)
    stats: {tu: 50, stamina: 100, health: 60, bravery: 110, reactions: 50, firing: 60, throwing: 0, strength: 100, psiStrength: 100, psiSkill: 0, melee: 0}
    standHeight: 16
    kneelHeight: 16
    value: 0
    deathSound: 23
    energyRecovery: 50
  - type: STR_GJ_DEF_MISSILE
    race: STR_GJ_DEF_MISSILE
    armor: GJ_DEF_MISSILE_ARMOR
    stats: {tu: 50, stamina: 100, health: 70, bravery: 110, reactions: 40, firing: 65, throwing: 0, strength: 100, psiStrength: 100, psiSkill: 0, melee: 0}
    standHeight: 16
    kneelHeight: 16
    value: 0
    deathSound: 23
    energyRecovery: 50
  - type: STR_GJ_DEF_GATE          # (unused since 23 Nov: the gate is a door set into the tile's wall, BaseDefences::placeGate)
    race: STR_GJ_DEF_GATE
    armor: GJ_DEF_GATE_ARMOR
    stats: {tu: 1, stamina: 100, health: 200, bravery: 110, reactions: 0, firing: 0, throwing: 0, strength: 100, psiStrength: 100, psiSkill: 0, melee: 0}
    standHeight: 20
    kneelHeight: 20
    value: 0
    deathSound: 23
    energyRecovery: 50
  - type: STR_GJ_DEF_CHECKPOINT    # a sandbagged post with a gun on it: cheaper and weaker than the MG turret
    race: STR_GJ_DEF_CHECKPOINT
    armor: GJ_DEF_CHECKPOINT_ARMOR
    stats: {tu: 40, stamina: 100, health: 50, bravery: 110, reactions: 45, firing: 50, throwing: 0, strength: 100, psiStrength: 100, psiSkill: 0, melee: 0}
    standHeight: 14
    kneelHeight: 14
    value: 0
    deathSound: 23
    energyRecovery: 50

extraSprites:
  - type: GJ_DEF_MG.PCK             # build/install_defence_art.py from the graphics AI's mg_d0-7 + mg_wreck (23 Nov)
    width: 2048
    height: 3200
    subX: 128
    subY: 160
    files:
      0: Resources/Units/gj_def_mg_body.png

  - type: GJ_DEF_MISSILE.PCK        # the graphics AI's part 2 (23 Nov)
    width: 2048
    height: 3200
    subX: 128
    subY: 160
    files:
      0: Resources/Units/gj_def_missile_body.png
  - type: GJ_DEF_CHECKPOINT.PCK
    width: 2048
    height: 3200
    subX: 128
    subY: 160
    files:
      0: Resources/Units/gj_def_checkpoint_body.png
  - type: GJ_GATE.PCK               # the security gate, drawn over the door it is built on (Map.cpp, BaseDefences::gateLook)
    width: 768
    height: 160
    subX: 128
    subY: 160
    files:
      0: Resources/Units/gj_def_gate.png

armors:
  - type: GJ_DEF_MISSILE_ARMOR
    spriteSheet: GJ_DEF_MISSILE.PCK
    drawingRoutine: 23
    deathFrames: 8
    size: 1
    frontArmor: 50
    sideArmor: 40
    rearArmor: 30
    underArmor: 30
    allowInv: false
    allowsKneeling: false
    allowsRunning: false
    allowsMoving: false
    corpseBattle: [STR_AF_WRECK]
    loftempsSet: [3]
  - type: GJ_DEF_MG_ARMOR
    spriteSheet: GJ_DEF_MG.PCK
    drawingRoutine: 23
    deathFrames: 8
    size: 1
    frontArmor: 50
    sideArmor: 40
    rearArmor: 30
    underArmor: 30
    allowInv: false
    allowsKneeling: false
    allowsRunning: false
    allowsMoving: false
    corpseBattle: [STR_AF_WRECK]
    loftempsSet: [3]
  - type: GJ_DEF_TURRET_ARMOR
    spriteSheet: TOM_DOORGUN.PCK
    drawingRoutine: 23
    deathFrames: 8
    size: 1
    frontArmor: 50
    sideArmor: 40
    rearArmor: 30
    underArmor: 30
    allowInv: false
    allowsKneeling: false
    allowsRunning: false
    allowsMoving: false
    corpseBattle: [STR_AF_WRECK]
    loftempsSet: [3]
  - type: GJ_DEF_GATE_ARMOR
    spriteSheet: TOM_DOORGUN.PCK
    drawingRoutine: 23
    deathFrames: 8
    size: 1
    frontArmor: 90
    sideArmor: 90
    rearArmor: 90
    underArmor: 90
    allowInv: false
    allowsKneeling: false
    allowsRunning: false
    allowsMoving: false
    corpseBattle: [STR_AF_WRECK]
    loftempsSet: [3]
  - type: GJ_DEF_CHECKPOINT_ARMOR
    spriteSheet: GJ_DEF_CHECKPOINT.PCK
    drawingRoutine: 23
    deathFrames: 8
    size: 1
    frontArmor: 45
    sideArmor: 25
    rearArmor: 15
    underArmor: 15
    allowInv: false
    allowsKneeling: false
    allowsRunning: false
    allowsMoving: false
    corpseBattle: [STR_AF_WRECK]
    loftempsSet: [3]

extraStrings:
  - type: en-US
    strings: &defstr
      STR_GJ_VIEW_BASE: "VIEW BASE"
      STR_GJ_WALK_HELP: "VIEW BASE - walk the Pit. Right-click open floor to buy a defence (put a gate in a doorway or corridor), right-click one to take it out. END MISSION to leave."
      STR_GJ_DEF_PLACE_TITLE: "PLACE A DEFENCE"
      STR_GJ_DEF_REMOVE_TITLE: "TAKE IT OUT?"
      STR_GJ_DEF_TAKE_OUT: "Take out the {0} (half back)"
      STR_GJ_DEF_NO_ROOM: "It will not stand there."
      STR_GJ_DEF_MG: "MG turret"
      STR_GJ_DEF_MISSILE: "Missile turret"
      STR_GJ_DEF_GATE: "Security gate"
      STR_GJ_DEF_CHECKPOINT: "Checkpoint"
  - type: en-GB
    strings: *defstr
