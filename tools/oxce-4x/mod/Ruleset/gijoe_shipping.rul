ufos:
  - type: STR_MERCHANT_SHIP
    size: STR_LARGE
    sprite: 3
    marker: 36
    damageMax: 300
    speedMax: 15
    missionScore: 0                    # shipping is not Cobra activity: no hit to the monthly rating
    power: 0
    range: 0
    score: 0
    reload: 56
    breakOffTime: 400
    battlescapeTerrainData:
      name: UFO1A
      mapDataSets: [BLANKS, UFO1]
      mapBlocks:
        - {name: UFO1A, width: 10, length: 10}

ufoTrajectories:
  - id: P_SHIPPING                     # unused: Shipping.cpp steers the merchants itself
    groundTimer: 1
    waypoints:
      - [0, 1, 100]
      - [0, 1, 100]

alienMissions:
  - type: STR_CIVIL_SHIPPING                # holds every merchant at sea; never spawns anything itself
    points: 0
    objective: 0
    raceWeights:
      0:
        STR_COBRA: 100
    waves: []
  - type: STR_SHIP_SEARCH_MISSION           # the boarding a stop and search puts on the spot
    points: 0
    objective: 3
    raceWeights:
      0:
        STR_COBRA: 100
    waves:
      - ufo: STR_SHIP_SEARCH_LINE
        count: 1
        trajectory: P0
        timer: 60
        objective: true

alienDeployments:
  - type: STR_SHIP_SEARCH_LINE
    data:
      - alienRank: 5
        lowQty: 3
        highQty: 4
        dQty: 1
        percentageOutsideUfo: 100
        itemSets:
          - [STR_PISTOL, STR_PISTOL_CLIP, STR_PISTOL_CLIP]
          - [STR_RIFLE, STR_RIFLE_CLIP, STR_RIFLE_CLIP]
          - [STR_RIFLE, STR_RIFLE_CLIP, STR_RIFLE_CLIP]
    width: 60
    length: 20
    height: 8
    terrains: [FREIGHTER_T]
    script: FREIGHTER_SCRIPT
    shade: 0
    duration: [12, 12]
    markerName: STR_SHIP_STOPPED_SITE
    markerIcon: 22
    briefing: {palette: 0, title: STR_SHIP_SEARCH_LINE, desc: STR_SHIP_SEARCH_LINE_BRIEFING}
  - type: STR_SHIP_SEARCH_LINE_HIGH
    data:
      - alienRank: 5
        lowQty: 6
        highQty: 8
        dQty: 1
        percentageOutsideUfo: 100
        itemSets:
          - [STR_PISTOL, STR_PISTOL_CLIP, STR_PISTOL_CLIP]
          - [STR_RIFLE, STR_RIFLE_CLIP, STR_RIFLE_CLIP]
          - [STR_RIFLE, STR_RIFLE_CLIP, STR_RIFLE_CLIP]
    width: 60
    length: 20
    height: 8
    terrains: [FREIGHTER_T]
    script: FREIGHTER_SCRIPT
    shade: 0
    duration: [12, 12]
    markerName: STR_SHIP_STOPPED_SITE
    markerIcon: 22
    briefing: {palette: 0, title: STR_SHIP_SEARCH_LINE, desc: STR_SHIP_SEARCH_LINE_BRIEFING}
  - type: STR_SHIP_SEARCH_CONTAINERS
    data:
      - alienRank: 5
        lowQty: 3
        highQty: 3
        dQty: 1
        percentageOutsideUfo: 100
        itemSets:
          - [STR_PISTOL, STR_PISTOL_CLIP, STR_PISTOL_CLIP]
          - [STR_RIFLE, STR_RIFLE_CLIP, STR_RIFLE_CLIP]
          - [STR_RIFLE, STR_RIFLE_CLIP, STR_RIFLE_CLIP]
    civilians: 9
    width: 60
    length: 20
    height: 8
    terrains: [CONTSHIP_T]
    script: CONTSHIP_SCRIPT
    shade: 0
    duration: [12, 12]
    markerName: STR_SHIP_STOPPED_SITE
    markerIcon: 22
    briefing: {palette: 0, title: STR_SHIP_SEARCH_CONTAINERS, desc: STR_SHIP_SEARCH_CONTAINERS_BRIEFING}
  - type: STR_SHIP_SEARCH_CONTAINERS_HIGH
    data:
      - alienRank: 5
        lowQty: 6
        highQty: 8
        dQty: 1
        percentageOutsideUfo: 100
        itemSets:
          - [STR_PISTOL, STR_PISTOL_CLIP, STR_PISTOL_CLIP]
          - [STR_RIFLE, STR_RIFLE_CLIP, STR_RIFLE_CLIP]
          - [STR_RIFLE, STR_RIFLE_CLIP, STR_RIFLE_CLIP]
    civilians: 9
    width: 60
    length: 20
    height: 8
    terrains: [CONTSHIP_T]
    script: CONTSHIP_SCRIPT
    shade: 0
    duration: [12, 12]
    markerName: STR_SHIP_STOPPED_SITE
    markerIcon: 22
    briefing: {palette: 0, title: STR_SHIP_SEARCH_CONTAINERS, desc: STR_SHIP_SEARCH_CONTAINERS_BRIEFING}
  - type: STR_SHIP_HIJACK
    data:
      - alienRank: 5
        lowQty: 8
        highQty: 10
        dQty: 1
        percentageOutsideUfo: 100
        itemSets:
          - [STR_PISTOL, STR_PISTOL_CLIP, STR_PISTOL_CLIP]
          - [STR_RIFLE, STR_RIFLE_CLIP, STR_RIFLE_CLIP]
          - [STR_RIFLE, STR_RIFLE_CLIP, STR_RIFLE_CLIP]
      - alienRank: 5
        customUnitType: STR_ROBBERY_LEADER
        lowQty: 1
        highQty: 1
        dQty: 0
        percentageOutsideUfo: 100
        itemSets:
          - [STR_PISTOL, STR_PISTOL_CLIP]
    civilians: 12
    width: 60
    length: 20
    height: 8
    terrains: [HIJACKED_T]
    script: HIJACKED_SCRIPT
    shade: 0
    duration: [72, 72]
    markerName: STR_SHIP_HIJACK_SITE
    markerIcon: 22
    briefing: {palette: 0, title: STR_SHIP_HIJACK, desc: STR_SHIP_HIJACK_BRIEFING}


extraSprites:
  - type: GlobeMarkers
    width: 28
    height: 28
    subX: 28
    subY: 28
    files:
      36: Resources/Globe/marker_36_merchant_ship.png
  - type: SEA_MERCHANT_BODY_HD.PCK           # STAND-IN: the Cobra ship with its paint and emblem greyed out
    width: 2560
    height: 3200
    subX: 640
    subY: 800
    files:
      0: Resources/Units/air_merchant_5_body.png

extraStrings:
  - type: en-US
    strings: &shipstr
      STR_MERCHANT_SHIP: "Merchant ship"
      STR_SEA_MERCHANT: "Merchant ship"
      STR_CIVIL_SHIPPING: "Shipping"
      STR_SHIP_SEARCH_MISSION: "Stop and search"
      STR_SHIP_STOPPED_SITE: "Stopped ship"
      STR_SHIP_STOPPED_SITE_: "Stopped ship"
      STR_SHIP_STOP_TITLE: "{0}"
      STR_SHIP_BOUND: "Bound for {0}, out of {1}"
      STR_SHIP_FLAG: "Flag: {0}"
      STR_SHIP_FLAG_NONE: "a flag of convenience"
      STR_SHIP_INTEL_UNKNOWN: "Intel: nothing on her. She could easily be innocent."
      STR_SHIP_STOP_SEARCH: "STOP AND SEARCH"
      STR_SHIP_OPEN_FIRE: "OPEN FIRE"
      STR_SHIP_LET_GO: "LET IT GO"
      STR_SHIP_SEARCH_NOTHING: "{0} heaves to. The hold is searched: nothing but what her papers say.{NEWLINE}Her flag country is not pleased (goodwill -{1})."
      STR_SHIP_SEARCH_SEIZED: "{0} heaves to. In the hold: Cobra containers, nobody with them. Seized."
      STR_SHIP_SEARCH_BLUFF: "{0} heaves to without a fuss. Too much without a fuss. The boarding team goes aboard."
      STR_SHIP_SEARCH_MINDERS: "{0} heaves to. The crew is cooperating - but somebody aboard isn't crew. The boarding team goes aboard."
      STR_SHIP_SUNK_INNOCENT: "{0} SUNK. She was an honest ship. The press has it by morning (goodwill -{1}, exposure up)."
      STR_SHIP_SUNK_COBRA: "{0} SUNK, and Cobra's cargo with her."
      STR_SHIP_DISABLED_INNOCENT: "{0} is dead in the water. She was an honest ship (goodwill -{1})."
      STR_SHIP_SEARCH_LINE: "STOP AND SEARCH"
      STR_SHIP_HIJACK: "HOSTAGE RESCUE AT SEA"
      STR_SHIP_HIJACK_SITE: "Hijacked ship"
      STR_SHIP_HIJACK_SITE_: "Hijacked ship"
      STR_SHIP_HIJACK_BRIEFING: "Cobra took her at sea. They hold the officers on the bridge and the rest of the crew in the mess. Every hostage you bring out alive counts with her flag country. Come over the forecastle rail and work aft."
      STR_SHIP_HIJACKED_TITLE: "{0} - HIJACKED"
      STR_SHIP_HIJACKED_HOURS: "Cobra holds her crew. {0} hours before they take the cargo or name a ransom."
      STR_SHIP_BOARD: "BOARD HER"
      STR_SHIP_HIJACK_ALERT: "MAYDAY - {0} reports armed men aboard and the radio goes dead. Cobra has her. {1} hours to get a team aboard before they take the cargo or ransom the crew."
      STR_SHIP_HIJACK_BOARD: "{0} is dead in the water with Cobra aboard. The team goes over the rail."
      STR_SHIP_HIJACK_RANSOM: "{0}: {1} paid Cobra's ransom and got her crew back. They wanted to know where G.I. Joe was (goodwill -{2})."
      STR_SHIP_HIJACK_SEIZED: "{0}: Cobra stripped her hold and let her go."
      STR_SHIP_SEARCH_LINE_HIGH: "STOP AND SEARCH"
      STR_SHIP_SEARCH_LINE_BRIEFING: "She stopped when told to and her master is all smiles. Her papers say machine parts. Search her: the hold, the bridge, the crew quarters. If this is a Cobra ship, her crew will not let you finish."
      STR_SHIP_SEARCH_CONTAINERS: "STOP AND SEARCH"
      STR_SHIP_SEARCH_CONTAINERS_HIGH: "STOP AND SEARCH"
      STR_SHIP_SEARCH_CONTAINERS_BRIEFING: "An honest crew and an honest ship, by the look of it. Somewhere on her deck are containers that are not what the manifest says, and men travelling with them who are not crew. Protect the crew."
  - type: en-GB
    strings: *shipstr
