# Civilian shipping: generated by tools/oxce-4x/build/gen_shipping.py from story_tools/shipping_lanes.yml (STORY).
# Engine: Geoscape/Shipping.cpp (merchants on lanes), ShipStopState (stop and search). Numbers are SEA design 12g/12h's;
# deliverFunds, the tier weights and the 15-knot merchants are BUILD's first guesses (faster ships made the lanes a Cobra money printer).
shipping:
  total: 40
  tierWeights: [60, 30, 10]
  deliverFunds: [20, 35, 0]
  deliverMaterielHigh: 50
  ownLineShare: 50
