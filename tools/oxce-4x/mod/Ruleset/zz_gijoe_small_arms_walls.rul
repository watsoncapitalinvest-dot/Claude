# Small arms chip walls instead of knocking them down (John 12 Nov 23:05: "i blew walls away with each gun shot").
# Loads after zz_gijoe_destruction.rul, which set every bullet to full damage against terrain (ToTile 1.0);
# the ranch's walls are armour 12-30, so one rifle round (30) flattened one. A quarter of the shot's power
# now reaches the wall. Grenades, rockets and HE rounds keep the destruction profile's values.
items:
  - type: STR_PISTOL_CLIP
    damageAlter:
      ToTile: 0.25
  - type: STR_RIFLE_CLIP
    damageAlter:
      ToTile: 0.25
  - type: STR_HC_AP_AMMO
    damageAlter:
      ToTile: 0.25
  - type: STR_AC_AP_AMMO
    damageAlter:
      ToTile: 0.25
  - type: STR_LASER_PISTOL
    damageAlter:
      ToTile: 0.25
  - type: STR_LASER_RIFLE
    damageAlter:
      ToTile: 0.25
  - type: STR_HEAVY_LASER
    damageAlter:
      ToTile: 0.25
  - type: STR_PLASMA_PISTOL_CLIP
    damageAlter:
      ToTile: 0.25
  - type: STR_PLASMA_RIFLE_CLIP
    damageAlter:
      ToTile: 0.25
  - type: STR_HEAVY_PLASMA_CLIP
    damageAlter:
      ToTile: 0.25
